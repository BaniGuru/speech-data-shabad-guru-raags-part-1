  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪੰਜਵਾ,",
      "start_time": 0.54,
      "end_time": 12.964
    },
    {
      "section_id": "section-2",
      "transcript": "ਘਰੁ ਦੂਜਾ।",
      "start_time": 12.964,
      "end_time": 20.937
    },
    {
      "section_id": "section-3",
      "transcript": "ਗੋਇਲਿ ਆਇਆ ਗੋਇਲੀ ਕਿਆ ਤਿਸੁ ਡੰਫੁ ਪਸਾਰੁ।",
      "start_time": 41.78,
      "end_time": 54.973
    },
    {
      "section_id": "section-4",
      "transcript": "ਮੁਹਲਤਿ ਪੁੰਨੀ ਚਲਣਾ ਤੂੰ ਸੰਮਲੁ ਘਰ ਬਾਰੁ",
      "start_time": 54.973,
      "end_time": 68.54
    },
    {
      "section_id": "section-5",
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਉ ਮਨਾ ਸਤਿਗੁਰੁ ਸੇਵਿ ਪਿਆਰਿ",
      "start_time": 68.54,
      "end_time": 82.039
    },
    {
      "section_id": "section-6",
      "transcript": "ਕਿਆ ਥੋੜੜੀ ਬਾਤ ਗੁਮਾਨੁ ਰਹਾਉ।",
      "start_time": 82.039,
      "end_time": 92.603
    },
    {
      "section_id": "section-7",
      "transcript": "ਜੈਸੇ ਰੈਣਿ ਪਰਾਹੁਣੇ ਉਠਿ ਚਲਸਹਿ ਪਰਭਾਤਿ।",
      "start_time": 99.08,
      "end_time": 112.664
    },
    {
      "section_id": "section-8",
      "transcript": "ਕਿਆ ਤੂੰ ਰਤਾ ਗਿਰਸਤ ਸਿਉ ਸਭ ਫੁਲਾ ਕੀ ਬਾਗਾਤਿ।",
      "start_time": 112.664,
      "end_time": 126.026
    },
    {
      "section_id": "section-9",
      "transcript": "ਮੇਰੀ ਮੇਰੀ ਕਿਆ ਕਰਹਿ ਜਿਨਿ ਦੀਆ ਸੋ ਪ੍ਰਭੁ ਲੋੜਿ",
      "start_time": 126.32,
      "end_time": 139.9
    },
    {
      "section_id": "section-10",
      "transcript": "ਸਰਪਰ ਉਠੀ ਚਲਣਾ ਛਡਿ ਜਾਸੀ ਲਖ ਕਰੋੜਿ।",
      "start_time": 139.9,
      "end_time": 153.588
    },
    {
      "section_id": "section-11",
      "transcript": "ਲਖ ਚਉਰਾਸੀਹ ਭ੍ਰਮਤਿਆ ਦੁਲਭ ਜਨਮੁ ਪਾਇਓਇ।",
      "start_time": 153.68,
      "end_time": 167.164
    },
    {
      "section_id": "section-12",
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਸਮਾਲਿ ਤੂੰ ਸੋ ਦਿਨੁ ਨੇੜਾ ਆਇਓਇ।",
      "start_time": 167.164,
      "end_time": 180.682
    },
    {
      "section_id": "section-13",
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਸਮਾਲਿ ਤੂੰ ਸੋ ਦਿਨੁ ਨੇੜਾ ਆਇਓਇ",

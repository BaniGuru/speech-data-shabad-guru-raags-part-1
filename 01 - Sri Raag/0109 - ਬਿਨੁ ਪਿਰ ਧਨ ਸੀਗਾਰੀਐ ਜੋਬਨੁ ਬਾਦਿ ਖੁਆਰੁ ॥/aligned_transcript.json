    {
      "section_id": "section-14",
      "transcript": "ਮਨ ਮਹਿ ਮਨੂਆ ਜੇ ਮਰੈ ਤਾ ਪਿਰੁ ਰਾਵੈ ਨਾਰਿ",
      "start_time": 224.26,
      "end_time": 237.42

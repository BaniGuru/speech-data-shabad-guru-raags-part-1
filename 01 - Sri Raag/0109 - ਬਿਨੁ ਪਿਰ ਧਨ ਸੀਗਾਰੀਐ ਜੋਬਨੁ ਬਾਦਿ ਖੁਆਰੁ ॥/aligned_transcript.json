    {
      "section_id": "section-15",
      "transcript": "ਇਕਤੁ ਤਾਗੈ ਰਲਿ ਮਿਲੈ ਗਲਿ ਮੋਤੀਅਨ ਕਾ ਹਾਰੁ",
      "start_time": 237.42,
      "end_time": 250.66
    },
    {
      "section_id": "section-16",
      "transcript": "ਸੰਤ ਸਭਾ ਸੁਖੁ ਊਪਜੈ ਗੁਰਮੁਖਿ ਨਾਮ ਅਧਾਰੁ",
      "start_time": 250.92,
      "end_time": 263.94

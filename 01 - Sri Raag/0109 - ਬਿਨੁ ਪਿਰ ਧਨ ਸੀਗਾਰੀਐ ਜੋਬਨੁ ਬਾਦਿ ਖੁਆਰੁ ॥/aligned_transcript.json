    {
      "section_id": "section-17",
      "transcript": "ਖਿਨ ਮਹਿ ਉਪਜੈ ਖਿਨਿ ਖਪੈ ਖਿਨੁ ਆਵੈ ਖਿਨੁ ਜਾਇ",
      "start_time": 270.68,
      "end_time": 283.82
    },
    {
      "section_id": "section-18",
      "transcript": "ਸਬਦੁ ਪਛਾਣੈ ਰਵਿ ਰਹੈ ਨਾ ਤਿਸੁ ਕਾਲੁ ਸੰਤਾਇ",
      "start_time": 284.06,
      "end_time": 297.14

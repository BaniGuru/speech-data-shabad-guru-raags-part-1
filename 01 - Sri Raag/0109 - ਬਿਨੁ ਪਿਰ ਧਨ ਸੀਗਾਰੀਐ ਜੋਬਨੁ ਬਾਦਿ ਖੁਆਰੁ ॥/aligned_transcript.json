  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪਹਿਲਾ",
      "start_time": 1.92,
      "end_time": 19.11
    },
    {
      "section_id": "section-2",
      "transcript": "ਬਿਨੁ ਪਿਰ ਧਨ ਸੀਗਾਰੀਐ ਜੋਬਨੁ ਬਾਦਿ ਖੁਆਰੁ",
      "start_time": 36.5,
      "end_time": 50.477
    },
    {
      "section_id": "section-3",
      "transcript": "ਨਾ ਮਾਣੇ ਸੁਖਿ ਸੇਜੜੀ ਬਿਨੁ ਪਿਰ ਬਾਦਿ ਸੀਗਾਰੁ",
      "start_time": 50.6,
      "end_time": 63.98
    },
    {
      "section_id": "section-4",
      "transcript": "ਦੂਖੁ ਘਣੋ ਦੋਹਾਗਣੀ ਨਾ ਘਰਿ ਸੇਜ ਭਤਾਰੁ",
      "start_time": 64.64,
      "end_time": 78.651
    },
    {
      "section_id": "section-5",
      "transcript": "ਮਨ ਰੇ, ਰਾਮ ਜਪਹੁ ਸੁਖੁ ਹੋਇ।",
      "start_time": 78.651,
      "end_time": 92.652
    },
    {
      "section_id": "section-6",
      "transcript": "ਬਿਨੁ ਗੁਰ ਪ੍ਰੇਮੁ ਨ ਪਾਈਐ",
      "start_time": 92.652,
      "end_time": 99.22
    },
    {
      "section_id": "section-7",
      "transcript": "ਸਬਦਿ ਮਿਲੈ ਰੰਗੁ ਹੋਇ ਰਹਾਉ।",
      "start_time": 99.6,
      "end_time": 109.927
    },
    {
      "section_id": "section-8",
      "transcript": "ਗੁਰ ਸੇਵਾ ਸੁਖੁ ਪਾਈਐ ਹਰਿ ਵਰੁ ਸਹਜਿ ਸੀਗਾਰੁ",
      "start_time": 130.04,
      "end_time": 143.34
    },
    {
      "section_id": "section-9",
      "transcript": "ਸਚਿ ਮਾਣੇ ਪਿਰ ਸੇਜੜੀ ਗੂੜਾ ਹੇਤੁ ਪਿਆਰੁ",
      "start_time": 143.68,
      "end_time": 157.02
    },
    {
      "section_id": "section-10",
      "transcript": "ਗੁਰਮੁਖਿ ਜਾਣਿ ਸਿਞਾਣੀਐ ਗੁਰਿ ਮੇਲੀ ਗੁਣ ਚਾਰੁ",
      "start_time": 157.3,
      "end_time": 170.62
    },
    {
      "section_id": "section-11",
      "transcript": "ਸਚਿ ਮਿਲਹੁ ਵਰ ਕਾਮਣੀ ਪਿਰਿ ਮੋਹੀ ਰੰਗੁ ਲਾਇ",
      "start_time": 177.4,
      "end_time": 190.54
    },
    {
      "section_id": "section-12",
      "transcript": "ਮਨੁ ਤਨੁ ਸਾਚਿ ਵਿਗਸਿਆ ਕੀਮਤਿ ਕਹਣੁ ਨ ਜਾਇ",
      "start_time": 190.76,
      "end_time": 203.94
    },
    {
      "section_id": "section-13",
      "transcript": "ਹਰਿ ਵਰੁ ਘਰਿ ਸੋਹਾਗਣੀ ਨਿਰਮਲ ਸਾਚੈ ਨਾਇ",
      "start_time": 204.16,
      "end_time": 217.42

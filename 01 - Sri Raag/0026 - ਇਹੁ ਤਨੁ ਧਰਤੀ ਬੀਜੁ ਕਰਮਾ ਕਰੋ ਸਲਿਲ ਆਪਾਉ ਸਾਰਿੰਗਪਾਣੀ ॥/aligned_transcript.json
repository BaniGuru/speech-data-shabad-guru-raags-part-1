  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪਹਿਲਾ ਘਰੁ ਤੀਜਾ",
      "start_time": 1.67,
      "end_time": 16.952
    },
    {
      "section_id": "section-2",
      "transcript": "ਇਹੁ ਤਨੁ ਧਰਤੀ ਬੀਜੁ ਕਰਮਾ ਕਰੋ, ਸਲਿਲ ਆਪਾਉ ਸਾਰਿੰਗਪਾਣੀ।",
      "start_time": 19.738,
      "end_time": 33.015
    },
    {
      "section_id": "section-3",
      "transcript": "ਮਨੁ ਕਿਰਸਾਣੁ ਹਰਿ ਰਿਦੈ ਜੰਮਾਇ ਲੈ",

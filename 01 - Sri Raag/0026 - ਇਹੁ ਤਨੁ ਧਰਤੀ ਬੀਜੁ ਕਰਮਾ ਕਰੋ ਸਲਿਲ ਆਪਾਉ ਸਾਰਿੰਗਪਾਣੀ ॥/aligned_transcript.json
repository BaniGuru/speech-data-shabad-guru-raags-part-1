      "end_time": 103.756
    },
    {
      "section_id": "section-11",
      "transcript": "ਕਮਲੁ ਬਿਗਸੈ ਮਧੁ ਆਸ੍ਰਮਾਈ",
      "start_time": 103.756,
      "end_time": 111.32
    },
    {
      "section_id": "section-12",
      "transcript": "ਬੀਸ ਸਪਤਾਹਰੋ ਬਾਸਰੋ ਸੰਗ੍ਰਹੈ।",

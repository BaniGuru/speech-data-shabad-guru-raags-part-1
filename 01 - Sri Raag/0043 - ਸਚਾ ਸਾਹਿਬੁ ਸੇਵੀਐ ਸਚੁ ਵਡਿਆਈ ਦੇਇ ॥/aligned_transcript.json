{
  "audio_file": "0023 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ।",
      "start_time": 3.85,
      "end_time": 14.34
    },
    {
      "section_id": "section-2",
      "transcript": "ਮਹਲਾ, ਤੀਜਾ।",
      "start_time": 14.46,
      "end_time": 27.369
    },
    {
      "section_id": "section-3",
      "transcript": "ਸਚਾ ਸਾਹਿਬੁ ਸੇਵੀਐ",
      "start_time": 43.16,
      "end_time": 50.23
    },
    {
      "section_id": "section-4",
      "transcript": "ਸਚੁ ਵਡਿਆਈ ਦੇਇ",
      "start_time": 50.29,
      "end_time": 57.37
    },
    {
      "section_id": "section-5",
      "transcript": "ਗੁਰ ਪਰਸਾਦੀ ਮਨਿ ਵਸੈ",
      "start_time": 57.43,
      "end_time": 64.64
    },
    {
      "section_id": "section-6",
      "transcript": "ਹਉਮੈ ਦੂਰਿ ਕਰੇਇ",
      "start_time": 64.68,
      "end_time": 71.73
    },
    {
      "section_id": "section-7",
      "transcript": "ਇਹੁ ਮਨੁ ਧਾਵਤੁ ਤਾ ਰਹੈ",
      "start_time": 71.87,
      "end_time": 78.64
    },
    {
      "section_id": "section-8",
      "transcript": "ਜਾ ਆਪੇ ਨਦਰਿ ਕਰੇਇ",
      "start_time": 78.7,
      "end_time": 85.64
    },
    {
      "section_id": "section-9",
      "transcript": "ਭਾਈ ਰੇ",
      "start_time": 85.68,
      "end_time": 92.56
    },
    {
      "section_id": "section-10",
      "transcript": "ਗੁਰਮੁਖਿ ਹਰਿ, ਨਾਮੁ ਧਿਆਇ।",
      "start_time": 92.64,
      "end_time": 99.66
    },
    {
      "section_id": "section-11",
      "transcript": "ਨਾਮੁ ਨਿਧਾਨੁ, ਸਦ ਮਨਿ ਵਸੈ।",
      "start_time": 99.66,
      "end_time": 106.71
    },
    {
      "section_id": "section-12",
      "transcript": "ਮਹਲੀ ਪਾਵੈ ਥਾਉ ਰਹਾਉ।",
      "start_time": 106.81,
      "end_time": 117.428
    },
    {
      "section_id": "section-13",
      "transcript": "ਮਨਮੁਖ ਮਨੁ ਤਨੁ, ਅੰਧੁ ਹੈ।",
      "start_time": 131.43,
      "end_time": 138.52
    },
    {
      "section_id": "section-14",
      "transcript": "ਤਿਸ ਨਉ ਠਉਰ ਨ ਠਾਉ",
      "start_time": 138.58,
      "end_time": 145.71
    },
    {
      "section_id": "section-15",
      "transcript": "ਬਹੁ ਜੋਨੀ, ਭਉਦਾ ਫਿਰੈ।",
      "start_time": 145.79,
      "end_time": 152.94
    },
    {
      "section_id": "section-16",
      "transcript": "ਜਿਉ ਸੁੰਞੈਂ ਘਰਿ ਕਾਉ",
      "start_time": 153.02,
      "end_time": 160.23
    },
    {
      "section_id": "section-17",
      "transcript": "ਗੁਰਮਤੀ, ਘਟਿ ਚਾਨਣਾ।",
      "start_time": 160.27,
      "end_time": 167.227
    },
    {
      "section_id": "section-18",
      "transcript": "ਸਬਦਿ ਮਿਲੈ ਹਰਿ ਨਾਉ",
      "start_time": 167.37,
      "end_time": 174.736
    },
    {
      "section_id": "section-19",
      "transcript": "ਤ੍ਰੈ ਗੁਣ ਬਿਖਿਆ, ਅੰਧੁ ਹੈ।",
      "start_time": 188.68,
      "end_time": 195.83
    },
    {
      "section_id": "section-20",
      "transcript": "ਮਾਇਆ ਮੋਹ ਗੁਬਾਰ",
      "start_time": 195.89,
      "end_time": 202.94
    },
    {
      "section_id": "section-21",
      "transcript": "ਲੋਭੀ ਅਨ ਕਉ, ਸੇਵਦੇ।",
      "start_time": 203.08,
      "end_time": 210.14
    },
    {
      "section_id": "section-22",
      "transcript": "ਪੜਿ ਵੇਦਾ ਕਰੈ ਪੂਕਾਰ।",
      "start_time": 210.2,
      "end_time": 217.23
    },
    {
      "section_id": "section-23",
      "transcript": "ਬਿਖਿਆ ਅੰਦਰਿ, ਪਚਿ ਮੁਏ।",
      "start_time": 217.33,
      "end_time": 224.23
    },
    {
      "section_id": "section-24",
      "transcript": "ਨਾ ਉਰਵਾਰੁ ਨ ਪਾਰੁ।",
      "start_time": 224.35,
      "end_time": 231.421
    },
    {
      "section_id": "section-25",
      "transcript": "ਮਾਇਆ ਮੋਹਿ, ਵਿਸਾਰਿਆ।",
      "start_time": 245.53,
      "end_time": 252.69
    },
    {
      "section_id": "section-26",
      "transcript": "ਜਗਤ ਪਿਤਾ ਪ੍ਰਤਿਪਾਲਿ",
      "start_time": 252.76,
      "end_time": 259.87
    },
    {
      "section_id": "section-27",
      "transcript": "ਬਾਝਹੁ ਗੁਰੂ, ਅਚੇਤੁ ਹੈ।",
      "start_time": 259.93,
      "end_time": 267.14
    },
    {
      "section_id": "section-28",
      "transcript": "ਸਭ ਬਧੀ, ਜਮਕਾਲਿ।",
      "start_time": 267.16,
      "end_time": 274.14
    },
    {
      "section_id": "section-29",
      "transcript": "ਨਾਨਕ ਗੁਰਮਤਿ, ਉਬਰੇ,",
      "start_time": 274.24,
      "end_time": 281.2
    },
    {
      "section_id": "section-30",
      "transcript": "ਸਚਾ ਨਾਮੁ ਸਮਾਲਿ।",
      "start_time": 281.2,
      "end_time": 288.6
    },
    {
      "section_id": "section-31",
      "transcript": "ਨਾਨਕ ਗੁਰਮਤਿ ਉਬਰੇ ਸਚਾ ਨਾਮੁ ਸਮਾਲਿ",
      "start_time": 302.277,
      "end_time": 319.168
    }
  ]
}

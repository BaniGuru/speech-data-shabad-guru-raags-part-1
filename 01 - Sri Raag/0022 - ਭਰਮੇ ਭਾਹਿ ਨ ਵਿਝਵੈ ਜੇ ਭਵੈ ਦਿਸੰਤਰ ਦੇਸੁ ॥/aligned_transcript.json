    {
      "section_id": "section-5",
      "transcript": "ਧ੍ਰਿਗੁ ਜੀਵਣੁ ਧ੍ਰਿਗੁ ਵੇਸੁ",
      "start_time": 46.944,
      "end_time": 52.725
    },
    {
      "section_id": "section-6",
      "transcript": "ਹੋਰੁ ਕਿਤੈ ਭਗਤਿ ਨ ਹੋਵਈ",
      "start_time": 52.725,
      "end_time": 58.436
    },
    {
      "section_id": "section-7",
      "transcript": "ਬਿਨੁ ਸਤਿਗੁਰ ਕੇ ਉਪਦੇਸ",
      "start_time": 58.436,
      "end_time": 64.738
    },
    {
      "section_id": "section-8",
      "transcript": "ਮਨ ਰੇ, ਗੁਰਮੁਖਿ ਅਗਨਿ ਨਿਵਾਰਿ।",
      "start_time": 64.738,
      "end_time": 76.416
    },
    {
      "section_id": "section-9",
      "transcript": "ਗੁਰ ਕਾ ਕਹਿਆ ਮਨਿ ਵਸੈ",
      "start_time": 76.416,
      "end_time": 82.189
    },
    {
      "section_id": "section-10",
      "transcript": "ਹਉਮੈ ਤ੍ਰਿਸਨਾ ਮਾਰਿ ਰਹਾਉ",

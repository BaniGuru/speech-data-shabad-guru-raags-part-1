      "transcript": "ਦੂਜਾ ਥਾਉ ਨ ਕੋ ਸੁਝੈ।",
      "start_time": 104.208,
      "end_time": 110.96
    },
    {
      "section_id": "section-8",
      "transcript": "ਗੁਰ ਮੇਲੇ ਸਚੁ ਸੋਇ ਰਹਾਉ",
      "start_time": 111.22,
      "end_time": 121.494
    },
    {
      "section_id": "section-9",
      "transcript": "ਸਗਲ ਪਦਾਰਥ ਤਿਸੁ ਮਿਲੇ ਜਿਨਿ ਗੁਰੁ ਡਿਠਾ ਜਾਇ",
      "start_time": 128.18,
      "end_time": 141.84

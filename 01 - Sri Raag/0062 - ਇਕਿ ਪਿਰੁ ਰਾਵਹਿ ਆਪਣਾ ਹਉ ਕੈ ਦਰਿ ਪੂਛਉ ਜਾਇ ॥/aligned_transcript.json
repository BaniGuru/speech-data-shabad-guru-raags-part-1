{
  "audio_file": "0029 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਤੀਜਾ।",
      "start_time": 1.883,
      "end_time": 18.691
    },
    {
      "section_id": "section-2",
      "transcript": "ਇਕਿ ਪਿਰੁ ਰਾਵਹਿ ਆਪਣਾ, ਹਉ ਕੈ ਦਰਿ ਪੂਛਉ ਜਾਇ।",
      "start_time": 35.34,
      "end_time": 48.079
    },
    {
      "section_id": "section-3",
      "transcript": "ਸਤਿਗੁਰੁ ਸੇਵੀ ਭਾਉ ਕਰਿ, ਮੈ ਪਿਰੁ ਦੇਹੁ ਮਿਲਾਇ।",
      "start_time": 48.8,
      "end_time": 61.99
    },
    {
      "section_id": "section-4",
      "transcript": "ਸਭੁ ਉਪਾਏ ਆਪੇ ਵੇਖੈ, ਕਿਸੁ ਨੇੜੈ ਕਿਸੁ ਦੂਰਿ।",
      "start_time": 62.332,
      "end_time": 75.629
    },
    {
      "section_id": "section-5",
      "transcript": "ਜਿਨਿ ਪਿਰੁ ਸੰਗੇ ਜਾਣਿਆ, ਪਿਰੁ ਰਾਵੇ ਸਦਾ ਹਦੂਰਿ।",
      "start_time": 75.629,
      "end_time": 88.746
    },
    {
      "section_id": "section-6",
      "transcript": "ਮੁੰਧੇ ਤੂ ਚਲੁ ਗੁਰ ਕੈ ਭਾਇ",
      "start_time": 102.68,
      "end_time": 109.28
    },
    {
      "section_id": "section-7",
      "transcript": "ਅਨਦਿਨੁ ਰਾਵਹਿ ਪਿਰੁ ਆਪਣਾ",
      "start_time": 109.469,
      "end_time": 116.08
    },
    {
      "section_id": "section-8",
      "transcript": "ਸਹਜੇ ਸਚਿ ਸਮਾਇ ਰਹਾਉ",
      "start_time": 116.1,
      "end_time": 125.438
    },
    {
      "section_id": "section-9",
      "transcript": "ਸਬਦਿ ਰਤੀਆ ਸੋਹਾਗਣੀ",
      "start_time": 139.36,
      "end_time": 145.84
    },
    {
      "section_id": "section-10",
      "transcript": "ਸਚੈ ਸਬਦਿ ਸੀਗਾਰਿ",
      "start_time": 145.88,
      "end_time": 151.84
    },
    {
      "section_id": "section-11",
      "transcript": "ਹਰਿ ਵਰੁ ਪਾਇਨਿ ਘਰਿ ਆਪਣੈ",
      "start_time": 158.82,
      "end_time": 165.12
    },
    {
      "section_id": "section-12",
      "transcript": "ਗੁਰ ਕੈ ਹੇਤਿ ਪਿਆਰਿ",
      "start_time": 165.26,
      "end_time": 171.6
    },
    {
      "section_id": "section-13",
      "transcript": "ਸੇਜ ਸੁਹਾਵੀ ਹਰਿ ਰੰਗਿ ਰਵੈ, ਭਗਤਿ ਭਰੇ ਭੰਡਾਰ।",
      "start_time": 171.72,
      "end_time": 184.279
    },
    {
      "section_id": "section-14",
      "transcript": "ਸੋ ਪ੍ਰਭੁ ਪ੍ਰੀਤਮੁ ਮਨਿ ਵਸੈ, ਜਿ ਸਭਸੈ ਦੇਇ ਅਧਾਰੁ।",
      "start_time": 184.279,
      "end_time": 197.175
    },
    {
      "section_id": "section-15",
      "transcript": "ਪਿਰੁ ਸਾਲਾਹਨਿ ਆਪਣਾ",
      "start_time": 210.06,
      "end_time": 216.432
    },
    {
      "section_id": "section-16",
      "transcript": "ਤਿਨ ਕੈ ਹਉ ਸਦ ਬਲਿਹਾਰੈ ਜਾਉ",
      "start_time": 216.432,
      "end_time": 222.72
    },
    {
      "section_id": "section-17",
      "transcript": "ਮਨੁ ਤਨੁ ਅਰਪੀ ਸਿਰੁ ਦੇਈ",
      "start_time": 228.993,
      "end_time": 235.28
    },
    {
      "section_id": "section-18",
      "transcript": "ਤਿਨ ਕੈ ਲਾਗਾ ਪਾਇ",
      "start_time": 235.44,
      "end_time": 241.76
    },
    {
      "section_id": "section-19",
      "transcript": "ਜਿਨੀ ਇਕੁ ਪਛਾਣਿਆ ਦੂਜਾ ਭਾਉ ਚੁਕਾਇ",
      "start_time": 241.84,

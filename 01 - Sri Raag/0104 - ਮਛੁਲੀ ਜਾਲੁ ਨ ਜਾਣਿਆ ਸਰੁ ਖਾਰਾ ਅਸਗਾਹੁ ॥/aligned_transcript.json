  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ।",
      "start_time": 1.733,
      "end_time": 13.316
    },
    {
      "section_id": "section-2",
      "transcript": "ਮਹਲਾ ਪਹਿਲਾ।",
      "start_time": 13.316,
      "end_time": 24.614
    },
    {
      "section_id": "section-3",
      "transcript": "ਮਛੁਲੀ ਜਾਲੁ ਨ ਜਾਣਿਆ",
      "start_time": 39.54,
      "end_time": 45.24
    },
    {
      "section_id": "section-4",
      "transcript": "ਸਰੁ ਖਾਰਾ ਅਸਗਾਹੁ",
      "start_time": 45.24,
      "end_time": 50.88
    },
    {
      "section_id": "section-5",
      "transcript": "ਅਤਿ ਸਿਆਣੀ ਸੋਹਣੀ ਕਿਉ ਕੀਤੋ ਵੇਸਾਹੁ",
      "start_time": 52.14,
      "end_time": 63.12
    },
    {
      "section_id": "section-6",
      "transcript": "ਕੀਤੇ ਕਾਰਣਿ ਪਾਕੜੀ ਕਾਲੁ ਨ ਟਲੈ ਸਿਰਾਹੁ",
      "start_time": 64.32,
      "end_time": 76.44
    },
    {
      "section_id": "section-7",
      "transcript": "ਭਾਈ ਰੇ ਇਉ ਸਿਰਿ ਜਾਣਹੁ ਕਾਲੁ",
      "start_time": 76.64,
      "end_time": 85.68
    },
    {
      "section_id": "section-8",
      "transcript": "ਜਿਉ ਮਛੀ ਤਿਉ ਮਾਣਸਾ ਪਵੈ ਅਚਿੰਤਾ ਜਾਲੁ ਰਹਾਉ",
      "start_time": 85.9,
      "end_time": 101.28
    },
    {
      "section_id": "section-9",
      "transcript": "ਸਭੁ ਜਗੁ ਬਾਧੋ ਕਾਲ ਕੋ ਬਿਨੁ ਗੁਰ ਕਾਲੁ ਅਫਾਰੁ",
      "start_time": 107.3,
      "end_time": 119.36
    },
    {
      "section_id": "section-10",
      "transcript": "ਸਚਿ ਰਤੇ ਸੇ ਉਬਰੇ ਦੁਬਿਧਾ ਛੋਡਿ ਵਿਕਾਰ",
      "start_time": 119.52,
      "end_time": 131.54
    },
    {
      "section_id": "section-11",
      "transcript": "ਹਉ ਤਿਨ ਕੈ ਬਲਿਹਾਰਣੈ ਦਰਿ ਸਚੈ ਸਚਿਆਰ",
      "start_time": 131.77,
      "end_time": 143.71
    },
    {
      "section_id": "section-12",
      "transcript": "ਸੀਚਾਨੇ ਜਿਉ ਪੰਖੀਆ ਜਾਲੀ ਬਧਿਕ ਹਾਥਿ",
      "start_time": 155.9,
      "end_time": 167.96
    },
    {
      "section_id": "section-13",
      "transcript": "ਗੁਰਿ ਰਾਖੇ ਸੇ ਉਬਰੇ ਹੋਰਿ ਫਾਥੇ ਚੋਗੈ ਸਾਥਿ",
      "start_time": 168.08,
      "end_time": 180.08
    },
    {
      "section_id": "section-14",
      "transcript": "ਬਿਨੁ ਨਾਵੈ ਚੁਣਿ ਸੁਟੀਅਹਿ ਕੋਇ ਨ ਸੰਗੀ ਸਾਥਿ",
      "start_time": 180.28,
      "end_time": 192.629
    },
    {
      "section_id": "section-15",
      "transcript": "ਸਚੋ ਸਚਾ ਆਖੀਐ ਸਚੇ ਸਚਾ ਥਾਨੁ",
      "start_time": 204.46,
      "end_time": 216.48
    },
    {
      "section_id": "section-16",
      "transcript": "ਜਿਨੀ ਸਚਾ ਮੰਨਿਆ ਤਿਨ ਮਨਿ ਸਚੁ ਧਿਆਨੁ",
      "start_time": 216.66,
      "end_time": 228.76
    },
    {
      "section_id": "section-17",
      "transcript": "ਮਨਿ ਮੁਖਿ ਸੂਚੇ ਜਾਣੀਅਹਿ ਗੁਰਮੁਖਿ ਜਿਨਾ ਗਿਆਨੁ",
      "start_time": 228.92,
      "end_time": 241.24
    },
    {
      "section_id": "section-18",
      "transcript": "ਸਤਿਗੁਰ ਅਗੈ ਅਰਦਾਸਿ ਕਰਿ ਸਾਜਨੁ ਦੇਇ ਮਿਲਾਇ",
      "start_time": 253.54,
      "end_time": 265.56
    },
    {
      "section_id": "section-19",
      "transcript": "ਸਾਜਨਿ ਮਿਲਿਐ ਸੁਖੁ ਪਾਇਆ ਜਮਦੂਤ ਮੁਏ ਬਿਖੁ ਖਾਇ",
      "start_time": 265.72,
      "end_time": 277.92
    },
    {
      "section_id": "section-20",
      "transcript": "ਨਾਵੈ ਅੰਦਰਿ ਹਉ ਵਸਾਂ ਨਾਉ ਵਸੈ ਮਨਿ ਆਇ",
      "start_time": 278.12,
      "end_time": 290.24
    },
    {
      "section_id": "section-21",
      "transcript": "ਬਾਝੁ ਗੁਰੂ ਗੁਬਾਰੁ ਹੈ ਬਿਨੁ ਸਬਦੈ ਬੂਝ ਨ ਪਾਇ",
      "start_time": 302.53,
      "end_time": 314.64
    },
    {
      "section_id": "section-22",
      "transcript": "ਗੁਰਮਤੀ ਪਰਗਾਸੁ ਹੋਇ ਸਚਿ ਰਹੈ ਲਿਵ ਲਾਇ",
      "start_time": 314.82,
      "end_time": 327.0
    },
    {
      "section_id": "section-23",
      "transcript": "ਤਿਥੈ ਕਾਲੁ ਨ ਸੰਚਰੈ ਜੋਤੀ ਜੋਤਿ ਸਮਾਇ",
      "start_time": 327.12,
      "end_time": 339.12
    },
    {
      "section_id": "section-24",
      "transcript": "ਤੂੰਹੈ ਸਾਜਨੁ ਤੂੰ ਸੁਜਾਣੁ ਤੂੰ ਆਪੇ ਮੇਲਣਹਾਰੁ",
      "start_time": 351.34,
      "end_time": 363.36
    },
    {
      "section_id": "section-25",
      "transcript": "ਗੁਰਸਬਦੀ ਸਾਲਾਹੀਐ ਅੰਤੁ ਨ ਪਾਰਾਵਾਰੁ",
      "start_time": 363.56,
      "end_time": 375.6
    },
    {
      "section_id": "section-26",
      "transcript": "ਤਿਥੈ ਕਾਲੁ ਨ ਅਪੜੈ ਜਿਥੈ ਗੁਰ ਕਾ ਸਬਦੁ ਅਪਾਰੁ",
      "start_time": 375.72,
      "end_time": 387.84
    },
    {
      "section_id": "section-27",
      "transcript": "ਹੁਕਮੀ ਸਭੇ ਊਪਜਹਿ ਹੁਕਮੀ ਕਾਰ ਕਮਾਹਿ",
      "start_time": 400.06,
      "end_time": 412.12
    },
    {
      "section_id": "section-28",
      "transcript": "ਹੁਕਮੀ ਕਾਲੈ ਵਸਿ ਹੈ ਹੁਕਮੀ ਸਾਚਿ ਸਮਾਹਿ",
      "start_time": 412.28,
      "end_time": 424.36
    },
    {
      "section_id": "section-29",
      "transcript": "ਨਾਨਕ ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋ ਥੀਐ ਇਨਾ ਜੰਤਾ ਵਸਿ ਕਿਛੁ ਨਾਹਿ",
      "start_time": 424.56,
      "end_time": 436.64
    },
    {
      "section_id": "section-30",

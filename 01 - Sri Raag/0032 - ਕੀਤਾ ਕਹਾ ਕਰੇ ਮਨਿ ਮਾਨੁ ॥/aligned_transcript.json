{
  "audio_file": "019 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪਹਿਲਾ",
      "start_time": 0.0,
      "end_time": 11.445
    },
    {
      "section_id": "section-2",
      "transcript": "ਘਰੁ ਚੌਥਾ।",
      "start_time": 11.445,
      "end_time": 19.982
    },
    {
      "section_id": "section-3",
      "transcript": "ਆ।",
      "start_time": 19.982,
      "end_time": 25.495
    },
    {
      "section_id": "section-4",
      "transcript": "ਕਹਾ ਕਰੇ ਮਨਿ ਮਾਨੁ",
      "start_time": 35.875,
      "end_time": 44.249
    },
    {
      "section_id": "section-5",
      "transcript": "ਦੇਵਣਹਾਰੇ ਕੈ ਹਥਿ, ਦਾਨੁ।",
      "start_time": 44.249,
      "end_time": 52.483
    },
    {
      "section_id": "section-6",
      "transcript": "ਭਾਵੈ ਦੇਇ, ਨ ਦੇਈ ਸੋਇ।",
      "start_time": 52.483,
      "end_time": 60.803
    },
    {
      "section_id": "section-7",
      "transcript": "ਕੀਤੇ ਕੈ ਕਹਿਐ, ਕਿਆ ਹੋਇ।",
      "start_time": 60.803,
      "end_time": 69.051
    },
    {
      "section_id": "section-8",
      "transcript": "ਆਪੇ ਸਚੁ, ਭਾਵੈ ਤਿਸੁ ਸਚੁ।",
      "start_time": 69.051,
      "end_time": 77.225
    },
    {
      "section_id": "section-9",
      "transcript": "ਅੰਧਾ ਕਚਾ, ਕਚੁ ਨਿਕਚੁ ਰਹਾਉ।",
      "start_time": 77.225,
      "end_time": 87.513
    },
    {
      "section_id": "section-10",
      "transcript": "ਜਾ ਕੇ ਰੁਖ ਬਿਰਖ, ਆਰਾਉ।",
      "start_time": 97.383,
      "end_time": 105.613
    },
    {
      "section_id": "section-11",
      "transcript": "ਜੇਹੀ ਧਾਤੁ, ਤੇਹਾ ਤਿਨ ਨਾਉ।",
      "start_time": 105.613,
      "end_time": 113.819
    },
    {
      "section_id": "section-12",
      "transcript": "ਫੁਲੁ ਭਾਉ, ਫਲੁ ਲਿਖਿਆ ਪਾਇ।",
      "start_time": 113.819,
      "end_time": 121.869
    },
    {
      "section_id": "section-13",
      "transcript": "ਆਪਿ ਬੀਜਿ, ਆਪੇ ਹੀ ਖਾਇ।",
      "start_time": 121.869,
      "end_time": 130.014
    },
    {
      "section_id": "section-14",
      "transcript": "ਕਚੀ ਕੰਧ, ਕਚਾ ਵਿਚਿ ਰਾਜੁ।",
      "start_time": 130.014,
      "end_time": 138.057
    },
    {
      "section_id": "section-15",
      "transcript": "ਮਤਿ ਅਲੂਣੀ, ਫਿਕਾ ਸਾਦੁ।",
      "start_time": 138.057,
      "end_time": 146.002
    },
    {
      "section_id": "section-16",
      "transcript": "ਨਾਨਕ ਆਣੇ, ਆਵੈ ਰਾਸਿ।",
      "start_time": 146.002,
      "end_time": 154.248
    },
    {
      "section_id": "section-17",
      "transcript": "ਵਿਣੁ ਨਾਵੈ, ਨਾਹੀ ਸਾਬਾਸਿ।",
      "start_time": 154.248,
      "end_time": 162.279
    },
    {
      "section_id": "section-18",
      "transcript": "ਵਿਣੁ ਨਾਵੈ, ਨਾਹੀ ਸਾਬਾਸਿ।",
      "start_time": 162.279,
      "end_time": 171.539
    }
  ]
}

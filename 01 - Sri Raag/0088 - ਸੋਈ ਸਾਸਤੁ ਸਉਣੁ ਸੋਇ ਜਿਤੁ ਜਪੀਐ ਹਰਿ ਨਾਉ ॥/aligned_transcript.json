  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪੰਜਵਾ",
      "start_time": 0.14,
      "end_time": 7.44
    },
    {
      "section_id": "section-2",
      "transcript": "ਸੋਈ ਸਾਸਤੁ ਸਉਣੁ ਸੋਇ ਜਿਤੁ ਜਪੀਐ ਹਰਿ, ਨਾਉ।",
      "start_time": 14.62,
      "end_time": 28.884
    },
    {
      "section_id": "section-3",
      "transcript": "ਚਰਣ ਕਮਲ ਗੁਰਿ ਧਨੁ ਦੀਆ",
      "start_time": 28.884,
      "end_time": 36.15
    },
    {
      "section_id": "section-4",
      "transcript": "ਮਿਲਿਆ ਨਿਥਾਵੇ ਥਾਉ",
      "start_time": 36.15,
      "end_time": 43.24
    },
    {
      "section_id": "section-5",
      "transcript": "ਸਾਚੀ ਪੂੰਜੀ ਸਚੁ ਸੰਜਮੋ ਆਠ ਪਹਰ ਗੁਣ ਗਾਉ",
      "start_time": 43.58,
      "end_time": 58.04
    },
    {
      "section_id": "section-6",
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭੁ ਭੇਟਿਆ ਮਰਣੁ ਨ ਆਵਣੁ ਜਾਉ",
      "start_time": 58.24,
      "end_time": 72.84
    },
    {
      "section_id": "section-7",
      "transcript": "ਮੇਰੇ ਮਨ ਹਰਿ ਭਜੁ ਸਦਾ ਇਕ ਰੰਗਿ",
      "start_time": 73.0,
      "end_time": 80.15
    },
    {
      "section_id": "section-8",
      "transcript": "ਘਟ ਘਟ ਅੰਤਰਿ ਰਵਿ ਰਹਿਆ ਸਦਾ ਸਹਾਈ ਸੰਗਿ ਰਹਾਉ",
      "start_time": 80.29,
      "end_time": 94.84
    },
    {
      "section_id": "section-9",
      "transcript": "ਸੁਖਾ ਕੀ ਮਿਤਿ ਕਿਆ ਗਣੀ ਜਾ ਸਿਮਰੀ, ਗੋਵਿੰਦੁ।",
      "start_time": 102.1,
      "end_time": 116.277
    },
    {
      "section_id": "section-10",
      "transcript": "ਜਿਨ ਚਾਖਿਆ ਸੇ ਤ੍ਰਿਪਤਾਸਿਆ",
      "start_time": 116.277,
      "end_time": 123.44
    },
    {
      "section_id": "section-11",
      "transcript": "ਉਹ ਰਸੁ ਜਾਣੈ ਜਿੰਦੁ",
      "start_time": 123.72,
      "end_time": 130.44
    },
    {
      "section_id": "section-12",
      "transcript": "ਸੰਤਾ ਸੰਗਤਿ ਮਨਿ ਵਸੈ ਪ੍ਰਭੁ ਪ੍ਰੀਤਮੁ ਬਖਸਿੰਦੁ",
      "start_time": 130.74,
      "end_time": 144.94
    },
    {
      "section_id": "section-13",
      "transcript": "ਜਿਨਿ ਸੇਵਿਆ ਪ੍ਰਭੁ ਆਪਣਾ",
      "start_time": 145.24,
      "end_time": 152.15
    },
    {
      "section_id": "section-14",
      "transcript": "ਸੋਈ ਰਾਜ ਨਰਿੰਦੁ",
      "start_time": 152.45,
      "end_time": 159.44
    },
    {
      "section_id": "section-15",
      "transcript": "ਅਉਸਰਿ ਹਰਿ ਜਸੁ ਗੁਣ ਰਮਣ ਜਿਤੁ ਕੋਟਿ ਮਜਨ ਇਸਨਾਨੁ",
      "start_time": 159.74,
      "end_time": 173.84
    },
    {
      "section_id": "section-16",
      "transcript": "ਰਸਨਾ ਉਚਰੈ ਗੁਣਵਤੀ ਕੋਇ ਨ ਪੁਜੈ ਦਾਨੁ",
      "start_time": 174.1,
      "end_time": 188.04
    },
    {
      "section_id": "section-17",
      "transcript": "ਦ੍ਰਿਸਟਿ ਧਾਰਿ ਮਨਿ ਤਨਿ ਵਸੈ ਦਇਆਲ ਪੁਰਖੁ ਮਿਹਰਵਾਨੁ",
      "start_time": 188.3,
      "end_time": 202.64
    },
    {
      "section_id": "section-18",
      "transcript": "ਜੀਉ ਪਿੰਡੁ ਧਨੁ ਤਿਸ ਦਾ",
      "start_time": 202.86,
      "end_time": 209.84
    },
    {

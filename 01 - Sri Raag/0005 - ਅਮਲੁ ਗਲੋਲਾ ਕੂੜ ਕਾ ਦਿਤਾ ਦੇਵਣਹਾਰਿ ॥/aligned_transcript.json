  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ",
      "start_time": 1.022,
      "end_time": 10.429
    },
    {
      "section_id": "section-2",
      "transcript": "ਮਹਲਾ, ਪਹਿਲਾ,",
      "start_time": 10.429,
      "end_time": 19.391
    },
    {
      "section_id": "section-3",
      "transcript": "ਅਮਲੁ ਗਲੋਲਾ, ਕੂੜ ਕਾ,",
      "start_time": 37.728,
      "end_time": 45.48
    },
    {
      "section_id": "section-4",
      "transcript": "ਦਿਤਾ ਦੇਵਣਹਾਰਿ",
      "start_time": 45.48,
      "end_time": 52.935
    },
    {
      "section_id": "section-5",
      "transcript": "ਮਤੀ ਮਰਣੁ, ਵਿਸਾਰਿਆ,",
      "start_time": 52.935,
      "end_time": 61.028
    },
    {
      "section_id": "section-6",
      "transcript": "ਖੁਸੀ ਕੀਤੀ ਦਿਨ ਚਾਰਿ",
      "start_time": 61.028,
      "end_time": 68.412
    },
    {
      "section_id": "section-7",
      "transcript": "ਸਚੁ ਮਿਲਿਆ ਤਿਨ ਸੋਫੀਆ",
      "start_time": 68.412,
      "end_time": 76.036
    },
    {
      "section_id": "section-8",
      "transcript": "ਰਾਖਣ ਕਉ ਦਰਵਾਰੁ",
      "start_time": 76.036,
      "end_time": 83.467
    },
    {
      "section_id": "section-9",
      "transcript": "ਨਾਨਕ ਸਾਚੇ, ਕਉ ਸਚੁ ਜਾਣੁ,",
      "start_time": 83.467,
      "end_time": 91.016
    },
    {
      "section_id": "section-10",
      "transcript": "ਜਿਤੁ ਸੇਵਿਐ ਸੁਖੁ, ਪਾਈਐ ਤੇਰੀ,",
      "start_time": 91.016,
      "end_time": 98.579
    },
    {
      "section_id": "section-11",
      "transcript": "ਦਰਗਹ ਚਲੈ ਮਾਣੁ, ਰਹਾਉ,",
      "start_time": 98.579,
      "end_time": 106.485
    },
    {
      "section_id": "section-12",
      "transcript": "ਸਚੁ ਸਰਾ ਗੁੜ ਬਾਹਰਾ",
      "start_time": 122.609,
      "end_time": 129.973
    },
    {
      "section_id": "section-13",
      "transcript": "ਜਿਸੁ ਵਿਚਿ ਸਚਾ ਨਾਉ",
      "start_time": 129.973,
      "end_time": 137.414
    },
    {
      "section_id": "section-14",
      "transcript": "ਸੁਣਹਿ ਵਖਾਣਹਿ, ਜੇਤੜੇ ਹਉ,",
      "start_time": 137.414,
      "end_time": 145.065
    },
    {
      "section_id": "section-15",
      "transcript": "ਤਿਨ ਬਲਿਹਾਰੈ, ਜਾਉ,",
      "start_time": 145.065,
      "end_time": 152.264
    },
    {
      "section_id": "section-16",
      "transcript": "ਤਾ ਮਨੁ ਖੀਵਾ, ਜਾਣੀਐ,",
      "start_time": 152.264,
      "end_time": 159.816
    },
    {
      "section_id": "section-17",
      "transcript": "ਜਾ ਮਹਲੀ ਪਾਏ ਥਾਉ",
      "start_time": 159.816,
      "end_time": 167.302
    },
    {
      "section_id": "section-18",
      "transcript": "ਨਾਉ ਨੀਰੁ ਚੰਗਿਆਈਆ।",
      "start_time": 174.981,
      "end_time": 182.172
    },
    {
      "section_id": "section-19",
      "transcript": "ਸਤੁ ਪਰਮਲੁ ਤਨਿ, ਵਾਸੁ,",
      "start_time": 182.172,
      "end_time": 189.679
    },
    {
      "section_id": "section-20",
      "transcript": "ਤਾ ਮੁਖੁ ਹੋਵੈ ਉਜਲਾ",
      "start_time": 189.679,
      "end_time": 197.163
    },
    {
      "section_id": "section-21",
      "transcript": "ਲਖ ਦਾਤੀ ਇਕ ਦਾਤਿ।",
      "start_time": 197.163,
      "end_time": 204.429
    },
    {
      "section_id": "section-22",
      "transcript": "ਦੂਖ ਤਿਸੈ ਪਹਿ ਆਖੀਅਹਿ",
      "start_time": 204.429,
      "end_time": 211.832
    },
    {
      "section_id": "section-23",
      "transcript": "ਸੂਖ ਜਿਸੈ ਹੀ ਪਾਸਿ।",
      "start_time": 211.832,
      "end_time": 219.41
    },
    {
      "section_id": "section-24",
      "transcript": "ਸੋ ਕਿਉ ਮਨਹੁ ਵਿਸਾਰੀਐ।",
      "start_time": 227.193,
      "end_time": 234.681
    },
    {
      "section_id": "section-25",
      "transcript": "ਜਾ ਕੇ ਜੀਅ ਪਰਾਣ",
      "start_time": 234.681,
      "end_time": 242.142
    },
    {
      "section_id": "section-26",
      "transcript": "ਤਿਸੁ ਵਿਣੁ ਸਭੁ ਅਪਵਿਤ੍ਰੁ ਹੈ",
      "start_time": 242.142,
      "end_time": 249.88
    },
    {
      "section_id": "section-27",
      "transcript": "ਜੇਤਾ ਪੈਨਣੁ ਖਾਣੁ।",
      "start_time": 249.88,
      "end_time": 257.343
    },
    {
      "section_id": "section-28",
      "transcript": "ਹੋਰਿ ਗਲਾਂ ਸਭਿ ਕੂੜੀਆ।",
      "start_time": 257.343,
      "end_time": 264.871
    },
    {
      "section_id": "section-29",
      "transcript": "ਤੁਧੁ ਭਾਵੈ ਪਰਵਾਣੁ",
      "start_time": 264.871,
      "end_time": 272.337
    },
    {
      "section_id": "section-30",
      "transcript": "ਹੋਰਿ ਗਲਾਂ ਸਭਿ ਕੂੜੀਆ।",
      "start_time": 287.472,
      "end_time": 295.03
    },
    {
      "section_id": "section-31",

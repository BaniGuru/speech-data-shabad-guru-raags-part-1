  "audio_file": "0027 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਤੀਜਾ",
      "start_time": 5.44,
      "end_time": 15.726
    },
    {
      "section_id": "section-2",
      "transcript": "ਆ।",
      "start_time": 15.726,
      "end_time": 22.472
    },
    {
      "section_id": "section-3",
      "transcript": "ਆਪਣਾ ਭਉ ਤਿਨ ਪਾਇਓਨੁ ਜਿਨ ਗੁਰ ਕਾ ਸਬਦੁ ਬੀਚਾਰਿ",
      "start_time": 39.56,
      "end_time": 53.76
    },
    {
      "section_id": "section-4",
      "transcript": "ਸਤਸੰਗਤੀ ਸਦਾ ਮਿਲਿ ਰਹੇ ਸਚੇ ਕੇ ਗੁਣ ਸਾਰਿ",
      "start_time": 53.88,
      "end_time": 68.22
    },
    {
      "section_id": "section-5",
      "transcript": "ਦੁਬਿਧਾ ਮੈਲੁ ਚੁਕਾਈਅਨੁ ਹਰਿ ਰਾਖਿਆ ਉਰ ਧਾਰਿ",
      "start_time": 68.32,
      "end_time": 82.56
    },
    {
      "section_id": "section-6",
      "transcript": "ਸਚੀ ਬਾਣੀ ਸਚੁ ਮਨਿ ਸਚੇ ਨਾਲਿ ਪਿਆਰੁ",
      "start_time": 82.7,
      "end_time": 96.84
    },
    {
      "section_id": "section-7",
      "transcript": "ਮਨ ਮੇਰੇ ਹਉਮੈ ਮੈਲੁ ਭਰ ਨਾਲਿ",
      "start_time": 96.98,
      "end_time": 111.18
    },
    {
      "section_id": "section-8",
      "transcript": "ਹਰਿ ਨਿਰਮਲੁ ਸਦਾ ਸੋਹਣਾ ਸਬਦਿ ਸਵਾਰਣਹਾਰੁ ਰਹਾਉ",
      "start_time": 111.36,
      "end_time": 129.168
    },
    {
      "section_id": "section-9",
      "transcript": "ਸਚੈ ਸਬਦਿ ਮਨੁ ਮੋਹਿਆ ਪ੍ਰਭਿ ਆਪੇ ਲਏ ਮਿਲਾਇ",
      "start_time": 132.64,
      "end_time": 146.88
    },
    {
      "section_id": "section-10",
      "transcript": "ਅਨਦਿਨੁ ਨਾਮੇ ਰਤਿਆ ਜੋਤੀ ਜੋਤਿ ਸਮਾਇ",
      "start_time": 147.1,
      "end_time": 161.1
    },
    {
      "section_id": "section-11",
      "transcript": "ਜੋਤੀ ਹੂ ਪ੍ਰਭੁ ਜਾਪਦਾ ਬਿਨੁ ਸਤਗੁਰ ਬੂਝ ਨ ਪਾਇ",
      "start_time": 161.34,
      "end_time": 175.44
    },
    {
      "section_id": "section-12",
      "transcript": "ਜਿਨ ਕਉ ਪੂਰਬਿ ਲਿਖਿਆ ਸਤਗੁਰੁ ਭੇਟਿਆ ਤਿਨ ਆਇ",
      "start_time": 175.64,
      "end_time": 189.54
    },
    {
      "section_id": "section-13",
      "transcript": "ਵਿਣੁ ਨਾਵੈ ਸਭ ਡੁਮਣੀ ਦੂਜੈ ਭਾਇ ਖੁਆਇ",
      "start_time": 189.74,
      "end_time": 203.82
    },
    {
      "section_id": "section-14",
      "transcript": "ਤਿਸੁ ਬਿਨੁ ਘੜੀ ਨ ਜੀਵਦੀ ਦੁਖੀ ਰੈਣਿ ਵਿਹਾਇ",
      "start_time": 203.96,
      "end_time": 218.237
    },
    {
      "section_id": "section-15",
      "transcript": "ਭਰਮਿ ਭੁਲਾਣਾ ਅੰਧੁਲਾ।",
      "start_time": 218.237,
      "end_time": 225.12
    },
    {
      "section_id": "section-16",
      "transcript": "ਫਿਰਿ ਫਿਰਿ ਆਵੈ ਜਾਇ",
      "start_time": 225.28,
      "end_time": 232.454
    },
    {
      "section_id": "section-17",
      "transcript": "ਨਦਰਿ ਕਰੇ ਪ੍ਰਭੁ ਆਪਣੀ",
      "start_time": 232.454,
      "end_time": 239.46
    },
    {
      "section_id": "section-18",
      "transcript": "ਆਪੇ ਲਏ ਮਿਲਾਇ।",
      "start_time": 239.72,
      "end_time": 246.694
    },
    {
      "section_id": "section-19",
      "transcript": "ਸਭੁ ਕਿਛੁ ਸੁਣਦਾ ਵੇਖਦਾ",
      "start_time": 246.694,
      "end_time": 253.68
    },
    {
      "section_id": "section-20",
      "transcript": "ਕਿਉ ਮੁਕਰਿ ਪਇਆ ਜਾਇ",
      "start_time": 253.82,
      "end_time": 260.88
    },
    {
      "section_id": "section-21",
      "transcript": "ਪਾਪੋ ਪਾਪੁ ਕਮਾਵਦੇ ਪਾਪੇ ਪਚਹਿ ਪਚਾਇ",
      "start_time": 261.02,
      "end_time": 275.22
    },
    {
      "section_id": "section-22",
      "transcript": "ਸੋ ਪ੍ਰਭੁ ਨਦਰਿ ਨ ਆਵਈ ਮਨਮੁਖਿ ਬੂਝ ਨ ਪਾਇ",
      "start_time": 275.4,
      "end_time": 289.74
    },
    {
      "section_id": "section-23",
      "transcript": "ਜਿਸੁ ਵੇਖਾਲੇ ਸੋਈ ਵੇਖੈ ਨਾਨਕ ਗੁਰਮੁਖਿ ਪਾਇ",
      "start_time": 289.92,
      "end_time": 304.02
    },
    {
      "section_id": "section-24",

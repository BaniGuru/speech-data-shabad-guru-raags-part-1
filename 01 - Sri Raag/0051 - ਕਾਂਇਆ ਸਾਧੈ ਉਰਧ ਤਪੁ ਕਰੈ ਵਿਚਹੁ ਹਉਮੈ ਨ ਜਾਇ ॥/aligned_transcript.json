      "start_time": 58.02,
      "end_time": 65.88
    },
    {
      "section_id": "section-6",
      "transcript": "ਅਧਿਆਤਮ ਕਰਮ ਜੇ ਕਰੇ ਨਾਮੁ ਨ ਕਬ ਹੀ ਪਾਇ",
      "start_time": 66.2,
      "end_time": 81.98
    },
    {
      "section_id": "section-7",
      "transcript": "ਗੁਰ ਕੈ ਸਬਦਿ ਜੀਵਤੁ ਮਰੈ ਹਰਿ ਨਾਮੁ ਵਸੈ ਮਨਿ ਆਇ",
      "start_time": 82.26,
      "end_time": 97.74
    },
    {
      "section_id": "section-8",
      "transcript": "ਸੁਣਿ ਮਨ ਮੇਰੇ ਭਜੁ ਸਤਗੁਰ ਸਰਣਾ",
      "start_time": 98.02,
      "end_time": 105.38
    },
    {

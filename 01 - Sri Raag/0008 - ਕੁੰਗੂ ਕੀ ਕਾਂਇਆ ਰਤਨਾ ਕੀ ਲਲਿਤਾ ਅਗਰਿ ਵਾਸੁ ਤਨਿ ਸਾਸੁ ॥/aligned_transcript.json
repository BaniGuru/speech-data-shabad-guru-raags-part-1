{
  "audio_file": "011 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪਹਿਲਾ",
      "start_time": 0.0,
      "end_time": 16.811
    },
    {
      "section_id": "section-2",
      "transcript": "ਕੁੰਗੂ ਕੀ ਕਾਂਇਆ ਰਤਨਾ ਕੀ ਲਲਿਤਾ, ਅਗਰਿ ਵਾਸੁ ਤਨਿ ਸਾਸੁ।",
      "start_time": 24.166,
      "end_time": 32.745
    },
    {
      "section_id": "section-3",
      "transcript": "ਅਠਸਠਿ ਤੀਰਥ ਕਾ ਮੁਖਿ ਟਿਕਾ, ਤਿਤੁ ਘਟਿ ਮਤਿ ਵਿਗਾਸੁ।",
      "start_time": 32.745,
      "end_time": 41.332
    },
    {
      "section_id": "section-4",
      "transcript": "ਓਤੁ ਮਤੀ ਸਾਲਾਹਣਾ, ਸਚੁ ਨਾਮੁ ਗੁਣਤਾਸੁ।",
      "start_time": 41.332,
      "end_time": 50.082
    },
    {
      "section_id": "section-5",
      "transcript": "ਬਾਬਾ ਹੋਰ ਮਤਿ, ਜੇ ਸਉ ਵੇਰ ਕਮਾਈਐ, ਕੂੜੈ ਕੂੜਾ ਜੋਰੁ ਰਹਾਉ।",
      "start_time": 50.082,
      "end_time": 64.228
    },
    {
      "section_id": "section-6",
      "transcript": "ਪੂਜ ਲਗੈ ਪੀਰੁ ਆਖੀਐ, ਸਭੁ ਮਿਲੈ ਸੰਸਾਰੁ।",
      "start_time": 76.09,
      "end_time": 84.484
    },
    {
      "section_id": "section-7",
      "transcript": "ਨਾਉ ਸਦਾਏ ਆਪਣਾ, ਹੋਵੈ ਸਿਧੁ ਸੁਮਾਰੁ।",
      "start_time": 84.484,
      "end_time": 93.06
    },
    {
      "section_id": "section-8",
      "transcript": "ਜਾ ਪਤਿ ਲੇਖੈ ਨਾ ਪਵੈ, ਸਭਾ ਪੂਜ ਖੁਆਰੁ।",
      "start_time": 93.06,
      "end_time": 102.176
    },
    {
      "section_id": "section-9",
      "transcript": "ਜਿਨ ਕਉ ਸਤਿਗੁਰਿ ਥਾਪਿਆ",
      "start_time": 114.439,
      "end_time": 122.324
    },
    {
      "section_id": "section-10",
      "transcript": "ਓਨਾ ਅੰਦਰਿ ਨਾਮੁ ਨਿਧਾਨੁ ਹੈ, ਨਾਮੋ ਪਰਗਟੁ ਹੋਇ।",
      "start_time": 122.324,
      "end_time": 131.557
    },
    {
      "section_id": "section-11",
      "transcript": "ਨਾਉ ਪੂਜੀਐ ਨਾਉ ਮੰਨੀਐ, ਅਖੰਡੁ ਸਦਾ ਸਚੁ ਸੋਇ।",
      "start_time": 131.557,
      "end_time": 139.748
    },
    {
      "section_id": "section-12",
      "transcript": "ਖੇਹੂ ਖੇਹ ਰਲਾਈਐ, ਤਾ ਜੀਉ ਕੇਹਾ ਹੋਇ।",
      "start_time": 152.375,
      "end_time": 160.596
    },
    {
      "section_id": "section-13",
      "transcript": "ਜਲੀਆ ਸਭਿ ਸਿਆਣਪਾ, ਉਠੀ ਚਲਿਆ ਰੋਇ।",
      "start_time": 160.596,
      "end_time": 168.822
    },
    {
      "section_id": "section-14",
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਵਿਸਾਰਿਐ, ਦਰਿ ਗਇਆ ਕਿਆ ਹੋਇ।",
      "start_time": 168.822,
      "end_time": 177.342
    },
    {
      "section_id": "section-15",
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਵਿਸਾਰਿਐ, ਦਰਿ ਗਇਆ ਕਿਆ ਹੋਇ।",
      "start_time": 177.342,
      "end_time": 185.844
    }
  ]
}

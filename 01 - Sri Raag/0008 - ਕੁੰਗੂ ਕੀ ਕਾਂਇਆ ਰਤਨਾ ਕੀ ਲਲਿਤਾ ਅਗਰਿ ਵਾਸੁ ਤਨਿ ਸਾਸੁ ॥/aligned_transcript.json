{
  "audio_file": "011 B Pb.mp3",
  "sections": [
    {
      "title": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪਹਿਲਾ",
      "section_id": "section-1",
      "start_time": 0,
      "end_time": 16811,
      "verified": true,
      "line_id": "28QX"
    },
    {
      "title": "ਕੁੰਗੂ ਕੀ ਕਾਂਇਆ ਰਤਨਾ ਕੀ ਲਲਿਤਾ, ਅਗਰਿ ਵਾਸੁ ਤਨਿ ਸਾਸੁ।",
      "section_id": "section-2",
      "start_time": 24166,
      "end_time": 32745,
      "verified": true,
      "line_id": "L30U"
    },
    {
      "title": "ਅਠਸਠਿ ਤੀਰਥ ਕਾ ਮੁਖਿ ਟਿਕਾ, ਤਿਤੁ ਘਟਿ ਮਤਿ ਵਿਗਾਸੁ।",
      "section_id": "section-3",
      "start_time": 32745,
      "end_time": 41332,
      "verified": true,
      "line_id": "TXG1"
    },
    {
      "title": "ਓਤੁ ਮਤੀ ਸਾਲਾਹਣਾ, ਸਚੁ ਨਾਮੁ ਗੁਣਤਾਸੁ।",
      "section_id": "section-4",
      "start_time": 41332,
      "end_time": 50082,
      "verified": true,
      "line_id": "BKJN"
    },
    {
      "title": "ਬਾਬਾ ਹੋਰ ਮਤਿ, ਜੇ ਸਉ ਵੇਰ ਕਮਾਈਐ, ਕੂੜੈ ਕੂੜਾ ਜੋਰੁ ਰਹਾਉ।",
      "section_id": "section-5",
      "start_time": 50082,
      "end_time": 64228,
      "verified": true,
      "line_id": "9008"
    },
    {
      "title": "ਪੂਜ ਲਗੈ ਪੀਰੁ ਆਖੀਐ, ਸਭੁ ਮਿਲੈ ਸੰਸਾਰੁ।",
      "section_id": "section-6",
      "start_time": 76090,
      "end_time": 84484,
      "verified": true,
      "line_id": "U0CW"
    },
    {
      "title": "ਨਾਉ ਸਦਾਏ ਆਪਣਾ, ਹੋਵੈ ਸਿਧੁ ਸੁਮਾਰੁ।",
      "section_id": "section-7",
      "start_time": 84484,
      "end_time": 93060,
      "verified": true,
      "line_id": "ZXPS"
    },
    {
      "title": "ਜਾ ਪਤਿ ਲੇਖੈ ਨਾ ਪਵੈ, ਸਭਾ ਪੂਜ ਖੁਆਰੁ।",
      "section_id": "section-8",
      "start_time": 93060,
      "end_time": 102176,
      "verified": true,
      "line_id": "0ZLQ"
    },
    {
      "title": "ਜਿਨ ਕਉ ਸਤਿਗੁਰਿ ਥਾਪਿਆ",
      "section_id": "section-9",
      "start_time": 114439,
      "end_time": 122324,
      "verified": true,
      "line_id": "CARQ"
    },
    {
      "title": "ਓਨਾ ਅੰਦਰਿ ਨਾਮੁ ਨਿਧਾਨੁ ਹੈ, ਨਾਮੋ ਪਰਗਟੁ ਹੋਇ।",
      "section_id": "section-10",
      "start_time": 122324,
      "end_time": 131557,
      "verified": true,
      "line_id": "DAXD"
    },
    {
      "title": "ਨਾਉ ਪੂਜੀਐ ਨਾਉ ਮੰਨੀਐ, ਅਖੰਡੁ ਸਦਾ ਸਚੁ ਸੋਇ।",
      "section_id": "section-11",
      "start_time": 131557,
      "end_time": 139748,
      "verified": true,
      "line_id": "5J3W"
    },
    {
      "title": "ਖੇਹੂ ਖੇਹ ਰਲਾਈਐ, ਤਾ ਜੀਉ ਕੇਹਾ ਹੋਇ।",
      "section_id": "section-12",
      "start_time": 152375,
      "end_time": 160596,
      "verified": true,
      "line_id": "XF96"
    },
    {
      "title": "ਜਲੀਆ ਸਭਿ ਸਿਆਣਪਾ, ਉਠੀ ਚਲਿਆ ਰੋਇ।",
      "section_id": "section-13",
      "start_time": 160596,
      "end_time": 168822,
      "verified": true,
      "line_id": "SAS5"
    },
    {
      "title": "ਨਾਨਕ ਨਾਮਿ ਵਿਸਾਰਿਐ, ਦਰਿ ਗਇਆ ਕਿਆ ਹੋਇ।",
      "section_id": "section-14",
      "start_time": 168822,
      "end_time": 177342,
      "verified": true,
      "line_id": "GFUS"
    },
    {
      "title": "ਨਾਨਕ ਨਾਮਿ ਵਿਸਾਰਿਐ, ਦਰਿ ਗਇਆ ਕਿਆ ਹੋਇ।",
      "section_id": "section-15",
      "start_time": 177342,
      "end_time": 185844,
      "verified": true,
      "line_id": "GFUS"
    }
  ]

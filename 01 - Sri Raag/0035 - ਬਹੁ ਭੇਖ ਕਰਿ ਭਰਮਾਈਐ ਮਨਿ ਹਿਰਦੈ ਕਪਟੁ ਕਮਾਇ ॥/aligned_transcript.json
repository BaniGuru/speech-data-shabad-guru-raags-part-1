    {
      "section_id": "section-13",
      "transcript": "ਸਤਸੰਗਤਿ ਮੇਲਿ ਮਿਲਾਇ",
      "start_time": 104.607,
      "end_time": 111.762
    },
    {
      "section_id": "section-14",
      "transcript": "ਜੇ ਲਖ ਇਸਤਰੀਆ ਭੋਗ ਕਰਹਿ, ਨਵ ਖੰਡ ਰਾਜੁ ਕਮਾਹਿ।",
      "start_time": 111.762,
      "end_time": 125.474
    },
    {
      "section_id": "section-15",
      "transcript": "ਬਿਨੁ ਸਤਗੁਰ ਸੁਖੁ ਨ ਪਾਵਈ",

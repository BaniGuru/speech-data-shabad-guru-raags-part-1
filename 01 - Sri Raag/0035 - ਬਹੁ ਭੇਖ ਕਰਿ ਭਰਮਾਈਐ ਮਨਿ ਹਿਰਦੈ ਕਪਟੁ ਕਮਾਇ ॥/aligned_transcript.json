    {
      "section_id": "section-3",
      "transcript": "ਬਹੁ ਭੇਖ ਕਰਿ ਭਰਮਾਈਐ",
      "start_time": 29.587,
      "end_time": 36.33
    },
    {
      "section_id": "section-4",
      "transcript": "ਮਨਿ ਹਿਰਦੈ ਕਪਟੁ ਕਮਾਇ",
      "start_time": 36.33,
      "end_time": 43.572
    },
    {
      "section_id": "section-5",
      "transcript": "ਹਰਿ ਕਾ ਮਹਲੁ ਨ ਪਾਵਈ",
      "start_time": 43.572,
      "end_time": 49.872

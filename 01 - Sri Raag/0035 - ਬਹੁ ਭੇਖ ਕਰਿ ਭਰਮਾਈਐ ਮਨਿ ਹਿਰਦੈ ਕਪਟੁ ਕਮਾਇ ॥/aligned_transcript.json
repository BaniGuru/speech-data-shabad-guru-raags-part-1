    {
      "section_id": "section-6",
      "transcript": "ਮਰਿ ਵਿਸਟਾ ਮਾਹਿ ਸਮਾਇ",
      "start_time": 49.872,
      "end_time": 57.184
    },
    {
      "section_id": "section-7",
      "transcript": "ਮਨ ਰੇ, ਗ੍ਰਿਹ ਹੀ ਮਾਹਿ ਉਦਾਸੁ।",
      "start_time": 57.184,
      "end_time": 64.145
    },
    {
      "section_id": "section-8",
      "transcript": "ਸਚੁ ਸੰਜਮੁ ਕਰਣੀ ਸੋ ਕਰੇ",
      "start_time": 64.145,
      "end_time": 70.871
    },
    {
      "section_id": "section-9",
      "transcript": "ਗੁਰਮੁਖਿ ਹੋਇ ਪਰਗਾਸੁ ਰਹਾਉ",
      "start_time": 70.871,
      "end_time": 79.536
    },
    {
      "section_id": "section-10",
      "transcript": "ਗੁਰ ਕੈ ਸਬਦਿ ਮਨੁ ਜੀਤਿਆ",

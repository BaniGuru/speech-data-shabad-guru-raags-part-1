{
  "audio_file": "0034 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ,",
      "start_time": 0.96,
      "end_time": 14.768
    },
    {
      "section_id": "section-2",
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ।",
      "start_time": 14.768,
      "end_time": 30.0
    },
    {
      "section_id": "section-3",
      "transcript": "ਸਭੇ ਗਲਾ ਵਿਸਰਨੁ ਇਕੋ ਵਿਸਰਿ ਨ ਜਾਉ",
      "start_time": 53.06,
      "end_time": 67.022
    },
    {
      "section_id": "section-4",
      "transcript": "ਧੰਧਾ ਸਭੁ ਜਲਾਇ ਕੈ ਗੁਰਿ ਨਾਮੁ ਦੀਆ ਸਚੁ ਸੁਆਉ",
      "start_time": 67.78,
      "end_time": 82.326
    },
    {
      "section_id": "section-5",
      "transcript": "ਆਸਾ ਸਭੇ ਲਾਹਿ ਕੈ ਇਕਾ ਆਸ ਕਮਾਉ",
      "start_time": 82.52,
      "end_time": 96.604
    },
    {
      "section_id": "section-6",
      "transcript": "ਜਿਨੀ ਸਤਿਗੁਰੁ ਸੇਵਿਆ ਤਿਨ ਅਗੈ ਮਿਲਿਆ ਥਾਉ",
      "start_time": 96.88,
      "end_time": 110.585
    },
    {
      "section_id": "section-7",
      "transcript": "ਮਨ ਮੇਰੇ ਕਰਤੇ ਨੋ ਸਾਲਾਹਿ",
      "start_time": 111.12,
      "end_time": 121.512
    },
    {
      "section_id": "section-8",
      "transcript": "ਸਭੇ ਛਡਿ ਸਿਆਣਪਾ।",
      "start_time": 121.512,
      "end_time": 128.58
    },
    {
      "section_id": "section-9",
      "transcript": "ਗੁਰ ਕੀ ਪੈਰੀ ਪਾਹਿ ਰਹਾਉ",
      "start_time": 128.58,
      "end_time": 138.0
    },
    {
      "section_id": "section-10",
      "transcript": "ਦੁਖ ਭੁਖ ਨਹ ਵਿਆਪਈ ਜੇ ਸੁਖਦਾਤਾ ਮਨਿ ਹੋਇ",
      "start_time": 145.232,
      "end_time": 158.638
    },
    {
      "section_id": "section-11",
      "transcript": "ਕਿਤ ਹੀ ਕੰਮਿ ਨ ਛਿਜੀਐ ਜਾ ਹਿਰਦੈ ਸਚਾ ਸੋਇ",
      "start_time": 158.94,
      "end_time": 172.1
    },
    {
      "section_id": "section-12",
      "transcript": "ਜਿਸੁ ਤੂੰ ਰਖਹਿ ਹਥ ਦੇ ਤਿਸੁ ਮਾਰਿ ਨ ਸਕੈ ਕੋਇ",
      "start_time": 172.1,
      "end_time": 185.182
    },
    {
      "section_id": "section-13",
      "transcript": "ਸੁਖਦਾਤਾ ਗੁਰੁ ਸੇਵੀਐ ਸਭਿ ਅਵਗਣ ਕਢੈ ਧੋਇ",
      "start_time": 185.46,
      "end_time": 197.0
    },
    {
      "section_id": "section-14",
      "transcript": "ਸੇਵਾ ਮੰਗੈ ਸੇਵਕੋ ਲਾਈਅਾਂ ਅਪੁਨੀ ਸੇਵ",
      "start_time": 211.04,
      "end_time": 223.569
    },
    {
      "section_id": "section-15",
      "transcript": "ਸਾਧੂ ਸੰਗੁ ਮਸਕਤੇ ਤੂਠੈ ਪਾਵਾ ਦੇਵ",
      "start_time": 223.72,
      "end_time": 236.258
    },
    {
      "section_id": "section-16",
      "transcript": "ਸਭੁ ਕਿਛੁ ਵਸਗਤਿ ਸਾਹਿਬੈ ਆਪੇ ਕਰਣ ਕਰੇਵ",
      "start_time": 236.28,
      "end_time": 248.658
    },
    {
      "section_id": "section-17",
      "transcript": "ਸਤਿਗੁਰ ਕੈ ਬਲਿਹਾਰਣੈ ਮਨਸਾ ਸਭ ਪੂਰੇਵ",
      "start_time": 248.78,
      "end_time": 260.958
    },
    {
      "section_id": "section-18",
      "transcript": "ਇਕੋ ਦਿਸੈ ਸਜਣੋ ਇਕੋ ਭਾਈ ਮੀਤੁ",
      "start_time": 273.66,
      "end_time": 285.854
    },
    {
      "section_id": "section-19",
      "transcript": "ਇਕਸੈ ਦੀ ਸਾਮਗਰੀ ਇਕਸੈ ਦੀ ਹੈ ਰੀਤਿ",
      "start_time": 286.0,
      "end_time": 297.994
    },
    {
      "section_id": "section-20",
      "transcript": "ਇਕਸ ਸਿਉ ਮਨੁ ਮਾਨਿਆ ਤਾ ਹੋਆ ਨਿਹਚਲੁ ਚੀਤੁ",
      "start_time": 298.28,
      "end_time": 309.826
    },
    {
      "section_id": "section-21",
      "transcript": "ਸਚੁ ਖਾਣਾ ਸਚੁ ਪੈਨਣਾ ਟੇਕ ਨਾਨਕ ਸਚੁ ਕੀਤੁ",
      "start_time": 309.826,
      "end_time": 322.259

  "audio_file": "0034 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ,",
      "start_time": 1.32,
      "end_time": 10.609
    },
    {
      "section_id": "section-2",
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ।",
      "start_time": 10.609,
      "end_time": 20.821
    },
    {
      "section_id": "section-3",
      "transcript": "ਸਭੇ ਥੋਕ ਪਰਾਪਤੇ ਜੇ ਆਵੈ ਇਕੁ ਹਥਿ",
      "start_time": 35.66,
      "end_time": 49.348
    },
    {
      "section_id": "section-4",
      "transcript": "ਜਨਮੁ ਪਦਾਰਥੁ ਸਫਲੁ ਹੈ ਜੇ ਸਚਾ ਸਬਦੁ ਕਥਿ",
      "start_time": 51.02,
      "end_time": 65.051
    },
    {
      "section_id": "section-5",
      "transcript": "ਗੁਰ ਤੇ ਮਹਲੁ ਪਰਾਪਤੇ ਜਿਸੁ ਲਿਖਿਆ ਹੋਵੈ ਮਥਿ",
      "start_time": 66.26,
      "end_time": 80.801
    },
    {
      "section_id": "section-6",
      "transcript": "ਮੇਰੇ ਮਨ ਏਕਸ ਸਿਉ ਚਿਤੁ ਲਾਇ",
      "start_time": 81.295,
      "end_time": 92.24
    },
    {
      "section_id": "section-7",
      "transcript": "ਏਕਸ ਬਿਨੁ ਸਭ ਧੰਧੁ ਹੈ, ਸਭ ਮਿਥਿਆ ਮੋਹੁ ਮਾਇ ਰਹਾਉ।",
      "start_time": 92.46,
      "end_time": 110.373
    },
    {
      "section_id": "section-8",
      "transcript": "ਲਖ ਖੁਸੀਆ ਪਾਤਿਸਾਹੀਆ ਜੇ ਸਤਿਗੁਰੁ ਨਦਰਿ ਕਰੇਇ",
      "start_time": 127.78,
      "end_time": 140.24
    },
    {
      "section_id": "section-9",
      "transcript": "ਨਿਮਖ ਏਕ ਹਰਿ ਨਾਮੁ ਦੇਇ ਮੇਰਾ ਮਨੁ ਤਨੁ ਸੀਤਲੁ ਹੋਇ",
      "start_time": 140.4,
      "end_time": 154.88
    },
    {
      "section_id": "section-10",
      "transcript": "ਜਿਸ ਕਉ ਪੂਰਬਿ ਲਿਖਿਆ ਤਿਨਿ ਸਤਿਗੁਰ ਚਰਨ ਗਹੇ",
      "start_time": 155.02,
      "end_time": 169.416
    },
    {
      "section_id": "section-11",
      "transcript": "ਸਫਲ ਮੂਰਤੁ ਸਫਲਾ ਘੜੀ",
      "start_time": 183.86,
      "end_time": 190.56
    },
    {
      "section_id": "section-12",
      "transcript": "ਜਿਤੁ ਸਚੇ ਨਾਲਿ ਪਿਆਰੁ",
      "start_time": 190.74,
      "end_time": 198.48
    },
    {
      "section_id": "section-13",
      "transcript": "ਦੂਖੁ ਸੰਤਾਪੁ ਨ ਲਗਈ",
      "start_time": 198.58,
      "end_time": 205.28
    },
    {
      "section_id": "section-14",
      "transcript": "ਜਿਸੁ ਹਰਿ ਕਾ ਨਾਮੁ ਅਧਾਰੁ",
      "start_time": 205.4,
      "end_time": 212.96
    },
    {
      "section_id": "section-15",
      "transcript": "ਬਾਹ ਪਕੜਿ ਗੁਰਿ ਕਾਢਿਆ",
      "start_time": 213.06,
      "end_time": 220.0
    },
    {
      "section_id": "section-16",
      "transcript": "ਸੋਈ ਉਤਰਿਆ ਪਾਰਿ",
      "start_time": 220.1,
      "end_time": 227.276
    },
    {
      "section_id": "section-17",
      "transcript": "ਥਾਨੁ ਸੁਹਾਵਾ ਪਵਿਤੁ ਹੈ",
      "start_time": 242.26,
      "end_time": 249.44
    },
    {
      "section_id": "section-18",
      "transcript": "ਜਿਥੈ ਸੰਤ ਸਭਾ",
      "start_time": 249.56,
      "end_time": 256.8
    },
    {
      "section_id": "section-19",
      "transcript": "ਢੋਈ ਤਿਸ ਹੀ ਨੋ ਮਿਲੈ",
      "start_time": 256.9,
      "end_time": 263.44
    },
    {
      "section_id": "section-20",
      "transcript": "ਜਿਨਿ ਪੂਰਾ ਗੁਰੂ ਲਭਾ",
      "start_time": 263.6,
      "end_time": 270.95
    },
    {
      "section_id": "section-21",
      "transcript": "ਨਾਨਕ ਬਧਾ ਘਰੁ ਤਹਾਂ",
      "start_time": 271.13,
      "end_time": 277.83
    },
    {

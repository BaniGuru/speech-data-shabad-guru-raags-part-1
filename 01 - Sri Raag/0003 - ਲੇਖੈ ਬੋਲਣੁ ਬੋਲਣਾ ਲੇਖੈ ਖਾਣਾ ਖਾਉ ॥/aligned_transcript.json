  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ",
      "start_time": 0.6,
      "end_time": 5.678
    },
    {
      "section_id": "section-2",
      "transcript": "ਮਹਲਾ ਪਹਿਲਾ",
      "start_time": 5.678,
      "end_time": 12.193
    },
    {
      "section_id": "section-3",
      "transcript": "ਲੇਖੈ ਬੋਲਣੁ ਬੋਲਣਾ ਲੇਖੈ ਖਾਣਾ ਖਾਉ",
      "start_time": 22.35,
      "end_time": 31.917
    },
    {
      "section_id": "section-4",
      "transcript": "ਲੇਖੈ ਵਾਟ ਚਲਾਈਆ ਲੇਖੈ ਸੁਣਿ ਵੇਖਾਉ",
      "start_time": 31.917,
      "end_time": 41.155
    },
    {
      "section_id": "section-5",
      "transcript": "ਲੇਖੈ ਸਾਹ ਲਵਾਈਅਹਿ ਪੜੇ ਕਿ ਪੁਛਣ ਜਾਉ",
      "start_time": 41.155,
      "end_time": 50.341
    },
    {
      "section_id": "section-6",
      "transcript": "ਬਾਬਾ ਮਾਇਆ ਰਚਨਾ ਧੋਹੁ ਅੰਧੈ ਨਾਮੁ ਵਿਸਾਰਿਆ",
      "start_time": 50.341,
      "end_time": 59.124
    },
    {
      "section_id": "section-7",
      "transcript": "ਨਾ ਤਿਸੁ ਏਹ ਨ ਓਹੁ ਰਹਾਉ",
      "start_time": 59.124,
      "end_time": 66.69
    },
    {
      "section_id": "section-8",
      "transcript": "ਜੀਵਣ ਮਰਣਾ ਜਾਇ ਕੈ ਏਥੈ ਖਾਜੈ ਕਾਲਿ",
      "start_time": 75.107,
      "end_time": 83.897
    },
    {
      "section_id": "section-9",
      "transcript": "ਜਿਥੈ ਬਹਿ ਸਮਝਾਈਐ, ਤਿਥੈ ਕੋਇ ਨ ਚਲਿਓ ਨਾਲਿ",
      "start_time": 83.897,
      "end_time": 92.846
    },
    {
      "section_id": "section-10",
      "transcript": "ਰੋਵਣ ਵਾਲੇ ਜੇਤੜੇ, ਸਭਿ ਬੰਨਹਿ ਪੰਡ ਪਰਾਲਿ",
      "start_time": 92.846,
      "end_time": 101.679
    },
    {
      "section_id": "section-11",
      "transcript": "ਸਭੁ ਕੋ ਆਖੈ ਬਹੁਤੁ ਬਹੁਤੁ ਘਟਿ ਨ ਆਖੈ ਕੋਇ",
      "start_time": 101.676,
      "end_time": 110.602
    },
    {
      "section_id": "section-12",
      "transcript": "ਕੀਮਤਿ ਕਿਨੈ ਨ ਪਾਈਆ, ਕਹਣਿ ਨ ਵਡਾ ਹੋਇ,",
      "start_time": 110.602,
      "end_time": 119.45
    },
    {
      "section_id": "section-13",
      "transcript": "ਸਾਚਾ ਸਾਹਬੁ ਏਕੁ ਤੂ, ਹੋਰਿ ਜੀਆ ਕੇਤੇ ਲੋਅ,",
      "start_time": 119.45,
      "end_time": 128.263
    },
    {
      "section_id": "section-14",
      "transcript": "ਨੀਚਾ ਅੰਦਰਿ ਨੀਚ ਜਾਤਿ, ਨੀਚੀ ਹੂ ਅਤਿ ਨੀਚੁ,",
      "start_time": 128.263,
      "end_time": 137.048
    },
    {
      "section_id": "section-15",
      "transcript": "ਨਾਨਕੁ ਤਿਨ ਕੈ ਸੰਗਿ ਸਾਥਿ, ਵਡਿਆ ਸਿਉ ਕਿਆ ਰੀਸ,",
      "start_time": 137.048,
      "end_time": 145.757
    },
    {
      "section_id": "section-16",
      "transcript": "ਜਿਥੈ ਨੀਚ ਸਮਾਲੀਅਨਿ, ਤਿਥੈ ਨਦਰਿ ਤੇਰੀ ਬਖਸੀਸ,",
      "start_time": 145.757,
      "end_time": 154.323
    },
    {
      "section_id": "section-17",
      "transcript": "ਜਿਥੈ ਨੀਚ ਸਮਾਲੀਅਨਿ, ਤਿਥੈ ਨਦਰਿ ਤੇਰੀ ਬਖਸੀਸ।",
      "start_time": 154.323,
      "end_time": 163.76
    }
  ]
}

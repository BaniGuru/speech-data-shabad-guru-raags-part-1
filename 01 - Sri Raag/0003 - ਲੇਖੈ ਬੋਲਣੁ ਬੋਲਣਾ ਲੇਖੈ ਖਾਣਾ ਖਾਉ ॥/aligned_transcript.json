  "sections": [
    {
      "title": "ਸਿਰੀਰਾਗੁ",
      "section_id": "section-1",
      "start_time": 600,
      "end_time": 5678,
      "verified": true,
      "line_id": "260S"
    },
    {
      "title": "ਮਹਲਾ ਪਹਿਲਾ",
      "section_id": "section-2",
      "start_time": 5678,
      "end_time": 12193,
      "verified": true,
      "line_id": null
    },
    {
      "title": "ਲੇਖੈ ਬੋਲਣੁ ਬੋਲਣਾ ਲੇਖੈ ਖਾਣਾ ਖਾਉ",
      "section_id": "section-3",
      "start_time": 22350,
      "end_time": 31917,
      "verified": true,
      "line_id": "E1AC"
    },
    {
      "title": "ਲੇਖੈ ਵਾਟ ਚਲਾਈਆ ਲੇਖੈ ਸੁਣਿ ਵੇਖਾਉ",
      "section_id": "section-4",
      "start_time": 31917,
      "end_time": 41155,
      "verified": true,
      "line_id": "J72A"
    },
    {
      "title": "ਲੇਖੈ ਸਾਹ ਲਵਾਈਅਹਿ ਪੜੇ ਕਿ ਪੁਛਣ ਜਾਉ",
      "section_id": "section-5",
      "start_time": 41155,
      "end_time": 50341,
      "verified": true,
      "line_id": "Q6E1"
    },
    {
      "title": "ਬਾਬਾ ਮਾਇਆ ਰਚਨਾ ਧੋਹੁ ਅੰਧੈ ਨਾਮੁ ਵਿਸਾਰਿਆ",
      "section_id": "section-6",
      "start_time": 50341,
      "end_time": 59124,
      "verified": true,
      "line_id": "VULP"
    },
    {
      "title": "ਨਾ ਤਿਸੁ ਏਹ ਨ ਓਹੁ ਰਹਾਉ",
      "section_id": "section-7",
      "start_time": 59124,
      "end_time": 66690,
      "verified": true,
      "line_id": "2JP8"
    },
    {
      "title": "ਜੀਵਣ ਮਰਣਾ ਜਾਇ ਕੈ ਏਥੈ ਖਾਜੈ ਕਾਲਿ",
      "section_id": "section-8",
      "start_time": 75107,
      "end_time": 83897,
      "verified": true,
      "line_id": "C9TN"
    },
    {
      "title": "ਜਿਥੈ ਬਹਿ ਸਮਝਾਈਐ, ਤਿਥੈ ਕੋਇ ਨ ਚਲਿਓ ਨਾਲਿ",
      "section_id": "section-9",
      "start_time": 83897,
      "end_time": 92846,
      "verified": true,
      "line_id": "ZTBF"
    },
    {
      "title": "ਰੋਵਣ ਵਾਲੇ ਜੇਤੜੇ, ਸਭਿ ਬੰਨਹਿ ਪੰਡ ਪਰਾਲਿ",
      "section_id": "section-10",
      "start_time": 92846,
      "end_time": 101679,
      "verified": true,
      "line_id": "YG3A"
    },
    {
      "title": "ਸਭੁ ਕੋ ਆਖੈ ਬਹੁਤੁ ਬਹੁਤੁ ਘਟਿ ਨ ਆਖੈ ਕੋਇ",
      "section_id": "section-11",
      "start_time": 101676,
      "end_time": 110602,
      "verified": true,
      "line_id": "VXLH"
    },
    {
      "title": "ਕੀਮਤਿ ਕਿਨੈ ਨ ਪਾਈਆ, ਕਹਣਿ ਨ ਵਡਾ ਹੋਇ,",
      "section_id": "section-12",
      "start_time": 110602,
      "end_time": 119450,
      "verified": true,
      "line_id": "4BJV"
    },
    {
      "title": "ਸਾਚਾ ਸਾਹਬੁ ਏਕੁ ਤੂ, ਹੋਰਿ ਜੀਆ ਕੇਤੇ ਲੋਅ,",
      "section_id": "section-13",
      "start_time": 119450,
      "end_time": 128263,
      "verified": true,
      "line_id": "ZZ8J"
    },
    {
      "title": "ਨੀਚਾ ਅੰਦਰਿ ਨੀਚ ਜਾਤਿ, ਨੀਚੀ ਹੂ ਅਤਿ ਨੀਚੁ,",
      "section_id": "section-14",
      "start_time": 128263,
      "end_time": 137048,
      "verified": true,
      "line_id": "RFV7"
    },
    {
      "title": "ਨਾਨਕੁ ਤਿਨ ਕੈ ਸੰਗਿ ਸਾਥਿ, ਵਡਿਆ ਸਿਉ ਕਿਆ ਰੀਸ,",
      "section_id": "section-15",
      "start_time": 137048,
      "end_time": 145757,
      "verified": true,
      "line_id": "GLEZ"
    },
    {
      "title": "ਜਿਥੈ ਨੀਚ ਸਮਾਲੀਅਨਿ, ਤਿਥੈ ਨਦਰਿ ਤੇਰੀ ਬਖਸੀਸ,",
      "section_id": "section-16",
      "start_time": 145757,
      "end_time": 154323,
      "verified": true,
      "line_id": "PY7S"
    },
    {
      "title": "ਜਿਥੈ ਨੀਚ ਸਮਾਲੀਅਨਿ, ਤਿਥੈ ਨਦਰਿ ਤੇਰੀ ਬਖਸੀਸ।",
      "section_id": "section-17",
      "start_time": 154323,
      "end_time": 163760,
      "verified": true,
      "line_id": "PY7S"
    }
  ]

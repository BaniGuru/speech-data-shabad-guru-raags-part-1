    {
      "section_id": "section-19",
      "transcript": "ਧੰਧਾ ਧਾਵਤ ਰਹਿ ਗਏ ਲਾਗਾ ਸਾਚਿ ਪਿਆਰੁ",
      "start_time": 306.58,
      "end_time": 320.803

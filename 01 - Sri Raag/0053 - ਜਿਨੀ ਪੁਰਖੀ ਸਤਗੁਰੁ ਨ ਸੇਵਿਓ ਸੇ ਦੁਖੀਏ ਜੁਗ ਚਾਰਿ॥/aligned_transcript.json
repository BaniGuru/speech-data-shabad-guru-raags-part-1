  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਤੀਜਾ",
      "start_time": 0.26,
      "end_time": 20.0
    },
    {
      "section_id": "section-2",
      "transcript": "ਜਿਨੀ ਪੁਰਖੀ ਸਤਗੁਰੁ ਨ ਸੇਵਿਓ ਸੇ ਦੁਖੀਏ ਜੁਗ ਚਾਰਿ",
      "start_time": 37.04,
      "end_time": 51.729
    },
    {
      "section_id": "section-3",
      "transcript": "ਘਰਿ ਹੋਦਾ ਪੁਰਖੁ ਨ ਪਛਾਣਿਆ ਅਭਿਮਾਨਿ ਮੁਠੇ ਅਹੰਕਾਰਿ",
      "start_time": 51.9,
      "end_time": 66.451
    },
    {
      "section_id": "section-4",
      "transcript": "ਸਤਗੁਰੂ ਕਿਆ ਫਿਟਕਿਆ ਮੰਗਿ ਥਕੇ ਸੰਸਾਰਿ",
      "start_time": 66.74,
      "end_time": 80.815
    },
    {
      "section_id": "section-5",
      "transcript": "ਸਚਾ ਸਬਦੁ ਨ ਸੇਵਿਓ ਸਭਿ ਕਾਜ ਸਵਾਰਣਹਾਰੁ",
      "start_time": 81.16,
      "end_time": 95.524
    },
    {
      "section_id": "section-6",
      "transcript": "ਮਨ ਮੇਰੇ ਸਦਾ ਹਰਿ ਵੇਖੁ ਹਦੂਰਿ",
      "start_time": 95.84,
      "end_time": 106.584
    },
    {
      "section_id": "section-7",
      "transcript": "ਜਨਮ ਮਰਨ ਦੁਖੁ ਪਰਹਰੈ।",
      "start_time": 106.584,
      "end_time": 113.997
    },
    {
      "section_id": "section-8",
      "transcript": "ਸਬਦਿ ਰਹਿਆ ਭਰਪੂਰਿ ਰਹਾਉ",
      "start_time": 114.16,
      "end_time": 125.059
    },
    {
      "section_id": "section-9",
      "transcript": "ਸਚੁ ਸਲਾਹਨਿ ਸੇ ਸਚੇ ਸਚਾ ਨਾਮੁ ਅਧਾਰੁ",
      "start_time": 143.1,
      "end_time": 157.381
    },
    {
      "section_id": "section-10",
      "transcript": "ਸਚੀ ਕਾਰ ਕਮਾਵਣੀ ਸਚੇ ਨਾਲਿ ਪਿਆਰੁ",
      "start_time": 157.72,
      "end_time": 172.027
    },
    {
      "section_id": "section-11",
      "transcript": "ਸਚਾ ਸਾਹੁ ਵਰਤਦਾ ਕੋਇ ਨ ਮੇਟਣਹਾਰੁ",
      "start_time": 172.36,
      "end_time": 186.952
    },
    {
      "section_id": "section-12",
      "transcript": "ਮਨਮੁਖ ਮਹਲੁ ਨ ਪਾਇਨੀ ਕੂੜਿ ਮੁਠੇ ਕੂੜਿਆਰ",
      "start_time": 187.16,
      "end_time": 201.606

{
  "audio_file": "0030 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ,",
      "start_time": 6.833,
      "end_time": 19.729
    },
    {
      "section_id": "section-2",
      "transcript": "ਮਹਲਾ ਤੀਜਾ।",
      "start_time": 19.729,
      "end_time": 32.529
    },
    {
      "section_id": "section-3",
      "transcript": "ਆ।",
      "start_time": 32.529,
      "end_time": 38.536
    },
    {
      "section_id": "section-4",
      "transcript": "ਹਰਿ ਜੀ ਸਚਾ ਸਚੁ ਤੂ ਸਭੁ ਕਿਛੁ ਤੇਰੈ ਚੀਰੈ",
      "start_time": 58.78,
      "end_time": 73.92
    },
    {
      "section_id": "section-5",
      "transcript": "ਲਖ ਚਉਰਾਸੀਹ ਤਰਸਦੇ ਫਿਰੇ ਬਿਨੁ ਗੁਰ ਭੇਟੇ ਪੀਰੈ",
      "start_time": 74.16,
      "end_time": 89.12
    },
    {
      "section_id": "section-6",
      "transcript": "ਹਰਿ ਜੀਉ ਬਖਸੇ ਬਖਸਿ ਲਏ ਸੂਖ ਸਦਾ ਸਰੀਰੈ",
      "start_time": 89.26,
      "end_time": 104.0
    },
    {
      "section_id": "section-7",
      "transcript": "ਗੁਰ ਪਰਸਾਦੀ ਸੇਵ ਕਰੀ ਸਚੁ ਗਹਿਰ ਗੰਭੀਰੈ",
      "start_time": 104.26,
      "end_time": 118.56
    },
    {
      "section_id": "section-8",
      "transcript": "ਮਨ ਮੇਰੇ ਨਾਮਿ ਰਤੇ ਸੁਖੁ ਹੋਇ।",
      "start_time": 118.82,
      "end_time": 129.268
    },
    {
      "section_id": "section-9",
      "transcript": "ਗੁਰਮਤੀ ਨਾਮੁ ਸਲਾਹੀਐ।",
      "start_time": 129.268,
      "end_time": 136.47
    },
    {
      "section_id": "section-10",
      "transcript": "ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਇ ਰਹਾਉ",
      "start_time": 136.69,
      "end_time": 147.28
    },
    {
      "section_id": "section-11",
      "transcript": "ਧਰਮ ਰਾਇ ਨੋ ਹੁਕਮੁ ਹੈ ਬਹਿ ਸਚਾ ਧਰਮੁ ਬੀਚਾਰਿ",
      "start_time": 154.03,
      "end_time": 167.6
    },
    {
      "section_id": "section-12",
      "transcript": "ਦੂਜੈ ਭਾਇ ਦੁਸਟੁ ਆਤਮਾ ਓਹੁ ਤੇਰੀ ਸਰਕਾਰ",
      "start_time": 167.84,
      "end_time": 181.2
    },
    {
      "section_id": "section-13",
      "transcript": "ਅਧਿਆਤਮੀ ਹਰਿ ਗੁਣ ਤਾਸੁ ਮਨਿ ਜਪਹਿ ਏਕੁ ਮੁਰਾਰਿ",
      "start_time": 181.42,
      "end_time": 194.56
    },
    {
      "section_id": "section-14",
      "transcript": "ਤਿਨ ਕੀ ਸੇਵਾ ਧਰਮ ਰਾਇ ਕਰੈ ਧੰਨੁ ਸਵਾਰਣਹਾਰੁ",
      "start_time": 194.68,
      "end_time": 207.2
    },
    {
      "section_id": "section-15",
      "transcript": "ਮਨ ਕੇ ਬਿਕਾਰ ਮਨਹਿ ਤਜੈ ਮਨਿ ਚੂਕੈ ਮੋਹੁ ਅਭਿਮਾਨੁ",
      "start_time": 220.058,
      "end_time": 233.44
    },
    {
      "section_id": "section-16",
      "transcript": "ਆਤਮ ਰਾਮੁ ਪਛਾਣਿਆ ਸਹਜੇ ਨਾਮਿ ਸਮਾਨੁ",
      "start_time": 233.44,
      "end_time": 246.24
    },
    {
      "section_id": "section-17",
      "transcript": "ਬਿਨੁ ਸਤਿਗੁਰ ਮੁਕਤਿ ਨ ਪਾਈਐ ਮਨਮੁਖਿ ਫਿਰੈ ਦਿਵਾਨੁ",
      "start_time": 246.5,
      "end_time": 258.95
    },
    {
      "section_id": "section-18",
      "transcript": "ਸਬਦੁ ਨ ਚੀਨੈ ਕਥਨੀ ਬਦਨੀ ਕਰੇ ਬਿਖਿਆ ਮਾਹਿ ਸਮਾਨੁ",
      "start_time": 259.13,
      "end_time": 271.27
    },
    {
      "section_id": "section-19",
      "transcript": "ਸਭੁ ਕਿਛੁ ਆਪੇ ਆਪਿ ਹੈ ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਇ",
      "start_time": 283.93,
      "end_time": 296.24
    },
    {
      "section_id": "section-20",
      "transcript": "ਜਿਉ ਬੋਲਾਏ ਤਿਉ ਬੋਲੀਐ ਜਾ ਆਪਿ ਬੁਲਾਏ ਸੋਇ",
      "start_time": 296.48,
      "end_time": 308.64
    },
    {
      "section_id": "section-21",
      "transcript": "ਗੁਰਮੁਖਿ ਬਾਣੀ ਬ੍ਰਹਮੁ ਹੈ ਸਬਦਿ ਮਿਲਾਵਾ ਹੋਇ",
      "start_time": 308.88,
      "end_time": 320.95
    },
    {
      "section_id": "section-22",
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਸਮਾਲਿ ਤੂ ਜਿਤੁ ਸੇਵਿਐ ਸੁਖੁ ਹੋਇ",
      "start_time": 321.21,
      "end_time": 333.28
    },
    {
      "section_id": "section-23",
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਸਮਾਲਿ ਤੂ ਜਿਤੁ ਸੇਵਿਐ ਸੁਖੁ ਹੋਇ",
      "start_time": 345.72,

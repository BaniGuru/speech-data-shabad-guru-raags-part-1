  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪਹਿਲਾ।",
      "start_time": 0.612,
      "end_time": 12.551
    },
    {
      "section_id": "section-2",
      "transcript": "ਘਰੁ ਚੌਥਾ।",
      "start_time": 12.551,
      "end_time": 25.358
    },
    {
      "section_id": "section-3",
      "transcript": "ਆ।",
      "start_time": 25.358,
      "end_time": 31.287
    },
    {
      "section_id": "section-4",
      "transcript": "ਏਕੁ, ਸੁਆਨੁ, ਦੁਇ ਸੁਆਨੀ ਨਾਲਿ।",
      "start_time": 41.268,
      "end_time": 46.234
    },
    {
      "section_id": "section-5",
      "transcript": "ਭਲਕੇ ਭਉਕਹਿ, ਸਦਾ ਬਇਆਲਿ,",
      "start_time": 46.234,
      "end_time": 52.03
    },
    {
      "section_id": "section-6",
      "transcript": "ਏਕੁ ਸੁਆਨੁ, ਦੁਇ ਸੁਆਨੀ ਨਾਲਿ,",
      "start_time": 62.395,
      "end_time": 67.799
    },
    {
      "section_id": "section-7",
      "transcript": "ਭਲਕੇ ਭਉਕਹਿ, ਸਦਾ ਬਇਆਲਿ।",
      "start_time": 67.799,
      "end_time": 72.987
    },
    {
      "section_id": "section-8",
      "transcript": "ਕੂੜੁ ਛੁਰਾ, ਮੁਠਾ ਮੁਰਦਾਰੁ।",
      "start_time": 72.987,
      "end_time": 78.326
    },
    {
      "section_id": "section-9",
      "transcript": "ਧਾਣਕ ਰੂਪਿ ਰਹਾ",
      "start_time": 78.326,
      "end_time": 84.127
    },
    {
      "section_id": "section-10",
      "transcript": "ਕੂੜੁ ਛੁਰਾ, ਮੁਠਾ ਮੁਰਦਾਰੁ।",
      "start_time": 94.536,
      "end_time": 99.935
    },
    {
      "section_id": "section-11",
      "transcript": "ਧਾਣਕ ਰੂਪਿ ਰਹਾ, ਕਰਤਾਰ।",
      "start_time": 99.935,
      "end_time": 105.038
    },
    {
      "section_id": "section-12",
      "transcript": "ਮੈ ਪਤਿ ਕੀ ਪੰਦਿ ਨ ਕਰਣੀ ਕੀ ਕਾਰ",
      "start_time": 105.038,
      "end_time": 110.374
    },
    {
      "section_id": "section-13",
      "transcript": "ਹਉ ਬਿਗੜੈ ਰੂਪਿ, ਰਹਾ ਬਿਕਰਾਲ।",
      "start_time": 110.374,
      "end_time": 116.004
    },
    {
      "section_id": "section-14",
      "transcript": "ਤੇਰਾ ਏਕੁ ਨਾਮੁ, ਤਾਰੇ ਸੰਸਾਰੁ।",
      "start_time": 116.004,
      "end_time": 121.225
    },
    {
      "section_id": "section-15",
      "transcript": "ਮੈ ਏਹਾ ਆਸ, ਏਹੋ ਆਧਾਰੁ ਰਹਾਉ।",
      "start_time": 121.225,
      "end_time": 129.262
    },
    {
      "section_id": "section-16",
      "transcript": "ਮੁਖਿ ਨਿੰਦਾ ਆਖਾ, ਦਿਨੁ ਰਾਤਿ।",
      "start_time": 142.768,
      "end_time": 147.884
    },
    {
      "section_id": "section-17",
      "transcript": "ਪਰ ਘਰੁ ਜੋਹੀ, ਨੀਚ ਸਨਾਤਿ।",
      "start_time": 147.884,
      "end_time": 153.331
    },
    {
      "section_id": "section-18",
      "transcript": "ਕਾਮੁ ਕ੍ਰੋਧੁ, ਤਨਿ ਵਸਹਿ ਚੰਡਾਲ।",
      "start_time": 153.331,
      "end_time": 158.544
    },
    {
      "section_id": "section-19",
      "transcript": "ਧਾਣਕ ਰੂਪਿ ਰਹਾ, ਕਰਤਾਰ।",
      "start_time": 158.544,
      "end_time": 163.96
    },
    {
      "section_id": "section-20",
      "transcript": "ਫਾਹੀ ਸੁਰਤਿ, ਮਲੂਕੀ ਵੇਸੁ।",
      "start_time": 163.96,
      "end_time": 169.482
    },
    {
      "section_id": "section-21",
      "transcript": "ਹਉ ਠਗਵਾੜਾ, ਠਗੀ ਦੇਸੁ।",
      "start_time": 169.482,
      "end_time": 175.087
    },
    {
      "section_id": "section-22",
      "transcript": "ਖਰਾ ਸਿਆਣਾ, ਬਹੁਤਾ ਭਾਰੁ।",
      "start_time": 184.969,
      "end_time": 190.545
    },
    {
      "section_id": "section-23",
      "transcript": "ਧਾਣਕ ਰੂਪਿ ਰਹਾ, ਕਰਤਾਰ, ਮੈ ਕੀਤਾ ਨ ਜਾਤਾ, ਹਰਾਮਖੋਰੁ।",
      "start_time": 190.545,
      "end_time": 200.787
    },
    {
      "section_id": "section-24",
      "transcript": "ਹਉ ਕਿਆ ਮੁਹੁ ਦੇਸਾ, ਦੁਸਟੁ ਚੋਰੁ।",
      "start_time": 200.787,
      "end_time": 206.353
    },
    {
      "section_id": "section-25",
      "transcript": "ਨਾਨਕੁ ਨੀਚੁ, ਕਹੈ ਬੀਚਾਰੁ।",
      "start_time": 206.353,
      "end_time": 211.798
    },
    {
      "section_id": "section-26",
      "transcript": "ਧਾਣਕ ਰੂਪਿ ਰਹਾ, ਕਰਤਾਰ।",
      "start_time": 211.798,
      "end_time": 217.18
    },
    {

  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਤੀਜਾ",
      "start_time": 4.57,
      "end_time": 20.637
    },
    {
      "section_id": "section-2",
      "transcript": "ਆ।",
      "start_time": 20.637,
      "end_time": 26.22
    },
    {
      "section_id": "section-3",
      "transcript": "ਹਰਿ ਭਗਤਾ ਹਰਿ ਧਨੁ ਰਾਸਿ ਹੈ ਗੁਰ ਪੂਛਿ ਕਰਹਿ ਵਾਪਾਰੁ",
      "start_time": 32.76,
      "end_time": 46.14
    },
    {
      "section_id": "section-4",
      "transcript": "ਹਰਿ ਨਾਮੁ ਸਲਾਹਨਿ ਸਦਾ ਸਦਾ ਵਖਰੁ ਹਰਿ ਨਾਮੁ ਅਧਾਰੁ",
      "start_time": 46.32,
      "end_time": 59.46
    },
    {
      "section_id": "section-5",
      "transcript": "ਗੁਰਿ ਪੂਰੈ ਹਰਿ ਨਾਮੁ ਦ੍ਰਿੜਾਇਆ ਹਰਿ ਭਗਤਾ ਅਤੁਟੁ ਭੰਡਾਰੁ",
      "start_time": 59.68,
      "end_time": 72.95
    },
    {
      "section_id": "section-6",
      "transcript": "ਭਾਈ ਰੇ, ਇਸੁ ਮਨ ਕਉ ਸਮਝਾਇ।",
      "start_time": 73.15,
      "end_time": 86.529
    },
    {
      "section_id": "section-7",
      "transcript": "ਏ ਮਨ ਆਲਸੁ ਕਿਆ ਕਰਹਿ ਗੁਰਮੁਖਿ ਨਾਮੁ ਧਿਆਇ ਰਹਾਉ",
      "start_time": 86.529,
      "end_time": 102.86
    },
    {
      "section_id": "section-8",
      "transcript": "ਹਰਿ ਭਗਤਿ ਹਰਿ ਕਾ ਪਿਆਰੁ ਹੈ ਜੇ ਗੁਰਮੁਖਿ ਕਰੇ ਬੀਚਾਰੁ",
      "start_time": 109.92,
      "end_time": 123.14
    },
    {
      "section_id": "section-9",
      "transcript": "ਪਾਖੰਡਿ ਭਗਤਿ ਨ ਹੋਵਈ ਦੁਬਿਧਾ ਬੋਲੁ ਖੁਆਰੁ",
      "start_time": 123.34,
      "end_time": 136.46
    },
    {
      "section_id": "section-10",
      "transcript": "ਸੋ ਜਨੁ ਰਲਾਇਆ ਨਾ ਰਲੈ ਜਿਸੁ ਅੰਤਰਿ ਬਿਬੇਕ ਬੀਚਾਰੁ",
      "start_time": 136.66,
      "end_time": 149.78
    },
    {
      "section_id": "section-11",
      "transcript": "ਸੋ ਸੇਵਕੁ ਹਰਿ ਆਖੀਐ ਜੋ ਹਰਿ ਰਾਖੈ ਉਰਿ ਧਾਰਿ",
      "start_time": 149.98,
      "end_time": 162.97
    },
    {
      "section_id": "section-12",
      "transcript": "ਮਨੁ ਤਨੁ ਸਉਪੇ ਆਗੈ ਧਰੇ ਹਉਮੈ ਵਿਚਹੁ ਮਾਰਿ",
      "start_time": 163.23,
      "end_time": 176.24
    },
    {
      "section_id": "section-13",
      "transcript": "ਧਨੁ ਗੁਰਮੁਖਿ ਸੋ ਪਰਵਾਣੁ ਹੈ ਜਿ ਕਦੇ ਨ ਆਵੈ ਹਾਰਿ",
      "start_time": 176.46,
      "end_time": 189.44
    },
    {
      "section_id": "section-14",
      "transcript": "ਕਰਮਿ ਮਿਲੈ ਤਾ ਪਾਈਐ ਵਿਣੁ ਕਰਮੈ ਪਾਇਆ ਨ ਜਾਇ",
      "start_time": 189.66,
      "end_time": 202.64
    },
    {
      "section_id": "section-15",
      "transcript": "ਲਖ ਚਉਰਾਸੀਹ ਤਰਸਦੇ ਜਿਸੁ ਮੇਲੇ ਸੋ ਮਿਲੈ ਹਰਿ ਆਇ",
      "start_time": 202.96,
      "end_time": 215.84
    },
    {
      "section_id": "section-16",
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਹਰਿ ਪਾਇਆ ਸਦਾ ਹਰਿ ਨਾਮਿ ਸਮਾਇ",
      "start_time": 216.14,
      "end_time": 228.8
    },
    {

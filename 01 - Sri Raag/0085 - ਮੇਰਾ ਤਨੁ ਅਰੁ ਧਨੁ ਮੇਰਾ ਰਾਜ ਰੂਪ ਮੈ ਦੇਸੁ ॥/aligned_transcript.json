  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪੰਜਵਾ",
      "start_time": 0.58,
      "end_time": 17.94
    },
    {
      "section_id": "section-2",
      "transcript": "ਮੇਰਾ ਤਨੁ ਅਰੁ ਧਨੁ ਮੇਰਾ ਰਾਜ ਰੂਪ ਮੈ ਦੇਸੁ",
      "start_time": 35.58,
      "end_time": 50.36
    },
    {
      "section_id": "section-3",
      "transcript": "ਸੁਤ ਦਾਰਾ ਬਨਿਤਾ ਅਨੇਕ ਬਹੁਤੁ ਰੰਗ ਅਰੁ ਵੇਸ।",
      "start_time": 50.36,
      "end_time": 64.259
    },
    {
      "section_id": "section-4",
      "transcript": "ਹਰਿ ਨਾਮੁ ਰਿਦੈ ਨ ਵਸਈ ਕਾਰਜਿ ਕਿਤੈ ਨ ਲੇਖਿ।",
      "start_time": 64.259,
      "end_time": 78.23
    },
    {
      "section_id": "section-5",
      "transcript": "ਮੇਰੇ ਮਨ ਹਰਿ ਹਰਿ ਨਾਮੁ ਧਿਆਇ।",
      "start_time": 94.1,
      "end_time": 108.764
    },
    {
      "section_id": "section-6",
      "transcript": "ਕਰਿ ਸੰਗਤਿ ਨਿਤ ਸਾਧ ਕੀ ਗੁਰ ਚਰਣੀ ਚਿਤੁ ਲਾਇ ਰਹਾਉ",
      "start_time": 108.764,
      "end_time": 125.787
    },
    {
      "section_id": "section-7",
      "transcript": "ਨਾਮੁ ਨਿਧਾਨੁ ਧਿਆਈਐ ਮਸਤਕਿ ਹੋਵੈ ਭਾਗੁ।",
      "start_time": 150.39,
      "end_time": 165.242
    },
    {
      "section_id": "section-8",
      "transcript": "ਕਾਰਜ ਸਭਿ ਸਵਾਰੀਅਹਿ ਗੁਰ ਕੀ ਚਰਣੀ ਲਾਗੁ।",
      "start_time": 165.242,
      "end_time": 179.84
    },
    {
      "section_id": "section-9",
      "transcript": "ਹਉਮੈ ਰੋਗੁ ਭ੍ਰਮੁ ਕਟੀਐ ਨਾ ਆਵੈ ਨਾ ਜਾਗੁ",
      "start_time": 180.42,
      "end_time": 195.232
    },
    {
      "section_id": "section-10",
      "transcript": "ਕਰਿ ਸੰਗਤਿ ਤੂ ਸਾਧ ਕੀ ਅਠਸਠਿ ਤੀਰਥ ਨਾਉ।",
      "start_time": 209.54,
      "end_time": 223.872
    },
    {
      "section_id": "section-11",
      "transcript": "ਜੀਉ ਪ੍ਰਾਣ ਮਨੁ ਤਨੁ ਹਰੇ ਸਾਚਾ ਏਹੁ ਸੁਆਉ।",
      "start_time": 223.872,
      "end_time": 238.643
    },
    {
      "section_id": "section-12",
      "transcript": "ਐਥੈ ਮਿਲਹਿ ਵਡਾਈਆ ਦਰਗਹਿ ਪਾਵਹਿ ਥਾਉ",
      "start_time": 239.08,
      "end_time": 253.954
    },
    {
      "section_id": "section-13",
      "transcript": "ਕਰੇ ਕਰਾਏ ਆਪਿ ਪ੍ਰਭੁ ਸਭੁ ਕਿਛੁ ਤਿਸ ਹੀ ਹਾਥਿ।",
      "start_time": 268.2,
      "end_time": 282.86
    },
    {
      "section_id": "section-14",
      "transcript": "ਮਾਰਿ ਆਪੇ ਜੀਵਾਲਦਾ ਅੰਤਰਿ ਬਾਹਰਿ ਸਾਥਿ।",
      "start_time": 282.86,
      "end_time": 297.385
    },
    {
      "section_id": "section-15",
      "transcript": "ਨਾਨਕ ਪ੍ਰਭ ਸਰਣਾਗਤੀ ਸਰਬ ਘਟਾ ਕੇ ਨਾਥ",
      "start_time": 297.66,

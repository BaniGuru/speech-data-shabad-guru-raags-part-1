    {
      "section_id": "section-2",
      "transcript": "ਚੌਥਾ ਘਰੁ ਪਹਿਲਾ",
      "start_time": 11.48,
      "end_time": 18.953
    },
    {
      "section_id": "section-3",
      "transcript": "ਮੈ ਮਨਿ ਤਨਿ ਬਿਰਹੁ ਅਤਿ ਅਗਲਾ ਕਿਉ ਪ੍ਰੀਤਮੁ ਮਿਲੈ ਘਰਿ ਆਇ",
      "start_time": 34.99,
      "end_time": 49.417
    },
    {
      "section_id": "section-4",
      "transcript": "ਜਾ ਦੇਖਾ ਪ੍ਰਭੁ ਆਪਣਾ ਪ੍ਰਭਿ ਦੇਖਿਐ ਦੁਖੁ ਜਾਇ",
      "start_time": 49.64,
      "end_time": 64.006
    },
    {
      "section_id": "section-5",
      "transcript": "ਜਾਇ ਪੁਛਾ ਤਿਨ ਸਜਣਾ ਪ੍ਰਭੁ ਕਿਤੁ ਬਿਧਿ ਮਿਲੈ ਮਿਲਾਇ",
      "start_time": 64.62,
      "end_time": 78.732
    },
    {
      "section_id": "section-6",
      "transcript": "ਮੇਰੇ ਸਤਿਗੁਰਾ ਮੈ ਤੁਝ ਬਿਨੁ ਅਵਰੁ ਨ ਕੋਇ",
      "start_time": 79.3,
      "end_time": 89.79
    },
    {
      "section_id": "section-7",
      "transcript": "ਹਮ ਮੂਰਖ ਮੁਗਧ ਸਰਣਾਗਤੀ ਕਰਿ ਕਿਰਪਾ ਮੇਲੇ ਹਰਿ ਸੋਇ ਰਹਾਉ",
      "start_time": 90.16,
      "end_time": 106.84
    },
    {
      "section_id": "section-8",
      "transcript": "ਸਤਿਗੁਰੁ ਦਾਤਾ ਹਰਿ ਨਾਮ ਕਾ ਪ੍ਰਭੁ ਆਪਿ ਮਿਲਾਵੈ ਸੋਇ",
      "start_time": 115.2,
      "end_time": 128.945
    },
    {
      "section_id": "section-9",
      "transcript": "ਸਤਿਗੁਰਿ ਹਰਿ ਪ੍ਰਭੁ ਬੁਝਿਆ",
      "start_time": 129.16,
      "end_time": 135.983
    },
    {
      "section_id": "section-10",
      "transcript": "ਗੁਰ ਜੇਵਡੁ ਅਵਰੁ ਨ ਕੋਇ।",
      "start_time": 136.24,
      "end_time": 143.046
    },
    {
      "section_id": "section-11",
      "transcript": "ਹਉ ਗੁਰ ਸਰਣਾਈ ਢਹਿ ਪਵਾ ਕਰਿ ਦਇਆ ਮੇਲੇ ਪ੍ਰਭੁ ਸੋਇ",
      "start_time": 143.046,
      "end_time": 156.896
    },
    {
      "section_id": "section-12",
      "transcript": "ਮਨਹਠਿ ਕਿਨੈ ਨ ਪਾਇਆ ਕਰਿ ਉਪਾਵ ਥਕੇ ਸਭੁ ਕੋਇ",
      "start_time": 171.24,
      "end_time": 184.746
    },
    {
      "section_id": "section-13",
      "transcript": "ਸਹਸ ਸਿਆਣਪ ਕਰਿ ਰਹੇ ਮਨਿ ਕੋਰੈ ਰੰਗੁ ਨ ਹੋਇ",
      "start_time": 185.02,
      "end_time": 198.404
    },
    {
      "section_id": "section-14",
      "transcript": "ਕੂੜਿ ਕਪਟਿ ਕਿਨੈ ਨ ਪਾਇਓ ਜੋ ਬੀਜੈ ਖਾਵੈ ਸੋਇ",

    {
      "section_id": "section-4",
      "transcript": "ਦਰਿ ਸੇਵਨਿ ਸੰਤ ਜਨ ਖੜੇ ਪਾਇਨਿ ਗੁਣੀ ਨਿਧਾਨੁ",
      "start_time": 58.68,
      "end_time": 69.28
    },
    {
      "section_id": "section-5",
      "transcript": "ਮੇਰੇ ਮਨ ਗੁਰ ਮੁਖਿ ਧਿਆਇ ਹਰਿ ਸੋਇ",
      "start_time": 79.74,
      "end_time": 87.04
    },
    {
      "section_id": "section-6",
      "transcript": "ਗੁਰ ਕਾ ਸਬਦੁ ਮਨਿ ਵਸੈ ਮਨੁ ਤਨੁ ਨਿਰਮਲੁ ਹੋਇ ਰਹਾਉ",
      "start_time": 87.04,
      "end_time": 99.693

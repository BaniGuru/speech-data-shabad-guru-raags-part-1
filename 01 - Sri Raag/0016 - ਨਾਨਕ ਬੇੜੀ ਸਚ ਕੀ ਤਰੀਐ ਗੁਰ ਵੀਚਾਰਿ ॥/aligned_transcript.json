      "transcript": "ਮਹਲਾ ਪਹਿਲਾ",
      "start_time": 13.086,
      "end_time": 26.503
    },
    {
      "section_id": "section-3",
      "transcript": "ਨਾਨਕ ਬੇੜੀ ਸਚ ਕੀ।",
      "start_time": 41.867,
      "end_time": 49.222
    },
    {
      "section_id": "section-4",
      "transcript": "ਤਰੀਐ ਗੁਰ ਵੀਚਾਰਿ।",
      "start_time": 49.222,
      "end_time": 56.24
    },
    {
      "section_id": "section-5",
      "transcript": "ਇਕਿ ਆਵਹਿ ਇਕਿ ਜਾਵਹੀ।",
      "start_time": 56.24,
      "end_time": 63.908
    },
    {
      "section_id": "section-6",
      "transcript": "ਪੂਰਿ ਭਰੇ ਅਹੰਕਾਰਿ।",
      "start_time": 63.908,
      "end_time": 70.872
    },
    {
      "section_id": "section-7",
      "transcript": "ਮਨਹਠਿ ਮਤੀ ਬੂਡੀਐ।",
      "start_time": 70.872,
      "end_time": 77.935
    },
    {
      "section_id": "section-8",
      "transcript": "ਗੁਰਮੁਖਿ ਸਚੁ ਸੁ ਤਾਰਿ।",
      "start_time": 77.935,
      "end_time": 85.283
    },
    {
      "section_id": "section-9",
      "transcript": "ਗੁਰ ਬਿਨੁ, ਕਿਉ ਤਰੀਐ ਸੁਖੁ ਹੋਇ।",
      "start_time": 92.032,
      "end_time": 99.163
    },
    {
      "section_id": "section-10",
      "transcript": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਰਾਖੁ ਤੂੰ, ਰਹਾਉ",
      "start_time": 99.163,
      "end_time": 105.416
    },
    {
      "section_id": "section-11",
      "transcript": "ਮੈ ਅਵਰੁ ਨ ਦੂਜਾ ਕੋਇ, ਰਹਾ",
      "start_time": 105.416,
      "end_time": 116.268
    },
    {
      "section_id": "section-12",
      "transcript": "ਆਗੈ ਦੇਖਉ ਡਉ ਜਲੈ।",
      "start_time": 139.59,
      "end_time": 146.191
    },
    {
      "section_id": "section-13",
      "transcript": "ਪਾਛੈ ਹਰਿਓ ਅੰਗੂਰੁ।",
      "start_time": 146.191,
      "end_time": 152.986
    },
    {
      "section_id": "section-14",
      "transcript": "ਜਿਸ ਤੇ ਉਪਜੈ ਤਿਸ ਤੇ ਬਿਨਸੈ।",
      "start_time": 152.986,
      "end_time": 159.956
    },
    {
      "section_id": "section-15",
      "transcript": "ਘਟਿ ਘਟਿ ਸਚੁ ਭਰਪੂਰਿ।",
      "start_time": 159.956,
      "end_time": 166.807
    },
    {
      "section_id": "section-16",
      "transcript": "ਆਪੇ ਮੇਲਿ ਮਿਲਾਵਹੀ।",
      "start_time": 166.807,
      "end_time": 173.466

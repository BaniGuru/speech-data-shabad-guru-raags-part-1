  "audio_file": "0020 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਤੀਜਾ",
      "start_time": 0.0,
      "end_time": 8.968
    },
    {
      "section_id": "section-2",
      "transcript": "ਘਰੁ ਪਹਿਲਾ।",
      "start_time": 8.968,
      "end_time": 14.532
    },
    {
      "section_id": "section-3",
      "transcript": "ਆ।",
      "start_time": 14.532,
      "end_time": 19.663
    },
    {
      "section_id": "section-4",
      "transcript": "ਜਿਸ ਹੀ ਕੀ ਸਿਰਕਾਰ ਹੈ",
      "start_time": 34.12,
      "end_time": 41.058
    },
    {
      "section_id": "section-5",
      "transcript": "ਤਿਸ ਹੀ ਕਾ ਸਭੁ ਕੋਇ",
      "start_time": 41.058,
      "end_time": 47.853
    },
    {
      "section_id": "section-6",
      "transcript": "ਗੁਰਮੁਖਿ ਕਾਰ ਕਮਾਵਣੀ",
      "start_time": 47.853,
      "end_time": 54.621
    },
    {
      "section_id": "section-7",
      "transcript": "ਸਚੁ ਘਟਿ ਪਰਗਟੁ ਹੋਇ",
      "start_time": 54.621,
      "end_time": 61.772
    },
    {
      "section_id": "section-8",
      "transcript": "ਅੰਤਰਿ ਜਿਸ ਕੈ ਸਚੁ ਵਸੈ",
      "start_time": 61.772,
      "end_time": 68.376
    },
    {
      "section_id": "section-9",
      "transcript": "ਸਚੇ ਸਚੀ ਸੋਇ",
      "start_time": 68.376,
      "end_time": 75.546
    },
    {
      "section_id": "section-10",
      "transcript": "ਸਚਿ ਮਿਲੇ ਸੇ ਨ ਵਿਛੁੜਹਿ।",
      "start_time": 75.546,
      "end_time": 82.116
    },
    {
      "section_id": "section-11",
      "transcript": "ਤਿਨ ਨਿਜ ਘਰਿ ਵਾਸਾ ਹੋਇ।",
      "start_time": 82.116,
      "end_time": 89.517
    },
    {
      "section_id": "section-12",
      "transcript": "ਮੇਰੇ ਰਾਮ।",
      "start_time": 89.517,
      "end_time": 95.737
    },
    {
      "section_id": "section-13",
      "transcript": "ਮੈ ਹਰਿ ਬਿਨੁ, ਅਵਰੁ ਨ ਕੋਇ।",
      "start_time": 95.737,
      "end_time": 103.211
    },
    {
      "section_id": "section-14",
      "transcript": "ਸਤਗੁਰੁ ਸਚੁ ਪ੍ਰਭੁ ਨਿਰਮਲਾ।",
      "start_time": 103.211,
      "end_time": 110.126
    },
    {
      "section_id": "section-15",
      "transcript": "ਸਬਦਿ ਮਿਲਾਵਾ ਹੋਇ ਰਹਾਉ।",
      "start_time": 110.126,
      "end_time": 118.364
    },
    {
      "section_id": "section-16",
      "transcript": "ਸਬਦਿ ਮਿਲੈ ਸੋ ਮਿਲਿ ਰਹੈ।",
      "start_time": 123.818,
      "end_time": 130.759
    },
    {
      "section_id": "section-17",
      "transcript": "ਜਿਸ ਨੋ ਆਪੇ ਲਏ ਮਿਲਾਇ।",
      "start_time": 130.759,
      "end_time": 137.887
    },
    {
      "section_id": "section-18",
      "transcript": "ਦੂਜੈ ਭਾਇ ਕੋ ਨਾ ਮਿਲੈ।",
      "start_time": 137.887,
      "end_time": 144.811
    },
    {
      "section_id": "section-19",
      "transcript": "ਫਿਰਿ ਫਿਰਿ ਆਵੈ ਜਾਇ।",
      "start_time": 144.811,
      "end_time": 151.516
    },
    {
      "section_id": "section-20",
      "transcript": "ਸਭ ਮਹਿ ਇਕੁ ਵਰਤਦਾ।",
      "start_time": 151.516,
      "end_time": 158.481
    },
    {
      "section_id": "section-21",
      "transcript": "ਏਕੋ ਰਹਿਆ ਸਮਾਇ।",
      "start_time": 158.481,
      "end_time": 165.235
    },
    {
      "section_id": "section-22",
      "transcript": "ਜਿਸ ਨੋ ਆਪਿ ਦਇਆਲੁ।",
      "start_time": 165.235,
      "end_time": 171.575
    },
    {
      "section_id": "section-23",
      "transcript": "ਸੋ ਗੁਰਮੁਖਿ ਨਾਮਿ ਸਮਾਇ।",
      "start_time": 171.575,
      "end_time": 178.929
    },
    {
      "section_id": "section-24",
      "transcript": "ਪੜਿ ਪੜਿ ਪੰਡਿਤ ਜੋਤਕੀ।",
      "start_time": 178.929,
      "end_time": 185.832
    },
    {
      "section_id": "section-25",
      "transcript": "ਵਾਦ ਕਰਹਿ ਬੀਚਾਰੁ।",
      "start_time": 185.832,
      "end_time": 192.535
    },
    {
      "section_id": "section-26",
      "transcript": "ਮਤਿ ਬੁਧਿ ਭਵੀ ਨ ਬੁਝਈ।",
      "start_time": 192.535,
      "end_time": 199.514
    },
    {
      "section_id": "section-27",
      "transcript": "ਅੰਤਰਿ ਲੋਭ ਵਿਕਾਰੁ।",
      "start_time": 199.514,
      "end_time": 206.434
    },
    {
      "section_id": "section-28",
      "transcript": "ਲਖ ਚਉਰਾਸੀਹ ਭਰਮਦੇ।",
      "start_time": 206.434,
      "end_time": 213.492
    },
    {
      "section_id": "section-29",
      "transcript": "ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਹੋਇ ਖੁਆਰੁ।",
      "start_time": 213.492,
      "end_time": 220.304
    },
    {
      "section_id": "section-30",
      "transcript": "ਪੂਰਬਿ ਲਿਖਿਆ ਕਮਾਵਣਾ।",
      "start_time": 220.304,
      "end_time": 227.148
    },
    {
      "section_id": "section-31",
      "transcript": "ਕੋਇ ਨ ਮੇਟਣਹਾਰੁ।",
      "start_time": 227.148,
      "end_time": 233.915
    },
    {
      "section_id": "section-32",
      "transcript": "ਸਤਿਗੁਰ ਕੀ ਸੇਵਾ ਗਾਖੜੀ, ਸਿਰੁ ਦੀਜੈ ਆਪੁ ਗਵਾਇ,",
      "start_time": 233.915,
      "end_time": 247.515
    },
    {
      "section_id": "section-33",
      "transcript": "ਸਬਦਿ ਮਿਲਹਿ ਤਾ ਹਰਿ ਮਿਲੈ।",
      "start_time": 247.515,
      "end_time": 254.439
    },
    {
      "section_id": "section-34",
      "transcript": "ਸੇਵਾ ਪਵੈ ਸਭ ਥਾਇ।",
      "start_time": 254.439,
      "end_time": 261.338
    },
    {
      "section_id": "section-35",
      "transcript": "ਪਥਰੁ ਪਾਰਸਿ ਪਰਸੀਐ, ਪਾਰਸੁ ਹੋਇ।",
      "start_time": 261.338,
      "end_time": 268.224
    },
    {
      "section_id": "section-36",
      "transcript": "ਜੋਤੀ ਜੋਤਿ ਸਮਾਇ।",
      "start_time": 268.224,
      "end_time": 275.039
    },
    {
      "section_id": "section-37",
      "transcript": "ਜਿਨ ਕਉ ਪੂਰਬਿ ਲਿਖਿਆ।",
      "start_time": 275.039,
      "end_time": 281.32
    },
    {
      "section_id": "section-38",
      "transcript": "ਤਿਨ ਸਤਿਗੁਰੁ ਮਿਲਿਆ ਆਇ।",
      "start_time": 281.32,
      "end_time": 288.557
    },
    {
      "section_id": "section-39",
      "transcript": "ਮਨ ਭੁਖਾ ਭੁਖਾ ਮਤ ਕਰਹਿ।",
      "start_time": 288.557,
      "end_time": 295.56
    },
    {
      "section_id": "section-40",
      "transcript": "ਮਤ ਤੂ ਕਰਹਿ ਪੂਕਾਰ।",
      "start_time": 295.56,
      "end_time": 302.331
    },
    {
      "section_id": "section-41",
      "transcript": "ਲਖ ਚਉਰਾਸੀਹ ਜਿਨਿ ਸਿਰੀ।",
      "start_time": 302.331,
      "end_time": 309.339
    },
    {
      "section_id": "section-42",
      "transcript": "ਸਭੁ ਤਿਸ ਕਾ, ਸਭਸੈ ਦੇਇ ਅਧਾਰੁ।",
      "start_time": 309.339,
      "end_time": 316.183
    },
    {
      "section_id": "section-43",
      "transcript": "ਨਿਰਭਉ ਸਦਾ ਦਇਆਲੁ ਹੈ।",
      "start_time": 316.183,
      "end_time": 322.857
    },
    {
      "section_id": "section-44",
      "transcript": "ਸਭਨਾ ਕਰਦਾ ਸਾਰ।",
      "start_time": 322.857,
      "end_time": 329.947
    },
    {
      "section_id": "section-45",
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਬੁਝੀਐ।",
      "start_time": 329.947,
      "end_time": 336.794
    },
    {
      "section_id": "section-46",
      "transcript": "ਪਾਈਐ, ਮੋਖ ਦੁਆਰੁ।",
      "start_time": 336.794,
      "end_time": 343.792
    },
    {
      "section_id": "section-47",
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਬੁਝੀਐ",
      "start_time": 356.899,
      "end_time": 363.78
    },
    {

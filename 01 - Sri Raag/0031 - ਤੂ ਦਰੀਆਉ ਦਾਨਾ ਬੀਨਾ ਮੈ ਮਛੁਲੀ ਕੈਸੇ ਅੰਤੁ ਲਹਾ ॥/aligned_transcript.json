{
  "audio_file": "019 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪਹਿਲਾ।",
      "start_time": 5.899,
      "end_time": 18.521
    },
    {
      "section_id": "section-2",
      "transcript": "ਘਰੁ ਚੌਥਾ।",
      "start_time": 18.521,
      "end_time": 26.77
    },
    {
      "section_id": "section-3",
      "transcript": "ਆ।",
      "start_time": 26.77,
      "end_time": 32.621
    },
    {
      "section_id": "section-4",
      "transcript": "ਤੂ ਦਰੀਆਉ ਦਾਨਾ ਬੀਨਾ",
      "start_time": 51.666,
      "end_time": 59.964
    },
    {
      "section_id": "section-5",
      "transcript": "ਮੈ ਮਛੁਲੀ ਕੈਸੇ ਅੰਤੁ ਲਹਾ",
      "start_time": 59.964,
      "end_time": 68.202
    },
    {
      "section_id": "section-6",
      "transcript": "ਜਹ ਜਹ ਦੇਖਾ ਤਹ ਤਹ ਤੂ ਹੈ",
      "start_time": 68.202,
      "end_time": 76.681
    },
    {
      "section_id": "section-7",
      "transcript": "ਤੁਝ ਤੇ ਨਿਕਸੀ ਫੂਟਿ ਮਰਾ",
      "start_time": 76.681,
      "end_time": 85.128
    },
    {
      "section_id": "section-8",
      "transcript": "ਨ ਜਾਣਾ ਮੇਉ, ਨ ਜਾਣਾ ਜਾਲੀ।",
      "start_time": 85.128,
      "end_time": 93.652
    },
    {
      "section_id": "section-9",
      "transcript": "ਜਾ ਦੁਖੁ ਲਾਗੈ, ਤਾ ਤੁਝੈ ਸਮਾਲੀ ਰਹਾਉ।",
      "start_time": 93.652,
      "end_time": 104.785
    },
    {
      "section_id": "section-10",
      "transcript": "ਤੂ ਭਰਪੂਰਿ, ਜਾਨਿਆ ਮੈ ਦੂਰਿ।",
      "start_time": 122.816,
      "end_time": 130.933
    },
    {
      "section_id": "section-11",
      "transcript": "ਜੋ ਕਛੁ ਕਰੀ, ਸੁ ਤੇਰੈ ਹਦੂਰਿ।",
      "start_time": 130.933,
      "end_time": 139.413
    },
    {
      "section_id": "section-12",
      "transcript": "ਤੂ ਦੇਖਹਿ, ਹਉ ਮੁਕਰਿ ਪਾਉ।",
      "start_time": 139.413,
      "end_time": 147.509
    },
    {
      "section_id": "section-13",
      "transcript": "ਤੇਰੈ ਕੰਮਿ ਨ ਤੇਰੈ ਨਾਇ",
      "start_time": 147.509,
      "end_time": 155.707
    },
    {
      "section_id": "section-14",
      "transcript": "ਜੇਤਾ ਦੇਹਿ, ਤੇਤਾ ਹਉ ਖਾਉ।",
      "start_time": 155.707,
      "end_time": 163.867
    },
    {
      "section_id": "section-15",
      "transcript": "ਬਿਆ ਦਰੁ ਨਾਹੀ, ਕੈ ਦਰਿ ਜਾਉ।",
      "start_time": 163.867,
      "end_time": 172.022
    },
    {
      "section_id": "section-16",
      "transcript": "ਨਾਨਕੁ, ਏਕ ਕਹੈ ਅਰਦਾਸਿ।",
      "start_time": 172.022,
      "end_time": 180.266
    },
    {
      "section_id": "section-17",
      "transcript": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ, ਤੇਰੈ ਪਾਸਿ।",
      "start_time": 180.266,
      "end_time": 188.586
    },
    {
      "section_id": "section-18",
      "transcript": "ਆਪੇ ਨੇੜੈ ਦੂਰਿ ਆਪੇ ਹੀ",
      "start_time": 188.586,
      "end_time": 196.873
    },
    {
      "section_id": "section-19",
      "transcript": "ਆਪੇ ਮੰਝਿ ਮਿਆਨੁੋ",
      "start_time": 196.873,
      "end_time": 204.91
    },
    {
      "section_id": "section-20",
      "transcript": "ਆਪੇ ਵੇਖੈ ਸੁਣੇ ਆਪੇ ਹੀ",
      "start_time": 204.91,
      "end_time": 213.236
    },
    {
      "section_id": "section-21",
      "transcript": "ਕੁਦਰਤਿ ਕਰੇ ਜਹਾਨੁੋ",
      "start_time": 213.236,
      "end_time": 221.395
    },
    {
      "section_id": "section-22",
      "transcript": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਨਾਨਕਾ",
      "start_time": 221.395,
      "end_time": 229.606
    },
    {
      "section_id": "section-23",
      "transcript": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਨਾਨਕਾ।",
      "start_time": 229.606,
      "end_time": 237.85
    },
    {
      "section_id": "section-24",
      "transcript": "ਹੁਕਮੁ ਸੋਈ ਪਰਵਾਨੁੋ।",
      "start_time": 237.85,
      "end_time": 246.046
    },
    {
      "section_id": "section-25",
      "transcript": "ਹੁਕਮੁ ਸੋਈ ਪਰਵਾਨੁੋ",
      "start_time": 246.046,
      "end_time": 255.476
    }
  ]
}

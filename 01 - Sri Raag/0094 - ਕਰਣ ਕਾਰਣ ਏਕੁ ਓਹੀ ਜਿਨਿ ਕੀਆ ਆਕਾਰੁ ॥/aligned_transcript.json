      "end_time": 75.122
    },
    {
      "section_id": "section-8",
      "transcript": "ਗੁਰ ਕੇ ਚਰਨ ਮਨ ਮਹਿ ਧਿਆਇ",
      "start_time": 75.36,
      "end_time": 83.309
    },
    {
      "section_id": "section-9",
      "transcript": "ਛੋਡਿ ਸਗਲ ਸਿਆਣਪਾ।",
      "start_time": 83.309,
      "end_time": 91.08
    },
    {
      "section_id": "section-10",
      "transcript": "ਸਾਚਿ ਸਬਦਿ ਲਿਵ ਲਾਇ ਰਹਾਉ।",

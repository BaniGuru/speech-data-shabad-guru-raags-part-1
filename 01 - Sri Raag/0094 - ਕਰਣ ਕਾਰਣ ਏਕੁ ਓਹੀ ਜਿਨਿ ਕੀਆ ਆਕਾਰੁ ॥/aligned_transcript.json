      "end_time": 150.17
    },
    {
      "section_id": "section-15",
      "transcript": "ਦੇਖਿ ਦਰਸਨੁ ਮਨੁ ਸਾਧਾਰੈ ਪਾਪ ਸਗਲੇ ਜਾਹਿ",
      "start_time": 150.48,
      "end_time": 164.754

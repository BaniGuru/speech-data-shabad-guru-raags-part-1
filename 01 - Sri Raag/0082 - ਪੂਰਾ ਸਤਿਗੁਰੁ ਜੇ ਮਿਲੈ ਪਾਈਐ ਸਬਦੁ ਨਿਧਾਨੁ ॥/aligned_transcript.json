  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪੰਜਵਾ",
      "start_time": 1.86,
      "end_time": 15.92
    },
    {
      "section_id": "section-2",
      "transcript": "ਪੂਰਾ ਸਤਿਗੁਰੁ ਜੇ ਮਿਲੈ ਪਾਈਐ ਸਬਦੁ ਨਿਧਾਨੁ",
      "start_time": 30.78,
      "end_time": 43.84
    },
    {
      "section_id": "section-3",
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਆਪਣੀ ਜਪੀਐ ਅੰਮ੍ਰਿਤ ਨਾਮੁ",
      "start_time": 44.6,
      "end_time": 57.84
    },
    {
      "section_id": "section-4",
      "transcript": "ਜਨਮ ਮਰਣ ਦੁਖੁ ਕਾਟੀਐ ਲਾਗੈ ਸਹਜਿ ਧਿਆਨੁ",
      "start_time": 58.38,
      "end_time": 71.84
    },
    {
      "section_id": "section-5",
      "transcript": "ਮੇਰੇ ਮਨ ਪ੍ਰਭ ਸਰਣਾਈ ਪਾਇ।",
      "start_time": 85.7,
      "end_time": 92.478
    },
    {
      "section_id": "section-6",
      "transcript": "ਹਰਿ ਬਿਨੁ ਦੂਜਾ ਕੋ ਨਹੀ।",
      "start_time": 92.478,
      "end_time": 99.2
    },
    {
      "section_id": "section-7",
      "transcript": "ਏਕੋ ਨਾਮੁ ਧਿਆਇ ਰਹਾਉ",
      "start_time": 99.42,
      "end_time": 109.284
    },
    {
      "section_id": "section-8",
      "transcript": "ਕੀਮਤਿ ਕਹਣੁ ਨ ਜਾਈਐ ਸਾਗਰੁ ਗੁਣੀ ਅਥਾਹੁ",
      "start_time": 123.1,
      "end_time": 136.56
    },
    {
      "section_id": "section-9",
      "transcript": "ਵਡਭਾਗੀ ਮਿਲੁ ਸੰਗਤੀ ਸਚਾ ਸਬਦੁ ਵਿਸਾਹੁ",
      "start_time": 136.7,
      "end_time": 150.24
    },
    {
      "section_id": "section-10",
      "transcript": "ਕਰਿ ਸੇਵਾ ਸੁਖ ਸਾਗਰੈ ਸਿਰਿ ਸਾਹਾ ਪਾਤਿਸਾਹੁ",
      "start_time": 150.34,
      "end_time": 163.84
    },
    {
      "section_id": "section-11",
      "transcript": "ਚਰਣ ਕਮਲ ਕਾ ਆਸਰਾ ਦੂਜਾ ਨਾਹੀ ਠਾਉ",
      "start_time": 177.3,
      "end_time": 190.96
    },
    {
      "section_id": "section-12",
      "transcript": "ਮੈ ਧਰ ਤੇਰੀ ਪਾਰਬ੍ਰਹਮ ਤੇਰੈ ਤਾਣਿ ਰਹਾਉ।",
      "start_time": 191.12,
      "end_time": 204.48
    },
    {
      "section_id": "section-13",
      "transcript": "ਨਿਮਾਣਿਆ ਪ੍ਰਭੁ ਮਾਣੁ ਤੂੰ ਤੇਰੈ ਸੰਗਿ ਸਮਾਉ",
      "start_time": 204.62,
      "end_time": 218.88
    },
    {
      "section_id": "section-14",
      "transcript": "ਹਰਿ ਜਪੀਐ ਆਰਾਧੀਐ ਆਠ ਪਹਰ ਗੋਵਿੰਦੁ",
      "start_time": 232.38,
      "end_time": 246.16
    },
    {
      "section_id": "section-15",
      "transcript": "ਜੀਅ ਪ੍ਰਾਣ ਤਨੁ ਧਨੁ ਰਖੇ ਕਰਿ ਕਿਰਪਾ ਰਾਖੀ ਜਿੰਦੁ",
      "start_time": 246.3,
      "end_time": 259.84
    },
    {
      "section_id": "section-16",
      "transcript": "ਨਾਨਕ ਸਗਲੇ ਦੋਖ ਉਤਾਰਿਅਨੁ ਪ੍ਰਭੁ ਪਾਰਬ੍ਰਹਮ ਬਖਸਿੰਦੁ",

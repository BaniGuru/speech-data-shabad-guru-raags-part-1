      "end_time": 61.867
    },
    {
      "section_id": "section-6",
      "transcript": "ਅਗਨਿ ਕ੍ਰੋਧੁ ਚੰਡਾਲੁ।",
      "start_time": 61.867,
      "end_time": 69.755
    },
    {
      "section_id": "section-7",
      "transcript": "ਰਸ ਕਸ ਆਪੁ ਸਲਾਹਣਾ ਏ",
      "start_time": 69.755,
      "end_time": 77.493
    },
    {
      "section_id": "section-8",
      "transcript": "ਕਰਮ ਮੇਰੇ ਕਰਤਾਰ",
      "start_time": 77.493,
      "end_time": 85.131
    },
    {
      "section_id": "section-9",
      "transcript": "ਬਾਬਾ ਬੋਲੀਐ",
      "start_time": 85.131,
      "end_time": 92.7
    },
    {
      "section_id": "section-10",
      "transcript": "ਊਤਮ ਸੇ ਦਰਿ ਊਤਮ ਕਹੀਅਹਿ",
      "start_time": 92.7,
      "end_time": 100.347
    },
    {
      "section_id": "section-11",
      "transcript": "ਨੀਚ ਕਰਮ ਬਹਿ ਰੋਇ ਰਹਾਉ",
      "start_time": 100.347,
      "end_time": 108.363
    },
    {
      "section_id": "section-12",
      "transcript": "ਰਸੁ ਸੁਇਨਾ ਰਸੁ ਰੁਪਾ ਕਾਮਣਿ,",

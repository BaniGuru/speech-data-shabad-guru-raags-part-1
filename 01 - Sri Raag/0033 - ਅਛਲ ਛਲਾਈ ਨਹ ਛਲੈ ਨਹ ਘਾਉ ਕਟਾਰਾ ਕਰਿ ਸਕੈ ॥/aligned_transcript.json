{
  "audio_file": "019 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਪਹਿਲਾ,",
      "start_time": 0.0,
      "end_time": 11.328
    },
    {
      "section_id": "section-2",
      "transcript": "ਘਰੁ ਪੰਜਵਾ।",
      "start_time": 11.328,
      "end_time": 19.684
    },
    {
      "section_id": "section-3",
      "transcript": "ਆ।",
      "start_time": 19.684,
      "end_time": 25.04
    },
    {
      "section_id": "section-4",
      "transcript": "ਅਛਲ ਛਲਾਈ ਨਹ ਛਲੈ।",
      "start_time": 35.964,
      "end_time": 45.303
    },
    {
      "section_id": "section-5",
      "transcript": "ਨਹ ਘਾਉ ਕਟਾਰਾ ਕਰਿ ਸਕੈ।",
      "start_time": 45.303,
      "end_time": 53.073
    },
    {
      "section_id": "section-6",
      "transcript": "ਜਿਉ ਸਾਹਿਬੁ ਰਾਖੈ ਤਿਉ ਰਹੈ।",
      "start_time": 53.848,
      "end_time": 61.938
    },
    {
      "section_id": "section-7",
      "transcript": "ਇਸੁ ਲੋਭੀ ਕਾ ਜੀਉ ਟਲ ਪਲੈ",
      "start_time": 61.938,
      "end_time": 70.07
    },
    {
      "section_id": "section-8",
      "transcript": "ਬਿਨੁ ਤੇਲ, ਦੀਵਾ ਕਿਉ ਜਲੈ ਰਹਾਉ।",
      "start_time": 70.07,
      "end_time": 77.949
    },
    {
      "section_id": "section-9",
      "transcript": "ਪੋਥੀ ਪੁਰਾਣ, ਕਮਾਈਐ।",
      "start_time": 94.05,
      "end_time": 101.643
    },
    {
      "section_id": "section-10",
      "transcript": "ਭਉ ਵਟੀ, ਇਤੁ ਤਨਿ ਪਾਈਐ।",
      "start_time": 101.643,
      "end_time": 109.567
    },
    {
      "section_id": "section-11",
      "transcript": "ਸਚੁ ਬੂਝਣੁ, ਆਣਿ ਜਲਾਈਐ।",
      "start_time": 109.567,
      "end_time": 117.445
    },
    {
      "section_id": "section-12",
      "transcript": "ਇਹੁ ਤੇਲੁ, ਦੀਵਾ ਇਉ ਜਲੈ।",
      "start_time": 117.445,
      "end_time": 125.583
    },
    {
      "section_id": "section-13",
      "transcript": "ਕਰਿ ਚਾਨਣੁ, ਸਾਹਿਬ ਤਉ ਮਿਲੈ ਰਹਾਉ।",
      "start_time": 125.583,
      "end_time": 133.284
    },
    {
      "section_id": "section-14",
      "transcript": "ਇਤੁ ਤਨਿ, ਲਾਗੈ ਬਾਣੀਆ।",
      "start_time": 141.046,
      "end_time": 148.771
    },
    {
      "section_id": "section-15",
      "transcript": "ਸੁਖੁ ਹੋਵੈ, ਸੇਵ ਕਮਾਣੀਆ।",
      "start_time": 148.771,
      "end_time": 156.341
    },
    {
      "section_id": "section-16",
      "transcript": "ਸਭ ਦੁਨੀਆ, ਆਵਣ ਜਾਣੀਆ।",
      "start_time": 156.341,
      "end_time": 164.069
    },
    {
      "section_id": "section-17",
      "transcript": "ਵਿਚਿ ਦੁਨੀਆ, ਸੇਵ ਕਮਾਈਐ।",
      "start_time": 164.069,
      "end_time": 171.917
    },
    {
      "section_id": "section-18",
      "transcript": "ਤਾ ਦਰਗਹ, ਬੈਸਣੁ ਪਾਈਐ।",
      "start_time": 171.917,
      "end_time": 179.482
    },
    {
      "section_id": "section-19",
      "transcript": "ਕਹੁ ਨਾਨਕ, ਬਾਹ ਲੁਡਾਈਐ।",
      "start_time": 179.482,
      "end_time": 187.225
    },
    {
      "section_id": "section-20",
      "transcript": "ਕਹੁ ਨਾਨਕ, ਬਾਹ ਲੁਡਾਈਐ।",
      "start_time": 187.225,
      "end_time": 196.663
    }
  ]
}

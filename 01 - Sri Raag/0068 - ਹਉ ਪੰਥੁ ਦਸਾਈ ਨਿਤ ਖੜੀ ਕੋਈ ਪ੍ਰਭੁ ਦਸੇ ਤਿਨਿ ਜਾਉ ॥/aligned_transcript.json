  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ।",
      "start_time": 2.1,
      "end_time": 11.07
    },
    {
      "section_id": "section-2",
      "transcript": "ਮਹਲਾ ਚੌਥਾ।",
      "start_time": 11.07,
      "end_time": 19.958
    },
    {
      "section_id": "section-3",
      "transcript": "ਹਉ ਪੰਥੁ ਦਸਾਈ ਨਿਤ ਖੜੀ",
      "start_time": 34.4,
      "end_time": 41.04
    },
    {
      "section_id": "section-4",
      "transcript": "ਕੋਈ ਪ੍ਰਭੁ ਦਸੇ ਤਿਨਿ ਜਾਉ",
      "start_time": 41.12,
      "end_time": 48.28
    },
    {
      "section_id": "section-5",
      "transcript": "ਜਿਨੀ ਮੇਰਾ ਪਿਆਰਾ ਰਾਵਿਆ ਤਿਨ ਪੀਛੈ ਲਾਗਿ ਫਿਰਾਉ",
      "start_time": 48.42,
      "end_time": 61.76
    },
    {
      "section_id": "section-6",
      "transcript": "ਕਰਿ ਮਿੰਨਤਿ ਕਰਿ ਜੋਦੜੀ ਮੈ ਪ੍ਰਭੁ ਮਿਲਣੈ ਕਾ ਚਾਉ",
      "start_time": 61.84,
      "end_time": 74.95
    },
    {
      "section_id": "section-7",
      "transcript": "ਮੇਰੇ ਭਾਈ ਜਨਾ",
      "start_time": 75.17,
      "end_time": 81.84
    },
    {
      "section_id": "section-8",
      "transcript": "ਕੋਈ ਮੋ ਕਉ ਹਰਿ ਪ੍ਰਭੁ ਮੇਲਿ ਮਿਲਾਇ",
      "start_time": 87.8,
      "end_time": 94.96
    },
    {
      "section_id": "section-9",
      "transcript": "ਹਉ ਸਤਿਗੁਰ ਵਿਟਹੁ ਵਾਰਿਆ, ਜਿਨਿ ਹਰਿ ਪ੍ਰਭੁ ਦੀਆ ਦਿਖਾਇ ਰਹਾਉ।",
      "start_time": 95.12,
      "end_time": 112.368
    },
    {
      "section_id": "section-10",
      "transcript": "ਹੋਇ ਨਿਮਾਣੀ ਢਹਿ ਪਵਾ ਪੂਰੇ ਸਤਿਗੁਰ ਪਾਸਿ",
      "start_time": 127.8,
      "end_time": 140.63
    },
    {
      "section_id": "section-11",
      "transcript": "ਨਿਮਾਣਿਆ ਗੁਰੁ ਮਾਣੁ ਹੈ ਗੁਰੁ ਸਤਿਗੁਰੁ ਕਰੇ ਸਾਬਾਸਿ",
      "start_time": 140.63,
      "end_time": 154.32
    },
    {
      "section_id": "section-12",
      "transcript": "ਹਉ ਗੁਰੁ ਸਾਲਾਹਿ ਨ ਰਜਊ ਮੈ ਮੇਲੇ ਹਰਿ ਪ੍ਰਭੁ ਪਾਸਿ",
      "start_time": 154.52,
      "end_time": 167.44
    },
    {
      "section_id": "section-13",
      "transcript": "ਸਤਿਗੁਰ ਨੋ ਸਭ ਕੋ ਲੋਚਦਾ ਜੇਤਾ ਜਗਤੁ ਸਭੁ ਕੋਇ",
      "start_time": 173.78,
      "end_time": 186.64
    },
    {
      "section_id": "section-14",
      "transcript": "ਬਿਨੁ ਭਾਗਾ ਦਰਸਨੁ ਨਾ ਥੀਐ ਭਾਗਹੀਣ ਬਹਿ ਰੋਇ",
      "start_time": 186.84,
      "end_time": 199.8
    },
    {
      "section_id": "section-15",
      "transcript": "ਜੋ ਹਰਿ ਪ੍ਰਭ ਭਾਣਾ ਸੋ ਥੀਆ ਧੁਰਿ ਲਿਖਿਆ ਨ ਮੇਟੈ ਕੋਇ",
      "start_time": 199.96,
      "end_time": 213.04
    },
    {
      "section_id": "section-16",
      "transcript": "ਆਪੇ ਸਤਿਗੁਰੁ ਆਪਿ ਹਰਿ ਆਪੇ ਮੇਲਿ ਮਿਲਾਇ",
      "start_time": 219.4,
      "end_time": 232.32
    },
    {
      "section_id": "section-17",
      "transcript": "ਆਪਿ ਦਇਆ ਕਰਿ ਮੇਲਸੀ ਗੁਰ ਸਤਿਗੁਰ ਪੀਛੈ ਪਾਇ",
      "start_time": 232.32,
      "end_time": 245.28
    },
    {
      "section_id": "section-18",
      "transcript": "ਸਭੁ ਜਗਜੀਵਨੁ ਜਗਿ ਆਪਿ ਹੈ ਨਾਨਕ ਜਲੁ ਜਲਹਿ ਸਮਾਇ",
      "start_time": 245.48,

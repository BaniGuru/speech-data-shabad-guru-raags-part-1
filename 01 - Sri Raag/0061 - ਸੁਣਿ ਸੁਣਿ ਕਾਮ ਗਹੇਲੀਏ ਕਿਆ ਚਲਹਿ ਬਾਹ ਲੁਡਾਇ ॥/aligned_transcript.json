{
  "audio_file": "0029 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਤੀਜਾ।",
      "start_time": 5.28,
      "end_time": 21.642
    },
    {
      "section_id": "section-2",
      "transcript": "ਸੁਣਿ ਸੁਣਿ ਕਾਮ ਗਹੇਲੀਏ, ਕਿਆ ਚਲਹਿ ਬਾਹ ਲੁਡਾਇ।",
      "start_time": 40.36,
      "end_time": 50.96
    },
    {
      "section_id": "section-3",
      "transcript": "ਆਪਣਾ ਪਿਰੁ ਨ ਪਛਾਣਹੀ ਕਿਆ ਮੁਹੁ ਦੇਸਹਿ ਜਾਇ",
      "start_time": 51.2,
      "end_time": 60.738
    },
    {
      "section_id": "section-4",
      "transcript": "ਜਿਨੀ ਸਖੀਂ ਕੰਤੁ ਪਛਾਣਿਆ ਹਉ ਤਿਨ ਕੈ ਲਾਗਉ ਪਾਇ",
      "start_time": 60.738,
      "end_time": 71.23
    },
    {
      "section_id": "section-5",
      "transcript": "ਤਿਨ ਹੀ ਜੈਸੀ ਥੀ ਰਹਾ ਸਤਸੰਗਤਿ ਮੇਲਿ ਮਿਲਾਇ",
      "start_time": 71.6,
      "end_time": 81.04
    },
    {
      "section_id": "section-6",
      "transcript": "ਮੁੰਧੇ ਕੂੜਿ ਮੁਠੀ ਕੂੜਿਆਰਿ",
      "start_time": 90.88,
      "end_time": 98.12
    },
    {
      "section_id": "section-7",
      "transcript": "ਪਿਰੁ ਪ੍ਰਭੁ ਸਾਚਾ ਸੋਹਣਾ, ਪਾਈਐ ਗੁਰ ਬੀਚਾਰਿ ਰਹਾਉ।",
      "start_time": 98.23,
      "end_time": 110.44
    },
    {
      "section_id": "section-8",
      "transcript": "ਮਨਮੁਖਿ ਕੰਤੁ ਨ ਪਛਾਣਈ ਤਿਨ ਕਿਉ ਰੈਣਿ ਵਿਹਾਇ",
      "start_time": 119.88,
      "end_time": 129.04
    },
    {
      "section_id": "section-9",
      "transcript": "ਗਰਬਿ ਅਟੀਆ ਤ੍ਰਿਸਨਾ ਜਲਹਿ, ਦੁਖੁ ਪਾਵਹਿ ਦੂਜੈ ਭਾਇ।",
      "start_time": 133.86,
      "end_time": 143.04
    },
    {
      "section_id": "section-10",
      "transcript": "ਸਬਦਿ ਰਤੀਆ ਸੋਹਾਗਣੀ ਤਿਨ ਵਿਚਹੁ ਹਉਮੈ ਜਾਇ",
      "start_time": 143.11,
      "end_time": 152.16
    },
    {
      "section_id": "section-11",
      "transcript": "ਸਦਾ ਪਿਰੁ ਰਾਵਹਿ ਆਪਣਾ ਤਿਨਾ ਸੁਖੇ ਸੁਖਿ ਵਿਹਾਇ",
      "start_time": 152.27,
      "end_time": 160.63
    },
    {
      "section_id": "section-12",
      "transcript": "ਗਿਆਨ ਵਿਹੂਣੀ ਪਿਰ ਮੁਤੀਆ ਪਿਰਮੁ ਨ ਪਾਇਆ ਜਾਇ",
      "start_time": 170.86,
      "end_time": 180.04
    },
    {
      "section_id": "section-13",
      "transcript": "ਅਗਿਆਨ ਮਤੀ ਅੰਧੇਰੁ ਹੈ, ਬਿਨੁ ਪਿਰ ਦੇਖੇ ਭੁਖ ਨ ਜਾਇ।",
      "start_time": 184.64,
      "end_time": 194.04
    },
    {
      "section_id": "section-14",
      "transcript": "ਆਵਹੁ ਮਿਲਹੁ ਸਹੇਲੀਹੋ ਮੈ ਪਿਰੁ ਦੇਹੁ ਮਿਲਾਇ",
      "start_time": 194.25,
      "end_time": 202.44
    },
    {
      "section_id": "section-15",
      "transcript": "ਪੂਰੈ ਭਾਗਿ ਸਤਿਗੁਰੁ ਮਿਲੈ ਪਿਰੁ ਪਾਇਆ ਸਚਿ ਸਮਾਇ",
      "start_time": 212.54,
      "end_time": 222.076
    },
    {
      "section_id": "section-16",
      "transcript": "ਸੇ ਸਹੀਆ ਸੋਹਾਗਣੀ ਜਿਨ ਕਉ ਨਦਰਿ ਕਰੇਇ",
      "start_time": 230.62,
      "end_time": 239.44
    },
    {
      "section_id": "section-17",
      "transcript": "ਖਸਮੁ ਪਛਾਣਹਿ ਆਪਣਾ ਤਨੁ ਮਨੁ ਆਗੈ ਦੇਇ",
      "start_time": 243.98,
      "end_time": 252.88
    },
    {
      "section_id": "section-18",
      "transcript": "ਘਰਿ ਵਰੁ ਪਾਇਆ ਆਪਣਾ ਹਉਮੈ ਦੂਰਿ ਕਰੇਇ",
      "start_time": 252.91,

  "sections": [
    {
      "section_id": "section-1",
      "transcript": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ਤੀਜਾ",
      "start_time": 1.08,
      "end_time": 11.668
    },
    {
      "section_id": "section-2",
      "transcript": "ਆ।",
      "start_time": 11.668,
      "end_time": 17.876
    },
    {
      "section_id": "section-3",
      "transcript": "ਕਿਸੁ ਹਉ ਸੇਵੀ ਕਿਆ ਜਪੁ ਕਰੀ ਸਤਗੁਰ ਪੂਛਉ ਜਾਇ",
      "start_time": 35.66,
      "end_time": 49.4
    },
    {
      "section_id": "section-4",
      "transcript": "ਸਤਗੁਰ ਕਾ ਭਾਣਾ ਮੰਨਿ ਲਈ ਵਿਚਹੁ ਆਪੁ ਗਵਾਇ",
      "start_time": 49.4,
      "end_time": 63.84
    },
    {
      "section_id": "section-5",
      "transcript": "ਏਹਾ ਸੇਵਾ ਚਾਕਰੀ ਨਾਮੁ ਵਸੈ ਮਨਿ ਆਇ",
      "start_time": 63.84,
      "end_time": 78.338
    },
    {
      "section_id": "section-6",
      "transcript": "ਨਾਮੈ ਹੀ ਤੇ ਸੁਖੁ ਪਾਈਐ ਸਚੈ ਸਬਦਿ ਸੁਹਾਇ",
      "start_time": 78.338,
      "end_time": 92.886
    },
    {
      "section_id": "section-7",
      "transcript": "ਮਨ ਮੇਰੇ",
      "start_time": 92.886,
      "end_time": 99.72
    },
    {
      "section_id": "section-8",
      "transcript": "ਅਨਦਿਨੁ ਜਾਗੁ ਹਰਿ ਚੇਤਿ",
      "start_time": 100.12,
      "end_time": 107.124
    },
    {
      "section_id": "section-9",
      "transcript": "ਆਪਣੀ ਖੇਤੀ ਰਖਿ ਲੈ ਕੂੰਜ ਪੜੈਗੀ ਖੇਤਿ ਰਹਾਉ।",
      "start_time": 107.124,
      "end_time": 125.06
    },
    {
      "section_id": "section-10",
      "transcript": "ਮਨ ਕੀਆ ਇਛਾ ਪੂਰੀਆ ਸਬਦਿ ਰਹਿਆ ਭਰਪੂਰਿ",
      "start_time": 132.4,
      "end_time": 146.367
    },
    {
      "section_id": "section-11",
      "transcript": "ਭੈ ਭਾਇ ਭਗਤਿ ਕਰਹਿ ਦਿਨੁ ਰਾਤੀ ਹਰਿ ਜੀਉ ਵੇਖੈ ਸਦਾ ਹਦੂਰਿ",
      "start_time": 146.72,
      "end_time": 161.213
    },
    {
      "section_id": "section-12",
      "transcript": "ਸਚੈ ਸਬਦਿ ਸਦਾ ਮਨੁ ਰਾਤਾ ਭ੍ਰਮੁ ਗਇਆ ਸਰੀਰਹੁ ਦੂਰਿ",
      "start_time": 161.213,
      "end_time": 175.399
    },
    {
      "section_id": "section-13",
      "transcript": "ਨਿਰਮਲੁ ਸਾਹਿਬੁ ਪਾਇਆ ਸਾਚਾ ਗੁਣੀ ਗਹੀਰੁ",
      "start_time": 175.58,
      "end_time": 189.71
    },
    {
      "section_id": "section-14",
      "transcript": "ਜੋ ਜਾਗੇ ਸੇ ਉਬਰੇ ਸੂਤੇ ਗਏ ਮੁਹਾਇ",
      "start_time": 189.71,
      "end_time": 203.976
    },
    {
      "section_id": "section-15",
      "transcript": "ਸਚਾ ਸਬਦੁ ਨ ਪਛਾਣਿਓ ਸੁਪਨਾ ਗਇਆ ਵਿਹਾਇ।",
      "start_time": 203.976,
      "end_time": 218.418
    },
    {
      "section_id": "section-16",
      "transcript": "ਸੁੰਞੇ ਘਰ ਕਾ ਪਾਹੁਣਾ ਜਿਉ ਆਇਆ ਤਿਉ ਜਾਇ",
      "start_time": 218.44,
      "end_time": 232.656
    },
    {
      "section_id": "section-17",
      "transcript": "ਮਨਮੁਖ ਜਨਮੁ ਬਿਰਥਾ ਗਇਆ ਕਿਆ ਮੁਹੁ ਦੇਸੀ ਜਾਇ",
      "start_time": 232.656,
      "end_time": 247.029
    },
    {
      "section_id": "section-18",
      "transcript": "ਸਭ ਕਿਛੁ ਆਪੇ ਆਪਿ ਹੈ",
      "start_time": 247.029,
      "end_time": 254.07
    },
    {
      "section_id": "section-19",
      "transcript": "ਹਉਮੈ ਵਿਚਿ ਕਹਨੁ ਨ ਜਾਇ।",
      "start_time": 254.26,
      "end_time": 261.214
    },
    {
      "section_id": "section-20",
      "transcript": "ਗੁਰ ਕੈ ਸਬਦਿ ਪਛਾਣੀਐ ਦੁਖੁ ਹਉਮੈ ਵਿਚਹੁ ਗਵਾਇ",
      "start_time": 261.214,
      "end_time": 275.568
    },
    {
      "section_id": "section-21",
      "transcript": "ਸਤਗੁਰੁ ਸੇਵਨਿ ਆਪਣਾ ਹਉ ਤਿਨ ਕੈ ਲਾਗਉ ਪਾਇ",
      "start_time": 275.76,
      "end_time": 289.886
    },
    {
      "section_id": "section-22",
      "transcript": "ਨਾਨਕ ਦਰਿ ਸਚੈ ਸਚਿਆਰ ਹਹਿ ਹਉ ਤਿਨ ਬਲਿਹਾਰੈ ਜਾਉ",
      "start_time": 289.886,
      "end_time": 304.613
    },
    {
      "section_id": "section-23",
      "transcript": "ਨਾਨਕ ਦਰਿ ਸਚੈ ਸਚਿਆਰ ਹਹਿ ਹਉ ਤਿਨ ਬਲਿਹਾਰੈ ਜਾਉ।",

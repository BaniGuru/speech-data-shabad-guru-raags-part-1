{
  "audio_file": "0142 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.105,
      "end_time": 8.001,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.105,
      "end_time": 23.9,
      "transcript": "ਦੁਲਭ ਦੇਹ, ਪਾਈ ਵਡਭਾਗੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.9,
      "end_time": 31.975,
      "transcript": "ਨਾਮੁ ਨ ਜਪਹਿ, ਤੇ ਆਤਮ ਘਾਤੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.4,
      "end_time": 40.267,
      "transcript": "ਮਰਿ ਨ ਜਾਹੀ, ਜਿਨਾ ਬਿਸਰਤ ਰਾਮ"
    },
    {
      "section_id": "section-00005",
      "start_time": 40.267,
      "end_time": 48.685,
      "transcript": "ਨਾਮ ਬਿਹੂਨ, ਜੀਵਨ ਕਉਨ ਕਾਮ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.334,
      "end_time": 76.465,
      "transcript": "ਖਾਤ ਪੀਤ ਖੇਲਤ, ਹਸਤ ਬਿਸਥਾਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.465,
      "end_time": 84.268,
      "transcript": "ਕਵਨ ਅਰਥ, ਮਿਰਤਕ ਸੀਗਾਰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.268,
      "end_time": 91.985,
      "transcript": "ਜੋ ਨ ਸੁਨਹਿ, ਜਸੁ ਪਰਮਾਨੰਦਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 92.52,
      "end_time": 100.478,
      "transcript": "ਪਸੁ ਪੰਖੀ, ਤ੍ਰਿਗਦ ਜੋਨਿ ਤੇ ਮੰਦਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 100.478,
      "end_time": 108.295,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਗੁਰਿ ਮੰਤ੍ਰੁ ਦ੍ਰਿੜਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 108.585,
      "end_time": 115.985,
      "transcript": "ਕੇਵਲ ਨਾਮੁ, ਰਿਦ ਮਾਹਿ ਸਮਾਇਆ"
    }
  ]
}

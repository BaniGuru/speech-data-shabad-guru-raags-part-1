{
  "audio_file": "0242 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.155,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.12,
      "end_time": 20.815,
      "transcript": "ਗਗਨਿ ਰਸਾਲ, ਚੁਐ ਮੇਰੀ ਭਾਠੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.815,
      "end_time": 27.975,
      "transcript": "ਸੰਚਿ ਮਹਾ ਰਸੁ, ਤਨੁ ਭਇਆ ਕਾਠੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.975,
      "end_time": 35.28,
      "transcript": "ਉਆ ਕਉ ਕਹੀਐ, ਸਹਜ ਮਤਵਾਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.28,
      "end_time": 42.275,
      "transcript": "ਪੀਵਤ ਰਾਮ ਰਸੁ, ਗਿਆਨ ਬੀਚਾਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.36,
      "end_time": 56.195,
      "transcript": "ਸਹਜ ਕਲਾਲਨਿ, ਜਉ ਮਿਲਿ ਆਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.195,
      "end_time": 63.4,
      "transcript": "ਆਨੰਦਿ ਮਾਤੇ, ਅਨਦਿਨੁ ਜਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.4,
      "end_time": 70.32,
      "transcript": "ਚੀਨਤ ਚੀਤੁ, ਨਿਰੰਜਨ ਲਾਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.32,
      "end_time": 76.495,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਤੌ ਅਨਭਉ ਪਾਇਆ"
    }
  ]
}

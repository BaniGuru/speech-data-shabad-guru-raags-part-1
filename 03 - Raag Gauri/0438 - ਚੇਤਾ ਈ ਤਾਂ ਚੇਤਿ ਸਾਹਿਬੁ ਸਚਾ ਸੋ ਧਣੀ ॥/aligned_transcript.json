      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 78.32,
      "end_time": 84.585,
      "transcript": "ਵਾਊ ਸੰਦੇ ਕਪੜੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 85.0,
      "end_time": 91.245,
      "transcript": "ਪਹਿਰਹਿ ਗਰਬਿ ਗਵਾਰ"

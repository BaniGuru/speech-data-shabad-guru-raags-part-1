{
  "audio_file": "0122 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.24,
      "end_time": 7.277,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.52,
      "end_time": 21.479,
      "transcript": "ਗੁਰ ਸੇਵਾ, ਜੁਗ ਚਾਰੇ ਹੋਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.479,
      "end_time": 28.32,
      "transcript": "ਪੂਰਾ ਜਨੁ ਕਾਰ ਕਮਾਵੈ ਕੋਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.32,
      "end_time": 35.466,
      "transcript": "ਅਖੁਟੁ ਨਾਮ ਧਨੁ ਹਰਿ ਤੋਟਿ ਨ ਹੋਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.466,
      "end_time": 42.543,
      "transcript": "ਐਥੈ ਸਦਾ ਸੁਖੁ, ਦਰਿ ਸੋਭਾ ਹੋਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.543,
      "end_time": 49.72,
      "transcript": "ਏ ਮਨ ਮੇਰੇ, ਭਰਮੁ ਨ ਕੀਜੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.72,
      "end_time": 57.279,
      "transcript": "ਗੁਰਮੁਖਿ ਸੇਵਾ, ਅੰਮ੍ਰਿਤ ਰਸੁ ਪੀਜੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.0,
      "end_time": 71.079,
      "transcript": "ਸਤਿਗੁਰੁ ਸੇਵਹਿ, ਸੇ ਮਹਾਪੁਰਖ ਸੰਸਾਰੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.079,
      "end_time": 78.072,
      "transcript": "ਆਪਿ ਉਧਰੇ, ਕੁਲ ਸਗਲ ਨਿਸਤਾਰੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.072,
      "end_time": 85.212,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਰਖਹਿ ਉਰ ਧਾਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.212,
      "end_time": 92.206,
      "transcript": "ਨਾਮਿ ਰਤੇ, ਭਉਜਲ ਉਤਰਹਿ ਪਾਰੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 92.206,
      "end_time": 99.317,
      "transcript": "ਸਤਿਗੁਰੁ ਸੇਵਹਿ, ਸਦਾ ਮਨਿ ਦਾਸਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 99.317,
      "end_time": 106.292,
      "transcript": "ਹਉਮੈ ਮਾਰਿ, ਕਮਲੁ ਪਰਗਾਸਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 106.292,
      "end_time": 113.575,
      "transcript": "ਅਨਹਦੁ ਵਾਜੈ, ਨਿਜ ਘਰਿ ਵਾਸਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 113.575,
      "end_time": 120.972,
      "transcript": "ਨਾਮਿ ਰਤੇ, ਘਰ ਮਾਹਿ ਉਦਾਸਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 120.972,
      "end_time": 128.64,
      "transcript": "ਸਤਿਗੁਰੁ ਸੇਵਹਿ, ਤਿਨ ਕੀ ਸਚੀ ਬਾਣੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 128.64,
      "end_time": 135.741,
      "transcript": "ਜੁਗੁ ਜੁਗੁ ਭਗਤੀ ਆਖਿ ਵਖਾਣੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 135.741,
      "end_time": 142.97,
      "transcript": "ਅਨਦਿਨੁ ਜਪਹਿ, ਹਰਿ ਸਾਰੰਗਪਾਣੀ"
    },
    {
      "section_id": "section-00019",
      "start_time": 143.52,
      "end_time": 150.531,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ, ਨਿਹਕੇਵਲ ਨਿਰਬਾਣੀ"
    }
  ]
}

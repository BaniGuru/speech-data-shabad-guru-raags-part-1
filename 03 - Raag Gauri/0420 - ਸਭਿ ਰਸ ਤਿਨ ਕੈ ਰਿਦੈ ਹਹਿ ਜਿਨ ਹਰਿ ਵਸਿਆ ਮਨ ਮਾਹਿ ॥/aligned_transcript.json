{
  "audio_file": "0229 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 6.621,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.621,
      "end_time": 12.954,
      "transcript": "ਮਹਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 12.954,
      "end_time": 18.514,
      "transcript": "ਚੌਥਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.8,
      "end_time": 32.075,
      "transcript": "ਸਭਿ ਰਸ ਤਿਨ ਕੈ ਰਿਦੈ ਹਹਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.52,
      "end_time": 39.12,
      "transcript": "ਜਿਨ ਹਰਿ ਵਸਿਆ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 39.12,
      "end_time": 45.105,
      "transcript": "ਹਰਿ ਦਰਗਹਿ ਤੇ ਮੁਖ ਉਜਲੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 45.6,
      "end_time": 52.15,
      "transcript": "ਤਿਨ ਕਉ ਸਭਿ ਦੇਖਣ ਜਾਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 52.15,
      "end_time": 58.235,
      "transcript": "ਜਿਨ ਨਿਰਭਉ ਨਾਮੁ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 58.68,
      "end_time": 64.775,
      "transcript": "ਤਿਨ ਕਉ ਭਉ ਕੋਈ ਨਾਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 65.28,
      "end_time": 71.245,
      "transcript": "ਹਰਿ ਉਤਮੁ ਤਿਨੀ ਸਰੇਵਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 71.76,
      "end_time": 77.755,
      "transcript": "ਜਿਨ ਕਉ ਧੁਰਿ ਲਿਖਿਆ ਆਹਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 78.24,
      "end_time": 84.795,
      "transcript": "ਤੇ ਹਰਿ ਦਰਗਹਿ ਪੈਨਾਈਅਹਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 84.795,
      "end_time": 91.32,
      "transcript": "ਜਿਨ ਹਰਿ ਵੁਠਾ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 91.32,
      "end_time": 97.345,
      "transcript": "ਓਇ ਆਪਿ ਤਰੇ ਸਭ ਕੁਟੰਬ ਸਿਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 97.76,
      "end_time": 104.235,
      "transcript": "ਤਿਨ ਪਿਛੈ ਸਭੁ ਜਗਤੁ ਛਡਾਹਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 104.235,
      "end_time": 110.235,
      "transcript": "ਜਨ ਨਾਨਕ ਕਉ ਹਰਿ ਮੇਲਿ ਜਨ"
    },
    {
      "section_id": "section-00017",
      "start_time": 110.385,
      "end_time": 116.9,
      "transcript": "ਤਿਨ ਵੇਖਿ ਵੇਖਿ ਹਮ ਜੀਵਾਹਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 116.9,
      "end_time": 124.112,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 129.995,
      "end_time": 136.095,
      "transcript": "ਸਾ ਧਰਤੀ ਭਈ ਹਰੀਆਵਲੀ"
    },
    {
      "section_id": "section-00020",
      "start_time": 136.48,
      "end_time": 142.675,
      "transcript": "ਜਿਥੈ ਮੇਰਾ ਸਤਿਗੁਰੁ ਬੈਠਾ ਆਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 142.675,
      "end_time": 148.915,
      "transcript": "ਸੇ ਜੰਤ ਭਏ ਹਰੀਆਵਲੇ"
    },
    {
      "section_id": "section-00022",
      "start_time": 149.315,
      "end_time": 155.84,
      "transcript": "ਜਿਨੀ ਮੇਰਾ ਸਤਿਗੁਰੁ ਦੇਖਿਆ ਜਾਇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 155.84,
      "end_time": 162.262,
      "transcript": "ਧਨੁ ਧੰਨੁ ਪਿਤਾ ਧਨੁ ਧੰਨੁ ਕੁਲੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 162.262,
      "end_time": 168.69,
      "transcript": "ਧਨੁ ਧਨੁ ਸੁ ਜਨਨੀ ਜਿਨਿ ਗੁਰੂ ਜਣਿਆ ਮਾਇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 168.69,
      "end_time": 175.105,
      "transcript": "ਧਨੁ ਧੰਨੁ ਗੁਰੂ ਜਿਨਿ ਨਾਮੁ ਅਰਾਧਿਆ"
    },
    {
      "section_id": "section-00026",
      "start_time": 175.105,
      "end_time": 181.56,
      "transcript": "ਆਪਿ ਤਰਿਆ ਜਿਨੀ ਡਿਠਾ ਤਿਨਾ ਲਏ ਛਡਾਇ"
    },
    {
      "section_id": "section-00027",
      "start_time": 181.56,
      "end_time": 187.84,
      "transcript": "ਹਰਿ ਸਤਿਗੁਰੁ ਮੇਲਹੁ ਦਇਆ ਕਰਿ"
    },
    {
      "section_id": "section-00028",
      "start_time": 187.84,
      "end_time": 193.865,
      "transcript": "ਜਨੁ ਨਾਨਕੁ ਧੋਵੈ ਪਾਇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 194.28,
      "end_time": 198.365,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00030",
      "start_time": 206.36,
      "end_time": 210.369,
      "transcript": "ਸਚੁ ਸਚਾ ਸਤਿਗੁਰੁ ਅਮਰੁ ਹੈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 210.369,
      "end_time": 214.4,
      "transcript": "ਜਿਸੁ ਅੰਦਰਿ ਹਰਿ ਉਰਿ ਧਾਰਿਆ"
    },
    {
      "section_id": "section-00032",
      "start_time": 214.4,
      "end_time": 222.635,
      "transcript": "ਸਚੁ ਸਚਾ ਸਤਿਗੁਰੁ ਪੁਰਖੁ ਹੈ ਜਿਨਿ ਕਾਮੁ ਕ੍ਰੋਧੁ ਬਿਖੁ ਮਾਰਿਆ"
    },
    {
      "section_id": "section-00033",
      "start_time": 222.635,
      "end_time": 230.865,
      "transcript": "ਜਾ ਡਿਠਾ ਪੂਰਾ ਸਤਿਗੁਰੂ, ਤਾਂ ਅੰਦਰਹੁ ਮਨੁ ਸਾਧਾਰਿਆ"
    },
    {
      "section_id": "section-00034",
      "start_time": 231.28,
      "end_time": 239.125,
      "transcript": "ਬਲਿਹਾਰੀ ਗੁਰ ਆਪਣੇ, ਸਦਾ ਸਦਾ ਘੁਮਿ ਵਾਰਿਆ"
    },
    {
      "section_id": "section-00035",
      "start_time": 239.44,
      "end_time": 248.013,
      "transcript": "ਗੁਰਮੁਖਿ ਜਿਤਾ, ਮਨਮੁਖਿ ਹਾਰਿਆ"
    }
  ]
}

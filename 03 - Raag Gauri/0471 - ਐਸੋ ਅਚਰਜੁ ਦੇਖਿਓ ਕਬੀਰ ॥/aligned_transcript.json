{
  "audio_file": "0240 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 6.172,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ ਕੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.172,
      "end_time": 12.184,
      "transcript": "ਨਾਲਿ ਰਲਾਇ ਲਿਖਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 12.184,
      "end_time": 18.834,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.72,
      "end_time": 30.525,
      "transcript": "ਐਸੋ ਅਚਰਜੁ, ਦੇਖਿਓ ਕਬੀਰ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.525,
      "end_time": 36.612,
      "transcript": "ਦਧਿ ਕੈ ਭੋਲੈ ਬਿਰੋਲੈ ਨੀਰੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 36.612,
      "end_time": 40.174,
      "transcript": "ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 46.16,
      "end_time": 52.035,
      "transcript": "ਹਰੀ ਅੰਗੂਰੀ, ਗਦਹਾ ਚਰੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 52.24,
      "end_time": 58.272,
      "transcript": "ਨਿਤ ਉਠਿ ਹਾਸੈ, ਹੀਗੈ ਮਰੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 58.272,
      "end_time": 64.64,
      "transcript": "ਮਾਤਾ ਭੈਸਾ, ਅੰਮੁਹਾ ਜਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 64.64,
      "end_time": 70.7,
      "transcript": "ਕੁਦਿ ਕੁਦਿ ਚਰੈ, ਰਸਾਤਲਿ ਪਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 70.7,
      "end_time": 76.95,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਪਰਗਟੁ ਭਈ ਖੇਡ"
    },
    {
      "section_id": "section-00012",
      "start_time": 76.95,
      "end_time": 82.855,
      "transcript": "ਲੇਲੇ ਕਉ, ਚੂਘੈ ਨਿਤ ਭੇਡ"
    },
    {
      "section_id": "section-00013",
      "start_time": 83.165,
      "end_time": 89.245,
      "transcript": "ਰਾਮ ਰਮਤ, ਮਤਿ ਪਰਗਟੀ ਆਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 89.245,
      "end_time": 95.155,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਗੁਰਿ ਸੋਝੀ ਪਾਈ"
    }
  ]
}

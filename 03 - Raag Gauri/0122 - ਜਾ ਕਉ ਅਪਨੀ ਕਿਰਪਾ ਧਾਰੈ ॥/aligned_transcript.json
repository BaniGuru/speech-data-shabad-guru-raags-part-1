{
  "audio_file": "0143 EPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.315,
      "end_time": 7.86,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.775,
      "end_time": 23.55,
      "transcript": "ਜਾ ਕਉ ਅਪਨੀ, ਕਿਰਪਾ ਧਾਰੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.55,
      "end_time": 31.325,
      "transcript": "ਸੋ ਜਨੁ, ਰਸਨਾ ਨਾਮੁ ਉਚਾਰੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.325,
      "end_time": 39.04,
      "transcript": "ਹਰਿ ਬਿਸਰਤ, ਸਹਸਾ ਦੁਖੁ ਬਿਆਪੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.04,
      "end_time": 46.44,
      "transcript": "ਸਿਮਰਤ ਨਾਮੁ, ਭਰਮੁ ਭਉ ਭਾਗੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.6,
      "end_time": 66.44,
      "transcript": "ਹਰਿ ਕੀਰਤਨੁ ਸੁਣੈ, ਹਰਿ ਕੀਰਤਨੁ ਗਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.44,
      "end_time": 74.225,
      "transcript": "ਤਿਸੁ ਜਨ ਦੂਖੁ, ਨਿਕਟਿ ਨਹੀ ਆਵੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.225,
      "end_time": 82.2,
      "transcript": "ਹਰਿ ਕੀ ਟਹਲ ਕਰਤ, ਜਨੁ ਸੋਹੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 82.2,
      "end_time": 89.79,
      "transcript": "ਤਾ ਕਉ, ਮਾਇਆ ਅਗਨਿ ਨ ਪੋਹੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 89.79,
      "end_time": 97.565,
      "transcript": "ਮਨਿ ਤਨਿ ਮੁਖਿ, ਹਰਿ ਨਾਮੁ ਦਇਆਲ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.745,
      "end_time": 104.645,
      "transcript": "ਨਾਨਕ, ਤਜੀਅਲੇ ਅਵਰਿ ਜੰਜਾਲ"
    }
  ]
}

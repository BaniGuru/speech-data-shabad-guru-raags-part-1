{
  "audio_file": "0136 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.52,
      "end_time": 8.914,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 17.52,
      "end_time": 25.92,
      "transcript": "ਆਨ ਰਸਾ, ਜੇਤੇ ਤੈ ਚਾਖੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.92,
      "end_time": 34.268,
      "transcript": "ਨਿਮਖ ਨ ਤ੍ਰਿਸਨਾ ਤੇਰੀ ਲਾਥੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 34.268,
      "end_time": 42.935,
      "transcript": "ਹਰਿ ਰਸ ਕਾ ਤੂੰ ਚਾਖਹਿ ਸਾਦੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.935,
      "end_time": 51.188,
      "transcript": "ਚਾਖਤ ਹੋਇ ਰਹਹਿ ਬਿਸਮਾਦੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.188,
      "end_time": 60.101,
      "transcript": "ਅੰਮ੍ਰਿਤੁ ਰਸਨਾ, ਪੀਉ ਪਿਆਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.101,
      "end_time": 64.341,
      "transcript": "ਇਹ ਰਸ ਰਾਤੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.341,
      "end_time": 73.065,
      "transcript": "ਹੋਇ ਤ੍ਰਿਪਤਾਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.72,
      "end_time": 90.36,
      "transcript": "ਹੇ ਜਿਹਵੇ ਤੂੰ ਰਾਮ ਗੁਣ ਗਾਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.36,
      "end_time": 98.844,
      "transcript": "ਨਿਮਖ ਨਿਮਖ, ਹਰਿ ਹਰਿ ਹਰਿ ਧਿਆਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 98.844,
      "end_time": 107.491,
      "transcript": "ਆਨ ਨ ਸੁਨੀਐ, ਕਤਹੂੰ ਜਾਈਐ"
    },
    {
      "section_id": "section-00012",
      "start_time": 107.491,
      "end_time": 116.001,
      "transcript": "ਸਾਧਸੰਗਤਿ, ਵਡਭਾਗੀ ਪਾਈਐ"
    },
    {
      "section_id": "section-00013",
      "start_time": 116.001,
      "end_time": 124.696,
      "transcript": "ਆਠ ਪਹਰ, ਜਿਹਵੇ ਆਰਾਧਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 124.696,
      "end_time": 133.312,
      "transcript": "ਪਾਰਬ੍ਰਹਮ, ਠਾਕੁਰ ਆਗਾਧਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 133.312,
      "end_time": 141.92,
      "transcript": "ਈਹਾ ਊਹਾ, ਸਦਾ ਸੁਹੇਲੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 141.92,
      "end_time": 150.27,
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਵਤ, ਰਸਨ ਅਮੋਲੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 150.27,
      "end_time": 159.08,
      "transcript": "ਬਨਸਪਤਿ ਮਉਲੀ, ਫਲ ਫੁਲ ਪੇਡੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 159.08,
      "end_time": 167.404,
      "transcript": "ਇਹ ਰਸ ਰਾਤੀ, ਬਹੁਰਿ ਨ ਛੋਡੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 167.404,
      "end_time": 176.006,
      "transcript": "ਆਨ ਨ ਰਸ ਕਸ, ਲਵੈ ਨ ਲਾਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 176.006,
      "end_time": 184.35,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਗੁਰ ਭਏ ਹੈ ਸਹਾਈ"
    }
  ]
}

{
  "audio_file": "0181 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.105,
      "end_time": 7.262,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.055,
      "end_time": 21.01,
      "transcript": "ਬਿਨੁ ਸਿਮਰਨ, ਜੈਸੇ ਸਰਪ ਆਰਜਾਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.01,
      "end_time": 28.16,
      "transcript": "ਤਿਉ ਜੀਵਹਿ ਸਾਕਤ, ਨਾਮੁ ਬਿਸਾਰੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.16,
      "end_time": 35.12,
      "transcript": "ਏਕ ਨਿਮਖ, ਜੋ ਸਿਮਰਨ ਮਹਿ ਜੀਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.12,
      "end_time": 42.127,
      "transcript": "ਕੋਟਿ ਦਿਨਸ ਲਾਖ, ਸਦਾ ਥਿਰੁ ਥੀਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.605,
      "end_time": 59.475,
      "transcript": "ਬਿਨੁ ਸਿਮਰਨ, ਧ੍ਰਿਗੁ ਕਰਮ ਕਰਾਸ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.84,
      "end_time": 66.675,
      "transcript": "ਕਾਗ ਬਤਨ, ਬਿਸਟਾ ਮਹਿ ਵਾਸ"
    },
    {
      "section_id": "section-00008",
      "start_time": 66.675,
      "end_time": 73.69,
      "transcript": "ਬਿਨੁ ਸਿਮਰਨ, ਭਏ ਕੂਕਰ ਕਾਮ"
    },
    {
      "section_id": "section-00009",
      "start_time": 73.69,
      "end_time": 80.605,
      "transcript": "ਸਾਕਤ ਬੇਸੁਆ ਪੂਤ, ਨਿਨਾਮ"
    },
    {
      "section_id": "section-00010",
      "start_time": 80.605,
      "end_time": 87.825,
      "transcript": "ਬਿਨੁ ਸਿਮਰਨ, ਜੈਸੇ ਸੀਙ ਛਤਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.825,
      "end_time": 94.965,
      "transcript": "ਬੋਲਹਿ ਕੂਰੁ, ਸਾਕਤ ਮੁਖੁ ਕਾਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 94.965,
      "end_time": 102.16,
      "transcript": "ਬਿਨੁ ਸਿਮਰਨ, ਗਰਧਭ ਕੀ ਨਿਆਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 102.16,
      "end_time": 108.98,
      "transcript": "ਸਾਕਤ, ਥਾਨ ਭਰਿਸਟ ਫਿਰਾਹੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 108.98,
      "end_time": 116.32,
      "transcript": "ਬਿਨੁ ਸਿਮਰਨ, ਕੂਕਰ ਹਰਕਾਇਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 116.32,
      "end_time": 123.215,
      "transcript": "ਸਾਕਤ ਲੋਭੀ, ਬੰਧੁ ਨ ਪਾਇਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 123.215,
      "end_time": 129.965,
      "transcript": "ਬਿਨੁ ਸਿਮਰਨ, ਹੈ ਆਤਮ ਘਾਤੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 130.44,
      "end_time": 137.185,
      "transcript": "ਸਾਕਤ ਨੀਚ, ਤਿਸੁ ਕੁਲੁ ਨਹੀ ਜਾਤੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 137.185,
      "end_time": 144.305,
      "transcript": "ਜਿਸੁ ਭਇਆ ਕ੍ਰਿਪਾਲੁ, ਤਿਸੁ ਸਤਸੰਗਿ ਮਿਲਾਇਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 144.305,
      "end_time": 151.4,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਗੁਰਿ ਜਗਤੁ ਤਰਾਇਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 151.4,
      "end_time": 158.395,
      "transcript": "ਜਿਸੁ ਭਇਆ ਕ੍ਰਿਪਾਲੁ, ਤਿਸੁ ਸਤਸੰਗਿ ਮਿਲਾਇਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 158.395,
      "end_time": 165.595,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਗੁਰਿ ਜਗਤੁ ਤਰਾਇਆ"
    }
  ]

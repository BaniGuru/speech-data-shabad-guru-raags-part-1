{
  "audio_file": "0142 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 8.574,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.885,
      "end_time": 24.016,
      "transcript": "ਕਾ ਕੀ ਮਾਈ, ਕਾ ਕੋ ਬਾਪ"
    },
    {
      "section_id": "section-00003",
      "start_time": 24.016,
      "end_time": 32.165,
      "transcript": "ਨਾਮ ਧਾਰੀਕ, ਝੂਠੇ ਸਭਿ ਸਾਕ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.165,
      "end_time": 39.995,
      "transcript": "ਕਾਹੇ ਕਉ, ਮੂਰਖ ਭਖਲਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.995,
      "end_time": 48.383,
      "transcript": "ਮਿਲਿ ਸੰਜੋਗਿ, ਹੁਕਮਿ ਤੂੰ ਆਇਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.0,
      "end_time": 75.655,
      "transcript": "ਏਕਾ ਮਾਟੀ, ਏਕਾ ਜੋਤਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.04,
      "end_time": 83.545,
      "transcript": "ਏਕੋ ਪਵਨੁ, ਕਹਾ ਕਉਨੁ ਰੋਤਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.015,
      "end_time": 91.96,
      "transcript": "ਮੇਰਾ ਮੇਰਾ ਕਰਿ, ਬਿਲਲਾਹੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 91.96,
      "end_time": 99.495,
      "transcript": "ਮਰਣਹਾਰੁ, ਇਹੁ ਜੀਅਰਾ ਨਾਹੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 100.055,
      "end_time": 107.854,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਗੁਰਿ ਖੋਲੇ ਕਪਾਟ"
    },
    {
      "section_id": "section-00011",
      "start_time": 107.854,
      "end_time": 115.265,
      "transcript": "ਮੁਕਤੁ ਭਏ, ਬਿਨਸੇ ਭ੍ਰਮ ਥਾਟ"
    }
  ]
}

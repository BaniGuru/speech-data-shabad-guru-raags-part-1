{
  "audio_file": "0117 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.941,
      "end_time": 14.886,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 33.24,
      "end_time": 40.241,
      "transcript": "ਕਿਰਤੁ ਪਇਆ, ਨਹ ਮੇਟੈ ਕੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 40.241,
      "end_time": 47.556,
      "transcript": "ਕਿਆ ਜਾਣਾ, ਕਿਆ ਆਗੈ ਹੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 47.556,
      "end_time": 54.885,
      "transcript": "ਜੋ ਤਿਸੁ ਭਾਣਾ, ਸੋਈ ਹੂਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 54.885,
      "end_time": 61.977,
      "transcript": "ਅਵਰੁ ਨ ਕਰਣੈ ਵਾਲਾ ਦੂਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 61.977,
      "end_time": 69.003,
      "transcript": "ਨਾ ਜਾਣਾ ਕਰਮ, ਕੇਵਡ ਤੇਰੀ ਦਾਤਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 69.003,
      "end_time": 76.296,
      "transcript": "ਕਰਮੁ ਧਰਮੁ ਤੇਰੇ ਨਾਮ ਕੀ ਜਾਤਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 83.64,
      "end_time": 90.517,
      "transcript": "ਤੂ ਏਵਡੁ ਦਾਤਾ, ਦੇਵਣਹਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 90.517,
      "end_time": 97.793,
      "transcript": "ਤੋਟਿ ਨਾਹੀ, ਤੁਧੁ ਭਗਤਿ ਭੰਡਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 97.793,
      "end_time": 104.801,
      "transcript": "ਕੀਆ ਗਰਬੁ, ਨ ਆਵੈ ਰਾਸਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.801,
      "end_time": 112.107,
      "transcript": "ਜੀਉ ਪਿੰਡੁ, ਸਭੁ ਤੇਰੈ ਪਾਸਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 112.107,
      "end_time": 119.165,
      "transcript": "ਤੂ ਮਾਰਿ ਜੀਵਾਲਹਿ, ਬਖਸਿ ਮਿਲਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 119.165,
      "end_time": 126.318,
      "transcript": "ਜਿਉ ਭਾਵੀ, ਤਿਉ ਨਾਮੁ ਜਪਾਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 126.318,
      "end_time": 133.353,
      "transcript": "ਤੂੰ ਦਾਨਾ ਬੀਨਾ, ਸਾਚਾ ਸਿਰਿ ਮੇਰੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 133.353,
      "end_time": 140.563,
      "transcript": "ਗੁਰਮਤਿ ਦੇਇ, ਭਰੋਸੈ ਤੇਰੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 140.563,
      "end_time": 147.502,
      "transcript": "ਤਨ ਮਹਿ ਮੈਲੁ ਨਾਹੀ ਮਨੁ ਰਾਤਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 147.502,
      "end_time": 154.775,
      "transcript": "ਗੁਰ ਬਚਨੀ ਸਚੁ ਸਬਦਿ ਪਛਾਤਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 154.775,
      "end_time": 161.885,
      "transcript": "ਤੇਰਾ ਤਾਣੁ, ਨਾਮ ਕੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 161.885,
      "end_time": 168.972,
      "transcript": "ਨਾਨਕ ਰਹਣਾ ਭਗਤਿ ਸਰਣਾਈ"
    }
  ]
}

{
  "audio_file": "0144 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.12,
      "end_time": 6.475,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.96,
      "end_time": 19.108,
      "transcript": "ਕਲਿ ਕਲੇਸ, ਗੁਰ ਸਬਦਿ ਨਿਵਾਰੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.108,
      "end_time": 25.56,
      "transcript": "ਆਵਣ ਜਾਣ ਰਹੇ, ਸੁਖ ਸਾਰੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.56,
      "end_time": 31.96,
      "transcript": "ਭੈ ਬਿਨਸੇ, ਨਿਰਭਉ ਹਰਿ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.96,
      "end_time": 39.665,
      "transcript": "ਸਾਧਸੰਗਿ, ਹਰਿ ਕੇ ਗੁਣ ਗਾਇਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 47.8,
      "end_time": 53.917,
      "transcript": "ਚਰਨ ਕਵਲ, ਰਿਦ ਅੰਤਰਿ ਧਾਰੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.917,
      "end_time": 60.52,
      "transcript": "ਅਗਨਿ ਸਾਗਰ, ਗੁਰਿ ਪਾਰਿ ਉਤਾਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.52,
      "end_time": 66.77,
      "transcript": "ਬੂਡਤ ਜਾਤ, ਪੂਰੈ ਗੁਰਿ ਕਾਢੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.77,
      "end_time": 73.335,
      "transcript": "ਜਨਮ ਜਨਮ ਕੇ, ਟੂਟੇ ਗਾਢੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.68,
      "end_time": 85.745,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਤਿਸੁ ਗੁਰ ਬਲਿਹਾਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.12,
      "end_time": 92.335,
      "transcript": "ਜਿਸੁ ਭੇਟਤ, ਗਤਿ ਭਈ ਹਮਾਰੀ"
    }
  ]
}

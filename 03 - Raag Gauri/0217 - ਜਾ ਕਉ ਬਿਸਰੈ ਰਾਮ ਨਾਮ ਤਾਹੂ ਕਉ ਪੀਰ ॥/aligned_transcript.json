{
  "audio_file": "0160 C PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 7.003,
      "transcript": "ਗਉੜੀ₂ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.875,
      "end_time": 22.055,
      "transcript": "ਜਾ ਕਉ ਬਿਸਰੈ ਰਾਮ ਨਾਮ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.355,
      "end_time": 29.615,
      "transcript": "ਤਾਹੂ ਕਉ ਪੀਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.0,
      "end_time": 37.56,
      "transcript": "ਸਾਧਸੰਗਤਿ ਮਿਲਿ ਹਰਿ ਰਵਹਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.56,
      "end_time": 45.054,
      "transcript": "ਸੇ ਗੁਣੀ ਗਹੀਰ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.345,
      "end_time": 59.405,
      "transcript": "ਜਾ ਕਉ, ਗੁਰਮੁਖਿ ਰਿਦੈ ਬੁਧਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.96,
      "end_time": 67.025,
      "transcript": "ਤਾ ਕੈ ਕਰ ਤਲ, ਨਵ ਨਿਧਿ ਸਿਧਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.455,
      "end_time": 74.685,
      "transcript": "ਜੋ ਜਾਨਹਿ, ਹਰਿ ਪ੍ਰਭ ਧਨੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.105,
      "end_time": 82.475,
      "transcript": "ਕਿਛੁ ਨਾਹੀ, ਤਾ ਕੈ ਕਮੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.765,
      "end_time": 90.255,
      "transcript": "ਕਰਣੈਹਾਰੁ ਪਛਾਨਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 90.48,
      "end_time": 97.585,
      "transcript": "ਸਰਬ ਸੂਖ ਰੰਗ ਮਾਣਿਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 98.16,
      "end_time": 105.035,
      "transcript": "ਹਰਿ ਧਨੁ, ਜਾ ਕੈ ਗ੍ਰਿਹਿ ਵਸੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 105.6,
      "end_time": 112.315,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਤਿਨ ਸੰਗਿ ਦੁਖੁ ਨਸੈ"
    }
  ]
}

{
  "audio_file": "0134 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.103,
      "end_time": 6.24,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.4,
      "end_time": 18.68,
      "transcript": "ਤਿਸ ਕੀ ਸਰਣਿ, ਨਾਹੀ ਭਉ ਸੋਗੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.68,
      "end_time": 24.96,
      "transcript": "ਉਸ ਤੇ ਬਾਹਰਿ, ਕਛੂ ਨ ਹੋਗੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.96,
      "end_time": 31.024,
      "transcript": "ਤਜੀ ਸਿਆਣਪ, ਬਲ ਬੁਧਿ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.024,
      "end_time": 37.239,
      "transcript": "ਦਾਸ ਅਪਨੇ ਕੀ ਰਾਖਨਹਾਰ"
    },
    {
      "section_id": "section-00006",
      "start_time": 37.239,
      "end_time": 43.48,
      "transcript": "ਜਪਿ ਮਨ ਮੇਰੇ, ਰਾਮ ਰਾਮ ਰੰਗਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 43.48,
      "end_time": 53.22,
      "transcript": "ਘਰਿ ਬਾਹਰਿ ਤੇਰੈ ਸਦ ਸੰਗਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.8,
      "end_time": 65.04,
      "transcript": "ਤਿਸ ਕੀ ਟੇਕ, ਮਨੈ ਮਹਿ ਰਾਖੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.04,
      "end_time": 71.083,
      "transcript": "ਗੁਰ ਕਾ ਸਬਦੁ, ਅੰਮ੍ਰਿਤ ਰਸੁ ਚਾਖੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.083,
      "end_time": 77.324,
      "transcript": "ਅਵਰਿ ਜਤਨ, ਕਹਹੁ ਕਉਨ ਕਾਜ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.324,
      "end_time": 83.8,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਰਾਖੈ ਆਪਿ ਲਾਜ"
    },
    {
      "section_id": "section-00012",
      "start_time": 83.8,
      "end_time": 90.04,
      "transcript": "ਕਿਆ ਮਾਨੁਖ, ਕਹਹੁ ਕਿਆ ਜੋਰੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 90.04,
      "end_time": 96.36,
      "transcript": "ਝੂਠਾ, ਮਾਇਆ ਕਾ ਸਭੁ ਸੋਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 96.36,
      "end_time": 102.56,
      "transcript": "ਕਰਣ ਕਰਾਵਨਹਾਰ, ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 102.56,
      "end_time": 108.72,
      "transcript": "ਸਗਲ ਘਟਾ ਕੇ ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 108.72,
      "end_time": 115.0,
      "transcript": "ਸਰਬ ਸੁਖਾ ਸੁਖੁ ਸਾਚਾ ਏਹੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 115.0,
      "end_time": 121.114,
      "transcript": "ਗੁਰ ਉਪਦੇਸੁ, ਮਨੈ ਮਹਿ ਲੇਹੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 121.114,
      "end_time": 127.48,
      "transcript": "ਜਾ ਕਉ, ਰਾਮ ਨਾਮ ਲਿਵ ਲਾਗੀ"
    },
    {
      "section_id": "section-00019",
      "start_time": 127.48,
      "end_time": 133.66,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਸੋ ਧੰਨੁ ਵਡਭਾਗੀ"
    }
  ]
}

{
  "audio_file": "0149 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.195,
      "end_time": 7.092,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.865,
      "end_time": 19.28,
      "transcript": "ਜੋ ਪ੍ਰਾਣੀ, ਗੋਵਿੰਦੁ ਧਿਆਵੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.28,
      "end_time": 25.76,
      "transcript": "ਪੜਿਆ ਅਣਪੜਿਆ, ਪਰਮ ਗਤਿ ਪਾਵੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.76,
      "end_time": 31.695,
      "transcript": "ਸਾਧੂ ਸੰਗਿ, ਸਿਮਰਿ ਗੋਪਾਲ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.975,
      "end_time": 41.685,
      "transcript": "ਬਿਨੁ ਨਾਵੈ, ਝੂਠਾ ਧਨੁ ਮਾਲੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.085,
      "end_time": 54.6,
      "transcript": "ਰੂਪਵੰਤੁ, ਸੋ ਚਤੁਰੁ ਸਿਆਣਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.6,
      "end_time": 61.0,
      "transcript": "ਜਿਨਿ ਜਨਿ ਮਾਨਿਆ, ਪ੍ਰਭ ਕਾ ਭਾਣਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.0,
      "end_time": 67.48,
      "transcript": "ਜਗ ਮਹਿ ਆਇਆ, ਸੋ ਪਰਵਾਣੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.48,
      "end_time": 74.105,
      "transcript": "ਘਟਿ ਘਟਿ, ਅਪਣਾ ਸੁਆਮੀ ਜਾਣੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 80.36,
      "end_time": 86.63,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਾ ਕੇ ਪੂਰਨ ਭਾਗ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.63,
      "end_time": 92.705,
      "transcript": "ਹਰਿ ਚਰਣੀ, ਤਾ ਕਾ ਮਨੁ ਲਾਗ"
    }
  ]
}

{
  "audio_file": "0138 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.08,
      "end_time": 15.543,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.543,
      "end_time": 27.171,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 46.52,
      "end_time": 54.0,
      "transcript": "ਜਾ ਕੈ ਵਸਿ, ਖਾਨ ਸੁਲਤਾਨ"
    },
    {
      "section_id": "section-00004",
      "start_time": 54.0,
      "end_time": 61.48,
      "transcript": "ਜਾ ਕੈ ਵਸਿ ਹੈ, ਸਗਲ ਜਹਾਨ"
    },
    {
      "section_id": "section-00005",
      "start_time": 61.48,
      "end_time": 68.8,
      "transcript": "ਜਾ ਕਾ ਕੀਆ, ਸਭੁ ਕਿਛੁ ਹੋਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.8,
      "end_time": 76.16,
      "transcript": "ਤਿਸ ਤੇ ਬਾਹਰਿ, ਨਾਹੀ ਕੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.16,
      "end_time": 83.68,
      "transcript": "ਕਹੁ ਬੇਨੰਤੀ, ਅਪੁਨੇ ਸਤਿਗੁਰ ਪਾਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 83.68,
      "end_time": 94.65,
      "transcript": "ਕਾਜ ਤੁਮਾਰੇ ਦੇਇ ਨਿਬਾਹਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 105.52,
      "end_time": 112.92,
      "transcript": "ਸਭ ਤੇ ਊਚ, ਜਾ ਕਾ ਦਰਬਾਰੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 112.92,
      "end_time": 120.2,
      "transcript": "ਸਗਲ ਭਗਤ, ਜਾ ਕਾ ਨਾਮੁ ਅਧਾਰੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 120.2,
      "end_time": 127.56,
      "transcript": "ਸਰਬ ਬਿਆਪਿਤ, ਪੂਰਨ ਧਨੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 127.56,
      "end_time": 135.054,
      "transcript": "ਜਾ ਕੀ ਸੋਭਾ, ਘਟਿ ਘਟਿ ਬਨੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 142.16,
      "end_time": 149.44,
      "transcript": "ਜਿਸੁ ਸਿਮਰਤ, ਦੁਖ ਡੇਰਾ ਢਹੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 149.44,
      "end_time": 156.72,
      "transcript": "ਜਿਸੁ ਸਿਮਰਤ, ਜਮੁ ਕਿਛੂ ਨ ਕਹੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 156.72,
      "end_time": 163.726,
      "transcript": "ਜਿਸੁ ਸਿਮਰਤ ਹੋਤ ਸੂਕੇ ਹਰੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 163.726,
      "end_time": 171.584,
      "transcript": "ਜਿਸੁ ਸਿਮਰਤ ਡੂਬਤ ਪਾਹਨ ਤਰੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 178.48,
      "end_time": 185.68,
      "transcript": "ਸੰਤ ਸਭਾ ਕਉ, ਸਦਾ ਜੈਕਾਰੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 185.68,
      "end_time": 192.8,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਜਨ ਪ੍ਰਾਨ ਅਧਾਰੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 192.8,
      "end_time": 199.88,
      "transcript": "ਕਹੁ ਨਾਨਕ ਮੇਰੀ ਸੁਣੀ ਅਰਦਾਸਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 199.88,
      "end_time": 206.68,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਮੋ ਕਉ ਨਾਮ ਨਿਵਾਸਿ"
    }
  ]
}

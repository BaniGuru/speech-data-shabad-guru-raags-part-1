  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.245,
      "end_time": 4.545,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.0,
      "end_time": 20.375,
      "transcript": "ਭੈ ਭੰਜਨ ਅਘ ਦੂਖ ਨਾਸ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.375,
      "end_time": 28.319,
      "transcript": "ਮਨਹਿ ਅਰਾਧਿ ਹਰੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.319,
      "end_time": 35.705,
      "transcript": "ਸੰਤਸੰਗ ਜਿਹ ਰਿਦ ਬਸਿਓ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.005,
      "end_time": 46.405,
      "transcript": "ਨਾਨਕ ਤੇ ਨ ਭ੍ਰਮੇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.96,
      "end_time": 55.155,
      "transcript": "ਭਭਾ, ਭਰਮੁ ਮਿਟਾਵਹੁ ਅਪਨਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.155,
      "end_time": 59.455,
      "transcript": "ਇਆ ਸੰਸਾਰੁ, ਸਗਲ ਹੈ ਸੁਪਨਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.455,
      "end_time": 63.65,
      "transcript": "ਭਰਮੇ, ਸੁਰਿ ਨਰ ਦੇਵੀ ਦੇਵਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.65,
      "end_time": 67.96,
      "transcript": "ਭਰਮੇ, ਸਿਧ ਸਾਧਿਕ ਬ੍ਰਹਮੇਵਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 67.96,
      "end_time": 72.095,
      "transcript": "ਭਰਮਿ ਭਰਮਿ, ਮਾਨੁਖ ਡਹਕਾਏ"
    },
    {
      "section_id": "section-00011",
      "start_time": 72.095,
      "end_time": 76.28,
      "transcript": "ਦੁਤਰ ਮਹਾ ਬਿਖਮ, ਇਹ ਮਾਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 76.28,
      "end_time": 80.48,
      "transcript": "ਗੁਰਮੁਖਿ, ਭ੍ਰਮ ਭੈ ਮੋਹ ਮਿਟਾਇਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 80.48,
      "end_time": 85.575,
      "transcript": "ਨਾਨਕ ਤੇਹ, ਪਰਮ ਸੁਖ ਪਾਇਆ"
    }
  ]
}

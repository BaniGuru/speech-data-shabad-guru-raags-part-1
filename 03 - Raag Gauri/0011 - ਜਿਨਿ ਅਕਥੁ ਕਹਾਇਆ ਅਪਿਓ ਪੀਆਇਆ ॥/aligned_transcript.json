{
  "audio_file": "0117 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.103,
      "end_time": 6.9,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.2,
      "end_time": 21.221,
      "transcript": "ਜਿਨਿ ਅਕਥੁ ਕਹਾਇਆ, ਅਪਿਓ ਪੀਆਇਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.221,
      "end_time": 28.075,
      "transcript": "ਅਨ ਭੈ ਵਿਸਰੇ, ਨਾਮਿ ਸਮਾਇਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.075,
      "end_time": 35.169,
      "transcript": "ਕਿਆ ਡਰੀਐ, ਡਰੁ ਡਰਹਿ ਸਮਾਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.169,
      "end_time": 42.499,
      "transcript": "ਪੂਰੇ ਗੁਰ ਕੈ ਸਬਦਿ ਪਛਾਨਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.28,
      "end_time": 56.292,
      "transcript": "ਜਿਸੁ ਨਰ ਰਾਮੁ ਰਿਦੈ ਹਰਿ ਰਾਸਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.292,
      "end_time": 63.315,
      "transcript": "ਸਹਜਿ ਸੁਭਾਇ ਮਿਲੇ ਸਾਬਾਸਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.315,
      "end_time": 70.263,
      "transcript": "ਜਾਹਿ ਸਵਾਰੈ ਸਾਝ ਬਿਆਲ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.263,
      "end_time": 77.619,
      "transcript": "ਇਤ ਉਤ ਮਨਮੁਖ, ਬਾਧੇ ਕਾਲ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.619,
      "end_time": 84.625,
      "transcript": "ਅਹਿਨਿਸਿ ਰਾਮੁ ਰਿਦੈ, ਸੇ ਪੂਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.625,
      "end_time": 91.573,
      "transcript": "ਨਾਨਕ ਰਾਮ ਮਿਲੇ, ਭ੍ਰਮ ਦੂਰੇ"
    }
  ]
}

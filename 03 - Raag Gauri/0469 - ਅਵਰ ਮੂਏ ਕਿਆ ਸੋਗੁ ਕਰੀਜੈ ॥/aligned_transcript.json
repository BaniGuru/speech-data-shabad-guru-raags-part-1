{
  "audio_file": "0240 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.075,
      "end_time": 6.465,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.36,
      "end_time": 18.44,
      "transcript": "ਅਵਰ ਮੂਏ, ਕਿਆ ਸੋਗੁ ਕਰੀਜੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.44,
      "end_time": 24.52,
      "transcript": "ਤਉ ਕੀਜੈ, ਜਉ ਆਪਨ ਜੀਜੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.52,
      "end_time": 30.455,
      "transcript": "ਮੈ ਨ ਮਰਉ, ਮਰਿਬੋ ਸੰਸਾਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.455,
      "end_time": 39.695,
      "transcript": "ਅਬ ਮੋਹਿ ਮਿਲਿਓ ਹੈ, ਜੀਆਵਨਹਾਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.76,
      "end_time": 51.96,
      "transcript": "ਇਆ ਦੇਹੀ, ਪਰਮਲ ਮਹਕੰਦਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.96,
      "end_time": 57.855,
      "transcript": "ਤਾ ਸੁਖ, ਬਿਸਰੇ ਪਰਮਾਨੰਦਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.075,
      "end_time": 64.09,
      "transcript": "ਕੂਅਟਾ ਏਕੁ, ਪੰਚ ਪਨਿਹਾਰੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.09,
      "end_time": 70.12,
      "transcript": "ਟੂਟੀ ਲਾਜੁ, ਭਰੈ ਮਤਿ ਹਾਰੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.12,
      "end_time": 76.075,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਇਕ ਬੁਧਿ ਬੀਚਾਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 76.295,
      "end_time": 81.975,
      "transcript": "ਨਾ ਓਹੁ ਕੂਅਟਾ, ਨਾ ਪਨਿਹਾਰੀ"
    }
  ]
}

{
  "audio_file": "0146 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 6.625,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.12,
      "end_time": 19.155,
      "transcript": "ਹਿਰਦੈ, ਚਰਨ ਕਮਲ ਪ੍ਰਭ ਧਾਰੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.64,
      "end_time": 25.545,
      "transcript": "ਪੂਰੇ ਸਤਿਗੁਰ ਮਿਲਿ, ਨਿਸਤਾਰੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.035,
      "end_time": 32.44,
      "transcript": "ਗੋਵਿੰਦ ਗੁਣ ਗਾਵਹੁ, ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.44,
      "end_time": 40.605,
      "transcript": "ਮਿਲਿ ਸਾਧੂ, ਹਰਿ ਨਾਮੁ ਧਿਆਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.32,
      "end_time": 55.04,
      "transcript": "ਦੁਲਭ ਦੇਹ, ਹੋਈ ਪਰਵਾਨੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.04,
      "end_time": 61.52,
      "transcript": "ਸਤਿਗੁਰ ਤੇ, ਪਾਇਆ ਨਾਮ ਨੀਸਾਨੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.52,
      "end_time": 67.88,
      "transcript": "ਹਰਿ ਸਿਮਰਤ, ਪੂਰਨ ਪਦੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.88,
      "end_time": 74.555,
      "transcript": "ਸਾਧਸੰਗਿ, ਭੈ ਭਰਮ ਮਿਟਾਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 80.725,
      "end_time": 86.775,
      "transcript": "ਜਤ ਕਤ ਦੇਖਉ, ਤਤ ਰਹਿਆ ਸਮਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.175,
      "end_time": 93.515,
      "transcript": "ਨਾਨਕ ਦਾਸ, ਹਰਿ ਕੀ ਸਰਣਾਇ"
    }
  ]
}

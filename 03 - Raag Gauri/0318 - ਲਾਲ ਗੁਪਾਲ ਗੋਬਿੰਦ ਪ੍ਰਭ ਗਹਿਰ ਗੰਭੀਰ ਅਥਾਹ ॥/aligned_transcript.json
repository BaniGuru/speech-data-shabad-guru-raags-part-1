  "audio_file": "0190 F Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.785,
      "end_time": 6.533,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.285,
      "end_time": 20.92,
      "transcript": "ਲਾਲ ਗੁਪਾਲ ਗੋਬਿੰਦ ਪ੍ਰਭ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.92,
      "end_time": 26.818,
      "transcript": "ਗਹਿਰ ਗੰਭੀਰ ਅਥਾਹ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.818,
      "end_time": 33.693,
      "transcript": "ਦੂਸਰ ਨਾਹੀ ਅਵਰ ਕੋ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.693,
      "end_time": 44.228,
      "transcript": "ਨਾਨਕ ਬੇਪਰਵਾਹ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.645,
      "end_time": 57.802,
      "transcript": "ਲਲਾ, ਤਾ ਕੈ ਲਵੈ ਨ ਕੋਊ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.802,
      "end_time": 62.4,
      "transcript": "ਏਕਹਿ ਆਪਿ, ਅਵਰ ਨਹ ਹੋਊ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.4,
      "end_time": 70.593,
      "transcript": "ਹੋਵਨਹਾਰੁ, ਹੋਤ ਸਦ ਆਇਆ ਉਆ ਕਾ ਅੰਤੁ, ਨ ਕਾਹੂ ਪਾਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.593,
      "end_time": 75.2,
      "transcript": "ਕੀਟ ਹਸਤਿ ਮਹਿ, ਪੂਰ ਸਮਾਨੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.2,
      "end_time": 79.455,
      "transcript": "ਪ੍ਰਗਟ ਪੁਰਖ, ਸਭ ਠਾਊ ਜਾਨੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.455,
      "end_time": 88.503,
      "transcript": "ਜਾ ਕਉ ਦੀਨੋ, ਹਰਿ ਰਸੁ ਅਪਨਾ ਨਾਨਕ ਗੁਰਮੁਖਿ, ਹਰਿ ਹਰਿ ਤਿਹ ਜਪਨਾ"
    }
  ]
}

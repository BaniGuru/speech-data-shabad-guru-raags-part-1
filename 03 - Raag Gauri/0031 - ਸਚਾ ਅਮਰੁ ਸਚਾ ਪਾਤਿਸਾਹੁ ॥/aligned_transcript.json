{
  "audio_file": "0122 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.44,
      "end_time": 15.809,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਤੀਜਾ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 26.08,
      "end_time": 33.497,
      "transcript": "ਸਚਾ ਅਮਰੁ, ਸਚਾ ਪਾਤਿਸਾਹੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 33.497,
      "end_time": 40.6,
      "transcript": "ਮਨਿ ਸਾਚੈ ਰਾਤੇ, ਹਰਿ ਵੇਪਰਵਾਹੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.04,
      "end_time": 48.15,
      "transcript": "ਸਚੈ ਮਹਲਿ, ਸਚਿ ਨਾਮਿ ਸਮਾਹੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 48.15,
      "end_time": 55.682,
      "transcript": "ਸੁਣਿ ਮਨ ਮੇਰੇ, ਸਬਦੁ ਵੀਚਾਰਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 55.682,
      "end_time": 63.696,
      "transcript": "ਰਾਮ ਜਪਹੁ ਭਵਜਲੁ ਉਤਰਹੁ ਪਾਰਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.44,
      "end_time": 77.8,
      "transcript": "ਭਰਮੇ ਆਵੈ, ਭਰਮੇ ਜਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.8,
      "end_time": 85.08,
      "transcript": "ਇਹੁ ਜਗੁ ਜਨਮਿਆ, ਦੂਜੈ ਭਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 85.08,
      "end_time": 92.36,
      "transcript": "ਮਨਮੁਖਿ ਨ ਚੇਤੈ, ਆਵੈ ਜਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.36,
      "end_time": 99.461,
      "transcript": "ਆਪਿ ਭੁਲਾ ਕਿ, ਪ੍ਰਭਿ ਆਪਿ ਭੁਲਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 99.461,
      "end_time": 106.714,
      "transcript": "ਇਹੁ ਜੀਉ ਵਿਡਾਣੀ ਚਾਕਰੀ ਲਾਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.714,
      "end_time": 113.645,
      "transcript": "ਮਹਾ ਦੁਖੁ ਖਟੇ, ਬਿਰਥਾ ਜਨਮੁ ਗਵਾਇਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 113.645,
      "end_time": 121.031,
      "transcript": "ਕਿਰਪਾ ਕਰਿ, ਸਤਿਗੁਰੂ ਮਿਲਾਏ"
    },
    {
      "section_id": "section-00014",
      "start_time": 121.031,
      "end_time": 127.96,
      "transcript": "ਏਕੋ ਨਾਮੁ ਚੇਤੇ, ਵਿਚਹੁ ਭਰਮੁ ਚੁਕਾਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 127.96,
      "end_time": 134.818,
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਜਪੇ, ਨਾਉ ਨਉ ਨਿਧਿ ਪਾਏ"
    }
  ]
}

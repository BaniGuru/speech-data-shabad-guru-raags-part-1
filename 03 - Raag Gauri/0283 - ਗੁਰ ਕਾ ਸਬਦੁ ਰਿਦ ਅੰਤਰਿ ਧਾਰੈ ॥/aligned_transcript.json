{
  "audio_file": "0180 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.095,
      "end_time": 15.535,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 31.435,
      "end_time": 37.8,
      "transcript": "ਗੁਰ ਕਾ ਸਬਦੁ, ਰਿਦ ਅੰਤਰਿ ਧਾਰੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.8,
      "end_time": 44.225,
      "transcript": "ਪੰਚ ਜਨਾ ਸਿਉ, ਸੰਗੁ ਨਿਵਾਰੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.225,
      "end_time": 50.71,
      "transcript": "ਦਸ ਇੰਦ੍ਰੀ, ਕਰਿ ਰਾਖੈ ਵਾਸਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 50.71,
      "end_time": 57.2,
      "transcript": "ਤਾ ਕੈ ਆਤਮੈ, ਹੋਇ ਪਰਗਾਸੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 57.2,
      "end_time": 63.385,
      "transcript": "ਐਸੀ ਦ੍ਰਿੜਤਾ, ਤਾ ਕੈ ਹੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.385,
      "end_time": 72.635,
      "transcript": "ਜਾ ਕਉ, ਦਇਆ ਮਇਆ ਪ੍ਰਭ ਸੋਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 79.415,
      "end_time": 85.68,
      "transcript": "ਸਾਜਨੁ ਦੁਸਟੁ, ਜਾ ਕੈ ਏਕ ਸਮਾਨੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 85.68,
      "end_time": 92.005,
      "transcript": "ਜੇਤਾ ਬੋਲਣੁ, ਤੇਤਾ ਗਿਆਨੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.005,
      "end_time": 98.425,
      "transcript": "ਜੇਤਾ ਸੁਨਣਾ, ਤੇਤਾ ਨਾਮੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 98.425,
      "end_time": 104.795,
      "transcript": "ਜੇਤਾ ਪੇਖਨੁ, ਤੇਤਾ ਧਿਆਨੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 104.795,
      "end_time": 111.27,
      "transcript": "ਸਹਜੇ ਜਾਗਣੁ, ਸਹਜੇ ਸੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 111.27,
      "end_time": 117.56,
      "transcript": "ਸਹਜੇ ਹੋਤਾ ਜਾਇ, ਸੁ ਹੋਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 117.56,
      "end_time": 124.18,
      "transcript": "ਸਹਜਿ ਬੈਰਾਗੁ, ਸਹਜੇ ਹੀ ਹਸਨਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 124.18,
      "end_time": 130.59,
      "transcript": "ਸਹਜੇ ਚੂਪ, ਸਹਜੇ ਹੀ ਜਪਨਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 130.59,
      "end_time": 136.985,
      "transcript": "ਸਹਜੇ ਭੋਜਨੁ, ਸਹਜੇ ਭਾਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 136.985,
      "end_time": 143.55,
      "transcript": "ਸਹਜੇ ਮਿਟਿਓ, ਸਗਲ ਦੁਰਾਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 143.55,
      "end_time": 149.995,
      "transcript": "ਸਹਜੇ, ਹੋਆ ਸਾਧੂ ਸੰਗੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 149.995,
      "end_time": 156.385,
      "transcript": "ਸਹਜਿ, ਮਿਲਿਓ ਪਾਰਬ੍ਰਹਮੁ ਨਿਸੰਗੁ"
    },
    {
      "section_id": "section-00020",
      "start_time": 156.385,
      "end_time": 162.97,
      "transcript": "ਸਹਜੇ ਗ੍ਰਿਹ ਮਹਿ, ਸਹਜਿ ਉਦਾਸੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 162.97,
      "end_time": 169.4,
      "transcript": "ਸਹਜੇ, ਦੁਬਿਧਾ ਤਨ ਕੀ ਨਾਸੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 169.4,
      "end_time": 175.88,
      "transcript": "ਜਾ ਕੈ ਸਹਜਿ, ਮਨਿ ਭਇਆ ਅਨੰਦੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 175.893,
      "end_time": 182.201,
      "transcript": "ਤਾ ਕਉ ਭੇਟਿਆ, ਪਰਮਾਨੰਦੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 188.49,
      "end_time": 194.915,
      "transcript": "ਸਹਜੇ, ਅੰਮ੍ਰਿਤੁ ਪੀਓ ਨਾਮੁ"
    },
    {
      "section_id": "section-00025",
      "start_time": 194.915,
      "end_time": 201.275,
      "transcript": "ਸਹਜੇ, ਕੀਨੋ ਜੀਅ ਕੋ ਦਾਨੁ"
    },
    {
      "section_id": "section-00026",
      "start_time": 201.275,
      "end_time": 207.92,
      "transcript": "ਸਹਜ ਕਥਾ ਮਹਿ, ਆਤਮੁ ਰਸਿਆ"
    },
    {
      "section_id": "section-00027",
      "start_time": 207.92,
      "end_time": 214.24,
      "transcript": "ਤਾ ਕੈ ਸੰਗਿ, ਅਬਿਨਾਸੀ ਵਸਿਆ"
    },
    {
      "section_id": "section-00028",
      "start_time": 214.24,
      "end_time": 220.325,
      "transcript": "ਸਹਜੇ, ਆਸਣੁ ਅਸਥਿਰੁ ਭਾਇਆ"
    },
    {
      "section_id": "section-00029",
      "start_time": 220.785,
      "end_time": 227.19,
      "transcript": "ਸਹਜੇ, ਅਨਹਤ ਸਬਦੁ ਵਜਾਇਆ"
    },
    {
      "section_id": "section-00030",
      "start_time": 227.19,
      "end_time": 233.84,
      "transcript": "ਸਹਜੇ, ਰੁਣ ਝੁਣਕਾਰੁ ਸੁਹਾਇਆ"
    },
    {
      "section_id": "section-00031",
      "start_time": 233.84,
      "end_time": 240.11,
      "transcript": "ਤਾ ਕੈ ਘਰਿ, ਪਾਰਬ੍ਰਹਮੁ ਸਮਾਇਆ"
    },
    {
      "section_id": "section-00032",
      "start_time": 240.11,
      "end_time": 246.605,
      "transcript": "ਸਹਜੇ, ਜਾ ਕਉ ਪਰਿਓ ਕਰਮਾ"
    },
    {
      "section_id": "section-00033",
      "start_time": 246.605,
      "end_time": 253.005,
      "transcript": "ਸਹਜੇ ਗੁਰੁ ਭੇਟਿਓ, ਸਚੁ ਧਰਮਾ"
    },
    {
      "section_id": "section-00034",
      "start_time": 253.005,
      "end_time": 259.445,
      "transcript": "ਜਾ ਕੈ ਸਹਜੁ ਭਇਆ, ਸੋ ਜਾਣੈ"
    },
    {
      "section_id": "section-00035",
      "start_time": 259.445,
      "end_time": 265.525,
      "transcript": "ਨਾਨਕ ਦਾਸ, ਤਾ ਕੈ ਕੁਰਬਾਣੈ"
    }
  ]
}

{
  "audio_file": "0221 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.08,
      "end_time": 2.307,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.92,
      "end_time": 19.589,
      "transcript": "ਪੰਚ ਬਿਕਾਰ ਮਨ ਮਹਿ ਬਸੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.589,
      "end_time": 27.127,
      "transcript": "ਰਾਚੇ ਮਾਇਆ ਸੰਗਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.127,
      "end_time": 34.789,
      "transcript": "ਸਾਧਸੰਗਿ ਹੋਇ ਨਿਰਮਲਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.789,
      "end_time": 47.169,
      "transcript": "ਨਾਨਕ ਪ੍ਰਭ ਕੈ ਰੰਗਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.48,
      "end_time": 58.76,
      "transcript": "ਪੰਚਮਿ ਪੰਚ ਪ੍ਰਧਾਨ ਤੇ, ਜਿਹ ਜਾਨਿਓ ਪਰਪੰਚੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 58.76,
      "end_time": 66.885,
      "transcript": "ਕੁਸਮ ਬਾਸ ਬਹੁ ਰੰਗੁ ਘਣੋ, ਸਭ ਮਿਥਿਆ ਬਲਬੰਚੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 66.885,
      "end_time": 75.11,
      "transcript": "ਨਹ ਜਾਪੈ ਨਹ ਬੂਝੀਐ, ਨਹ ਕਛੁ ਕਰਤ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.11,
      "end_time": 83.445,
      "transcript": "ਸੁਆਦ ਮੋਹ ਰਸ ਬੇਧਿਓ, ਅਗਿਆਨਿ ਰਚਿਓ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.445,
      "end_time": 91.646,
      "transcript": "ਜਨਮ ਮਰਣ ਬਹੁ ਜੋਨਿ ਭ੍ਰਮਣ, ਕੀਨੇ ਕਰਮ ਅਨੇਕ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.646,
      "end_time": 99.645,
      "transcript": "ਰਚਨਹਾਰੁ ਨਹ ਸਿਮਰਿਓ, ਮਨਿ ਨ ਬੀਚਾਰਿ ਬਿਬੇਕ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.92,
      "end_time": 107.675,
      "transcript": "ਭਾਉ ਭਗਤਿ ਭਗਵਾਨ ਸੰਗਿ, ਮਾਇਆ ਲਿਪਤ ਨ ਰੰਚ"
    },
    {
      "section_id": "section-00013",
      "start_time": 107.88,
      "end_time": 117.235,
      "transcript": "ਨਾਨਕ ਬਿਰਲੇ ਪਾਈਅਹਿ, ਜੋ ਨ ਰਚਹਿ ਪਰਪੰਚ"
    }
  ]
}

      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 8.751,
      "end_time": 16.595,
      "transcript": "ਝਗਰਾ ਏਕੁ ਨਿਬੇਰਹੁ, ਰਾਮ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.16,
      "end_time": 27.585,
      "transcript": "ਜਉ ਤੁਮ, ਅਪਨੇ ਜਨ ਸੌ ਕਾਮੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.84,
      "end_time": 41.845,
      "transcript": "ਇਹੁ ਮਨੁ ਬਡਾ, ਕਿ ਜਾ ਸਉ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.045,
      "end_time": 49.655,
      "transcript": "ਰਾਮੁ ਬਡਾ, ਕੈ ਰਾਮਹਿ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.24,
      "end_time": 58.532,
      "transcript": "ਬ੍ਰਹਮਾ ਬਡਾ, ਕਿ ਜਾਸੁ ਉਪਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 58.532,
      "end_time": 66.075,
      "transcript": "ਬੇਦੁ ਬਡਾ, ਕਿ ਜਹਾਂ ਤੇ ਆਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 66.76,
      "end_time": 74.785,
      "transcript": "ਕਹਿ ਕਬੀਰ, ਹਉ ਭਇਆ ਉਦਾਸੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.0,
      "end_time": 82.965,
      "transcript": "ਤੀਰਥੁ ਬਡਾ, ਕਿ ਹਰਿ ਕਾ ਦਾਸੁ"
    }
  ]
}

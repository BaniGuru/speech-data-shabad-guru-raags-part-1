{
  "audio_file": "0115 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.326,
      "end_time": 17.007,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ ਦਖਣੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 31.8,
      "end_time": 38.545,
      "transcript": "ਸੁਣਿ ਸੁਣਿ ਬੂਝੈ, ਮਾਨੈ ਨਾਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 38.545,
      "end_time": 45.581,
      "transcript": "ਤਾ ਕੈ ਸਦ ਬਲਿਹਾਰੈ ਜਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.581,
      "end_time": 52.567,
      "transcript": "ਆਪਿ ਭੁਲਾਏ, ਠਉਰ ਨ ਠਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.567,
      "end_time": 59.291,
      "transcript": "ਤੂੰ ਸਮਝਾਵਹਿ, ਮੇਲਿ ਮਿਲਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 59.291,
      "end_time": 66.299,
      "transcript": "ਨਾਮੁ ਮਿਲੈ, ਚਲੈ ਮੈ ਨਾਲਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.299,
      "end_time": 73.664,
      "transcript": "ਬਿਨੁ ਨਾਵੈ, ਬਾਧੀ ਸਭ ਕਾਲਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 80.28,
      "end_time": 86.936,
      "transcript": "ਖੇਤੀ ਵਣਜੁ, ਨਾਵੈ ਕੀ ਓਟ"
    },
    {
      "section_id": "section-00009",
      "start_time": 86.936,
      "end_time": 93.791,
      "transcript": "ਪਾਪੁ ਪੁੰਨੁ, ਬੀਜ ਕੀ ਪੋਟ"
    },
    {
      "section_id": "section-00010",
      "start_time": 93.791,
      "end_time": 100.539,
      "transcript": "ਕਾਮੁ ਕ੍ਰੋਧੁ, ਜੀਅ ਮਹਿ ਚੋਟ"
    },
    {
      "section_id": "section-00011",
      "start_time": 100.539,
      "end_time": 107.501,
      "transcript": "ਨਾਮੁ ਵਿਸਾਰਿ, ਚਲੇ ਮਨਿ ਖੋਟ"
    },
    {
      "section_id": "section-00012",
      "start_time": 107.501,
      "end_time": 114.244,
      "transcript": "ਸਾਚੇ ਗੁਰ ਕੀ, ਸਾਚੀ ਸੀਖ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.244,
      "end_time": 121.16,
      "transcript": "ਤਨੁ ਮਨੁ ਸੀਤਲੁ, ਸਾਚੁ ਪਰੀਖ"
    },
    {
      "section_id": "section-00014",
      "start_time": 121.16,
      "end_time": 127.88,
      "transcript": "ਜਲ ਪੁਰਾਇਨਿ, ਰਸ ਕਮਲ ਪਰੀਖ"
    },
    {
      "section_id": "section-00015",
      "start_time": 127.88,
      "end_time": 134.707,
      "transcript": "ਸਬਦਿ ਰਤੇ, ਮੀਠੇ ਰਸ ਈਖ"
    },
    {
      "section_id": "section-00016",
      "start_time": 134.707,
      "end_time": 141.458,
      "transcript": "ਹੁਕਮਿ ਸੰਜੋਗੀ, ਗੜਿ ਦਸ ਦੁਆਰ"
    },
    {
      "section_id": "section-00017",
      "start_time": 141.458,
      "end_time": 148.451,
      "transcript": "ਪੰਚ ਵਸਹਿ ਮਿਲਿ ਜੋਤਿ ਅਪਾਰ"
    },
    {
      "section_id": "section-00018",
      "start_time": 148.451,
      "end_time": 155.461,
      "transcript": "ਆਪਿ ਤੁਲੈ, ਆਪੇ ਵਣਜਾਰ"
    },
    {
      "section_id": "section-00019",
      "start_time": 155.461,
      "end_time": 162.003,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਸਵਾਰਣਹਾਰ"
    },
    {
      "section_id": "section-00020",
      "start_time": 162.063,
      "end_time": 168.703,
      "transcript": "ਆਪਿ ਤੁਲੈ, ਆਪੇ ਵਣਜਾਰ"
    },
    {
      "section_id": "section-00021",
      "start_time": 168.703,
      "end_time": 178.598,
      "transcript": " ਨਾਨਕ ਨਾਮਿ ਸਵਾਰਣਹਾਰ"
    }
  ]
}

{
  "audio_file": "0137 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.96,
      "end_time": 15.715,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 25.12,
      "end_time": 31.56,
      "transcript": "ਤੂੰ ਮੇਰਾ ਸਖਾ, ਤੂੰਹੀ ਮੇਰਾ ਮੀਤੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 31.56,
      "end_time": 38.04,
      "transcript": "ਤੂੰ ਮੇਰਾ ਪ੍ਰੀਤਮੁ, ਤੁਮ ਸੰਗਿ ਹੀਤੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.04,
      "end_time": 44.32,
      "transcript": "ਤੂੰ ਮੇਰੀ ਪਤਿ, ਤੂਹੈ ਮੇਰਾ ਗਹਣਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.32,
      "end_time": 51.9,
      "transcript": "ਤੁਝ ਬਿਨੁ, ਨਿਮਖੁ ਨ ਜਾਈ ਰਹਣਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 56.96,
      "end_time": 63.28,
      "transcript": "ਤੂੰ ਮੇਰੇ ਲਾਲਨ, ਤੂੰ ਮੇਰੇ ਪ੍ਰਾਨ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.28,
      "end_time": 71.271,
      "transcript": "ਤੂੰ ਮੇਰੇ ਸਾਹਿਬ, ਤੂੰ ਮੇਰੇ ਖਾਨ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 79.04,
      "end_time": 85.4,
      "transcript": "ਜਿਉ ਤੁਮ ਰਾਖਹੁ, ਤਿਵ ਹੀ ਰਹਨਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 85.4,
      "end_time": 91.84,
      "transcript": "ਜੋ ਤੁਮ ਕਹਹੁ, ਸੋਈ ਮੋਹਿ ਕਰਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.84,
      "end_time": 98.28,
      "transcript": "ਜਹ ਪੇਖਉ, ਤਹਾ ਤੁਮ ਬਸਨਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 98.28,
      "end_time": 104.76,
      "transcript": "ਨਿਰਭਉ ਨਾਮੁ, ਜਪਉ ਤੇਰਾ ਰਸਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 104.76,
      "end_time": 110.746,
      "transcript": "ਤੂੰ ਮੇਰੀ ਨਵ ਨਿਧਿ, ਤੂੰ ਭੰਡਾਰੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 110.746,
      "end_time": 117.545,
      "transcript": "ਰੰਗ ਰਸਾ, ਤੂੰ ਮਨਹਿ ਅਧਾਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 117.545,
      "end_time": 123.662,
      "transcript": "ਤੂੰ ਮੇਰੀ ਸੋਭਾ, ਤੁਮ ਸੰਗਿ ਰਚੀਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 123.662,
      "end_time": 131.43,
      "transcript": "ਤੂੰ ਮੇਰੀ ਓਟ, ਤੂੰ ਹੈ ਮੇਰਾ ਤਕੀਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 136.6,
      "end_time": 142.92,
      "transcript": "ਮਨ ਤਨ ਅੰਤਰਿ, ਤੁਹੀ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 142.92,
      "end_time": 149.28,
      "transcript": "ਮਰਮੁ ਤੁਮਾਰਾ, ਗੁਰ ਤੇ ਪਾਇਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 149.28,
      "end_time": 155.423,
      "transcript": "ਸਤਿਗੁਰ ਤੇ ਦ੍ਰਿੜਿਆ, ਇਕੁ ਏਕੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 155.423,
      "end_time": 161.88,
      "transcript": "ਨਾਨਕ ਦਾਸ, ਹਰਿ ਹਰਿ ਹਰਿ ਟੇਕੈ"
    }
  ]
}

    {
      "section_id": "section-00001",
      "start_time": 0.029,
      "end_time": 6.201,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.36,
      "end_time": 18.345,
      "transcript": "ਧੋਤੀ ਖੋਲਿ, ਵਿਛਾਏ ਹੇਠਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.345,
      "end_time": 24.465,
      "transcript": "ਗਰਧਪ ਵਾਂਗੂ, ਲਾਹੇ ਪੇਟਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.465,
      "end_time": 30.6,
      "transcript": "ਬਿਨੁ ਕਰਤੂਤੀ, ਮੁਕਤਿ ਨ ਪਾਈਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.6,
      "end_time": 39.735,
      "transcript": "ਮੁਕਤਿ ਪਦਾਰਥੁ, ਨਾਮੁ ਧਿਆਈਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.665,
      "end_time": 51.8,
      "transcript": "ਪੂਜਾ ਤਿਲਕ, ਕਰਤ ਇਸਨਾਨਾਂ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.8,
      "end_time": 57.865,
      "transcript": "ਛੁਰੀ ਕਾਢਿ, ਲੇਵੈ ਹਥਿ ਦਾਨਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.865,
      "end_time": 63.865,
      "transcript": "ਬੇਦੁ ਪੜੈ, ਮੁਖਿ ਮੀਠੀ ਬਾਣੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.865,
      "end_time": 70.005,
      "transcript": "ਜੀਆਂ ਕੁਹਤ, ਨ ਸੰਗੈ ਪਰਾਣੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.987,
      "end_time": 82.211,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਿਸੁ ਕਿਰਪਾ ਧਾਰੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 82.211,

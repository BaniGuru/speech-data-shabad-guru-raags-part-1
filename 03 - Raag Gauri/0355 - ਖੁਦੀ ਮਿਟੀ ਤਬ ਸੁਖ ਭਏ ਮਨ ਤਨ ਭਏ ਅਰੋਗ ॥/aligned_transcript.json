  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.745,
      "end_time": 9.565,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 10.04,
      "end_time": 15.595,
      "transcript": "ਖੁਦੀ ਮਿਟੀ ਤਬ ਸੁਖ ਭਏ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.0,
      "end_time": 21.585,
      "transcript": "ਮਨ ਤਨ ਭਏ ਅਰੋਗ"
    },
    {
      "section_id": "section-00004",
      "start_time": 22.005,
      "end_time": 27.764,
      "transcript": "ਨਾਨਕ ਦ੍ਰਿਸਟੀ ਆਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 27.764,
      "end_time": 33.605,
      "transcript": "ਉਸਤਤਿ ਕਰਨੈ ਜੋਗੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 34.08,
      "end_time": 35.565,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 45.32,
      "end_time": 53.24,
      "transcript": "ਖਖਾ, ਖਰਾ ਸਰਾਹਉ ਤਾਹੂ ਜੋ ਖਿਨ ਮਹਿ, ਊਨੇ ਸੁਭਰ ਭਰਾਹੂ"
    },
    {
      "section_id": "section-00008",
      "start_time": 53.24,
      "end_time": 61.04,
      "transcript": "ਖਰਾ ਨਿਮਾਨਾ, ਹੋਤ ਪਰਾਨੀ ਅਨਦਿਨੁ ਜਾਪੈ, ਪ੍ਰਭ ਨਿਰਬਾਨੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 61.04,
      "end_time": 68.88,
      "transcript": "ਭਾਵੈ ਖਸਮ, ਤ ਉਆ ਸੁਖੁ ਦੇਤਾ ਪਾਰਬ੍ਰਹਮੁ, ਐਸੋ ਆਗਨਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.88,
      "end_time": 77.045,
      "transcript": "ਅਸੰਖ ਖਤੇ, ਖਿਨ ਬਖਸਨਹਾਰਾ ਨਾਨਕ, ਸਾਹਿਬ ਸਦਾ ਦਇਆਰਾ"
    }
  ]
}

{
  "audio_file": "0190 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 5.315,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.845,
      "end_time": 20.308,
      "transcript": "ਲਾਲਚ ਝੂਠ ਬਿਕਾਰ ਮੋਹ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.308,
      "end_time": 26.688,
      "transcript": "ਬਿਆਪਤ ਮੂੜੇ ਅੰਧ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.915,
      "end_time": 33.265,
      "transcript": "ਲਾਗਿ ਪਰੇ ਦੁਰਗੰਧ ਸਿਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.385,
      "end_time": 43.545,
      "transcript": "ਨਾਨਕ ਮਾਇਆ ਬੰਧ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.655,
      "end_time": 57.238,
      "transcript": "ਲਲਾ, ਲਪਟਿ ਬਿਖੈ ਰਸ ਰਾਤੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.238,
      "end_time": 61.565,
      "transcript": "ਅਹੰਬੁਧਿ, ਮਾਇਆ ਮਦ ਮਾਤੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.565,
      "end_time": 69.698,
      "transcript": "ਇਆ ਮਾਇਆ ਮਹਿ, ਜਨਮਹਿ ਮਰਨਾ ਜਿਉ ਜਿਉ ਹੁਕਮੁ, ਤਿਵੈ ਤਿਉ ਕਰਨਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 69.698,
      "end_time": 73.963,
      "transcript": "ਕੋਊ ਊਨ, ਨ ਕੋਊ ਪੂਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 73.963,
      "end_time": 78.134,
      "transcript": "ਕੋਊ ਸੁਘਰੁ ਨ ਕੋਊ ਮੂਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 78.134,
      "end_time": 82.532,
      "transcript": "ਜਿਤੁ ਜਿਤੁ ਲਾਵਹੁ, ਤਿਤੁ ਤਿਤੁ ਲਗਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 82.532,
      "end_time": 87.312,
      "transcript": "ਨਾਨਕ ਠਾਕੁਰ, ਸਦਾ ਅਲਿਪਨਾ"
    }
  ]
}

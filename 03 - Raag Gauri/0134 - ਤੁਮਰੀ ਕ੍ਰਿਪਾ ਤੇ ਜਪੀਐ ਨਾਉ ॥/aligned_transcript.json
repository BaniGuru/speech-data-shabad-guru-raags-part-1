  "audio_file": "0145 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.075,
      "end_time": 6.754,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.661,
      "end_time": 19.2,
      "transcript": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ, ਜਪੀਐ ਨਾਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.2,
      "end_time": 25.47,
      "transcript": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ, ਦਰਗਹ ਥਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.47,
      "end_time": 32.07,
      "transcript": "ਤੁਝ ਬਿਨੁ ਪਾਰਬ੍ਰਹਮ, ਨਹੀ ਕੋਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.07,
      "end_time": 41.705,
      "transcript": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ, ਸਦਾ ਸੁਖੁ ਹੋਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 47.92,
      "end_time": 54.28,
      "transcript": "ਤੁਮ ਮਨਿ ਵਸੇ, ਤਉ ਦੂਖੁ ਨ ਲਾਗੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.28,
      "end_time": 60.72,
      "transcript": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ, ਭ੍ਰਮੁ ਭਉ ਭਾਗੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.72,
      "end_time": 66.985,
      "transcript": "ਪਾਰਬ੍ਰਹਮ, ਅਪਰੰਪਰ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.985,
      "end_time": 73.275,
      "transcript": "ਸਗਲ ਘਟਾ ਕੇ, ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 73.6,
      "end_time": 79.495,
      "transcript": "ਕਰਉ ਅਰਦਾਸਿ, ਅਪਨੇ ਸਤਿਗੁਰ ਪਾਸਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.875,
      "end_time": 86.035,
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ, ਸਚੁ ਰਾਸਿ"
    }
  ]
}

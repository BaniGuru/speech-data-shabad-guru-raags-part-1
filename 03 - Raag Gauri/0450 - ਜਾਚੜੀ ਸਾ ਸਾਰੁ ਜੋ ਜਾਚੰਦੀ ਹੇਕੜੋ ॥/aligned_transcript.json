      "transcript": "ਮਹਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 13.399,
      "end_time": 18.202,
      "transcript": "ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.645,
      "end_time": 36.885,
      "transcript": "ਜਾਚੜੀ ਸਾ ਸਾਰੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.435,
      "end_time": 45.505,
      "transcript": "ਜੋ ਜਾਚੰਦੀ ਹੇਕੜੋ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.045,
      "end_time": 54.189,
      "transcript": "ਗਾਲੀ੍ ਬਿਆ ਵਿਕਾਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.189,
      "end_time": 62.115,
      "transcript": "ਨਾਨਕ ਧਣੀ ਵਿਹੂਣੀਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.405,
      "end_time": 66.885,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.015,
      "end_time": 82.695,
      "transcript": "ਨੀਹਿ ਜਿ ਵਿਧਾ ਮੰਨੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.08,
      "end_time": 91.543,
      "transcript": "ਪਛਾਣੂ ਵਿਰਲੋ ਥਿਓ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.543,
      "end_time": 99.355,
      "transcript": "ਜੋੜਣਹਾਰਾ ਸੰਤੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.795,
      "end_time": 107.665,
      "transcript": "ਨਾਨਕ ਪਾਧਰੁ ਪਧਰੋ"
    },
    {
      "section_id": "section-00013",
      "start_time": 107.92,
      "end_time": 110.315,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 115.6,
      "end_time": 124.425,
      "transcript": "ਸੋਈ ਸੇਵਿਹੁ ਜੀਅੜੇ, ਦਾਤਾ ਬਖਸਿੰਦੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 124.56,
      "end_time": 133.6,
      "transcript": "ਕਿਲਵਿਖ ਸਭਿ ਬਿਨਾਸੁ ਹੋਨਿ, ਸਿਮਰਤ ਗੋਵਿੰਦੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 133.6,
      "end_time": 142.33,
      "transcript": "ਹਰਿ ਮਾਰਗੁ ਸਾਧੂ ਦਸਿਆ, ਜਪੀਐ ਗੁਰਮੰਤੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 142.33,
      "end_time": 150.96,
      "transcript": "ਮਾਇਆ ਸੁਆਦ ਸਭਿ ਫਿਕਿਆ, ਹਰਿ ਮਨਿ ਭਾਵੰਦੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 150.96,
      "end_time": 161.565,
      "transcript": "ਧਿਆਇ ਨਾਨਕ ਪਰਮੇਸਰੈ, ਜਿਨਿ ਦਿਤੀ ਜਿੰਦੁ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 3.215,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.2,
      "end_time": 18.4,
      "transcript": "ਜਿਉ ਕਪਿ ਕੇ ਕਰ ਮੁਸਟਿ ਚਨਨ ਕੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.4,
      "end_time": 24.055,
      "transcript": "ਲੁਬਧਿ ਨ ਤਿਆਗੁ ਦਇਓ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.56,
      "end_time": 30.8,
      "transcript": "ਜੋ ਜੋ ਕਰਮ ਕੀਏ ਲਾਲਚ ਸਿਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.8,
      "end_time": 36.595,
      "transcript": "ਤੇ ਫਿਰਿ ਗਰਹਿ ਪਰਿਓ"
    },
    {
      "section_id": "section-00006",
      "start_time": 37.08,
      "end_time": 43.32,
      "transcript": "ਭਗਤਿ ਬਿਨੁ, ਬਿਰਥੇ ਜਨਮੁ ਗਇਓ"
    },
    {
      "section_id": "section-00007",
      "start_time": 43.32,
      "end_time": 49.52,
      "transcript": "ਸਾਧਸੰਗਤਿ ਭਗਵਾਨ ਭਜਨ ਬਿਨੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 49.52,
      "end_time": 56.765,
      "transcript": "ਕਹੀ ਨ ਸਚੁ ਰਹਿਓ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 61.8,
      "end_time": 67.625,
      "transcript": "ਜਿਉ ਉਦਿਆਨ ਕੁਸਮ ਪਰਫੁਲਿਤ"
    },
    {
      "section_id": "section-00010",
      "start_time": 67.92,
      "end_time": 73.817,
      "transcript": "ਕਿਨਹਿ ਨ ਘ੍ਰਾਉ ਲਇਓ"
    },
    {
      "section_id": "section-00011",
      "start_time": 73.817,
      "end_time": 80.055,
      "transcript": "ਤੈਸੇ ਭ੍ਰਮਤ ਅਨੇਕ ਜੋਨਿ ਮਹਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 80.055,
      "end_time": 85.835,
      "transcript": "ਫਿਰਿ ਫਿਰਿ ਕਾਲ ਹਇਓ"
    },
    {
      "section_id": "section-00013",
      "start_time": 86.24,
      "end_time": 92.365,
      "transcript": "ਇਆ ਧਨ ਜੋਬਨ ਅਰੁ ਸੁਤ ਦਾਰਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 92.365,
      "end_time": 98.085,
      "transcript": "ਪੇਖਨ ਕਉ ਜੁ ਦਇਓ"
    },
    {
      "section_id": "section-00015",
      "start_time": 98.56,
      "end_time": 104.355,
      "transcript": "ਤਿਨ ਹੀ ਮਾਹਿ ਅਟਕਿ ਜੋ ਉਰਝੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 104.355,
      "end_time": 110.761,
      "transcript": "ਇੰਦ੍ਰੀ ਪ੍ਰੇਰਿ ਲਇਓ"
    },
    {
      "section_id": "section-00017",
      "start_time": 110.761,
      "end_time": 116.96,
      "transcript": "ਅਉਧ ਅਨਲ ਤਨੁ ਤਿਨ ਕੋ ਮੰਦਰੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 116.96,
      "end_time": 122.655,
      "transcript": "ਚਹੁ ਦਿਸ ਠਾਟੁ ਠਇਓ"
    },
    {
      "section_id": "section-00019",
      "start_time": 123.04,
      "end_time": 128.805,
      "transcript": "ਕਹਿ ਕਬੀਰ ਭੈ ਸਾਗਰ ਤਰਨ ਕਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 128.805,
      "end_time": 134.675,
      "transcript": "ਮੈ ਸਤਿਗੁਰ ਓਟ ਲਇਓ"
    }
  ]
}

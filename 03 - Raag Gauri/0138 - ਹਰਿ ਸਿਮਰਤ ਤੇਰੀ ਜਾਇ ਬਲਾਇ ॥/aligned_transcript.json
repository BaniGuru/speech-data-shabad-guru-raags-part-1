{
  "audio_file": "0146 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.235,
      "end_time": 12.825,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 30.16,
      "end_time": 36.665,
      "transcript": "ਹਰਿ ਸਿਮਰਤ, ਤੇਰੀ ਜਾਇ ਬਲਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.28,
      "end_time": 43.8,
      "transcript": "ਸਰਬ ਕਲਿਆਣ, ਵਸੈ ਮਨਿ ਆਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 43.8,
      "end_time": 49.875,
      "transcript": "ਭਜੁ ਮਨ ਮੇਰੇ, ਏਕੋ ਨਾਮ"
    },
    {
      "section_id": "section-00005",
      "start_time": 50.255,
      "end_time": 58.075,
      "transcript": "ਜੀਅ ਤੇਰੇ ਕੈ, ਆਵੈ ਕਾਮ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 66.015,
      "end_time": 72.315,
      "transcript": "ਰੈਣਿ ਦਿਨਸੁ, ਗੁਣ ਗਾਉ ਅਨੰਤਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 72.52,
      "end_time": 78.995,
      "transcript": "ਗੁਰ ਪੂਰੇ ਕਾ, ਨਿਰਮਲ ਮੰਤਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 78.995,
      "end_time": 85.385,
      "transcript": "ਛੋਡਿ ਉਪਾਵ, ਏਕ ਟੇਕ ਰਾਖੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 85.385,
      "end_time": 92.065,
      "transcript": "ਮਹਾ ਪਦਾਰਥੁ, ਅੰਮ੍ਰਿਤ ਰਸੁ ਚਾਖੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 98.6,
      "end_time": 104.725,
      "transcript": "ਬਿਖਮ ਸਾਗਰੁ, ਤੇਈ ਜਨ ਤਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 105.125,
      "end_time": 111.475,
      "transcript": "ਨਾਨਕ, ਜਾ ਕਉ ਨਦਰਿ ਕਰੇ"
    }
  ]
}

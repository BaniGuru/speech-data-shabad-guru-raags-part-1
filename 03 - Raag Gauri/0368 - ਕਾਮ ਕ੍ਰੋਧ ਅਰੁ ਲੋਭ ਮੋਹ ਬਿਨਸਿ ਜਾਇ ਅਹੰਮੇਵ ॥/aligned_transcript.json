{
  "audio_file": "0202 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.0,
      "end_time": 12.889,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 21.08,
      "end_time": 28.6,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ ਅਰੁ ਲੋਭ ਮੋਹ"
    },
    {
      "section_id": "section-00003",
      "start_time": 28.6,
      "end_time": 35.586,
      "transcript": "ਬਿਨਸਿ ਜਾਇ ਅਹੰਮੇਵ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.586,
      "end_time": 42.905,
      "transcript": "ਨਾਨਕ ਪ੍ਰਭ ਸਰਣਾਗਤੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.32,
      "end_time": 53.965,
      "transcript": "ਕਰਿ ਪ੍ਰਸਾਦੁ ਗੁਰਦੇਵ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.805,
      "end_time": 70.08,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਛਤੀਹ ਅੰਮ੍ਰਿਤ ਖਾਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.08,
      "end_time": 77.125,
      "transcript": "ਤਿਸੁ ਠਾਕੁਰ ਕਉ, ਰਖੁ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.125,
      "end_time": 84.4,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਸੁਗੰਧਤ ਤਨਿ ਲਾਵਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.4,
      "end_time": 91.48,
      "transcript": "ਤਿਸ ਕਉ ਸਿਮਰਤ, ਪਰਮ ਗਤਿ ਪਾਵਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.48,
      "end_time": 98.6,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਬਸਹਿ ਸੁਖ ਮੰਦਰਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 98.6,
      "end_time": 105.705,
      "transcript": "ਤਿਸਹਿ ਧਿਆਇ, ਸਦਾ ਮਨ ਅੰਦਰਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 105.705,
      "end_time": 112.545,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਗ੍ਰਿਹ ਸੰਗਿ ਸੁਖ ਬਸਨਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.975,
      "end_time": 119.875,
      "transcript": "ਆਠ ਪਹਰ, ਸਿਮਰਹੁ ਤਿਸੁ ਰਸਨਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 120.32,
      "end_time": 127.46,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਰੰਗ ਰਸ ਭੋਗ"
    },
    {
      "section_id": "section-00015",
      "start_time": 127.46,
      "end_time": 134.445,
      "transcript": "ਨਾਨਕ ਸਦਾ ਧਿਆਈਐ, ਧਿਆਵਨ ਜੋਗ"
    },
    {
      "section_id": "section-00016",
      "start_time": 142.04,
      "end_time": 149.165,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਪਾਟ ਪਟੰਬਰ ਹਢਾਵਹਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 149.165,
      "end_time": 156.68,
      "transcript": "ਤਿਸਹਿ ਤਿਆਗਿ, ਕਤ ਅਵਰ ਲੁਭਾਵਹਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 156.68,
      "end_time": 163.96,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਸੁਖਿ ਸੇਜ ਸੋਈਜੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 163.96,
      "end_time": 171.065,
      "transcript": "ਮਨ ਆਠ ਪਹਰ, ਤਾ ਕਾ ਜਸੁ ਗਾਵੀਜੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 171.065,
      "end_time": 178.36,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੁਝੁ ਸਭੁ ਕੋਊ ਮਾਨੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 178.36,
      "end_time": 185.56,
      "transcript": "ਮੁਖਿ ਤਾ ਕੋ ਜਸੁ, ਰਸਨ ਬਖਾਨੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 185.56,
      "end_time": 192.76,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੇਰੋ ਰਹਤਾ ਧਰਮੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 192.76,
      "end_time": 199.84,
      "transcript": "ਮਨ ਸਦਾ ਧਿਆਇ, ਕੇਵਲ ਪਾਰਬ੍ਰਹਮੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 199.84,
      "end_time": 206.735,
      "transcript": "ਪ੍ਰਭ ਜੀ ਜਪਤ, ਦਰਗਹ ਮਾਨੁ ਪਾਵਹਿ"
    },
    {
      "section_id": "section-00025",
      "start_time": 206.735,
      "end_time": 214.145,
      "transcript": "ਨਾਨਕ ਪਤਿ ਸੇਤੀ, ਘਰਿ ਜਾਵਹਿ"
    },
    {
      "section_id": "section-00026",
      "start_time": 221.36,
      "end_time": 228.48,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਆਰੋਗ ਕੰਚਨ ਦੇਹੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 228.48,
      "end_time": 235.325,
      "transcript": "ਲਿਵ ਲਾਵਹੁ, ਤਿਸੁ ਰਾਮ ਸਨੇਹੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 235.325,
      "end_time": 242.68,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੇਰਾ ਓਲਾ ਰਹਤ"
    },
    {
      "section_id": "section-00029",
      "start_time": 242.68,
      "end_time": 249.525,
      "transcript": "ਮਨ ਸੁਖੁ ਪਾਵਹਿ, ਹਰਿ ਹਰਿ ਜਸੁ ਕਹਤ"
    },
    {
      "section_id": "section-00030",
      "start_time": 249.525,
      "end_time": 256.92,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੇਰੇ ਸਗਲ ਛਿਦ੍ਰ ਢਾਕੇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 256.92,
      "end_time": 264.085,
      "transcript": "ਮਨ ਸਰਨੀ ਪਰੁ, ਠਾਕੁਰ ਪ੍ਰਭ ਤਾ ਕੈ"
    },
    {
      "section_id": "section-00032",
      "start_time": 264.085,
      "end_time": 271.2,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੁਝੁ ਕੋ ਨ ਪਹੂਚੈ"
    },
    {
      "section_id": "section-00033",
      "start_time": 271.2,
      "end_time": 278.36,
      "transcript": "ਮਨ ਸਾਸਿ ਸਾਸਿ, ਸਿਮਰਹੁ ਪ੍ਰਭ ਊਚੇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 278.36,
      "end_time": 285.215,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਪਾਈ ਦ੍ਰੁਲਭ ਦੇਹ"
    },
    {
      "section_id": "section-00035",
      "start_time": 285.215,
      "end_time": 292.945,
      "transcript": "ਨਾਨਕ ਤਾ ਕੀ, ਭਗਤਿ ਕਰੇਹ"
    },
    {
      "section_id": "section-00036",
      "start_time": 299.44,
      "end_time": 306.52,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਆਭੂਖਨ ਪਹਿਰੀਜੈ"
    },
    {
      "section_id": "section-00037",
      "start_time": 306.52,
      "end_time": 313.56,
      "transcript": "ਮਨ ਤਿਸੁ ਸਿਮਰਤ, ਕਿਉ ਆਲਸੁ ਕੀਜੈ"
    },
    {
      "section_id": "section-00038",
      "start_time": 313.56,
      "end_time": 320.6,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਅਸ੍ਵ ਹਸਤਿ ਅਸਵਾਰੀ"
    },
    {
      "section_id": "section-00039",
      "start_time": 320.6,
      "end_time": 327.6,
      "transcript": "ਮਨ ਤਿਸੁ ਪ੍ਰਭ ਕਉ, ਕਬਹੂ ਨ ਬਿਸਾਰੀ"
    },
    {
      "section_id": "section-00040",
      "start_time": 327.6,
      "end_time": 334.375,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਬਾਗ ਮਿਲਖ ਧਨਾ"
    },
    {
      "section_id": "section-00041",
      "start_time": 334.645,
      "end_time": 341.385,
      "transcript": "ਰਾਖੁ ਪਰੋਇ, ਪ੍ਰਭੁ ਅਪੁਨੇ ਮਨਾ"
    },
    {
      "section_id": "section-00042",
      "start_time": 341.72,
      "end_time": 348.735,
      "transcript": "ਜਿਨਿ ਤੇਰੀ ਮਨ, ਬਨਤ ਬਨਾਈ"
    },
    {
      "section_id": "section-00043",
      "start_time": 348.735,
      "end_time": 355.8,
      "transcript": "ਊਠਤ ਬੈਠਤ, ਸਦ ਤਿਸਹਿ ਧਿਆਈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 355.8,
      "end_time": 362.445,
      "transcript": "ਤਿਸਹਿ ਧਿਆਇ, ਜੋ ਏਕ ਅਲਖੈ"
    },
    {
      "section_id": "section-00045",
      "start_time": 362.84,
      "end_time": 369.725,
      "transcript": "ਈਹਾ ਊਹਾ, ਨਾਨਕ ਤੇਰੀ ਰਖੈ"
    },
    {
      "section_id": "section-00046",
      "start_time": 376.705,
      "end_time": 383.84,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਕਰਹਿ ਪੁੰਨ ਬਹੁ ਦਾਨ"
    },
    {
      "section_id": "section-00047",
      "start_time": 383.84,
      "end_time": 390.76,
      "transcript": "ਮਨ ਆਠ ਪਹਰ, ਕਰਿ ਤਿਸ ਕਾ ਧਿਆਨ"
    },
    {
      "section_id": "section-00048",
      "start_time": 390.76,
      "end_time": 397.72,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੂ ਆਚਾਰ ਬਿਉਹਾਰੀ"
    },
    {
      "section_id": "section-00049",
      "start_time": 397.72,
      "end_time": 404.68,
      "transcript": "ਤਿਸੁ ਪ੍ਰਭ ਕਉ, ਸਾਸਿ ਸਾਸਿ ਚਿਤਾਰੀ"
    },
    {
      "section_id": "section-00050",
      "start_time": 404.68,
      "end_time": 411.715,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੇਰਾ ਸੁੰਦਰ ਰੂਪੁ"
    },
    {
      "section_id": "section-00051",
      "start_time": 411.715,
      "end_time": 418.68,
      "transcript": "ਸੋ ਪ੍ਰਭੁ ਸਿਮਰਹੁ, ਸਦਾ ਅਨੂਪੁ"
    },
    {
      "section_id": "section-00052",
      "start_time": 418.68,
      "end_time": 425.72,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੇਰੀ ਨੀਕੀ ਜਾਤਿ"
    },
    {
      "section_id": "section-00053",
      "start_time": 425.72,
      "end_time": 432.64,
      "transcript": "ਸੋ ਪ੍ਰਭੁ ਸਿਮਰਿ, ਸਦਾ ਦਿਨ ਰਾਤਿ"
    },
    {
      "section_id": "section-00054",
      "start_time": 432.64,
      "end_time": 439.155,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੇਰੀ ਪਤਿ ਰਹੈ"
    },
    {
      "section_id": "section-00055",
      "start_time": 439.655,
      "end_time": 446.585,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਨਾਨਕ ਜਸੁ ਕਹੈ"
    },
    {
      "section_id": "section-00056",
      "start_time": 453.187,
      "end_time": 460.56,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਸੁਨਹਿ ਕਰਨ ਨਾਦ"
    },
    {
      "section_id": "section-00057",
      "start_time": 460.56,
      "end_time": 467.48,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਪੇਖਹਿ ਬਿਸਮਾਦ"
    },
    {
      "section_id": "section-00058",
      "start_time": 467.48,
      "end_time": 474.44,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਬੋਲਹਿ ਅੰਮ੍ਰਿਤ ਰਸਨਾ"
    },
    {
      "section_id": "section-00059",
      "start_time": 474.44,
      "end_time": 481.4,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਸੁਖਿ ਸਹਜੇ ਬਸਨਾ"
    },
    {
      "section_id": "section-00060",
      "start_time": 481.4,
      "end_time": 488.4,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਹਸਤ ਕਰ ਚਲਹਿ"
    },
    {
      "section_id": "section-00061",
      "start_time": 488.4,
      "end_time": 495.45,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਸੰਪੂਰਨ ਫਲਹਿ"
    },
    {
      "section_id": "section-00062",
      "start_time": 495.45,
      "end_time": 502.4,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਪਰਮ ਗਤਿ ਪਾਵਹਿ"
    },
    {
      "section_id": "section-00063",
      "start_time": 502.4,
      "end_time": 509.365,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਸੁਖਿ ਸਹਜਿ ਸਮਾਵਹਿ"
    },
    {
      "section_id": "section-00064",
      "start_time": 509.365,
      "end_time": 516.4,
      "transcript": "ਐਸਾ ਪ੍ਰਭੁ ਤਿਆਗਿ, ਅਵਰ ਕਤ ਲਾਗਹੁ"
    },
    {
      "section_id": "section-00065",
      "start_time": 516.4,
      "end_time": 523.5,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਨਾਨਕ ਮਨਿ ਜਾਗਹੁ"
    },
    {
      "section_id": "section-00066",
      "start_time": 530.115,
      "end_time": 537.125,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੂੰ ਪ੍ਰਗਟੁ ਸੰਸਾਰਿ"
    },
    {
      "section_id": "section-00067",
      "start_time": 537.125,
      "end_time": 544.04,
      "transcript": "ਤਿਸੁ ਪ੍ਰਭ ਕਉ, ਮੂਲਿ ਨ ਮਨਹੁ ਬਿਸਾਰਿ"
    },
    {
      "section_id": "section-00068",
      "start_time": 544.04,
      "end_time": 550.705,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੇਰਾ ਪਰਤਾਪੁ"
    },
    {
      "section_id": "section-00069",
      "start_time": 550.705,
      "end_time": 557.62,
      "transcript": "ਰੇ ਮਨ ਮੂੜ, ਤੂ ਤਾ ਕਉ ਜਾਪੁ"
    },
    {
      "section_id": "section-00070",
      "start_time": 557.62,
      "end_time": 564.8,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੇਰੇ ਕਾਰਜ ਪੂਰੇ"
    },
    {
      "section_id": "section-00071",
      "start_time": 564.8,
      "end_time": 571.71,
      "transcript": "ਤਿਸਹਿ ਜਾਨੁ ਮਨ, ਸਦਾ ਹਜੂਰੇ"
    },
    {
      "section_id": "section-00072",
      "start_time": 571.71,
      "end_time": 578.695,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਤੂੰ ਪਾਵਹਿ ਸਾਚੁ"
    },
    {
      "section_id": "section-00073",
      "start_time": 578.695,
      "end_time": 585.76,
      "transcript": "ਰੇ ਮਨ ਮੇਰੇ, ਤੂੰ ਤਾ ਸਿਉ ਰਾਚੁ"
    },
    {
      "section_id": "section-00074",
      "start_time": 585.76,
      "end_time": 592.68,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ, ਸਭ ਕੀ ਗਤਿ ਹੋਇ"
    },
    {
      "section_id": "section-00075",
      "start_time": 592.68,
      "end_time": 599.905,
      "transcript": "ਨਾਨਕ ਜਾਪੁ ਜਪੈ, ਜਪੁ ਸੋਇ"
    },
    {
      "section_id": "section-00076",
      "start_time": 606.605,
      "end_time": 613.175,
      "transcript": "ਆਪਿ ਜਪਾਏ, ਜਪੈ ਸੋ ਨਾਉ"
    },
    {
      "section_id": "section-00077",
      "start_time": 613.595,
      "end_time": 620.48,
      "transcript": "ਆਪਿ ਗਾਵਾਏ, ਸੁ ਹਰਿ ਗੁਨ ਗਾਉ"
    },
    {
      "section_id": "section-00078",
      "start_time": 620.48,
      "end_time": 627.4,
      "transcript": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ, ਹੋਇ ਪ੍ਰਗਾਸੁ"
    },
    {
      "section_id": "section-00079",
      "start_time": 627.4,
      "end_time": 634.32,
      "transcript": "ਪ੍ਰਭੂ ਦਇਆ ਤੇ, ਕਮਲ ਬਿਗਾਸੁ"
    },
    {
      "section_id": "section-00080",
      "start_time": 634.32,
      "end_time": 641.28,
      "transcript": "ਪ੍ਰਭ ਸੁਪ੍ਰਸੰਨ, ਬਸੈ ਮਨਿ ਸੋਇ"
    },
    {
      "section_id": "section-00081",
      "start_time": 641.28,
      "end_time": 648.205,
      "transcript": "ਪ੍ਰਭ ਦਇਆ ਤੇ, ਮਤਿ ਊਤਮ ਹੋਇ"

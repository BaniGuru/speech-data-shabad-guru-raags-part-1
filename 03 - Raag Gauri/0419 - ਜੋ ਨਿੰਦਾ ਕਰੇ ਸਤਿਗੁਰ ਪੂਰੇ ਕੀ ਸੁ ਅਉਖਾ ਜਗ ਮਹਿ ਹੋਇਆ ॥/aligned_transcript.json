{
  "audio_file": "0229 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.425,
      "end_time": 9.461,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.461,
      "end_time": 23.148,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 41.205,
      "end_time": 48.8,
      "transcript": "ਜੋ ਨਿੰਦਾ ਕਰੇ ਸਤਿਗੁਰ ਪੂਰੇ ਕੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 48.8,
      "end_time": 55.435,
      "transcript": "ਸੁ ਅਉਖਾ ਜਗ ਮਹਿ ਹੋਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 55.92,
      "end_time": 62.695,
      "transcript": "ਨਰਕ ਘੋਰੁ ਦੁਖ ਖੂਹੁ ਹੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 63.16,
      "end_time": 69.845,
      "transcript": "ਓਥੈ ਪਕੜਿ ਓਹੁ ਢੋਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.36,
      "end_time": 76.755,
      "transcript": "ਕੂਕ ਪੁਕਾਰ ਕੋ ਨ ਸੁਣੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.16,
      "end_time": 83.585,
      "transcript": "ਓਹੁ ਅਉਖਾ ਹੋਇ ਹੋਇ ਰੋਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.12,
      "end_time": 90.995,
      "transcript": "ਓਨਿ ਹਲਤੁ ਪਲਤੁ ਸਭੁ ਗਵਾਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.995,
      "end_time": 97.935,
      "transcript": "ਲਾਹਾ ਮੂਲੁ ਸਭੁ ਖੋਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.935,
      "end_time": 104.85,
      "transcript": "ਓਹੁ ਤੇਲੀ ਸੰਦਾ ਬਲਦੁ ਕਰਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 104.85,
      "end_time": 111.345,
      "transcript": "ਨਿਤ ਭਲਕੇ ਉਠਿ ਪ੍ਰਭਿ ਜੋਇਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 111.8,
      "end_time": 118.79,
      "transcript": "ਹਰਿ ਵੇਖੈ ਸੁਣੈ ਨਿਤ ਸਭੁ ਕਿਛੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 118.79,
      "end_time": 125.355,
      "transcript": "ਤਿਦੂ ਕਿਛੁ ਗੁਝਾ ਨ ਹੋਇਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 125.675,
      "end_time": 132.115,
      "transcript": "ਜੈਸਾ ਬੀਜੇ ਸੋ ਲੁਣੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 132.485,
      "end_time": 138.945,
      "transcript": "ਜੇਹਾ ਪੁਰਬਿ ਕਿਨੈ ਬੋਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 139.4,
      "end_time": 145.845,
      "transcript": "ਜਿਸੁ ਕ੍ਰਿਪਾ ਕਰੇ ਪ੍ਰਭੁ ਆਪਣੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 146.24,
      "end_time": 152.575,
      "transcript": "ਤਿਸੁ ਸਤਿਗੁਰ ਕੇ ਚਰਣ ਧੋਇਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 153.08,
      "end_time": 159.365,
      "transcript": "ਗੁਰ ਸਤਿਗੁਰ ਪਿਛੈ ਤਰਿ ਗਇਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 159.725,
      "end_time": 165.965,
      "transcript": "ਜਿਉ ਲੋਹਾ ਕਾਠ ਸੰਗੋਇਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 166.345,
      "end_time": 172.605,
      "transcript": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਧਿਆਇ ਤੂ"
    },
    {
      "section_id": "section-00022",
      "start_time": 173.08,
      "end_time": 179.255,
      "transcript": "ਜਪਿ ਹਰਿ ਹਰਿ ਨਾਮਿ ਸੁਖੁ ਹੋਇਆ"
    },
    {
      "section_id": "section-00023",
      "start_time": 179.6,
      "end_time": 186.682,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 193.24,
      "end_time": 199.375,
      "transcript": "ਵਡਭਾਗੀਆ ਸੋਹਾਗਣੀ"
    },
    {
      "section_id": "section-00025",
      "start_time": 199.815,
      "end_time": 206.315,
      "transcript": "ਜਿਨਾ ਗੁਰਮੁਖਿ ਮਿਲਿਆ ਹਰਿ ਰਾਇ"
    },
    {
      "section_id": "section-00026",
      "start_time": 206.315,
      "end_time": 212.89,
      "transcript": "ਅੰਤਰ ਜੋਤਿ ਪ੍ਰਗਾਸੀਆ"
    },
    {
      "section_id": "section-00027",
      "start_time": 212.89,
      "end_time": 219.375,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਸਮਾਇ"
    },
    {
      "section_id": "section-00028",
      "start_time": 219.72,
      "end_time": 223.825,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00029",
      "start_time": 232.0,
      "end_time": 240.51,
      "transcript": "ਇਹੁ ਸਰੀਰੁ ਸਭੁ ਧਰਮੁ ਹੈ, ਜਿਸੁ ਅੰਦਰਿ ਸਚੇ ਕੀ ਵਿਚਿ ਜੋਤਿ"
    },
    {
      "section_id": "section-00030",
      "start_time": 240.51,
      "end_time": 248.885,
      "transcript": "ਗੁਹਜ ਰਤਨ ਵਿਚਿ ਲੁਕਿ ਰਹੇ, ਕੋਈ ਗੁਰਮੁਖਿ ਸੇਵਕੁ ਕਢੈ ਖੋਤਿ"
    },
    {
      "section_id": "section-00031",
      "start_time": 248.885,
      "end_time": 257.72,
      "transcript": "ਸਭੁ ਆਤਮ ਰਾਮੁ ਪਛਾਣਿਆ, ਤਾਂ ਇਕੁ ਰਵਿਆ ਇਕੋ ਓਤਿ ਪੋਤਿ"
    },
    {
      "section_id": "section-00032",
      "start_time": 257.72,
      "end_time": 266.08,
      "transcript": "ਇਕੁ ਦੇਖਿਆ ਇਕੁ ਮੰਨਿਆ, ਇਕੋ ਸੁਣਿਆ ਸ੍ਰਵਣ ਸਰੋਤਿ"
    },
    {
      "section_id": "section-00033",
      "start_time": 266.08,
      "end_time": 274.645,
      "transcript": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਸਲਾਹਿ ਤੂ, ਸਚੁ ਸਚੇ ਸੇਵਾ ਤੇਰੀ ਹੋਤਿ"
    }
  ]
}

{
  "audio_file": "0146 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.12,
      "end_time": 6.155,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.76,
      "end_time": 18.865,
      "transcript": "ਕਰੈ ਦੁਹਕਰਮ, ਦਿਖਾਵੈ ਹੋਰੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.865,
      "end_time": 25.49,
      "transcript": "ਰਾਮ ਕੀ ਦਰਗਹ, ਬਾਧਾ ਚੋਰੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.49,
      "end_time": 31.765,
      "transcript": "ਰਾਮੁ ਰਮੈ, ਸੋਈ ਰਾਮਾਣਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.765,
      "end_time": 39.755,
      "transcript": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ, ਏਕੁ ਸਮਾਣਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 47.575,
      "end_time": 53.865,
      "transcript": "ਅੰਤਰਿ ਬਿਖੁ, ਮੁਖਿ ਅੰਮ੍ਰਿਤੁ ਸੁਣਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.865,
      "end_time": 60.12,
      "transcript": "ਜਮ ਪੁਰਿ ਬਾਧਾ, ਚੋਟਾ ਖਾਵੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.12,
      "end_time": 66.37,
      "transcript": "ਅਨਿਕ ਪੜਦੇ ਮਹਿ, ਕਮਾਵੈ ਵਿਕਾਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.37,
      "end_time": 72.745,
      "transcript": "ਖਿਨ ਮਹਿ, ਪ੍ਰਗਟ ਹੋਹਿ ਸੰਸਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.0,
      "end_time": 85.179,
      "transcript": "ਅੰਤਰਿ ਸਾਚਿ ਨਾਮਿ ਰਸਿ ਰਾਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.179,
      "end_time": 91.365,
      "transcript": "ਨਾਨਕ, ਤਿਸੁ ਕਿਰਪਾਲੁ ਬਿਧਾਤਾ"
    }
  ]
}

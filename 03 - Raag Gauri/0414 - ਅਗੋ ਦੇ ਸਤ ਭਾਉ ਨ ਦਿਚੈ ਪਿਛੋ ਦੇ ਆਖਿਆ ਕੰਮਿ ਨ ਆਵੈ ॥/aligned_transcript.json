{
  "audio_file": "0227 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.4,
      "end_time": 16.284,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 34.84,
      "end_time": 42.515,
      "transcript": "ਅਗੋ ਦੇ ਸਤ ਭਾਉ ਨ ਦਿਚੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 42.88,
      "end_time": 50.8,
      "transcript": "ਪਿਛੋ ਦੇ ਆਖਿਆ ਕੰਮਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 50.8,
      "end_time": 58.56,
      "transcript": "ਅਧ ਵਿਚਿ ਫਿਰੈ ਮਨਮੁਖੁ ਵੇਚਾਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 58.56,
      "end_time": 65.885,
      "transcript": "ਗਲੀ ਕਿਉ ਸੁਖੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 66.44,
      "end_time": 73.836,
      "transcript": "ਜਿਸੁ ਅੰਦਰਿ ਪ੍ਰੀਤਿ ਨਹੀ ਸਤਿਗੁਰ ਕੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 73.836,
      "end_time": 81.835,
      "transcript": "ਸੁ ਕੂੜੀ ਆਵੈ ਕੂੜੀ ਜਾਵੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 81.835,
      "end_time": 89.576,
      "transcript": "ਜੇ ਕ੍ਰਿਪਾ ਕਰੇ ਮੇਰਾ ਹਰਿ ਪ੍ਰਭੁ ਕਰਤਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 89.576,
      "end_time": 97.36,
      "transcript": "ਤਾਂ ਸਤਿਗੁਰੁ ਪਾਰਬ੍ਰਹਮੁ ਨਦਰੀ ਆਵੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 97.36,
      "end_time": 104.605,
      "transcript": "ਤਾ ਅਪਿਉ ਪੀਵੈ ਸਬਦੁ ਗੁਰ ਕੇਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 105.0,
      "end_time": 112.59,
      "transcript": "ਸਭੁ ਕਾੜਾ ਅੰਦੇਸਾ ਭਰਮੁ ਚੁਕਾਵੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 112.59,
      "end_time": 120.035,
      "transcript": "ਸਦਾ ਅਨੰਦਿ ਰਹੈ ਦਿਨੁ ਰਾਤੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 120.44,
      "end_time": 127.535,
      "transcript": "ਜਨ ਨਾਨਕ ਅਨਦਿਨੁ ਹਰਿ ਗੁਣ ਗਾਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 127.535,
      "end_time": 131.96,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 131.96,
      "end_time": 139.36,
      "transcript": "ਗੁਰ ਸਤਿਗੁਰ ਕਾ ਜੋ ਸਿਖੁ ਅਖਾਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 139.36,
      "end_time": 147.235,
      "transcript": "ਸੁ ਭਲਕੇ ਉਠਿ ਹਰਿ ਨਾਮੁ ਧਿਆਵੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 147.235,
      "end_time": 154.605,
      "transcript": "ਉਦਮੁ ਕਰੇ ਭਲਕੇ ਪਰਭਾਤੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 154.605,
      "end_time": 161.935,
      "transcript": "ਇਸਨਾਨੁ ਕਰੇ ਅੰਮ੍ਰਿਤ ਸਰਿ ਨਾਵੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 170.04,
      "end_time": 177.64,
      "transcript": "ਉਪਦੇਸਿ ਗੁਰੂ ਹਰਿ ਹਰਿ ਜਪੁ ਜਾਪੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 177.64,
      "end_time": 185.235,
      "transcript": "ਸਭਿ ਕਿਲਵਿਖ ਪਾਪ ਦੋਖ ਲਹਿ ਜਾਵੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 185.235,
      "end_time": 192.88,
      "transcript": "ਫਿਰਿ ਚੜੈ ਦਿਵਸੁ ਗੁਰਬਾਣੀ ਗਾਵੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 192.88,
      "end_time": 200.265,
      "transcript": "ਬਹਦਿਆ ਉਠਦਿਆ ਹਰਿ ਨਾਮੁ ਧਿਆਵੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 200.265,
      "end_time": 207.81,
      "transcript": "ਜੋ ਸਾਸਿ ਗਿਰਾਸਿ ਧਿਆਏ ਮੇਰਾ ਹਰਿ ਹਰਿ"
    },
    {
      "section_id": "section-00024",
      "start_time": 207.81,
      "end_time": 215.335,
      "transcript": "ਸੋ ਗੁਰਸਿਖੁ ਗੁਰੂ ਮਨਿ ਭਾਵੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 215.535,
      "end_time": 223.08,
      "transcript": "ਜਿਸ ਨੋ ਦਇਆਲੁ ਹੋਵੈ ਮੇਰਾ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 223.08,
      "end_time": 230.555,
      "transcript": "ਤਿਸੁ ਗੁਰਸਿਖ ਗੁਰੂ ਉਪਦੇਸੁ ਸੁਣਾਵੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 230.555,
      "end_time": 237.72,
      "transcript": "ਜਨੁ ਨਾਨਕੁ ਧੂੜਿ ਮੰਗੈ ਤਿਸੁ ਗੁਰਸਿਖ ਕੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 237.72,
      "end_time": 245.315,
      "transcript": "ਜੋ ਆਪਿ ਜਪੈ ਅਵਰਹ ਨਾਮੁ ਜਪਾਵੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 245.315,
      "end_time": 250.055,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00030",
      "start_time": 253.6,
      "end_time": 261.77,
      "transcript": "ਜੋ ਤੁਧੁ ਸਚੁ ਧਿਆਇਦੇ, ਸੇ ਵਿਰਲੇ ਥੋੜੇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 261.77,
      "end_time": 269.76,
      "transcript": "ਜੋ ਮਨਿ ਚਿਤਿ ਇਕੁ ਅਰਾਧਦੇ ਤਿਨ, ਕੀ ਬਰਕਤਿ ਖਾਹਿ ਅਸੰਖ ਕਰੋੜੇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 269.76,
      "end_time": 277.735,
      "transcript": "ਤੁਧੁਨੋ ਸਭ ਧਿਆਇਦੀ, ਸੇ ਥਾਇ ਪਏ ਜੋ ਸਾਹਿਬ ਲੋੜੇ"
    },
    {
      "section_id": "section-00033",
      "start_time": 277.735,
      "end_time": 285.48,
      "transcript": "ਜੋ ਬਿਨੁ ਸਤਿਗੁਰ ਸੇਵੇ ਖਾਦੇ ਪੈਨਦੇ, ਸੇ ਮੁਏ ਮਰਿ ਜੰਮੇ ਕੋੜ੍ਹੇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 285.48,
      "end_time": 292.84,
      "transcript": "ਓਇ ਹਾਜਰੁ ਮਿਠਾ ਬੋਲਦੇ, ਬਾਹਰਿ ਵਿਸੁ ਕਢਹਿ ਮੁਖਿ ਘੋਲੇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 292.84,
      "end_time": 297.725,
      "transcript": "ਮਨਿ ਖੋਟੇ, ਦਯਿ ਵਿਛੋੜੇ"
    }
  ]
}

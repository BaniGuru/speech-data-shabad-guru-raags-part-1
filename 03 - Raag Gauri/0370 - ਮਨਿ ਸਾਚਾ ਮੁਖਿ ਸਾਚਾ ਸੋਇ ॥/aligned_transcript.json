{
  "audio_file": "0204 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.905,
      "end_time": 15.665,
      "transcript": "ਸਲੋਕੁ ਮਨਿ ਸਾਚਾ, ਮੁਖਿ ਸਾਚਾ ਸੋਇ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.2,
      "end_time": 26.975,
      "transcript": "ਅਵਰੁ ਨ ਪੇਖੈ, ਏਕਸੁ ਬਿਨੁ ਕੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 27.585,
      "end_time": 38.959,
      "transcript": "ਨਾਨਕ ਇਹ ਲਛਣ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.959,
      "end_time": 55.845,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਹੋਇ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 90.205,
      "end_time": 98.165,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸਦਾ ਨਿਰਲੇਪ"
    },
    {
      "section_id": "section-00006",
      "start_time": 98.565,
      "end_time": 106.345,
      "transcript": "ਜੈਸੇ ਜਲ ਮਹਿ, ਕਮਲ ਅਲੇਪ"
    },
    {
      "section_id": "section-00007",
      "start_time": 106.8,
      "end_time": 114.575,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸਦਾ ਨਿਰਦੋਖ"
    },
    {
      "section_id": "section-00008",
      "start_time": 115.005,
      "end_time": 123.185,
      "transcript": "ਜੈਸੇ ਸੂਰੁ, ਸਰਬ ਕਉ ਸੋਖ"
    },
    {
      "section_id": "section-00009",
      "start_time": 131.4,
      "end_time": 139.225,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਦ੍ਰਿਸਟਿ ਸਮਾਨਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 139.68,
      "end_time": 147.385,
      "transcript": "ਜੈਸੇ ਰਾਜ ਰੰਕ ਕਉ, ਲਾਗੈ ਤੁਲਿ ਪਵਾਨ"
    },
    {
      "section_id": "section-00011",
      "start_time": 147.84,
      "end_time": 155.705,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਧੀਰਜੁ ਏਕ"
    },
    {
      "section_id": "section-00012",
      "start_time": 156.08,
      "end_time": 163.805,
      "transcript": "ਜਿਉ ਬਸੁਧਾ, ਕੋਊ ਖੋਦੈ ਕੋਊ ਚੰਦਨ ਲੇਪ"
    },
    {
      "section_id": "section-00013",
      "start_time": 164.24,
      "end_time": 171.795,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਇਹੈ ਗੁਨਾਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 172.365,
      "end_time": 180.85,
      "transcript": "ਨਾਨਕ ਜਿਉ ਪਾਵਕ ਕਾ, ਸਹਜ ਸੁਭਾਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 188.432,
      "end_time": 196.305,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਨਿਰਮਲ ਤੇ ਨਿਰਮਲਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 196.695,
      "end_time": 204.355,
      "transcript": "ਜੈਸੇ ਮੈਲੁ, ਨ ਲਾਗੈ ਜਲਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 204.72,
      "end_time": 212.295,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਮਨਿ ਹੋਇ ਪ੍ਰਗਾਸੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 212.84,
      "end_time": 221.165,
      "transcript": "ਜੈਸੇ, ਧਰ ਊਪਰਿ ਆਕਾਸੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 228.445,
      "end_time": 236.845,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਮਿਤ੍ਰ ਸਤ੍ਰੁ ਸਮਾਨਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 236.845,
      "end_time": 244.505,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਨਾਹੀ ਅਭਿਮਾਨ"
    },
    {
      "section_id": "section-00021",
      "start_time": 244.92,
      "end_time": 252.88,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਊਚ ਤੇ ਊਚਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 252.88,
      "end_time": 260.8,
      "transcript": "ਮਨਿ ਅਪਨੈ ਹੈ, ਸਭ ਤੇ ਨੀਚਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 260.8,
      "end_time": 268.325,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸੇ ਜਨ ਭਏ"
    },
    {
      "section_id": "section-00024",
      "start_time": 268.765,
      "end_time": 277.875,
      "transcript": "ਨਾਨਕ ਜਿਨ ਪ੍ਰਭੁ, ਆਪਿ ਕਰੇਇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 288.285,
      "end_time": 295.985,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸਗਲ ਕੀ ਰੀਨਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 296.44,
      "end_time": 303.865,
      "transcript": "ਆਤਮ ਰਸੁ, ਬ੍ਰਹਮ ਗਿਆਨੀ ਚੀਨਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 304.32,
      "end_time": 311.725,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ, ਸਭ ਊਪਰਿ ਮਇਆ"
    },
    {
      "section_id": "section-00028",
      "start_time": 312.28,
      "end_time": 320.075,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਤੇ, ਕਛੁ ਬੁਰਾ ਨ ਭਇਆ"
    },
    {
      "section_id": "section-00029",
      "start_time": 328.12,
      "end_time": 335.635,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸਦਾ ਸਮਦਰਸੀ"
    },
    {
      "section_id": "section-00030",
      "start_time": 335.96,
      "end_time": 343.645,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਦ੍ਰਿਸਟਿ, ਅੰਮ੍ਰਿਤੁ ਬਰਸੀ"
    },
    {
      "section_id": "section-00031",
      "start_time": 343.92,
      "end_time": 351.445,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਬੰਧਨ ਤੇ ਮੁਕਤਾ"
    },
    {
      "section_id": "section-00032",
      "start_time": 351.8,
      "end_time": 359.335,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ, ਨਿਰਮਲ ਜੁਗਤਾ"
    },
    {
      "section_id": "section-00033",
      "start_time": 359.72,
      "end_time": 367.125,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਭੋਜਨੁ ਗਿਆਨ"
    },
    {
      "section_id": "section-00034",
      "start_time": 367.585,
      "end_time": 375.245,
      "transcript": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਬ੍ਰਹਮ ਧਿਆਨੁ"
    },
    {
      "section_id": "section-00035",
      "start_time": 383.165,
      "end_time": 390.635,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਏਕ ਊਪਰਿ ਆਸ"
    },
    {
      "section_id": "section-00036",
      "start_time": 391.08,
      "end_time": 398.455,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਨਹੀ ਬਿਨਾਸ"
    },
    {
      "section_id": "section-00037",
      "start_time": 398.92,
      "end_time": 406.415,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਗਰੀਬੀ ਸਮਾਹਾ"
    },
    {
      "section_id": "section-00038",
      "start_time": 406.72,
      "end_time": 414.455,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਪਰਉਪਕਾਰ ਉਮਾਹਾ"
    },
    {
      "section_id": "section-00039",
      "start_time": 422.275,
      "end_time": 430.2,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਨਾਹੀ ਧੰਧਾ"
    },
    {
      "section_id": "section-00040",
      "start_time": 430.2,
      "end_time": 438.04,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਲੇ ਧਾਵਤੁ ਬੰਧਾ"
    },
    {
      "section_id": "section-00041",
      "start_time": 438.04,
      "end_time": 445.565,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਹੋਇ ਸੁ ਭਲਾ"
    },
    {
      "section_id": "section-00042",
      "start_time": 445.84,
      "end_time": 453.345,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸੁਫਲ ਫਲਾ"
    },
    {
      "section_id": "section-00043",
      "start_time": 453.68,
      "end_time": 461.085,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸੰਗਿ, ਸਗਲ ਉਧਾਰੁ"
    },
    {
      "section_id": "section-00044",
      "start_time": 461.515,
      "end_time": 468.905,
      "transcript": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ, ਜਪੈ ਸਗਲ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00045",
      "start_time": 480.667,
      "end_time": 488.315,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਏਕੈ ਰੰਗ"
    },
    {
      "section_id": "section-00046",
      "start_time": 488.72,
      "end_time": 496.205,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਬਸੈ ਪ੍ਰਭੁ ਸੰਗ"
    },
    {
      "section_id": "section-00047",
      "start_time": 496.52,
      "end_time": 504.44,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਨਾਮੁ ਆਧਾਰੁ"
    },
    {
      "section_id": "section-00048",
      "start_time": 504.44,
      "end_time": 512.385,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਨਾਮੁ ਪਰਵਾਰੁ"
    },
    {
      "section_id": "section-00049",
      "start_time": 520.085,
      "end_time": 527.92,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸਦਾ ਸਦ ਜਾਗਤ"
    },
    {
      "section_id": "section-00050",
      "start_time": 527.92,
      "end_time": 535.8,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਅਹੰਬੁਧਿ ਤਿਆਗਤ"
    },
    {
      "section_id": "section-00051",
      "start_time": 535.8,
      "end_time": 543.355,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਮਨਿ, ਪਰਮਾਨੰਦ"
    },
    {
      "section_id": "section-00052",
      "start_time": 543.68,
      "end_time": 550.985,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਘਰਿ, ਸਦਾ ਅਨੰਦ"
    },
    {
      "section_id": "section-00053",
      "start_time": 551.44,
      "end_time": 558.875,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸੁਖ ਸਹਜ ਨਿਵਾਸ"
    },
    {
      "section_id": "section-00054",
      "start_time": 559.335,
      "end_time": 567.274,
      "transcript": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਨਹੀ ਬਿਨਾਸ"
    },
    {
      "section_id": "section-00055",
      "start_time": 574.88,
      "end_time": 582.445,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਬ੍ਰਹਮ ਕਾ ਬੇਤਾ"
    },
    {
      "section_id": "section-00056",
      "start_time": 582.76,
      "end_time": 590.56,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਏਕ ਸੰਗਿ ਹੇਤਾ"
    },
    {
      "section_id": "section-00057",
      "start_time": 590.56,
      "end_time": 598.055,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਹੋਇ ਅਚਿੰਤ"
    },
    {
      "section_id": "section-00058",
      "start_time": 598.44,
      "end_time": 606.245,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਨਿਰਮਲ ਮੰਤ"
    },
    {
      "section_id": "section-00059",
      "start_time": 614.0,
      "end_time": 621.645,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਜਿਸੁ ਕਰੈ ਪ੍ਰਭੁ ਆਪਿ"
    },
    {
      "section_id": "section-00060",
      "start_time": 621.645,
      "end_time": 629.595,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਬਡ ਪਰਤਾਪ"
    },
    {
      "section_id": "section-00061",
      "start_time": 629.595,
      "end_time": 637.43,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਦਰਸੁ, ਬਡਭਾਗੀ ਪਾਈਐ"
    },
    {
      "section_id": "section-00062",
      "start_time": 637.43,
      "end_time": 644.875,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਉ, ਬਲਿ ਬਲਿ ਜਾਈਐ"
    },
    {
      "section_id": "section-00063",
      "start_time": 645.28,
      "end_time": 653.03,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਉ, ਖੋਜਹਿ ਮਹੇਸੁਰ"
    },
    {
      "section_id": "section-00064",
      "start_time": 653.03,
      "end_time": 661.845,
      "transcript": "ਨਾਨਕ, ਬ੍ਰਹਮ ਗਿਆਨੀ ਆਪਿ ਪਰਮੇਸੁਰ"
    },
    {
      "section_id": "section-00065",
      "start_time": 672.019,
      "end_time": 679.745,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ, ਕੀਮਤਿ ਨਾਹਿ"
    },
    {
      "section_id": "section-00066",
      "start_time": 680.12,
      "end_time": 687.495,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ, ਸਗਲ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00067",
      "start_time": 687.88,
      "end_time": 695.43,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਕਉਨ ਜਾਨੈ ਭੇਦੁ"
    },
    {
      "section_id": "section-00068",
      "start_time": 695.43,
      "end_time": 703.535,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਉ, ਸਦਾ ਅਦੇਸੁ"
    },
    {
      "section_id": "section-00069",
      "start_time": 711.16,
      "end_time": 719.0,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਕਥਿਆ ਨ ਜਾਇ ਅਧਾਖੵਰੁ"
    },
    {
      "section_id": "section-00070",
      "start_time": 719.0,
      "end_time": 726.76,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸਰਬ ਕਾ ਠਾਕੁਰੁ"
    },
    {
      "section_id": "section-00071",
      "start_time": 726.76,
      "end_time": 734.52,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਮਿਤਿ, ਕਉਨੁ ਬਖਾਨੈ"
    },
    {
      "section_id": "section-00072",
      "start_time": 734.52,
      "end_time": 742.36,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਗਤਿ, ਬ੍ਰਹਮ ਗਿਆਨੀ ਜਾਨੈ"
    },
    {
      "section_id": "section-00073",
      "start_time": 742.36,
      "end_time": 749.755,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ, ਅੰਤੁ ਨ ਪਾਰੁ"
    },
    {
      "section_id": "section-00074",
      "start_time": 750.165,
      "end_time": 757.835,
      "transcript": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਉ, ਸਦਾ ਨਮਸਕਾਰੁ"
    },
    {
      "section_id": "section-00075",
      "start_time": 765.605,
      "end_time": 772.945,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸਭ ਸ੍ਰਿਸਟਿ ਕਾ ਕਰਤਾ"
    },
    {
      "section_id": "section-00076",
      "start_time": 773.36,
      "end_time": 780.655,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਸਦ ਜੀਵੈ ਨਹੀ ਮਰਤਾ"
    },
    {
      "section_id": "section-00077",
      "start_time": 781.0,
      "end_time": 788.325,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਮੁਕਤਿ ਜੁਗਤਿ ਜੀਅ ਕਾ ਦਾਤਾ"
    },
    {
      "section_id": "section-00078",
      "start_time": 788.64,
      "end_time": 796.215,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ, ਪੂਰਨ ਪੁਰਖੁ ਬਿਧਾਤਾ"
    },
    {
      "section_id": "section-00079",
      "start_time": 803.915,
      "end_time": 811.8,
      "transcript": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਅਨਾਥ ਕਾ ਨਾਥੁ"
    },
    {

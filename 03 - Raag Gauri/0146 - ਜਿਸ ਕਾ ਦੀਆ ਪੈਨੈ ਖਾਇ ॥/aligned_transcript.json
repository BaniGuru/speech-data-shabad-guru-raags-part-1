{
  "audio_file": "0147 BPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.215,
      "end_time": 7.485,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.98,
      "end_time": 19.76,
      "transcript": "ਜਿਸ ਕਾ ਦੀਆ, ਪੈਨੈ ਖਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.76,
      "end_time": 26.24,
      "transcript": "ਤਿਸੁ ਸਿਉ, ਆਲਸੁ ਕਿਉ ਬਨੈ ਮਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.24,
      "end_time": 32.8,
      "transcript": "ਖਸਮੁ ਬਿਸਾਰਿ, ਆਨ ਕੰਮਿ ਲਾਗਹਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.8,
      "end_time": 42.295,
      "transcript": "ਕਉਡੀ ਬਦਲੇ, ਰਤਨੁ ਤਿਆਗਹਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.92,
      "end_time": 55.295,
      "transcript": "ਪ੍ਰਭੂ ਤਿਆਗਿ, ਲਾਗਤ ਅਨ ਲੋਭਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.295,
      "end_time": 61.88,
      "transcript": "ਦਾਸਿ ਸਲਾਮੁ ਕਰਤ, ਕਤ ਸੋਭਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.88,
      "end_time": 68.24,
      "transcript": "ਅੰਮ੍ਰਿਤ ਰਸੁ, ਖਾਵਹਿ ਖਾਨ ਪਾਨ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.24,
      "end_time": 74.612,
      "transcript": "ਜਿਨਿ ਦੀਏ, ਤਿਸਹਿ ਨ ਜਾਨਹਿ ਸੁਆਨ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.612,
      "end_time": 81.08,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਹਮ ਲੂਣ ਹਰਾਮੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.08,
      "end_time": 86.995,
      "transcript": "ਬਖਸਿ ਲੇਹੁ, ਪ੍ਰਭ ਅੰਤਰਜਾਮੀ"
    }
  ]
}

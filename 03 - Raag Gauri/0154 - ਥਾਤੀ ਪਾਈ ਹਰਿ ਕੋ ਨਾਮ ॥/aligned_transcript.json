{
  "audio_file": "0148 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 7.414,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.92,
      "end_time": 23.606,
      "transcript": "ਥਾਤੀ ਪਾਈ, ਹਰਿ ਕੋ ਨਾਮ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.606,
      "end_time": 31.519,
      "transcript": "ਬਿਚਰੁ ਸੰਸਾਰ, ਪੂਰਨ ਸਭਿ ਕਾਮ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.519,
      "end_time": 39.745,
      "transcript": "ਵਡਭਾਗੀ, ਹਰਿ ਕੀਰਤਨੁ ਗਾਈਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.745,
      "end_time": 47.605,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਤੂੰ ਦੇਹਿ, ਤ ਪਾਈਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.36,
      "end_time": 75.36,
      "transcript": "ਹਰਿ ਕੇ ਚਰਣ, ਹਿਰਦੈ ਉਰਿ ਧਾਰਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.36,
      "end_time": 82.785,
      "transcript": "ਭਵ ਸਾਗਰੁ, ਚੜਿ ਉਤਰਹਿ ਪਾਰਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 83.2,
      "end_time": 90.83,
      "transcript": "ਸਾਧੂ ਸੰਗੁ, ਕਰਹੁ ਸਭੁ ਕੋਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 90.83,
      "end_time": 98.145,
      "transcript": "ਸਦਾ ਕਲਿਆਣ, ਫਿਰਿ ਦੂਖੁ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 98.8,
      "end_time": 106.205,
      "transcript": "ਪ੍ਰੇਮ ਭਗਤਿ, ਭਜੁ ਗੁਣੀ ਨਿਧਾਨੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 106.715,
      "end_time": 113.675,
      "transcript": "ਨਾਨਕ, ਦਰਗਹ ਪਾਈਐ ਮਾਨੁ"
    }
  ]
}

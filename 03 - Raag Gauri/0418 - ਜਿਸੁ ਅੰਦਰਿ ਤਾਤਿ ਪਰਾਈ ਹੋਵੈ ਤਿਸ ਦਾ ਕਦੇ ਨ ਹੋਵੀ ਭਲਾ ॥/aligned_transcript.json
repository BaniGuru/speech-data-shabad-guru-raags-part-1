{
  "audio_file": "0228 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.155,
      "end_time": 6.187,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.187,
      "end_time": 17.958,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.04,
      "end_time": 33.6,
      "transcript": "ਜਿਸੁ ਅੰਦਰਿ ਤਾਤਿ ਪਰਾਈ ਹੋਵੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.6,
      "end_time": 40.185,
      "transcript": "ਤਿਸ ਦਾ ਕਦੇ ਨ ਹੋਵੀ ਭਲਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 41.08,
      "end_time": 48.476,
      "transcript": "ਓਸ ਦੈ ਆਖਿਐ ਕੋਈ ਨ ਲਗੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.476,
      "end_time": 55.699,
      "transcript": "ਨਿਤ ਓਜਾੜੀ ਪੂਕਾਰੇ ਖਲਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.699,
      "end_time": 62.645,
      "transcript": "ਜਿਸੁ ਅੰਦਰਿ ਚੁਗਲੀ ਚੁਗਲੋ ਵਜੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.515,
      "end_time": 70.125,
      "transcript": "ਕੀਤਾ ਕਰਤਿਆ ਓਸ ਦਾ ਸਭੁ ਗਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.88,
      "end_time": 78.32,
      "transcript": "ਨਿਤ ਚੁਗਲੀ ਕਰੇ ਅਣਹੋਦੀ ਪਰਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.32,
      "end_time": 85.225,
      "transcript": "ਮੁਹੁ ਕਢਿ ਨ ਸਕੈ ਓਸ ਦਾ ਕਾਲਾ ਭਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.72,
      "end_time": 93.24,
      "transcript": "ਕਰਮ ਧਰਤੀ ਸਰੀਰੁ ਕਲਿਜੁਗ ਵਿਚਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 93.24,
      "end_time": 100.59,
      "transcript": "ਜੇਹਾ ਕੋ ਬੀਜੇ ਤੇਹਾ ਕੋ ਖਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 100.59,
      "end_time": 107.99,
      "transcript": "ਗਲਾ ਉਪਰਿ ਤਪਾਵਸੁ ਨ ਹੋਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 107.99,
      "end_time": 114.765,
      "transcript": "ਵਿਸੁ ਖਾਧੀ ਤਤਕਾਲ ਮਰਿ ਜਾਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 115.48,
      "end_time": 123.04,
      "transcript": "ਭਾਈ ਵੇਖਹੁ ਨਿਆਉ ਸਚੁ ਕਰਤੇ ਕਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 123.04,
      "end_time": 130.36,
      "transcript": "ਜੇਹਾ ਕੋਈ ਕਰੇ ਤੇਹਾ ਕੋਈ ਪਾਏ"
    },
    {
      "section_id": "section-00017",
      "start_time": 130.36,
      "end_time": 137.7,
      "transcript": "ਜਨ ਨਾਨਕ ਕਉ ਸਭ ਸੋਝੀ ਪਾਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 137.7,
      "end_time": 144.824,
      "transcript": "ਹਰਿ ਦਰ ਕੀਆ ਬਾਤਾ ਆਖਿ ਸੁਣਾਏ"
    },
    {
      "section_id": "section-00019",
      "start_time": 144.824,
      "end_time": 149.445,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 156.36,
      "end_time": 163.8,
      "transcript": "ਹੋਦੈ ਪਰਤਖਿ ਗੁਰੂ ਜੋ ਵਿਛੁੜੇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 163.8,
      "end_time": 170.495,
      "transcript": "ਤਿਨ ਕਉ ਦਰਿ ਢੋਈ ਨਾਹੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 171.24,
      "end_time": 178.365,
      "transcript": "ਕੋਈ ਜਾਇ ਮਿਲੈ ਤਿਨ ਨਿੰਦਕਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 178.68,
      "end_time": 184.615,
      "transcript": "ਮੁਹ ਫਿਕੇ ਥੁਕ ਥੁਕ ਮੁਹਿ ਪਾਹੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 186.0,
      "end_time": 193.4,
      "transcript": "ਜੋ ਸਤਿਗੁਰਿ ਫਿਟਕੇ ਸੇ ਸਭ ਜਗਤਿ ਫਿਟਕੇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 193.4,
      "end_time": 200.045,
      "transcript": "ਨਿਤ ਭੰਭਲ ਭੂਸੇ ਖਾਹੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 200.76,
      "end_time": 207.635,
      "transcript": "ਜਿਨ ਗੁਰੁ ਗੋਪਿਆ ਆਪਣਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 208.2,
      "end_time": 214.385,
      "transcript": "ਸੇ ਲੈਦੇ ਢਹਾ ਫਿਰਾਹੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 215.42,
      "end_time": 222.76,
      "transcript": "ਤਿਨ ਕੀ ਭੁਖ ਕਦੇ ਨ ਉਤਰੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 222.76,
      "end_time": 229.555,
      "transcript": "ਨਿਤ ਭੁਖਾ ਭੁਖ ਕੂਕਾਹੀ"
    },
    {
      "section_id": "section-00030",
      "start_time": 230.32,
      "end_time": 236.955,
      "transcript": "ਓਨਾ ਦਾ ਆਖਿਆ ਕੋ ਨਾ ਸੁਣੈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 237.72,
      "end_time": 244.735,
      "transcript": "ਨਿਤ ਹਉਲੇ ਹਉਲਿ ਮਰਾਹੀ"
    },
    {
      "section_id": "section-00032",
      "start_time": 244.735,
      "end_time": 252.655,
      "transcript": "ਸਤਿਗੁਰ ਕੀ ਵਡਿਆਈ ਵੇਖਿ ਨ ਸਕਨੀ"
    },
    {
      "section_id": "section-00033",
      "start_time": 252.655,
      "end_time": 259.505,
      "transcript": "ਓਨਾ ਅਗੈ ਪਿਛੈ ਥਾਉ ਨਾਹੀ"
    },
    {
      "section_id": "section-00034",
      "start_time": 260.12,
      "end_time": 267.065,
      "transcript": "ਜੋ ਸਤਿਗੁਰਿ ਮਾਰੇ ਤਿਨ ਜਾਇ ਮਿਲਹਿ"
    },
    {
      "section_id": "section-00035",
      "start_time": 267.565,
      "end_time": 274.96,
      "transcript": "ਰਹਦੀ ਖੁਹਦੀ ਸਭ ਪਤਿ ਗਵਾਹੀ"
    },
    {
      "section_id": "section-00036",
      "start_time": 274.96,
      "end_time": 281.995,
      "transcript": "ਓਇ ਅਗੈ ਕੁਸਟੀ ਗੁਰ ਕੇ ਫਿਟਕੇ"
    },
    {
      "section_id": "section-00037",
      "start_time": 281.995,
      "end_time": 289.155,
      "transcript": "ਜਿ ਓਸੁ ਮਿਲੈ ਤਿਸੁ ਕੁਸਟੁ ਉਠਾਹੀ"
    },
    {
      "section_id": "section-00038",
      "start_time": 290.0,
      "end_time": 297.53,
      "transcript": "ਹਰਿ ਤਿਨ ਕਾ ਦਰਸਨੁ ਨਾ ਕਰਹੁ"
    },
    {
      "section_id": "section-00039",
      "start_time": 297.53,
      "end_time": 304.035,
      "transcript": "ਜੋ ਦੂਜੈ ਭਾਇ ਚਿਤੁ ਲਾਹੀ"
    },
    {
      "section_id": "section-00040",
      "start_time": 304.96,
      "end_time": 312.527,
      "transcript": "ਧੁਰਿ ਕਰਤੈ ਆਪਿ ਲਿਖਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00041",
      "start_time": 312.527,
      "end_time": 319.505,
      "transcript": "ਤਿਸੁ ਨਾਲਿ ਕਿਹੁ ਚਾਰਾ ਨਾਹੀ"
    },
    {
      "section_id": "section-00042",
      "start_time": 320.12,
      "end_time": 327.405,
      "transcript": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਅਰਾਧਿ ਤੂ"
    },
    {
      "section_id": "section-00043",
      "start_time": 327.405,
      "end_time": 333.975,
      "transcript": "ਤਿਸੁ ਅਪੜਿ ਕੋ ਨ ਸਕਾਹੀ"
    },
    {
      "section_id": "section-00044",
      "start_time": 335.055,
      "end_time": 341.615,
      "transcript": "ਨਾਵੈ ਕੀ ਵਡਿਆਈ ਵਡੀ ਹੈ"
    },
    {
      "section_id": "section-00045",
      "start_time": 342.64,
      "end_time": 349.525,
      "transcript": "ਨਿਤ ਸਵਾਈ ਚੜੈ ਚੜਾਹੀ"
    },
    {
      "section_id": "section-00046",
      "start_time": 349.785,
      "end_time": 354.395,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00047",
      "start_time": 361.275,
      "end_time": 367.715,
      "transcript": "ਜਿ ਹੋਂਦੈ ਗੁਰੂ ਬਹਿ ਟਿਕਿਆ"
    },
    {
      "section_id": "section-00048",
      "start_time": 368.72,
      "end_time": 376.195,
      "transcript": "ਤਿਸੁ ਜਨ ਕੀ ਵਡਿਆਈ ਵਡੀ ਹੋਈ"
    },
    {
      "section_id": "section-00049",
      "start_time": 376.195,
      "end_time": 383.589,
      "transcript": "ਤਿਸੁ ਕਉ ਜਗਤੁ ਨਿਵਿਆ"
    },
    {
      "section_id": "section-00050",
      "start_time": 383.589,
      "end_time": 391.04,
      "transcript": "ਸਭੁ ਪੈਰੀ ਪਇਆ ਜਸੁ ਵਰਤਿਆ ਲੋਈ"
    },
    {
      "section_id": "section-00051",
      "start_time": 391.04,
      "end_time": 398.455,
      "transcript": "ਤਿਸ ਕਉ ਖੰਡ ਬ੍ਰਹਮੰਡ ਨਮਸਕਾਰੁ ਕਰਹਿ"
    },
    {
      "section_id": "section-00052",
      "start_time": 398.455,
      "end_time": 406.08,
      "transcript": "ਜਿਸ ਕੈ ਮਸਤਕਿ ਹਥੁ ਧਰਿਆ ਗੁਰਿ ਪੂਰੈ ਸੋ ਪੂਰਾ ਹੋਈ"
    },
    {
      "section_id": "section-00053",
      "start_time": 406.08,
      "end_time": 413.325,
      "transcript": "ਗੁਰ ਕੀ ਵਡਿਆਈ ਨਿਤ ਚੜੈ ਸਵਾਈ"
    },
    {
      "section_id": "section-00054",
      "start_time": 413.325,
      "end_time": 419.985,
      "transcript": "ਅਪੜਿ ਕੋ ਨ ਸਕੋਈ"
    },
    {
      "section_id": "section-00055",
      "start_time": 420.76,
      "end_time": 427.925,
      "transcript": "ਜਨੁ ਨਾਨਕੁ ਹਰਿ ਕਰਤੈ ਆਪਿ ਬਹਿ ਟਿਕਿਆ"
    },
    {
      "section_id": "section-00056",
      "start_time": 427.925,
      "end_time": 437.555,
      "transcript": "ਆਪੇ ਪੈਜ ਰਖੈ ਪ੍ਰਭੁ ਸੋਈ ਪਉੜੀ"
    },
    {
      "section_id": "section-00057",
      "start_time": 439.52,
      "end_time": 447.75,
      "transcript": "ਕਾਇਆ ਕੋਟੁ ਅਪਾਰੁ ਹੈ, ਅੰਦਰਿ ਹਟਨਾਲੇ"
    },
    {
      "section_id": "section-00058",
      "start_time": 447.75,
      "end_time": 455.695,
      "transcript": "ਗੁਰਮੁਖਿ ਸਉਦਾ ਜੋ ਕਰੇ, ਹਰਿ ਵਸਤੁ ਸਮਾਲੇ"
    },
    {
      "section_id": "section-00059",
      "start_time": 455.96,
      "end_time": 463.815,
      "transcript": "ਨਾਮੁ ਨਿਧਾਨੁ ਹਰਿ ਵਣਜੀਐ, ਹੀਰੇ ਪਰਵਾਲੇ"
    },
    {
      "section_id": "section-00060",
      "start_time": 463.92,
      "end_time": 471.345,
      "transcript": "ਵਿਣੁ ਕਾਇਆ ਜਿ ਹੋਰ ਥੈ ਧਨੁ ਖੋਜਦੇ, ਸੇ ਮੂੜ ਬੇਤਾਲੇ"
    },
    {
      "section_id": "section-00061",
      "start_time": 471.75,
      "end_time": 483.688,
      "transcript": "ਸੇ ਉਝੜਿ ਭਰਮਿ ਭਵਾਈਅਹਿ ਜਿਉ ਝਾੜ ਮਿਰਗੁ ਭਾਲੇ"
    }
  ]
}

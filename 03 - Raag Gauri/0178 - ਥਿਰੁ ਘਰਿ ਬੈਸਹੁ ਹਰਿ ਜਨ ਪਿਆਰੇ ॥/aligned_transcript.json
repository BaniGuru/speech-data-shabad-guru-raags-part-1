{
  "audio_file": "0152 A PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.975,
      "end_time": 14.505,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 22.96,
      "end_time": 29.015,
      "transcript": "ਥਿਰੁ ਘਰਿ ਬੈਸਹੁ, ਹਰਿ ਜਨ ਪਿਆਰੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 29.48,
      "end_time": 37.215,
      "transcript": "ਸਤਿਗੁਰਿ ਤੁਮਰੇ, ਕਾਜ ਸਵਾਰੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.735,
      "end_time": 51.0,
      "transcript": "ਦੁਸਟ ਦੂਤ, ਪਰਮੇਸਰਿ ਮਾਰੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 51.0,
      "end_time": 57.2,
      "transcript": "ਜਨ ਕੀ ਪੈਜ, ਰਖੀ ਕਰਤਾਰੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 57.2,
      "end_time": 63.3,
      "transcript": "ਬਾਦਿਸਾਹ ਸਾਹ ਸਭ, ਵਸਿ ਕਰਿ ਦੀਨੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.3,
      "end_time": 69.715,
      "transcript": "ਅੰਮ੍ਰਿਤ ਨਾਮ, ਮਹਾ ਰਸ ਪੀਨੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.6,
      "end_time": 81.727,
      "transcript": "ਨਿਰਭਉ ਹੋਇ, ਭਜਹੁ ਭਗਵਾਨ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.727,
      "end_time": 87.985,
      "transcript": "ਸਾਧਸੰਗਤਿ ਮਿਲਿ, ਕੀਨੋ ਦਾਨੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.985,
      "end_time": 94.083,
      "transcript": "ਸਰਣਿ ਪਰੇ, ਪ੍ਰਭ ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.083,
      "end_time": 99.64,
      "transcript": "ਨਾਨਕ ਓਟ ਪਕਰੀ, ਪ੍ਰਭ ਸੁਆਮੀ"
    }
  ]
}

{
  "audio_file": "0199 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.44,
      "end_time": 15.122,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 24.646,
      "end_time": 32.625,
      "transcript": "ਬਹੁ ਸਾਸਤ੍ਰ ਬਹੁ ਸਿਮ੍ਰਿਤੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 33.28,
      "end_time": 40.935,
      "transcript": "ਪੇਖੇ ਸਰਬ ਢਢੋਲਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.52,
      "end_time": 49.135,
      "transcript": "ਪੂਜਸਿ ਨਾਹੀ ਹਰਿ ਹਰੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 49.635,
      "end_time": 61.265,
      "transcript": "ਨਾਨਕ ਨਾਮ ਅਮੋਲ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 71.715,
      "end_time": 79.58,
      "transcript": "ਜਾਪ ਤਾਪ, ਗਿਆਨ ਸਭਿ ਧਿਆਨ"
    },
    {
      "section_id": "section-00007",
      "start_time": 79.58,
      "end_time": 87.64,
      "transcript": "ਖਟ ਸਾਸਤ੍ਰ, ਸਿਮ੍ਰਿਤਿ ਵਖਿਆਨ"
    },
    {
      "section_id": "section-00008",
      "start_time": 87.64,
      "end_time": 95.265,
      "transcript": "ਜੋਗ ਅਭਿਆਸ, ਕਰਮ ਧ੍ਰਮ ਕਿਰਿਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 95.265,
      "end_time": 103.32,
      "transcript": "ਸਗਲ ਤਿਆਗਿ, ਬਨ ਮਧੇ ਫਿਰਿਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 103.32,
      "end_time": 111.12,
      "transcript": "ਅਨਿਕ ਪ੍ਰਕਾਰ, ਕੀਏ ਬਹੁ ਜਤਨਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 111.12,
      "end_time": 118.825,
      "transcript": "ਪੁੰਨ ਦਾਨ, ਹੋਮੇ ਬਹੁ ਰਤਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 118.825,
      "end_time": 126.41,
      "transcript": "ਸਰੀਰੁ ਕਟਾਇ, ਹੋਮੈ ਕਰਿ ਰਾਤੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 126.41,
      "end_time": 134.245,
      "transcript": "ਵਰਤ ਨੇਮ ਕਰੈ, ਬਹੁ ਭਾਤੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 134.245,
      "end_time": 142.01,
      "transcript": "ਨਹੀ ਤੁਲਿ, ਰਾਮ ਨਾਮ ਬੀਚਾਰ"
    },
    {
      "section_id": "section-00015",
      "start_time": 142.01,
      "end_time": 149.585,
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਨਾਮੁ, ਜਪੀਐ ਇਕ ਬਾਰ"
    },
    {
      "section_id": "section-00016",
      "start_time": 157.385,
      "end_time": 165.18,
      "transcript": "ਨਉ ਖੰਡ ਪ੍ਰਿਥਮੀ ਫਿਰੈ, ਚਿਰੁ ਜੀਵੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 165.18,
      "end_time": 172.755,
      "transcript": "ਮਹਾ ਉਦਾਸੁ, ਤਪੀਸਰੁ ਥੀਵੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 172.755,
      "end_time": 180.4,
      "transcript": "ਅਗਨਿ ਮਾਹਿ, ਹੋਮਤ ਪਰਾਨ"
    },
    {
      "section_id": "section-00019",
      "start_time": 180.4,
      "end_time": 187.77,
      "transcript": "ਕਨਿਕ ਅਸ੍ਵ ਹੈਵਰ, ਭੂਮਿ ਦਾਨ"
    },
    {
      "section_id": "section-00020",
      "start_time": 187.77,
      "end_time": 195.3,
      "transcript": "ਨਿਉਲੀ ਕਰਮ ਕਰੈ ਬਹੁ ਆਸਨ"
    },
    {
      "section_id": "section-00021",
      "start_time": 195.3,
      "end_time": 203.015,
      "transcript": "ਜੈਨ ਮਾਰਗ, ਸੰਜਮ ਅਤਿ ਸਾਧਨ"
    },
    {
      "section_id": "section-00022",
      "start_time": 203.015,
      "end_time": 210.64,
      "transcript": "ਨਿਮਖ ਨਿਮਖ ਕਰਿ, ਸਰੀਰੁ ਕਟਾਵੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 210.64,
      "end_time": 218.08,
      "transcript": "ਤਉ ਭੀ, ਹਉਮੈ ਮੈਲੁ ਨ ਜਾਵੈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 218.08,
      "end_time": 225.725,
      "transcript": "ਹਰਿ ਕੇ ਨਾਮ ਸਮਸਰਿ, ਕਛੁ ਨਾਹਿ"
    },
    {
      "section_id": "section-00025",
      "start_time": 225.725,
      "end_time": 233.305,
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਨਾਮੁ ਜਪਤ, ਗਤਿ ਪਾਹਿ"
    },
    {
      "section_id": "section-00026",
      "start_time": 240.905,
      "end_time": 247.875,
      "transcript": "ਮਨ ਕਾਮਨਾ, ਤੀਰਥ ਦੇਹ ਛੁਟੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 248.355,
      "end_time": 255.385,
      "transcript": "ਗਰਬੁ ਗੁਮਾਨੁ, ਨ ਮਨ ਤੇ ਹੁਟੈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 256.0,
      "end_time": 263.205,
      "transcript": "ਸੋਚ ਕਰੈ, ਦਿਨਸੁ ਅਰੁ ਰਾਤਿ"
    },
    {
      "section_id": "section-00029",
      "start_time": 263.205,
      "end_time": 270.765,
      "transcript": "ਮਨ ਕੀ ਮੈਲੁ, ਨ ਤਨ ਤੇ ਜਾਤਿ"
    },
    {
      "section_id": "section-00030",
      "start_time": 270.765,
      "end_time": 278.215,
      "transcript": "ਇਸੁ ਦੇਹੀ ਕਉ, ਬਹੁ ਸਾਧਨਾ ਕਰੈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 278.215,
      "end_time": 285.659,
      "transcript": "ਮਨ ਤੇ ਕਬਹੂ, ਨ ਬਿਖਿਆ ਟਰੈ"
    },
    {
      "section_id": "section-00032",
      "start_time": 285.659,
      "end_time": 293.17,
      "transcript": "ਜਲਿ ਧੋਵੈ ਬਹੁ, ਦੇਹ ਅਨੀਤਿ"
    },
    {
      "section_id": "section-00033",
      "start_time": 293.17,
      "end_time": 300.542,
      "transcript": "ਸੁਧ ਕਹਾ ਹੋਇ, ਕਾਚੀ ਭੀਤਿ"
    },
    {
      "section_id": "section-00034",
      "start_time": 300.542,
      "end_time": 308.02,
      "transcript": "ਮਨ ਹਰਿ ਕੇ ਨਾਮ ਕੀ, ਮਹਿਮਾ ਊਚ"
    },
    {
      "section_id": "section-00035",
      "start_time": 308.02,
      "end_time": 315.395,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਉਧਰੇ, ਪਤਿਤ ਬਹੁ ਮੂਚ"
    },
    {
      "section_id": "section-00036",
      "start_time": 323.005,
      "end_time": 330.42,
      "transcript": "ਬਹੁਤੁ ਸਿਆਣਪ, ਜਮ ਕਾ ਭਉ ਬਿਆਪੈ"
    },
    {
      "section_id": "section-00037",
      "start_time": 330.42,
      "end_time": 338.14,
      "transcript": "ਅਨਿਕ ਜਤਨ ਕਰਿ, ਤ੍ਰਿਸਨ ਨਾ ਧ੍ਰਾਪੈ"
    },
    {
      "section_id": "section-00038",
      "start_time": 338.14,
      "end_time": 345.115,
      "transcript": "ਭੇਖ ਅਨੇਕ, ਅਗਨਿ ਨਹੀ ਬੁਝੈ"
    },
    {
      "section_id": "section-00039",
      "start_time": 345.6,
      "end_time": 352.365,
      "transcript": "ਕੋਟਿ ਉਪਾਵ, ਦਰਗਹ ਨਹੀ ਸਿਝੈ"
    },
    {
      "section_id": "section-00040",
      "start_time": 352.96,
      "end_time": 360.36,
      "transcript": "ਛੂਟਸਿ ਨਾਹੀ, ਊਭ ਪਇਆਲਿ"
    },
    {
      "section_id": "section-00041",
      "start_time": 360.36,
      "end_time": 367.72,
      "transcript": "ਮੋਹਿ ਬਿਆਪਹਿ, ਮਾਇਆ ਜਾਲਿ"
    },
    {
      "section_id": "section-00042",
      "start_time": 367.72,
      "end_time": 375.07,
      "transcript": "ਅਵਰ ਕਰਤੂਤਿ, ਸਗਲੀ ਜਮੁ ਡਾਨੈ"
    },
    {
      "section_id": "section-00043",
      "start_time": 375.07,
      "end_time": 382.335,
      "transcript": "ਗੋਵਿੰਦ ਭਜਨ ਬਿਨੁ, ਤਿਲੁ ਨਹੀ ਮਾਨੈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 382.335,
      "end_time": 389.84,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਪਤ, ਦੁਖੁ ਜਾਇ"
    },
    {
      "section_id": "section-00045",
      "start_time": 389.84,
      "end_time": 397.255,
      "transcript": "ਨਾਨਕ ਬੋਲੈ, ਸਹਜਿ ਸੁਭਾਇ"
    },
    {
      "section_id": "section-00046",
      "start_time": 404.765,
      "end_time": 412.065,
      "transcript": "ਚਾਰਿ ਪਦਾਰਥ, ਜੇ ਕੋ ਮਾਗੈ"
    },
    {
      "section_id": "section-00047",
      "start_time": 412.065,
      "end_time": 419.52,
      "transcript": "ਸਾਧ ਜਨਾ ਕੀ, ਸੇਵਾ ਲਾਗੈ"
    },
    {
      "section_id": "section-00048",
      "start_time": 419.52,
      "end_time": 427.12,
      "transcript": "ਜੇ ਕੋ ਆਪੁਨਾ, ਦੂਖੁ ਮਿਟਾਵੈ"
    },
    {
      "section_id": "section-00049",
      "start_time": 427.12,
      "end_time": 434.315,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਰਿਦੈ ਸਦ ਗਾਵੈ"
    },
    {
      "section_id": "section-00050",
      "start_time": 434.315,
      "end_time": 441.8,
      "transcript": "ਜੇ ਕੋ, ਅਪੁਨੀ ਸੋਭਾ ਲੋਰੈ"
    },
    {
      "section_id": "section-00051",
      "start_time": 441.8,
      "end_time": 449.16,
      "transcript": "ਸਾਧਸੰਗਿ, ਇਹ ਹਉਮੈ ਛੋਰੈ"
    },
    {
      "section_id": "section-00052",
      "start_time": 449.16,
      "end_time": 456.265,
      "transcript": "ਜੇ ਕੋ, ਜਨਮ ਮਰਣ ਤੇ ਡਰੈ"
    },
    {
      "section_id": "section-00053",
      "start_time": 456.265,
      "end_time": 463.595,
      "transcript": "ਸਾਧ ਜਨਾ ਕੀ, ਸਰਨੀ ਪਰੈ"
    },
    {
      "section_id": "section-00054",
      "start_time": 463.595,
      "end_time": 470.915,
      "transcript": "ਜਿਸੁ ਜਨ ਕਉ, ਪ੍ਰਭ ਦਰਸ ਪਿਆਸਾ"
    },
    {
      "section_id": "section-00055",
      "start_time": 470.915,
      "end_time": 478.235,
      "transcript": "ਨਾਨਕ ਤਾ ਕੈ, ਬਲਿ ਬਲਿ ਜਾਸਾ"
    },
    {
      "section_id": "section-00056",
      "start_time": 485.695,
      "end_time": 492.975,
      "transcript": "ਸਗਲ ਪੁਰਖ ਮਹਿ, ਪੁਰਖੁ ਪ੍ਰਧਾਨੁ"
    },
    {
      "section_id": "section-00057",
      "start_time": 492.975,
      "end_time": 500.075,
      "transcript": "ਸਾਧਸੰਗਿ, ਜਾ ਕਾ ਮਿਟੈ ਅਭਿਮਾਨੁ"
    },
    {
      "section_id": "section-00058",
      "start_time": 500.565,
      "end_time": 507.77,
      "transcript": "ਆਪਸ ਕਉ, ਜੋ ਜਾਣੈ ਨੀਚਾ"
    },
    {
      "section_id": "section-00059",
      "start_time": 507.77,
      "end_time": 515.045,
      "transcript": "ਸੋਊ ਗਨੀਐ, ਸਭ ਤੇ ਊਚਾ"
    },
    {
      "section_id": "section-00060",
      "start_time": 515.045,
      "end_time": 522.385,
      "transcript": "ਜਾ ਕਾ ਮਨੁ, ਹੋਇ ਸਗਲ ਕੀ ਰੀਨਾ"
    },
    {
      "section_id": "section-00061",
      "start_time": 522.385,
      "end_time": 529.905,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਤਿਨਿ ਘਟਿ ਘਟਿ ਚੀਨਾ"
    },
    {
      "section_id": "section-00062",
      "start_time": 529.905,
      "end_time": 537.275,
      "transcript": "ਮਨ ਅਪੁਨੇ ਤੇ, ਬੁਰਾ ਮਿਟਾਨਾ"
    },
    {
      "section_id": "section-00063",
      "start_time": 537.275,
      "end_time": 544.37,
      "transcript": "ਪੇਖੈ ਸਗਲ ਸ੍ਰਿਸਟਿ, ਸਾਜਨਾ"
    },
    {
      "section_id": "section-00064",
      "start_time": 544.37,
      "end_time": 551.625,
      "transcript": "ਸੂਖ ਦੂਖ, ਜਨ ਸਮ ਦ੍ਰਿਸਟੇਤਾ"
    },
    {
      "section_id": "section-00065",
      "start_time": 551.625,
      "end_time": 559.145,
      "transcript": "ਨਾਨਕ, ਪਾਪ ਪੁੰਨ ਨਹੀ ਲੇਪਾ"
    },
    {
      "section_id": "section-00066",
      "start_time": 566.52,
      "end_time": 573.645,
      "transcript": "ਨਿਰਧਨ ਕਉ ਧਨੁ, ਤੇਰੋ ਨਾਉ"
    },
    {
      "section_id": "section-00067",
      "start_time": 573.645,
      "end_time": 580.745,
      "transcript": "ਨਿਥਾਵੇ ਕਉ, ਨਾਉ ਤੇਰਾ ਥਾਉ"
    },
    {
      "section_id": "section-00068",
      "start_time": 581.04,
      "end_time": 588.44,
      "transcript": "ਨਿਮਾਨੇ ਕਉ, ਪ੍ਰਭ ਤੇਰੋ ਮਾਨੁ"
    },
    {
      "section_id": "section-00069",
      "start_time": 588.44,
      "end_time": 595.775,
      "transcript": "ਸਗਲ ਘਟਾ ਕਉ, ਦੇਵਹੁ ਦਾਨੁ"
    },
    {
      "section_id": "section-00070",
      "start_time": 595.775,
      "end_time": 603.32,
      "transcript": "ਕਰਨ ਕਰਾਵਨਹਾਰ, ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00071",
      "start_time": 603.32,
      "end_time": 610.565,
      "transcript": "ਸਗਲ ਘਟਾ ਕੇ, ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00072",
      "start_time": 610.565,
      "end_time": 617.675,
      "transcript": "ਅਪਨੀ ਗਤਿ ਮਿਤਿ, ਜਾਨਹੁ ਆਪੇ"
    },
    {
      "section_id": "section-00073",
      "start_time": 618.085,
      "end_time": 625.375,
      "transcript": "ਆਪਨ ਸੰਗਿ, ਆਪਿ ਪ੍ਰਭ ਰਾਤੇ"
    },
    {
      "section_id": "section-00074",
      "start_time": 625.375,
      "end_time": 632.475,
      "transcript": "ਤੁਮ੍ਰੀ ਉਸਤਤਿ, ਤੁਮ ਤੇ ਹੋਇ"
    },
    {
      "section_id": "section-00075",
      "start_time": 632.475,
      "end_time": 639.925,
      "transcript": "ਨਾਨਕ, ਅਵਰੁ ਨ ਜਾਨਸਿ ਕੋਇ"
    },
    {
      "section_id": "section-00076",
      "start_time": 647.52,
      "end_time": 654.665,
      "transcript": "ਸਰਬ ਧਰਮ ਮਹਿ, ਸ੍ਰੇਸਟ ਧਰਮੁ"
    },
    {
      "section_id": "section-00077",
      "start_time": 654.665,
      "end_time": 662.01,
      "transcript": "ਹਰਿ ਕੋ ਨਾਮੁ ਜਪਿ, ਨਿਰਮਲ ਕਰਮੁ"
    },
    {
      "section_id": "section-00078",
      "start_time": 662.01,
      "end_time": 669.35,
      "transcript": "ਸਗਲ ਕ੍ਰਿਆ ਮਹਿ, ਊਤਮ ਕਿਰਿਆ"
    },
    {
      "section_id": "section-00079",
      "start_time": 669.35,
      "end_time": 676.66,
      "transcript": "ਸਾਧਸੰਗਿ, ਦੁਰਮਤਿ ਮਲੁ ਹਿਰਿਆ"
    },
    {
      "section_id": "section-00080",
      "start_time": 676.66,
      "end_time": 684.12,
      "transcript": "ਸਗਲ ਉਦਮ ਮਹਿ, ਉਦਮੁ ਭਲਾ"
    },
    {
      "section_id": "section-00081",
      "start_time": 684.12,
      "end_time": 691.385,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਜਪਹੁ ਜੀਅ ਸਦਾ"
    },
    {
      "section_id": "section-00082",
      "start_time": 691.385,
      "end_time": 698.48,
      "transcript": "ਸਗਲ ਬਾਨੀ ਮਹਿ, ਅੰਮ੍ਰਿਤ ਬਾਨੀ"
    },
    {
      "section_id": "section-00083",
      "start_time": 698.48,
      "end_time": 705.775,
      "transcript": "ਹਰਿ ਕੋ ਜਸੁ ਸੁਨਿ, ਰਸਨ ਬਖਾਨੀ"
    },
    {
      "section_id": "section-00084",
      "start_time": 705.775,
      "end_time": 713.075,
      "transcript": "ਸਗਲ ਥਾਨ ਤੇ, ਓਹੁ ਊਤਮ ਥਾਨੁ"
    },
    {
      "section_id": "section-00085",

{
  "audio_file": "0154 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.055,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.4,
      "end_time": 22.717,
      "transcript": "ਨਿਕਸੁ ਰੇ ਪੰਖੀ, ਸਿਮਰਿ ਹਰਿ ਪਾਂਖ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.717,
      "end_time": 30.555,
      "transcript": "ਮਿਲਿ ਸਾਧੂ ਸਰਣਿ ਗਹੁ ਪੂਰਨ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.555,
      "end_time": 38.005,
      "transcript": "ਰਾਮ ਰਤਨੁ ਹੀਅਰੇ ਸੰਗਿ ਰਾਖੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.802,
      "end_time": 53.433,
      "transcript": "ਭ੍ਰਮ ਕੀ ਕੂਈ ਤ੍ਰਿਸਨਾ ਰਸ ਪੰਕਜ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.433,
      "end_time": 60.745,
      "transcript": "ਅਤਿ ਤੀਖੵਣ ਮੋਹ ਕੀ ਫਾਸ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.32,
      "end_time": 68.455,
      "transcript": "ਕਾਟਨਹਾਰ ਜਗਤ ਗੁਰ ਗੋਬਿਦ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.96,
      "end_time": 76.361,
      "transcript": "ਚਰਨ ਕਮਲ ਤਾ ਕੇ ਕਰਹੁ ਨਿਵਾਸ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.361,
      "end_time": 83.735,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਗੋਬਿੰਦ ਪ੍ਰਭ ਪ੍ਰੀਤਮ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.135,
      "end_time": 91.405,
      "transcript": "ਦੀਨਾ ਨਾਥ ਸੁਨਹੁ ਅਰਦਾਸਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.92,
      "end_time": 99.145,
      "transcript": "ਕਰੁ ਗਹਿ ਲੇਹੁ ਨਾਨਕ ਕੇ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.435,
      "end_time": 106.765,
      "transcript": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਤੁਮਰੀ ਰਾਸਿ"
    }
  ]
}

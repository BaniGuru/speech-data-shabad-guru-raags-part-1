    },
    {
      "section_id": "section-00008",
      "start_time": 64.16,
      "end_time": 70.617,
      "transcript": "ਵਿਸਾਰੇਦੇ ਮਰਿ ਗਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.617,
      "end_time": 76.955,
      "transcript": "ਮਰਿ ਭਿ ਨ ਸਕਹਿ ਮੂਲਿ"
    },
    {

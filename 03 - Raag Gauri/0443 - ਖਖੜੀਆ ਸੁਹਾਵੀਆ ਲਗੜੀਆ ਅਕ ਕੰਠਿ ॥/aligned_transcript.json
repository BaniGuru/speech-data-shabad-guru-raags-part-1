    },
    {
      "section_id": "section-00013",
      "start_time": 102.36,
      "end_time": 110.485,
      "transcript": "ਸੁਖ ਨਿਧਾਨੁ ਪ੍ਰਭੁ ਏਕੁ ਹੈ, ਅਬਿਨਾਸੀ ਸੁਣਿਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 110.645,
      "end_time": 118.805,
      "transcript": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਪੂਰਿਆ, ਘਟਿ ਘਟਿ ਹਰਿ ਭਣਿਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 119.16,
      "end_time": 127.201,
      "transcript": "ਊਚ ਨੀਚ ਸਭ ਇਕ ਸਮਾਨਿ, ਕੀਟ ਹਸਤੀ ਬਣਿਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 127.201,
      "end_time": 135.475,
      "transcript": "ਮੀਤ ਸਖਾ ਸੁਤ ਬੰਧਿਪੋ ਸਭਿ ਤਿਸ ਦੇ ਜਣਿਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 135.475,
      "end_time": 143.522,
      "transcript": "ਤੁਸਿ ਨਾਨਕੁ ਦੇਵੈ ਜਿਸੁ ਨਾਮੁ, ਤਿਨਿ ਹਰਿ ਰੰਗੁ ਮਣਿਆ"
    },

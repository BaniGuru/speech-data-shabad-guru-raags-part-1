  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.076,
      "end_time": 7.185,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.52,
      "end_time": 21.145,
      "transcript": "ਜੀਅਰੇ, ਓਲਾ੍ ਨਾਮ ਕਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.6,
      "end_time": 28.325,
      "transcript": "ਅਵਰੁ ਜਿ ਕਰਨ ਕਰਾਵਨੋ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.68,
      "end_time": 36.125,
      "transcript": "ਤਿਨ ਮਹਿ ਭਉ ਹੈ ਜਾਮ ਕਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.12,
      "end_time": 50.277,
      "transcript": "ਅਵਰ ਜਤਨਿ, ਨਹੀ ਪਾਈਐ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.277,
      "end_time": 57.225,
      "transcript": "ਵਡੈ ਭਾਗਿ, ਹਰਿ ਧਿਆਈਐ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.575,
      "end_time": 64.494,
      "transcript": "ਲਾਖ ਹਿਕਮਤੀ, ਜਾਨੀਐ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.494,
      "end_time": 72.036,
      "transcript": "ਆਗੈ, ਤਿਲੁ ਨਹੀ ਮਾਨੀਐ"
    },
    {
      "section_id": "section-00009",
      "start_time": 78.825,
      "end_time": 86.274,
      "transcript": "ਅਹੰਬੁਧਿ, ਕਰਮ ਕਮਾਵਨੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 86.274,
      "end_time": 93.378,
      "transcript": "ਗ੍ਰਿਹ ਬਾਲੂ, ਨੀਰਿ ਬਹਾਵਨੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 93.378,
      "end_time": 100.505,
      "transcript": "ਪ੍ਰਭੁ ਕ੍ਰਿਪਾਲੁ, ਕਿਰਪਾ ਕਰੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 100.505,
      "end_time": 107.545,
      "transcript": "ਨਾਮੁ ਨਾਨਕ, ਸਾਧੂ ਸੰਗਿ ਮਿਲੈ"
    }
  ]
}

{
  "audio_file": "0239 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 7.485,
      "transcript": "ਕਬੀਰ ਜੀ ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.72,
      "end_time": 21.405,
      "transcript": "ਕਿਆ ਜਪੁ ਕਿਆ ਤਪੁ, ਕਿਆ ਬ੍ਰਤ ਪੂਜਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.895,
      "end_time": 29.0,
      "transcript": "ਜਾ ਕੈ ਰਿਦੈ, ਭਾਉ ਹੈ ਦੂਜਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.0,
      "end_time": 36.12,
      "transcript": "ਰੇ ਜਨ, ਮਨੁ ਮਾਧਉ ਸਿਉ ਲਾਈਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.12,
      "end_time": 43.255,
      "transcript": "ਚਤੁਰਾਈ, ਨ ਚਤੁਰਭੁਜੁ ਪਾਈਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.179,
      "end_time": 57.39,
      "transcript": "ਪਰਹਰੁ ਲੋਭੁ, ਅਰੁ ਲੋਕਾਚਾਰੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.39,
      "end_time": 64.68,
      "transcript": "ਪਰਹਰੁ, ਕਾਮੁ ਕ੍ਰੋਧੁ ਅਹੰਕਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.68,
      "end_time": 71.8,
      "transcript": "ਕਰਮ ਕਰਤ, ਬਧੇ ਅਹੰਮੇਵ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.8,
      "end_time": 78.88,
      "transcript": "ਮਿਲਿ ਪਾਥਰ ਕੀ, ਕਰਹੀ ਸੇਵ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.88,
      "end_time": 85.805,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਭਗਤਿ ਕਰਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.805,
      "end_time": 92.345,
      "transcript": "ਭੋਲੇ ਭਾਇ, ਮਿਲੇ ਰਘੁਰਾਇਆ"
    }
  ]
}

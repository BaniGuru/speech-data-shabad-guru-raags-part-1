{
  "audio_file": "0189 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 10.765,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00002",
      "start_time": 10.765,
      "end_time": 17.861,
      "transcript": "ਗਉੜੀ ਬਾਵਨ ਅਖਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.861,
      "end_time": 25.488,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.2,
      "end_time": 38.985,
      "transcript": "ਗੁਰਦੇਵ ਮਾਤਾ ਗੁਰਦੇਵ ਪਿਤਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.36,
      "end_time": 44.735,
      "transcript": "ਗੁਰਦੇਵ ਸੁਆਮੀ ਪਰਮੇਸੁਰਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.16,
      "end_time": 50.92,
      "transcript": "ਗੁਰਦੇਵ ਸਖਾ ਅਗਿਆਨ ਭੰਜਨੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.92,
      "end_time": 56.405,
      "transcript": "ਗੁਰਦੇਵ ਬੰਧਿਪ ਸਹੋਦਰਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 56.92,
      "end_time": 62.565,
      "transcript": "ਗੁਰਦੇਵ ਦਾਤਾ ਹਰਿ ਨਾਮੁ ਉਪਦੇਸੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 62.565,
      "end_time": 68.375,
      "transcript": "ਗੁਰਦੇਵ ਮੰਤੁ ਨਿਰੋਧਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.6,
      "end_time": 74.44,
      "transcript": "ਗੁਰਦੇਵ ਸਾਂਤਿ ਸਤਿ ਬੁਧਿ ਮੂਰਤਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 74.44,
      "end_time": 80.005,
      "transcript": "ਗੁਰਦੇਵ ਪਾਰਸ ਪਰਸ ਪਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 80.28,
      "end_time": 86.16,
      "transcript": "ਗੁਰਦੇਵ ਤੀਰਥੁ ਅੰਮ੍ਰਿਤ ਸਰੋਵਰੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 86.16,
      "end_time": 91.755,
      "transcript": "ਗੁਰ ਗਿਆਨ ਮਜਨੁ ਅਪਰੰਪਰਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 92.12,
      "end_time": 98.12,
      "transcript": "ਗੁਰਦੇਵ ਕਰਤਾ ਸਭਿ ਪਾਪ ਹਰਤਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 98.12,
      "end_time": 103.605,
      "transcript": "ਗੁਰਦੇਵ ਪਤਿਤ ਪਵਿਤ ਕਰਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 104.04,
      "end_time": 109.84,
      "transcript": "ਗੁਰਦੇਵ ਆਦਿ ਜੁਗਾਦਿ ਜੁਗੁ ਜੁਗੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 109.84,
      "end_time": 115.8,
      "transcript": "ਗੁਰਦੇਵ ਮੰਤੁ ਹਰਿ ਜਪਿ ਉਧਰਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 115.8,
      "end_time": 121.76,
      "transcript": "ਗੁਰਦੇਵ ਸੰਗਤਿ ਪ੍ਰਭ ਮੇਲਿ ਕਰਿ ਕਿਰਪਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 121.76,
      "end_time": 127.255,
      "transcript": "ਹਮ ਮੂੜ ਪਾਪੀ ਜਿਤੁ ਲਗਿ ਤਰਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 127.72,
      "end_time": 133.72,
      "transcript": "ਗੁਰਦੇਵ ਸਤਿਗੁਰੁ ਪਾਰਬ੍ਰਹਮੁ ਪਰਮੇਸਰੁ"
    },
    {
      "section_id": "section-00021",
      "start_time": 133.72,
      "end_time": 141.355,
      "transcript": "ਗੁਰਦੇਵ ਨਾਨਕ ਹਰਿ ਨਮਸਕਰਾ ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00022",
      "start_time": 142.845,
      "end_time": 148.225,
      "transcript": "ਆਪਹਿ ਕੀਆ ਕਰਾਇਆ"
    },
    {
      "section_id": "section-00023",
      "start_time": 148.715,
      "end_time": 154.055,
      "transcript": "ਆਪਹਿ ਕਰਨੈ ਜੋਗੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 154.64,
      "end_time": 160.6,
      "transcript": "ਨਾਨਕ ਏਕੋ ਰਵਿ ਰਹਿਆ"
    },
    {
      "section_id": "section-00025",
      "start_time": 160.6,
      "end_time": 168.215,
      "transcript": "ਦੂਸਰ ਹੋਆ ਨ ਹੋਗੁ ਪਉੜੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 177.68,
      "end_time": 185.385,
      "transcript": "ਓਅੰ ਸਾਧ ਸਤਿਗੁਰ, ਨਮਸਕਾਰੰ ਆਦਿ ਮਧਿ ਅੰਤਿ, ਨਿਰੰਕਾਰੰ"
    },
    {
      "section_id": "section-00027",
      "start_time": 185.385,
      "end_time": 193.15,
      "transcript": "ਆਪਹਿ ਸੁੰਨ, ਆਪਹਿ ਸੁਖ ਆਸਨ ਆਪਹਿ ਸੁਨਤ, ਆਪ ਹੀ ਜਾਸਨ"
    },
    {
      "section_id": "section-00028",
      "start_time": 193.15,
      "end_time": 201.285,
      "transcript": "ਆਪਨ ਆਪੁ, ਆਪਹਿ ਉਪਾਇਓ ਆਪਹਿ ਬਾਪ, ਆਪ ਹੀ ਮਾਇਓ"
    },
    {
      "section_id": "section-00029",
      "start_time": 201.285,
      "end_time": 209.16,
      "transcript": "ਆਪਹਿ ਸੂਖਮ, ਆਪਹਿ ਅਸਥੂਲਾ ਲਖੀ ਨ ਜਾਈ, ਨਾਨਕ ਲੀਲਾ"
    },
    {
      "section_id": "section-00030",
      "start_time": 209.16,
      "end_time": 219.405,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ਤੇਰੇ ਸੰਤਨ ਕੀ, ਮਨੁ ਹੋਇ ਰਵਾਲਾ ਰਹਾਉ"
    }
  ]
}

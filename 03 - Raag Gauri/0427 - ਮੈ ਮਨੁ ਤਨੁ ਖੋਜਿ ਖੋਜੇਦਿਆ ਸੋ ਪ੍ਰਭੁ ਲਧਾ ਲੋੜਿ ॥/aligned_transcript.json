{
  "audio_file": "0231 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.215,
      "end_time": 10.465,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 21.505,
      "end_time": 29.205,
      "transcript": "ਮੈ ਮਨੁ ਤਨੁ ਖੋਜਿ ਖੋਜੇਦਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 29.68,
      "end_time": 37.255,
      "transcript": "ਸੋ ਪ੍ਰਭੁ ਲਧਾ ਲੋੜਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 37.765,
      "end_time": 45.525,
      "transcript": "ਵਿਸਟੁ ਗੁਰੂ ਮੈ ਪਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.92,
      "end_time": 53.575,
      "transcript": "ਜਿਨਿ ਹਰਿ ਪ੍ਰਭੁ ਦਿਤਾ ਜੋੜਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.695,
      "end_time": 58.035,
      "transcript": "ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 65.995,
      "end_time": 73.615,
      "transcript": "ਮਾਇਆਧਾਰੀ, ਅਤਿ ਅੰਨਾ ਬੋਲਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.12,
      "end_time": 81.705,
      "transcript": "ਸਬਦੁ ਨ ਸੁਣਈ, ਬਹੁ ਰੋਲ ਘਚੋਲਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 82.16,
      "end_time": 89.775,
      "transcript": "ਗੁਰਮੁਖਿ ਜਾਪੈ, ਸਬਦਿ ਲਿਵ ਲਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.2,
      "end_time": 97.835,
      "transcript": "ਹਰਿ ਨਾਮੁ ਸੁਣਿ ਮੰਨੇ, ਹਰਿ ਨਾਮਿ ਸਮਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 98.135,
      "end_time": 105.695,
      "transcript": "ਜੋ ਤਿਸੁ ਭਾਵੈ, ਸੁ ਕਰੇ ਕਰਾਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.165,
      "end_time": 116.235,
      "transcript": "ਨਾਨਕ, ਵਜਦਾ ਜੰਤੁ ਵਜਾਇਆ ਪਉੜੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 121.6,
      "end_time": 130.44,
      "transcript": "ਤੂ ਕਰਤਾ ਸਭੁ ਕਿਛੁ ਜਾਣਦਾ, ਜੋ ਜੀਆ ਅੰਦਰਿ ਵਰਤੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 130.44,
      "end_time": 138.895,
      "transcript": "ਤੂ ਕਰਤਾ ਆਪਿ ਅਗਣਤੁ ਹੈ, ਸਭੁ ਜਗੁ ਵਿਚਿ ਗਣਤੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 139.4,
      "end_time": 147.665,
      "transcript": "ਸਭੁ ਕੀਤਾ ਤੇਰਾ ਵਰਤਦਾ, ਸਭ ਤੇਰੀ ਬਣਤੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 148.12,
      "end_time": 156.786,
      "transcript": "ਤੂ ਘਟਿ ਘਟਿ ਇਕੁ ਵਰਤਦਾ ਸਚੁ ਸਾਹਿਬ ਚਲਤੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 156.786,
      "end_time": 165.085,
      "transcript": "ਸਤਿਗੁਰ ਨੋ ਮਿਲੇ ਸੁ ਹਰਿ ਮਿਲੇ, ਨਾਹੀ ਕਿਸੈ ਪਰਤੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 165.52,
      "end_time": 175.235,
      "transcript": "ਸਤਿਗੁਰ ਨੋ ਮਿਲੇ ਸੁ ਹਰਿ ਮਿਲੇ, ਨਾਹੀ ਕਿਸੈ ਪਰਤੈ"
    }
  ]
}

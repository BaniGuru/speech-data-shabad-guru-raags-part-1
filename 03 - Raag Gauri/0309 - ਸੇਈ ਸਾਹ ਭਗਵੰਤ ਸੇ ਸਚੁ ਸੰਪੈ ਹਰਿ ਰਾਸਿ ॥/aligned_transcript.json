    {
      "section_id": "section-00002",
      "start_time": 17.4,
      "end_time": 23.125,
      "transcript": "ਸੇਈ ਸਾਹ ਭਗਵੰਤ ਸੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.125,
      "end_time": 28.675,
      "transcript": "ਸਚੁ ਸੰਪੈ ਹਰਿ ਰਾਸਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.205,
      "end_time": 34.675,
      "transcript": "ਨਾਨਕ ਸਚੁ ਸੁਚਿ ਪਾਈਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.2,
      "end_time": 42.815,
      "transcript": "ਤਿਹ ਸੰਤਨ ਕੈ ਪਾਸਿ ਪਵੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.265,
      "end_time": 60.01,
      "transcript": "ਸਸਾ, ਸਤਿ ਸਤਿ ਸਤਿ ਸੋਊ ਸਤਿ ਪੁਰਖ ਤੇ, ਭਿੰਨ ਨ ਕੋਊ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.01,
      "end_time": 67.865,
      "transcript": "ਸੋਊ ਸਰਨਿ ਪਰੈ, ਜਿਹ ਪਾਯੰ ਸਿਮਰਿ ਸਿਮਰਿ, ਗੁਨ ਗਾਇ ਸੁਨਾਯੰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.865,
      "end_time": 75.64,
      "transcript": "ਸੰਸੈ ਭਰਮੁ, ਨਹੀ ਕਛੁ ਬਿਆਪਤ ਪ੍ਰਗਟ ਪ੍ਰਤਾਪੁ, ਤਾਹੂ ਕੋ ਜਾਪਤ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.64,
      "end_time": 83.885,
      "transcript": "ਸੋ ਸਾਧੂ, ਇਹ ਪਹੁਚਨਹਾਰਾ ਨਾਨਕ, ਤਾ ਕੈ ਸਦ ਬਲਿਹਾਰਾ"
    }
  ]

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.185,
      "end_time": 11.195,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 17.095,
      "end_time": 22.865,
      "transcript": "ਰੋਸੁ ਨ ਕਾਹੂ ਸੰਗ ਕਰਹੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.045,
      "end_time": 28.535,
      "transcript": "ਆਪਨ ਆਪੁ ਬੀਚਾਰਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.055,
      "end_time": 34.965,
      "transcript": "ਹੋਇ ਨਿਮਾਨਾ ਜਗਿ ਰਹਹੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.965,
      "end_time": 40.615,
      "transcript": "ਨਾਨਕ ਨਦਰੀ ਪਾਰਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.04,
      "end_time": 42.545,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.12,
      "end_time": 59.88,
      "transcript": "ਰਾਰਾ, ਰੇਨ ਹੋਤ ਸਭ ਜਾ ਕੀ ਤਜਿ ਅਭਿਮਾਨੁ, ਛੁਟੈ ਤੇਰੀ ਬਾਕੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.88,
      "end_time": 67.655,
      "transcript": "ਰਣਿ ਦਰਗਹਿ, ਤਉ ਸੀਝਹਿ ਭਾਈ ਜਉ ਗੁਰਮੁਖਿ, ਰਾਮ ਨਾਮ ਲਿਵ ਲਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.655,
      "end_time": 75.48,
      "transcript": "ਰਹਤ ਰਹਤ, ਰਹਿ ਜਾਹਿ ਬਿਕਾਰਾ ਗੁਰ ਪੂਰੇ ਕੈ, ਸਬਦਿ ਅਪਾਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.48,
      "end_time": 83.725,
      "transcript": "ਰਾਤੇ ਰੰਗ, ਨਾਮ ਰਸ ਮਾਤੇ ਨਾਨਕ ਹਰਿ ਗੁਰ ਕੀਨੀ, ਦਾਤੇ"
    }
  ]
}

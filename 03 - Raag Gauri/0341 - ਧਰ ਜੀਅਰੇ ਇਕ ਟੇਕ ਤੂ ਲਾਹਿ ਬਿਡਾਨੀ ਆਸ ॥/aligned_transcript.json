  "audio_file": "0194 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.205,
      "end_time": 5.66,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.96,
      "end_time": 21.555,
      "transcript": "ਧਰ ਜੀਅਰੇ ਇਕ ਟੇਕ ਤੂ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.815,
      "end_time": 29.255,
      "transcript": "ਲਾਹਿ ਬਿਡਾਨੀ ਆਸ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.705,
      "end_time": 37.215,
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਧਿਆਈਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.64,
      "end_time": 48.765,
      "transcript": "ਕਾਰਜੁ ਆਵੈ ਰਾਸਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.6,
      "end_time": 61.905,
      "transcript": "ਧਧਾ ਧਾਵਤ ਤਉ ਮਿਟੈ, ਸੰਤਸੰਗਿ ਹੋਇ ਬਾਸੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.24,
      "end_time": 70.355,
      "transcript": "ਧੁਰ ਤੇ ਕਿਰਪਾ ਕਰਹੁ ਆਪਿ, ਤਉ ਹੋਇ ਮਨਹਿ ਪਰਗਾਸੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.88,
      "end_time": 75.12,
      "transcript": "ਧਨੁ ਸਾਚਾ, ਤੇਊ ਸਚ ਸਾਹਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.12,
      "end_time": 79.36,
      "transcript": "ਹਰਿ ਹਰਿ ਪੂੰਜੀ, ਨਾਮ ਬਿਸਾਹਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.36,
      "end_time": 83.575,
      "transcript": "ਧੀਰਜੁ ਜਸੁ ਸੋਭਾ, ਤਿਹ ਬਨਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.575,
      "end_time": 87.96,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਸ੍ਰਵਨ ਜਿਹ ਸੁਨਿਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.96,
      "end_time": 92.155,
      "transcript": "ਗੁਰਮੁਖਿ ਜਿਹ ਘਟਿ, ਰਹੇ ਸਮਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 92.155,
      "end_time": 97.045,
      "transcript": "ਨਾਨਕ ਤਿਹ ਜਨ, ਮਿਲੀ ਵਡਾਈ"
    }
  ]
}

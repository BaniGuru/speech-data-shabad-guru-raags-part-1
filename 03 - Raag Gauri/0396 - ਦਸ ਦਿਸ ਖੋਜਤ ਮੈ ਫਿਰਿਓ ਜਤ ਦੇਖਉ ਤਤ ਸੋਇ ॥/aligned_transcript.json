  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.285,
      "end_time": 5.935,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.655,
      "end_time": 20.125,
      "transcript": "ਦਸ ਦਿਸ ਖੋਜਤ ਮੈ ਫਿਰਿਓ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.125,
      "end_time": 26.435,
      "transcript": "ਜਤ ਦੇਖਉ ਤਤ ਸੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.76,
      "end_time": 32.735,
      "transcript": "ਮਨੁ ਬਸਿ ਆਵੈ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.105,
      "end_time": 43.045,
      "transcript": "ਜੇ ਪੂਰਨ ਕਿਰਪਾ ਹੋਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.605,
      "end_time": 56.86,
      "transcript": "ਦਸਮੀ ਦਸ ਦੁਆਰ, ਬਸਿ ਕੀਨੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.86,
      "end_time": 61.105,
      "transcript": "ਮਨਿ ਸੰਤੋਖੁ, ਨਾਮ ਜਪਿ ਲੀਨੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.105,
      "end_time": 65.28,
      "transcript": "ਕਰਨੀ ਸੁਨੀਐ, ਜਸੁ ਗੋਪਾਲ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.28,
      "end_time": 69.35,
      "transcript": "ਨੈਨੀ ਪੇਖਤ, ਸਾਧ ਦਇਆਲ"
    },
    {
      "section_id": "section-00010",
      "start_time": 69.35,
      "end_time": 73.58,
      "transcript": "ਰਸਨਾ ਗੁਨ ਗਾਵੈ, ਬੇਅੰਤ"
    },
    {
      "section_id": "section-00011",
      "start_time": 73.58,
      "end_time": 77.8,
      "transcript": "ਮਨ ਮਹਿ ਚਿਤਵੈ, ਪੂਰਨ ਭਗਵੰਤ"
    },
    {
      "section_id": "section-00012",
      "start_time": 77.8,
      "end_time": 86.023,
      "transcript": "ਹਸਤ ਚਰਨ, ਸੰਤ ਟਹਲ ਕਮਾਈਐ ਨਾਨਕ ਇਹੁ ਸੰਜਮੁ, ਪ੍ਰਭ ਕਿਰਪਾ ਪਾਈਐ"
    }
  ]
}

      "end_time": 4.797,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 21.28,
      "end_time": 28.655,
      "transcript": "ਨਰਕ ਘੋਰ ਬਹੁ ਦੁਖ ਘਣੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 28.92,
      "end_time": 36.585,
      "transcript": "ਅਕਿਰਤਘਣਾ ਕਾ ਥਾਨੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 37.08,
      "end_time": 44.565,
      "transcript": "ਤਿਨਿ ਪ੍ਰਭਿ ਮਾਰੇ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.0,
      "end_time": 52.185,
      "transcript": "ਹੋਇ ਹੋਇ ਮੁਏ ਹਰਾਮੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.68,
      "end_time": 56.855,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 64.56,
      "end_time": 71.875,
      "transcript": "ਅਵਖਧ ਸਭੇ ਕੀਤਿਅਨੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 72.36,
      "end_time": 79.725,
      "transcript": "ਨਿੰਦਕ ਕਾ ਦਾਰੂ ਨਾਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 80.165,
      "end_time": 87.525,
      "transcript": "ਆਪਿ ਭੁਲਾਏ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.88,
      "end_time": 95.255,
      "transcript": "ਪਚਿ ਪਚਿ ਜੋਨੀ ਪਾਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.84,
      "end_time": 108.07,
      "transcript": "ਪਉੜੀ ਪੰਜਵਾ ਤੁਸਿ ਦਿਤਾ ਪੂਰੈ ਸਤਿਗੁਰੂ, ਹਰਿ ਧਨੁ ਸਚੁ ਅਖੁਟੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 108.07,
      "end_time": 116.235,
      "transcript": "ਸਭਿ ਅੰਦੇਸੇ ਮਿਟਿ ਗਏ, ਜਮ ਕਾ ਭਉ ਛੁਟੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 116.6,
      "end_time": 124.735,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ ਬੁਰਿਆਈਅਾਂ, ਸੰਗਿ ਸਾਧੂ ਤੁਟੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 125.12,
      "end_time": 133.365,
      "transcript": "ਵਿਣੁ ਸਚੇ ਦੂਜਾ ਸੇਵਦੇ, ਹੁਇ ਮਰਸਨਿ ਬੁਟੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 133.6,
      "end_time": 142.993,
      "transcript": "ਨਾਨਕ ਕਉ ਗੁਰਿ ਬਖਸਿਆ, ਨਾਮੈ ਸੰਗਿ ਜੁਟੁ"
    }
  ]
}

{
  "audio_file": "0145 F Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 6.522,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.927,
      "end_time": 19.385,
      "transcript": "ਤੂੰ ਸਮਰਥੁ, ਤੂੰਹੈ ਮੇਰਾ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.655,
      "end_time": 25.992,
      "transcript": "ਸਭੁ ਕਿਛੁ ਤੁਮ ਤੇ, ਤੂੰ ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.992,
      "end_time": 32.485,
      "transcript": "ਪਾਰਬ੍ਰਹਮ, ਪੂਰਨ ਜਨ ਓਟ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.84,
      "end_time": 42.435,
      "transcript": "ਤੇਰੀ ਸਰਣਿ, ਉਧਰਹਿ ਜਨ ਕੋਟਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.815,
      "end_time": 55.24,
      "transcript": "ਜੇਤੇ ਜੀਅ, ਤੇਤੇ ਸਭਿ ਤੇਰੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.24,
      "end_time": 61.545,
      "transcript": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ, ਸੂਖ ਘਨੇਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.735,
      "end_time": 68.475,
      "transcript": "ਜੋ ਕਿਛੁ ਵਰਤੈ, ਸਭ ਤੇਰਾ ਭਾਣਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.475,
      "end_time": 74.475,
      "transcript": "ਹੁਕਮੁ ਬੂਝੈ, ਸੋ ਸਚਿ ਸਮਾਣਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.76,
      "end_time": 81.1,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਦੀਜੈ ਪ੍ਰਭ ਦਾਨੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.1,
      "end_time": 87.345,
      "transcript": "ਨਾਨਕ ਸਿਮਰੈ, ਨਾਮੁ ਨਿਧਾਨੁ"
    }
  ]
}

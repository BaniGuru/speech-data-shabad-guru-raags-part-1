{
  "audio_file": "0145 CPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.105,
      "end_time": 6.659,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.644,
      "end_time": 19.095,
      "transcript": "ਭੈ ਮਹਿ ਰਚਿਓ, ਸਭੁ ਸੰਸਾਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.095,
      "end_time": 25.64,
      "transcript": "ਤਿਸੁ ਭਉ ਨਾਹੀ, ਜਿਸੁ ਨਾਮੁ ਅਧਾਰਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.64,
      "end_time": 31.845,
      "transcript": "ਭਉ ਨ ਵਿਆਪੈ, ਤੇਰੀ ਸਰਣਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.16,
      "end_time": 41.705,
      "transcript": "ਜੋ ਤੁਧੁ ਭਾਵੈ, ਸੋਈ ਕਰਣਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.115,
      "end_time": 54.315,
      "transcript": "ਸੋਗ ਹਰਖ ਮਹਿ, ਆਵਣ ਜਾਣਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.68,
      "end_time": 61.14,
      "transcript": "ਤਿਨਿ ਸੁਖੁ ਪਾਇਆ, ਜੋ ਪ੍ਰਭ ਭਾਣਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.14,
      "end_time": 67.505,
      "transcript": "ਅਗਨਿ ਸਾਗਰੁ, ਮਹਾ ਵਿਆਪੈ ਮਾਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.505,
      "end_time": 74.005,
      "transcript": "ਸੇ ਸੀਤਲ, ਜਿਨ ਸਤਿਗੁਰੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.005,
      "end_time": 80.72,
      "transcript": "ਰਾਖਿ ਲੇਇ ਪ੍ਰਭੁ ਰਾਖਨਹਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.72,
      "end_time": 86.815,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਕਿਆ ਜੰਤ ਵਿਚਾਰਾ"
    }
  ]
}

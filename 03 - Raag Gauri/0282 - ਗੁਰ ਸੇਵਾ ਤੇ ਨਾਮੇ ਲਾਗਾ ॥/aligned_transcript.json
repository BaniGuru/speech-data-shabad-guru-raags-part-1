{
  "audio_file": "0179 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.065,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.475,
      "end_time": 21.91,
      "transcript": "ਗੁਰ ਸੇਵਾ ਤੇ ਨਾਮੇ ਲਾਗਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.91,
      "end_time": 29.28,
      "transcript": "ਤਿਸ ਕਉ ਮਿਲਿਆ, ਜਿਸੁ ਮਸਤਕਿ ਭਾਗਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.28,
      "end_time": 36.64,
      "transcript": "ਤਿਸ ਕੈ ਹਿਰਦੈ, ਰਵਿਆ ਸੋਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.64,
      "end_time": 43.905,
      "transcript": "ਮਨੁ ਤਨੁ ਸੀਤਲੁ, ਨਿਹਚਲੁ ਹੋਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.905,
      "end_time": 51.36,
      "transcript": "ਐਸਾ ਕੀਰਤਨੁ, ਕਰਿ ਮਨ ਮੇਰੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.36,
      "end_time": 58.775,
      "transcript": "ਈਹਾ ਊਹਾ, ਜੋ ਕਾਮਿ ਤੇਰੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.56,
      "end_time": 84.765,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਭਉ ਅਪਦਾ ਜਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.765,
      "end_time": 92.12,
      "transcript": "ਧਾਵਤ ਮਨੂਆ, ਆਵੈ ਠਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.12,
      "end_time": 99.66,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਫਿਰਿ ਦੂਖੁ ਨ ਲਾਗੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 99.66,
      "end_time": 106.91,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਇਹ ਹਉਮੈ ਭਾਗੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.91,
      "end_time": 114.205,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਵਸਿ ਆਵਹਿ ਪੰਚਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.205,
      "end_time": 121.505,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਰਿਦੈ ਅੰਮ੍ਰਿਤੁ ਸੰਚਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 121.505,
      "end_time": 128.255,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਇਹ ਤ੍ਰਿਸਨਾ ਬੁਝੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 129.08,
      "end_time": 135.805,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਹਰਿ ਦਰਗਹ ਸਿਝੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 136.4,
      "end_time": 143.415,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਕੋਟਿ ਮਿਟਹਿ ਅਪਰਾਧ"
    },
    {
      "section_id": "section-00017",
      "start_time": 143.775,
      "end_time": 150.675,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਹਰਿ ਹੋਵਹਿ ਸਾਧ"
    },
    {
      "section_id": "section-00018",
      "start_time": 151.16,
      "end_time": 158.5,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਮਨੁ ਸੀਤਲੁ ਹੋਵੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 158.5,
      "end_time": 165.915,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਮਲੁ ਸਗਲੀ ਖੋਵੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 173.505,
      "end_time": 180.415,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਰਤਨੁ ਹਰਿ ਮਿਲੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 180.925,
      "end_time": 187.905,
      "transcript": "ਬਹੁਰਿ ਨ ਛੋਡੈ, ਹਰਿ ਸੰਗਿ ਹਿਲੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 188.395,
      "end_time": 195.74,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਕਈ ਬੈਕੁੰਠ ਵਾਸੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 195.74,
      "end_time": 203.165,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਸੁਖ ਸਹਜਿ ਨਿਵਾਸੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 210.725,
      "end_time": 218.275,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਇਹ ਅਗਨਿ ਨ ਪੋਹਤ"
    },
    {
      "section_id": "section-00025",
      "start_time": 218.275,
      "end_time": 225.76,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਇਹੁ ਕਾਲੁ ਨ ਜੋਹਤ"
    },
    {
      "section_id": "section-00026",
      "start_time": 225.76,
      "end_time": 233.115,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਤੇਰਾ ਨਿਰਮਲ ਮਾਥਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 233.115,
      "end_time": 240.605,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਸਗਲਾ ਦੁਖੁ ਲਾਥਾ"
    },
    {
      "section_id": "section-00028",
      "start_time": 240.605,
      "end_time": 247.625,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਮੁਸਕਲੁ ਕਛੂ ਨ ਬਨੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 248.12,
      "end_time": 255.025,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਸੁਣਿ ਅਨਹਤ ਧੁਨੈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 255.415,
      "end_time": 262.325,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਇਹ ਨਿਰਮਲ ਸੋਇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 262.84,
      "end_time": 270.17,
      "transcript": "ਜਾਸੁ ਜਪਤ, ਕਮਲੁ ਸੀਧਾ ਹੋਇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 270.17,
      "end_time": 277.295,
      "transcript": "ਗੁਰਿ ਸੁਭ ਦ੍ਰਿਸਟਿ, ਸਭ ਊਪਰਿ ਕਰੀ"
    },
    {
      "section_id": "section-00033",
      "start_time": 277.6,
      "end_time": 284.78,
      "transcript": "ਜਿਸ ਕੈ ਹਿਰਦੈ, ਮੰਤ੍ਰੁ ਦੇ ਹਰੀ"
    },
    {
      "section_id": "section-00034",
      "start_time": 284.78,
      "end_time": 292.127,
      "transcript": "ਅਖੰਡ ਕੀਰਤਨੁ ਤਿਨਿ ਭੋਜਨੁ ਚੂਰਾ"
    },
    {
      "section_id": "section-00035",
      "start_time": 292.127,
      "end_time": 299.239,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਿਸੁ ਸਤਿਗੁਰੁ ਪੂਰਾ"
    },
    {
      "section_id": "section-00036",
      "start_time": 299.239,
      "end_time": 306.732,
      "transcript": "ਅਖੰਡ ਕੀਰਤਨੁ ਤਿਨਿ ਭੋਜਨੁ ਚੂਰਾ"
    },
    {
      "section_id": "section-00037",
      "start_time": 307.095,
      "end_time": 314.835,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਿਸੁ ਸਤਿਗੁਰੁ ਪੂਰਾ"
    }
  ]
}

{
  "audio_file": "0133 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.106,
      "end_time": 17.32,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 35.2,
      "end_time": 42.866,
      "transcript": "ਕਿਉ ਭ੍ਰਮੀਐ ਭ੍ਰਮੁ ਕਿਸ ਕਾ ਹੋਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 42.866,
      "end_time": 50.87,
      "transcript": "ਜਾ ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ, ਰਵਿਆ ਸੋਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 50.87,
      "end_time": 58.495,
      "transcript": "ਗੁਰਮੁਖਿ ਉਬਰੇ, ਮਨਮੁਖ ਪਤਿ ਖੋਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 58.495,
      "end_time": 66.52,
      "transcript": "ਜਿਸੁ ਰਾਖੈ ਆਪਿ, ਰਾਮੁ ਦਇਆਰਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 66.52,
      "end_time": 78.157,
      "transcript": "ਤਿਸੁ ਨਹੀ ਦੂਜਾ ਕੋ ਪਹੁਚਨਹਾਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 89.645,
      "end_time": 97.599,
      "transcript": "ਸਭ ਮਹਿ ਵਰਤੈ, ਏਕੁ ਅਨੰਤਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 97.599,
      "end_time": 105.61,
      "transcript": "ਤਾ ਤੂੰ ਸੁਖਿ ਸੋਉ, ਹੋਇ ਅਚਿੰਤਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 105.61,
      "end_time": 113.32,
      "transcript": "ਓਹੁ ਸਭੁ ਕਿਛੁ ਜਾਣੈ, ਜੋ ਵਰਤੰਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 113.44,
      "end_time": 121.24,
      "transcript": "ਮਨਮੁਖ ਮੁਏ ਜਿਨ ਦੂਜੀ ਪਿਆਸਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 121.24,
      "end_time": 129.0,
      "transcript": "ਬਹੁ ਜੋਨੀ ਭਵਹਿ, ਧੁਰਿ ਕਿਰਤਿ ਲਿਖਿਆਸਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 129.0,
      "end_time": 136.497,
      "transcript": "ਜੈਸਾ ਬੀਜਹਿ, ਤੈਸਾ ਖਾਸਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 136.497,
      "end_time": 144.2,
      "transcript": "ਦੇਖਿ ਦਰਸੁ, ਮਨਿ ਭਇਆ ਵਿਗਾਸਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 144.2,
      "end_time": 151.96,
      "transcript": "ਸਭੁ ਨਦਰੀ ਆਇਆ, ਬ੍ਰਹਮੁ ਪਰਗਾਸਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 151.96,
      "end_time": 159.51,
      "transcript": "ਜਨ ਨਾਨਕ ਕੀ, ਹਰਿ ਪੂਰਨ ਆਸਾ"
    }
  ]
}

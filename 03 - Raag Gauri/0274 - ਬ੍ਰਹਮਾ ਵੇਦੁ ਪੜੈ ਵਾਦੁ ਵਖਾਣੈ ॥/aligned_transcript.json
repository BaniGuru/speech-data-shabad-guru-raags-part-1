{
  "audio_file": "0175 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 6.756,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.72,
      "end_time": 19.085,
      "transcript": "ਬ੍ਰਹਮਾ ਵੇਦੁ ਪੜੈ, ਵਾਦੁ ਵਖਾਣੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.085,
      "end_time": 25.48,
      "transcript": "ਅੰਤਰਿ ਤਾਮਸੁ, ਆਪੁ ਨ ਪਛਾਣੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.48,
      "end_time": 31.65,
      "transcript": "ਤਾ ਪ੍ਰਭੁ ਪਾਏ, ਗੁਰਸਬਦੁ ਵਖਾਣੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.65,
      "end_time": 38.0,
      "transcript": "ਗੁਰ ਸੇਵਾ ਕਰਉ, ਫਿਰਿ ਕਾਲੁ ਨ ਖਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 38.0,
      "end_time": 47.584,
      "transcript": "ਮਨਮੁਖ ਖਾਧੇ, ਦੂਜੈ ਭਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.765,
      "end_time": 60.28,
      "transcript": "ਗੁਰਮੁਖਿ ਪ੍ਰਾਣੀ, ਅਪਰਾਧੀ ਸੀਧੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.28,
      "end_time": 66.64,
      "transcript": "ਗੁਰ ਕੈ ਸਬਦਿ, ਅੰਤਰਿ ਸਹਜਿ ਰੀਧੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.64,
      "end_time": 72.88,
      "transcript": "ਮੇਰਾ ਪ੍ਰਭੁ ਪਾਇਆ, ਗੁਰ ਕੈ ਸਬਦਿ ਸੀਧੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 72.88,
      "end_time": 79.11,
      "transcript": "ਸਤਿਗੁਰਿ ਮੇਲੇ, ਪ੍ਰਭਿ ਆਪਿ ਮਿਲਾਏ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.11,
      "end_time": 85.48,
      "transcript": "ਮੇਰੇ ਪ੍ਰਭ ਸਾਚੇ ਕੈ, ਮਨਿ ਭਾਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 85.48,
      "end_time": 91.71,
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਵਹਿ, ਸਹਜਿ ਸੁਭਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 91.71,
      "end_time": 98.0,
      "transcript": "ਬਿਨੁ ਗੁਰ ਸਾਚੇ, ਭਰਮਿ ਭੁਲਾਏ"
    },
    {
      "section_id": "section-00014",
      "start_time": 98.0,
      "end_time": 104.56,
      "transcript": "ਮਨਮੁਖ ਅੰਧੇ, ਸਦਾ ਬਿਖੁ ਖਾਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 104.56,
      "end_time": 110.84,
      "transcript": "ਜਮ ਡੰਡੁ ਸਹਹਿ, ਸਦਾ ਦੁਖੁ ਪਾਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 110.84,
      "end_time": 117.155,
      "transcript": "ਜਮੂਆ ਨ ਜੋਹੈ, ਹਰਿ ਕੀ ਸਰਣਾਈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 117.155,
      "end_time": 123.405,
      "transcript": "ਹਉਮੈ ਮਾਰਿ, ਸਚਿ ਲਿਵ ਲਾਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 123.405,
      "end_time": 129.76,
      "transcript": "ਸਦਾ ਰਹੈ, ਹਰਿ ਨਾਮਿ ਲਿਵ ਲਾਈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 129.76,
      "end_time": 135.745,
      "transcript": "ਸਤਿਗੁਰੁ ਸੇਵਹਿ, ਸੇ ਜਨ ਨਿਰਮਲ ਪਵਿਤਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 136.04,
      "end_time": 142.367,
      "transcript": "ਮਨ ਸਿਉ ਮਨੁ ਮਿਲਾਇ, ਸਭੁ ਜਗੁ ਜੀਤਾ"
    },
    {
      "section_id": "section-00021",
      "start_time": 142.367,
      "end_time": 148.615,
      "transcript": "ਇਨ ਬਿਧਿ ਕੁਸਲੁ ਤੇਰੈ, ਮੇਰੇ ਮੀਤਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 148.615,
      "end_time": 155.0,
      "transcript": "ਸਤਿਗੁਰੂ ਸੇਵੇ, ਸੋ ਫਲੁ ਪਾਏ"
    },
    {
      "section_id": "section-00023",
      "start_time": 155.0,
      "end_time": 161.28,
      "transcript": "ਹਿਰਦੈ ਨਾਮੁ, ਵਿਚਹੁ ਆਪੁ ਗਵਾਏ"
    },
    {
      "section_id": "section-00024",
      "start_time": 161.28,
      "end_time": 167.545,
      "transcript": "ਅਨਹਦ ਬਾਣੀ, ਸਬਦੁ ਵਜਾਏ"
    },
    {
      "section_id": "section-00025",
      "start_time": 167.545,
      "end_time": 173.96,
      "transcript": "ਸਤਿਗੁਰ ਤੇ, ਕਵਨੁ ਕਵਨੁ ਨ ਸੀਧੋ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 173.96,
      "end_time": 180.13,
      "transcript": "ਭਗਤੀ ਸੀਧੇ, ਦਰਿ ਸੋਭਾ ਪਾਈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 180.13,
      "end_time": 186.473,
      "transcript": "ਨਾਨਕ, ਰਾਮ ਨਾਮਿ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 186.473,
      "end_time": 192.6,
      "transcript": "ਭਗਤੀ ਸੀਧੇ, ਦਰਿ ਸੋਭਾ ਪਾਈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 192.6,
      "end_time": 199.295,
      "transcript": "ਨਾਨਕ, ਰਾਮ ਨਾਮਿ ਵਡਿਆਈ"
    }
  ]
}

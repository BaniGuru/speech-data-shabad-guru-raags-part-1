  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.685,
      "end_time": 11.745,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.92,
      "end_time": 17.87,
      "transcript": "ਤਿੰਨਾ ਭੁਖ ਨ ਕਾ ਰਹੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.87,
      "end_time": 23.845,
      "transcript": "ਜਿਸ ਦਾ ਪ੍ਰਭੁ ਹੈ ਸੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.845,
      "end_time": 29.595,
      "transcript": "ਨਾਨਕ ਚਰਣੀ ਲਗਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.96,
      "end_time": 35.74,
      "transcript": "ਉਧਰੈ ਸਭੋ ਕੋਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 35.74,
      "end_time": 38.995,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 38.995,
      "end_time": 44.92,
      "transcript": "ਜਾਚਿਕੁ ਮੰਗੈ ਨਿਤ ਨਾਮੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 44.92,
      "end_time": 50.542,
      "transcript": "ਸਾਹਿਬੁ ਕਰੇ ਕਬੂਲੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 50.542,
      "end_time": 56.83,
      "transcript": "ਨਾਨਕ ਪਰਮੇਸਰੁ ਜਜਮਾਨੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 56.83,
      "end_time": 62.415,
      "transcript": "ਤਿਸਹਿ ਭੁਖ ਨ ਮੂਲਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 62.88,
      "end_time": 64.605,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 74.0,
      "end_time": 81.805,
      "transcript": "ਮਨੁ ਰਤਾ ਗੋਵਿੰਦ ਸੰਗਿ, ਸਚੁ ਭੋਜਨੁ ਜੋੜੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 81.805,
      "end_time": 89.72,
      "transcript": "ਪ੍ਰੀਤਿ ਲਗੀ ਹਰਿ ਨਾਮ ਸਿਉ, ਏ ਹਸਤੀ ਘੋੜੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 89.72,
      "end_time": 97.56,
      "transcript": "ਰਾਜ ਮਿਲਖ ਖੁਸੀਆ ਘਣੀ, ਧਿਆਇ ਮੁਖੁ ਨ ਮੋੜੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 97.56,
      "end_time": 105.365,
      "transcript": "ਢਾਢੀ ਦਰਿ ਪ੍ਰਭ ਮੰਗਣਾ, ਦਰੁ ਕਦੇ ਨ ਛੋੜੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 105.365,
      "end_time": 113.812,
      "transcript": "ਨਾਨਕ ਮਨਿ ਤਨਿ ਚਾਉ ਏਹੁ, ਨਿਤ ਪ੍ਰਭ ਕਉ ਲੋੜੇ"
    }
  ]
}

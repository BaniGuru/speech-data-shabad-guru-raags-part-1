{
  "audio_file": "0223 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.24,
      "end_time": 6.756,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.4,
      "end_time": 22.775,
      "transcript": "ਚਾਰਿ ਕੁੰਟ ਚਉਦਹ ਭਵਨ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.48,
      "end_time": 31.025,
      "transcript": "ਸਗਲ ਬਿਆਪਤ ਰਾਮ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.545,
      "end_time": 39.245,
      "transcript": "ਨਾਨਕ ਊਨ ਨ ਦੇਖੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.665,
      "end_time": 49.965,
      "transcript": "ਪੂਰਨ ਤਾ ਕੇ ਕਾਮ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 54.705,
      "end_time": 59.44,
      "transcript": "ਚਉਦਹਿ, ਚਾਰਿ ਕੁੰਟ ਪ੍ਰਭ ਆਪ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.44,
      "end_time": 63.96,
      "transcript": "ਸਗਲ ਭਵਨ, ਪੂਰਨ ਪਰਤਾਪ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.96,
      "end_time": 68.4,
      "transcript": "ਦਸੇ ਦਿਸਾ, ਰਵਿਆ ਪ੍ਰਭੁ ਏਕੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.4,
      "end_time": 72.79,
      "transcript": "ਧਰਨਿ ਅਕਾਸ, ਸਭ ਮਹਿ ਪ੍ਰਭ ਪੇਖੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 72.79,
      "end_time": 77.08,
      "transcript": "ਜਲ ਥਲ ਬਨ, ਪਰਬਤ ਪਾਤਾਲ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.08,
      "end_time": 81.71,
      "transcript": "ਪਰਮੇਸ੍ਵਰ, ਤਹ ਬਸਹਿ ਦਇਆਲ"
    },
    {
      "section_id": "section-00012",
      "start_time": 81.71,
      "end_time": 86.155,
      "transcript": "ਸੂਖਮ ਅਸਥੂਲ, ਸਗਲ ਭਗਵਾਨ"
    },
    {
      "section_id": "section-00013",
      "start_time": 86.155,
      "end_time": 92.607,
      "transcript": "ਨਾਨਕ, ਗੁਰਮੁਖਿ ਬ੍ਰਹਮੁ ਪਛਾਨ"
    }
  ]
}

{
  "audio_file": "0191 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.28,
      "end_time": 5.659,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 5.659,
      "end_time": 13.705,
      "transcript": "ਖਾਤ ਖਰਚਤ ਬਿਲਛਤ ਰਹੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 13.705,
      "end_time": 21.155,
      "transcript": "ਟੂਟਿ ਨ ਜਾਹਿ ਭੰਡਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.155,
      "end_time": 28.491,
      "transcript": "ਹਰਿ ਹਰਿ ਜਪਤ ਅਨੇਕ ਜਨ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.491,
      "end_time": 36.785,
      "transcript": "ਨਾਨਕ ਨਾਹਿ ਸੁਮਾਰ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.72,
      "end_time": 50.495,
      "transcript": "ਖਖਾ ਖੂਨਾ ਕਛੁ ਨਹੀ, ਤਿਸੁ ਸੰਮ੍ਰਥ ਕੈ ਪਾਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.84,
      "end_time": 59.124,
      "transcript": "ਜੋ ਦੇਨਾ ਸੋ ਦੇ ਰਹਿਓ, ਭਾਵੈ ਤਹ ਤਹ ਜਾਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.124,
      "end_time": 67.687,
      "transcript": "ਖਰਚੁ ਖਜਾਨਾ ਨਾਮ ਧਨੁ, ਇਆ ਭਗਤਨ ਕੀ ਰਾਸਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.687,
      "end_time": 76.095,
      "transcript": "ਖਿਮਾ ਗਰੀਬੀ ਅਨਦ ਸਹਜ, ਜਪਤ ਰਹਹਿ ਗੁਣਤਾਸ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.32,
      "end_time": 84.583,
      "transcript": "ਖੇਲਹਿ ਬਿਗਸਹਿ ਅਨਦ ਸਿਉ, ਜਾ ਕਉ ਹੋਤ ਕ੍ਰਿਪਾਲ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.583,
      "end_time": 92.803,
      "transcript": "ਸਦੀਵ ਗਨੀਵ ਸੁਹਾਵਨੇ, ਰਾਮ ਨਾਮ ਗ੍ਰਿਹਿ ਮਾਲ"
    },
    {
      "section_id": "section-00012",
      "start_time": 92.803,
      "end_time": 100.965,
      "transcript": "ਖੇਦੁ ਨ ਦੂਖੁ ਨ ਡਾਨੁ ਤਿਹ, ਜਾ ਕਉ ਨਦਰਿ ਕਰੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 101.24,
      "end_time": 110.807,
      "transcript": "ਨਾਨਕ ਜੋ ਪ੍ਰਭ ਭਾਣਿਆ, ਪੂਰੀ ਤਿਨਾ ਪਰੀ"
    }
  ]
}

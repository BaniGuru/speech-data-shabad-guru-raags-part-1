{
  "audio_file": "0194 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.175,
      "end_time": 4.495,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.825,
      "end_time": 20.37,
      "transcript": "ਫਾਹੇ ਕਾਟੇ ਮਿਟੇ ਗਵਨ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.37,
      "end_time": 27.985,
      "transcript": "ਫਤਿਹ ਭਈ ਮਨਿ ਜੀਤ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.425,
      "end_time": 36.08,
      "transcript": "ਨਾਨਕ ਗੁਰ ਤੇ ਥਿਤ ਪਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.08,
      "end_time": 47.985,
      "transcript": "ਫਿਰਨ ਮਿਟੇ ਨਿਤ ਨੀਤ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.591,
      "end_time": 55.92,
      "transcript": "ਫਫਾ, ਫਿਰਤ ਫਿਰਤ ਤੂ ਆਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.92,
      "end_time": 60.2,
      "transcript": "ਦ੍ਰੁਲਭ ਦੇਹ, ਕਲਿਜੁਗ ਮਹਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.2,
      "end_time": 64.355,
      "transcript": "ਫਿਰਿ ਇਆ ਅਉਸਰੁ, ਚਰੈ ਨ ਹਾਥਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.355,
      "end_time": 68.56,
      "transcript": "ਨਾਮੁ ਜਪਹੁ, ਤਉ ਕਟੀਅਹਿ ਫਾਸਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.56,
      "end_time": 72.76,
      "transcript": "ਫਿਰਿ ਫਿਰਿ ਆਵਨ ਜਾਨੁ, ਨ ਹੋਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 72.76,
      "end_time": 77.0,
      "transcript": "ਏਕਹਿ ਏਕ, ਜਪਹੁ ਜਪੁ ਸੋਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 77.0,
      "end_time": 81.165,
      "transcript": "ਕਰਹੁ ਕ੍ਰਿਪਾ ਪ੍ਰਭ, ਕਰਨੈਹਾਰੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 81.165,
      "end_time": 86.065,
      "transcript": "ਮੇਲਿ ਲੇਹੁ, ਨਾਨਕ ਬੇਚਾਰੇ"
    }
  ]
}

{
  "audio_file": "0171 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 8.425,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 17.04,
      "end_time": 25.64,
      "transcript": "ਹਠੁ ਕਰਿ ਮਰੈ, ਨ ਲੇਖੈ ਪਾਵੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.64,
      "end_time": 33.915,
      "transcript": "ਵੇਸ ਕਰੈ, ਬਹੁ ਭਸਮ ਲਗਾਵੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.915,
      "end_time": 42.32,
      "transcript": "ਨਾਮੁ ਬਿਸਾਰਿ, ਬਹੁਰਿ ਪਛੁਤਾਵੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.32,
      "end_time": 50.512,
      "transcript": "ਤੂੰ ਮਨਿ ਹਰਿ ਜੀਉ, ਤੂੰ ਮਨਿ ਸੂਖ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.512,
      "end_time": 63.741,
      "transcript": "ਨਾਮੁ ਬਿਸਾਰਿ, ਸਹਹਿ ਜਮ ਦੂਖ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.155,
      "end_time": 75.675,
      "transcript": "ਚੋਆ ਚੰਦਨ, ਅਗਰ ਕਪੂਰਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.675,
      "end_time": 83.735,
      "transcript": "ਮਾਇਆ ਮਗਨੁ, ਪਰਮ ਪਦੁ ਦੂਰਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.295,
      "end_time": 92.596,
      "transcript": "ਨਾਮਿ ਬਿਸਾਰਿਐ, ਸਭੁ ਕੂੜੋ ਕੂਰਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.596,
      "end_time": 101.245,
      "transcript": "ਨੇਜੇ ਵਾਜੇ, ਤਖਤਿ ਸਲਾਮੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 101.245,
      "end_time": 109.465,
      "transcript": "ਅਧਕੀ ਤ੍ਰਿਸਨਾ, ਵਿਆਪੈ ਕਾਮੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 109.465,
      "end_time": 118.151,
      "transcript": "ਬਿਨੁ ਹਰਿ ਜਾਚੇ, ਭਗਤਿ ਨ ਨਾਮੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 118.151,
      "end_time": 126.535,
      "transcript": "ਵਾਦਿ ਅਹੰਕਾਰਿ, ਨਾਹੀ ਪ੍ਰਭ ਮੇਲਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 126.755,
      "end_time": 134.945,
      "transcript": "ਮਨੁ ਦੇ, ਪਾਵਹਿ ਨਾਮੁ ਸੁਹੇਲਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 135.36,
      "end_time": 144.057,
      "transcript": "ਦੂਜੈ ਭਾਇ, ਅਗਿਆਨੁ ਦੁਹੇਲਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 152.44,
      "end_time": 160.698,
      "transcript": "ਬਿਨੁ ਦਮ ਕੇ, ਸਉਦਾ ਨਹੀ ਹਾਟ"
    },
    {
      "section_id": "section-00017",
      "start_time": 160.698,
      "end_time": 169.308,
      "transcript": "ਬਿਨੁ ਬੋਹਿਥ, ਸਾਗਰ ਨਹੀ ਵਾਟ"
    },
    {
      "section_id": "section-00018",
      "start_time": 169.308,
      "end_time": 178.004,
      "transcript": "ਬਿਨੁ ਗੁਰ ਸੇਵੇ, ਘਾਟੇ ਘਾਟਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 178.004,
      "end_time": 186.319,
      "transcript": "ਤਿਸ ਕਉ ਵਾਹੁ ਵਾਹੁ ਜਿ ਵਾਟ ਦਿਖਾਵੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 186.319,
      "end_time": 195.0,
      "transcript": "ਤਿਸ ਕਉ ਵਾਹੁ ਵਾਹੁ ਜਿ ਸਬਦੁ ਸੁਣਾਵੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 195.0,
      "end_time": 203.445,
      "transcript": "ਤਿਸ ਕਉ ਵਾਹੁ ਵਾਹੁ, ਜਿ ਮੇਲਿ ਮਿਲਾਵੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 203.445,
      "end_time": 211.874,
      "transcript": "ਵਾਹੁ ਵਾਹੁ ਤਿਸ ਕਉ, ਜਿਸ ਕਾ ਇਹੁ ਜੀਉ"
    },
    {
      "section_id": "section-00023",
      "start_time": 211.874,
      "end_time": 220.246,
      "transcript": "ਗੁਰਸਬਦੀ ਮਥਿ, ਅੰਮ੍ਰਿਤੁ ਪੀਉ"
    },
    {
      "section_id": "section-00024",
      "start_time": 220.246,
      "end_time": 228.65,
      "transcript": "ਨਾਮ ਵਡਾਈ, ਤੁਧੁ ਭਾਣੈ ਦੀਉ"
    },
    {
      "section_id": "section-00025",
      "start_time": 228.65,
      "end_time": 237.32,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਕਿਉ ਜੀਵਾ ਮਾਇ"
    },
    {
      "section_id": "section-00026",
      "start_time": 237.32,
      "end_time": 245.115,
      "transcript": "ਅਨਦਿਨੁ ਜਪਤੁ ਰਹਉ, ਤੇਰੀ ਸਰਣਾਇ"
    },
    {
      "section_id": "section-00027",
      "start_time": 245.635,
      "end_time": 253.645,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ, ਪਤਿ ਪਾਇ"
    }
  ]
}

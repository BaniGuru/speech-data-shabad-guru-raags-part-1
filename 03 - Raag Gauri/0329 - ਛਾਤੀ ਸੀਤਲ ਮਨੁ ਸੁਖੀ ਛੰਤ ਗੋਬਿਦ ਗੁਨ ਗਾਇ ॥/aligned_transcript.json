  "audio_file": "0192 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.144,
      "end_time": 2.16,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.44,
      "end_time": 15.935,
      "transcript": "ਛਾਤੀ ਸੀਤਲ ਮਨੁ ਸੁਖੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.48,
      "end_time": 23.008,
      "transcript": "ਛੰਤ ਗੋਬਿਦ ਗੁਨ ਗਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.008,
      "end_time": 30.266,
      "transcript": "ਐਸੀ ਕਿਰਪਾ ਕਰਹੁ ਪ੍ਰਭ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.266,
      "end_time": 38.995,
      "transcript": "ਨਾਨਕ ਦਾਸ ਦਸਾਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.089,
      "end_time": 49.635,
      "transcript": "ਛਛਾ, ਛੋਹਰੇ ਦਾਸ ਤੁਮਾਰੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.635,
      "end_time": 54.075,
      "transcript": "ਦਾਸ ਦਾਸਨ ਕੇ, ਪਾਨੀਹਾਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 54.075,
      "end_time": 58.76,
      "transcript": "ਛਛਾ ਛਾਰੁ ਹੋਤ, ਤੇਰੇ ਸੰਤਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 58.76,
      "end_time": 63.005,
      "transcript": "ਅਪਨੀ ਕ੍ਰਿਪਾ ਕਰਹੁ, ਭਗਵੰਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 63.005,
      "end_time": 67.36,
      "transcript": "ਛਾਡਿ ਸਿਆਨਪ, ਬਹੁ ਚਤੁਰਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 67.36,
      "end_time": 71.535,
      "transcript": "ਸੰਤਨ ਕੀ, ਮਨ ਟੇਕ ਟਿਕਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 71.535,
      "end_time": 75.76,
      "transcript": "ਛਾਰੁ ਕੀ ਪੁਤਰੀ, ਪਰਮ ਗਤਿ ਪਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 75.76,
      "end_time": 80.895,
      "transcript": "ਨਾਨਕ, ਜਾ ਕਉ ਸੰਤ ਸਹਾਈ"
    }
  ]
}

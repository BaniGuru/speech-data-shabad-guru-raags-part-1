  "audio_file": "0196 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.355,
      "end_time": 6.745,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.235,
      "end_time": 20.661,
      "transcript": "ਲੇਖੈ ਕਤਹਿ ਨ ਛੂਟੀਐ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.661,
      "end_time": 27.175,
      "transcript": "ਖਿਨੁ ਖਿਨੁ ਭੂਲਨਹਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.56,
      "end_time": 33.745,
      "transcript": "ਬਖਸਨਹਾਰ ਬਖਸਿ ਲੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.115,
      "end_time": 40.345,
      "transcript": "ਨਾਨਕ ਪਾਰਿ ਉਤਾਰ"
    },
    {
      "section_id": "section-00006",
      "start_time": 40.72,
      "end_time": 44.768,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.24,
      "end_time": 61.653,
      "transcript": "ਲੂਣ ਹਰਾਮੀ ਗੁਨਹਗਾਰ, ਬੇਗਾਨਾ ਅਲਪ ਮਤਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.653,
      "end_time": 70.398,
      "transcript": "ਜੀਉ ਪਿੰਡੁ ਜਿਨਿ ਸੁਖ ਦੀਏ, ਤਾਹਿ ਨ ਜਾਨਤ ਤਤ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.398,
      "end_time": 78.655,
      "transcript": "ਲਾਹਾ ਮਾਇਆ ਕਾਰਨੇ, ਦਹ ਦਿਸਿ ਢੂਢਨ ਜਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.885,
      "end_time": 87.305,
      "transcript": "ਦੇਵਨਹਾਰ ਦਾਤਾਰ ਪ੍ਰਭ, ਨਿਮਖ ਨ ਮਨਹਿ ਬਸਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.565,
      "end_time": 95.945,
      "transcript": "ਲਾਲਚ ਝੂਠ ਬਿਕਾਰ ਮੋਹ, ਇਆ ਸੰਪੈ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 95.945,
      "end_time": 104.72,
      "transcript": "ਲੰਪਟ ਚੋਰ ਨਿੰਦਕ ਮਹਾ, ਤਿਨਹੂ ਸੰਗਿ ਬਿਹਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 104.72,
      "end_time": 112.905,
      "transcript": "ਤੁਧੁ ਭਾਵੈ ਤਾ ਬਖਸਿ ਲੈਹਿ, ਖੋਟੇ ਸੰਗਿ ਖਰੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 113.135,
      "end_time": 122.763,
      "transcript": "ਨਾਨਕ ਭਾਵੈ ਪਾਰਬ੍ਰਹਮ, ਪਾਹਨ ਨੀਰਿ ਤਰੇ"
    }
  ]
}

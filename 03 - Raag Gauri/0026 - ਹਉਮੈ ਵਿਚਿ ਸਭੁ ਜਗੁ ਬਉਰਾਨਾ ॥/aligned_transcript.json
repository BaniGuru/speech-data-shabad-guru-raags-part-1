{
  "audio_file": "0121 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.592,
      "end_time": 14.702,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.702,
      "end_time": 26.707,
      "transcript": "ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.88,
      "end_time": 45.4,
      "transcript": "ਹਉਮੈ ਵਿਚਿ ਸਭੁ ਜਗੁ ਬਉਰਾਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.4,
      "end_time": 52.575,
      "transcript": "ਦੂਜੈ ਭਾਇ ਭਰਮਿ ਭੁਲਾਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.575,
      "end_time": 60.0,
      "transcript": "ਬਹੁ ਚਿੰਤਾ ਚਿਤਵੈ, ਆਪੁ ਨ ਪਛਾਨਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 60.0,
      "end_time": 67.28,
      "transcript": "ਧੰਧਾ ਕਰਤਿਆ, ਅਨਦਿਨੁ ਵਿਹਾਨਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.28,
      "end_time": 74.276,
      "transcript": "ਹਿਰਦੈ ਰਾਮੁ ਰਮਹੁ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.276,
      "end_time": 85.021,
      "transcript": "ਗੁਰਮੁਖਿ ਰਸਨਾ ਹਰਿ ਰਸਨ ਰਸਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 88.48,
      "end_time": 95.64,
      "transcript": "ਗੁਰਮੁਖਿ ਹਿਰਦੈ, ਜਿਨਿ ਰਾਮੁ ਪਛਾਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 95.64,
      "end_time": 102.812,
      "transcript": "ਜਗਜੀਵਨੁ ਸੇਵਿ, ਜੁਗ ਚਾਰੇ ਜਾਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 102.812,
      "end_time": 109.92,
      "transcript": "ਹਉਮੈ ਮਾਰਿ, ਗੁਰ ਸਬਦਿ ਪਛਾਤਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 109.92,
      "end_time": 116.92,
      "transcript": "ਕ੍ਰਿਪਾ ਕਰੇ, ਪ੍ਰਭ ਕਰਮ ਬਿਧਾਤਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 116.92,
      "end_time": 123.996,
      "transcript": "ਸੇ ਜਨ ਸਚੇ, ਜੋ ਗੁਰ ਸਬਦਿ ਮਿਲਾਏ"
    },
    {
      "section_id": "section-00014",
      "start_time": 123.996,
      "end_time": 130.917,
      "transcript": "ਧਾਵਤ ਵਰਜੇ, ਠਾਕਿ ਰਹਾਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 130.917,
      "end_time": 137.738,
      "transcript": "ਨਾਮੁ ਨਵ ਨਿਧਿ, ਗੁਰ ਤੇ ਪਾਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 137.738,
      "end_time": 144.573,
      "transcript": "ਹਰਿ ਕਿਰਪਾ ਤੇ, ਹਰਿ ਵਸੈ ਮਨਿ ਆਏ"
    },
    {
      "section_id": "section-00017",
      "start_time": 144.573,
      "end_time": 151.8,
      "transcript": "ਰਾਮ ਰਾਮ ਕਰਤਿਆ, ਸੁਖੁ ਸਾਂਤਿ ਸਰੀਰ"
    },
    {
      "section_id": "section-00018",
      "start_time": 151.8,
      "end_time": 158.613,
      "transcript": "ਅੰਤਰਿ ਵਸੈ, ਨ ਲਾਗੈ ਜਮ ਪੀਰ"
    },
    {
      "section_id": "section-00019",
      "start_time": 158.613,
      "end_time": 165.489,
      "transcript": "ਆਪੇ ਸਾਹਿਬੁ, ਆਪਿ ਵਜੀਰ"
    },
    {
      "section_id": "section-00020",
      "start_time": 165.489,
      "end_time": 171.55,
      "transcript": "ਨਾਨਕ ਸੇਵਿ ਸਦਾ, ਹਰਿ ਗੁਣੀ ਗਹੀਰ"
    }
  ]
}

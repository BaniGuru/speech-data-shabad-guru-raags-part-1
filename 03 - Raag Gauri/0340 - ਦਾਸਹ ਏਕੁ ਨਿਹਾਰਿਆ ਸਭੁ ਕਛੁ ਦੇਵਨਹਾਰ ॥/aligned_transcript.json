{
  "audio_file": "0194 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.28,
      "end_time": 6.378,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.575,
      "end_time": 25.475,
      "transcript": "ਦਾਸਹ ਏਕੁ ਨਿਹਾਰਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.04,
      "end_time": 34.385,
      "transcript": "ਸਭੁ ਕਛੁ ਦੇਵਨਹਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.0,
      "end_time": 43.448,
      "transcript": "ਸਾਸਿ ਸਾਸਿ ਸਿਮਰਤ ਰਹਹਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.448,
      "end_time": 56.796,
      "transcript": "ਨਾਨਕ ਦਰਸ ਅਧਾਰ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 61.295,
      "end_time": 70.572,
      "transcript": "ਦਦਾ ਦਾਤਾ ਏਕੁ ਹੈ, ਸਭ ਕਉ ਦੇਵਨਹਾਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.572,
      "end_time": 79.505,
      "transcript": "ਦੇਂਦੇ ਤੋਟਿ ਨ ਆਵਈ, ਅਗਨਤ ਭਰੇ ਭੰਡਾਰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 79.775,
      "end_time": 84.48,
      "transcript": "ਦੈਨਹਾਰੁ, ਸਦ ਜੀਵਨਹਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.48,
      "end_time": 89.12,
      "transcript": "ਮਨ ਮੂਰਖ, ਕਿਉ ਤਾਹਿ ਬਿਸਾਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 89.12,
      "end_time": 93.525,
      "transcript": "ਦੋਸੁ ਨਹੀ, ਕਾਹੂ ਕਉ ਮੀਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 93.525,
      "end_time": 98.04,
      "transcript": "ਮਾਇਆ ਮੋਹ, ਬੰਧੁ ਪ੍ਰਭਿ ਕੀਤਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 98.04,
      "end_time": 102.465,
      "transcript": "ਦਰਦ ਨਿਵਾਰਹਿ ਜਾ ਕੇ ਆਪੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 102.465,
      "end_time": 107.785,
      "transcript": "ਨਾਨਕ, ਤੇ ਤੇ ਗੁਰਮੁਖਿ ਧ੍ਰਾਪੇ"
    }
  ]
}

{
  "audio_file": "0176 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.475,
      "end_time": 15.57,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 27.6,
      "end_time": 35.165,
      "transcript": "ਤ੍ਰੈ ਗੁਣ ਵਖਾਣੈ, ਭਰਮੁ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 35.165,
      "end_time": 43.24,
      "transcript": "ਬੰਧਨ ਨ ਤੂਟਹਿ, ਮੁਕਤਿ ਨ ਪਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 43.24,
      "end_time": 50.793,
      "transcript": "ਮੁਕਤਿ ਦਾਤਾ ਸਤਿਗੁਰੁ, ਜੁਗ ਮਾਹਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 50.793,
      "end_time": 58.84,
      "transcript": "ਗੁਰਮੁਖਿ ਪ੍ਰਾਣੀ, ਭਰਮੁ ਗਵਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.84,
      "end_time": 66.845,
      "transcript": "ਸਹਜ ਧੁਨਿ ਉਪਜੈ, ਹਰਿ ਲਿਵ ਲਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 73.976,
      "end_time": 81.88,
      "transcript": "ਤ੍ਰੈ ਗੁਣ, ਕਾਲੈ ਕੀ ਸਿਰਿ ਕਾਰਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 81.88,
      "end_time": 89.26,
      "transcript": "ਨਾਮੁ ਨ ਚੇਤਹਿ, ਉਪਾਵਣਹਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 89.26,
      "end_time": 97.165,
      "transcript": "ਮਰਿ ਜੰਮਹਿ, ਫਿਰਿ ਵਾਰੋ ਵਾਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 97.165,
      "end_time": 104.695,
      "transcript": "ਅੰਧੇ ਗੁਰੂ ਤੇ, ਭਰਮੁ ਨ ਜਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.695,
      "end_time": 112.455,
      "transcript": "ਮੂਲੁ ਛੋਡਿ, ਲਾਗੇ ਦੂਜੈ ਭਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 112.455,
      "end_time": 119.997,
      "transcript": "ਬਿਖੁ ਕਾ ਮਾਤਾ, ਬਿਖੁ ਮਾਹਿ ਸਮਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 119.997,
      "end_time": 127.88,
      "transcript": "ਮਾਇਆ ਕਰਿ, ਮੂਲੁ ਜੰਤ੍ਰ ਭਰਮਾਏ"
    },
    {
      "section_id": "section-00014",
      "start_time": 127.88,
      "end_time": 135.56,
      "transcript": "ਹਰਿ ਜੀਉ ਵਿਸਰਿਆ, ਦੂਜੈ ਭਾਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 135.56,
      "end_time": 143.034,
      "transcript": "ਜਿਸੁ ਨਦਰਿ ਕਰੇ, ਸੋ ਪਰਮ ਗਤਿ ਪਾਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 143.034,
      "end_time": 150.96,
      "transcript": "ਅੰਤਰਿ ਸਾਚੁ, ਬਾਹਰਿ ਸਾਚੁ ਵਰਤਾਏ"
    },
    {
      "section_id": "section-00017",
      "start_time": 150.96,
      "end_time": 158.392,
      "transcript": "ਸਾਚੁ ਨ ਛਪੈ, ਜੇ ਕੋ ਰਖੈ ਛਪਾਏ"
    },
    {
      "section_id": "section-00018",
      "start_time": 158.392,
      "end_time": 166.345,
      "transcript": "ਗਿਆਨੀ ਬੂਝਹਿ, ਸਹਜਿ ਸੁਭਾਏ"
    },
    {
      "section_id": "section-00019",
      "start_time": 166.345,
      "end_time": 173.725,
      "transcript": "ਗੁਰਮੁਖਿ, ਸਾਚਿ ਰਹਿਆ ਲਿਵ ਲਾਏ"
    },
    {
      "section_id": "section-00020",
      "start_time": 174.16,
      "end_time": 181.285,
      "transcript": "ਹਉਮੈ ਮਾਇਆ, ਸਬਦਿ ਜਲਾਏ"
    },
    {
      "section_id": "section-00021",
      "start_time": 181.615,
      "end_time": 189.255,
      "transcript": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਾਚਾ, ਮੇਲਿ ਮਿਲਾਏ"
    },
    {
      "section_id": "section-00022",
      "start_time": 189.255,
      "end_time": 196.705,
      "transcript": "ਸਤਿਗੁਰੁ ਦਾਤਾ, ਸਬਦੁ ਸੁਣਾਏ"
    },
    {
      "section_id": "section-00023",
      "start_time": 197.135,
      "end_time": 204.445,
      "transcript": "ਧਾਵਤੁ ਰਾਖੈ, ਠਾਕਿ ਰਹਾਏ"
    },
    {
      "section_id": "section-00024",
      "start_time": 205.0,
      "end_time": 212.369,
      "transcript": "ਪੂਰੇ ਗੁਰ ਤੇ, ਸੋਝੀ ਪਾਏ"
    },
    {
      "section_id": "section-00025",
      "start_time": 220.335,
      "end_time": 227.84,
      "transcript": "ਆਪੇ ਕਰਤਾ, ਸ੍ਰਿਸਟਿ ਸਿਰਜਿ ਜਿਨਿ ਗੋਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 227.84,
      "end_time": 235.055,
      "transcript": "ਤਿਸੁ ਬਿਨੁ ਦੂਜਾ, ਅਵਰੁ ਨ ਕੋਈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 235.395,
      "end_time": 242.605,
      "transcript": "ਨਾਨਕ, ਗੁਰਮੁਖਿ ਬੂਝੈ ਕੋਈ"
    }
  ]
}

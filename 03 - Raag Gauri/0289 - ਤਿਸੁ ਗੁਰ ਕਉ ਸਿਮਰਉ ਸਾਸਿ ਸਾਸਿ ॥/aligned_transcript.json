{
  "audio_file": "0182 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.309,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.6,
      "end_time": 21.455,
      "transcript": "ਤਿਸੁ ਗੁਰ ਕਉ, ਸਿਮਰਉ ਸਾਸਿ ਸਾਸਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.455,
      "end_time": 29.133,
      "transcript": "ਗੁਰੁ ਮੇਰੇ ਪ੍ਰਾਣ, ਸਤਿਗੁਰੁ ਮੇਰੀ ਰਾਸਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 39.8,
      "end_time": 46.825,
      "transcript": "ਗੁਰ ਕਾ ਦਰਸਨੁ, ਦੇਖਿ ਦੇਖਿ ਜੀਵਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.825,
      "end_time": 53.935,
      "transcript": "ਗੁਰ ਕੇ ਚਰਣ, ਧੋਇ ਧੋਇ ਪੀਵਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.935,
      "end_time": 61.156,
      "transcript": "ਗੁਰ ਕੀ ਰੇਣੁ, ਨਿਤ ਮਜਨੁ ਕਰਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.156,
      "end_time": 67.915,
      "transcript": "ਜਨਮ ਜਨਮ ਕੀ, ਹਉਮੈ ਮਲੁ ਹਰਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.44,
      "end_time": 75.6,
      "transcript": "ਤਿਸੁ ਗੁਰ ਕਉ, ਝੂਲਾਵਉ ਪਾਖਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.6,
      "end_time": 82.76,
      "transcript": "ਮਹਾ ਅਗਨਿ ਤੇ, ਹਾਥੁ ਦੇ ਰਾਖਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.76,
      "end_time": 89.84,
      "transcript": "ਤਿਸੁ ਗੁਰ ਕੈ ਗ੍ਰਿਹਿ, ਢੋਵਉ ਪਾਣੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 89.84,
      "end_time": 96.935,
      "transcript": "ਜਿਸੁ ਗੁਰ ਤੇ, ਅਕਲ ਗਤਿ ਜਾਣੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 96.935,
      "end_time": 103.674,
      "transcript": "ਤਿਸੁ ਗੁਰ ਕੈ ਗ੍ਰਿਹਿ, ਪੀਸਉ ਨੀਤ"
    },
    {
      "section_id": "section-00013",
      "start_time": 103.674,
      "end_time": 111.101,
      "transcript": "ਜਿਸੁ ਪਰਸਾਦਿ, ਵੈਰੀ ਸਭ ਮੀਤ"
    },
    {
      "section_id": "section-00014",
      "start_time": 118.28,
      "end_time": 124.925,
      "transcript": "ਜਿਨਿ ਗੁਰਿ, ਮੋ ਕਉ ਦੀਨਾ ਜੀਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 125.265,
      "end_time": 132.385,
      "transcript": "ਆਪੁਨਾ ਦਾਸਰਾ, ਆਪੇ ਮੁਲਿ ਲੀਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 132.385,
      "end_time": 139.435,
      "transcript": "ਆਪੇ ਲਾਇਓ, ਅਪਨਾ ਪਿਆਰੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 139.435,
      "end_time": 146.6,
      "transcript": "ਸਦਾ ਸਦਾ ਤਿਸੁ ਗੁਰ ਕਉ, ਕਰੀ ਨਮਸਕਾਰੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 146.6,
      "end_time": 153.675,
      "transcript": "ਕਲਿ ਕਲੇਸ, ਭੈ ਭ੍ਰਮ ਦੁਖ ਲਾਥਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 153.675,
      "end_time": 160.125,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਮੇਰਾ ਗੁਰੁ ਸਮਰਾਥਾ"
    }
  ]
}

      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.12,
      "end_time": 32.835,
      "transcript": "ਸਤਿਗੁਰ ਵਿਚਿ ਵਡੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.64,
      "end_time": 40.165,
      "transcript": "ਜੋ ਅਨਦਿਨੁ ਹਰਿ ਹਰਿ ਨਾਮੁ ਧਿਆਵੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 41.12,
      "end_time": 48.59,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਰਮਤ ਸੁਚ ਸੰਜਮੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.59,
      "end_time": 55.285,
      "transcript": "ਹਰਿ ਨਾਮੇ ਹੀ ਤ੍ਰਿਪਤਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.96,
      "end_time": 63.385,
      "transcript": "ਹਰਿ ਨਾਮੁ ਤਾਣੁ ਹਰਿ ਨਾਮੁ ਦੀਬਾਣੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.385,
      "end_time": 69.795,
      "transcript": "ਹਰਿ ਨਾਮੋ ਰਖ ਕਰਾਵੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.8,
      "end_time": 78.16,
      "transcript": "ਜੋ ਚਿਤੁ ਲਾਇ ਪੂਜੇ ਗੁਰ ਮੂਰਤਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.16,
      "end_time": 84.655,
      "transcript": "ਸੋ ਮਨ ਇਛੇ ਫਲ ਪਾਵੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.44,
      "end_time": 92.635,
      "transcript": "ਜੋ ਨਿੰਦਾ ਕਰੇ ਸਤਿਗੁਰ ਪੂਰੇ ਕੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 92.72,
      "end_time": 99.235,
      "transcript": "ਤਿਸੁ ਕਰਤਾ ਮਾਰ ਦਿਵਾਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 100.08,
      "end_time": 107.36,
      "transcript": "ਫੇਰਿ ਓਹ ਵੇਲਾ ਓਸੁ ਹਥਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 107.36,
      "end_time": 114.585,
      "transcript": "ਓਹੁ ਆਪਣਾ ਬੀਜਿਆ ਆਪੇ ਖਾਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 114.585,
      "end_time": 122.01,
      "transcript": "ਨਰਕਿ ਘੋਰਿ ਮੁਹਿ ਕਾਲੈ ਖੜਿਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 122.01,
      "end_time": 128.465,
      "transcript": "ਜਿਉ ਤਸਕਰੁ ਪਾਇ ਗਲਾਵੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 129.36,
      "end_time": 136.715,
      "transcript": "ਫਿਰਿ ਸਤਿਗੁਰ ਕੀ ਸਰਣੀ ਪਵੈ ਤਾ ਉਬਰੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 136.715,
      "end_time": 143.015,
      "transcript": "ਜਾ ਹਰਿ ਹਰਿ ਨਾਮੁ ਧਿਆਵੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 143.96,
      "end_time": 150.812,
      "transcript": "ਹਰਿ ਬਾਤਾ ਆਖਿ ਸੁਣਾਏ"
    },
    {
      "section_id": "section-00020",
      "start_time": 150.812,
      "end_time": 157.955,
      "transcript": "ਨਾਨਕੁ ਹਰਿ ਕਰਤੇ ਏਵੈ ਭਾਵੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 158.435,
      "end_time": 162.77,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 169.84,
      "end_time": 177.135,
      "transcript": "ਪੂਰੇ ਗੁਰ ਕਾ ਹੁਕਮੁ ਨ ਮੰਨੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 177.135,
      "end_time": 184.495,
      "transcript": "ਓਹੁ ਮਨਮੁਖੁ ਅਗਿਆਨੁ ਮੁਠਾ ਬਿਖੁ ਮਾਇਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 184.495,
      "end_time": 191.165,
      "transcript": "ਓਸੁ ਅੰਦਰਿ ਕੂੜੁ ਕੂੜੋ ਕਰਿ ਬੁਝੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 191.84,
      "end_time": 199.12,
      "transcript": "ਅਣਹੋਦੇ ਝਗੜੇ ਦਯਿ ਓਸ ਦੈ ਗਲਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00026",
      "start_time": 199.12,
      "end_time": 206.44,
      "transcript": "ਓਹੁ ਗਲ ਫਰੋਸੀ ਕਰੇ ਬਹੁਤੇਰੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 206.44,
      "end_time": 213.755,
      "transcript": "ਓਸ ਦਾ ਬੋਲਿਆ ਕਿਸੈ ਨ ਭਾਇਆ"
    },
    {
      "section_id": "section-00028",
      "start_time": 213.755,
      "end_time": 221.2,
      "transcript": "ਓਹੁ ਘਰਿ ਘਰਿ ਹੰਢੈ ਜਿਉ ਰੰਨ ਦੁੋਹਾਗਣਿ"
    },
    {
      "section_id": "section-00029",
      "start_time": 221.2,
      "end_time": 228.4,
      "transcript": "ਓਸੁ ਨਾਲਿ ਮੁਹੁ ਜੋੜੇ ਓਸੁ ਭੀ ਲਛਣੁ ਲਾਇਆ"
    },
    {
      "section_id": "section-00030",
      "start_time": 228.4,
      "end_time": 235.79,
      "transcript": "ਗੁਰਮੁਖਿ ਹੋਇ ਸੁ ਅਲਿਪਤੋ ਵਰਤੈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 235.79,
      "end_time": 242.305,
      "transcript": "ਓਸ ਦਾ ਪਾਸੁ ਛਡਿ ਗੁਰ ਪਾਸਿ ਬਹਿ ਜਾਇਆ"
    },
    {
      "section_id": "section-00032",
      "start_time": 243.16,
      "end_time": 250.405,
      "transcript": "ਜੋ ਗੁਰੁ ਗੋਪੇ ਆਪਣਾ ਸੁ ਭਲਾ ਨਾਹੀ ਪੰਚਹੁ"
    },
    {
      "section_id": "section-00033",
      "start_time": 250.405,
      "end_time": 256.735,
      "transcript": "ਓਨਿ ਲਾਹਾ ਮੂਲੁ ਸਭੁ ਗਵਾਇਆ"
    },
    {
      "section_id": "section-00034",
      "start_time": 257.64,
      "end_time": 264.895,
      "transcript": "ਪਹਿਲਾ ਆਗਮੁ ਨਿਗਮੁ ਨਾਨਕੁ ਆਖਿ ਸੁਣਾਏ"
    },
    {
      "section_id": "section-00035",
      "start_time": 264.895,
      "end_time": 272.17,
      "transcript": "ਪੂਰੇ ਗੁਰ ਕਾ ਬਚਨੁ ਉਪਰਿ ਆਇਆ"
    },
    {
      "section_id": "section-00036",
      "start_time": 272.17,
      "end_time": 279.56,
      "transcript": "ਗੁਰਸਿਖਾ ਵਡਿਆਈ ਭਾਵੈ ਗੁਰ ਪੂਰੇ ਕੀ"
    },
    {
      "section_id": "section-00037",
      "start_time": 279.56,
      "end_time": 288.425,
      "transcript": "ਮਨਮੁਖਾ ਓਹ ਵੇਲਾ ਹਥਿ ਨ ਆਇਆ ਪਉੜੀ"
    },
    {
      "section_id": "section-00038",
      "start_time": 289.16,
      "end_time": 297.365,
      "transcript": "ਸਚੁ ਸਚਾ ਸਭ ਦੂ ਵਡਾ ਹੈ, ਸੋ ਲਏ ਜਿਸੁ ਸਤਿਗੁਰੁ ਟਿਕੇ"
    },
    {
      "section_id": "section-00039",
      "start_time": 297.365,
      "end_time": 305.185,
      "transcript": "ਸੋ ਸਤਿਗੁਰੁ ਜਿ ਸਚੁ ਧਿਆਇਦਾ, ਸਚੁ ਸਚਾ ਸਤਿਗੁਰੁ ਇਕੇ"
    },
    {
      "section_id": "section-00040",
      "start_time": 305.64,
      "end_time": 313.52,
      "transcript": "ਸੋਈ ਸਤਿਗੁਰੁ ਪੁਰਖੁ ਹੈ, ਜਿਨਿ ਪੰਜੇ ਦੂਤ ਕੀਤੇ ਵਸਿ ਛਿਕੇ"
    },
    {
      "section_id": "section-00041",
      "start_time": 313.52,
      "end_time": 321.345,
      "transcript": "ਜਿ ਬਿਨੁ ਸਤਿਗੁਰ ਸੇਵੇ ਆਪੁ ਗਣਾਇਦੇ, ਤਿਨ ਅੰਦਰਿ ਕੂੜੁ ਫਿਟੁ ਫਿਟੁ ਮੁਹ ਫਿਕੇ"
    },
    {
      "section_id": "section-00042",
      "start_time": 321.345,
      "end_time": 332.811,
      "transcript": "ਓਇ ਬੋਲੇ ਕਿਸੈ ਨ ਭਾਵਨੀ, ਮੁਹ ਕਾਲੇ ਸਤਿਗੁਰ ਤੇ ਚੁਕੇ"
    }
  ]

{
  "audio_file": "0144 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 6.125,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.72,
      "end_time": 19.12,
      "transcript": "ਸਾਧਸੰਗਿ, ਤਾ ਕੀ ਸਰਨੀ ਪਰਹੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.12,
      "end_time": 25.54,
      "transcript": "ਮਨੁ ਤਨੁ ਅਪਨਾ, ਆਗੈ ਧਰਹੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.54,
      "end_time": 31.755,
      "transcript": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ, ਪੀਵਹੁ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.755,
      "end_time": 39.565,
      "transcript": "ਸਿਮਰਿ ਸਿਮਰਿ, ਸਭ ਤਪਤਿ ਬੁਝਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 47.6,
      "end_time": 53.96,
      "transcript": "ਤਜਿ ਅਭਿਮਾਨੁ, ਜਨਮ ਮਰਣੁ ਨਿਵਾਰਹੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.96,
      "end_time": 60.175,
      "transcript": "ਹਰਿ ਕੇ ਦਾਸ ਕੇ ਚਰਣ, ਨਮਸਕਾਰਹੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.175,
      "end_time": 66.44,
      "transcript": "ਸਾਸਿ ਸਾਸਿ, ਪ੍ਰਭੁ ਮਨਹਿ ਸਮਾਲੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.44,
      "end_time": 72.765,
      "transcript": "ਸੋ ਧਨੁ ਸੰਚਹੁ, ਜੋ ਚਾਲੈ ਨਾਲੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.96,
      "end_time": 85.038,
      "transcript": "ਤਿਸਹਿ ਪਰਾਪਤਿ, ਜਿਸੁ ਮਸਤਕਿ ਭਾਗੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.038,
      "end_time": 91.385,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਤਾ ਕੀ ਚਰਣੀ ਲਾਗੁ"
    }
  ]
}

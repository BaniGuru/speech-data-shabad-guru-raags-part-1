  "audio_file": "0192 G Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.0,
      "end_time": 1.986,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.24,
      "end_time": 16.006,
      "transcript": "ਟੂਟੇ ਬੰਧਨ ਜਨਮ ਮਰਨ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.006,
      "end_time": 22.125,
      "transcript": "ਸਾਧ ਸੇਵ ਸੁਖੁ ਪਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.145,
      "end_time": 30.099,
      "transcript": "ਨਾਨਕ ਮਨਹੁ ਨ ਬੀਸਰੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.099,
      "end_time": 38.415,
      "transcript": "ਗੁਣ ਨਿਧਿ ਗੋਬਿਦ ਰਾਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.312,
      "end_time": 53.68,
      "transcript": "ਟਹਲ ਕਰਹੁ ਤਉ ਏਕ ਕੀ, ਜਾ ਤੇ ਬ੍ਰਿਥਾ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.68,
      "end_time": 62.32,
      "transcript": "ਮਨਿ ਤਨਿ ਮੁਖਿ ਹੀਐ ਬਸੈ, ਜੋ ਚਾਹਹੁ ਸੋ ਹੋਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.32,
      "end_time": 71.08,
      "transcript": "ਟਹਲ ਮਹਲ ਤਾ ਕਉ ਮਿਲੈ, ਜਾ ਕਉ ਸਾਧ ਕ੍ਰਿਪਾਲ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.08,
      "end_time": 79.641,
      "transcript": "ਸਾਧੂ ਸੰਗਤਿ ਤਉ ਬਸੈ, ਜਉ ਆਪਨ ਹੋਹਿ ਦਇਆਲ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.641,
      "end_time": 88.3,
      "transcript": "ਟੋਹੇ ਟਾਹੇ ਬਹੁ ਭਵਨ, ਬਿਨੁ ਨਾਵੈ ਸੁਖੁ ਨਾਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 88.3,
      "end_time": 96.435,
      "transcript": "ਟਲਹਿ ਜਾਮ ਕੇ ਦੂਤ ਤਿਹ, ਜੁ ਸਾਧੂ ਸੰਗਿ ਸਮਾਹਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 96.705,
      "end_time": 100.92,
      "transcript": "ਬਾਰਿ ਬਾਰਿ ਜਾਉ ਸੰਤ ਸਦਕੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 100.92,
      "end_time": 106.34,
      "transcript": "ਨਾਨਕ, ਪਾਪ ਬਿਨਾਸੇ ਕਦਿ ਕੇ"
    }
  ]
}

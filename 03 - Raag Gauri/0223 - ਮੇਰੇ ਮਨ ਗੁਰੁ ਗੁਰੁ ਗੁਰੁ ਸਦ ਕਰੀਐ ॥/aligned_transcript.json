  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.245,
      "end_time": 7.84,
      "transcript": "ਗਉੜੀ ਪੂਰਬੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.675,
      "end_time": 23.485,
      "transcript": "ਮੇਰੇ ਮਨ, ਗੁਰੁ ਗੁਰੁ ਗੁਰੁ ਸਦ ਕਰੀਐ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.785,
      "end_time": 31.305,
      "transcript": "ਰਤਨ ਜਨਮੁ ਸਫਲੁ ਗੁਰਿ ਕੀਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.92,
      "end_time": 39.935,
      "transcript": "ਦਰਸਨ ਕਉ ਬਲਿਹਰੀਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 47.625,
      "end_time": 55.148,
      "transcript": "ਜੇਤੇ ਸਾਸ ਗ੍ਰਾਸ ਮਨੁ ਲੇਤਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 55.148,
      "end_time": 62.855,
      "transcript": "ਤੇਤੇ ਹੀ ਗੁਨ ਗਾਈਐ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.245,
      "end_time": 70.615,
      "transcript": "ਜਉ ਹੋਇ ਦੈਆਲੁ ਸਤਿਗੁਰੁ ਅਪੁਨਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 71.12,
      "end_time": 78.834,
      "transcript": "ਤਾ ਇਹ ਮਤਿ ਬੁਧਿ ਪਾਈਐ"
    },
    {
      "section_id": "section-00009",
      "start_time": 78.834,
      "end_time": 86.84,
      "transcript": "ਮੇਰੇ ਮਨ ਨਾਮਿ ਲਏ ਜਮ ਬੰਧ ਤੇ ਛੂਟਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 86.84,
      "end_time": 94.035,
      "transcript": "ਸਰਬ ਸੁਖਾ ਸੁਖ ਪਾਈਐ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.405,
      "end_time": 101.955,
      "transcript": "ਸੇਵਿ ਸੁਆਮੀ ਸਤਿਗੁਰੁ ਦਾਤਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 102.24,
      "end_time": 109.835,
      "transcript": "ਮਨ ਬੰਛਤ ਫਲ ਆਈਐ"
    },
    {
      "section_id": "section-00013",
      "start_time": 110.12,
      "end_time": 117.567,
      "transcript": "ਨਾਮੁ ਇਸਟੁ ਮੀਤ ਸੁਤ ਕਰਤਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 117.567,
      "end_time": 125.295,
      "transcript": "ਮਨ ਸੰਗਿ ਤੁਹਾਰੈ ਚਾਲੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 125.76,
      "end_time": 133.055,
      "transcript": "ਕਰਿ ਸੇਵਾ ਸਤਿਗੁਰ ਅਪੁਨੇ ਕੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 133.415,
      "end_time": 140.965,
      "transcript": "ਗੁਰ ਤੇ ਪਾਈਐ ਪਾਲੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 141.425,
      "end_time": 148.725,
      "transcript": "ਗੁਰਿ ਕਿਰਪਾਲਿ ਕ੍ਰਿਪਾ ਪ੍ਰਭਿ ਧਾਰੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 149.2,
      "end_time": 156.505,
      "transcript": "ਬਿਨਸੇ ਸਰਬ ਅੰਦੇਸਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 157.08,
      "end_time": 164.8,
      "transcript": "ਨਾਨਕ ਸੁਖੁ ਪਾਇਆ ਹਰਿ ਕੀਰਤਨਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 164.8,
      "end_time": 172.255,
      "transcript": "ਮਿਟਿਓ ਸਗਲ ਕਲੇਸਾ"
    }
  ]
}

{
  "audio_file": "0150 E PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.235,
      "end_time": 7.347,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.165,
      "end_time": 21.124,
      "transcript": "ਗਰੀਬਾ ਉਪਰਿ, ਜਿ ਖਿੰਜੈ ਦਾੜੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.124,
      "end_time": 28.195,
      "transcript": "ਪਾਰਬ੍ਰਹਮਿ, ਸਾ ਅਗਨਿ ਮਹਿ ਸਾੜੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.195,
      "end_time": 35.36,
      "transcript": "ਪੂਰਾ ਨਿਆਉ ਕਰੇ, ਕਰਤਾਰੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.36,
      "end_time": 42.415,
      "transcript": "ਅਪੁਨੇ ਦਾਸ ਕਉ, ਰਾਖਨਹਾਰੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 60.08,
      "end_time": 67.08,
      "transcript": "ਆਦਿ ਜੁਗਾਦਿ, ਪ੍ਰਗਟਿ ਪਰਤਾਪੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.08,
      "end_time": 74.2,
      "transcript": "ਨਿੰਦਕੁ ਮੁਆ, ਉਪਜਿ ਵਡ ਤਾਪੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.2,
      "end_time": 81.24,
      "transcript": "ਤਿਨਿ ਮਾਰਿਆ, ਜਿ ਰਖੈ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.24,
      "end_time": 88.24,
      "transcript": "ਆਗੈ ਪਾਛੈ, ਮੰਦੀ ਸੋਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.24,
      "end_time": 95.4,
      "transcript": "ਅਪੁਨੇ ਦਾਸ, ਰਾਖੈ ਕੰਠਿ ਲਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.4,
      "end_time": 101.995,
      "transcript": "ਸਰਣਿ ਨਾਨਕ, ਹਰਿ ਨਾਮੁ ਧਿਆਇ"
    }
  ]
}

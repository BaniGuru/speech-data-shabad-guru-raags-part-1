    },
    {
      "section_id": "section-00003",
      "start_time": 21.229,
      "end_time": 37.849,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 54.8,
      "end_time": 61.81,
      "transcript": "ਹਰਿ ਨਾਮੁ ਲੇਹੁ ਮੀਤਾ ਲੇਹੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 61.81,
      "end_time": 69.361,
      "transcript": "ਆਗੈ ਬਿਖਮ ਪੰਥੁ ਭੈਆਨ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 76.36,
      "end_time": 83.45,
      "transcript": "ਸੇਵਤ ਸੇਵਤ ਸਦਾ ਸੇਵਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 83.45,
      "end_time": 90.64,
      "transcript": "ਤੇਰੈ ਸੰਗਿ ਬਸਤੁ ਹੈ ਕਾਲੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 90.64,
      "end_time": 97.595,
      "transcript": "ਕਰਿ ਸੇਵਾ ਤੂੰ ਸਾਧ ਕੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 98.055,
      "end_time": 105.215,
      "transcript": "ਹੋ ਕਾਟੀਐ ਜਮ ਜਾਲੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 105.215,
      "end_time": 119.015,
      "transcript": "ਹੋਮ ਜਗ ਤੀਰਥ ਕੀਏ, ਬਿਚਿ ਹਉਮੈ ਬਧੇ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 119.4,
      "end_time": 126.484,
      "transcript": "ਨਰਕੁ ਸੁਰਗੁ ਦੁਇ ਭੁੰਚਨਾ ਹੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 126.484,
      "end_time": 133.475,
      "transcript": "ਬਹੁਰਿ ਬਹੁਰਿ ਅਵਤਾਰ"
    },
    {
      "section_id": "section-00013",
      "start_time": 133.88,
      "end_time": 140.435,
      "transcript": "ਸਿਵ ਪੁਰੀ ਬ੍ਰਹਮ ਇੰਦ੍ਰ ਪੁਰੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 140.88,
      "end_time": 147.655,
      "transcript": "ਨਿਹਚਲੁ ਕੋ ਥਾਉ ਨਾਹਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 148.055,
      "end_time": 154.905,
      "transcript": "ਬਿਨੁ ਹਰਿ ਸੇਵਾ ਸੁਖੁ ਨਹੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 155.44,
      "end_time": 162.145,
      "transcript": "ਹੋ ਸਾਕਤ ਆਵਹਿ ਜਾਹਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 162.555,
      "end_time": 169.325,
      "transcript": "ਜੈਸੋ ਗੁਰਿ ਉਪਦੇਸਿਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 169.76,
      "end_time": 176.275,
      "transcript": "ਮੈ ਤੈਸੋ ਕਹਿਆ ਪੁਕਾਰਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 176.745,
      "end_time": 183.555,
      "transcript": "ਨਾਨਕੁ ਕਹੈ ਸੁਨਿ ਰੇ ਮਨਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 184.04,
      "end_time": 191.835,
      "transcript": "ਕਰਿ ਕੀਰਤਨੁ ਹੋਇ ਉਧਾਰੁ"

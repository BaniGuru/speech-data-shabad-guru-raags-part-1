{
  "audio_file": "0192 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.0,
      "end_time": 1.807,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 10.52,
      "end_time": 17.369,
      "transcript": "ਚਿਤਿ ਚਿਤਵਉ ਚਰਣਾਰਬਿੰਦ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.369,
      "end_time": 23.844,
      "transcript": "ਊਧ ਕਵਲ ਬਿਗਸਾਂਤ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.844,
      "end_time": 30.795,
      "transcript": "ਪ੍ਰਗਟ ਭਏ ਆਪਹਿ ਗੁੋਬਿੰਦ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.795,
      "end_time": 39.455,
      "transcript": "ਨਾਨਕ ਸੰਤ ਮਤਾਂਤ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.055,
      "end_time": 49.96,
      "transcript": "ਚਚਾ, ਚਰਨ ਕਮਲ ਗੁਰ ਲਾਗਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.96,
      "end_time": 54.215,
      "transcript": "ਧਨਿ ਧਨਿ ਉਆ ਦਿਨ, ਸੰਜੋਗ ਸਭਾਗਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 54.215,
      "end_time": 58.56,
      "transcript": "ਚਾਰਿ ਕੁੰਟ, ਦਹ ਦਿਸਿ ਭ੍ਰਮਿ ਆਇਓ"
    },
    {
      "section_id": "section-00009",
      "start_time": 58.56,
      "end_time": 63.08,
      "transcript": "ਭਈ ਕ੍ਰਿਪਾ, ਤਬ ਦਰਸਨੁ ਪਾਇਓ"
    },
    {
      "section_id": "section-00010",
      "start_time": 63.08,
      "end_time": 67.32,
      "transcript": "ਚਾਰ ਬਿਚਾਰ, ਬਿਨਸਿਓ ਸਭ ਦੂਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 67.32,
      "end_time": 71.605,
      "transcript": "ਸਾਧਸੰਗਿ, ਮਨੁ ਨਿਰਮਲ ਹੂਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 71.605,
      "end_time": 75.72,
      "transcript": "ਚਿੰਤ ਬਿਸਾਰੀ, ਏਕ ਦ੍ਰਿਸਟੇਤਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 75.72,
      "end_time": 80.861,
      "transcript": "ਨਾਨਕ ਗਿਆਨ ਅੰਜਨੁ, ਜਿਹ ਨੇਤ੍ਰਾ"
    }
  ]
}

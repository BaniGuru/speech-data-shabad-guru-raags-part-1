{
  "audio_file": "0150 D PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 7.145,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.4,
      "end_time": 21.265,
      "transcript": "ਜੀਵਤ ਛਾਡਿ ਜਾਹਿ, ਦੇਵਾਨੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.265,
      "end_time": 28.804,
      "transcript": "ਮੁਇਆ, ਉਨ ਤੇ ਕੋ ਵਰਸਾਂਨੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.56,
      "end_time": 42.425,
      "transcript": "ਸਿਮਰਿ ਗੋਵਿੰਦੁ, ਮਨਿ ਤਨਿ ਧੁਰਿ ਲਿਖਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.425,
      "end_time": 49.958,
      "transcript": "ਕਾਹੂ ਕਾਜ, ਨ ਆਵਤ ਬਿਖਿਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 60.045,
      "end_time": 67.215,
      "transcript": "ਬਿਖੈ ਠਗਉਰੀ, ਜਿਨਿ ਜਿਨਿ ਖਾਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.215,
      "end_time": 74.025,
      "transcript": "ਤਾ ਕੀ ਤ੍ਰਿਸਨਾ, ਕਬਹੂੰ ਨ ਜਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.025,
      "end_time": 81.175,
      "transcript": "ਦਾਰਨ ਦੁਖ, ਦੁਤਰ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.495,
      "end_time": 88.68,
      "transcript": "ਰਾਮ ਨਾਮ ਬਿਨੁ, ਕੈਸੇ ਉਤਰਸਿ ਪਾਰਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.68,
      "end_time": 95.395,
      "transcript": "ਸਾਧਸੰਗਿ ਮਿਲਿ, ਦੁਇ ਕੁਲ ਸਾਧਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.695,
      "end_time": 102.375,
      "transcript": "ਰਾਮ ਨਾਮ, ਨਾਨਕ ਆਰਾਧਿ"
    }
  ]
}

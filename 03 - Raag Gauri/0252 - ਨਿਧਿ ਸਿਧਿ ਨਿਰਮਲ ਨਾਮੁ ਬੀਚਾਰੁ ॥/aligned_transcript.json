{
  "audio_file": "0167 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.325,
      "end_time": 10.438,
      "transcript": "ਰਾਗੁ ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 10.438,
      "end_time": 17.735,
      "transcript": "ਅਸਟਪਦੀਆ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.735,
      "end_time": 23.095,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.48,
      "end_time": 33.84,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿ ਨਾਮੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.84,
      "end_time": 43.295,
      "transcript": "ਕਰਤਾ ਪੁਰਖੁ ਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.601,
      "end_time": 48.761,
      "transcript": "ਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.095,
      "end_time": 63.096,
      "transcript": "ਨਿਧਿ ਸਿਧਿ, ਨਿਰਮਲ ਨਾਮੁ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.096,
      "end_time": 70.56,
      "transcript": "ਪੂਰਨ ਪੂਰਿ ਰਹਿਆ, ਬਿਖੁ ਮਾਰਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.56,
      "end_time": 77.859,
      "transcript": "ਤ੍ਰਿਕੁਟੀ ਛੂਟੀ, ਬਿਮਲ ਮਝਾਰਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.859,
      "end_time": 85.205,
      "transcript": "ਗੁਰ ਕੀ ਮਤਿ, ਜੀਇ ਆਈ ਕਾਰਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 92.44,
      "end_time": 99.515,
      "transcript": "ਇਨ ਬਿਧਿ, ਰਾਮ ਰਮਤ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.515,
      "end_time": 108.285,
      "transcript": "ਗਿਆਨ ਅੰਜਨੁ, ਗੁਰ ਸਬਦਿ ਪਛਾਨਿਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00013",
      "start_time": 113.815,
      "end_time": 121.173,
      "transcript": "ਇਕੁ ਸੁਖੁ ਮਾਨਿਆ, ਸਹਜਿ ਮਿਲਾਇਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 121.173,
      "end_time": 127.965,
      "transcript": "ਨਿਰਮਲ ਬਾਣੀ, ਭਰਮੁ ਚੁਕਾਇਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 128.495,
      "end_time": 135.235,
      "transcript": "ਲਾਲ ਭਏ, ਸੂਹਾ ਰੰਗੁ ਮਾਇਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 135.655,
      "end_time": 143.415,
      "transcript": "ਨਦਰਿ ਭਈ, ਬਿਖੁ ਠਾਕਿ ਰਹਾਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 150.002,
      "end_time": 157.2,
      "transcript": "ਉਲਟ ਭਈ, ਜੀਵਤ ਮਰਿ ਜਾਗਿਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 157.2,
      "end_time": 164.305,
      "transcript": "ਸਬਦਿ ਰਵੇ, ਮਨੁ ਹਰਿ ਸਿਉ ਲਾਗਿਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 164.305,
      "end_time": 171.447,
      "transcript": "ਰਸੁ ਸੰਗ੍ਰਹਿ, ਬਿਖੁ ਪਰਹਰਿ ਤਿਆਗਿਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 171.447,
      "end_time": 179.085,
      "transcript": "ਭਾਇ ਬਸੇ, ਜਮ ਕਾ ਭਉ ਭਾਗਿਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 185.587,
      "end_time": 193.16,
      "transcript": "ਸਾਦ ਰਹੇ, ਬਾਦੰ ਅਹੰਕਾਰਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 193.16,
      "end_time": 199.845,
      "transcript": "ਚਿਤੁ ਹਰਿ ਸਿਉ ਰਾਤਾ, ਹੁਕਮਿ ਅਪਾਰਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 200.265,
      "end_time": 207.52,
      "transcript": "ਜਾਤਿ ਰਹੇ, ਪਤਿ ਕੇ ਆਚਾਰਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 207.52,
      "end_time": 214.885,
      "transcript": "ਦ੍ਰਿਸਟਿ ਭਈ, ਸੁਖੁ ਆਤਮ ਧਾਰਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 221.88,
      "end_time": 228.96,
      "transcript": "ਤੁਝ ਬਿਨੁ, ਕੋਇ ਨ ਦੇਖਉ ਮੀਤੁ"
    },
    {
      "section_id": "section-00026",
      "start_time": 228.96,
      "end_time": 236.035,
      "transcript": "ਕਿਸੁ ਸੇਵਉ, ਕਿਸੁ ਦੇਵਉ ਚੀਤੁ"
    },
    {
      "section_id": "section-00027",
      "start_time": 236.035,
      "end_time": 243.135,
      "transcript": "ਕਿਸੁ ਪੂਛਉ, ਕਿਸੁ ਲਾਗਉ ਪਾਇ"
    },
    {
      "section_id": "section-00028",
      "start_time": 243.24,
      "end_time": 250.725,
      "transcript": "ਕਿਸੁ ਉਪਦੇਸਿ, ਰਹਾ ਲਿਵ ਲਾਇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 257.045,
      "end_time": 264.135,
      "transcript": "ਗੁਰ ਸੇਵੀ, ਗੁਰ ਲਾਗਉ ਪਾਇ"
    },
    {
      "section_id": "section-00030",
      "start_time": 264.56,
      "end_time": 271.075,
      "transcript": "ਭਗਤਿ ਕਰੀ, ਰਾਚਉ ਹਰਿ ਨਾਇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 271.64,
      "end_time": 278.47,
      "transcript": "ਸਿਖਿਆ ਦੀਖਿਆ, ਭੋਜਨ ਭਾਉ"
    },
    {
      "section_id": "section-00032",
      "start_time": 278.47,
      "end_time": 286.105,
      "transcript": "ਹੁਕਮਿ ਸੰਜੋਗੀ, ਨਿਜ ਘਰਿ ਜਾਉ"
    },
    {
      "section_id": "section-00033",
      "start_time": 292.725,
      "end_time": 299.435,
      "transcript": "ਗਰਬ ਗਤੰ, ਸੁਖ ਆਤਮ ਧਿਆਨਾ"
    },
    {
      "section_id": "section-00034",
      "start_time": 299.915,
      "end_time": 306.795,
      "transcript": "ਜੋਤਿ ਭਈ, ਜੋਤੀ ਮਾਹਿ ਸਮਾਨਾ"
    },
    {
      "section_id": "section-00035",
      "start_time": 306.795,
      "end_time": 314.025,
      "transcript": "ਲਿਖਤੁ ਮਿਟੈ ਨਹੀ, ਸਬਦੁ ਨੀਸਾਨਾ"
    },
    {
      "section_id": "section-00036",
      "start_time": 314.025,
      "end_time": 321.555,
      "transcript": "ਕਰਤਾ ਕਰਣਾ, ਕਰਤਾ ਜਾਨਾ"
    },
    {
      "section_id": "section-00037",
      "start_time": 328.105,
      "end_time": 335.17,
      "transcript": "ਨਹ ਪੰਡਿਤੁ, ਨਹ ਚਤੁਰੁ ਸਿਆਨਾ"
    },
    {
      "section_id": "section-00038",
      "start_time": 335.17,
      "end_time": 341.835,
      "transcript": "ਨਹ ਭੂਲੋ, ਨਹ ਭਰਮਿ ਭੁਲਾਨਾ"
    },
    {
      "section_id": "section-00039",
      "start_time": 342.365,
      "end_time": 349.065,
      "transcript": "ਕਥਉ ਨ ਕਥਨੀ, ਹੁਕਮੁ ਪਛਾਨਾ"
    },
    {
      "section_id": "section-00040",
      "start_time": 349.335,
      "end_time": 357.424,
      "transcript": "ਨਾਨਕ ਗੁਰਮਤਿ ਸਹਜਿ ਸਮਾਨਾ"
    },
    {
      "section_id": "section-00041",
      "start_time": 363.374,
      "end_time": 375.436,
      "transcript": "ਨਾਨਕ ਗੁਰਮਤਿ ਸਹਜਿ ਸਮਾਨਾ ਆ"
    }
  ]
}

{
  "audio_file": "0144 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.021,
      "end_time": 6.285,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.295,
      "end_time": 18.64,
      "transcript": "ਸੂਕੇ ਹਰੇ ਕੀਏ, ਖਿਨ ਮਾਹੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.64,
      "end_time": 24.899,
      "transcript": "ਅੰਮ੍ਰਿਤ ਦ੍ਰਿਸਟਿ ਸੰਚਿ, ਜੀਵਾਏ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.899,
      "end_time": 31.034,
      "transcript": "ਕਾਟੇ ਕਸਟ, ਪੂਰੇ ਗੁਰਦੇਵ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.034,
      "end_time": 38.935,
      "transcript": "ਸੇਵਕ ਕਉ ਦੀਨੀ, ਅਪੁਨੀ ਸੇਵ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.8,
      "end_time": 53.2,
      "transcript": "ਮਿਟਿ ਗਈ ਚਿੰਤ, ਪੁਨੀ ਮਨ ਆਸਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.2,
      "end_time": 59.44,
      "transcript": "ਕਰੀ ਦਇਆ, ਸਤਿਗੁਰਿ ਗੁਣਤਾਸਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.44,
      "end_time": 65.635,
      "transcript": "ਦੁਖ ਨਾਠੇ, ਸੁਖ ਆਇ ਸਮਾਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.635,
      "end_time": 71.935,
      "transcript": "ਢੀਲ ਨ ਪਰੀ, ਜਾ ਗੁਰਿ ਫੁਰਮਾਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.12,
      "end_time": 84.055,
      "transcript": "ਇਛ ਪੁਨੀ, ਪੂਰੇ ਗੁਰ ਮਿਲੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.055,
      "end_time": 90.314,
      "transcript": "ਨਾਨਕ ਤੇ ਜਨ, ਸੁਫਲ ਫਲੇ"
    }
  ]
}

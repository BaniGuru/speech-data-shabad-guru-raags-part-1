  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.115,
      "end_time": 8.215,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.44,
      "end_time": 23.04,
      "transcript": "ਤੁਝ ਬਿਨੁ, ਕਵਨੁ ਰੀਝਾਵੈ ਤੋਹੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.04,
      "end_time": 34.425,
      "transcript": "ਤੇਰੋ ਰੂਪੁ, ਸਗਲ ਦੇਖਿ ਮੋਹੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.855,
      "end_time": 53.56,
      "transcript": "ਸੁਰਗ ਪਇਆਲ ਮਿਰਤ ਭੂਅ ਮੰਡਲ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.56,
      "end_time": 60.575,
      "transcript": "ਸਰਬ ਸਮਾਨੋ ਏਕੈ ਓਹੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 61.16,
      "end_time": 68.305,
      "transcript": "ਸਿਵ ਸਿਵ ਕਰਤ ਸਗਲ ਕਰ ਜੋਰਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 68.72,
      "end_time": 75.785,
      "transcript": "ਸਰਬ ਮਇਆ ਠਾਕੁਰ ਤੇਰੀ ਦੋਹੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.32,
      "end_time": 83.843,
      "transcript": "ਪਤਿਤ ਪਾਵਨ ਠਾਕੁਰ ਨਾਮੁ ਤੁਮਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 83.843,
      "end_time": 91.247,
      "transcript": "ਸੁਖਦਾਈ ਨਿਰਮਲ ਸੀਤਲੋਹੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.247,
      "end_time": 98.655,
      "transcript": "ਗਿਆਨ ਧਿਆਨ ਨਾਨਕ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 98.985,
      "end_time": 106.005,
      "transcript": "ਸੰਤ ਤੇਰੇ ਸਿਉ ਗਾਲ ਗਲੋਹੀ"
    }
  ]

{
  "audio_file": "0115 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 6.95,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.127,
      "end_time": 21.22,
      "transcript": "ਡਰਿ ਘਰੁ ਘਰਿ ਡਰੁ, ਡਰਿ ਡਰੁ ਜਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.64,
      "end_time": 28.51,
      "transcript": "ਸੋ ਡਰੁ ਕੇਹਾ, ਜਿਤੁ ਡਰਿ ਡਰੁ ਪਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.8,
      "end_time": 35.77,
      "transcript": "ਤੁਧੁ ਬਿਨੁ ਦੂਜੀ ਨਾਹੀ ਜਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.77,
      "end_time": 42.869,
      "transcript": "ਜੋ ਕਿਛੁ ਵਰਤੈ, ਸਭ ਤੇਰੀ ਰਜਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.869,
      "end_time": 50.405,
      "transcript": "ਡਰੀਐ ਜੇ ਡਰੁ ਹੋਵੈ ਹੋਰੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.405,
      "end_time": 61.05,
      "transcript": "ਡਰਿ ਡਰਿ ਡਰਣਾ ਮਨ ਕਾ ਸੋਰੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.72,
      "end_time": 75.68,
      "transcript": "ਨਾ ਜੀਉ ਮਰੈ, ਨ ਡੂਬੈ ਤਰੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.92,
      "end_time": 82.62,
      "transcript": "ਜਿਨਿ ਕਿਛੁ ਕੀਆ, ਸੋ ਕਿਛੁ ਕਰੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.16,
      "end_time": 90.244,
      "transcript": "ਹੁਕਮੇ ਆਵੈ, ਹੁਕਮੇ ਜਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 90.244,
      "end_time": 97.24,
      "transcript": "ਆਗੈ ਪਾਛੈ, ਹੁਕਮਿ ਸਮਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.72,
      "end_time": 104.78,
      "transcript": "ਹੰਸੁ ਹੇਤੁ, ਆਸਾ ਅਸਮਾਨੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 104.92,
      "end_time": 111.86,
      "transcript": "ਤਿਸੁ ਵਿਚਿ ਭੂਖ ਬਹੁਤੁ ਨੈ ਸਾਨੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 112.28,
      "end_time": 119.52,
      "transcript": "ਭਉ ਖਾਣਾ ਪੀਣਾ ਆਧਾਰੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 119.52,
      "end_time": 126.35,
      "transcript": "ਵਿਣੁ ਖਾਧੇ ਮਰਿ ਹੋਹਿ ਗਵਾਰ"
    },
    {
      "section_id": "section-00016",
      "start_time": 126.76,
      "end_time": 134.12,
      "transcript": "ਜਿਸ ਕਾ ਕੋਇ ਕੋਈ ਕੋਇ ਕੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 134.12,
      "end_time": 141.13,
      "transcript": "ਸਭੁ ਕੋ ਤੇਰਾ, ਤੂੰ ਸਭਨਾ ਕਾ ਸੋਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 141.52,
      "end_time": 148.8,
      "transcript": "ਜਾ ਕੇ ਜੀਅ ਜੰਤ ਧਨੁ ਮਾਲੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 148.8,
      "end_time": 155.63,
      "transcript": "ਨਾਨਕ ਆਖਣੁ ਬਿਖਮੁ ਬੀਚਾਰੁ"
    }
  ]
}

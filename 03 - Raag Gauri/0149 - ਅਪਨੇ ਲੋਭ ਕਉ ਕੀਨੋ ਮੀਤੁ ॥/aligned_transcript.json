{
  "audio_file": "0147 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 6.704,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.822,
      "end_time": 19.6,
      "transcript": "ਅਪਨੇ ਲੋਭ ਕਉ, ਕੀਨੋ ਮੀਤੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.6,
      "end_time": 26.2,
      "transcript": "ਸਗਲ ਮਨੋਰਥ, ਮੁਕਤਿ ਪਦੁ ਦੀਤੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.2,
      "end_time": 32.485,
      "transcript": "ਐਸਾ ਮੀਤੁ, ਕਰਹੁ ਸਭੁ ਕੋਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.485,
      "end_time": 42.215,
      "transcript": "ਜਾ ਤੇ ਬਿਰਥਾ, ਕੋਇ ਨ ਹੋਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.88,
      "end_time": 55.145,
      "transcript": "ਅਪੁਨੈ ਸੁਆਇ, ਰਿਦੈ ਲੈ ਧਾਰਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.145,
      "end_time": 61.606,
      "transcript": "ਦੂਖ ਦਰਦ ਰੋਗ, ਸਗਲ ਬਿਦਾਰਿਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.606,
      "end_time": 68.187,
      "transcript": "ਰਸਨਾ ਗੀਧੀ, ਬੋਲਤ ਰਾਮ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.187,
      "end_time": 74.764,
      "transcript": "ਪੂਰਨ ਹੋਏ, ਸਗਲੇ ਕਾਮ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.764,
      "end_time": 81.4,
      "transcript": "ਅਨਿਕ ਬਾਰ, ਨਾਨਕ ਬਲਿਹਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.4,
      "end_time": 87.205,
      "transcript": "ਸਫਲ ਦਰਸਨੁ, ਗੋਬਿੰਦੁ ਹਮਾਰਾ"
    }
  ]
}

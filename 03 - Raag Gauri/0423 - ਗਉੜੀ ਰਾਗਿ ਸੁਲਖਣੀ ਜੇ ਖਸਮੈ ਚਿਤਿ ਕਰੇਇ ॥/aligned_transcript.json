{
  "audio_file": "0230 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.48,
      "end_time": 7.105,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.04,
      "end_time": 20.905,
      "transcript": "ਗਉੜੀ ਰਾਗਿ ਸੁਲਖਣੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.72,
      "end_time": 27.825,
      "transcript": "ਜੇ ਖਸਮੈ ਚਿਤਿ ਕਰੇਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.48,
      "end_time": 34.929,
      "transcript": "ਭਾਣੈ ਚਲੈ ਸਤਿਗੁਰੂ ਕੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.929,
      "end_time": 42.071,
      "transcript": "ਐਸਾ ਸੀਗਾਰੁ ਕਰੇਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.072,
      "end_time": 54.989,
      "transcript": "ਸਚਾ ਸਬਦੁ ਭਤਾਰੁ ਹੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.989,
      "end_time": 61.55,
      "transcript": "ਸਦਾ ਸਦਾ ਰਾਵੇਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.55,
      "end_time": 67.984,
      "transcript": "ਜਿਉ ਉਬਲੀ ਮਜੀਠੈ ਰੰਗੁ ਗਹਗਹਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.984,
      "end_time": 74.86,
      "transcript": "ਤਿਉ ਸਚੇ ਨੋ ਜੀਉ ਦੇਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.86,
      "end_time": 81.235,
      "transcript": "ਰੰਗਿ ਚਲੂਲੈ ਅਤਿ ਰਤੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.64,
      "end_time": 87.955,
      "transcript": "ਸਚੇ ਸਿਉ ਲਗਾ ਨੇਹੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 94.8,
      "end_time": 100.995,
      "transcript": "ਕੂੜੁ ਠਗੀ ਗੁਝੀ ਨਾ ਰਹੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 101.4,
      "end_time": 107.847,
      "transcript": "ਕੂੜੁ ਮੁਲੰਮਾ ਪਲੇਟਿ ਧਰੇਹੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 107.847,
      "end_time": 114.463,
      "transcript": "ਕੂੜੀ ਕਰਨਿ ਵਡਾਈਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 114.463,
      "end_time": 120.895,
      "transcript": "ਕੂੜੇ ਸਿਉ ਲਗਾ ਨੇਹੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 121.015,
      "end_time": 127.125,
      "transcript": "ਨਾਨਕ ਸਚਾ ਆਪਿ ਹੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 127.645,
      "end_time": 137.445,
      "transcript": "ਆਪੇ ਨਦਰਿ ਕਰੇਇ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 143.664,
      "end_time": 150.245,
      "transcript": "ਸਤਸੰਗਤਿ ਮਹਿ ਹਰਿ ਉਸਤਤਿ ਹੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 150.48,
      "end_time": 156.44,
      "transcript": "ਸੰਗਿ ਸਾਧੂ ਮਿਲੇ ਪਿਆਰਿਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 156.44,
      "end_time": 163.095,
      "transcript": "ਓਇ ਪੁਰਖ ਪ੍ਰਾਣੀ ਧੰਨਿ ਜਨ ਹਹਿ"
    },
    {
      "section_id": "section-00021",
      "start_time": 163.52,
      "end_time": 170.275,
      "transcript": "ਉਪਦੇਸੁ ਕਰਹਿ ਪਰਉਪਕਾਰਿਆ"
    },
    {
      "section_id": "section-00022",
      "start_time": 176.56,
      "end_time": 183.08,
      "transcript": "ਹਰਿ ਨਾਮੁ ਦ੍ਰਿੜਾਵਹਿ ਹਰਿ ਨਾਮੁ ਸੁਣਾਵਹਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 183.08,
      "end_time": 189.43,
      "transcript": "ਹਰਿ ਨਾਮੇ ਜਗੁ ਨਿਸਤਾਰਿਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 189.43,
      "end_time": 195.92,
      "transcript": "ਗੁਰ ਵੇਖਣ ਕਉ ਸਭੁ ਕੋਈ ਲੋਚੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 195.92,
      "end_time": 202.443,
      "transcript": "ਨਵ ਖੰਡ ਜਗਤਿ ਨਮਸਕਾਰਿਆ"
    },
    {
      "section_id": "section-00026",
      "start_time": 202.443,
      "end_time": 209.035,
      "transcript": "ਤੁਧੁ ਆਪੇ ਆਪੁ ਰਖਿਆ ਸਤਿਗੁਰ ਵਿਚਿ"
    },
    {
      "section_id": "section-00027",
      "start_time": 209.035,
      "end_time": 215.365,
      "transcript": "ਗੁਰੁ ਆਪੇ ਤੁਧੁ ਸਵਾਰਿਆ"
    },
    {
      "section_id": "section-00028",
      "start_time": 222.24,
      "end_time": 228.73,
      "transcript": "ਤੂ ਆਪੇ ਪੂਜਹਿ ਪੂਜ ਕਰਾਵਹਿ"
    },
    {
      "section_id": "section-00029",
      "start_time": 228.73,
      "end_time": 235.115,
      "transcript": "ਸਤਿਗੁਰ ਕਉ ਸਿਰਜਣਹਾਰਿਆ"
    },
    {
      "section_id": "section-00030",
      "start_time": 235.4,
      "end_time": 241.84,
      "transcript": "ਕੋਈ ਵਿਛੁੜਿ ਜਾਇ ਸਤਿਗੁਰੂ ਪਾਸਹੁ"
    },
    {
      "section_id": "section-00031",
      "start_time": 241.84,
      "end_time": 248.41,
      "transcript": "ਤਿਸੁ ਕਾਲਾ ਮੁਹੁ ਜਮਿ ਮਾਰਿਆ"
    },
    {
      "section_id": "section-00032",
      "start_time": 248.41,
      "end_time": 254.75,
      "transcript": "ਤਿਸੁ ਅਗੈ ਪਿਛੈ ਢੋਈ ਨਾਹੀ"
    },
    {
      "section_id": "section-00033",
      "start_time": 254.75,
      "end_time": 260.595,
      "transcript": "ਗੁਰਸਿਖੀ ਮਨਿ ਵੀਚਾਰਿਆ"
    },
    {
      "section_id": "section-00034",
      "start_time": 268.04,
      "end_time": 274.48,
      "transcript": "ਸਤਿਗੁਰੂ ਨੋ ਮਿਲੇ ਸੇਈ ਜਨ ਉਬਰੇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 274.48,
      "end_time": 280.956,
      "transcript": "ਜਿਨ ਹਿਰਦੈ ਨਾਮੁ ਸਮਾਰਿਆ"
    },
    {
      "section_id": "section-00036",
      "start_time": 280.956,
      "end_time": 287.525,
      "transcript": "ਜਨ ਨਾਨਕ ਕੇ ਗੁਰਸਿਖ ਪੁਤਹਹੁ"
    },
    {
      "section_id": "section-00037",
      "start_time": 287.525,
      "end_time": 297.485,
      "transcript": "ਹਰਿ ਜਪਿਅਹੁ ਹਰਿ ਨਿਸਤਾਰਿਆ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00038",
      "start_time": 303.8,
      "end_time": 309.946,
      "transcript": "ਹਉਮੈ ਜਗਤੁ ਭੁਲਾਇਆ"
    },
    {
      "section_id": "section-00039",
      "start_time": 309.946,
      "end_time": 316.195,
      "transcript": "ਦੁਰਮਤਿ ਬਿਖਿਆ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00040",
      "start_time": 316.669,
      "end_time": 323.175,
      "transcript": "ਸਤਿਗੁਰੁ ਮਿਲੈ ਤ ਨਦਰਿ ਹੋਇ"
    },
    {
      "section_id": "section-00041",
      "start_time": 323.175,
      "end_time": 329.335,
      "transcript": "ਮਨਮੁਖ ਅੰਧ ਅੰਧਿਆਰ"
    },
    {
      "section_id": "section-00042",
      "start_time": 329.805,
      "end_time": 336.215,
      "transcript": "ਨਾਨਕ ਆਪੇ ਮੇਲਿ ਲਏ"
    },
    {
      "section_id": "section-00043",
      "start_time": 336.215,
      "end_time": 345.755,
      "transcript": "ਜਿਸ ਨੋ ਸਬਦਿ ਲਾਏ ਪਿਆਰੁ ਪਉੜੀ"
    },
    {
      "section_id": "section-00044",
      "start_time": 350.04,
      "end_time": 358.23,
      "transcript": "ਸਚੁ ਸਚੇ ਕੀ ਸਿਫਤਿ ਸਲਾਹ ਹੈ, ਸੋ ਕਰੇ ਜਿਸੁ ਅੰਦਰੁ ਭਿਜੈ"
    },
    {
      "section_id": "section-00045",
      "start_time": 358.23,
      "end_time": 366.46,
      "transcript": "ਜਿਨੀ ਇਕ ਮਨਿ ਇਕੁ ਅਰਾਧਿਆ, ਤਿਨ ਕਾ ਕੰਧੁ ਨ ਕਬਹੂ ਛਿਜੈ"
    },
    {
      "section_id": "section-00046",
      "start_time": 366.46,
      "end_time": 374.84,
      "transcript": "ਧਨੁ ਧਨੁ ਪੁਰਖ ਸਾਬਾਸਿ ਹੈ, ਜਿਨ ਸਚੁ ਰਸਨਾ ਅੰਮ੍ਰਿਤੁ ਪਿਜੈ"
    },
    {
      "section_id": "section-00047",
      "start_time": 374.84,
      "end_time": 382.97,
      "transcript": "ਸਚੁ ਸਚਾ ਜਿਨ ਮਨਿ ਭਾਵਦਾ, ਸੇ ਮਨਿ ਸਚੀ ਦਰਗਹ ਲਿਜੈ"
    },
    {
      "section_id": "section-00048",
      "start_time": 382.97,
      "end_time": 391.745,
      "transcript": "ਧਨੁ ਧੰਨੁ ਜਨਮੁ ਸਚਿਆਰੀਆ, ਮੁਖ ਉਜਲ ਸਚੁ ਕਰਿਜੈ"
    }
  ]
}

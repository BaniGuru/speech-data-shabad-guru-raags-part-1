  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.755,
      "end_time": 13.377,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 44.56,
      "end_time": 51.001,
      "transcript": "ਹਉ, ਤਾ ਕੈ ਬਲਿਹਾਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 51.001,
      "end_time": 59.845,
      "transcript": "ਜਾ ਕੈ, ਕੇਵਲ ਨਾਮੁ ਅਧਾਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 68.405,
      "end_time": 75.16,
      "transcript": "ਮਹਿਮਾ ਤਾ ਕੀ ਕੇਤਕ ਗਨੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 75.16,
      "end_time": 81.485,
      "transcript": "ਜਨ ਪਾਰਬ੍ਰਹਮ ਰੰਗਿ ਰਾਤੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 81.995,
      "end_time": 88.96,
      "transcript": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਤਿਨਾ ਸੰਗਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 88.96,
      "end_time": 95.045,
      "transcript": "ਉਨ ਸਮਸਰਿ ਅਵਰ ਨ ਦਾਤੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 95.525,
      "end_time": 101.825,
      "transcript": "ਜਗਤ ਉਧਾਰਣ ਸੇਈ ਆਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 102.315,
      "end_time": 108.535,
      "transcript": "ਜੋ ਜਨ ਦਰਸ ਪਿਆਸਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 109.12,
      "end_time": 115.725,
      "transcript": "ਉਨ ਕੀ ਸਰਣਿ ਪਰੈ ਸੋ ਤਰਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 115.725,
      "end_time": 122.64,
      "transcript": "ਸੰਤਸੰਗਿ ਪੂਰਨ ਆਸਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 122.64,
      "end_time": 128.755,
      "transcript": "ਤਾ ਕੈ ਚਰਣਿ ਪਰਉ ਤਾ ਜੀਵਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 129.275,
      "end_time": 135.435,
      "transcript": "ਜਨ ਕੈ ਸੰਗਿ ਨਿਹਾਲਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 135.885,
      "end_time": 142.355,
      "transcript": "ਭਗਤਨ ਕੀ ਰੇਣੁ ਹੋਇ ਮਨੁ ਮੇਰਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 142.88,
      "end_time": 148.865,
      "transcript": "ਹੋਹੁ ਪ੍ਰਭੂ ਕਿਰਪਾਲਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 149.395,
      "end_time": 156.28,
      "transcript": "ਰਾਜੁ ਜੋਬਨੁ ਅਵਧ ਜੋ ਦੀਸੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 156.28,
      "end_time": 162.385,
      "transcript": "ਸਭੁ ਕਿਛੁ ਜੁਗ ਮਹਿ ਘਾਟਿਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 162.855,
      "end_time": 169.385,
      "transcript": "ਨਾਮੁ ਨਿਧਾਨੁ ਸਦ ਨਵਤਨੁ ਨਿਰਮਲੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 169.385,
      "end_time": 175.475,
      "transcript": "ਇਹੁ ਨਾਨਕ ਹਰਿ ਧਨੁ ਖਾਟਿਆ"
    }
  ]
}

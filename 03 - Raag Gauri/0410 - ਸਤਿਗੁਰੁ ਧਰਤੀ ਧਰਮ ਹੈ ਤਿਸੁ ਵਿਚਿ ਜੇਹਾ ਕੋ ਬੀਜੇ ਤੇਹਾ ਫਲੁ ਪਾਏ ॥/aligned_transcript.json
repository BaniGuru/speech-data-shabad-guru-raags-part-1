{
  "audio_file": "0225 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.12,
      "end_time": 5.468,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 5.468,
      "end_time": 11.304,
      "transcript": "ਮਹਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 11.304,
      "end_time": 16.57,
      "transcript": "ਚੌਥਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.28,
      "end_time": 32.92,
      "transcript": "ਸਤਿਗੁਰੁ ਧਰਤੀ ਧਰਮ ਹੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.92,
      "end_time": 41.68,
      "transcript": "ਤਿਸੁ ਵਿਚਿ ਜੇਹਾ ਕੋ ਬੀਜੇ ਤੇਹਾ ਫਲੁ ਪਾਏ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.68,
      "end_time": 48.922,
      "transcript": "ਗੁਰਸਿਖੀ ਅੰਮ੍ਰਿਤੁ ਬੀਜਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.922,
      "end_time": 56.105,
      "transcript": "ਤਿਨ ਅੰਮ੍ਰਿਤ ਫਲੁ ਹਰਿ ਪਾਏ"
    },
    {
      "section_id": "section-00008",
      "start_time": 56.8,
      "end_time": 63.95,
      "transcript": "ਓਨਾ ਹਲਤਿ ਪਲਤਿ ਮੁਖ ਉਜਲੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.95,
      "end_time": 71.155,
      "transcript": "ਓਇ ਹਰਿ ਦਰਗਹ ਸਚੀ ਪੈਨਾਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 72.08,
      "end_time": 79.565,
      "transcript": "ਇਕਨਾ੍ ਅੰਦਰਿ ਖੋਟੁ ਨਿਤ ਖੋਟੁ ਕਮਾਵਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.565,
      "end_time": 87.08,
      "transcript": "ਓਹੁ ਜੇਹਾ ਬੀਜੇ ਤੇਹਾ ਫਲੁ ਖਾਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.08,
      "end_time": 94.53,
      "transcript": "ਜਾ ਸਤਿਗੁਰੁ ਸਰਾਫੁ ਨਦਰਿ ਕਰਿ ਦੇਖੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 94.53,
      "end_time": 102.08,
      "transcript": "ਸੁਆਵਗੀਰ ਸਭਿ ਉਘੜਿ ਆਏ"
    },
    {
      "section_id": "section-00014",
      "start_time": 102.08,
      "end_time": 109.6,
      "transcript": "ਓਇ ਜੇਹਾ ਚਿਤਵਹਿ ਨਿਤ ਤੇਹਾ ਪਾਇਨਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 109.6,
      "end_time": 116.365,
      "transcript": "ਓਇ ਤੇਹੋ ਜੇਹੇ ਦਯਿ ਵਜਾਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 117.12,
      "end_time": 124.52,
      "transcript": "ਨਾਨਕ ਦੁਹੀ ਸਿਰੀ ਖਸਮੁ ਆਪੇ ਵਰਤੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 124.52,
      "end_time": 135.675,
      "transcript": "ਨਿਤ ਕਰਿ ਕਰਿ ਦੇਖੈ ਚਲਤ ਸਬਾਏ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 143.16,
      "end_time": 149.755,
      "transcript": "ਇਕੁ ਮਨੁ ਇਕੁ ਵਰਤਦਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 150.64,
      "end_time": 157.215,
      "transcript": "ਜਿਤੁ ਲਗੈ ਸੋ ਥਾਇ ਪਾਇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 158.2,
      "end_time": 165.065,
      "transcript": "ਕੋਈ ਗਲਾ ਕਰੇ ਘਨੇਰੀਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 165.68,
      "end_time": 172.465,
      "transcript": "ਜਿ ਘਰਿ ਵਥੁ ਹੋਵੈ ਸਾਈ ਖਾਇ"
    },
    {
      "section_id": "section-00022",
      "start_time": 172.465,
      "end_time": 179.735,
      "transcript": "ਬਿਨੁ ਸਤਿਗੁਰ ਸੋਝੀ ਨਾ ਪਵੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 180.64,
      "end_time": 187.415,
      "transcript": "ਅਹੰਕਾਰੁ ਨ ਵਿਚਹੁ ਜਾਇ"
    },
    {
      "section_id": "section-00024",
      "start_time": 187.695,
      "end_time": 194.925,
      "transcript": "ਅਹੰਕਾਰੀਆ ਨੋ ਦੁਖ ਭੁਖ ਹੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 195.6,
      "end_time": 202.345,
      "transcript": "ਹਥੁ ਤਡਹਿ ਘਰਿ ਘਰਿ ਮੰਗਾਇ"
    },
    {
      "section_id": "section-00026",
      "start_time": 202.975,
      "end_time": 210.11,
      "transcript": "ਕੂੜੁ ਠਗੀ ਗੁਝੀ ਨਾ ਰਹੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 210.11,
      "end_time": 217.185,
      "transcript": "ਮੁਲੰਮਾ ਪਾਜੁ ਲਹਿ ਜਾਇ"
    },
    {
      "section_id": "section-00028",
      "start_time": 218.015,
      "end_time": 225.395,
      "transcript": "ਜਿਸੁ ਹੋਵੈ ਪੂਰਬਿ ਲਿਖਿਆ"
    },
    {
      "section_id": "section-00029",
      "start_time": 225.64,
      "end_time": 232.175,
      "transcript": "ਤਿਸੁ ਸਤਿਗੁਰੁ ਮਿਲੈ ਪ੍ਰਭੁ ਆਇ"
    },
    {
      "section_id": "section-00030",
      "start_time": 233.12,
      "end_time": 239.725,
      "transcript": "ਜਿਉ ਲੋਹਾ ਪਾਰਸਿ ਭੇਟੀਐ"
    },
    {
      "section_id": "section-00031",
      "start_time": 240.245,
      "end_time": 247.255,
      "transcript": "ਮਿਲਿ ਸੰਗਤਿ ਸੁਵਰਨੁ ਹੋਇ ਜਾਇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 248.08,
      "end_time": 255.108,
      "transcript": "ਜਨ ਨਾਨਕ ਕੇ ਪ੍ਰਭ ਤੂ ਧਣੀ"
    },
    {
      "section_id": "section-00033",
      "start_time": 255.108,
      "end_time": 265.105,
      "transcript": "ਜਿਉ ਭਾਵੈ ਤਿਵੈ ਚਲਾਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00034",
      "start_time": 265.44,
      "end_time": 273.755,
      "transcript": "ਜਿਨ ਹਰਿ ਹਿਰਦੈ ਸੇਵਿਆ, ਤਿਨ ਹਰਿ ਆਪਿ ਮਿਲਾਏ"
    },
    {
      "section_id": "section-00035",
      "start_time": 273.755,
      "end_time": 282.08,
      "transcript": "ਗੁਣ ਕੀ ਸਾਝਿ ਤਿਨ ਸਿਉ ਕਰੀ, ਸਭਿ ਅਵਗਣ ਸਬਦਿ ਜਲਾਏ"
    },
    {
      "section_id": "section-00036",
      "start_time": 282.08,
      "end_time": 290.28,
      "transcript": "ਅਉਗਣ ਵਿਕਣਿ ਪਲਰੀ, ਜਿਸੁ ਦੇਹਿ ਸੁ ਸਚੇ ਪਾਏ"
    },
    {
      "section_id": "section-00037",
      "start_time": 290.28,
      "end_time": 298.4,
      "transcript": "ਬਲਿਹਾਰੀ ਗੁਰ ਆਪਣੇ, ਜਿਨਿ ਅਉਗਣ ਮੇਟਿ ਗੁਣ ਪਰਗਟੀਆਏ"
    },
    {
      "section_id": "section-00038",
      "start_time": 298.4,
      "end_time": 309.645,
      "transcript": "ਵਡੀ ਵਡਿਆਈ ਵਡੇ ਕੀ, ਗੁਰਮੁਖਿ ਆਲਾਏ"
    }
  ]
}

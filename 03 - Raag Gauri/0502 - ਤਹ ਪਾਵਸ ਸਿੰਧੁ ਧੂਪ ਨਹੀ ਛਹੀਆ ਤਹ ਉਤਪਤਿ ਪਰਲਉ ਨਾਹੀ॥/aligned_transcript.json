      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 29.36,
      "end_time": 37.44,
      "transcript": "ਤਹ ਪਾਵਸ ਸਿੰਧੁ ਧੂਪ ਨਹੀ ਛਹੀਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.44,
      "end_time": 45.105,
      "transcript": "ਤਹ ਉਤਪਤਿ ਪਰਲਉ ਨਾਹੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.105,
      "end_time": 52.985,
      "transcript": "ਜੀਵਨ ਮਿਰਤੁ ਨ ਦੁਖੁ ਸੁਖੁ ਬਿਆਪੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.985,
      "end_time": 60.75,
      "transcript": "ਸੁੰਨ ਸਮਾਧਿ ਦੋਊ ਤਹ ਨਾਹੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 60.75,
      "end_time": 68.535,
      "transcript": "ਸਹਜ ਕੀ ਅਕਥ ਕਥਾ, ਹੈ ਨਿਰਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 68.76,
      "end_time": 75.495,
      "transcript": "ਤੁਲਿ ਨਹੀ ਚਢੈ ਜਾਇ ਨ ਮੁਕਾਤੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.287,
      "end_time": 84.138,
      "transcript": "ਹਲੁਕੀ ਲਗੈ ਨ ਭਾਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 91.674,
      "end_time": 99.8,
      "transcript": "ਅਰਧ ਉਰਧ ਦੋਊ ਤਹ ਨਾਹੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 99.8,
      "end_time": 107.385,
      "transcript": "ਰਾਤਿ ਦਿਨਸੁ ਤਹ ਨਾਹੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 107.6,
      "end_time": 115.4,
      "transcript": "ਜਲੁ ਨਹੀ ਪਵਨੁ ਪਾਵਕੁ ਫੁਨਿ ਨਾਹੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 115.4,
      "end_time": 122.847,
      "transcript": "ਸਤਿਗੁਰ ਤਹਾ ਸਮਾਹੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 123.28,
      "end_time": 131.08,
      "transcript": "ਅਗਮ ਅਗੋਚਰੁ ਰਹੈ ਨਿਰੰਤਰਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 131.08,
      "end_time": 138.445,
      "transcript": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਲਹੀਐ"
    },
    {
      "section_id": "section-00015",
      "start_time": 138.775,
      "end_time": 146.2,
      "transcript": "ਕਹੁ ਕਬੀਰ ਬਲਿ ਜਾਉ ਗੁਰ ਅਪੁਨੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 146.64,
      "end_time": 153.855,
      "transcript": "ਸਤਸੰਗਤਿ ਮਿਲਿ ਰਹੀਐ"
    }
  ]
}

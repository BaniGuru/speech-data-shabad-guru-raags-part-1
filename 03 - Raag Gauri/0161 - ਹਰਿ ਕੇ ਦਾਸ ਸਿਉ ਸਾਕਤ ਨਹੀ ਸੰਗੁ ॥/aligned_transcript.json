{
  "audio_file": "0149 E PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 6.335,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.535,
      "end_time": 18.96,
      "transcript": "ਹਰਿ ਕੇ ਦਾਸ ਸਿਉ, ਸਾਕਤ ਨਹੀ ਸੰਗੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.96,
      "end_time": 28.355,
      "transcript": "ਓਹੁ ਬਿਖਈ, ਓਸੁ ਰਾਮ ਕੋ ਰੰਗੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 34.755,
      "end_time": 41.078,
      "transcript": "ਮਨ ਅਸਵਾਰ, ਜੈਸੇ ਤੁਰੀ ਸੀਗਾਰੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 41.078,
      "end_time": 47.275,
      "transcript": "ਜਿਉ ਕਾਪੁਰਖੁ, ਪੁਚਾਰੈ ਨਾਰੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 47.495,
      "end_time": 53.915,
      "transcript": "ਬੈਲ ਕਉ, ਨੇਤ੍ਰਾ ਪਾਇ ਦੁਹਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.915,
      "end_time": 60.435,
      "transcript": "ਗਊ ਚਰਿ, ਸਿੰਘ ਪਾਛੈ ਪਾਵੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 66.725,
      "end_time": 73.035,
      "transcript": "ਗਾਡਰ ਲੇ, ਕਾਮਧੇਨੁ ਕਰਿ ਪੂਜੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 73.28,
      "end_time": 79.425,
      "transcript": "ਸਉਦੇ ਕਉ ਧਾਵੈ, ਬਿਨੁ ਪੂੰਜੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.615,
      "end_time": 85.875,
      "transcript": "ਨਾਨਕ, ਰਾਮ ਨਾਮੁ ਜਪਿ ਚੀਤ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.08,
      "end_time": 92.215,
      "transcript": "ਸਿਮਰਿ ਸੁਆਮੀ, ਹਰਿ ਸਾ ਮੀਤ"
    }
  ]
}

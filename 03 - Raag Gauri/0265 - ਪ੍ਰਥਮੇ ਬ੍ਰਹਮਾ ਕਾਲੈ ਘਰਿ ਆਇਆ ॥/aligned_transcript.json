{
  "audio_file": "0172 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.085,
      "end_time": 8.524,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 8.524,
      "end_time": 23.903,
      "transcript": "ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.28,
      "end_time": 45.0,
      "transcript": "ਪ੍ਰਥਮੇ ਬ੍ਰਹਮਾ, ਕਾਲੈ ਘਰਿ ਆਇਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.0,
      "end_time": 53.665,
      "transcript": "ਬ੍ਰਹਮ, ਕਮਲੁ ਪਇਆਲਿ ਨ ਪਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.665,
      "end_time": 62.105,
      "transcript": "ਆਗਿਆ ਨਹੀ ਲੀਨੀ, ਭਰਮਿ ਭੁਲਾਇਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.105,
      "end_time": 70.7,
      "transcript": "ਜੋ ਉਪਜੈ, ਸੋ ਕਾਲਿ ਸੰਘਾਰਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.7,
      "end_time": 83.195,
      "transcript": "ਹਮ ਹਰਿ ਰਾਖੇ, ਗੁਰਸਬਦੁ ਬੀਚਾਰਿਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 87.295,
      "end_time": 95.62,
      "transcript": "ਮਾਇਆ ਮੋਹੇ, ਦੇਵੀ ਸਭਿ ਦੇਵਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 95.62,
      "end_time": 103.9,
      "transcript": "ਕਾਲੁ ਨ ਛੋਡੈ, ਬਿਨੁ ਗੁਰ ਕੀ ਸੇਵਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 103.9,
      "end_time": 111.97,
      "transcript": "ਓਹੁ, ਅਬਿਨਾਸੀ ਅਲਖ ਅਭੇਵਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 111.97,
      "end_time": 120.285,
      "transcript": "ਸੁਲਤਾਨ ਖਾਨ ਬਾਦਿਸਾਹ, ਨਹੀ ਰਹਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 120.285,
      "end_time": 128.64,
      "transcript": "ਨਾਮਹੁ ਭੂਲੈ, ਜਮ ਕਾ ਦੁਖੁ ਸਹਨਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 128.64,
      "end_time": 136.79,
      "transcript": "ਮੈ ਧਰ ਨਾਮੁ, ਜਿਉ ਰਾਖਹੁ ਰਹਨਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 136.79,
      "end_time": 145.12,
      "transcript": "ਚਉਧਰੀ ਰਾਜੇ, ਨਹੀ ਕਿਸੈ ਮੁਕਾਮੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 145.12,
      "end_time": 153.24,
      "transcript": "ਸਾਹ ਮਰਹਿ, ਸੰਚਹਿ ਮਾਇਆ ਦਾਮ"
    },
    {
      "section_id": "section-00016",
      "start_time": 153.24,
      "end_time": 161.385,
      "transcript": "ਮੈ ਧਨੁ ਦੀਜੈ, ਹਰਿ ਅੰਮ੍ਰਿਤ ਨਾਮੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 161.385,
      "end_time": 169.515,
      "transcript": "ਰਯਤਿ ਮਹਰ, ਮੁਕਦਮ ਸਿਕਦਾਰੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 169.515,
      "end_time": 177.72,
      "transcript": "ਨਿਹਚਲੁ, ਕੋਇ ਨ ਦਿਸੈ ਸੰਸਾਰੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 177.72,
      "end_time": 185.78,
      "transcript": "ਅਫਰਿਉ ਕਾਲੁ, ਕੂੜੁ ਸਿਰਿ ਮਾਰੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 185.78,
      "end_time": 194.0,
      "transcript": "ਨਿਹਚਲੁ ਏਕੁ, ਸਚਾ ਸਚੁ ਸੋਈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 194.0,
      "end_time": 202.06,
      "transcript": "ਜਿਨਿ ਕਰਿ ਸਾਜੀ, ਤਿਨਹਿ ਸਭ ਗੋਈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 202.06,
      "end_time": 209.985,
      "transcript": "ਓਹੁ ਗੁਰਮੁਖਿ ਜਾਪੈ, ਤਾਂ ਪਤਿ ਹੋਈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 209.985,
      "end_time": 217.855,
      "transcript": "ਕਾਜੀ ਸੇਖ, ਭੇਖ ਫਕੀਰਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 218.125,
      "end_time": 225.815,
      "transcript": "ਵਡੇ ਕਹਾਵਹਿ, ਹਉਮੈ ਤਨਿ ਪੀਰਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 226.24,
      "end_time": 234.025,
      "transcript": "ਕਾਲੁ ਨ ਛੋਡੈ, ਬਿਨੁ ਸਤਿਗੁਰ ਕੀ ਧੀਰਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 234.32,
      "end_time": 242.075,
      "transcript": "ਕਾਲੁ ਜਾਲੁ, ਜਿਹਵਾ ਅਰੁ ਨੈਣੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 242.245,
      "end_time": 249.845,
      "transcript": "ਕਾਨੀ ਕਾਲੁ, ਸੁਣੈ ਬਿਖੁ ਬੈਣੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 250.235,
      "end_time": 258.36,
      "transcript": "ਬਿਨੁ ਸਬਦੈ, ਮੂਠੇ ਦਿਨੁ ਰੈਣੀ"
    },
    {
      "section_id": "section-00029",
      "start_time": 258.36,
      "end_time": 266.36,
      "transcript": "ਹਿਰਦੈ ਸਾਚੁ ਵਸੈ, ਹਰਿ ਨਾਇ"
    },
    {
      "section_id": "section-00030",
      "start_time": 266.36,
      "end_time": 273.885,
      "transcript": "ਕਾਲੁ ਨ ਜੋਹਿ ਸਕੈ, ਗੁਣ ਗਾਇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 274.145,
      "end_time": 281.735,
      "transcript": "ਨਾਨਕ, ਗੁਰਮੁਖਿ ਸਬਦਿ ਸਮਾਇ"
    }
  ]
}

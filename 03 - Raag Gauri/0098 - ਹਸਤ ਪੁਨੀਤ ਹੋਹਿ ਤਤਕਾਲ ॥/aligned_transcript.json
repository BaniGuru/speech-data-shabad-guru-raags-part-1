{
  "audio_file": "0139 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.48,
      "end_time": 7.08,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.08,
      "end_time": 13.524,
      "transcript": "ਹਸਤ ਪੁਨੀਤ ਹੋਹਿ, ਤਤਕਾਲ"
    },
    {
      "section_id": "section-00003",
      "start_time": 13.524,
      "end_time": 20.4,
      "transcript": "ਬਿਨਸਿ ਜਾਹਿ, ਮਾਇਆ ਜੰਜਾਲ"
    },
    {
      "section_id": "section-00004",
      "start_time": 20.4,
      "end_time": 27.0,
      "transcript": "ਰਸਨਾ ਰਮਹੁ, ਰਾਮ ਗੁਣ ਨੀਤ"
    },
    {
      "section_id": "section-00005",
      "start_time": 27.0,
      "end_time": 34.132,
      "transcript": "ਸੁਖੁ ਪਾਵਹੁ, ਮੇਰੇ ਭਾਈ ਮੀਤ"
    },
    {
      "section_id": "section-00006",
      "start_time": 40.267,
      "end_time": 46.806,
      "transcript": "ਲਿਖੁ ਲੇਖਣਿ, ਕਾਗਦਿ ਮਸਵਾਣੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 46.806,
      "end_time": 54.798,
      "transcript": "ਰਾਮ ਨਾਮ ਹਰਿ ਅੰਮ੍ਰਿਤ ਬਾਣੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.2,
      "end_time": 66.478,
      "transcript": "ਇਹ ਕਾਰਜਿ, ਤੇਰੇ ਜਾਹਿ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.478,
      "end_time": 73.32,
      "transcript": "ਸਿਮਰਤ ਰਾਮ, ਨਾਹੀ ਜਮ ਮਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 73.32,
      "end_time": 79.665,
      "transcript": "ਧਰਮ ਰਾਇ ਕੇ ਦੂਤ, ਨ ਜੋਹੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.665,
      "end_time": 86.64,
      "transcript": "ਮਾਇਆ ਮਗਨ, ਨ ਕਛੂਐ ਮੋਹੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 86.64,
      "end_time": 93.056,
      "transcript": "ਉਧਰਹਿ ਆਪਿ, ਤਰੈ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 93.056,
      "end_time": 99.738,
      "transcript": "ਰਾਮ ਨਾਮ ਜਪਿ, ਏਕੰਕਾਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 99.738,
      "end_time": 106.262,
      "transcript": "ਆਪਿ ਕਮਾਉ, ਅਵਰਾ ਉਪਦੇਸ"
    },
    {
      "section_id": "section-00015",
      "start_time": 106.262,
      "end_time": 113.08,
      "transcript": "ਰਾਮ ਨਾਮ, ਹਿਰਦੈ ਪਰਵੇਸ"
    },
    {
      "section_id": "section-00016",
      "start_time": 113.08,
      "end_time": 119.32,
      "transcript": "ਜਾ ਕੈ ਮਾਥੈ, ਏਹੁ ਨਿਧਾਨੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 119.32,
      "end_time": 125.957,
      "transcript": "ਸੋਈ ਪੁਰਖੁ, ਜਪੈ ਭਗਵਾਨੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 125.957,
      "end_time": 132.316,
      "transcript": "ਆਠ ਪਹਰ, ਹਰਿ ਹਰਿ ਗੁਣ ਗਾਉ"
    },
    {
      "section_id": "section-00019",
      "start_time": 132.316,
      "end_time": 139.394,
      "transcript": "ਕਹੁ ਨਾਨਕ ਹਉ ਤਿਸੁ ਬਲਿ ਜਾਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 145.748,
      "end_time": 155.438,
      "transcript": "ਕਹੁ ਨਾਨਕ ਹਉ ਤਿਸੁ ਬਲਿ ਜਾਉ"
    }
  ]
}

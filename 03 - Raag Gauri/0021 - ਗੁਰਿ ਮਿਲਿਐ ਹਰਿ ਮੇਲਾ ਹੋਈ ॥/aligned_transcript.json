{
  "audio_file": "0119 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.2,
      "end_time": 13.912,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.912,
      "end_time": 23.5,
      "transcript": "ਮਹਲਾ ਤੀਜਾ ਚਉਪਦੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.5,
      "end_time": 38.459,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 53.96,
      "end_time": 60.585,
      "transcript": "ਗੁਰਿ ਮਿਲਿਐ, ਹਰਿ ਮੇਲਾ ਹੋਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 60.585,
      "end_time": 67.058,
      "transcript": "ਆਪੇ ਮੇਲਿ ਮਿਲਾਵੈ ਸੋਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.058,
      "end_time": 73.76,
      "transcript": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਭ ਬਿਧਿ ਆਪੇ ਜਾਣੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 73.76,
      "end_time": 81.66,
      "transcript": "ਹੁਕਮੇ ਮੇਲੇ, ਸਬਦਿ ਪਛਾਣੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 86.96,
      "end_time": 93.44,
      "transcript": "ਸਤਿਗੁਰ ਕੈ ਭਇ, ਭ੍ਰਮੁ ਭਉ ਜਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 93.44,
      "end_time": 101.759,
      "transcript": "ਭੈ ਰਾਚੈ ਸਚ ਰੰਗਿ ਸਮਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 106.373,
      "end_time": 113.0,
      "transcript": "ਗੁਰਿ ਮਿਲਿਐ, ਹਰਿ ਮਨਿ ਵਸੈ ਸੁਭਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 113.0,
      "end_time": 119.4,
      "transcript": "ਮੇਰਾ ਪ੍ਰਭੁ ਭਾਰਾ, ਕੀਮਤਿ ਨਹੀ ਪਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 119.4,
      "end_time": 125.84,
      "transcript": "ਸਬਦਿ ਸਾਲਾਹੈ, ਅੰਤੁ ਨ ਪਾਰਾਵਾਰੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 125.84,
      "end_time": 132.87,
      "transcript": "ਮੇਰਾ ਪ੍ਰਭੁ ਬਖਸੇ, ਬਖਸਣਹਾਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 138.72,
      "end_time": 145.12,
      "transcript": "ਗੁਰਿ ਮਿਲਿਐ, ਸਭ ਮਤਿ ਬੁਧਿ ਹੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 145.12,
      "end_time": 151.64,
      "transcript": "ਮਨਿ ਨਿਰਮਲਿ, ਵਸੈ ਸਚੁ ਸੋਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 151.64,
      "end_time": 157.92,
      "transcript": "ਸਾਚਿ ਵਸਿਐ, ਸਾਚੀ ਸਭ ਕਾਰ"
    },
    {
      "section_id": "section-00017",
      "start_time": 157.92,
      "end_time": 164.763,
      "transcript": "ਊਤਮ ਕਰਣੀ, ਸਬਦ ਬੀਚਾਰ"
    },
    {
      "section_id": "section-00018",
      "start_time": 170.68,
      "end_time": 177.04,
      "transcript": "ਗੁਰ ਤੇ, ਸਾਚੀ ਸੇਵਾ ਹੋਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 177.04,
      "end_time": 183.48,
      "transcript": "ਗੁਰਮੁਖਿ ਨਾਮੁ, ਪਛਾਣੈ ਕੋਇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 183.48,
      "end_time": 189.96,
      "transcript": "ਜੀਵੈ ਦਾਤਾ, ਦੇਵਣਹਾਰੁ"
    },
    {
      "section_id": "section-00021",
      "start_time": 189.96,
      "end_time": 196.457,
      "transcript": "ਨਾਨਕ ਹਰਿ ਨਾਮੇ, ਲਗੈ ਪਿਆਰੁ"
    },
    {
      "section_id": "section-00022",
      "start_time": 202.651,
      "end_time": 211.196,
      "transcript": "ਨਾਨਕ ਹਰਿ ਨਾਮੇ, ਲਗੈ ਪਿਆਰੁ"
    }
  ]
}

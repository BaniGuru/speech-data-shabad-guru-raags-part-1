  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.915,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.04,
      "end_time": 14.12,
      "transcript": "ਮਨ ਕਾ ਸੁਭਾਉ, ਮਨਹਿ ਬਿਆਪੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.12,
      "end_time": 21.09,
      "transcript": "ਮਨਹਿ ਮਾਰਿ, ਕਵਨ ਸਿਧਿ ਥਾਪੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.09,
      "end_time": 28.12,
      "transcript": "ਕਵਨੁ ਸੁ ਮੁਨਿ, ਜੋ ਮਨੁ ਮਾਰੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.12,
      "end_time": 36.795,
      "transcript": "ਮਨ ਕਉ ਮਾਰਿ, ਕਹਹੁ ਕਿਸੁ ਤਾਰੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.285,
      "end_time": 48.87,
      "transcript": "ਮਨ ਅੰਤਰਿ, ਬੋਲੈ ਸਭੁ ਕੋਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.87,
      "end_time": 56.28,
      "transcript": "ਮਨ ਮਾਰੇ ਬਿਨੁ, ਭਗਤਿ ਨ ਹੋਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 56.28,
      "end_time": 63.32,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਜੋ ਜਾਨੈ ਭੇਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.32,
      "end_time": 69.28,
      "transcript": "ਮਨੁ ਮਧੁਸੂਦਨੁ, ਤ੍ਰਿਭਵਣ ਦੇਉ"
    }
  ]
}

{
  "audio_file": "0151 F PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.225,
      "end_time": 6.784,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.56,
      "end_time": 18.68,
      "transcript": "ਤੂੰਹੈ ਮਸਲਤਿ, ਤੂੰਹੈ ਨਾਲਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.68,
      "end_time": 24.8,
      "transcript": "ਤੂਹੈ ਰਾਖਹਿ, ਸਾਰਿ ਸਮਾਲਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.8,
      "end_time": 30.785,
      "transcript": "ਐਸਾ ਰਾਮੁ, ਦੀਨ ਦੁਨੀ ਸਹਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.785,
      "end_time": 39.965,
      "transcript": "ਦਾਸ ਕੀ ਪੈਜ ਰਖੈ, ਮੇਰੇ ਭਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.215,
      "end_time": 52.245,
      "transcript": "ਆਗੈ ਆਪਿ, ਇਹੁ ਥਾਨੁ ਵਸਿ ਜਾ ਕੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.245,
      "end_time": 58.52,
      "transcript": "ਆਠ ਪਹਰ, ਮਨੁ ਹਰਿ ਕਉ ਜਾਪੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.52,
      "end_time": 64.557,
      "transcript": "ਪਤਿ ਪਰਵਾਣੁ, ਸਚੁ ਨੀਸਾਣੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.557,
      "end_time": 70.785,
      "transcript": "ਜਾ ਕਉ, ਆਪਿ ਕਰਹਿ ਫੁਰਮਾਨੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.856,
      "end_time": 82.909,
      "transcript": "ਆਪੇ ਦਾਤਾ, ਆਪਿ ਪ੍ਰਤਿਪਾਲਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 82.909,
      "end_time": 88.705,
      "transcript": "ਨਿਤ ਨਿਤ ਨਾਨਕ, ਰਾਮ ਨਾਮੁ ਸਮਾਲਿ"
    }
  ]
}

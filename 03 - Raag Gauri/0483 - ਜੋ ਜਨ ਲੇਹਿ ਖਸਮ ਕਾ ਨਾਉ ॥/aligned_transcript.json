{
  "audio_file": "0242 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.295,
      "end_time": 7.208,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.56,
      "end_time": 21.515,
      "transcript": "ਜੋ ਜਨ ਲੇਹਿ, ਖਸਮ ਕਾ ਨਾਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.515,
      "end_time": 28.495,
      "transcript": "ਤਿਨ ਕੈ, ਸਦ ਬਲਿਹਾਰੈ ਜਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.495,
      "end_time": 35.525,
      "transcript": "ਸੋ ਨਿਰਮਲੁ, ਨਿਰਮਲ ਹਰਿ ਗੁਨ ਗਾਵੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.525,
      "end_time": 42.775,
      "transcript": "ਸੋ ਭਾਈ, ਮੇਰੈ ਮਨਿ ਭਾਵੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.705,
      "end_time": 56.72,
      "transcript": "ਜਿਹ ਘਟ, ਰਾਮੁ ਰਹਿਆ ਭਰਪੂਰਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.72,
      "end_time": 63.655,
      "transcript": "ਤਿਨ ਕੀ ਪਗ ਪੰਕਜ, ਹਮ ਧੂਰਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.655,
      "end_time": 70.685,
      "transcript": "ਜਾਤਿ ਜੁਲਾਹਾ, ਮਤਿ ਕਾ ਧੀਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.685,
      "end_time": 77.225,
      "transcript": "ਸਹਜਿ ਸਹਜਿ, ਗੁਣ ਰਮੈ ਕਬੀਰੁ"
    }
  ]
}

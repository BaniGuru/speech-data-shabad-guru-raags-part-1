{
  "audio_file": "0221 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.086,
      "end_time": 2.375,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.44,
      "end_time": 19.235,
      "transcript": "ਚਤੁਰ ਸਿਆਣਾ ਸੁਘੜੁ ਸੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.235,
      "end_time": 26.705,
      "transcript": "ਜਿਨਿ ਤਜਿਆ ਅਭਿਮਾਨੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.12,
      "end_time": 34.615,
      "transcript": "ਚਾਰਿ ਪਦਾਰਥ ਅਸਟ ਸਿਧਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.8,
      "end_time": 42.165,
      "transcript": "ਭਜੁ ਨਾਨਕ ਹਰਿ ਨਾਮੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.165,
      "end_time": 46.325,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.544,
      "end_time": 59.12,
      "transcript": "ਚਤੁਰਥਿ ਚਾਰੇ ਬੇਦ ਸੁਣਿ, ਸੋਧਿਓ ਤਤੁ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.12,
      "end_time": 67.345,
      "transcript": "ਸਰਬ ਖੇਮ ਕਲਿਆਣ ਨਿਧਿ, ਰਾਮ ਨਾਮੁ ਜਪਿ ਸਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.345,
      "end_time": 75.515,
      "transcript": "ਨਰਕ ਨਿਵਾਰੈ ਦੁਖ ਹਰੈ, ਤੂਟਹਿ ਅਨਿਕ ਕਲੇਸ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.795,
      "end_time": 83.605,
      "transcript": "ਮੀਚੁ ਹੁਟੈ ਜਮ ਤੇ ਛੁਟੈ, ਹਰਿ ਕੀਰਤਨ ਪਰਵੇਸ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.045,
      "end_time": 92.205,
      "transcript": "ਭਉ ਬਿਨਸੈ ਅੰਮ੍ਰਿਤੁ ਰਸੈ, ਰੰਗਿ ਰਤੇ ਨਿਰੰਕਾਰ"
    },
    {
      "section_id": "section-00012",
      "start_time": 92.32,
      "end_time": 100.225,
      "transcript": "ਦੁਖ ਦਾਰਿਦ ਅਪਵਿਤ੍ਰਤਾ, ਨਾਸਹਿ ਨਾਮ ਅਧਾਰ"
    },
    {
      "section_id": "section-00013",
      "start_time": 100.44,
      "end_time": 108.305,
      "transcript": "ਸੁਰਿ ਨਰ ਮੁਨਿ ਜਨ ਖੋਜਤੇ, ਸੁਖ ਸਾਗਰ ਗੋਪਾਲ"
    },
    {
      "section_id": "section-00014",
      "start_time": 108.52,
      "end_time": 118.155,
      "transcript": "ਮਨੁ ਨਿਰਮਲੁ ਮੁਖੁ ਊਜਲਾ, ਹੋਇ ਨਾਨਕ ਸਾਧ ਰਵਾਲ"
    }
  ]
}

    {
      "section_id": "section-00005",
      "start_time": 44.28,
      "end_time": 51.58,
      "transcript": "ਤੂਹੀ ਮਾਨ ਤੂੰਹੀ ਧਾਨ, ਤੂਹੀ ਪਤਿ ਤੂਹੀ ਪ੍ਰਾਨ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.58,
      "end_time": 59.192,
      "transcript": "ਗੁਰਿ, ਤੂਟੀ ਲੈ ਜੋਰੀ"

{
  "audio_file": "0132 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 7.145,
      "transcript": "ਗਉੜੀ ਮਾਝ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 17.84,
      "end_time": 24.623,
      "transcript": "ਮੇਰਾ ਬਿਰਹੀ ਨਾਮੁ ਮਿਲੈ, ਤਾ ਜੀਵਾ ਜੀਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 24.623,
      "end_time": 35.36,
      "transcript": "ਮਨ ਅੰਦਰਿ ਅੰਮ੍ਰਿਤੁ ਗੁਰਮਤਿ ਹਰਿ ਲੀਵਾ ਜੀਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.36,
      "end_time": 42.318,
      "transcript": "ਮਨੁ ਹਰਿ ਰੰਗਿ ਰਤੜਾ, ਹਰਿ ਰਸੁ ਸਦਾ ਪੀਵਾ ਜੀਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.318,
      "end_time": 52.982,
      "transcript": "ਹਰਿ ਪਾਇਅੜਾ ਮਨਿ ਜੀਵਾ ਜੀਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 60.08,
      "end_time": 67.065,
      "transcript": "ਮੇਰੈ ਮਨਿ ਤਨਿ ਪ੍ਰੇਮੁ ਲਗਾ ਹਰਿ ਬਾਣੁ ਜੀਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.065,
      "end_time": 74.28,
      "transcript": "ਮੇਰਾ ਪ੍ਰੀਤਮੁ ਮਿਤ੍ਰੁ ਹਰਿ ਪੁਰਖੁ ਸੁਜਾਣੁ ਜੀਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.28,
      "end_time": 84.643,
      "transcript": "ਗੁਰੁ ਮੇਲੇ ਸੰਤ ਹਰਿ ਸੁਘੜੁ ਸੁਜਾਣੁ ਜੀਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.643,
      "end_time": 95.325,
      "transcript": "ਹਉ ਨਾਮ ਵਿਟਹੁ ਕੁਰਬਾਣੁ ਜੀਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 95.325,
      "end_time": 102.33,
      "transcript": "ਹਉ ਹਰਿ ਹਰਿ ਸਜਣੁ, ਹਰਿ ਮੀਤੁ ਦਸਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 102.33,
      "end_time": 112.986,
      "transcript": "ਹਰਿ ਦਸਹੁ ਸੰਤਹੁ ਜੀ ਹਰਿ ਖੋਜੁ ਪਵਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00012",
      "start_time": 112.986,
      "end_time": 120.374,
      "transcript": "ਸਤਿਗੁਰੁ ਤੁਠੜਾ ਦਸੇ ਹਰਿ ਪਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00013",
      "start_time": 120.374,
      "end_time": 131.726,
      "transcript": "ਹਰਿ ਨਾਮੇ ਨਾਮਿ ਸਮਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 138.16,
      "end_time": 145.04,
      "transcript": "ਮੈ ਵੇਦਨ ਪ੍ਰੇਮੁ, ਹਰਿ ਬਿਰਹੁ ਲਗਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 145.04,
      "end_time": 152.193,
      "transcript": "ਗੁਰ ਸਰਧਾ ਪੂਰਿ, ਅੰਮ੍ਰਿਤੁ ਮੁਖਿ ਪਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 152.193,
      "end_time": 162.69,
      "transcript": "ਹਰਿ ਹੋਹੁ ਦਇਆਲੁ ਹਰਿ ਨਾਮੁ ਧਿਆਈ ਜੀਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 162.96,
      "end_time": 173.967,
      "transcript": "ਜਨ ਨਾਨਕ ਹਰਿ ਰਸੁ ਪਾਈ ਜੀਉ"
    }
  ]
}

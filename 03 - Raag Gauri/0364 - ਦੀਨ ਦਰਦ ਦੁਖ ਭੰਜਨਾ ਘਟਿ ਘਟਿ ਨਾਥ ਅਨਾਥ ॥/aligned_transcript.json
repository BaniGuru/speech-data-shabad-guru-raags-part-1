{
  "audio_file": "0198 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.44,
      "end_time": 11.415,
      "transcript": "ਸਲੋਕੁ ਦੀਨ ਦਰਦ ਦੁਖ ਭੰਜਨਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.36,
      "end_time": 19.285,
      "transcript": "ਘਟਿ ਘਟਿ ਨਾਥ ਅਨਾਥ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.56,
      "end_time": 31.329,
      "transcript": "ਸਰਣਿ ਤੁਮਾ੍ਰੀ ਆਇਓ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.329,
      "end_time": 46.355,
      "transcript": "ਨਾਨਕ ਕੇ ਪ੍ਰਭ ਸਾਥ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 64.885,
      "end_time": 73.105,
      "transcript": "ਜਹ ਮਾਤ ਪਿਤਾ, ਸੁਤ ਮੀਤ ਨ ਭਾਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 73.56,
      "end_time": 81.605,
      "transcript": "ਮਨ ਊਹਾ, ਨਾਮੁ ਤੇਰੈ ਸੰਗਿ ਸਹਾਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 82.04,
      "end_time": 90.025,
      "transcript": "ਜਹ ਮਹਾ ਭਇਆਨ, ਦੂਤ ਜਮ ਦਲੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 90.44,
      "end_time": 98.601,
      "transcript": "ਤਹ ਕੇਵਲ ਨਾਮੁ, ਸੰਗਿ ਤੇਰੈ ਚਲੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 98.601,
      "end_time": 106.745,
      "transcript": "ਜਹ ਮੁਸਕਲ ਹੋਵੈ, ਅਤਿ ਭਾਰੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 107.24,
      "end_time": 115.065,
      "transcript": "ਹਰਿ ਕੋ ਨਾਮੁ, ਖਿਨ ਮਾਹਿ ਉਧਾਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 115.56,
      "end_time": 123.365,
      "transcript": "ਅਨਿਕ ਪੁਨਹਚਰਨ ਕਰਤ, ਨਹੀ ਤਰੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 123.8,
      "end_time": 131.575,
      "transcript": "ਹਰਿ ਕੋ ਨਾਮੁ, ਕੋਟਿ ਪਾਪ ਪਰਹਰੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 131.955,
      "end_time": 139.815,
      "transcript": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਜਪਹੁ, ਮਨ ਮੇਰੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 140.265,
      "end_time": 148.493,
      "transcript": "ਨਾਨਕ, ਪਾਵਹੁ ਸੂਖ ਘਨੇਰੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 156.765,
      "end_time": 164.625,
      "transcript": "ਸਗਲ ਸ੍ਰਿਸਟਿ ਕੋ ਰਾਜਾ, ਦੁਖੀਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 165.04,
      "end_time": 173.025,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਪਤ, ਹੋਇ ਸੁਖੀਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 173.025,
      "end_time": 180.865,
      "transcript": "ਲਾਖ ਕਰੋਰੀ, ਬੰਧੁ ਨ ਪਰੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 181.28,
      "end_time": 188.815,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਪਤ, ਨਿਸਤਰੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 189.36,
      "end_time": 197.4,
      "transcript": "ਅਨਿਕ ਮਾਇਆ ਰੰਗ, ਤਿਖ ਨ ਬੁਝਾਵੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 197.4,
      "end_time": 205.315,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਪਤ, ਆਘਾਵੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 205.315,
      "end_time": 213.165,
      "transcript": "ਜਿਹ ਮਾਰਗਿ, ਇਹੁ ਜਾਤ ਇਕੇਲਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 213.6,
      "end_time": 221.225,
      "transcript": "ਤਹ ਹਰਿ ਨਾਮੁ ਸੰਗਿ, ਹੋਤ ਸੁਹੇਲਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 221.64,
      "end_time": 229.265,
      "transcript": "ਐਸਾ ਨਾਮੁ, ਮਨ ਸਦਾ ਧਿਆਈਐ"
    },
    {
      "section_id": "section-00024",
      "start_time": 229.605,
      "end_time": 237.628,
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ, ਪਰਮ ਗਤਿ ਪਾਈਐ"
    },
    {
      "section_id": "section-00025",
      "start_time": 245.56,
      "end_time": 253.165,
      "transcript": "ਛੂਟਤ ਨਹੀ, ਕੋਟਿ ਲਖ ਬਾਹੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 253.64,
      "end_time": 261.075,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਤਹ ਪਾਰਿ ਪਰਾਹੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 261.56,
      "end_time": 269.28,
      "transcript": "ਅਨਿਕ ਬਿਘਨ, ਜਹ ਆਇ ਸੰਘਾਰੈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 269.28,
      "end_time": 277.52,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਤਤਕਾਲ ਉਧਾਰੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 277.52,
      "end_time": 284.935,
      "transcript": "ਅਨਿਕ ਜੋਨਿ, ਜਨਮੈ ਮਰਿ ਜਾਮ"
    },
    {
      "section_id": "section-00030",
      "start_time": 285.455,
      "end_time": 292.925,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਪਾਵੈ ਬਿਸ੍ਰਾਮ"
    },
    {
      "section_id": "section-00031",
      "start_time": 293.52,
      "end_time": 301.44,
      "transcript": "ਹਉ ਮੈਲਾ ਮਲੁ, ਕਬਹੁ ਨ ਧੋਵੈ"
    },
    {
      "section_id": "section-00032",
      "start_time": 301.44,
      "end_time": 309.185,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਕੋਟਿ ਪਾਪ ਖੋਵੈ"
    },
    {
      "section_id": "section-00033",
      "start_time": 309.185,
      "end_time": 316.775,
      "transcript": "ਐਸਾ ਨਾਮੁ ਜਪਹੁ, ਮਨ ਰੰਗਿ"
    },
    {
      "section_id": "section-00034",
      "start_time": 317.265,
      "end_time": 324.12,
      "transcript": "ਨਾਨਕ ਪਾਈਐ, ਸਾਧ ਕੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00035",
      "start_time": 336.769,
      "end_time": 344.755,
      "transcript": "ਜਿਹ ਮਾਰਗ ਕੇ, ਗਨੇ ਜਾਹਿ ਨ ਕੋਸਾ"
    },
    {
      "section_id": "section-00036",
      "start_time": 344.755,
      "end_time": 352.705,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਊਹਾ ਸੰਗਿ ਤੋਸਾ"
    },
    {
      "section_id": "section-00037",
      "start_time": 352.705,
      "end_time": 360.855,
      "transcript": "ਜਿਹ ਪੈਡੈ, ਮਹਾ ਅੰਧ ਗੁਬਾਰਾ"
    },
    {
      "section_id": "section-00038",
      "start_time": 360.855,
      "end_time": 368.375,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਸੰਗਿ ਉਜੀਆਰਾ"
    },
    {
      "section_id": "section-00039",
      "start_time": 368.815,
      "end_time": 376.88,
      "transcript": "ਜਹਾ ਪੰਥਿ, ਤੇਰਾ ਕੋ ਨ ਸਿਞਾਨੂ"
    },
    {
      "section_id": "section-00040",
      "start_time": 376.88,
      "end_time": 384.53,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਤਹ ਨਾਲਿ ਪਛਾਨੂ"
    },
    {
      "section_id": "section-00041",
      "start_time": 384.53,
      "end_time": 392.095,
      "transcript": "ਜਹ ਮਹਾ ਭਇਆਨ, ਤਪਤਿ ਬਹੁ ਘਾਮ"
    },
    {
      "section_id": "section-00042",
      "start_time": 392.56,
      "end_time": 400.055,
      "transcript": "ਤਹ ਹਰਿ ਕੇ ਨਾਮ ਕੀ, ਤੁਮ ਊਪਰਿ ਛਾਮ"
    },
    {
      "section_id": "section-00043",
      "start_time": 400.445,
      "end_time": 408.13,
      "transcript": "ਜਹਾ ਤ੍ਰਿਖਾ, ਮਨ ਤੁਝੁ ਆਕਰਖੈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 408.13,
      "end_time": 416.17,
      "transcript": "ਤਹ ਨਾਨਕ, ਹਰਿ ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਬਰਖੈ"
    },
    {
      "section_id": "section-00045",
      "start_time": 424.068,
      "end_time": 431.425,
      "transcript": "ਭਗਤ ਜਨਾ ਕੀ, ਬਰਤਨਿ ਨਾਮੁ"
    },
    {
      "section_id": "section-00046",
      "start_time": 432.0,
      "end_time": 439.455,
      "transcript": "ਸੰਤ ਜਨਾ ਕੈ, ਮਨਿ ਬਿਸ੍ਰਾਮੁ"
    },
    {
      "section_id": "section-00047",
      "start_time": 439.84,
      "end_time": 447.305,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਦਾਸ ਕੀ ਓਟ"
    },
    {
      "section_id": "section-00048",
      "start_time": 447.8,
      "end_time": 455.555,
      "transcript": "ਹਰਿ ਕੈ ਨਾਮਿ, ਉਧਰੇ ਜਨ ਕੋਟਿ"
    },
    {
      "section_id": "section-00049",
      "start_time": 455.555,
      "end_time": 463.275,
      "transcript": "ਹਰਿ ਜਸੁ ਕਰਤ, ਸੰਤ ਦਿਨੁ ਰਾਤਿ"
    },
    {
      "section_id": "section-00050",
      "start_time": 463.72,
      "end_time": 471.625,
      "transcript": "ਹਰਿ ਹਰਿ ਅਉਖਧੁ, ਸਾਧ ਕਮਾਤਿ"
    },
    {
      "section_id": "section-00051",
      "start_time": 471.625,
      "end_time": 479.075,
      "transcript": "ਹਰਿ ਜਨ ਕੈ, ਹਰਿ ਨਾਮੁ ਨਿਧਾਨੁ"
    },
    {
      "section_id": "section-00052",
      "start_time": 479.64,
      "end_time": 486.915,
      "transcript": "ਪਾਰਬ੍ਰਹਮਿ, ਜਨ ਕੀਨੋ ਦਾਨ"
    },
    {
      "section_id": "section-00053",
      "start_time": 487.36,
      "end_time": 494.805,
      "transcript": "ਮਨ ਤਨ ਰੰਗਿ, ਰਤੇ ਰੰਗ ਏਕੈ"
    },
    {
      "section_id": "section-00054",
      "start_time": 495.245,
      "end_time": 503.115,
      "transcript": "ਨਾਨਕ ਜਨ ਕੈ, ਬਿਰਤਿ ਬਿਬੇਕੈ"
    },
    {
      "section_id": "section-00055",
      "start_time": 510.96,
      "end_time": 518.335,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਜਨ ਕਉ ਮੁਕਤਿ ਜੁਗਤਿ"
    },
    {
      "section_id": "section-00056",
      "start_time": 518.76,
      "end_time": 526.265,
      "transcript": "ਹਰਿ ਕੈ ਨਾਮਿ, ਜਨ ਕਉ ਤ੍ਰਿਪਤਿ ਭੁਗਤਿ"
    },
    {
      "section_id": "section-00057",
      "start_time": 526.265,
      "end_time": 534.275,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਜਨ ਕਾ ਰੂਪ ਰੰਗੁ"
    },
    {
      "section_id": "section-00058",
      "start_time": 534.275,
      "end_time": 541.81,
      "transcript": "ਹਰਿ ਨਾਮੁ ਜਪਤ, ਕਬ ਪਰੈ ਨ ਭੰਗੁ"
    },
    {
      "section_id": "section-00059",
      "start_time": 541.81,
      "end_time": 549.395,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਜਨ ਕੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00060",
      "start_time": 549.92,
      "end_time": 557.255,
      "transcript": "ਹਰਿ ਕੈ ਨਾਮਿ, ਜਨ ਸੋਭਾ ਪਾਈ"
    },
    {
      "section_id": "section-00061",
      "start_time": 557.68,
      "end_time": 565.165,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਜਨ ਕਉ ਭੋਗ ਜੋਗ"
    },
    {
      "section_id": "section-00062",
      "start_time": 565.56,
      "end_time": 573.035,
      "transcript": "ਹਰਿ ਨਾਮੁ ਜਪਤ, ਕਛੁ ਨਾਹਿ ਬਿਓਗੁ"
    },
    {
      "section_id": "section-00063",
      "start_time": 573.035,
      "end_time": 580.785,
      "transcript": "ਜਨੁ ਰਾਤਾ, ਹਰਿ ਨਾਮ ਕੀ ਸੇਵਾ"
    },
    {
      "section_id": "section-00064",
      "start_time": 581.135,
      "end_time": 589.17,
      "transcript": "ਨਾਨਕ ਪੂਜੈ, ਹਰਿ ਹਰਿ ਦੇਵਾ"
    },
    {
      "section_id": "section-00065",
      "start_time": 600.8,
      "end_time": 608.245,
      "transcript": "ਹਰਿ ਹਰਿ ਜਨ ਕੈ, ਮਾਲੁ ਖਜੀਨਾ"
    },
    {
      "section_id": "section-00066",
      "start_time": 608.64,
      "end_time": 616.415,
      "transcript": "ਹਰਿ ਧਨੁ ਜਨ ਕਉ, ਆਪਿ ਪ੍ਰਭਿ ਦੀਨਾ"
    },
    {
      "section_id": "section-00067",
      "start_time": 616.415,
      "end_time": 624.005,
      "transcript": "ਹਰਿ ਹਰਿ ਜਨ ਕੈ, ਓਟ ਸਤਾਣੀ"
    },
    {
      "section_id": "section-00068",
      "start_time": 624.52,
      "end_time": 632.015,
      "transcript": "ਹਰਿ ਪ੍ਰਤਾਪਿ, ਜਨ ਅਵਰ ਨ ਜਾਣੀ"
    },
    {
      "section_id": "section-00069",
      "start_time": 632.24,
      "end_time": 639.575,
      "transcript": "ਓਤਿ ਪੋਤਿ, ਜਨ ਹਰਿ ਰਸਿ ਰਾਤੇ"
    },
    {
      "section_id": "section-00070",
      "start_time": 640.16,
      "end_time": 647.425,
      "transcript": "ਸੁੰਨ ਸਮਾਧਿ, ਨਾਮ ਰਸ ਮਾਤੇ"
    },
    {
      "section_id": "section-00071",
      "start_time": 647.855,
      "end_time": 655.245,
      "transcript": "ਆਠ ਪਹਰ, ਜਨੁ ਹਰਿ ਹਰਿ ਜਪੈ"
    },
    {
      "section_id": "section-00072",
      "start_time": 655.56,
      "end_time": 662.915,
      "transcript": "ਹਰਿ ਕਾ ਭਗਤੁ ਪ੍ਰਗਟ, ਨਹੀ ਛਪੈ"
    },
    {
      "section_id": "section-00073",
      "start_time": 663.32,
      "end_time": 670.475,
      "transcript": "ਹਰਿ ਕੀ ਭਗਤਿ, ਮੁਕਤਿ ਬਹੁ ਕਰੇ"
    },
    {
      "section_id": "section-00074",
      "start_time": 670.935,
      "end_time": 678.515,
      "transcript": "ਨਾਨਕ ਜਨ ਸੰਗਿ, ਕੇਤੇ ਤਰੇ"
    },
    {
      "section_id": "section-00075",
      "start_time": 686.44,
      "end_time": 693.765,
      "transcript": "ਪਾਰਜਾਤੁ ਇਹੁ, ਹਰਿ ਕੋ ਨਾਮ"
    },
    {
      "section_id": "section-00076",
      "start_time": 694.24,
      "end_time": 701.585,
      "transcript": "ਕਾਮਧੇਨ, ਹਰਿ ਹਰਿ ਗੁਣ ਗਾਮ"
    },
    {
      "section_id": "section-00077",
      "start_time": 702.04,
      "end_time": 709.335,
      "transcript": "ਸਭ ਤੇ ਊਤਮ, ਹਰਿ ਕੀ ਕਥਾ"
    },
    {
      "section_id": "section-00078",
      "start_time": 709.785,
      "end_time": 717.575,
      "transcript": "ਨਾਮੁ ਸੁਨਤ, ਦਰਦ ਦੁਖ ਲਥਾ"
    },
    {
      "section_id": "section-00079",
      "start_time": 725.225,
      "end_time": 732.735,
      "transcript": "ਨਾਮ ਕੀ ਮਹਿਮਾ, ਸੰਤ ਰਿਦ ਵਸੈ"
    },
    {
      "section_id": "section-00080",
      "start_time": 733.16,
      "end_time": 740.455,
      "transcript": "ਸੰਤ ਪ੍ਰਤਾਪਿ, ਦੁਰਤੁ ਸਭੁ ਨਸੈ"
    },
    {
      "section_id": "section-00081",
      "start_time": 740.88,
      "end_time": 748.145,
      "transcript": "ਸੰਤ ਕਾ ਸੰਗੁ, ਵਡਭਾਗੀ ਪਾਈਐ"
    },
    {
      "section_id": "section-00082",
      "start_time": 748.6,
      "end_time": 755.815,
      "transcript": "ਸੰਤ ਕੀ ਸੇਵਾ, ਨਾਮੁ ਧਿਆਈਐ"
    },
    {
      "section_id": "section-00083",
      "start_time": 756.245,
      "end_time": 763.625,
      "transcript": "ਨਾਮ ਤੁਲਿ, ਕਛੁ ਅਵਰੁ ਨ ਹੋਇ"
    },
    {

{
  "audio_file": "0208 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.336,
      "end_time": 14.083,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 22.6,
      "end_time": 36.395,
      "transcript": "ਸੁਖੀ ਬਸੈ ਮਸਕੀਨੀਆ, ਆਪੁ ਨਿਵਾਰਿ ਤਲੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.955,
      "end_time": 54.595,
      "transcript": "ਬਡੇ ਬਡੇ ਅਹੰਕਾਰੀਆ, ਨਾਨਕ ਗਰਬਿ ਗਲੇ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 63.24,
      "end_time": 70.4,
      "transcript": "ਜਿਸ ਕੈ ਅੰਤਰਿ, ਰਾਜ ਅਭਿਮਾਨੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 70.4,
      "end_time": 77.36,
      "transcript": "ਸੋ ਨਰਕਪਾਤੀ, ਹੋਵਤ ਸੁਆਨੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 77.36,
      "end_time": 84.14,
      "transcript": "ਜੋ ਜਾਨੈ, ਮੈ ਜੋਬਨਵੰਤੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 84.14,
      "end_time": 90.455,
      "transcript": "ਸੋ ਹੋਵਤ, ਬਿਸਟਾ ਕਾ ਜੰਤੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 91.255,
      "end_time": 98.185,
      "transcript": "ਆਪਸ ਕਉ, ਕਰਮਵੰਤੁ ਕਹਾਵੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 98.185,
      "end_time": 104.97,
      "transcript": "ਜਨਮਿ ਮਰੈ, ਬਹੁ ਜੋਨਿ ਭ੍ਰਮਾਵੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 104.97,
      "end_time": 112.16,
      "transcript": "ਧਨ ਭੂਮਿ ਕਾ, ਜੋ ਕਰੈ ਗੁਮਾਨੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 112.16,
      "end_time": 119.0,
      "transcript": "ਸੋ ਮੂਰਖੁ, ਅੰਧਾ ਅਗਿਆਨੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 119.0,
      "end_time": 125.96,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਜਿਸ ਕੈ ਹਿਰਦੈ ਗਰੀਬੀ ਬਸਾਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 125.96,
      "end_time": 133.172,
      "transcript": "ਨਾਨਕ ਈਹਾ ਮੁਕਤੁ, ਆਗੈ ਸੁਖੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 139.6,
      "end_time": 146.56,
      "transcript": "ਧਨਵੰਤਾ ਹੋਇ ਕਰਿ, ਗਰਬਾਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 146.56,
      "end_time": 153.36,
      "transcript": "ਤ੍ਰਿਣ ਸਮਾਨਿ, ਕਛੁ ਸੰਗਿ ਨ ਜਾਵੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 153.36,
      "end_time": 159.93,
      "transcript": "ਬਹੁ ਲਸਕਰ ਮਾਨੁਖ ਊਪਰਿ, ਕਰੇ ਆਸ"
    },
    {
      "section_id": "section-00017",
      "start_time": 159.93,
      "end_time": 166.88,
      "transcript": "ਪਲ ਭੀਤਰਿ, ਤਾ ਕਾ ਹੋਇ ਬਿਨਾਸ"
    },
    {
      "section_id": "section-00018",
      "start_time": 166.88,
      "end_time": 173.68,
      "transcript": "ਸਭ ਤੇ, ਆਪ ਜਾਨੈ ਬਲਵੰਤੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 173.68,
      "end_time": 180.525,
      "transcript": "ਖਿਨ ਮਹਿ, ਹੋਇ ਜਾਇ ਭਸਮੰਤੁ"
    },
    {
      "section_id": "section-00020",
      "start_time": 180.525,
      "end_time": 187.36,
      "transcript": "ਕਿਸੈ ਨ ਬਦੈ, ਆਪਿ ਅਹੰਕਾਰੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 187.36,
      "end_time": 194.085,
      "transcript": "ਧਰਮ ਰਾਇ, ਤਿਸੁ ਕਰੇ ਖੁਆਰੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 194.085,
      "end_time": 201.12,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਜਾ ਕਾ ਮਿਟੈ ਅਭਿਮਾਨੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 201.12,
      "end_time": 207.905,
      "transcript": "ਸੋ ਜਨੁ ਨਾਨਕ, ਦਰਗਹ ਪਰਵਾਨੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 214.795,
      "end_time": 221.64,
      "transcript": "ਕੋਟਿ ਕਰਮ ਕਰੈ, ਹਉ ਧਾਰੇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 221.64,
      "end_time": 228.485,
      "transcript": "ਸ੍ਰਮੁ ਪਾਵੈ, ਸਗਲੇ ਬਿਰਥਾਰੇ"
    },
    {
      "section_id": "section-00026",
      "start_time": 228.485,
      "end_time": 234.945,
      "transcript": "ਅਨਿਕ ਤਪਸਿਆ, ਕਰੇ ਅਹੰਕਾਰ"
    },
    {
      "section_id": "section-00027",
      "start_time": 235.4,
      "end_time": 242.2,
      "transcript": "ਨਰਕ ਸੁਰਗ, ਫਿਰਿ ਫਿਰਿ ਅਵਤਾਰ"
    },
    {
      "section_id": "section-00028",
      "start_time": 242.2,
      "end_time": 249.08,
      "transcript": "ਅਨਿਕ ਜਤਨ ਕਰਿ, ਆਤਮ ਨਹੀ ਦ੍ਰਵੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 249.08,
      "end_time": 255.455,
      "transcript": "ਹਰਿ ਦਰਗਹ, ਕਹੁ ਕੈਸੇ ਗਵੈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 255.855,
      "end_time": 262.51,
      "transcript": "ਆਪਸ ਕਉ, ਜੋ ਭਲਾ ਕਹਾਵੈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 262.51,
      "end_time": 269.44,
      "transcript": "ਤਿਸਹਿ ਭਲਾਈ, ਨਿਕਟਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00032",
      "start_time": 269.44,
      "end_time": 276.2,
      "transcript": "ਸਰਬ ਕੀ ਰੇਨ, ਜਾ ਕਾ ਮਨੁ ਹੋਇ"
    },
    {
      "section_id": "section-00033",
      "start_time": 276.2,
      "end_time": 283.578,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਤਾ ਕੀ ਨਿਰਮਲ ਸੋਇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 289.765,
      "end_time": 296.39,
      "transcript": "ਜਬ ਲਗੁ ਜਾਨੈ, ਮੁਝ ਤੇ ਕਛੁ ਹੋਇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 296.39,
      "end_time": 303.44,
      "transcript": "ਤਬ ਇਸ ਕਉ, ਸੁਖੁ ਨਾਹੀ ਕੋਇ"
    },
    {
      "section_id": "section-00036",
      "start_time": 303.44,
      "end_time": 310.16,
      "transcript": "ਜਬ ਇਹ ਜਾਨੈ, ਮੈ ਕਿਛੁ ਕਰਤਾ"
    },
    {
      "section_id": "section-00037",
      "start_time": 310.16,
      "end_time": 316.92,
      "transcript": "ਤਬ ਲਗੁ, ਗਰਭ ਜੋਨਿ ਮਹਿ ਫਿਰਤਾ"
    },
    {
      "section_id": "section-00038",
      "start_time": 316.92,
      "end_time": 323.725,
      "transcript": "ਜਬ ਧਾਰੈ, ਕੋਊ ਬੈਰੀ ਮੀਤੁ"
    },
    {
      "section_id": "section-00039",
      "start_time": 323.725,
      "end_time": 330.52,
      "transcript": "ਤਬ ਲਗੁ, ਨਿਹਚਲੁ ਨਾਹੀ ਚੀਤੁ"
    },
    {
      "section_id": "section-00040",
      "start_time": 330.52,
      "end_time": 337.32,
      "transcript": "ਜਬ ਲਗੁ, ਮੋਹ ਮਗਨ ਸੰਗਿ ਮਾਇ"
    },
    {
      "section_id": "section-00041",
      "start_time": 337.32,
      "end_time": 344.0,
      "transcript": "ਤਬ ਲਗੁ, ਧਰਮ ਰਾਇ ਦੇਇ ਸਜਾਇ"
    },
    {
      "section_id": "section-00042",
      "start_time": 344.0,
      "end_time": 350.72,
      "transcript": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ, ਬੰਧਨ ਤੂਟੈ"
    },
    {
      "section_id": "section-00043",
      "start_time": 350.72,
      "end_time": 357.851,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਨਾਨਕ ਹਉ ਛੂਟੈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 363.753,
      "end_time": 370.92,
      "transcript": "ਸਹਸ ਖਟੇ, ਲਖ ਕਉ ਉਠਿ ਧਾਵੈ"
    },
    {
      "section_id": "section-00045",
      "start_time": 370.92,
      "end_time": 377.76,
      "transcript": "ਤ੍ਰਿਪਤਿ ਨ ਆਵੈ, ਮਾਇਆ ਪਾਛੈ ਪਾਵੈ"
    },
    {
      "section_id": "section-00046",
      "start_time": 377.76,
      "end_time": 384.52,
      "transcript": "ਅਨਿਕ ਭੋਗ, ਬਿਖਿਆ ਕੇ ਕਰੈ"
    },
    {
      "section_id": "section-00047",
      "start_time": 384.52,
      "end_time": 391.28,
      "transcript": "ਨਹ ਤ੍ਰਿਪਤਾਵੈ, ਖਪਿ ਖਪਿ ਮਰੈ"
    },
    {
      "section_id": "section-00048",
      "start_time": 391.28,
      "end_time": 398.04,
      "transcript": "ਬਿਨਾ ਸੰਤੋਖ, ਨਹੀ ਕੋਊ ਰਾਜੈ"
    },
    {
      "section_id": "section-00049",
      "start_time": 398.04,
      "end_time": 404.96,
      "transcript": "ਸੁਪਨ ਮਨੋਰਥ, ਬ੍ਰਿਥੇ ਸਭ ਕਾਜੈ"
    },
    {
      "section_id": "section-00050",
      "start_time": 404.96,
      "end_time": 411.51,
      "transcript": "ਨਾਮ ਰੰਗਿ, ਸਰਬ ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00051",
      "start_time": 411.51,
      "end_time": 418.4,
      "transcript": "ਬਡਭਾਗੀ, ਕਿਸੈ ਪਰਾਪਤਿ ਹੋਇ"
    },
    {
      "section_id": "section-00052",
      "start_time": 418.4,
      "end_time": 425.12,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਆਪੇ ਆਪਿ"
    },
    {
      "section_id": "section-00053",
      "start_time": 425.12,
      "end_time": 432.078,
      "transcript": "ਸਦਾ ਸਦਾ, ਨਾਨਕ ਹਰਿ ਜਾਪਿ"
    },
    {
      "section_id": "section-00054",
      "start_time": 438.093,
      "end_time": 445.295,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਕਰਨੈਹਾਰੁ"
    },
    {
      "section_id": "section-00055",
      "start_time": 445.295,
      "end_time": 452.12,
      "transcript": "ਇਸ ਕੈ ਹਾਥਿ ਕਹਾ, ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00056",
      "start_time": 452.12,
      "end_time": 458.56,
      "transcript": "ਜੈਸੀ ਦ੍ਰਿਸਟਿ ਕਰੇ, ਤੈਸਾ ਹੋਇ"
    },
    {
      "section_id": "section-00057",
      "start_time": 458.56,
      "end_time": 465.56,
      "transcript": "ਆਪੇ ਆਪਿ, ਆਪਿ ਪ੍ਰਭੁ ਸੋਇ"
    },
    {
      "section_id": "section-00058",
      "start_time": 465.56,
      "end_time": 472.24,
      "transcript": "ਜੋ ਕਿਛੁ ਕੀਨੋ, ਸੁ ਅਪਨੈ ਰੰਗਿ"
    },
    {
      "section_id": "section-00059",
      "start_time": 472.24,
      "end_time": 478.815,
      "transcript": "ਸਭ ਤੇ ਦੂਰਿ, ਸਭਹੂ ਕੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00060",
      "start_time": 478.815,
      "end_time": 485.485,
      "transcript": "ਬੂਝੈ ਦੇਖੈ, ਕਰੈ ਬਿਬੇਕ"
    },
    {
      "section_id": "section-00061",
      "start_time": 485.775,
      "end_time": 492.48,
      "transcript": "ਆਪਹਿ ਏਕ, ਆਪਹਿ ਅਨੇਕ"
    },
    {
      "section_id": "section-00062",
      "start_time": 492.48,
      "end_time": 499.025,
      "transcript": "ਮਰੈ ਨ ਬਿਨਸੈ, ਆਵੈ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00063",
      "start_time": 499.025,
      "end_time": 505.935,
      "transcript": "ਨਾਨਕ ਸਦ ਹੀ, ਰਹਿਆ ਸਮਾਇ"
    },
    {
      "section_id": "section-00064",
      "start_time": 512.505,
      "end_time": 519.145,
      "transcript": "ਆਪਿ ਉਪਦੇਸੈ, ਸਮਝੈ ਆਪਿ"
    },
    {
      "section_id": "section-00065",
      "start_time": 519.145,
      "end_time": 525.66,
      "transcript": "ਆਪੇ ਰਚਿਆ, ਸਭ ਕੈ ਸਾਥਿ"
    },
    {
      "section_id": "section-00066",
      "start_time": 525.66,
      "end_time": 532.36,
      "transcript": "ਆਪਿ ਕੀਨੋ, ਆਪਨ ਬਿਸਥਾਰੁ"
    },
    {
      "section_id": "section-00067",
      "start_time": 532.36,
      "end_time": 539.28,
      "transcript": "ਸਭੁ ਕਛੁ ਉਸ ਕਾ, ਓਹੁ ਕਰਨੈਹਾਰੁ"
    },
    {
      "section_id": "section-00068",
      "start_time": 539.28,
      "end_time": 546.08,
      "transcript": "ਉਸ ਤੇ ਭਿੰਨ, ਕਹਹੁ ਕਿਛੁ ਹੋਇ"
    },
    {
      "section_id": "section-00069",
      "start_time": 546.08,
      "end_time": 552.8,
      "transcript": "ਥਾਨ ਥਨੰਤਰਿ, ਏਕੈ ਸੋਇ"
    },
    {
      "section_id": "section-00070",
      "start_time": 552.8,
      "end_time": 559.385,
      "transcript": "ਅਪੁਨੇ ਚਲਿਤ, ਆਪਿ ਕਰਣੈਹਾਰ"
    },
    {
      "section_id": "section-00071",
      "start_time": 559.385,
      "end_time": 566.2,
      "transcript": "ਕਉਤਕ ਕਰੈ, ਰੰਗ ਆਪਾਰ"
    },
    {
      "section_id": "section-00072",
      "start_time": 566.2,
      "end_time": 572.96,
      "transcript": "ਮਨ ਮਹਿ ਆਪਿ, ਮਨ ਅਪੁਨੇ ਮਾਹਿ"
    },
    {
      "section_id": "section-00073",
      "start_time": 572.96,
      "end_time": 579.485,
      "transcript": "ਨਾਨਕ ਕੀਮਤਿ, ਕਹਨੁ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00074",
      "start_time": 586.36,
      "end_time": 592.91,
      "transcript": "ਸਤਿ ਸਤਿ, ਸਤਿ ਪ੍ਰਭੁ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00075",
      "start_time": 592.91,
      "end_time": 599.375,
      "transcript": "ਗੁਰ ਪਰਸਾਦਿ, ਕਿਨੈ ਵਖਿਆਨੀ"
    },
    {
      "section_id": "section-00076",
      "start_time": 599.375,
      "end_time": 606.25,
      "transcript": "ਸਚੁ ਸਚੁ, ਸਚੁ ਸਭੁ ਕੀਨਾ"
    },
    {
      "section_id": "section-00077",
      "start_time": 606.25,
      "end_time": 613.04,
      "transcript": "ਕੋਟਿ ਮਧੇ, ਕਿਨੈ ਬਿਰਲੈ ਚੀਨਾ"
    },
    {
      "section_id": "section-00078",
      "start_time": 613.04,
      "end_time": 619.76,
      "transcript": "ਭਲਾ ਭਲਾ, ਭਲਾ ਤੇਰਾ ਰੂਪ"
    },
    {
      "section_id": "section-00079",
      "start_time": 619.76,
      "end_time": 626.52,
      "transcript": "ਅਤਿ ਸੁੰਦਰ, ਅਪਾਰ ਅਨੂਪ"
    },
    {
      "section_id": "section-00080",
      "start_time": 626.52,
      "end_time": 633.24,
      "transcript": "ਨਿਰਮਲ ਨਿਰਮਲ, ਨਿਰਮਲ ਤੇਰੀ ਬਾਣੀ"
    },
    {
      "section_id": "section-00081",
      "start_time": 633.24,
      "end_time": 639.675,
      "transcript": "ਘਟਿ ਘਟਿ ਸੁਨੀ ਸ੍ਰਵਨ, ਬਖੵਾਣੀ"
    },
    {
      "section_id": "section-00082",
      "start_time": 639.675,
      "end_time": 646.46,
      "transcript": "ਪਵਿਤ੍ਰ ਪਵਿਤ੍ਰ, ਪਵਿਤ੍ਰ ਪੁਨੀਤ"
    },
    {
      "section_id": "section-00083",
      "start_time": 646.46,
      "end_time": 653.104,
      "transcript": "ਨਾਮੁ ਜਪੈ, ਨਾਨਕ ਮਨਿ ਪ੍ਰੀਤਿ"
    },
    {
      "section_id": "section-00084",
      "start_time": 659.656,
      "end_time": 669.19,
      "transcript": "ਨਾਮੁ ਜਪੈ, ਨਾਨਕ ਮਨਿ ਪ੍ਰੀਤਿ"
    }
  ]
}

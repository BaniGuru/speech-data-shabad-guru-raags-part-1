  "audio_file": "0238 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.315,
      "end_time": 11.135,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.68,
      "end_time": 17.56,
      "transcript": "ਧੰਧੜੇ ਕੁਲਾਹ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.56,
      "end_time": 23.315,
      "transcript": "ਚਿਤਿ ਨ ਆਵੈ ਹੇਕੜੋ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.555,
      "end_time": 29.35,
      "transcript": "ਨਾਨਕ ਸੇਈ ਤੰਨ ਫੁਟੰਨਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.35,
      "end_time": 35.005,
      "transcript": "ਜਿਨਾ ਸਾਂਈ ਵਿਸਰੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 35.2,
      "end_time": 38.155,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 38.155,
      "end_time": 44.015,
      "transcript": "ਪਰੇਤਹੁ ਕੀਤੋਨੁ ਦੇਵਤਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 44.48,
      "end_time": 50.035,
      "transcript": "ਤਿਨਿ ਕਰਣੈਹਾਰੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 50.335,
      "end_time": 56.375,
      "transcript": "ਸਭੇ ਸਿਖ ਉਬਾਰਿਅਨੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 56.375,
      "end_time": 61.935,
      "transcript": "ਪ੍ਰਭਿ ਕਾਜ ਸਵਾਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 62.44,
      "end_time": 68.247,
      "transcript": "ਨਿੰਦਕ ਪਕੜਿ ਪਛਾੜਿਅਨੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 68.247,
      "end_time": 74.005,
      "transcript": "ਝੂਠੇ ਦਰਬਾਰੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 74.345,
      "end_time": 79.995,
      "transcript": "ਨਾਨਕ ਕਾ ਪ੍ਰਭੁ ਵਡਾ ਹੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 80.335,
      "end_time": 85.835,
      "transcript": "ਆਪਿ ਸਾਜਿ ਸਵਾਰੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 86.28,
      "end_time": 88.005,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 97.356,
      "end_time": 104.935,
      "transcript": "ਪ੍ਰਭੁ ਬੇਅੰਤੁ ਕਿਛੁ ਅੰਤੁ ਨਾਹਿ, ਸਭੁ ਤਿਸੈ ਕਰਣਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 105.16,
      "end_time": 112.555,
      "transcript": "ਅਗਮ ਅਗੋਚਰੁ ਸਾਹਿਬੋ, ਜੀਅਾਂ ਕਾ ਪਰਣਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 113.0,
      "end_time": 120.475,
      "transcript": "ਹਸਤ ਦੇਇ ਪ੍ਰਤਿਪਾਲਦਾ, ਭਰਣ ਪੋਖਣੁ ਕਰਣਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 120.8,
      "end_time": 128.485,
      "transcript": "ਮਿਹਰਵਾਨੁ ਬਖਸਿੰਦੁ ਆਪਿ, ਜਪਿ ਸਚੇ ਤਰਣਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 128.64,
      "end_time": 136.685,
      "transcript": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸੋ ਭਲਾ, ਨਾਨਕ ਦਾਸ ਸਰਣਾ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.886,
      "end_time": 8.951,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 8.951,
      "end_time": 22.653,
      "transcript": "ਮਾਝ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 44.08,
      "end_time": 51.56,
      "transcript": "ਮੈ ਹਰਿ ਨਾਮੈ ਹਰਿ ਬਿਰਹੁ ਲਗਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 51.56,
      "end_time": 62.315,
      "transcript": "ਮੇਰਾ ਹਰਿ ਪ੍ਰਭੁ ਮਿਤੁ ਮਿਲੈ ਸੁਖੁ ਪਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 62.315,
      "end_time": 69.242,
      "transcript": "ਹਰਿ ਪ੍ਰਭੁ ਦੇਖਿ ਜੀਵਾ ਮੇਰੀ ਮਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 69.242,
      "end_time": 79.477,
      "transcript": "ਮੇਰਾ ਨਾਮੁ ਸਖਾ ਹਰਿ ਭਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 79.477,
      "end_time": 87.069,
      "transcript": "ਗੁਣ ਗਾਵਹੁ ਸੰਤ ਜੀਉ, ਮੇਰੇ ਹਰਿ ਪ੍ਰਭ ਕੇਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 87.069,
      "end_time": 94.232,
      "transcript": "ਜਪਿ ਗੁਰਮੁਖਿ ਨਾਮੁ ਜੀਉ, ਭਾਗ ਵਡੇਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 94.232,
      "end_time": 104.672,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜੀਉ ਪ੍ਰਾਨ ਹਰਿ ਮੇਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 104.672,
      "end_time": 115.4,
      "transcript": "ਫਿਰਿ ਬਹੁੜਿ ਨ ਭਵਜਲ ਫੇਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 115.4,
      "end_time": 122.68,
      "transcript": "ਕਿਉ ਹਰਿ ਪ੍ਰਭ ਵੇਖਾ, ਮੇਰੈ ਮਨਿ ਤਨਿ ਚਾਉ ਜੀਉ"
    },
    {
      "section_id": "section-00012",
      "start_time": 122.68,
      "end_time": 133.173,
      "transcript": "ਹਰਿ ਮੇਲਹੁ ਸੰਤ ਜੀਉ ਮਨਿ ਲਗਾ ਭਾਉ ਜੀਉ"
    },
    {
      "section_id": "section-00013",
      "start_time": 133.173,
      "end_time": 140.378,
      "transcript": "ਗੁਰਸਬਦੀ ਪਾਈਐ, ਹਰਿ ਪ੍ਰੀਤਮ ਰਾਉ ਜੀਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 140.378,
      "end_time": 151.12,
      "transcript": "ਵਡਭਾਗੀ ਜਪਿ ਨਾਉ ਜੀਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 151.12,
      "end_time": 158.151,
      "transcript": "ਮੇਰੈ ਮਨਿ ਤਨਿ ਵਡੜੀ, ਗੋਵਿੰਦ ਪ੍ਰਭ ਆਸਾ ਜੀਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 158.151,
      "end_time": 165.357,
      "transcript": "ਹਰਿ ਮੇਲਹੁ ਸੰਤ ਜੀਉ, ਗੋਵਿਦ ਪ੍ਰਭ ਪਾਸਾ ਜੀਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 165.357,
      "end_time": 176.0,
      "transcript": "ਸਤਿਗੁਰ ਮਤਿ ਨਾਮੁ ਸਦਾ ਪਰਗਾਸਾ ਜੀਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 176.0,
      "end_time": 186.64,
      "transcript": "ਜਨ ਨਾਨਕ ਪੂਰਿਅੜੀ ਮਨਿ ਆਸਾ ਜੀਉ"
    }
  ]
}

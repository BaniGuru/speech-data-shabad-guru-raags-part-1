{
  "audio_file": "0143 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.155,
      "end_time": 8.07,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.32,
      "end_time": 24.2,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਹਰਿ ਨਾਮੁ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 24.2,
      "end_time": 32.045,
      "transcript": "ਤਬ ਤੇ, ਧਾਵਤੁ ਮਨੁ ਤ੍ਰਿਪਤਾਇਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.235,
      "end_time": 40.16,
      "transcript": "ਸੁਖ ਬਿਸ੍ਰਾਮੁ ਪਾਇਆ, ਗੁਣ ਗਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 40.16,
      "end_time": 48.305,
      "transcript": "ਸ੍ਰਮੁ ਮਿਟਿਆ, ਮੇਰੀ ਹਤੀ ਬਲਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.08,
      "end_time": 75.955,
      "transcript": "ਚਰਨ ਕਮਲ, ਅਰਾਧਿ ਭਗਵੰਤਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.955,
      "end_time": 83.865,
      "transcript": "ਹਰਿ ਸਿਮਰਨ ਤੇ, ਮਿਟੀ ਮੇਰੀ ਚਿੰਤਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.08,
      "end_time": 92.04,
      "transcript": "ਸਭ ਤਜਿ ਅਨਾਥੁ, ਏਕ ਸਰਣਿ ਆਇਓ"
    },
    {
      "section_id": "section-00009",
      "start_time": 92.04,
      "end_time": 99.08,
      "transcript": "ਊਚ ਅਸਥਾਨੁ, ਤਬ ਸਹਜੇ ਪਾਇਓ"
    },
    {
      "section_id": "section-00010",
      "start_time": 100.035,
      "end_time": 107.96,
      "transcript": "ਦੂਖੁ ਦਰਦੁ, ਭਰਮੁ ਭਉ ਨਸਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 107.96,
      "end_time": 115.395,
      "transcript": "ਕਰਣਹਾਰੁ, ਨਾਨਕ ਮਨਿ ਬਸਿਆ"
    }
  ]
}

{
  "audio_file": "0146 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.425,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.975,
      "end_time": 19.44,
      "transcript": "ਗੁਰ ਜੀ ਕੇ, ਦਰਸਨ ਕਉ ਬਲਿ ਜਾਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.44,
      "end_time": 25.735,
      "transcript": "ਜਪਿ ਜਪਿ ਜੀਵਾ, ਸਤਿਗੁਰ ਨਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.735,
      "end_time": 31.665,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਪੂਰਨ ਗੁਰਦੇਵ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.08,
      "end_time": 40.145,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਲਾਗਉ ਤੇਰੀ ਸੇਵ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 47.92,
      "end_time": 54.24,
      "transcript": "ਚਰਨ ਕਮਲ, ਹਿਰਦੈ ਉਰ ਧਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.24,
      "end_time": 60.81,
      "transcript": "ਮਨ ਤਨ ਧਨ, ਗੁਰ ਪ੍ਰਾਨ ਅਧਾਰੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.81,
      "end_time": 66.93,
      "transcript": "ਸਫਲ ਜਨਮੁ, ਹੋਵੈ ਪਰਵਾਣੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.93,
      "end_time": 73.475,
      "transcript": "ਗੁਰੁ ਪਾਰਬ੍ਰਹਮੁ, ਨਿਕਟਿ ਕਰਿ ਜਾਣੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.685,
      "end_time": 86.235,
      "transcript": "ਸੰਤ ਧੂਰਿ, ਪਾਈਐ ਵਡਭਾਗੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.235,
      "end_time": 92.445,
      "transcript": "ਨਾਨਕ ਗੁਰ ਭੇਟਤ, ਹਰਿ ਸਿਉ ਲਿਵ ਲਾਗੀ"
    }
  ]
}

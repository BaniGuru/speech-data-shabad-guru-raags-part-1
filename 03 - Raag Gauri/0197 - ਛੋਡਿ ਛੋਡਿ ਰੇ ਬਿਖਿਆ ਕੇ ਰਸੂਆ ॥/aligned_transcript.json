  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.645,
      "end_time": 15.456,
      "transcript": "ਗਉੜੀ₃ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 35.104,
      "end_time": 43.08,
      "transcript": "ਛੋਡਿ ਛੋਡਿ ਰੇ, ਬਿਖਿਆ ਕੇ ਰਸੂਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 43.08,
      "end_time": 50.815,
      "transcript": "ਉਰਝਿ ਰਹਿਓ ਰੇ ਬਾਵਰ ਗਾਵਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 50.815,
      "end_time": 63.355,
      "transcript": "ਜਿਉ ਕਿਰਖੈ ਹਰਿਆਇਓ ਪਸੂਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 74.425,
      "end_time": 81.895,
      "transcript": "ਜੋ ਜਾਨਹਿ ਤੂੰ ਅਪੁਨੇ ਕਾਜੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 82.295,
      "end_time": 89.912,
      "transcript": "ਸੋ ਸੰਗਿ ਨ ਚਾਲੈ ਤੇਰੈ ਤਸੂਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 89.912,
      "end_time": 97.548,
      "transcript": "ਨਾਗੋ ਆਇਓ ਨਾਗ ਸਿਧਾਸੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 97.548,
      "end_time": 105.215,
      "transcript": "ਫੇਰਿ ਫਿਰਿਓ ਅਰੁ ਕਾਲਿ ਗਰਸੂਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 105.84,
      "end_time": 113.438,
      "transcript": "ਪੇਖਿ ਪੇਖਿ ਰੇ ਕਸੁੰਭ ਕੀ ਲੀਲਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 113.438,
      "end_time": 120.886,
      "transcript": "ਰਾਚਿ ਮਾਚਿ ਤਿਨਹੂੰ ਲਉ ਹਸੂਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 120.886,
      "end_time": 128.625,
      "transcript": "ਛੀਜਤ ਡੋਰਿ ਦਿਨਸੁ ਅਰੁ ਰੈਨੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 128.625,
      "end_time": 136.225,
      "transcript": "ਜੀਅ ਕੋ ਕਾਜੁ ਨ ਕੀਨੋ ਕਛੂਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 136.76,
      "end_time": 143.765,
      "transcript": "ਕਰਤ ਕਰਤ ਇਵ ਹੀ ਬਿਰਧਾਨੋ"
    },
    {
      "section_id": "section-00014",
      "start_time": 144.365,
      "end_time": 151.715,
      "transcript": "ਹਾਰਿਓ ਉਕਤੇ ਤਨੁ ਖੀਨਸੂਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 152.12,
      "end_time": 159.175,
      "transcript": "ਜਿਉ ਮੋਹਿਓ ਉਨਿ ਮੋਹਨੀ ਬਾਲਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 159.8,
      "end_time": 167.135,
      "transcript": "ਉਸ ਤੇ ਘਟੈ ਨਾਹੀ ਰੁਚ ਚਸੂਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 175.295,
      "end_time": 182.535,
      "transcript": "ਜਗੁ ਐਸਾ ਮੋਹਿ ਗੁਰਹਿ ਦਿਖਾਇਓ"
    },
    {
      "section_id": "section-00018",
      "start_time": 182.955,
      "end_time": 190.69,
      "transcript": "ਤਉ ਸਰਣਿ ਪਰਿਓ ਤਜਿ ਗਰਬਸੂਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 190.69,
      "end_time": 198.145,
      "transcript": "ਮਾਰਗੁ ਪ੍ਰਭ ਕੋ ਸੰਤਿ ਬਤਾਇਓ"
    },
    {
      "section_id": "section-00020",
      "start_time": 198.64,
      "end_time": 205.735,
      "transcript": "ਦ੍ਰਿੜੀ ਨਾਨਕ ਦਾਸ ਭਗਤਿ ਹਰਿ ਜਸੂਆ"
    }
  ]
}

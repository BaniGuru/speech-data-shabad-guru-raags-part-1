{
  "audio_file": "0223 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.795,
      "end_time": 13.285,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 25.465,
      "end_time": 33.955,
      "transcript": "ਦੁਰਮਤਿ ਹਰੀ ਸੇਵਾ ਕਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 34.72,
      "end_time": 43.145,
      "transcript": "ਭੇਟੇ ਸਾਧ ਕ੍ਰਿਪਾਲ"
    },
    {
      "section_id": "section-00004",
      "start_time": 43.695,
      "end_time": 52.315,
      "transcript": "ਨਾਨਕ ਪ੍ਰਭ ਸਿਉ ਮਿਲਿ ਰਹੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.685,
      "end_time": 64.405,
      "transcript": "ਬਿਨਸੇ ਸਗਲ ਜੰਜਾਲ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 74.36,
      "end_time": 79.0,
      "transcript": "ਦੁਆਦਸੀ, ਦਾਨੁ ਨਾਮੁ ਇਸਨਾਨੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 79.0,
      "end_time": 83.28,
      "transcript": "ਹਰਿ ਕੀ ਭਗਤਿ ਕਰਹੁ, ਤਜਿ ਮਾਨੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 83.28,
      "end_time": 87.875,
      "transcript": "ਹਰਿ ਅੰਮ੍ਰਿਤ ਪਾਨ ਕਰਹੁ, ਸਾਧਸੰਗਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 87.875,
      "end_time": 92.76,
      "transcript": "ਮਨ ਤ੍ਰਿਪਤਾਸੈ, ਕੀਰਤਨ ਪ੍ਰਭ ਰੰਗਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.76,
      "end_time": 97.32,
      "transcript": "ਕੋਮਲ ਬਾਣੀ, ਸਭ ਕਉ ਸੰਤੋਖੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.32,
      "end_time": 101.91,
      "transcript": "ਪੰਚ ਭੂ ਆਤਮਾ, ਹਰਿ ਨਾਮ ਰਸਿ ਪੋਖੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 101.91,
      "end_time": 106.48,
      "transcript": "ਗੁਰ ਪੂਰੇ ਤੇ, ਏਹ ਨਿਹਚਉ ਪਾਈਐ"
    },
    {
      "section_id": "section-00013",
      "start_time": 106.48,
      "end_time": 113.115,
      "transcript": "ਨਾਨਕ ਰਾਮ ਰਮਤ, ਫਿਰਿ ਜੋਨਿ ਨ ਆਈਐ"
    }
  ]
}

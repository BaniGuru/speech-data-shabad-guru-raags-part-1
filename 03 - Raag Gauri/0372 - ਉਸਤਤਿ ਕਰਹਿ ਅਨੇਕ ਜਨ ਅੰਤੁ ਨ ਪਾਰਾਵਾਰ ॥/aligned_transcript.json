{
  "audio_file": "0206 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.995,
      "end_time": 9.859,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 20.19,
      "end_time": 28.095,
      "transcript": "ਉਸਤਤਿ ਕਰਹਿ ਅਨੇਕ ਜਨ"
    },
    {
      "section_id": "section-00003",
      "start_time": 28.92,
      "end_time": 36.755,
      "transcript": "ਅੰਤੁ ਨ ਪਾਰਾਵਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 37.605,
      "end_time": 45.775,
      "transcript": "ਨਾਨਕ ਰਚਨਾ ਪ੍ਰਭਿ ਰਚੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.28,
      "end_time": 58.005,
      "transcript": "ਬਹੁ ਬਿਧਿ ਅਨਿਕ ਪ੍ਰਕਾਰ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.821,
      "end_time": 77.015,
      "transcript": "ਕਈ ਕੋਟਿ, ਹੋਏ ਪੂਜਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 77.48,
      "end_time": 86.095,
      "transcript": "ਕਈ ਕੋਟਿ, ਆਚਾਰ ਬਿਉਹਾਰੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 86.395,
      "end_time": 95.495,
      "transcript": "ਕਈ ਕੋਟਿ, ਭਏ ਤੀਰਥ ਵਾਸੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 95.495,
      "end_time": 104.305,
      "transcript": "ਕਈ ਕੋਟਿ, ਬਨ ਭ੍ਰਮਹਿ ਉਦਾਸੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 104.305,
      "end_time": 112.965,
      "transcript": "ਕਈ ਕੋਟਿ, ਬੇਦ ਕੇ ਸ੍ਰੋਤੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 113.385,
      "end_time": 122.4,
      "transcript": "ਕਈ ਕੋਟਿ, ਤਪੀਸੁਰ ਹੋਤੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 122.4,
      "end_time": 130.655,
      "transcript": "ਕਈ ਕੋਟਿ, ਆਤਮ ਧਿਆਨੁ ਧਾਰਹਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 131.2,
      "end_time": 139.605,
      "transcript": "ਕਈ ਕੋਟਿ ਕਬਿ, ਕਾਬਿ ਬੀਚਾਰਹਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 140.0,
      "end_time": 148.345,
      "transcript": "ਕਈ ਕੋਟਿ, ਨਵਤਨ ਨਾਮ ਧਿਆਵਹਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 148.745,
      "end_time": 157.575,
      "transcript": "ਨਾਨਕ ਕਰਤੇ ਕਾ, ਅੰਤੁ ਨ ਪਾਵਹਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 166.245,
      "end_time": 174.955,
      "transcript": "ਕਈ ਕੋਟਿ, ਭਏ ਅਭਿਮਾਨੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 174.955,
      "end_time": 183.405,
      "transcript": "ਕਈ ਕੋਟਿ, ਅੰਧ ਅਗਿਆਨੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 183.715,
      "end_time": 191.915,
      "transcript": "ਕਈ ਕੋਟਿ, ਕਿਰਪਨ ਕਠੋਰ"
    },
    {
      "section_id": "section-00019",
      "start_time": 192.4,
      "end_time": 201.08,
      "transcript": "ਕਈ ਕੋਟਿ, ਅਭਿਗ ਆਤਮ ਨਿਕੋਰ"
    },
    {
      "section_id": "section-00020",
      "start_time": 201.08,
      "end_time": 209.195,
      "transcript": "ਕਈ ਕੋਟਿ, ਪਰ ਦਰਬ ਕਉ ਹਿਰਹਿ"
    },
    {
      "section_id": "section-00021",
      "start_time": 209.665,
      "end_time": 217.805,
      "transcript": "ਕਈ ਕੋਟਿ, ਪਰ ਦੂਖਨਾ ਕਰਹਿ"
    },
    {
      "section_id": "section-00022",
      "start_time": 218.28,
      "end_time": 226.285,
      "transcript": "ਕਈ ਕੋਟਿ, ਮਾਇਆ ਸ੍ਰਮ ਮਾਹਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 226.815,
      "end_time": 235.105,
      "transcript": "ਕਈ ਕੋਟਿ, ਪਰਦੇਸ ਭ੍ਰਮਾਹਿ"
    },
    {
      "section_id": "section-00024",
      "start_time": 235.325,
      "end_time": 243.425,
      "transcript": "ਜਿਤੁ ਜਿਤੁ ਲਾਵਹੁ, ਤਿਤੁ ਤਿਤੁ ਲਗਨਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 243.955,
      "end_time": 252.825,
      "transcript": "ਨਾਨਕ ਕਰਤੇ ਕੀ, ਜਾਨੈ ਕਰਤਾ ਰਚਨਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 260.865,
      "end_time": 269.65,
      "transcript": "ਕਈ ਕੋਟਿ, ਸਿਧ ਜਤੀ ਜੋਗੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 269.65,
      "end_time": 278.225,
      "transcript": "ਕਈ ਕੋਟਿ, ਰਾਜੇ ਰਸ ਭੋਗੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 278.225,
      "end_time": 286.435,
      "transcript": "ਕਈ ਕੋਟਿ, ਪੰਖੀ ਸਰਪ ਉਪਾਏ"
    },
    {
      "section_id": "section-00029",
      "start_time": 286.845,
      "end_time": 294.915,
      "transcript": "ਕਈ ਕੋਟਿ, ਪਾਥਰ ਬਿਰਖ ਨਿਪਜਾਏ"
    },
    {
      "section_id": "section-00030",
      "start_time": 295.4,
      "end_time": 303.815,
      "transcript": "ਕਈ ਕੋਟਿ, ਪਵਣ ਪਾਣੀ ਬੈਸੰਤਰ"
    },
    {
      "section_id": "section-00031",
      "start_time": 303.815,
      "end_time": 312.135,
      "transcript": "ਕਈ ਕੋਟਿ, ਦੇਸ ਭੂ ਮੰਡਲ"
    },
    {
      "section_id": "section-00032",
      "start_time": 312.135,
      "end_time": 320.115,
      "transcript": "ਕਈ ਕੋਟਿ, ਸਸੀਅਰ ਸੂਰ ਨਖੵਤ੍ਰ"
    },
    {
      "section_id": "section-00033",
      "start_time": 320.305,
      "end_time": 329.015,
      "transcript": "ਕਈ ਕੋਟਿ ਦੇਵ ਦਾਨਵ, ਇੰਦ੍ਰ ਸਿਰਿ ਛਤ੍ਰ"
    },
    {
      "section_id": "section-00034",
      "start_time": 329.015,
      "end_time": 337.455,
      "transcript": "ਸਗਲ ਸਮਗ੍ਰੀ, ਅਪਨੈ ਸੂਤਿ ਧਾਰੈ"
    },
    {
      "section_id": "section-00035",
      "start_time": 337.455,
      "end_time": 346.005,
      "transcript": "ਨਾਨਕ ਜਿਸੁ ਜਿਸੁ ਭਾਵੈ, ਤਿਸੁ ਤਿਸੁ ਨਿਸਤਾਰੈ"
    },
    {
      "section_id": "section-00036",
      "start_time": 354.071,
      "end_time": 362.925,
      "transcript": "ਕਈ ਕੋਟਿ, ਰਾਜਸ ਤਾਮਸ ਸਾਤਕ"
    },
    {
      "section_id": "section-00037",
      "start_time": 362.925,
      "end_time": 371.46,
      "transcript": "ਕਈ ਕੋਟਿ ਬੇਦ ਪੁਰਾਨ, ਸਿਮ੍ਰਿਤਿ ਅਰੁ ਸਾਸਤ"
    },
    {
      "section_id": "section-00038",
      "start_time": 371.46,
      "end_time": 379.575,
      "transcript": "ਕਈ ਕੋਟਿ, ਕੀਏ ਰਤਨ ਸਮੁਦ"
    },
    {
      "section_id": "section-00039",
      "start_time": 379.92,
      "end_time": 388.4,
      "transcript": "ਕਈ ਕੋਟਿ, ਨਾਨਾ ਪ੍ਰਕਾਰ ਜੰਤ"
    },
    {
      "section_id": "section-00040",
      "start_time": 388.4,
      "end_time": 396.8,
      "transcript": "ਕਈ ਕੋਟਿ, ਕੀਏ ਚਿਰ ਜੀਵੇ"
    },
    {
      "section_id": "section-00041",
      "start_time": 396.8,
      "end_time": 405.09,
      "transcript": "ਕਈ ਕੋਟਿ, ਗਿਰੀ ਮੇਰ ਸੁਵਰਨ ਥੀਵੇ"
    },
    {
      "section_id": "section-00042",
      "start_time": 405.09,
      "end_time": 413.085,
      "transcript": "ਕਈ ਕੋਟਿ, ਜਖੵ ਕਿੰਨਰ ਪਿਸਾਚ"
    },
    {
      "section_id": "section-00043",
      "start_time": 413.52,
      "end_time": 421.665,
      "transcript": "ਕਈ ਕੋਟਿ, ਭੂਤ ਪ੍ਰੇਤ ਸੂਕਰ ਮ੍ਰਿਗਾਚ"
    },
    {
      "section_id": "section-00044",
      "start_time": 421.88,
      "end_time": 429.795,
      "transcript": "ਸਭ ਤੇ ਨੇਰੈ, ਸਭਹੂ ਤੇ ਦੂਰਿ"
    },
    {
      "section_id": "section-00045",
      "start_time": 430.175,
      "end_time": 438.465,
      "transcript": "ਨਾਨਕ ਆਪਿ ਅਲਿਪਤੁ, ਰਹਿਆ ਭਰਪੂਰਿ"
    },
    {
      "section_id": "section-00046",
      "start_time": 446.96,
      "end_time": 455.123,
      "transcript": "ਕਈ ਕੋਟਿ, ਪਾਤਾਲ ਕੇ ਵਾਸੀ"
    },
    {
      "section_id": "section-00047",
      "start_time": 455.123,
      "end_time": 463.255,
      "transcript": "ਕਈ ਕੋਟਿ, ਨਰਕ ਸੁਰਗ ਨਿਵਾਸੀ"
    },
    {
      "section_id": "section-00048",
      "start_time": 463.72,
      "end_time": 471.743,
      "transcript": "ਕਈ ਕੋਟਿ, ਜਨਮਹਿ ਜੀਵਹਿ ਮਰਹਿ"
    },
    {
      "section_id": "section-00049",
      "start_time": 471.743,
      "end_time": 480.105,
      "transcript": "ਕਈ ਕੋਟਿ, ਬਹੁ ਜੋਨੀ ਫਿਰਹਿ"
    },
    {
      "section_id": "section-00050",
      "start_time": 480.105,
      "end_time": 488.275,
      "transcript": "ਕਈ ਕੋਟਿ, ਬੈਠਤ ਹੀ ਖਾਹਿ"
    },
    {
      "section_id": "section-00051",
      "start_time": 488.685,
      "end_time": 496.665,
      "transcript": "ਕਈ ਕੋਟਿ, ਘਾਲਹਿ ਥਕਿ ਪਾਹਿ"
    },
    {
      "section_id": "section-00052",
      "start_time": 497.08,
      "end_time": 505.054,
      "transcript": "ਕਈ ਕੋਟਿ, ਕੀਏ ਧਨਵੰਤ"
    },
    {
      "section_id": "section-00053",
      "start_time": 505.054,
      "end_time": 513.435,
      "transcript": "ਕਈ ਕੋਟਿ, ਮਾਇਆ ਮਹਿ ਚਿੰਤ"
    },
    {
      "section_id": "section-00054",
      "start_time": 513.655,
      "end_time": 522.035,
      "transcript": "ਜਹ ਜਹ ਭਾਣਾ, ਤਹ ਤਹ ਰਾਖੇ"
    },
    {
      "section_id": "section-00055",
      "start_time": 522.035,
      "end_time": 530.525,
      "transcript": "ਨਾਨਕ ਸਭੁ ਕਿਛੁ, ਪ੍ਰਭ ਕੈ ਹਾਥੇ"
    },
    {
      "section_id": "section-00056",
      "start_time": 538.785,
      "end_time": 547.225,
      "transcript": "ਕਈ ਕੋਟਿ, ਭਏ ਬੈਰਾਗੀ"
    },
    {
      "section_id": "section-00057",
      "start_time": 547.225,
      "end_time": 555.72,
      "transcript": "ਰਾਮ ਨਾਮ ਸੰਗਿ, ਤਿਨਿ ਲਿਵ ਲਾਗੀ"
    },
    {
      "section_id": "section-00058",
      "start_time": 555.72,
      "end_time": 563.755,
      "transcript": "ਕਈ ਕੋਟਿ, ਪ੍ਰਭ ਕਉ ਖੋਜੰਤੇ"
    },
    {
      "section_id": "section-00059",
      "start_time": 564.085,
      "end_time": 572.376,
      "transcript": "ਆਤਮ ਮਹਿ, ਪਾਰਬ੍ਰਹਮੁ ਲਹੰਤੇ"
    },
    {
      "section_id": "section-00060",
      "start_time": 572.376,
      "end_time": 580.165,
      "transcript": "ਕਈ ਕੋਟਿ, ਦਰਸਨ ਪ੍ਰਭ ਪਿਆਸ"
    },
    {
      "section_id": "section-00061",
      "start_time": 580.76,
      "end_time": 588.768,
      "transcript": "ਤਿਨ ਕਉ ਮਿਲਿਓ, ਪ੍ਰਭੁ ਅਬਿਨਾਸ"
    },
    {
      "section_id": "section-00062",
      "start_time": 588.768,
      "end_time": 597.36,
      "transcript": "ਕਈ ਕੋਟਿ, ਮਾਗਹਿ ਸਤਸੰਗੁ"
    },
    {
      "section_id": "section-00063",
      "start_time": 597.36,
      "end_time": 605.505,
      "transcript": "ਪਾਰਬ੍ਰਹਮ, ਤਿਨ ਲਾਗਾ ਰੰਗੁ"
    },
    {
      "section_id": "section-00064",
      "start_time": 605.505,
      "end_time": 613.665,
      "transcript": "ਜਿਨ ਕਉ ਹੋਏ, ਆਪਿ ਸੁਪ੍ਰਸੰਨ"
    },
    {
      "section_id": "section-00065",
      "start_time": 613.855,
      "end_time": 623.695,
      "transcript": "ਨਾਨਕ ਤੇ ਜਨ, ਸਦਾ ਧਨਿ ਧੰਨਿ"
    },
    {
      "section_id": "section-00066",
      "start_time": 630.605,
      "end_time": 638.725,
      "transcript": "ਕਈ ਕੋਟਿ, ਖਾਣੀ ਅਰੁ ਖੰਡ"
    },
    {
      "section_id": "section-00067",
      "start_time": 639.08,
      "end_time": 647.085,
      "transcript": "ਕਈ ਕੋਟਿ, ਅਕਾਸ ਬ੍ਰਹਮੰਡ"
    },
    {
      "section_id": "section-00068",
      "start_time": 647.44,
      "end_time": 655.465,
      "transcript": "ਕਈ ਕੋਟਿ, ਹੋਏ ਅਵਤਾਰ"
    },
    {
      "section_id": "section-00069",
      "start_time": 655.8,
      "end_time": 663.635,
      "transcript": "ਕਈ ਜੁਗਤਿ, ਕੀਨੋ ਬਿਸਥਾਰ"
    },
    {
      "section_id": "section-00070",
      "start_time": 664.08,
      "end_time": 672.025,
      "transcript": "ਕਈ ਬਾਰ, ਪਸਰਿਓ ਪਾਸਾਰ"
    },
    {
      "section_id": "section-00071",
      "start_time": 672.52,
      "end_time": 680.405,
      "transcript": "ਸਦਾ ਸਦਾ, ਇਕੁ ਏਕੰਕਾਰ"
    },
    {
      "section_id": "section-00072",
      "start_time": 680.84,
      "end_time": 688.865,
      "transcript": "ਕਈ ਕੋਟਿ, ਕੀਨੇ ਬਹੁ ਭਾਤਿ"
    },
    {
      "section_id": "section-00073",
      "start_time": 688.865,
      "end_time": 697.225,
      "transcript": "ਪ੍ਰਭ ਤੇ ਹੋਏ, ਪ੍ਰਭ ਮਾਹਿ ਸਮਾਤਿ"
    },
    {
      "section_id": "section-00074",
      "start_time": 697.52,
      "end_time": 705.215,
      "transcript": "ਤਾ ਕਾ ਅੰਤੁ, ਨ ਜਾਨੈ ਕੋਇ"
    },
    {
      "section_id": "section-00075",
      "start_time": 705.835,
      "end_time": 714.733,
      "transcript": "ਆਪੇ ਆਪਿ, ਨਾਨਕ ਪ੍ਰਭੁ ਸੋਇ"
    },
    {
      "section_id": "section-00076",
      "start_time": 722.6,
      "end_time": 730.83,
      "transcript": "ਕਈ ਕੋਟਿ, ਪਾਰਬ੍ਰਹਮ ਕੇ ਦਾਸ"
    },
    {
      "section_id": "section-00077",
      "start_time": 730.83,
      "end_time": 739.183,
      "transcript": "ਤਿਨ ਹੋਵਤ, ਆਤਮ ਪਰਗਾਸ"
    },
    {
      "section_id": "section-00078",
      "start_time": 739.183,
      "end_time": 747.575,
      "transcript": "ਕਈ ਕੋਟਿ, ਤਤ ਕੇ ਬੇਤੇ"
    },
    {
      "section_id": "section-00079",
      "start_time": 748.0,
      "end_time": 756.195,
      "transcript": "ਸਦਾ ਨਿਹਾਰਹਿ, ਏਕੋ ਨੇਤ੍ਰੇ"
    },
    {
      "section_id": "section-00080",
      "start_time": 756.195,
      "end_time": 764.175,
      "transcript": "ਕਈ ਕੋਟਿ, ਨਾਮ ਰਸੁ ਪੀਵਹਿ"
    },
    {
      "section_id": "section-00081",
      "start_time": 764.76,
      "end_time": 772.831,
      "transcript": "ਅਮਰ ਭਏ, ਸਦ ਸਦ ਹੀ ਜੀਵਹਿ"
    },
    {
      "section_id": "section-00082",
      "start_time": 772.831,
      "end_time": 780.965,
      "transcript": "ਕਈ ਕੋਟਿ, ਨਾਮ ਗੁਨ ਗਾਵਹਿ"
    },
    {
      "section_id": "section-00083",
      "start_time": 781.295,
      "end_time": 789.235,
      "transcript": "ਆਤਮ ਰਸਿ, ਸੁਖਿ ਸਹਜਿ ਸਮਾਵਹਿ"
    },
    {
      "section_id": "section-00084",
      "start_time": 789.575,
      "end_time": 797.305,
      "transcript": "ਅਪੁਨੇ ਜਨ ਕਉ, ਸਾਸਿ ਸਾਸਿ ਸਮਾਰੇ"
    },
    {
      "section_id": "section-00085",
      "start_time": 797.915,
      "end_time": 805.775,
      "transcript": "ਨਾਨਕ ਓਇ, ਪਰਮੇਸੁਰ ਕੇ ਪਿਆਰੇ"
    },
    {

    {
      "section_id": "section-00010",
      "start_time": 74.875,
      "end_time": 81.221,
      "transcript": "ਤਜਿ ਸਭਿ ਭਰਮ, ਭਜਿਓ ਪਾਰਬ੍ਰਹਮੁ"

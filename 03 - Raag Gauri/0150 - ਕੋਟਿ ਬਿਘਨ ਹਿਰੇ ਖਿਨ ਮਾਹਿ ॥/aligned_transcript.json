    {
      "section_id": "section-00002",
      "start_time": 13.375,
      "end_time": 19.495,
      "transcript": "ਕੋਟਿ ਬਿਘਨ ਹਿਰੇ, ਖਿਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.92,
      "end_time": 26.215,
      "transcript": "ਹਰਿ ਹਰਿ ਕਥਾ, ਸਾਧਸੰਗਿ ਸੁਨਾਹਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.44,
      "end_time": 32.672,
      "transcript": "ਪੀਵਤ ਰਾਮ ਰਸੁ, ਅੰਮ੍ਰਿਤ ਗੁਣ ਜਾਸੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.672,
      "end_time": 42.475,
      "transcript": "ਜਪਿ ਹਰਿ ਚਰਣ, ਮਿਟੀ ਖੁਧਿ ਤਾਸੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.0,
      "end_time": 55.301,
      "transcript": "ਸਰਬ ਕਲਿਆਣ, ਸੁਖ ਸਹਜ ਨਿਧਾਨ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.301,
      "end_time": 61.605,
      "transcript": "ਜਾ ਕੈ ਰਿਦੈ, ਵਸਹਿ ਭਗਵਾਨ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.96,
      "end_time": 68.4,
      "transcript": "ਅਉਖਧ ਮੰਤ੍ਰ ਤੰਤ, ਸਭਿ ਛਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.4,
      "end_time": 74.875,
      "transcript": "ਕਰਣੈਹਾਰੁ, ਰਿਦੇ ਮਹਿ ਧਾਰੁ"

{
  "audio_file": "0139 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.68,
      "end_time": 20.89,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 30.2,
      "end_time": 37.347,
      "transcript": "ਜਿਸੁ ਮਨਿ ਵਸੈ, ਤਰੈ ਜਨੁ ਸੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.347,
      "end_time": 44.673,
      "transcript": "ਜਾ ਕੈ ਕਰਮਿ ਪਰਾਪਤਿ ਹੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.673,
      "end_time": 51.466,
      "transcript": "ਦੂਖੁ ਰੋਗੁ ਕਛੁ ਭਉ, ਨ ਬਿਆਪੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 51.466,
      "end_time": 59.754,
      "transcript": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ, ਰਿਦੈ ਹਰਿ ਜਾਪੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 66.0,
      "end_time": 72.8,
      "transcript": "ਪਾਰਬ੍ਰਹਮੁ ਪਰਮੇਸੁਰੁ ਧਿਆਈਐ"
    },
    {
      "section_id": "section-00007",
      "start_time": 72.8,
      "end_time": 81.62,
      "transcript": "ਗੁਰ ਪੂਰੇ ਤੇ ਇਹ ਮਤਿ ਪਾਈਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 86.84,
      "end_time": 93.559,
      "transcript": "ਕਰਣ ਕਰਾਵਨਹਾਰ ਦਇਆਲ"
    },
    {
      "section_id": "section-00009",
      "start_time": 93.559,
      "end_time": 100.642,
      "transcript": "ਜੀਅ ਜੰਤ, ਸਗਲੇ ਪ੍ਰਤਿਪਾਲ"
    },
    {
      "section_id": "section-00010",
      "start_time": 100.642,
      "end_time": 107.463,
      "transcript": "ਅਗਮ ਅਗੋਚਰ, ਸਦਾ ਬੇਅੰਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 107.463,
      "end_time": 114.6,
      "transcript": "ਸਿਮਰਿ ਮਨਾ, ਪੂਰੇ ਗੁਰ ਮੰਤਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 114.6,
      "end_time": 121.4,
      "transcript": "ਜਾ ਕੀ ਸੇਵਾ, ਸਰਬ ਨਿਧਾਨੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 121.4,
      "end_time": 128.274,
      "transcript": "ਪ੍ਰਭ ਕੀ ਪੂਜਾ, ਪਾਈਐ ਮਾਨੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 128.274,
      "end_time": 135.153,
      "transcript": "ਜਾ ਕੀ ਟਹਲ, ਨ ਬਿਰਥੀ ਜਾਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 135.153,
      "end_time": 141.93,
      "transcript": "ਸਦਾ ਸਦਾ, ਹਰਿ ਕੇ ਗੁਣ ਗਾਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 141.93,
      "end_time": 148.803,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਪ੍ਰਭ ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 148.803,
      "end_time": 155.445,
      "transcript": "ਸੁਖ ਨਿਧਾਨ, ਹਰਿ ਅਲਖ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 155.445,
      "end_time": 162.661,
      "transcript": "ਜੀਅ ਜੰਤ, ਤੇਰੀ ਸਰਣਾਈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 162.661,
      "end_time": 169.953,
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ ਵਡਿਆਈ"
    }
  ]
}

  "audio_file": "0155 B PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.045,
      "transcript": "ਗਉੜੀ₂ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.107,
      "end_time": 22.255,
      "transcript": "ਅਉਧ ਘਟੈ, ਦਿਨਸੁ ਰੈਨਾਰੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.76,
      "end_time": 30.255,
      "transcript": "ਮਨ ਗੁਰ ਮਿਲਿ, ਕਾਜ ਸਵਾਰੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.08,
      "end_time": 45.315,
      "transcript": "ਕਰਉ ਬੇਨੰਤੀ ਸੁਨਹੁ ਮੇਰੇ ਮੀਤਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.8,
      "end_time": 52.845,
      "transcript": "ਸੰਤ ਟਹਲ ਕੀ ਬੇਲਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.48,
      "end_time": 60.385,
      "transcript": "ਈਹਾ ਖਾਟਿ ਚਲਹੁ ਹਰਿ ਲਾਹਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.24,
      "end_time": 68.215,
      "transcript": "ਆਗੈ ਬਸਨੁ ਸੁਹੇਲਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.92,
      "end_time": 76.52,
      "transcript": "ਇਹੁ ਸੰਸਾਰੁ ਬਿਕਾਰੁ ਸਹਸੇ ਮਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.52,
      "end_time": 83.505,
      "transcript": "ਤਰਿਓ ਬ੍ਰਹਮ ਗਿਆਨੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.12,
      "end_time": 91.7,
      "transcript": "ਜਿਸਹਿ ਜਗਾਇ ਪੀਆਏ ਹਰਿ ਰਸੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.7,
      "end_time": 98.845,
      "transcript": "ਅਕਥ ਕਥਾ ਤਿਨਿ ਜਾਨੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.475,
      "end_time": 107.4,
      "transcript": "ਜਾ ਕਉ ਆਏ ਸੋਈ ਵਿਹਾਝਹੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 107.4,
      "end_time": 114.365,
      "transcript": "ਹਰਿ ਗੁਰ ਤੇ ਮਨਹਿ ਬਸੇਰਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 114.92,
      "end_time": 122.075,
      "transcript": "ਨਿਜ ਘਰਿ ਮਹਲੁ ਪਾਵਹੁ ਸੁਖ ਸਹਜੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 122.8,
      "end_time": 129.995,
      "transcript": "ਬਹੁਰਿ ਨ ਹੋਇਗੋ ਫੇਰਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 130.6,
      "end_time": 137.775,
      "transcript": "ਅੰਤਰਜਾਮੀ ਪੁਰਖ ਬਿਧਾਤੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 138.32,
      "end_time": 145.375,
      "transcript": "ਸਰਧਾ ਮਨ ਕੀ ਪੂਰੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 146.065,
      "end_time": 153.095,
      "transcript": "ਨਾਨਕੁ ਦਾਸੁ ਇਹੀ ਸੁਖੁ ਮਾਗੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 153.8,
      "end_time": 160.885,
      "transcript": "ਮੋ ਕਉ ਕਰਿ ਸੰਤਨ ਕੀ ਧੂਰੇ"
    }
  ]
}

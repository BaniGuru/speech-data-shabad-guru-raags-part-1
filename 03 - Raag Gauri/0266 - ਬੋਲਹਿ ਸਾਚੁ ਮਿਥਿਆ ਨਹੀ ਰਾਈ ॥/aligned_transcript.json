{
  "audio_file": "0172 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.135,
      "end_time": 8.005,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.985,
      "end_time": 23.905,
      "transcript": "ਬੋਲਹਿ ਸਾਚੁ, ਮਿਥਿਆ ਨਹੀ ਰਾਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.905,
      "end_time": 31.925,
      "transcript": "ਚਾਲਹਿ ਗੁਰਮੁਖਿ, ਹੁਕਮਿ ਰਜਾਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.925,
      "end_time": 39.935,
      "transcript": "ਰਹਹਿ ਅਤੀਤ, ਸਚੇ ਸਰਣਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.935,
      "end_time": 47.91,
      "transcript": "ਸਚ ਘਰਿ ਬੈਸੈ, ਕਾਲੁ ਨ ਜੋਹੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 47.91,
      "end_time": 60.495,
      "transcript": "ਮਨਮੁਖ ਕਉ, ਆਵਤ ਜਾਵਤ ਦੁਖੁ ਮੋਹੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.759,
      "end_time": 71.785,
      "transcript": "ਅਪਿਉ ਪੀਅਉ, ਅਕਥੁ ਕਥਿ ਰਹੀਐ"
    },
    {
      "section_id": "section-00008",
      "start_time": 71.785,
      "end_time": 79.625,
      "transcript": "ਨਿਜ ਘਰਿ ਬੈਸਿ, ਸਹਜ ਘਰੁ ਲਹੀਐ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.625,
      "end_time": 87.725,
      "transcript": "ਹਰਿ ਰਸਿ ਮਾਤੇ, ਇਹੁ ਸੁਖੁ ਕਹੀਐ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.725,
      "end_time": 95.8,
      "transcript": "ਗੁਰਮਤਿ ਚਾਲ ਨਿਹਚਲ, ਨਹੀ ਡੋਲੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.8,
      "end_time": 103.635,
      "transcript": "ਗੁਰਮਤਿ, ਸਾਚਿ ਸਹਜਿ ਹਰਿ ਬੋਲੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 103.635,
      "end_time": 111.445,
      "transcript": "ਪੀਵੈ ਅੰਮ੍ਰਿਤੁ, ਤਤੁ ਵਿਰੋਲੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 111.445,
      "end_time": 119.335,
      "transcript": "ਸਤਿਗੁਰੁ ਦੇਖਿਆ, ਦੀਖਿਆ ਲੀਨੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 119.335,
      "end_time": 127.035,
      "transcript": "ਮਨੁ ਤਨੁ ਅਰਪਿਓ, ਅੰਤਰਗਤਿ ਕੀਨੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 127.035,
      "end_time": 135.025,
      "transcript": "ਗਤਿ ਮਿਤਿ ਪਾਈ, ਆਤਮੁ ਚੀਨੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 135.36,
      "end_time": 143.16,
      "transcript": "ਭੋਜਨੁ, ਨਾਮੁ ਨਿਰੰਜਨ ਸਾਰੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 143.16,
      "end_time": 150.535,
      "transcript": "ਪਰਮ ਹੰਸੁ, ਸਚੁ ਜੋਤਿ ਅਪਾਰ"
    },
    {
      "section_id": "section-00018",
      "start_time": 150.925,
      "end_time": 158.815,
      "transcript": "ਜਹ ਦੇਖਉ, ਤਹ ਏਕੰਕਾਰੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 158.815,
      "end_time": 166.84,
      "transcript": "ਰਹੈ ਨਿਰਾਲਮੁ, ਏਕਾ ਸਚੁ ਕਰਣੀ"
    },
    {
      "section_id": "section-00020",
      "start_time": 166.84,
      "end_time": 174.72,
      "transcript": "ਪਰਮ ਪਦੁ ਪਾਇਆ, ਸੇਵਾ ਗੁਰ ਚਰਣੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 174.72,
      "end_time": 182.46,
      "transcript": "ਮਨ ਤੇ ਮਨੁ ਮਾਨਿਆ, ਚੂਕੀ ਅਹੰ ਭ੍ਰਮਣੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 182.46,
      "end_time": 190.325,
      "transcript": "ਇਨ ਬਿਧਿ, ਕਉਣੁ ਕਉਣੁ ਨਹੀ ਤਾਰਿਆ"
    },
    {
      "section_id": "section-00023",
      "start_time": 190.325,
      "end_time": 198.135,
      "transcript": "ਹਰਿ ਜਸਿ, ਸੰਤ ਭਗਤ ਨਿਸਤਾਰਿਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 198.135,
      "end_time": 205.845,
      "transcript": "ਪ੍ਰਭ ਪਾਏ, ਹਮ ਅਵਰੁ ਨ ਭਾਰਿਆ"
    },
    {
      "section_id": "section-00025",
      "start_time": 205.845,
      "end_time": 213.735,
      "transcript": "ਸਾਚ ਮਹਲਿ, ਗੁਰਿ ਅਲਖੁ ਲਖਾਇਆ"
    },
    {
      "section_id": "section-00026",
      "start_time": 213.735,
      "end_time": 221.49,
      "transcript": "ਨਿਹਚਲ ਮਹਲੁ, ਨਹੀ ਛਾਇਆ ਮਾਇਆ"
    },
    {
      "section_id": "section-00027",
      "start_time": 221.49,
      "end_time": 229.405,
      "transcript": "ਸਾਚਿ ਸੰਤੋਖੇ, ਭਰਮੁ ਚੁਕਾਇਆ"
    },
    {
      "section_id": "section-00028",
      "start_time": 229.405,
      "end_time": 237.32,
      "transcript": "ਜਿਨ ਕੈ ਮਨਿ ਵਸਿਆ ਸਚੁ ਸੋਈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 237.32,
      "end_time": 244.94,
      "transcript": "ਤਿਨ ਕੀ ਸੰਗਤਿ, ਗੁਰਮੁਖਿ ਹੋਈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 244.94,
      "end_time": 252.81,
      "transcript": "ਨਾਨਕ ਸਾਚਿ ਨਾਮਿ, ਮਲੁ ਖੋਈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 252.81,
      "end_time": 261.395,
      "transcript": "ਨਾਨਕ ਸਾਚਿ ਨਾਮਿ, ਮਲੁ ਖੋਈ"
    }
  ]
}

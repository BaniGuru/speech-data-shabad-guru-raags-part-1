{
  "audio_file": "0169 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.195,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.6,
      "end_time": 21.92,
      "transcript": "ਅਧਿਆਤਮ ਕਰਮ ਕਰੇ, ਤਾ ਸਾਚਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.92,
      "end_time": 29.16,
      "transcript": "ਮੁਕਤਿ ਭੇਦੁ, ਕਿਆ ਜਾਣੈ ਕਾਚਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.16,
      "end_time": 36.355,
      "transcript": "ਐਸਾ ਜੋਗੀ, ਜੁਗਤਿ ਬੀਚਾਰੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.355,
      "end_time": 47.116,
      "transcript": "ਪੰਚ ਮਾਰਿ, ਸਾਚੁ ਉਰਿ ਧਾਰੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.04,
      "end_time": 65.235,
      "transcript": "ਜਿਸ ਕੈ ਅੰਤਰਿ, ਸਾਚੁ ਵਸਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 65.235,
      "end_time": 72.64,
      "transcript": "ਜੋਗ ਜੁਗਤਿ ਕੀ, ਕੀਮਤਿ ਪਾਵੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 72.64,
      "end_time": 80.0,
      "transcript": "ਰਵਿ ਸਸਿ ਏਕੋ, ਗ੍ਰਿਹ ਉਦਿਆਨੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 80.0,
      "end_time": 87.36,
      "transcript": "ਕਰਣੀ ਕੀਰਤਿ, ਕਰਮ ਸਮਾਨੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.36,
      "end_time": 94.615,
      "transcript": "ਏਕ ਸਬਦ, ਇਕ ਭਿਖਿਆ ਮਾਗੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.615,
      "end_time": 101.875,
      "transcript": "ਗਿਆਨੁ ਧਿਆਨੁ ਜੁਗਤਿ, ਸਚੁ ਜਾਗੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 101.875,
      "end_time": 108.875,
      "transcript": "ਭੈ ਰਚਿ ਰਹੈ, ਨ ਬਾਹਰਿ ਜਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 109.405,
      "end_time": 116.205,
      "transcript": "ਕੀਮਤਿ ਕਉਣ, ਰਹੈ ਲਿਵ ਲਾਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 116.715,
      "end_time": 123.86,
      "transcript": "ਆਪੇ ਮੇਲੇ, ਭਰਮੁ ਚੁਕਾਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 123.86,
      "end_time": 131.28,
      "transcript": "ਗੁਰ ਪਰਸਾਦਿ, ਪਰਮ ਪਦੁ ਪਾਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 131.28,
      "end_time": 138.405,
      "transcript": "ਗੁਰ ਕੀ ਸੇਵਾ, ਸਬਦੁ ਵੀਚਾਰੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 138.405,
      "end_time": 145.84,
      "transcript": "ਹਉਮੈ ਮਾਰੇ, ਕਰਣੀ ਸਾਰੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 145.84,
      "end_time": 153.16,
      "transcript": "ਜਪ ਤਪ ਸੰਜਮ, ਪਾਠ ਪੁਰਾਣੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 153.16,
      "end_time": 159.895,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਅਪਰੰਪਰ ਮਾਨੁ"
    }
  ]
}

{
  "audio_file": "0174 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.28,
      "end_time": 14.485,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ ਅਸਟਪਦੀਆ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.0,
      "end_time": 30.025,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 39.875,
      "end_time": 46.64,
      "transcript": "ਮਨ ਕਾ ਸੂਤਕੁ, ਦੂਜਾ ਭਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 46.64,
      "end_time": 53.065,
      "transcript": "ਭਰਮੇ ਭੂਲੇ, ਆਵਉ ਜਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.065,
      "end_time": 59.465,
      "transcript": "ਮਨਮੁਖਿ ਸੂਤਕੁ, ਕਬਹਿ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 59.775,
      "end_time": 69.705,
      "transcript": "ਜਿਚਰੁ ਸਬਦਿ ਨ ਭੀਜੈ, ਹਰਿ ਕੈ ਨਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.335,
      "end_time": 82.92,
      "transcript": "ਸਭੋ ਸੂਤਕੁ, ਜੇਤਾ ਮੋਹੁ ਆਕਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 82.92,
      "end_time": 89.345,
      "transcript": "ਮਰਿ ਮਰਿ ਜੰਮੈ, ਵਾਰੋ ਵਾਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 89.625,
      "end_time": 96.055,
      "transcript": "ਸੂਤਕੁ, ਅਗਨਿ ਪਉਣੈ ਪਾਣੀ ਮਾਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 96.32,
      "end_time": 103.045,
      "transcript": "ਸੂਤਕੁ ਭੋਜਨੁ, ਜੇਤਾ ਕਿਛੁ ਖਾਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 109.515,
      "end_time": 116.24,
      "transcript": "ਸੂਤਕਿ, ਕਰਮ ਨ ਪੂਜਾ ਹੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 116.24,
      "end_time": 122.76,
      "transcript": "ਨਾਮਿ ਰਤੇ, ਮਨੁ ਨਿਰਮਲੁ ਹੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 122.76,
      "end_time": 129.24,
      "transcript": "ਸਤਿਗੁਰੁ ਸੇਵਿਐ, ਸੂਤਕੁ ਜਾਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 129.24,
      "end_time": 135.559,
      "transcript": "ਮਰੈ ਨ ਜਨਮੈ, ਕਾਲੁ ਨ ਖਾਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 135.559,
      "end_time": 142.32,
      "transcript": "ਸਾਸਤ ਸਿੰਮ੍ਰਿਤਿ, ਸੋਧਿ ਦੇਖਹੁ ਕੋਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 142.32,
      "end_time": 148.935,
      "transcript": "ਵਿਣੁ ਨਾਵੈ, ਕੋ ਮੁਕਤਿ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 155.205,
      "end_time": 161.72,
      "transcript": "ਜੁਗ ਚਾਰੇ, ਨਾਮੁ ਉਤਮੁ ਸਬਦੁ ਬੀਚਾਰਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 161.72,
      "end_time": 168.125,
      "transcript": "ਕਲਿ ਮਹਿ ਗੁਰਮੁਖਿ, ਉਤਰਸਿ ਪਾਰਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 168.125,
      "end_time": 174.335,
      "transcript": "ਸਾਚਾ, ਮਰੈ ਨ ਆਵੈ ਜਾਇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 174.755,
      "end_time": 180.835,
      "transcript": "ਨਾਨਕ, ਗੁਰਮੁਖਿ ਰਹੈ ਸਮਾਇ"
    }
  ]
}

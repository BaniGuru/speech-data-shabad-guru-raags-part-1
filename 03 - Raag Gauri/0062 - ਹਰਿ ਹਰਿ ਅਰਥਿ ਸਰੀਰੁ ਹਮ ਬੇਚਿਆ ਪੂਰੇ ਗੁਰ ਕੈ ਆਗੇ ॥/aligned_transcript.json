{
  "audio_file": "0129 CPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.026,
      "end_time": 7.019,
      "transcript": "ਗਉੜੀ ਪੂਰਬੀ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.04,
      "end_time": 20.754,
      "transcript": "ਹਰਿ ਹਰਿ ਅਰਥਿ ਸਰੀਰੁ ਹਮ ਬੇਚਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.754,
      "end_time": 27.63,
      "transcript": "ਪੂਰੇ ਗੁਰ ਕੈ ਆਗੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.63,
      "end_time": 34.672,
      "transcript": "ਸਤਿਗੁਰ ਦਾਤੈ ਨਾਮੁ ਦਿੜਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.672,
      "end_time": 41.445,
      "transcript": "ਮੁਖਿ ਮਸਤਕਿ ਭਾਗ ਸਭਾਗੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.445,
      "end_time": 50.758,
      "transcript": "ਰਾਮ ਗੁਰਮਤਿ ਹਰਿ ਲਿਵ ਲਾਗੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.56,
      "end_time": 61.92,
      "transcript": "ਘਟਿ ਘਟਿ ਰਮਈਆ ਰਮਤ ਰਾਮ ਰਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.92,
      "end_time": 69.232,
      "transcript": "ਗੁਰ ਸਬਦਿ ਗੁਰੂ ਲਿਵ ਲਾਗੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 69.232,
      "end_time": 75.72,
      "transcript": "ਹਉ ਮਨੁ ਤਨੁ ਦੇਵਉ ਕਾਟਿ ਗੁਰੂ ਕਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.72,
      "end_time": 83.12,
      "transcript": "ਮੇਰਾ ਭ੍ਰਮੁ ਭਉ ਗੁਰ ਬਚਨੀ ਭਾਗੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.12,
      "end_time": 89.52,
      "transcript": "ਅੰਧਿਆਰੈ ਦੀਪਕ ਆਨਿ ਜਲਾਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 89.52,
      "end_time": 97.0,
      "transcript": "ਗੁਰ ਗਿਆਨਿ ਗੁਰੂ ਲਿਵ ਲਾਗੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 97.0,
      "end_time": 103.88,
      "transcript": "ਅਗਿਆਨੁ ਅੰਧੇਰਾ ਬਿਨਸਿ ਬਿਨਾਸਿਓ"
    },
    {
      "section_id": "section-00014",
      "start_time": 103.88,
      "end_time": 110.763,
      "transcript": "ਘਰਿ ਵਸਤੁ ਲਹੀ ਮਨ ਜਾਗੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 110.763,
      "end_time": 117.68,
      "transcript": "ਸਾਕਤ ਬਧਿਕ ਮਾਇਆਧਾਰੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 117.68,
      "end_time": 124.56,
      "transcript": "ਤਿਨ ਜਮ ਜੋਹਨਿ ਲਾਗੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 124.56,
      "end_time": 131.4,
      "transcript": "ਉਨ ਸਤਿਗੁਰ ਆਗੈ ਸੀਸੁ ਨ ਬੇਚਿਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 131.4,
      "end_time": 138.2,
      "transcript": "ਓਇ ਆਵਹਿ ਜਾਹਿ ਅਭਾਗੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 138.2,
      "end_time": 145.12,
      "transcript": "ਹਮਰਾ ਬਿਨਉ ਸੁਨਹੁ ਪ੍ਰਭ ਠਾਕੁਰ"
    },
    {
      "section_id": "section-00020",
      "start_time": 145.12,
      "end_time": 151.927,
      "transcript": "ਹਮ ਸਰਣਿ ਪ੍ਰਭੂ ਹਰਿ ਮਾਗੇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 151.927,
      "end_time": 158.32,
      "transcript": "ਜਨ ਨਾਨਕ ਕੀ ਲਜ ਪਾਤਿ ਗੁਰੂ ਹੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 158.32,
      "end_time": 165.262,
      "transcript": "ਸਿਰੁ ਬੇਚਿਓ ਸਤਿਗੁਰ ਆਗੇ"
    }
  ]
}

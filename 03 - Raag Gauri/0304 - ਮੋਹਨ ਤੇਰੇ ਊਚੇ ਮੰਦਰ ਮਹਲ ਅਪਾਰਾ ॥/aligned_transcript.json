{
  "audio_file": "0188 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.185,
      "end_time": 11.238,
      "transcript": "ਗਉੜੀ₂ ਮਹਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.238,
      "end_time": 17.42,
      "transcript": "ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 33.965,
      "end_time": 41.24,
      "transcript": "ਮੋਹਨ ਤੇਰੇ ਊਚੇ ਮੰਦਰ, ਮਹਲ ਅਪਾਰਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.24,
      "end_time": 48.24,
      "transcript": "ਮੋਹਨ ਤੇਰੇ ਸੋਹਨਿ ਦੁਆਰ ਜੀਉ, ਸੰਤ ਧਰਮ ਸਾਲਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 48.24,
      "end_time": 55.52,
      "transcript": "ਧਰਮ ਸਾਲ ਅਪਾਰ ਦੈਆਰ ਠਾਕੁਰ"
    },
    {
      "section_id": "section-00006",
      "start_time": 55.52,
      "end_time": 62.675,
      "transcript": "ਸਦਾ ਕੀਰਤਨੁ ਗਾਵਹੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 69.475,
      "end_time": 76.52,
      "transcript": "ਜਹ ਸਾਧ ਸੰਤ ਇਕਤ੍ਰ ਹੋਵਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.52,
      "end_time": 83.136,
      "transcript": "ਤਹਾ ਤੁਝਹਿ ਧਿਆਵਹੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 83.136,
      "end_time": 90.046,
      "transcript": "ਕਰਿ ਦਇਆ ਮਇਆ ਦਇਆਲ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.046,
      "end_time": 96.745,
      "transcript": "ਹੋਹੁ ਦੀਨ ਕ੍ਰਿਪਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 96.96,
      "end_time": 103.88,
      "transcript": "ਬਿਨਵੰਤਿ ਨਾਨਕ ਦਰਸ ਪਿਆਸੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 103.88,
      "end_time": 110.475,
      "transcript": "ਮਿਲਿ ਦਰਸਨ ਸੁਖੁ ਸਾਰਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 110.72,
      "end_time": 117.6,
      "transcript": "ਮੋਹਨ ਤੇਰੇ ਬਚਨ ਅਨੂਪ, ਚਾਲ ਨਿਰਾਲੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 117.6,
      "end_time": 124.485,
      "transcript": "ਮੋਹਨ ਤੂੰ ਮਾਨਹਿ ਏਕੁ ਜੀ, ਅਵਰ ਸਭ ਰਾਲੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 130.995,
      "end_time": 137.8,
      "transcript": "ਮਾਨਹਿ ਤ ਏਕੁ ਅਲੇਖੁ ਠਾਕੁਰੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 137.8,
      "end_time": 143.995,
      "transcript": "ਜਿਨਹਿ ਸਭ ਕਲ ਧਾਰੀਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 144.16,
      "end_time": 150.92,
      "transcript": "ਤੁਧੁ ਬਚਨਿ ਗੁਰ ਕੈ ਵਸਿ ਕੀਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 150.92,
      "end_time": 157.145,
      "transcript": "ਆਦਿ ਪੁਰਖੁ ਬਨਵਾਰੀਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 157.52,
      "end_time": 164.005,
      "transcript": "ਤੂੰ ਆਪਿ ਚਲਿਆ ਆਪਿ ਰਹਿਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 164.195,
      "end_time": 170.255,
      "transcript": "ਆਪਿ ਸਭ ਕਲ ਧਾਰੀਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 170.64,
      "end_time": 177.12,
      "transcript": "ਬਿਨਵੰਤਿ ਨਾਨਕ ਪੈਜ ਰਾਖਹੁ"
    },
    {
      "section_id": "section-00022",
      "start_time": 177.12,
      "end_time": 183.315,
      "transcript": "ਸਭ ਸੇਵਕ ਸਰਨਿ ਤੁਮਾਰੀਆ"
    },
    {
      "section_id": "section-00023",
      "start_time": 183.515,
      "end_time": 190.16,
      "transcript": "ਮੋਹਨ ਤੁਧੁ ਸਤਸੰਗਤਿ ਧਿਆਵੈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 190.16,
      "end_time": 196.545,
      "transcript": "ਦਰਸ ਧਿਆਨਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 196.695,
      "end_time": 203.28,
      "transcript": "ਮੋਹਨ ਜਮੁ ਨੇੜਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 203.28,
      "end_time": 210.535,
      "transcript": "ਤੁਧੁ ਜਪਹਿ ਨਿਦਾਨਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 216.355,
      "end_time": 222.965,
      "transcript": "ਜਮਕਾਲੁ ਤਿਨ ਕਉ ਲਗੈ ਨਾਹੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 222.965,
      "end_time": 229.325,
      "transcript": "ਜੋ ਇਕ ਮਨਿ ਧਿਆਵਹੇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 229.64,
      "end_time": 236.4,
      "transcript": "ਮਨਿ ਬਚਨਿ ਕਰਮਿ ਜਿ ਤੁਧੁ ਅਰਾਧਹਿ"
    },
    {
      "section_id": "section-00030",
      "start_time": 236.4,
      "end_time": 242.715,
      "transcript": "ਸੇ ਸਭੇ ਫਲ ਪਾਵਹੇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 242.92,
      "end_time": 249.44,
      "transcript": "ਮਲ ਮੂਤ ਮੂੜ ਜਿ ਮੁਗਧ ਹੋਤੇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 249.44,
      "end_time": 255.765,
      "transcript": "ਸਿ ਦੇਖਿ ਦਰਸੁ ਸੁਗਿਆਨਾ"
    },
    {
      "section_id": "section-00033",
      "start_time": 256.08,
      "end_time": 262.563,
      "transcript": "ਬਿਨਵੰਤਿ ਨਾਨਕ ਰਾਜੁ ਨਿਹਚਲੁ"
    },
    {
      "section_id": "section-00034",
      "start_time": 262.563,
      "end_time": 269.037,
      "transcript": "ਪੂਰਨ ਪੁਰਖ ਭਗਵਾਨਾ"
    },
    {
      "section_id": "section-00035",
      "start_time": 269.037,
      "end_time": 275.68,
      "transcript": "ਮੋਹਨ ਤੂੰ ਸੁਫਲੁ ਫਲਿਆ, ਸਣੁ ਪਰਵਾਰੇ"
    },
    {
      "section_id": "section-00036",
      "start_time": 275.68,
      "end_time": 282.157,
      "transcript": "ਮੋਹਨ ਪੁਤ੍ਰ ਮੀਤ ਭਾਈ ਕੁਟੰਬ, ਸਭਿ ਤਾਰੇ"
    },
    {
      "section_id": "section-00037",
      "start_time": 282.157,
      "end_time": 288.34,
      "transcript": "ਤਾਰਿਆ ਜਹਾਨੁ ਲਹਿਆ ਅਭਿਮਾਨੁ"
    },
    {
      "section_id": "section-00038",
      "start_time": 288.34,
      "end_time": 295.004,
      "transcript": "ਜਿਨੀ ਦਰਸਨੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00039",
      "start_time": 295.004,
      "end_time": 301.725,
      "transcript": "ਜਿਨੀ ਤੁਧਨੋ ਧੰਨੁ ਕਹਿਆ"
    },
    {
      "section_id": "section-00040",
      "start_time": 301.725,
      "end_time": 308.088,
      "transcript": "ਤਿਨ ਜਮੁ ਨੇੜਿ ਨ ਆਇਆ"
    },
    {
      "section_id": "section-00041",
      "start_time": 308.088,
      "end_time": 314.72,
      "transcript": "ਬੇਅੰਤ ਗੁਣ ਤੇਰੇ ਕਥੇ ਨ ਜਾਹੀ"
    },
    {
      "section_id": "section-00042",
      "start_time": 314.72,
      "end_time": 320.695,
      "transcript": "ਸਤਿਗੁਰ ਪੁਰਖ ਮੁਰਾਰੇ"
    },
    {
      "section_id": "section-00043",
      "start_time": 321.08,
      "end_time": 327.48,
      "transcript": "ਬਿਨਵੰਤਿ ਨਾਨਕ ਟੇਕ ਰਾਖੀ"
    },
    {
      "section_id": "section-00044",
      "start_time": 327.48,
      "end_time": 333.435,
      "transcript": "ਜਿਤੁ ਲਗਿ ਤਰਿਆ ਸੰਸਾਰੇ"
    }
  ]
}

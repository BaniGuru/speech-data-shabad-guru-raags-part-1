  "audio_file": "0160 A PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.165,
      "end_time": 10.909,
      "transcript": "ਗਉੜੀ ਮਹਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 10.909,
      "end_time": 18.585,
      "transcript": "ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.325,
      "end_time": 44.985,
      "transcript": "ਮਨ, ਰਾਮ ਨਾਮ ਗੁਨ ਗਾਈਐ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.455,
      "end_time": 52.835,
      "transcript": "ਨੀਤ ਨੀਤ ਹਰਿ ਸੇਵੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.595,
      "end_time": 61.581,
      "transcript": "ਸਾਸਿ ਸਾਸਿ ਹਰਿ ਧਿਆਈਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 69.135,
      "end_time": 76.625,
      "transcript": "ਸੰਤਸੰਗਿ, ਹਰਿ ਮਨਿ ਵਸੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.955,
      "end_time": 84.385,
      "transcript": "ਦੁਖੁ ਦਰਦੁ ਅਨੇਰਾ ਭ੍ਰਮੁ ਨਸੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 85.04,
      "end_time": 92.225,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਹਰਿ ਜਾਪੀਐ"
    },
    {
      "section_id": "section-00009",
      "start_time": 93.005,
      "end_time": 100.455,
      "transcript": "ਸੋ ਜਨੁ, ਦੂਖਿ ਨ ਵਿਆਪੀਐ"
    },
    {
      "section_id": "section-00010",
      "start_time": 101.145,
      "end_time": 108.728,
      "transcript": "ਜਾ ਕਉ, ਗੁਰੁ ਹਰਿ ਮੰਤ੍ਰੁ ਦੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 108.728,
      "end_time": 116.375,
      "transcript": "ਸੋ ਉਬਰਿਆ, ਮਾਇਆ ਅਗਨਿ ਤੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 116.485,
      "end_time": 124.015,
      "transcript": "ਨਾਨਕ ਕਉ, ਪ੍ਰਭ ਮਇਆ ਕਰਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 124.015,
      "end_time": 131.055,
      "transcript": "ਮੇਰੈ ਮਨਿ ਤਨਿ, ਵਾਸੈ ਨਾਮੁ ਹਰਿ"
    }
  ]
}

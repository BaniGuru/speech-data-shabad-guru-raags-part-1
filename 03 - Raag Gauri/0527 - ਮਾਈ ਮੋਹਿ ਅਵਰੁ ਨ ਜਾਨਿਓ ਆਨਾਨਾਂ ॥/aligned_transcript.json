    {
      "section_id": "section-00002",
      "start_time": 12.175,
      "end_time": 18.32,
      "transcript": "ਮਾਈ ਮੋਹਿ ਅਵਰੁ ਨ ਜਾਨਿਓ, ਆਨਾਨਾਂ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.32,
      "end_time": 24.225,
      "transcript": "ਸਿਵ ਸਨਕਾਦਿ ਜਾਸੁ ਗੁਨ ਗਾਵਹਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.225,
      "end_time": 32.285,
      "transcript": "ਤਾਸੁ ਬਸਹਿ ਮੋਰੇ ਪ੍ਰਾਨਾਨਾਂ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.32,
      "end_time": 45.48,
      "transcript": "ਹਿਰਦੇ ਪ੍ਰਗਾਸੁ ਗਿਆਨ ਗੁਰ ਗੰਮਿਤ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.48,
      "end_time": 51.015,
      "transcript": "ਗਗਨ ਮੰਡਲ ਮਹਿ ਧਿਆਨਾਨਾਂ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.44,
      "end_time": 57.505,
      "transcript": "ਬਿਖੈ ਰੋਗ ਭੈ ਬੰਧਨ ਭਾਗੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.505,
      "end_time": 63.165,
      "transcript": "ਮਨ ਨਿਜ ਘਰਿ ਸੁਖੁ ਜਾਨਾਨਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.72,
      "end_time": 69.88,
      "transcript": "ਏਕ ਸੁਮਤਿ ਰਤਿ ਜਾਨਿ ਮਾਨਿ ਪ੍ਰਭ"

{
  "audio_file": "0121 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 7.028,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.68,
      "end_time": 20.48,
      "transcript": "ਸੋ ਕਿਉ ਵਿਸਰੈ ਜਿਸ ਕੇ ਜੀਅ ਪਰਾਨਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.48,
      "end_time": 27.2,
      "transcript": "ਸੋ ਕਿਉ ਵਿਸਰੈ ਸਭ ਮਾਹਿ ਸਮਾਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.2,
      "end_time": 34.6,
      "transcript": "ਜਿਤੁ ਸੇਵਿਐ ਦਰਗਹ ਪਤਿ ਪਰਵਾਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.6,
      "end_time": 41.36,
      "transcript": "ਹਰਿ ਕੇ ਨਾਮ ਵਿਟਹੁ, ਬਲਿ ਜਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.36,
      "end_time": 51.885,
      "transcript": "ਤੂੰ ਵਿਸਰਹਿ ਤਦਿ ਹੀ ਮਰਿ ਜਾਉ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.96,
      "end_time": 61.64,
      "transcript": "ਤਿਨ ਤੂੰ ਵਿਸਰਹਿ, ਜਿ ਤੁਧੁ ਆਪਿ ਭੁਲਾਏ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.64,
      "end_time": 68.36,
      "transcript": "ਤਿਨ ਤੂੰ ਵਿਸਰਹਿ, ਜਿ ਦੂਜੈ ਭਾਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.36,
      "end_time": 74.913,
      "transcript": "ਮਨਮੁਖ ਅਗਿਆਨੀ, ਜੋਨੀ ਪਾਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.913,
      "end_time": 81.84,
      "transcript": "ਜਿਨ ਇਕ ਮਨਿ ਤੁਠਾ, ਸੇ ਸਤਿਗੁਰ ਸੇਵਾ ਲਾਏ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.84,
      "end_time": 88.476,
      "transcript": "ਜਿਨ ਇਕ ਮਨਿ ਤੁਠਾ, ਤਿਨ ਹਰਿ ਮੰਨਿ ਵਸਾਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 88.476,
      "end_time": 95.24,
      "transcript": "ਗੁਰਮਤੀ, ਹਰਿ ਨਾਮਿ ਸਮਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 95.24,
      "end_time": 101.96,
      "transcript": "ਜਿਨਾ ਪੋਤੈ ਪੁੰਨੁ, ਸੇ ਗਿਆਨ ਬੀਚਾਰੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 101.96,
      "end_time": 108.365,
      "transcript": "ਜਿਨਾ ਪੋਤੈ ਪੁੰਨੁ, ਤਿਨ ਹਉਮੈ ਮਾਰੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 108.365,
      "end_time": 115.049,
      "transcript": "ਨਾਨਕ ਜੋ ਨਾਮਿ ਰਤੇ, ਤਿਨ ਕਉ ਬਲਿਹਾਰੀ"
    }
  ]
}

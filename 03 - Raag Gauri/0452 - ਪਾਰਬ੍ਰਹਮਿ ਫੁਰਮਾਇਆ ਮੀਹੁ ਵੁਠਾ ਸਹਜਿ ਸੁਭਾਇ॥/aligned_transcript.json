    {
      "section_id": "section-00005",
      "start_time": 35.8,
      "end_time": 43.52,
      "transcript": "ਅੰਨੁ ਧੰਨੁ ਬਹੁਤੁ ਉਪਜਿਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.52,
      "end_time": 51.135,
      "transcript": "ਪ੍ਰਿਥਮੀ ਰਜੀ ਤਿਪਤਿ ਅਘਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.52,
      "end_time": 59.24,
      "transcript": "ਸਦਾ ਸਦਾ ਗੁਣ ਉਚਰੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.24,
      "end_time": 66.155,
      "transcript": "ਦੁਖੁ ਦਾਲਦੁ ਗਇਆ ਬਿਲਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.895,
      "end_time": 74.185,
      "transcript": "ਪੂਰਬਿ ਲਿਖਿਆ ਪਾਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.6,
      "end_time": 81.595,
      "transcript": "ਮਿਲਿਆ ਤਿਸੈ ਰਜਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 82.16,
      "end_time": 89.265,
      "transcript": "ਪਰਮੇਸਰਿ ਜੀਵਾਲਿਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 89.695,
      "end_time": 96.815,
      "transcript": "ਨਾਨਕ ਤਿਸੈ ਧਿਆਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 97.005,
      "end_time": 101.085,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 108.495,
      "end_time": 115.975,
      "transcript": "ਜੀਵਨ ਪਦੁ ਨਿਰਬਾਣੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 115.975,
      "end_time": 123.325,
      "transcript": "ਇਕੋ ਸਿਮਰੀਐ"
    },
    {
      "section_id": "section-00016",
      "start_time": 123.595,
      "end_time": 130.805,
      "transcript": "ਦੂਜੀ ਨਾਹੀ ਜਾਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 131.24,
      "end_time": 138.125,
      "transcript": "ਕਿਨਿ ਬਿਧਿ ਧੀਰੀਐ"
    },
    {
      "section_id": "section-00018",
      "start_time": 138.575,
      "end_time": 146.085,
      "transcript": "ਡਿਠਾ ਸਭੁ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 146.085,
      "end_time": 153.79,
      "transcript": "ਸੁਖੁ ਨ ਨਾਮ ਬਿਨੁ"
    },
    {
      "section_id": "section-00020",
      "start_time": 153.79,
      "end_time": 160.825,
      "transcript": "ਤਨੁ ਧਨੁ ਹੋਸੀ ਛਾਰੁ"
    },
    {
      "section_id": "section-00021",
      "start_time": 161.235,
      "end_time": 168.285,
      "transcript": "ਜਾਣੈ ਕੋਇ ਜਨੁ"
    },
    {
      "section_id": "section-00022",
      "start_time": 168.775,
      "end_time": 176.195,
      "transcript": "ਰੰਗ ਰੂਪ ਰਸ ਬਾਦਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 176.68,
      "end_time": 183.795,
      "transcript": "ਕਿ ਕਰਹਿ ਪਰਾਣੀਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 184.285,
      "end_time": 191.715,
      "transcript": "ਜਿਸੁ ਭੁਲਾਏ ਆਪਿ"
    },
    {
      "section_id": "section-00025",
      "start_time": 191.96,
      "end_time": 199.338,
      "transcript": "ਤਿਸੁ ਕਲ ਨਹੀ ਜਾਣੀਆ"
    },
    {
      "section_id": "section-00026",
      "start_time": 199.338,
      "end_time": 207.115,
      "transcript": "ਰੰਗਿ ਰਤੇ ਨਿਰਬਾਣੁ"
    },
    {
      "section_id": "section-00027",
      "start_time": 207.115,
      "end_time": 214.305,
      "transcript": "ਸਚਾ ਗਾਵਹੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 214.795,
      "end_time": 221.905,
      "transcript": "ਨਾਨਕ ਸਰਣਿ ਦੁਆਰਿ"
    },
    {
      "section_id": "section-00029",
      "start_time": 222.395,
      "end_time": 229.505,
      "transcript": "ਜੇ ਤੁਧੁ ਭਾਵਹੀ"
    },
    {
      "section_id": "section-00030",
      "start_time": 230.04,
      "end_time": 232.545,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00031",
      "start_time": 237.235,
      "end_time": 245.465,
      "transcript": "ਜੰਮਣੁ ਮਰਣੁ ਨ ਤਿਨ੍ ਕਉ, ਜੋ ਹਰਿ ਲੜਿ ਲਾਗੇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 245.84,
      "end_time": 253.875,
      "transcript": "ਜੀਵਤ ਸੇ ਪਰਵਾਣੁ ਹੋਏ, ਹਰਿ ਕੀਰਤਨਿ ਜਾਗੇ"
    },
    {
      "section_id": "section-00033",
      "start_time": 254.36,
      "end_time": 262.465,
      "transcript": "ਸਾਧਸੰਗੁ ਜਿਨ ਪਾਇਆ, ਸੇਈ ਵਡਭਾਗੇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 262.795,
      "end_time": 270.765,
      "transcript": "ਨਾਇ ਵਿਸਰਿਐ ਧ੍ਰਿਗੁ ਜੀਵਣਾ, ਤੂਟੇ ਕਚ ਧਾਗੇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 271.2,
      "end_time": 281.507,
      "transcript": "ਨਾਨਕ ਧੂੜਿ ਪੁਨੀਤ ਸਾਧ, ਲਖ ਕੋਟਿ ਪਿਰਾਗੇ"
    }
  ]
}

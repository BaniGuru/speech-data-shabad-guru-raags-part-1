{
  "audio_file": "0171 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.135,
      "end_time": 11.979,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.979,
      "end_time": 27.052,
      "transcript": "ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.345,
      "end_time": 46.552,
      "transcript": "ਸੇਵਾ ਏਕ, ਨ ਜਾਨਸਿ ਅਵਰੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 46.552,
      "end_time": 55.38,
      "transcript": "ਪਰਪੰਚ ਬਿਆਧਿ, ਤਿਆਗੈ ਕਵਰੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 55.38,
      "end_time": 64.48,
      "transcript": "ਭਾਇ ਮਿਲੈ, ਸਚੁ ਸਾਚੈ ਸਚੁ ਰੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 64.48,
      "end_time": 72.806,
      "transcript": "ਐਸਾ ਰਾਮ ਭਗਤੁ, ਜਨੁ ਹੋਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 72.806,
      "end_time": 86.759,
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਇ ਮਿਲੈ ਮਲੁ ਧੋਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 89.77,
      "end_time": 99.0,
      "transcript": "ਊਂਧੋ ਕਵਲੁ, ਸਗਲ ਸੰਸਾਰੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 99.0,
      "end_time": 107.6,
      "transcript": "ਦੁਰਮਤਿ ਅਗਨਿ, ਜਗਤ ਪਰਜਾਰੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 107.6,
      "end_time": 116.12,
      "transcript": "ਸੋ ਉਬਰੈ, ਗੁਰਸਬਦੁ ਬੀਚਾਰੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 116.12,
      "end_time": 124.546,
      "transcript": "ਭ੍ਰਿੰਗ ਪਤੰਗੁ ਕੁੰਚਰੁ ਅਰੁ ਮੀਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 124.546,
      "end_time": 133.32,
      "transcript": "ਮਿਰਗੁ ਮਰੈ, ਸਹਿ ਅਪੁਨਾ ਕੀਨਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 133.32,
      "end_time": 141.756,
      "transcript": "ਤ੍ਰਿਸਨਾ ਰਾਚਿ, ਤਤੁ ਨਹੀ ਬੀਨਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 141.756,
      "end_time": 150.535,
      "transcript": "ਕਾਮੁ ਚਿਤੈ, ਕਾਮਣਿ ਹਿਤਕਾਰੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 150.68,
      "end_time": 158.941,
      "transcript": "ਕ੍ਰੋਧੁ ਬਿਨਾਸੈ, ਸਗਲ ਵਿਕਾਰੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 158.941,
      "end_time": 167.495,
      "transcript": "ਪਤਿ ਮਤਿ ਖੋਵਹਿ, ਨਾਮੁ ਵਿਸਾਰੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 176.455,
      "end_time": 185.08,
      "transcript": "ਪਰ ਘਰਿ, ਚੀਤੁ ਮਨਮੁਖਿ ਡੋਲਾਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 185.08,
      "end_time": 193.48,
      "transcript": "ਗਲਿ ਜੇਵਰੀ, ਧੰਧੈ ਲਪਟਾਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 193.48,
      "end_time": 202.01,
      "transcript": "ਗੁਰਮੁਖਿ ਛੂਟਸਿ, ਹਰਿ ਗੁਣ ਗਾਇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 202.01,
      "end_time": 210.715,
      "transcript": "ਜਿਉ ਤਨੁ ਬਿਧਵਾ, ਪਰ ਕਉ ਦੇਈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 210.96,
      "end_time": 219.315,
      "transcript": "ਕਾਮਿ ਦਾਮਿ, ਚਿਤੁ ਪਰ ਵਸਿ ਸੇਈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 219.315,
      "end_time": 228.056,
      "transcript": "ਬਿਨੁ ਪਿਰ ਤ੍ਰਿਪਤਿ, ਨ ਕਬਹੂੰ ਹੋਈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 236.275,
      "end_time": 245.28,
      "transcript": "ਪੜਿ ਪੜਿ ਪੋਥੀ, ਸਿੰਮ੍ਰਿਤਿ ਪਾਠਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 245.28,
      "end_time": 253.8,
      "transcript": "ਬੇਦ ਪੁਰਾਣ ਪੜੈ, ਸੁਣਿ ਥਾਟਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 253.8,
      "end_time": 262.285,
      "transcript": "ਬਿਨੁ ਰਸ ਰਾਤੇ, ਮਨੁ ਬਹੁ ਨਾਟਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 262.285,
      "end_time": 270.84,
      "transcript": "ਜਿਉ ਚਾਤ੍ਰਿਕ, ਜਲ ਪ੍ਰੇਮ ਪਿਆਸਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 270.84,
      "end_time": 279.44,
      "transcript": "ਜਿਉ ਮੀਨਾ, ਜਲ ਮਾਹਿ ਉਲਾਸਾ"
    },
    {
      "section_id": "section-00028",
      "start_time": 279.44,
      "end_time": 287.375,
      "transcript": "ਨਾਨਕ ਹਰਿ ਰਸੁ ਪੀ, ਤ੍ਰਿਪਤਾਸਾ"
    }
  ]
}

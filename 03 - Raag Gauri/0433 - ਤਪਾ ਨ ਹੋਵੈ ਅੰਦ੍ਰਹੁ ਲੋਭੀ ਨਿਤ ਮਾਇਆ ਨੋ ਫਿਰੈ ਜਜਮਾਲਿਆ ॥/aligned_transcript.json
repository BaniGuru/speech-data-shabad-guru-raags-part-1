{
  "audio_file": "0233 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.706,
      "end_time": 13.752,
      "transcript": "ਸਲੋਕ ਮਹਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.752,
      "end_time": 19.905,
      "transcript": "ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 28.88,
      "end_time": 35.6,
      "transcript": "ਤਪਾ ਨ ਹੋਵੈ ਅੰਦ੍ਰਹੁ ਲੋਭੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.6,
      "end_time": 42.17,
      "transcript": "ਨਿਤ ਮਾਇਆ ਨੋ ਫਿਰੈ ਜਜਮਾਲਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.17,
      "end_time": 51.295,
      "transcript": "ਅਗੋ ਦੇ ਸਦਿਆ ਸਤੈ ਦੀ ਭਿਖਿਆ ਲਏ ਨਾਹੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.92,
      "end_time": 65.209,
      "transcript": "ਪਿਛੋ ਦੇ ਪਛੁਤਾਇ ਕੈ ਆਣਿ ਤਪੈ ਪੁਤੁ ਵਿਚਿ ਬਹਾਲਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 71.32,
      "end_time": 77.58,
      "transcript": "ਪੰਚ ਲੋਗ ਸਭਿ ਹਸਣ ਲਗੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.58,
      "end_time": 83.96,
      "transcript": "ਤਪਾ ਲੋਭਿ ਲਹਰਿ ਹੈ ਗਾਲਿਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 83.96,
      "end_time": 90.356,
      "transcript": "ਜਿਥੈ ਥੋੜਾ ਧਨੁ ਵੇਖੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.356,
      "end_time": 96.8,
      "transcript": "ਤਿਥੈ ਤਪਾ ਭਿਟੈ ਨਾਹੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 96.8,
      "end_time": 103.125,
      "transcript": "ਧਨਿ ਬਹੁਤੈ ਡਿਠੈ ਤਪੈ ਧਰਮੁ ਹਾਰਿਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 103.125,
      "end_time": 109.085,
      "transcript": "ਭਾਈ ਏਹੁ ਤਪਾ ਨ ਹੋਵੀ ਬਗੁਲਾ ਹੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 109.48,
      "end_time": 115.565,
      "transcript": "ਬਹਿ ਸਾਧ ਜਨਾ ਵੀਚਾਰਿਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 122.2,
      "end_time": 128.387,
      "transcript": "ਸਤ ਪੁਰਖ ਕੀ ਤਪਾ ਨਿੰਦਾ ਕਰੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 128.387,
      "end_time": 134.815,
      "transcript": "ਸੰਸਾਰੈ ਕੀ ਉਸਤਤੀ ਵਿਚਿ ਹੋਵੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 134.815,
      "end_time": 141.24,
      "transcript": "ਏਤੁ ਦੋਖੈ ਤਪਾ ਦਯਿ ਮਾਰਿਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 141.24,
      "end_time": 147.351,
      "transcript": "ਮਹਾ ਪੁਰਖਾਂ ਕੀ ਨਿੰਦਾ ਕਾ ਵੇਖੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 147.351,
      "end_time": 153.465,
      "transcript": "ਜਿ ਤਪੇ ਨੋ ਫਲੁ ਲਗਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 153.88,
      "end_time": 159.875,
      "transcript": "ਸਭੁ ਗਇਆ ਤਪੇ ਕਾ ਘਾਲਿਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 166.52,
      "end_time": 172.335,
      "transcript": "ਬਾਹਰਿ ਬਹੈ ਪੰਚਾ ਵਿਚਿ, ਤਪਾ ਸਦਾਏ"
    },
    {
      "section_id": "section-00021",
      "start_time": 172.88,
      "end_time": 179.155,
      "transcript": "ਅੰਦਰਿ ਬਹੈ ਤਪਾ ਪਾਪ ਕਮਾਏ"
    },
    {
      "section_id": "section-00022",
      "start_time": 179.155,
      "end_time": 185.43,
      "transcript": "ਹਰਿ ਅੰਦਰਲਾ ਪਾਪੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 185.43,
      "end_time": 191.865,
      "transcript": "ਪੰਚਾ ਨੋ ਉਘਾ ਕਰਿ ਵੇਖਾਲਿਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 198.16,
      "end_time": 204.385,
      "transcript": "ਧਰਮ ਰਾਇ ਜਮਕੰਕਰਾ ਨੋ ਆਖਿ ਛਡਿਆ"
    },
    {
      "section_id": "section-00025",
      "start_time": 204.385,
      "end_time": 210.555,
      "transcript": "ਏਸੁ ਤਪੇ ਨੋ ਤਿਥੈ ਖੜਿ ਪਾਇਹੁ"
    },
    {
      "section_id": "section-00026",
      "start_time": 210.555,
      "end_time": 217.12,
      "transcript": "ਜਿਥੈ ਮਹਾ ਮਹਾਂ ਹਤਿਆਰਿਆ"
    },
    {
      "section_id": "section-00027",
      "start_time": 217.12,
      "end_time": 223.345,
      "transcript": "ਫਿਰਿ ਏਸੁ ਤਪੇ ਦੈ ਮੁਹਿ ਕੋਈ ਲਗਹੁ ਨਾਹੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 223.345,
      "end_time": 229.195,
      "transcript": "ਏਹੁ ਸਤਿਗੁਰਿ ਹੈ ਫਿਟਕਾਰਿਆ"
    },
    {
      "section_id": "section-00029",
      "start_time": 229.64,
      "end_time": 235.465,
      "transcript": "ਹਰਿ ਕੈ ਦਰਿ ਵਰਤਿਆ"
    },
    {
      "section_id": "section-00030",
      "start_time": 235.76,
      "end_time": 241.905,
      "transcript": "ਸੁ ਨਾਨਕਿ ਆਖਿ ਸੁਣਾਇਆ"
    },
    {
      "section_id": "section-00031",
      "start_time": 242.36,
      "end_time": 249.075,
      "transcript": "ਸੋ ਬੂਝੈ, ਜੁ ਦਯਿ ਸਵਾਰਿਆ"
    },
    {
      "section_id": "section-00032",
      "start_time": 251.547,
      "end_time": 258.01,
      "transcript": "ਮਹਲਾ"
    },
    {
      "section_id": "section-00033",
      "start_time": 258.01,
      "end_time": 263.669,
      "transcript": "ਚੌਥਾ"
    },
    {
      "section_id": "section-00034",
      "start_time": 281.12,
      "end_time": 288.275,
      "transcript": "ਹਰਿ ਭਗਤਾਂ ਹਰਿ ਆਰਾਧਿਆ"
    },
    {
      "section_id": "section-00035",
      "start_time": 288.575,
      "end_time": 295.625,
      "transcript": "ਹਰਿ ਕੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00036",
      "start_time": 296.04,
      "end_time": 302.985,
      "transcript": "ਹਰਿ ਕੀਰਤਨੁ ਭਗਤ ਨਿਤ ਗਾਂਵਦੇ"
    },
    {
      "section_id": "section-00037",
      "start_time": 303.48,
      "end_time": 310.175,
      "transcript": "ਹਰਿ ਨਾਮੁ ਸੁਖਦਾਈ"
    },
    {
      "section_id": "section-00038",
      "start_time": 310.72,
      "end_time": 318.52,
      "transcript": "ਹਰਿ ਭਗਤਾਂ ਨੋ ਨਿਤ ਨਾਵੈ ਦੀ ਵਡਿਆਈ ਬਖਸੀਅਨੁ"
    },
    {
      "section_id": "section-00039",
      "start_time": 318.52,
      "end_time": 325.325,
      "transcript": "ਨਿਤ ਚੜੈ ਸਵਾਈ"
    },
    {
      "section_id": "section-00040",
      "start_time": 325.84,
      "end_time": 333.2,
      "transcript": "ਹਰਿ ਭਗਤਾਂ ਨੋ ਥਿਰੁ ਘਰੀ ਬਹਾਲਿਅਨੁ"
    },
    {
      "section_id": "section-00041",
      "start_time": 333.2,
      "end_time": 339.965,
      "transcript": "ਅਪਣੀ ਪੈਜ ਰਖਾਈ"
    },
    {
      "section_id": "section-00042",
      "start_time": 340.32,
      "end_time": 347.395,
      "transcript": "ਨਿੰਦਕਾਂ ਪਾਸਹੁ ਹਰਿ ਲੇਖਾ ਮੰਗਸੀ"
    },
    {
      "section_id": "section-00043",
      "start_time": 347.635,
      "end_time": 355.565,
      "transcript": "ਬਹੁ ਦੇਇ ਸਜਾਈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 362.075,
      "end_time": 369.14,
      "transcript": "ਜੇਹਾ ਨਿੰਦਕ ਅਪਣੈ ਜੀਇ ਕਮਾਵਦੇ"
    },
    {
      "section_id": "section-00045",
      "start_time": 369.14,
      "end_time": 376.165,
      "transcript": "ਤੇਹੋ ਫਲੁ ਪਾਈ"
    },
    {
      "section_id": "section-00046",
      "start_time": 376.6,
      "end_time": 383.795,
      "transcript": "ਅੰਦਰਿ ਕਮਾਣਾ ਸਰਪਰ ਉਘੜੈ"
    },
    {
      "section_id": "section-00047",
      "start_time": 383.795,
      "end_time": 390.595,
      "transcript": "ਭਾਵੈ ਕੋਈ ਬਹਿ ਧਰਤੀ ਵਿਚਿ ਕਮਾਈ"
    },
    {
      "section_id": "section-00048",
      "start_time": 391.08,
      "end_time": 397.835,
      "transcript": "ਜਨ ਨਾਨਕੁ ਦੇਖਿ ਵਿਗਸਿਆ"
    },
    {
      "section_id": "section-00049",
      "start_time": 398.28,
      "end_time": 405.075,
      "transcript": "ਹਰਿ ਕੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00050",
      "start_time": 405.44,
      "end_time": 412.515,
      "transcript": "ਪਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00051",
      "start_time": 416.6,
      "end_time": 424.44,
      "transcript": "ਭਗਤ ਜਨਾਂ ਕਾ ਰਾਖਾ ਹਰਿ ਆਪਿ ਹੈ, ਕਿਆ ਪਾਪੀ ਕਰੀਐ"
    },
    {
      "section_id": "section-00052",
      "start_time": 424.44,
      "end_time": 432.358,
      "transcript": "ਗੁਮਾਨੁ ਕਰਹਿ ਮੂੜ ਗੁਮਾਨੀਆ, ਵਿਸੁ ਖਾਧੀ ਮਰੀਐ"
    },
    {
      "section_id": "section-00053",
      "start_time": 432.358,
      "end_time": 440.84,
      "transcript": "ਆਇ ਲਗੇ ਨੀ ਦਿਹ ਥੋੜੜੇ ਜਿਉ ਪਕਾ ਖੇਤੁ ਲੁਣੀਐ"
    },
    {
      "section_id": "section-00054",
      "start_time": 440.84,
      "end_time": 448.365,
      "transcript": "ਜੇਹੇ ਕਰਮ ਕਮਾਵਦੇ, ਤੇਵੇਹੋ ਭਣੀਐ"
    },
    {
      "section_id": "section-00055",
      "start_time": 448.365,
      "end_time": 457.115,
      "transcript": "ਜਨ ਨਾਨਕ ਕਾ ਖਸਮੁ ਵਡਾ ਹੈ, ਸਭਨਾ ਦਾ ਧਣੀਐ"
    }
  ]
}

{
  "audio_file": "0250 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.115,
      "end_time": 3.414,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.52,
      "end_time": 18.68,
      "transcript": "ਨਿੰਦਉ, ਨਿੰਦਉ, ਮੋ ਕਉ ਲੋਗੁ ਨਿੰਦਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.68,
      "end_time": 24.665,
      "transcript": "ਨਿੰਦਾ ਜਨ ਕਉ, ਖਰੀ ਪਿਆਰੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.84,
      "end_time": 33.455,
      "transcript": "ਨਿੰਦਾ ਬਾਪੁ, ਨਿੰਦਾ ਮਹਤਾਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.885,
      "end_time": 46.28,
      "transcript": "ਨਿੰਦਾ ਹੋਇ, ਤ ਬੈਕੁੰਠਿ ਜਾਈਐ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.28,
      "end_time": 52.24,
      "transcript": "ਨਾਮੁ ਪਦਾਰਥੁ, ਮਨਹਿ ਬਸਾਈਐ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.24,
      "end_time": 58.4,
      "transcript": "ਰਿਦੈ ਸੁਧ, ਜਉ ਨਿੰਦਾ ਹੋਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.4,
      "end_time": 64.215,
      "transcript": "ਹਮਰੇ ਕਪਰੇ, ਨਿੰਦਕੁ ਧੋਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.215,
      "end_time": 70.64,
      "transcript": "ਨਿੰਦਾ ਕਰੈ, ਸੁ ਹਮਰਾ ਮੀਤੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.64,
      "end_time": 76.68,
      "transcript": "ਨਿੰਦਕ ਮਾਹਿ, ਹਮਾਰਾ ਚੀਤੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 76.68,
      "end_time": 82.8,
      "transcript": "ਨਿੰਦਕੁ ਸੋ, ਜੋ ਨਿੰਦਾ ਹੋਰੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 82.8,
      "end_time": 88.795,
      "transcript": "ਹਮਰਾ ਜੀਵਨੁ, ਨਿੰਦਕੁ ਲੋਰੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 88.795,
      "end_time": 95.12,
      "transcript": "ਨਿੰਦਾ ਹਮਰੀ, ਪ੍ਰੇਮ ਪਿਆਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 95.12,
      "end_time": 101.24,
      "transcript": "ਨਿੰਦਾ ਹਮਰਾ, ਕਰੈ ਉਧਾਰੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 101.24,
      "end_time": 107.32,
      "transcript": "ਜਨ ਕਬੀਰ ਕਉ, ਨਿੰਦਾ ਸਾਰੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 107.32,
      "end_time": 113.425,
      "transcript": "ਨਿੰਦਕੁ ਡੂਬਾ, ਹਮ ਉਤਰੇ ਪਾਰਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 125.405,
      "end_time": 131.415,
      "transcript": "ਰਾਜਾ ਰਾਮ ਤੂੰ ਐਸਾ ਨਿਰਭਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 131.415,
      "end_time": 137.758,
      "transcript": "ਤਰਨ ਤਾਰਨ ਰਾਮ ਰਾਇਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00019",
      "start_time": 143.248,
      "end_time": 149.528,
      "transcript": "ਜਬ ਹਮ ਹੋਤੇ ਤਬ ਤੁਮ ਨਾਹੀ"
    },
    {
      "section_id": "section-00020",
      "start_time": 149.528,
      "end_time": 155.495,
      "transcript": "ਅਬ ਤੁਮ ਹਹੁ ਹਮ ਨਾਹੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 155.495,
      "end_time": 161.84,
      "transcript": "ਅਬ ਹਮ ਤੁਮ ਏਕ ਭਏ ਹਹਿ"
    },
    {
      "section_id": "section-00022",
      "start_time": 161.84,
      "end_time": 167.705,
      "transcript": "ਏਕੈ ਦੇਖਤ ਮਨੁ ਪਤੀਆਹੀ"
    },
    {
      "section_id": "section-00023",
      "start_time": 167.705,
      "end_time": 173.955,
      "transcript": "ਜਬ ਬੁਧਿ ਹੋਤੀ ਤਬ ਬਲੁ ਕੈਸਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 173.955,
      "end_time": 179.585,
      "transcript": "ਅਬ ਬੁਧਿ ਬਲੁ ਨ ਖਟਾਈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 180.075,
      "end_time": 186.025,
      "transcript": "ਕਹਿ ਕਬੀਰ ਬੁਧਿ ਹਰਿ ਲਈ ਮੇਰੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 186.025,
      "end_time": 191.575,
      "transcript": "ਬੁਧਿ ਬਦਲੀ ਸਿਧਿ ਪਾਈ"
    }
  ]
}

{
  "audio_file": "0240 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.235,
      "end_time": 6.786,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.56,
      "end_time": 18.69,
      "transcript": "ਅਸਥਾਵਰ ਜੰਗਮ, ਕੀਟ ਪਤੰਗਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.69,
      "end_time": 24.515,
      "transcript": "ਅਨਿਕ ਜਨਮ, ਕੀਏ ਬਹੁ ਰੰਗਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.88,
      "end_time": 30.96,
      "transcript": "ਐਸੇ ਘਰ, ਹਮ ਬਹੁਤੁ ਬਸਾਏ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.96,
      "end_time": 40.315,
      "transcript": "ਜਬ ਹਮ ਰਾਮ, ਗਰਭ ਹੋਇ ਆਏ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.305,
      "end_time": 52.315,
      "transcript": "ਜੋਗੀ ਜਤੀ ਤਪੀ ਬ੍ਰਹਮਚਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.56,
      "end_time": 58.375,
      "transcript": "ਕਬਹੂ ਰਾਜਾ ਛਤ੍ਰਪਤਿ, ਕਬਹੂ ਭੇਖਾਰੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.8,
      "end_time": 64.765,
      "transcript": "ਸਾਕਤ ਮਰਹਿ, ਸੰਤ ਸਭਿ ਜੀਵਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.765,
      "end_time": 71.105,
      "transcript": "ਰਾਮ ਰਸਾਇਨੁ, ਰਸਨਾ ਪੀਵਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.105,
      "end_time": 77.255,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਪ੍ਰਭ ਕਿਰਪਾ ਕੀਜੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.255,
      "end_time": 83.015,
      "transcript": "ਹਾਰਿ ਪਰੇ, ਅਬ ਪੂਰਾ ਦੀਜੈ"
    }
  ]
}

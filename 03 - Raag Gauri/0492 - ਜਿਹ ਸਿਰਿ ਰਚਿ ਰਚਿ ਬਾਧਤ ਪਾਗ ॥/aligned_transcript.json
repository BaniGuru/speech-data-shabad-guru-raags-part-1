  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.835,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.085,
      "end_time": 19.454,
      "transcript": "ਜਿਹ ਸਿਰਿ, ਰਚਿ ਰਚਿ ਬਾਧਤ ਪਾਗ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.454,
      "end_time": 25.935,
      "transcript": "ਸੋ ਸਿਰੁ, ਚੁੰਚ ਸਵਾਰਹਿ ਕਾਗ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.2,
      "end_time": 32.58,
      "transcript": "ਇਸੁ ਤਨ ਧਨ ਕੋ, ਕਿਆ ਗਰਬਈਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.58,
      "end_time": 42.235,
      "transcript": "ਰਾਮ ਨਾਮੁ, ਕਾਹੇ ਨ ਦ੍ਰਿੜੀ੍ਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.8,
      "end_time": 55.025,
      "transcript": "ਕਹਤ ਕਬੀਰ, ਸੁਨਹੁ ਮਨ ਮੇਰੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.36,
      "end_time": 61.435,
      "transcript": "ਇਹੀ ਹਵਾਲ, ਹੋਹਿਗੇ ਤੇਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.805,
      "end_time": 68.175,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਕੇ ਪਦੇ ਪੈਤੀਸ"
    }
  ]
}

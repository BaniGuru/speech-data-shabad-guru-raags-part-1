{
  "audio_file": "0132 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.805,
      "end_time": 6.904,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.904,
      "end_time": 22.6,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਗੁਆਰੇਰੀ ਚਉਪਦੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.68,
      "end_time": 40.15,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 49.08,
      "end_time": 56.52,
      "transcript": "ਕਿਨ ਬਿਧਿ ਕੁਸਲੁ ਹੋਤ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 56.52,
      "end_time": 64.618,
      "transcript": "ਕਿਉ ਪਾਈਐ ਹਰਿ ਰਾਮ ਸਹਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 71.56,
      "end_time": 79.12,
      "transcript": "ਕੁਸਲੁ ਨ ਗ੍ਰਿਹਿ ਮੇਰੀ ਸਭ ਮਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 79.12,
      "end_time": 86.44,
      "transcript": "ਊਚੇ ਮੰਦਰ, ਸੁੰਦਰ ਛਾਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 86.44,
      "end_time": 94.04,
      "transcript": "ਝੂਠੇ ਲਾਲਚਿ, ਜਨਮੁ ਗਵਾਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 94.04,
      "end_time": 101.36,
      "transcript": "ਹਸਤੀ ਘੋੜੇ, ਦੇਖਿ ਵਿਗਾਸਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 101.36,
      "end_time": 108.8,
      "transcript": "ਲਸਕਰ ਜੋੜੇ, ਨੇਬ ਖਵਾਸਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 108.8,
      "end_time": 116.2,
      "transcript": "ਗਲਿ ਜੇਵੜੀ, ਹਉਮੈ ਕੇ ਫਾਸਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 116.2,
      "end_time": 123.307,
      "transcript": "ਰਾਜੁ ਕਮਾਵੈ, ਦਹ ਦਿਸ ਸਾਰੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 123.307,
      "end_time": 130.588,
      "transcript": "ਮਾਣੈ ਰੰਗ, ਭੋਗ ਬਹੁ ਨਾਰੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 130.588,
      "end_time": 137.743,
      "transcript": "ਜਿਉ ਨਰਪਤਿ, ਸੁਪਨੈ ਭੇਖਾਰੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 137.743,
      "end_time": 145.205,
      "transcript": "ਏਕੁ ਕੁਸਲੁ, ਮੋ ਕਉ ਸਤਿਗੁਰੂ ਬਤਾਇਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 145.205,
      "end_time": 152.52,
      "transcript": "ਹਰਿ ਜੋ ਕਿਛੁ ਕਰੇ ਸੁ ਹਰਿ ਕਿਆ ਭਗਤਾ ਭਾਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 152.52,
      "end_time": 159.88,
      "transcript": "ਜਨ ਨਾਨਕ ਹਉਮੈ ਮਾਰਿ ਸਮਾਇਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 159.88,
      "end_time": 167.24,
      "transcript": "ਇਨਿ ਬਿਧਿ ਕੁਸਲ ਹੋਤ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 167.24,
      "end_time": 174.58,
      "transcript": "ਇਉ ਪਾਈਐ ਹਰਿ ਰਾਮ ਸਹਾਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 174.58,
      "end_time": 181.69,
      "transcript": "ਇਨਿ ਬਿਧਿ ਕੁਸਲ ਹੋਤ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 181.69,
      "end_time": 192.781,
      "transcript": "ਇਉ ਪਾਈਐ ਹਰਿ ਰਾਮ ਸਹਾਈ ਰਹਾਉ ਦੂਜਾ"
    }
  ]
}

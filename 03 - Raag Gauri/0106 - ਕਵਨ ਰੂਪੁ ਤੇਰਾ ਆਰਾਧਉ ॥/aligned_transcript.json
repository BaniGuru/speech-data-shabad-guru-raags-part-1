{
  "audio_file": "0141 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.265,
      "end_time": 7.035,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.542,
      "end_time": 18.783,
      "transcript": "ਕਵਨ ਰੂਪੁ ਤੇਰਾ, ਆਰਾਧਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.783,
      "end_time": 24.8,
      "transcript": "ਕਵਨ ਜੋਗ ਕਾਇਆ, ਲੇ ਸਾਧਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.8,
      "end_time": 30.973,
      "transcript": "ਕਵਨ ਗੁਨੁ, ਜੋ ਤੁਝੁ ਲੈ ਗਾਵਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.973,
      "end_time": 40.552,
      "transcript": "ਕਵਨ ਬੋਲ, ਪਾਰਬ੍ਰਹਮ ਰੀਝਾਵਉ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.56,
      "end_time": 52.72,
      "transcript": "ਕਵਨ ਸੁ ਪੂਜਾ, ਤੇਰੀ ਕਰਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.72,
      "end_time": 58.88,
      "transcript": "ਕਵਨ ਸੁ ਬਿਧਿ, ਜਿਤੁ ਭਵਜਲ ਤਰਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.88,
      "end_time": 64.831,
      "transcript": "ਕਵਨ ਤਪੁ, ਜਿਤੁ ਤਪੀਆ ਹੋਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.831,
      "end_time": 71.245,
      "transcript": "ਕਵਨੁ ਸੁ ਨਾਮੁ, ਹਉਮੈ ਮਲੁ ਖੋਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.952,
      "end_time": 83.095,
      "transcript": "ਗੁਣ ਪੂਜਾ ਗਿਆਨ ਧਿਆਨ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.52,
      "end_time": 89.48,
      "transcript": "ਨਾਨਕ ਸਗਲ ਘਾਲ"
    },
    {
      "section_id": "section-00012",
      "start_time": 89.48,
      "end_time": 95.502,
      "transcript": "ਜਿਸੁ ਕਰਿ ਕਿਰਪਾ, ਸਤਿਗੁਰੁ ਮਿਲੈ ਦਇਆਲ"
    },
    {
      "section_id": "section-00013",
      "start_time": 95.502,
      "end_time": 101.8,
      "transcript": "ਤਿਸ ਹੀ ਗੁਨੁ, ਤਿਨ ਹੀ ਪ੍ਰਭੁ ਜਾਤਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 101.8,
      "end_time": 110.665,
      "transcript": "ਜਿਸ ਕੀ ਮਾਨਿ ਲੇਇ ਸੁਖਦਾਤਾ ਰਹਾਉ ਦੂਜਾ"
    }
  ]
}

{
  "audio_file": "0141 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.325,
      "end_time": 13.805,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 28.64,
      "end_time": 34.975,
      "transcript": "ਅਗਮ ਰੂਪ ਕਾ, ਮਨ ਮਹਿ ਥਾਨਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 34.975,
      "end_time": 41.345,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਕਿਨੈ ਵਿਰਲੈ ਜਾਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.345,
      "end_time": 47.6,
      "transcript": "ਸਹਜ ਕਥਾ ਕੇ, ਅੰਮ੍ਰਿਤ ਕੁੰਟਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 47.6,
      "end_time": 57.263,
      "transcript": "ਜਿਸਹਿ ਪਰਾਪਤਿ, ਤਿਸੁ ਲੈ ਭੁੰਚਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 63.0,
      "end_time": 69.013,
      "transcript": "ਅਨਹਤ ਬਾਣੀ, ਥਾਨੁ ਨਿਰਾਲਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 69.013,
      "end_time": 75.123,
      "transcript": "ਤਾ ਕੀ ਧੁਨਿ, ਮੋਹੇ ਗੋਪਾਲਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.123,
      "end_time": 81.339,
      "transcript": "ਤਹ ਸਹਜ ਅਖਾਰੇ, ਅਨੇਕ ਅਨੰਤਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.339,
      "end_time": 87.727,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਕੇ ਸੰਗੀ ਸੰਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 93.8,
      "end_time": 100.04,
      "transcript": "ਹਰਖ ਅਨੰਤ, ਸੋਗ ਨਹੀ ਬੀਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 100.04,
      "end_time": 105.705,
      "transcript": "ਸੋ ਘਰੁ, ਗੁਰਿ ਨਾਨਕ ਕਉ ਦੀਆ"
    }
  ]
}

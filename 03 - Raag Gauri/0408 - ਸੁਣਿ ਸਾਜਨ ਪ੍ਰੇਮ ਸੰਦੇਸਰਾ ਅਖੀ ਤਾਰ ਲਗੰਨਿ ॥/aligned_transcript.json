{
  "audio_file": "0224 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.175,
      "end_time": 4.685,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 5.16,
      "end_time": 12.535,
      "transcript": "ਸੁਣਿ ਸਾਜਨ ਪ੍ਰੇਮ ਸੰਦੇਸਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 12.96,
      "end_time": 20.208,
      "transcript": "ਅਖੀ ਤਾਰ ਲਗੰਨਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 20.68,
      "end_time": 27.945,
      "transcript": "ਗੁਰਿ ਤੁਠੈ ਸਜਣੁ ਮੇਲਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.36,
      "end_time": 35.385,
      "transcript": "ਜਨ ਨਾਨਕ ਸੁਖਿ ਸਵੰਨਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 35.84,
      "end_time": 39.975,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 47.52,
      "end_time": 54.735,
      "transcript": "ਸਤਿਗੁਰੁ ਦਾਤਾ ਦਇਆਲੁ ਹੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 55.12,
      "end_time": 62.215,
      "transcript": "ਜਿਸ ਨੋ ਦਇਆ ਸਦਾ ਹੋਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 62.76,
      "end_time": 69.945,
      "transcript": "ਸਤਿਗੁਰੁ ਅੰਦਰਹੁ ਨਿਰਵੈਰੁ ਹੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.36,
      "end_time": 77.705,
      "transcript": "ਸਭੁ ਦੇਖੈ ਬ੍ਰਹਮੁ ਇਕੁ ਸੋਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.6,
      "end_time": 92.97,
      "transcript": "ਨਿਰਵੈਰਾ ਨਾਲਿ ਜਿ ਵੈਰੁ ਚਲਾਇਦੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 92.97,
      "end_time": 100.555,
      "transcript": "ਤਿਨ ਵਿਚਹੁ ਤਿਸਟਿਆ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 100.68,
      "end_time": 107.965,
      "transcript": "ਸਤਿਗੁਰੁ ਸਭਨਾ ਦਾ ਭਲਾ ਮਨਾਇਦਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 107.965,
      "end_time": 115.375,
      "transcript": "ਤਿਸ ਦਾ ਬੁਰਾ ਕਿਉ ਹੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 115.72,
      "end_time": 122.855,
      "transcript": "ਸਤਿਗੁਰ ਨੋ ਜੇਹਾ ਕੋ ਇਛਦਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 123.24,
      "end_time": 130.245,
      "transcript": "ਤੇਹਾ ਫਲੁ ਪਾਏ ਕੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 130.765,
      "end_time": 138.015,
      "transcript": "ਨਾਨਕ ਕਰਤਾ ਸਭੁ ਕਿਛੁ ਜਾਣਦਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 138.335,
      "end_time": 149.905,
      "transcript": "ਜਿਦੂ ਕਿਛੁ ਗੁਝਾ ਨ ਹੋਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00019",
      "start_time": 153.96,
      "end_time": 162.32,
      "transcript": "ਜਿਸ ਨੋ ਸਾਹਿਬੁ ਵਡਾ ਕਰੇ, ਸੋਈ ਵਡ ਜਾਣੀ"
    },
    {
      "section_id": "section-00020",
      "start_time": 162.32,
      "end_time": 170.545,
      "transcript": "ਜਿਸੁ ਸਾਹਿਬ ਭਾਵੈ ਤਿਸੁ ਬਖਸਿ ਲਏ, ਸੋ ਸਾਹਿਬ ਮਨਿ ਭਾਣੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 170.545,
      "end_time": 178.857,
      "transcript": "ਜੇ ਕੋ ਓਸ ਦੀ ਰੀਸ ਕਰੇ, ਸੋ ਮੂੜ ਅਜਾਣੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 178.857,
      "end_time": 187.125,
      "transcript": "ਜਿਸ ਨੋ ਸਤਿਗੁਰੁ ਮੇਲੇ ਸੁ ਗੁਣ ਰਵੈ, ਗੁਣ ਆਖਿ ਵਖਾਣੀ"
    },
    {
      "section_id": "section-00023",
      "start_time": 187.4,
      "end_time": 196.695,
      "transcript": "ਨਾਨਕ ਸਚਾ ਸਚੁ ਹੈ, ਬੁਝਿ ਸਚਿ ਸਮਾਣੀ"
    }
  ]
}

  "audio_file": "0236 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.215,
      "end_time": 11.948,
      "transcript": "ਸਲੋਕ ਮਹਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.948,
      "end_time": 19.278,
      "transcript": "ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 28.695,
      "end_time": 36.025,
      "transcript": "ਜਿਨਾ ਸਾਸਿ ਗਿਰਾਸਿ ਨ ਵਿਸਰੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 36.025,
      "end_time": 42.815,
      "transcript": "ਹਰਿ ਨਾਮਾਂ ਮਨਿ ਮੰਤੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.32,
      "end_time": 50.065,
      "transcript": "ਧੰਨੁ ਸਿ ਸੇਈ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.56,
      "end_time": 57.125,
      "transcript": "ਪੂਰਨੁ ਸੋਈ ਸੰਤੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.32,
      "end_time": 61.005,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.2,
      "end_time": 74.685,
      "transcript": "ਅਠੇ ਪਹਰ ਭਉਦਾ ਫਿਰੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.135,
      "end_time": 81.705,
      "transcript": "ਖਾਵਣ ਸੰਦੜੈ ਸੂਲਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.2,
      "end_time": 88.5,
      "transcript": "ਦੋਜਕਿ ਪਉਦਾ ਕਿਉ ਰਹੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 88.5,
      "end_time": 95.645,
      "transcript": "ਜਾ ਚਿਤਿ ਨ ਹੋਇ ਰਸੂਲਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 96.195,
      "end_time": 99.665,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 99.665,
      "end_time": 108.455,
      "transcript": "ਤਿਸੈ ਸਰੇਵਹੁ ਪ੍ਰਾਣੀਹੋ, ਜਿਸ ਦੈ ਨਾਉ ਪਲੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 108.8,
      "end_time": 117.67,
      "transcript": "ਐਥੈ ਰਹਹੁ ਸੁਹੇਲਿਆ, ਅਗੈ ਨਾਲਿ ਚਲੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 117.67,
      "end_time": 126.375,
      "transcript": "ਘਰੁ ਬੰਧਹੁ ਸਚ ਧਰਮ ਕਾ, ਗਡਿ ਥੰਮੁ ਅਹਲੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 126.92,
      "end_time": 135.545,
      "transcript": "ਓਟ ਲੈਹੁ ਨਾਰਾਇਣੈ, ਦੀਨ ਦੁਨੀਆ ਝਲੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 135.88,
      "end_time": 145.03,
      "transcript": "ਨਾਨਕ ਪਕੜੇ ਚਰਣ ਹਰਿ, ਤਿਸੁ ਦਰਗਹ ਮਲੈ"
    }
  ]
}

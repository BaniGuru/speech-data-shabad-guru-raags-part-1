{
  "audio_file": "0120 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.425,
      "end_time": 7.16,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.16,
      "end_time": 14.56,
      "transcript": "ਸੁ ਥਾਉ ਸਚੁ, ਮਨੁ ਨਿਰਮਲੁ ਹੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.56,
      "end_time": 21.44,
      "transcript": "ਸਚਿ ਨਿਵਾਸੁ ਕਰੇ ਸਚੁ ਸੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.44,
      "end_time": 28.36,
      "transcript": "ਸਚੀ ਬਾਣੀ, ਜੁਗ ਚਾਰੇ ਜਾਪੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.36,
      "end_time": 35.526,
      "transcript": "ਸਭੁ ਕਿਛੁ ਸਾਚਾ, ਆਪੇ ਆਪੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.89,
      "end_time": 48.92,
      "transcript": "ਕਰਮੁ ਹੋਵੈ, ਸਤਸੰਗਿ ਮਿਲਾਏ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.92,
      "end_time": 57.808,
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਵੈ ਬੈਸਿ ਸੁ ਥਾਏ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.767,
      "end_time": 69.56,
      "transcript": "ਜਲਉ ਇਹ ਜਿਹਵਾ, ਦੂਜੈ ਭਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 69.56,
      "end_time": 76.52,
      "transcript": "ਹਰਿ ਰਸੁ ਨ ਚਾਖੈ, ਫੀਕਾ ਆਲਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.52,
      "end_time": 83.4,
      "transcript": "ਬਿਨੁ ਬੂਝੇ ਤਨੁ ਮਨੁ ਫੀਕਾ ਹੋਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.4,
      "end_time": 90.732,
      "transcript": "ਬਿਨੁ ਨਾਵੈ ਦੁਖੀਆ ਚਲਿਆ ਰੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.08,
      "end_time": 104.0,
      "transcript": "ਰਸਨਾ ਹਰਿ ਰਸੁ ਚਾਖਿਆ, ਸਹਜਿ ਸੁਭਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 104.0,
      "end_time": 110.695,
      "transcript": "ਗੁਰ ਕਿਰਪਾ ਤੇ, ਸਚਿ ਸਮਾਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 110.695,
      "end_time": 117.64,
      "transcript": "ਸਾਚੇ ਰਾਤੀ, ਗੁਰਸਬਦੁ ਵੀਚਾਰ"
    },
    {
      "section_id": "section-00015",
      "start_time": 117.64,
      "end_time": 124.984,
      "transcript": "ਅੰਮ੍ਰਿਤੁ ਪੀਵੈ ਨਿਰਮਲ ਧਾਰ"
    },
    {
      "section_id": "section-00016",
      "start_time": 131.52,
      "end_time": 138.2,
      "transcript": "ਨਾਮਿ ਸਮਾਵੈ, ਜੋ ਭਾਡਾ ਹੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 138.2,
      "end_time": 145.08,
      "transcript": "ਊਂਧੈ ਭਾਂਡੈ, ਟਿਕੈ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 145.08,
      "end_time": 151.827,
      "transcript": "ਗੁਰਸਬਦੀ ਮਨਿ ਨਾਮਿ ਨਿਵਾਸੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 151.827,
      "end_time": 159.327,
      "transcript": "ਨਾਨਕ ਸਚੁ ਭਾਂਡਾ, ਜਿਸੁ ਸਬਦ ਪਿਆਸ"
    }
  ]
}

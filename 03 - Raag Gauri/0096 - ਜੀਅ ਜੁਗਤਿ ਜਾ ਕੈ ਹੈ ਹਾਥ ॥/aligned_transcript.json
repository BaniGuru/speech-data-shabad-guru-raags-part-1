{
  "audio_file": "0139 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.96,
      "end_time": 7.37,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.37,
      "end_time": 14.64,
      "transcript": "ਜੀਅ ਜੁਗਤਿ, ਜਾ ਕੈ ਹੈ ਹਾਥ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.64,
      "end_time": 21.4,
      "transcript": "ਸੋ ਸਿਮਰਹੁ, ਅਨਾਥ ਕੋ ਨਾਥੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.4,
      "end_time": 28.28,
      "transcript": "ਪ੍ਰਭ ਚਿਤਿ ਆਏ, ਸਭੁ ਦੁਖੁ ਜਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.28,
      "end_time": 36.09,
      "transcript": "ਭੈ ਸਭ ਬਿਨਸਹਿ, ਹਰਿ ਕੈ ਨਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.88,
      "end_time": 48.72,
      "transcript": "ਬਿਨੁ ਹਰਿ ਭਉ ਕਾਹੇ ਕਾ ਮਾਨਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.72,
      "end_time": 57.13,
      "transcript": "ਹਰਿ ਬਿਸਰਤ, ਕਾਹੇ ਸੁਖੁ ਜਾਨਹਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.2,
      "end_time": 68.776,
      "transcript": "ਜਿਨਿ ਧਾਰੇ, ਬਹੁ ਧਰਣਿ ਅਗਾਸ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.776,
      "end_time": 75.57,
      "transcript": "ਜਾ ਕੀ ਜੋਤਿ, ਜੀਅ ਪਰਗਾਸ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.57,
      "end_time": 82.52,
      "transcript": "ਜਾ ਕੀ ਬਖਸ, ਨ ਮੇਟੈ ਕੋਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 82.52,
      "end_time": 89.36,
      "transcript": "ਸਿਮਰਿ ਸਿਮਰਿ ਪ੍ਰਭੁ, ਨਿਰਭਉ ਹੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 89.36,
      "end_time": 96.08,
      "transcript": "ਆਠ ਪਹਰ ਸਿਮਰਹੁ ਪ੍ਰਭ ਨਾਮੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 96.08,
      "end_time": 102.727,
      "transcript": "ਅਨਿਕ ਤੀਰਥ, ਮਜਨੁ ਇਸਨਾਨੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 102.727,
      "end_time": 109.64,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਕੀ ਸਰਣੀ ਪਾਹਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 109.64,
      "end_time": 116.24,
      "transcript": "ਕੋਟਿ ਕਲੰਕ, ਖਿਨ ਮਹਿ ਮਿਟਿ ਜਾਹਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 116.24,
      "end_time": 123.0,
      "transcript": "ਬੇਮੁਹਤਾਜੁ, ਪੂਰਾ ਪਾਤਿਸਾਹੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 123.0,
      "end_time": 129.72,
      "transcript": "ਪ੍ਰਭ ਸੇਵਕ ਸਾਚਾ ਵੇਸਾਹੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 129.72,
      "end_time": 136.56,
      "transcript": "ਗੁਰਿ ਪੂਰੈ, ਰਾਖੇ ਦੇ ਹਾਥ"
    },
    {
      "section_id": "section-00019",
      "start_time": 136.56,
      "end_time": 143.615,
      "transcript": "ਨਾਨਕ ਪਾਰਬ੍ਰਹਮ ਸਮਰਾਥ"
    }
  ]
}

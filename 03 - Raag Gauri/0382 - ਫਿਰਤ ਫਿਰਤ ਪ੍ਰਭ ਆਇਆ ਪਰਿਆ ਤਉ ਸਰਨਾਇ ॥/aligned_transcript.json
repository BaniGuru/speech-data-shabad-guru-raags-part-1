{
  "audio_file": "0216 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.09,
      "end_time": 14.625,
      "transcript": "ਸਲੋਕੁ ਫਿਰਤ ਫਿਰਤ ਪ੍ਰਭ ਆਇਆ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.48,
      "end_time": 24.215,
      "transcript": "ਪਰਿਆ ਤਉ ਸਰਨਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.945,
      "end_time": 38.545,
      "transcript": "ਨਾਨਕ ਕੀ ਪ੍ਰਭ ਬੇਨਤੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.545,
      "end_time": 54.005,
      "transcript": "ਅਪਨੀ ਭਗਤੀ ਲਾਇ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 72.555,
      "end_time": 80.485,
      "transcript": "ਜਾਚਕ ਜਨੁ ਜਾਚੈ, ਪ੍ਰਭ ਦਾਨੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 81.0,
      "end_time": 88.825,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਦੇਵਹੁ ਹਰਿ ਨਾਮੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 89.32,
      "end_time": 97.378,
      "transcript": "ਸਾਧ ਜਨਾ ਕੀ, ਮਾਗਉ ਧੂਰਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 97.378,
      "end_time": 105.806,
      "transcript": "ਪਾਰਬ੍ਰਹਮ, ਮੇਰੀ ਸਰਧਾ ਪੂਰਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 105.806,
      "end_time": 113.939,
      "transcript": "ਸਦਾ ਸਦਾ, ਪ੍ਰਭ ਕੇ ਗੁਨ ਗਾਵਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 113.939,
      "end_time": 122.28,
      "transcript": "ਸਾਸਿ ਸਾਸਿ, ਪ੍ਰਭ ਤੁਮਹਿ ਧਿਆਵਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 122.28,
      "end_time": 129.975,
      "transcript": "ਚਰਨ ਕਮਲ ਸਿਉ, ਲਾਗੈ ਪ੍ਰੀਤਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 130.44,
      "end_time": 138.035,
      "transcript": "ਭਗਤਿ ਕਰਉ, ਪ੍ਰਭ ਕੀ ਨਿਤ ਨੀਤਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 138.64,
      "end_time": 146.185,
      "transcript": "ਏਕ ਓਟ, ਏਕੋ ਆਧਾਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 146.625,
      "end_time": 154.595,
      "transcript": "ਨਾਨਕੁ ਮਾਗੈ, ਨਾਮੁ ਪ੍ਰਭ ਸਾਰੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 162.76,
      "end_time": 170.515,
      "transcript": "ਪ੍ਰਭ ਕੀ ਦ੍ਰਿਸਟਿ, ਮਹਾ ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 170.96,
      "end_time": 179.0,
      "transcript": "ਹਰਿ ਰਸੁ, ਪਾਵੈ ਬਿਰਲਾ ਕੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 179.0,
      "end_time": 186.99,
      "transcript": "ਜਿਨ ਚਾਖਿਆ, ਸੇ ਜਨ ਤ੍ਰਿਪਤਾਨੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 186.99,
      "end_time": 194.92,
      "transcript": "ਪੂਰਨ ਪੁਰਖ, ਨਹੀ ਡੋਲਾਨੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 194.92,
      "end_time": 203.015,
      "transcript": "ਸੁਭਰ ਭਰੇ, ਪ੍ਰੇਮ ਰਸ ਰੰਗਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 203.015,
      "end_time": 210.905,
      "transcript": "ਉਪਜੈ ਚਾਉ, ਸਾਧ ਕੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00021",
      "start_time": 211.365,
      "end_time": 219.025,
      "transcript": "ਪਰੇ ਸਰਨਿ, ਆਨ ਸਭ ਤਿਆਗਿ"
    },
    {
      "section_id": "section-00022",
      "start_time": 219.52,
      "end_time": 227.085,
      "transcript": "ਅੰਤਰਿ ਪ੍ਰਗਾਸ, ਅਨਦਿਨੁ ਲਿਵ ਲਾਗਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 227.56,
      "end_time": 234.985,
      "transcript": "ਬਡਭਾਗੀ, ਜਪਿਆ ਪ੍ਰਭੁ ਸੋਇ"
    },
    {
      "section_id": "section-00024",
      "start_time": 235.565,
      "end_time": 243.335,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ, ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 251.56,
      "end_time": 258.925,
      "transcript": "ਸੇਵਕ ਕੀ ਮਨਸਾ, ਪੂਰੀ ਭਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 259.44,
      "end_time": 266.965,
      "transcript": "ਸਤਿਗੁਰ ਤੇ, ਨਿਰਮਲ ਮਤਿ ਲਈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 267.4,
      "end_time": 274.865,
      "transcript": "ਜਨ ਕਉ, ਪ੍ਰਭੁ ਹੋਇਓ ਦਇਆਲੁ"
    },
    {
      "section_id": "section-00028",
      "start_time": 275.395,
      "end_time": 282.815,
      "transcript": "ਸੇਵਕੁ ਕੀਨੋ, ਸਦਾ ਨਿਹਾਲੁ"
    },
    {
      "section_id": "section-00029",
      "start_time": 283.36,
      "end_time": 290.815,
      "transcript": "ਬੰਧਨ ਕਾਟਿ, ਮੁਕਤਿ ਜਨੁ ਭਇਆ"
    },
    {
      "section_id": "section-00030",
      "start_time": 291.28,
      "end_time": 299.005,
      "transcript": "ਜਨਮ ਮਰਨ, ਦੂਖੁ ਭ੍ਰਮੁ ਗਇਆ"
    },
    {
      "section_id": "section-00031",
      "start_time": 299.32,
      "end_time": 306.695,
      "transcript": "ਇਛ ਪੁਨੀ, ਸਰਧਾ ਸਭ ਪੂਰੀ"
    },
    {
      "section_id": "section-00032",
      "start_time": 307.2,
      "end_time": 314.575,
      "transcript": "ਰਵਿ ਰਹਿਆ, ਸਦ ਸੰਗਿ ਹਜੂਰੀ"
    },
    {
      "section_id": "section-00033",
      "start_time": 315.04,
      "end_time": 322.555,
      "transcript": "ਜਿਸ ਕਾ ਸਾ, ਤਿਨਿ ਲੀਆ ਮਿਲਾਇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 322.975,
      "end_time": 331.128,
      "transcript": "ਨਾਨਕ ਭਗਤੀ, ਨਾਮਿ ਸਮਾਇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 342.84,
      "end_time": 350.8,
      "transcript": "ਸੋ ਕਿਉ ਬਿਸਰੈ, ਜਿ ਘਾਲ ਨ ਭਾਨੈ"
    },
    {
      "section_id": "section-00036",
      "start_time": 350.8,
      "end_time": 358.64,
      "transcript": "ਸੋ ਕਿਉ ਬਿਸਰੈ, ਜਿ ਕੀਆ ਜਾਨੈ"
    },
    {
      "section_id": "section-00037",
      "start_time": 358.64,
      "end_time": 366.425,
      "transcript": "ਸੋ ਕਿਉ ਬਿਸਰੈ, ਜਿਨਿ ਸਭੁ ਕਿਛੁ ਦੀਆ"
    },
    {
      "section_id": "section-00038",
      "start_time": 366.425,
      "end_time": 374.245,
      "transcript": "ਸੋ ਕਿਉ ਬਿਸਰੈ, ਜਿ ਜੀਵਨ ਜੀਆ"
    },
    {
      "section_id": "section-00039",
      "start_time": 374.68,
      "end_time": 382.6,
      "transcript": "ਸੋ ਕਿਉ ਬਿਸਰੈ, ਜਿ ਅਗਨਿ ਮਹਿ ਰਾਖੈ"
    },
    {
      "section_id": "section-00040",
      "start_time": 382.6,
      "end_time": 390.56,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਕੋ ਬਿਰਲਾ ਲਾਖੈ"
    },
    {
      "section_id": "section-00041",
      "start_time": 390.56,
      "end_time": 398.085,
      "transcript": "ਸੋ ਕਿਉ ਬਿਸਰੈ, ਜਿ ਬਿਖੁ ਤੇ ਕਾਢੈ"
    },
    {
      "section_id": "section-00042",
      "start_time": 398.56,
      "end_time": 406.295,
      "transcript": "ਜਨਮ ਜਨਮ ਕਾ, ਟੂਟਾ ਗਾਢੈ"
    },
    {
      "section_id": "section-00043",
      "start_time": 406.295,
      "end_time": 414.28,
      "transcript": "ਗੁਰਿ ਪੂਰੈ, ਤਤੁ ਇਹੈ ਬੁਝਾਇਆ"
    },
    {
      "section_id": "section-00044",
      "start_time": 414.28,
      "end_time": 421.965,
      "transcript": "ਪ੍ਰਭੁ ਅਪਨਾ, ਨਾਨਕ ਜਨ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00045",
      "start_time": 429.92,
      "end_time": 437.315,
      "transcript": "ਸਾਜਨ ਸੰਤ, ਕਰਹੁ ਇਹੁ ਕਾਮੁ"
    },
    {
      "section_id": "section-00046",
      "start_time": 437.8,
      "end_time": 445.56,
      "transcript": "ਆਨ ਤਿਆਗਿ, ਜਪਹੁ ਹਰਿ ਨਾਮੁ"
    },
    {
      "section_id": "section-00047",
      "start_time": 445.56,
      "end_time": 452.985,
      "transcript": "ਸਿਮਰਿ ਸਿਮਰਿ, ਸਿਮਰਿ ਸੁਖ ਪਾਵਹੁ"
    },
    {
      "section_id": "section-00048",
      "start_time": 453.375,
      "end_time": 461.08,
      "transcript": "ਆਪਿ ਜਪਹੁ, ਅਵਰਹ ਨਾਮੁ ਜਪਾਵਹੁ"
    },
    {
      "section_id": "section-00049",
      "start_time": 461.08,
      "end_time": 468.77,
      "transcript": "ਭਗਤਿ ਭਾਇ, ਤਰੀਐ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00050",
      "start_time": 468.77,
      "end_time": 476.285,
      "transcript": "ਬਿਨੁ ਭਗਤੀ, ਤਨੁ ਹੋਸੀ ਛਾਰੁ"
    },
    {
      "section_id": "section-00051",
      "start_time": 476.64,
      "end_time": 483.915,
      "transcript": "ਸਰਬ ਕਲਿਆਣ, ਸੂਖ ਨਿਧਿ ਨਾਮੁ"
    },
    {
      "section_id": "section-00052",
      "start_time": 484.48,
      "end_time": 492.24,
      "transcript": "ਬੂਡਤ ਜਾਤ, ਪਾਏ ਬਿਸ੍ਰਾਮੁ"
    },
    {
      "section_id": "section-00053",
      "start_time": 492.24,
      "end_time": 499.485,
      "transcript": "ਸਗਲ ਦੂਖ ਕਾ, ਹੋਵਤ ਨਾਸੁ"
    },
    {
      "section_id": "section-00054",
      "start_time": 499.975,
      "end_time": 507.86,
      "transcript": "ਨਾਨਕ, ਨਾਮੁ ਜਪਹੁ ਗੁਨਤਾਸੁ"
    },
    {
      "section_id": "section-00055",
      "start_time": 515.56,
      "end_time": 523.215,
      "transcript": "ਉਪਜੀ ਪ੍ਰੀਤਿ, ਪ੍ਰੇਮ ਰਸੁ ਚਾਉ"
    },
    {
      "section_id": "section-00056",
      "start_time": 523.215,
      "end_time": 531.16,
      "transcript": "ਮਨ ਤਨ ਅੰਤਰਿ, ਇਹੀ ਸੁਆਉ"
    },
    {
      "section_id": "section-00057",
      "start_time": 531.16,
      "end_time": 538.71,
      "transcript": "ਨੇਤ੍ਰਹੁ ਪੇਖਿ ਦਰਸੁ, ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00058",
      "start_time": 538.71,
      "end_time": 546.72,
      "transcript": "ਮਨੁ ਬਿਗਸੈ, ਸਾਧ ਚਰਨ ਧੋਇ"
    },
    {
      "section_id": "section-00059",
      "start_time": 546.72,
      "end_time": 554.055,
      "transcript": "ਭਗਤ ਜਨਾ ਕੈ, ਮਨਿ ਤਨਿ ਰੰਗੁ"
    },
    {
      "section_id": "section-00060",
      "start_time": 554.525,
      "end_time": 561.865,
      "transcript": "ਬਿਰਲਾ ਕੋਊ, ਪਾਵੈ ਸੰਗੁ"
    },
    {
      "section_id": "section-00061",
      "start_time": 562.045,
      "end_time": 569.625,
      "transcript": "ਏਕ ਬਸਤੁ, ਦੀਜੈ ਕਰਿ ਮਇਆ"
    },
    {
      "section_id": "section-00062",
      "start_time": 570.12,
      "end_time": 577.745,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਨਾਮੁ ਜਪਿ ਲਇਆ"
    },
    {
      "section_id": "section-00063",
      "start_time": 577.745,
      "end_time": 585.105,
      "transcript": "ਤਾ ਕੀ ਉਪਮਾ, ਕਹੀ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00064",
      "start_time": 585.625,
      "end_time": 593.305,
      "transcript": "ਨਾਨਕ, ਰਹਿਆ ਸਰਬ ਸਮਾਇ"
    },
    {
      "section_id": "section-00065",
      "start_time": 604.88,
      "end_time": 612.185,
      "transcript": "ਪ੍ਰਭ ਬਖਸੰਦ, ਦੀਨ ਦਇਆਲ"
    },
    {
      "section_id": "section-00066",
      "start_time": 612.64,
      "end_time": 619.99,
      "transcript": "ਭਗਤਿ ਵਛਲ, ਸਦਾ ਕਿਰਪਾਲ"
    },
    {
      "section_id": "section-00067",
      "start_time": 619.99,
      "end_time": 627.655,
      "transcript": "ਅਨਾਥ ਨਾਥ, ਗੋਬਿੰਦ ਗੁਪਾਲ"
    },
    {
      "section_id": "section-00068",
      "start_time": 628.16,
      "end_time": 635.665,
      "transcript": "ਸਰਬ ਘਟਾ, ਕਰਤ ਪ੍ਰਤਿਪਾਲ"
    },
    {
      "section_id": "section-00069",
      "start_time": 643.64,
      "end_time": 651.005,
      "transcript": "ਆਦਿ ਪੁਰਖ, ਕਾਰਣ ਕਰਤਾਰ"
    },
    {
      "section_id": "section-00070",
      "start_time": 651.4,
      "end_time": 658.875,
      "transcript": "ਭਗਤ ਜਨਾ ਕੇ, ਪ੍ਰਾਨ ਅਧਾਰ"
    },
    {
      "section_id": "section-00071",
      "start_time": 659.24,
      "end_time": 666.555,
      "transcript": "ਜੋ ਜੋ ਜਪੈ, ਸੁ ਹੋਇ ਪੁਨੀਤ"
    },
    {
      "section_id": "section-00072",
      "start_time": 666.96,
      "end_time": 674.225,
      "transcript": "ਭਗਤਿ ਭਾਇ, ਲਾਵੈ ਮਨ ਹੀਤ"
    },
    {
      "section_id": "section-00073",
      "start_time": 674.72,
      "end_time": 682.025,
      "transcript": "ਹਮ ਨਿਰਗੁਨੀਆਰ, ਨੀਚ ਅਜਾਨ"
    },
    {
      "section_id": "section-00074",
      "start_time": 682.525,
      "end_time": 690.05,
      "transcript": "ਨਾਨਕ, ਤੁਮਰੀ ਸਰਨਿ ਪੁਰਖ ਭਗਵਾਨ"
    },
    {
      "section_id": "section-00075",
      "start_time": 698.0,
      "end_time": 705.285,
      "transcript": "ਸਰਬ ਬੈਕੁੰਠ, ਮੁਕਤਿ ਮੋਖ ਪਾਏ"
    },
    {
      "section_id": "section-00076",
      "start_time": 705.72,
      "end_time": 713.4,
      "transcript": "ਏਕ ਨਿਮਖ, ਹਰਿ ਕੇ ਗੁਨ ਗਾਏ"
    },
    {
      "section_id": "section-00077",
      "start_time": 713.4,
      "end_time": 720.615,
      "transcript": "ਅਨਿਕ ਰਾਜ ਭੋਗ ਬਡਿਆਈ"
    },
    {
      "section_id": "section-00078",
      "start_time": 721.08,
      "end_time": 728.595,
      "transcript": "ਹਰਿ ਕੇ ਨਾਮ ਕੀ ਕਥਾ, ਮਨਿ ਭਾਈ"
    },
    {
      "section_id": "section-00079",
      "start_time": 736.355,
      "end_time": 743.825,
      "transcript": "ਬਹੁ ਭੋਜਨ, ਕਾਪਰ ਸੰਗੀਤ"
    },
    {
      "section_id": "section-00080",
      "start_time": 744.2,
      "end_time": 751.595,
      "transcript": "ਰਸਨਾ ਜਪਤੀ, ਹਰਿ ਹਰਿ ਨੀਤ"
    },
    {
      "section_id": "section-00081",
      "start_time": 752.04,
      "end_time": 759.495,
      "transcript": "ਭਲੀ ਸੁ ਕਰਨੀ, ਸੋਭਾ ਧਨਵੰਤ"
    },
    {
      "section_id": "section-00082",
      "start_time": 759.76,
      "end_time": 767.115,
      "transcript": "ਹਿਰਦੈ ਬਸੇ, ਪੂਰਨ ਗੁਰ ਮੰਤ"
    },
    {
      "section_id": "section-00083",
      "start_time": 767.52,
      "end_time": 774.785,
      "transcript": "ਸਾਧਸੰਗਿ, ਪ੍ਰਭ ਦੇਹੁ ਨਿਵਾਸ"
    },
    {
      "section_id": "section-00084",
      "start_time": 775.24,
      "end_time": 782.835,
      "transcript": "ਸਰਬ ਸੂਖ, ਨਾਨਕ ਪਰਗਾਸ"
    },
    {
      "section_id": "section-00085",
      "start_time": 798.24,
      "end_time": 805.714,
      "transcript": "ਸਾਧਸੰਗਿ, ਪ੍ਰਭ ਦੇਹੁ ਨਿਵਾਸ"

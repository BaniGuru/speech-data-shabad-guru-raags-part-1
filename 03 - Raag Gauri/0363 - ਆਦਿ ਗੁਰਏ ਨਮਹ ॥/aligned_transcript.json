{
  "audio_file": "0197 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.455,
      "end_time": 22.815,
      "transcript": "ਗਉੜੀ ਸੁਖਮਨੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 23.4,
      "end_time": 34.352,
      "transcript": "ਸਲੋਕੁ ਇਕਓਅੰਕਾਰਿ "
    },
    {
      "section_id": "section-00003",
      "start_time": 34.462,
      "end_time": 45.8,
      "transcript": "ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 57.094,
      "end_time": 64.915,
      "transcript": "ਆਦਿ ਗੁਰਏ, ਨਮਹ"
    },
    {
      "section_id": "section-00005",
      "start_time": 65.56,
      "end_time": 73.425,
      "transcript": "ਜੁਗਾਦਿ ਗੁਰਏ, ਨਮਹ"
    },
    {
      "section_id": "section-00006",
      "start_time": 74.44,
      "end_time": 82.795,
      "transcript": "ਸਤਿਗੁਰਏ, ਨਮਹ"
    },
    {
      "section_id": "section-00007",
      "start_time": 82.96,
      "end_time": 93.995,
      "transcript": "ਸ੍ਰੀ ਗੁਰਦੇਵਏ, ਨਮਹ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 105.12,
      "end_time": 114.085,
      "transcript": "ਸਿਮਰਉ ਸਿਮਰਿ ਸਿਮਰਿ, ਸੁਖੁ ਪਾਵਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 114.085,
      "end_time": 123.59,
      "transcript": "ਕਲਿ ਕਲੇਸ, ਤਨ ਮਾਹਿ ਮਿਟਾਵਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 123.59,
      "end_time": 132.54,
      "transcript": "ਸਿਮਰਉ ਜਾਸੁ, ਬਿਸੁੰਭਰ ਏਕੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 132.54,
      "end_time": 141.892,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਅਗਨਤ ਅਨੇਕੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 141.892,
      "end_time": 151.01,
      "transcript": "ਬੇਦ ਪੁਰਾਨ, ਸਿੰਮ੍ਰਿਤਿ ਸੁਧਾਖੵਰ"
    },
    {
      "section_id": "section-00013",
      "start_time": 151.01,
      "end_time": 160.16,
      "transcript": "ਕੀਨੇ ਰਾਮ ਨਾਮ, ਇਕ ਆਖੵਰ"
    },
    {
      "section_id": "section-00014",
      "start_time": 160.16,
      "end_time": 169.2,
      "transcript": "ਕਿਨਕਾ ਏਕ, ਜਿਸੁ ਜੀਅ ਬਸਾਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 169.2,
      "end_time": 178.24,
      "transcript": "ਤਾ ਕੀ ਮਹਿਮਾ, ਗਨੀ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 178.24,
      "end_time": 186.645,
      "transcript": "ਕਾਂਖੀ, ਏਕੈ ਦਰਸ ਤੁਹਾਰੋ"
    },
    {
      "section_id": "section-00017",
      "start_time": 187.215,
      "end_time": 196.325,
      "transcript": "ਨਾਨਕ ਉਨ ਸੰਗਿ, ਮੋਹਿ ਉਧਾਰੋ"
    },
    {
      "section_id": "section-00018",
      "start_time": 205.2,
      "end_time": 213.899,
      "transcript": "ਸੁਖਮਨੀ ਸੁਖ, ਅੰਮ੍ਰਿਤ ਪ੍ਰਭ ਨਾਮੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 213.899,
      "end_time": 223.155,
      "transcript": "ਭਗਤ ਜਨਾ ਕੈ, ਮਨਿ ਬਿਸ੍ਰਾਮ ਰਹਾਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 232.12,
      "end_time": 241.055,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਗਰਭਿ ਨ ਬਸੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 241.055,
      "end_time": 249.96,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਦੂਖੁ ਜਮੁ ਨਸੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 249.96,
      "end_time": 258.92,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਕਾਲੁ ਪਰਹਰੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 258.92,
      "end_time": 267.6,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਦੁਸਮਨੁ ਟਰੈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 267.6,
      "end_time": 276.645,
      "transcript": "ਪ੍ਰਭ ਸਿਮਰਤ, ਕਛੁ ਬਿਘਨੁ ਨ ਲਾਗੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 276.645,
      "end_time": 285.4,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਅਨਦਿਨੁ ਜਾਗੈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 285.4,
      "end_time": 293.945,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਭਉ ਨ ਬਿਆਪੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 293.945,
      "end_time": 303.09,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਦੁਖੁ ਨ ਸੰਤਾਪੈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 303.09,
      "end_time": 312.04,
      "transcript": "ਪ੍ਰਭ ਕਾ ਸਿਮਰਨੁ, ਸਾਧ ਕੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00029",
      "start_time": 312.04,
      "end_time": 321.337,
      "transcript": "ਸਰਬ ਨਿਧਾਨ, ਨਾਨਕ ਹਰਿ ਰੰਗਿ"
    },
    {
      "section_id": "section-00030",
      "start_time": 329.68,
      "end_time": 338.43,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਰਿਧਿ ਸਿਧਿ ਨਉ ਨਿਧਿ"
    },
    {
      "section_id": "section-00031",
      "start_time": 338.43,
      "end_time": 346.875,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਗਿਆਨੁ ਧਿਆਨੁ ਤਤੁ ਬੁਧਿ"
    },
    {
      "section_id": "section-00032",
      "start_time": 346.875,
      "end_time": 355.699,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਜਪ ਤਪ ਪੂਜਾ"
    },
    {
      "section_id": "section-00033",
      "start_time": 355.699,
      "end_time": 364.64,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਬਿਨਸੈ ਦੂਜਾ"
    },
    {
      "section_id": "section-00034",
      "start_time": 364.64,
      "end_time": 373.52,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਤੀਰਥ ਇਸਨਾਨੀ"
    },
    {
      "section_id": "section-00035",
      "start_time": 373.52,
      "end_time": 382.16,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਦਰਗਹ ਮਾਨੀ"
    },
    {
      "section_id": "section-00036",
      "start_time": 382.16,
      "end_time": 390.355,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਹੋਇ ਸੁ ਭਲਾ"
    },
    {
      "section_id": "section-00037",
      "start_time": 390.92,
      "end_time": 399.155,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਸੁਫਲ ਫਲਾ"
    },
    {
      "section_id": "section-00038",
      "start_time": 399.64,
      "end_time": 407.955,
      "transcript": "ਸੇ ਸਿਮਰਹਿ, ਜਿਨ ਆਪਿ ਸਿਮਰਾਏ"
    },
    {
      "section_id": "section-00039",
      "start_time": 407.955,
      "end_time": 418.625,
      "transcript": "ਨਾਨਕ ਤਾ ਕੈ, ਲਾਗਉ ਪਾਏ"
    },
    {
      "section_id": "section-00040",
      "start_time": 425.68,
      "end_time": 434.48,
      "transcript": "ਪ੍ਰਭ ਕਾ ਸਿਮਰਨੁ, ਸਭ ਤੇ ਊਚਾ"
    },
    {
      "section_id": "section-00041",
      "start_time": 434.48,
      "end_time": 443.24,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਉਧਰੇ ਮੂਚਾ"
    },
    {
      "section_id": "section-00042",
      "start_time": 443.24,
      "end_time": 451.697,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਤ੍ਰਿਸਨਾ ਬੁਝੈ"
    },
    {
      "section_id": "section-00043",
      "start_time": 451.697,
      "end_time": 460.665,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਸਭੁ ਕਿਛੁ ਸੁਝੈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 460.8,
      "end_time": 469.6,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਨਾਹੀ ਜਮ ਤ੍ਰਾਸਾ"
    },
    {
      "section_id": "section-00045",
      "start_time": 469.6,
      "end_time": 478.4,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਪੂਰਨ ਆਸਾ"
    },
    {
      "section_id": "section-00046",
      "start_time": 478.4,
      "end_time": 486.595,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਮਨ ਕੀ ਮਲੁ ਜਾਇ"
    },
    {
      "section_id": "section-00047",
      "start_time": 487.24,
      "end_time": 495.84,
      "transcript": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ, ਰਿਦ ਮਾਹਿ ਸਮਾਇ"
    },
    {
      "section_id": "section-00048",
      "start_time": 495.84,
      "end_time": 503.935,
      "transcript": "ਪ੍ਰਭ ਜੀ ਬਸਹਿ, ਸਾਧ ਕੀ ਰਸਨਾ"
    },
    {
      "section_id": "section-00049",
      "start_time": 504.555,
      "end_time": 513.195,
      "transcript": "ਨਾਨਕ ਜਨ ਕਾ, ਦਾਸਨਿ ਦਸਨਾ"
    },
    {
      "section_id": "section-00050",
      "start_time": 522.0,
      "end_time": 530.577,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸੇ ਧਨਵੰਤੇ"
    },
    {
      "section_id": "section-00051",
      "start_time": 530.577,
      "end_time": 539.015,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸੇ ਪਤਿਵੰਤੇ"
    },
    {
      "section_id": "section-00052",
      "start_time": 539.4,
      "end_time": 547.455,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸੇ ਜਨ ਪਰਵਾਨ"
    },
    {
      "section_id": "section-00053",
      "start_time": 548.12,
      "end_time": 556.245,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸੇ ਪੁਰਖ ਪ੍ਰਧਾਨ"
    },
    {
      "section_id": "section-00054",
      "start_time": 556.64,
      "end_time": 565.395,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸਿ ਬੇਮੁਹਤਾਜੇ"
    },
    {
      "section_id": "section-00055",
      "start_time": 565.395,
      "end_time": 574.04,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸਿ ਸਰਬ ਕੇ ਰਾਜੇ"
    },
    {
      "section_id": "section-00056",
      "start_time": 574.04,
      "end_time": 582.095,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸੇ ਸੁਖਵਾਸੀ"
    },
    {
      "section_id": "section-00057",
      "start_time": 582.68,
      "end_time": 590.795,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸਦਾ ਅਬਿਨਾਸੀ"
    },
    {
      "section_id": "section-00058",
      "start_time": 591.28,
      "end_time": 599.335,
      "transcript": "ਸਿਮਰਨ ਤੇ ਲਾਗੇ, ਜਿਨ ਆਪਿ ਦਇਆਲਾ"
    },
    {
      "section_id": "section-00059",
      "start_time": 600.025,
      "end_time": 609.495,
      "transcript": "ਨਾਨਕ ਜਨ ਕੀ, ਮੰਗੈ ਰਵਾਲਾ"
    },
    {
      "section_id": "section-00060",
      "start_time": 617.32,
      "end_time": 625.76,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸੇ ਪਰਉਪਕਾਰੀ"
    },
    {
      "section_id": "section-00061",
      "start_time": 625.76,
      "end_time": 634.275,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਤਿਨ ਸਦ ਬਲਿਹਾਰੀ"
    },
    {
      "section_id": "section-00062",
      "start_time": 634.72,
      "end_time": 643.275,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਸੇ ਮੁਖ ਸੁਹਾਵੇ"
    },
    {
      "section_id": "section-00063",
      "start_time": 643.44,
      "end_time": 652.07,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਤਿਨ ਸੂਖਿ ਬਿਹਾਵੈ"
    },
    {
      "section_id": "section-00064",
      "start_time": 652.07,
      "end_time": 660.69,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਤਿਨ ਆਤਮੁ ਜੀਤਾ"
    },
    {
      "section_id": "section-00065",
      "start_time": 660.69,
      "end_time": 669.105,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਤਿਨ ਨਿਰਮਲ ਰੀਤਾ"
    },
    {
      "section_id": "section-00066",
      "start_time": 669.36,
      "end_time": 677.525,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਤਿਨ ਅਨਦ ਘਨੇਰੇ"
    },
    {
      "section_id": "section-00067",
      "start_time": 678.12,
      "end_time": 686.409,
      "transcript": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ, ਬਸਹਿ ਹਰਿ ਨੇਰੇ"
    },
    {
      "section_id": "section-00068",
      "start_time": 686.409,
      "end_time": 694.785,
      "transcript": "ਸੰਤ ਕ੍ਰਿਪਾ ਤੇ, ਅਨਦਿਨੁ ਜਾਗਿ"
    },
    {
      "section_id": "section-00069",
      "start_time": 695.395,
      "end_time": 704.974,
      "transcript": "ਨਾਨਕ, ਸਿਮਰਨੁ ਪੂਰੈ ਭਾਗਿ"
    },
    {
      "section_id": "section-00070",
      "start_time": 712.92,
      "end_time": 721.155,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਕਾਰਜ ਪੂਰੇ"
    },
    {
      "section_id": "section-00071",
      "start_time": 721.72,
      "end_time": 730.268,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਕਬਹੁ ਨ ਝੂਰੇ"
    },
    {
      "section_id": "section-00072",
      "start_time": 730.268,
      "end_time": 739.095,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਹਰਿ ਗੁਨ ਬਾਨੀ"
    },
    {
      "section_id": "section-00073",
      "start_time": 739.095,
      "end_time": 747.72,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਸਹਜਿ ਸਮਾਨੀ"
    },
    {
      "section_id": "section-00074",
      "start_time": 747.72,
      "end_time": 756.44,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਨਿਹਚਲ ਆਸਨੁ"
    },
    {
      "section_id": "section-00075",
      "start_time": 756.44,
      "end_time": 765.08,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਕਮਲ ਬਿਗਾਸਨੁ"
    },
    {
      "section_id": "section-00076",
      "start_time": 765.08,
      "end_time": 773.215,
      "transcript": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ, ਅਨਹਦ ਝੁਨਕਾਰ"
    },
    {
      "section_id": "section-00077",
      "start_time": 773.84,
      "end_time": 782.115,
      "transcript": "ਸੁਖੁ ਪ੍ਰਭ ਸਿਮਰਨ ਕਾ, ਅੰਤੁ ਨ ਪਾਰ"
    },
    {
      "section_id": "section-00078",
      "start_time": 782.52,
      "end_time": 790.555,
      "transcript": "ਸਿਮਰਹਿ ਸੇ ਜਨ, ਜਿਨ ਕਉ ਪ੍ਰਭ ਮਇਆ"
    },
    {
      "section_id": "section-00079",
      "start_time": 791.215,
      "end_time": 799.865,
      "transcript": "ਨਾਨਕ ਤਿਨ ਜਨ, ਸਰਨੀ ਪਇਆ"
    },
    {
      "section_id": "section-00080",
      "start_time": 808.6,
      "end_time": 816.715,
      "transcript": "ਹਰਿ ਸਿਮਰਨੁ ਕਰਿ, ਭਗਤ ਪ੍ਰਗਟਾਏ"
    },
    {
      "section_id": "section-00081",
      "start_time": 817.36,
      "end_time": 825.575,
      "transcript": "ਹਰਿ ਸਿਮਰਨਿ ਲਗਿ, ਬੇਦ ਉਪਾਏ"
    },
    {

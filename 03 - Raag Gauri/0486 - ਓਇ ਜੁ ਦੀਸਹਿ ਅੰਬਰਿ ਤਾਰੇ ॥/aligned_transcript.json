  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.505,
      "end_time": 6.985,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.48,
      "end_time": 14.353,
      "transcript": "ਓਇ ਜੁ ਦੀਸਹਿ, ਅੰਬਰਿ ਤਾਰੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.353,
      "end_time": 21.52,
      "transcript": "ਕਿਨਿ ਓਇ ਚੀਤੇ, ਚੀਤਨਹਾਰੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.52,
      "end_time": 28.392,
      "transcript": "ਕਹੁ ਰੇ ਪੰਡਿਤ, ਅੰਬਰੁ ਕਾ ਸਿਉ ਲਾਗਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.392,
      "end_time": 35.515,
      "transcript": "ਬੂਝੈ, ਬੂਝਨਹਾਰੁ ਸਭਾਗਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.045,
      "end_time": 49.68,
      "transcript": "ਸੂਰਜ ਚੰਦੁ, ਕਰਹਿ ਉਜੀਆਰਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.68,
      "end_time": 56.76,
      "transcript": "ਸਭ ਮਹਿ ਪਸਰਿਆ, ਬ੍ਰਹਮ ਪਸਾਰਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 56.76,
      "end_time": 63.76,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਜਾਨੈਗਾ ਸੋਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.76,
      "end_time": 70.161,
      "transcript": "ਹਿਰਦੈ ਰਾਮੁ, ਮੁਖਿ ਰਾਮੈ ਹੋਇ"
    }
  ]
}

{
  "audio_file": "0152 B PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.164,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.32,
      "end_time": 17.975,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਭਾਹਿ ਨ ਜਲੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.44,
      "end_time": 24.68,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਮਾਇਆ ਨਹੀ ਛਲੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.68,
      "end_time": 30.355,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਨਹੀ ਡੂਬੈ ਜਲਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.76,
      "end_time": 36.495,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਸੁਫਲ ਫਲਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 36.88,
      "end_time": 42.635,
      "transcript": "ਸਭ ਭੈ ਮਿਟਹਿ, ਤੁਮਾਰੈ ਨਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 43.16,
      "end_time": 50.685,
      "transcript": "ਭੇਟਤ ਸੰਗਿ, ਹਰਿ ਹਰਿ ਗੁਨ ਗਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.68,
      "end_time": 64.675,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਮਿਟੈ ਸਭ ਚਿੰਤਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.0,
      "end_time": 71.23,
      "transcript": "ਹਰਿ ਸਿਉ ਸੋ ਰਚੈ, ਜਿਸੁ ਸਾਧ ਕਾ ਮੰਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.23,
      "end_time": 77.225,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਜਮ ਕੀ ਨਹੀ ਤ੍ਰਾਸ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.52,
      "end_time": 83.865,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਪੂਰਨ ਆਸ"
    },
    {
      "section_id": "section-00012",
      "start_time": 90.2,
      "end_time": 96.48,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਦੂਖੁ ਨ ਲਾਗੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 96.48,
      "end_time": 103.025,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤਾ, ਅਨਦਿਨੁ ਜਾਗੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 109.16,
      "end_time": 115.44,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤਾ, ਸਹਜ ਘਰਿ ਵਸੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 115.44,
      "end_time": 121.845,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਭ੍ਰਮੁ ਭਉ ਨਸੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 127.96,
      "end_time": 134.2,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਮਤਿ ਊਤਮ ਹੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 134.2,
      "end_time": 140.48,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਨਿਰਮਲ ਸੋਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 140.48,
      "end_time": 146.345,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਤਿਨ ਕਉ ਬਲਿ ਜਾਈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 146.345,
      "end_time": 152.725,
      "transcript": "ਜਿਨ ਕਉ ਪ੍ਰਭੁ ਮੇਰਾ, ਬਿਸਰਤ ਨਾਹੀ"
    }
  ]
}

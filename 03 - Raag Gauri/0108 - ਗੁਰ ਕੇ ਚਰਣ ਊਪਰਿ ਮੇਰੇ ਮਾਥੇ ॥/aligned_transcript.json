{
  "audio_file": "0141 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 6.267,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.107,
      "end_time": 18.232,
      "transcript": "ਗੁਰ ਕੇ ਚਰਣ, ਊਪਰਿ ਮੇਰੇ ਮਾਥੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.232,
      "end_time": 24.335,
      "transcript": "ਤਾ ਤੇ ਦੁਖ ਮੇਰੇ, ਸਗਲੇ ਲਾਥੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.335,
      "end_time": 30.44,
      "transcript": "ਸਤਿਗੁਰ ਅਪੁਨੇ ਕਉ, ਕੁਰਬਾਨੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.44,
      "end_time": 39.595,
      "transcript": "ਆਤਮ ਚੀਨਿ, ਪਰਮ ਰੰਗ ਮਾਨੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.64,
      "end_time": 51.664,
      "transcript": "ਚਰਣ ਰੇਣੁ, ਗੁਰ ਕੀ ਮੁਖਿ ਲਾਗੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.664,
      "end_time": 57.687,
      "transcript": "ਅਹੰਬੁਧਿ, ਤਿਨਿ ਸਗਲ ਤਿਆਗੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.687,
      "end_time": 63.8,
      "transcript": "ਗੁਰ ਕਾ ਸਬਦੁ, ਲਗੋ ਮਨਿ ਮੀਠਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.8,
      "end_time": 69.911,
      "transcript": "ਪਾਰਬ੍ਰਹਮੁ, ਤਾ ਤੇ ਮੋਹਿ ਡੀਠਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.92,
      "end_time": 81.775,
      "transcript": "ਗੁਰੁ ਸੁਖਦਾਤਾ, ਗੁਰੁ ਕਰਤਾਰੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.775,
      "end_time": 87.495,
      "transcript": "ਜੀਅ ਪ੍ਰਾਣ ਨਾਨਕ ਗੁਰੁ ਆਧਾਰੁ"
    }
  ]
}

{
  "audio_file": "0154 D PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.215,
      "end_time": 8.055,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.181,
      "end_time": 22.495,
      "transcript": "ਹਰਿ ਪੇਖਨ ਕਉ, ਸਿਮਰਤ ਮਨੁ ਮੇਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.04,
      "end_time": 30.095,
      "transcript": "ਆਸ ਪਿਆਸੀ ਚਿਤਵਉ ਦਿਨੁ ਰੈਨੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.68,
      "end_time": 38.025,
      "transcript": "ਹੈ ਕੋਈ ਸੰਤੁ ਮਿਲਾਵੈ ਨੇਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.555,
      "end_time": 52.655,
      "transcript": "ਸੇਵਾ ਕਰਉ ਦਾਸ ਦਾਸਨ ਕੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.08,
      "end_time": 60.085,
      "transcript": "ਅਨਿਕ ਭਾਂਤਿ ਤਿਸੁ ਕਰਉ ਨਿਹੋਰਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.56,
      "end_time": 68.007,
      "transcript": "ਤੁਲਾ ਧਾਰਿ ਤੋਲੇ ਸੁਖ ਸਗਲੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.007,
      "end_time": 75.205,
      "transcript": "ਬਿਨੁ ਹਰਿ ਦਰਸ ਸਭੋ ਹੀ ਥੋਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.565,
      "end_time": 82.835,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਗਾਏ ਗੁਨ ਸਾਗਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.28,
      "end_time": 90.624,
      "transcript": "ਜਨਮ ਜਨਮ ਕੋ ਜਾਤ ਬਹੋਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 90.624,
      "end_time": 98.175,
      "transcript": "ਆਨਦ ਸੂਖ ਭੇਟਤ ਹਰਿ ਨਾਨਕ"
    },
    {
      "section_id": "section-00012",
      "start_time": 98.465,
      "end_time": 105.535,
      "transcript": "ਜਨਮੁ ਕ੍ਰਿਤਾਰਥੁ ਸਫਲੁ ਸਵੇਰਾ"
    }
  ]
}

      "transcript": "ਜਿਥਹੁ ਵੰਞੈ ਜਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 40.56,
      "end_time": 46.745,
      "transcript": "ਤਿਥਾਊ ਮਉਜੂਦੁ ਸੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 46.745,
      "end_time": 50.02,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 50.02,
      "end_time": 56.36,
      "transcript": "ਚੜਿ ਕੈ ਘੋੜੜੈ ਕੁੰਦੇ ਪਕੜਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 56.36,
      "end_time": 61.885,
      "transcript": "ਖੂੰਡੀ ਦੀ ਖੇਡਾਰੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 62.4,
      "end_time": 68.755,
      "transcript": "ਹੰਸਾ ਸੇਤੀ ਚਿਤੁ ਉਲਾਸਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 68.755,
      "end_time": 74.355,
      "transcript": "ਕੁਕੜ ਦੀ ਓਡਾਰੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 74.6,
      "end_time": 76.535,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 85.978,
      "end_time": 93.785,
      "transcript": "ਰਸਨਾ ਉਚਰੈ ਹਰਿ ਸ੍ਰਵਣੀ ਸੁਣੈ, ਸੋ ਉਧਰੈ ਮਿਤਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 93.785,
      "end_time": 101.525,
      "transcript": "ਹਰਿ ਜਸੁ ਲਿਖਹਿ ਲਾਇ ਭਾਵਨੀ, ਸੇ ਹਸਤ ਪਵਿਤਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 101.72,
      "end_time": 109.515,
      "transcript": "ਅਠਸਠਿ ਤੀਰਥ ਮਜਨਾ, ਸਭਿ ਪੁੰਨ ਤਿਨਿ ਕਿਤਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 109.72,
      "end_time": 117.587,
      "transcript": "ਸੰਸਾਰ ਸਾਗਰ ਤੇ ਉਧਰੇ, ਬਿਖਿਆ ਗੜੁ ਜਿਤਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 117.587,
      "end_time": 125.69,
      "transcript": "ਨਾਨਕ ਲੜਿ ਲਾਇ ਉਧਾਰਿਅਨੁ, ਦਯੁ ਸੇਵਿ ਅਮਿਤਾ"
    }
  ]
}

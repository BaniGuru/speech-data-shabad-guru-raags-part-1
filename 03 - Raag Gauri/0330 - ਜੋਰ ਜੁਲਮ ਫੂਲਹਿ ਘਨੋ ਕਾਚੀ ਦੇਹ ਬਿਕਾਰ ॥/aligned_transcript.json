      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.76,
      "end_time": 16.673,
      "transcript": "ਜੋਰ ਜੁਲਮ ਫੂਲਹਿ ਘਨੋ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.673,
      "end_time": 23.015,
      "transcript": "ਕਾਚੀ ਦੇਹ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.6,
      "end_time": 30.333,
      "transcript": "ਅਹੰਬੁਧਿ ਬੰਧਨ ਪਰੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.333,
      "end_time": 39.025,
      "transcript": "ਨਾਨਕ ਨਾਮ ਛੁਟਾਰ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.985,
      "end_time": 49.45,
      "transcript": "ਜਜਾ ਜਾਨੈ, ਹਉ ਕਛੁ ਹੂਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.45,
      "end_time": 53.64,
      "transcript": "ਬਾਧਿਓ, ਜਿਉ ਨਲਿਨੀ ਭ੍ਰਮਿ ਸੂਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 53.64,
      "end_time": 58.2,
      "transcript": "ਜਉ ਜਾਨੈ, ਹਉ ਭਗਤੁ ਗਿਆਨੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 58.2,
      "end_time": 62.505,
      "transcript": "ਆਗੈ ਠਾਕੁਰਿ, ਤਿਲੁ ਨਹੀ ਮਾਨੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 62.505,
      "end_time": 67.08,
      "transcript": "ਜਉ ਜਾਨੈ, ਮੈ ਕਥਨੀ ਕਰਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 67.08,
      "end_time": 71.52,
      "transcript": "ਬਿਆਪਾਰੀ, ਬਸੁਧਾ ਜਿਉ ਫਿਰਤਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 71.52,
      "end_time": 75.715,
      "transcript": "ਸਾਧਸੰਗਿ, ਜਿਹ ਹਉਮੈ ਮਾਰੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 75.715,
      "end_time": 80.705,
      "transcript": "ਨਾਨਕ ਤਾ ਕਉ, ਮਿਲੇ ਮੁਰਾਰੀ"
    }
  ]
}

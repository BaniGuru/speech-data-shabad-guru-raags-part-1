  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.175,
      "end_time": 6.687,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.04,
      "end_time": 20.225,
      "transcript": "ਟੂਟੇ ਬੰਧਨ ਜਾਸੁ ਕੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.225,
      "end_time": 26.844,
      "transcript": "ਹੋਆ ਸਾਧੂ ਸੰਗੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.844,
      "end_time": 33.375,
      "transcript": "ਜੋ ਰਾਤੇ ਰੰਗ ਏਕ ਕੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.545,
      "end_time": 43.485,
      "transcript": "ਨਾਨਕ ਗੂੜਾ ਰੰਗੁ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.375,
      "end_time": 57.87,
      "transcript": "ਰਾਰਾ ਰੰਗਹੁ, ਇਆ ਮਨੁ ਅਪਨਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.87,
      "end_time": 62.14,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਜਪਹੁ ਜਪੁ ਰਸਨਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.14,
      "end_time": 66.37,
      "transcript": "ਰੇ ਰੇ ਦਰਗਹ, ਕਹੈ ਨ ਕੋਊ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.37,
      "end_time": 70.685,
      "transcript": "ਆਉ ਬੈਠੁ, ਆਦਰੁ ਸੁਭ ਦੇਊ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.685,
      "end_time": 78.948,
      "transcript": "ਉਆ ਮਹਲੀ, ਪਾਵਹਿ ਤੂ ਬਾਸਾ ਜਨਮ ਮਰਨ, ਨਹ ਹੋਇ ਬਿਨਾਸਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 78.948,
      "end_time": 83.294,
      "transcript": "ਮਸਤਕਿ ਕਰਮੁ ਲਿਖਿਓ, ਧੁਰਿ ਜਾ ਕੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 83.294,
      "end_time": 87.865,
      "transcript": "ਹਰਿ ਸੰਪੈ, ਨਾਨਕ ਘਰਿ ਤਾ ਕੈ"
    }
  ]
}

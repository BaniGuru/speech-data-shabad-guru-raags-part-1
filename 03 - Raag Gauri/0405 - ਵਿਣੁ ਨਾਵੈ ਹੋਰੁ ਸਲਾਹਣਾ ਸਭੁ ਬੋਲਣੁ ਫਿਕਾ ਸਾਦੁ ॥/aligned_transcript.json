{
  "audio_file": "0224 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.275,
      "end_time": 4.955,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.525,
      "end_time": 20.955,
      "transcript": "ਵਿਣੁ ਨਾਵੈ ਹੋਰੁ ਸਲਾਹਣਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.4,
      "end_time": 28.425,
      "transcript": "ਸਭੁ ਬੋਲਣੁ ਫਿਕਾ ਸਾਦੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.04,
      "end_time": 36.638,
      "transcript": "ਮਨਮੁਖ ਅਹੰਕਾਰੁ ਸਲਾਹਦੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.638,
      "end_time": 44.211,
      "transcript": "ਹਉਮੈ ਮਮਤਾ ਵਾਦੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.211,
      "end_time": 51.88,
      "transcript": "ਜਿਨ ਸਾਲਾਹਨਿ ਸੇ ਮਰਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.88,
      "end_time": 59.527,
      "transcript": "ਖਪਿ ਜਾਵੈ ਸਭੁ ਅਪਵਾਦੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.527,
      "end_time": 66.905,
      "transcript": "ਜਨ ਨਾਨਕ ਗੁਰਮੁਖਿ ਉਬਰੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.905,
      "end_time": 74.8,
      "transcript": "ਜਪਿ ਹਰਿ ਹਰਿ ਪਰਮਾਨਾਦੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.8,
      "end_time": 79.219,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.24,
      "end_time": 93.395,
      "transcript": "ਸਤਿਗੁਰ ਹਰਿ ਪ੍ਰਭੁ ਦਸਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 93.765,
      "end_time": 100.955,
      "transcript": "ਨਾਮੁ ਧਿਆਈ ਮਨਿ ਹਰੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 101.285,
      "end_time": 108.743,
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਪਵਿਤੁ ਹਰਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 108.743,
      "end_time": 116.185,
      "transcript": "ਮੁਖਿ ਬੋਲੀ ਸਭਿ ਦੁਖ ਪਰਹਰੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 116.185,
      "end_time": 120.349,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 124.36,
      "end_time": 132.76,
      "transcript": "ਤੂ ਆਪੇ ਆਪਿ ਨਿਰੰਕਾਰੁ ਹੈ, ਨਿਰੰਜਨ ਹਰਿ ਰਾਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 132.76,
      "end_time": 141.2,
      "transcript": "ਜਿਨੀ ਤੂ ਇਕ ਮਨਿ ਸਚੁ ਧਿਆਇਆ, ਤਿਨ ਕਾ ਸਭੁ ਦੁਖੁ ਗਵਾਇਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 141.2,
      "end_time": 149.6,
      "transcript": "ਤੇਰਾ ਸਰੀਕੁ ਕੋ ਨਾਹੀ, ਜਿਸ ਨੋ ਲਵੈ ਲਾਇ ਸੁਣਾਇਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 149.6,
      "end_time": 157.96,
      "transcript": "ਤੁਧੁ ਜੇਵਡੁ ਦਾਤਾ ਤੂਹੈ ਨਿਰੰਜਨਾ, ਤੂਹੈ ਸਚੁ ਮੇਰੈ ਮਨਿ ਭਾਇਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 157.96,
      "end_time": 167.005,
      "transcript": "ਸਚੇ ਮੇਰੇ ਸਾਹਿਬਾ, ਸਚੇ ਸਚੁ ਨਾਇਆ"
    }
  ]
}

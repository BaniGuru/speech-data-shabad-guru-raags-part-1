{
  "audio_file": "0133 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.463,
      "end_time": 8.276,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.8,
      "end_time": 23.12,
      "transcript": "ਕਰਮ ਭੂਮਿ ਮਹਿ, ਬੋਅਹੁ ਨਾਮੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.12,
      "end_time": 30.92,
      "transcript": "ਪੂਰਨ ਹੋਇ, ਤੁਮਾਰਾ ਕਾਮੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.92,
      "end_time": 38.56,
      "transcript": "ਫਲ ਪਾਵਹਿ ਮਿਟੈ ਜਮ ਤ੍ਰਾਸ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.56,
      "end_time": 46.24,
      "transcript": "ਨਿਤ ਗਾਵਹਿ ਹਰਿ ਹਰਿ ਗੁਣ ਜਾਸ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.24,
      "end_time": 54.04,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਅੰਤਰਿ ਉਰਿ ਧਾਰਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.04,
      "end_time": 65.45,
      "transcript": "ਸੀਘਰ ਕਾਰਜੁ ਲੇਹੁ ਸਵਾਰਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.8,
      "end_time": 84.36,
      "transcript": "ਅਪਨੇ ਪ੍ਰਭ ਸਿਉ, ਹੋਹੁ ਸਾਵਧਾਨੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.36,
      "end_time": 92.08,
      "transcript": "ਤਾ ਤੂੰ ਦਰਗਹ ਪਾਵਹਿ ਮਾਨੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.08,
      "end_time": 99.8,
      "transcript": "ਉਕਤਿ ਸਿਆਣਪ, ਸਗਲੀ ਤਿਆਗੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 99.8,
      "end_time": 107.44,
      "transcript": "ਸੰਤ ਜਨਾ ਕੀ, ਚਰਣੀ ਲਾਗੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 107.44,
      "end_time": 115.36,
      "transcript": "ਸਰਬ ਜੀਅ ਹਹਿ, ਜਾ ਕੈ ਹਾਥਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 115.36,
      "end_time": 122.76,
      "transcript": "ਕਦੇ ਨ ਵਿਛੁੜੈ, ਸਭ ਕੈ ਸਾਥਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 122.76,
      "end_time": 130.56,
      "transcript": "ਉਪਾਵ ਛੋਡਿ, ਗਹੁ ਤਿਸ ਕੀ ਓਟ"
    },
    {
      "section_id": "section-00015",
      "start_time": 130.56,
      "end_time": 137.835,
      "transcript": "ਨਿਮਖ ਮਾਹਿ, ਹੋਵੈ ਤੇਰੀ ਛੋਟਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 137.835,
      "end_time": 145.64,
      "transcript": "ਸਦਾ ਨਿਕਟਿ ਕਰਿ, ਤਿਸ ਨੋ ਜਾਣੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 145.64,
      "end_time": 153.32,
      "transcript": "ਪ੍ਰਭ ਕੀ ਆਗਿਆ, ਸਤਿ ਕਰਿ ਮਾਨੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 153.32,
      "end_time": 161.0,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਮਿਟਾਵਹੁ ਆਪੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 161.0,
      "end_time": 168.38,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਨਾਨਕ ਜਪਿ ਜਾਪੁ"
    }
  ]
}

{
  "audio_file": "0212 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.485,
      "end_time": 8.206,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 26.61,
      "end_time": 34.7,
      "transcript": "ਰੂਪੁ ਨ ਰੇਖ ਨ ਰੰਗੁ ਕਿਛੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 34.7,
      "end_time": 41.975,
      "transcript": "ਤ੍ਰਿਹੁ ਗੁਣ ਤੇ ਪ੍ਰਭ ਭਿੰਨ"
    },
    {
      "section_id": "section-00004",
      "start_time": 42.6,
      "end_time": 49.985,
      "transcript": "ਤਿਸਹਿ ਬੁਝਾਏ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 50.44,
      "end_time": 61.155,
      "transcript": "ਜਿਸੁ ਹੋਵੈ ਸੁਪ੍ਰਸੰਨ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 70.905,
      "end_time": 79.295,
      "transcript": "ਅਬਿਨਾਸੀ ਪ੍ਰਭੁ, ਮਨ ਮਹਿ ਰਾਖੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 79.825,
      "end_time": 88.62,
      "transcript": "ਮਾਨੁਖ ਕੀ, ਤੂ ਪ੍ਰੀਤਿ ਤਿਆਗੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 88.62,
      "end_time": 96.745,
      "transcript": "ਤਿਸ ਤੇ ਪਰੈ, ਨਾਹੀ ਕਿਛੁ ਕੋਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 97.4,
      "end_time": 105.505,
      "transcript": "ਸਰਬ ਨਿਰੰਤਰਿ, ਏਕੋ ਸੋਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 105.995,
      "end_time": 114.645,
      "transcript": "ਆਪੇ ਬੀਨਾ, ਆਪੇ ਦਾਨਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 114.645,
      "end_time": 122.795,
      "transcript": "ਗਹਿਰ ਗੰਭੀਰੁ, ਗਹੀਰੁ ਸੁਜਾਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 123.44,
      "end_time": 132.06,
      "transcript": "ਪਾਰਬ੍ਰਹਮ, ਪਰਮੇਸੁਰ ਗੋਬਿੰਦ"
    },
    {
      "section_id": "section-00013",
      "start_time": 132.06,
      "end_time": 139.925,
      "transcript": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ, ਦਇਆਲ ਬਖਸੰਦ"
    },
    {
      "section_id": "section-00014",
      "start_time": 140.68,
      "end_time": 149.025,
      "transcript": "ਸਾਧ ਤੇਰੇ ਕੀ, ਚਰਨੀ ਪਾਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 149.025,
      "end_time": 157.625,
      "transcript": "ਨਾਨਕ ਕੈ ਮਨਿ, ਇਹੁ ਅਨਰਾਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 166.305,
      "end_time": 174.415,
      "transcript": "ਮਨਸਾ ਪੂਰਨ, ਸਰਨਾ ਜੋਗ"
    },
    {
      "section_id": "section-00017",
      "start_time": 174.865,
      "end_time": 183.3,
      "transcript": "ਜੋ ਕਰਿ ਪਾਇਆ, ਸੋਈ ਹੋਗੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 183.3,
      "end_time": 191.905,
      "transcript": "ਹਰਨ ਭਰਨ, ਜਾ ਕਾ ਨੇਤ੍ਰ ਫੋਰੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 191.905,
      "end_time": 200.535,
      "transcript": "ਤਿਸ ਕਾ ਮੰਤ੍ਰੁ, ਨ ਜਾਨੈ ਹੋਰੁ"
    },
    {
      "section_id": "section-00020",
      "start_time": 200.535,
      "end_time": 209.175,
      "transcript": "ਅਨਦ ਰੂਪ, ਮੰਗਲ ਸਦ ਜਾ ਕੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 209.175,
      "end_time": 217.335,
      "transcript": "ਸਰਬ ਥੋਕ, ਸੁਨੀਅਹਿ ਘਰਿ ਤਾ ਕੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 217.765,
      "end_time": 226.36,
      "transcript": "ਰਾਜ ਮਹਿ ਰਾਜੁ, ਜੋਗ ਮਹਿ ਜੋਗੀ"
    },
    {
      "section_id": "section-00023",
      "start_time": 226.36,
      "end_time": 234.625,
      "transcript": "ਤਪ ਮਹਿ ਤਪੀਸਰੁ, ਗ੍ਰਿਹਸਤ ਮਹਿ ਭੋਗੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 234.625,
      "end_time": 242.765,
      "transcript": "ਧਿਆਇ ਧਿਆਇ, ਭਗਤਹ ਸੁਖੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00025",
      "start_time": 243.305,
      "end_time": 251.525,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਪੁਰਖ ਕਾ, ਕਿਨੈ ਅੰਤੁ ਨ ਪਾਇਆ"
    },
    {
      "section_id": "section-00026",
      "start_time": 260.055,
      "end_time": 268.669,
      "transcript": "ਜਾ ਕੀ ਲੀਲਾ ਕੀ, ਮਿਤਿ ਨਾਹਿ"
    },
    {
      "section_id": "section-00027",
      "start_time": 268.669,
      "end_time": 276.865,
      "transcript": "ਸਗਲ ਦੇਵ, ਹਾਰੇ ਅਵਗਾਹਿ"
    },
    {
      "section_id": "section-00028",
      "start_time": 277.105,
      "end_time": 285.495,
      "transcript": "ਪਿਤਾ ਕਾ ਜਨਮੁ, ਕਿ ਜਾਨੈ ਪੂਤੁ"
    },
    {
      "section_id": "section-00029",
      "start_time": 285.495,
      "end_time": 294.08,
      "transcript": "ਸਗਲ ਪਰੋਈ, ਅਪੁਨੈ ਸੂਤਿ"
    },
    {
      "section_id": "section-00030",
      "start_time": 294.08,
      "end_time": 302.185,
      "transcript": "ਸੁਮਤਿ ਗਿਆਨੁ ਧਿਆਨੁ, ਜਿਨ ਦੇਇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 302.735,
      "end_time": 311.28,
      "transcript": "ਜਨ ਦਾਸ, ਨਾਮੁ ਧਿਆਵਹਿ ਸੇਇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 311.28,
      "end_time": 319.62,
      "transcript": "ਤਿਹੁ ਗੁਣ ਮਹਿ, ਜਾ ਕਉ ਭਰਮਾਏ"
    },
    {
      "section_id": "section-00033",
      "start_time": 319.62,
      "end_time": 327.795,
      "transcript": "ਜਨਮਿ ਮਰੈ, ਫਿਰਿ ਆਵੈ ਜਾਏ"
    },
    {
      "section_id": "section-00034",
      "start_time": 328.28,
      "end_time": 336.365,
      "transcript": "ਊਚ ਨੀਚ, ਤਿਸ ਕੇ ਅਸਥਾਨ"
    },
    {
      "section_id": "section-00035",
      "start_time": 336.745,
      "end_time": 345.225,
      "transcript": "ਜੈਸਾ ਜਨਾਵੈ, ਤੈਸਾ ਨਾਨਕ ਜਾਨ"
    },
    {
      "section_id": "section-00036",
      "start_time": 353.675,
      "end_time": 361.765,
      "transcript": "ਨਾਨਾ ਰੂਪ, ਨਾਨਾ ਜਾ ਕੇ ਰੰਗ"
    },
    {
      "section_id": "section-00037",
      "start_time": 362.265,
      "end_time": 370.345,
      "transcript": "ਨਾਨਾ ਭੇਖ ਕਰਹਿ, ਇਕ ਰੰਗ"
    },
    {
      "section_id": "section-00038",
      "start_time": 370.725,
      "end_time": 378.975,
      "transcript": "ਨਾਨਾ ਬਿਧਿ, ਕੀਨੋ ਬਿਸਥਾਰੁ"
    },
    {
      "section_id": "section-00039",
      "start_time": 378.975,
      "end_time": 387.505,
      "transcript": "ਪ੍ਰਭੁ ਅਬਿਨਾਸੀ, ਏਕੰਕਾਰੁ"
    },
    {
      "section_id": "section-00040",
      "start_time": 387.505,
      "end_time": 396.105,
      "transcript": "ਨਾਨਾ ਚਲਿਤ ਕਰੇ, ਖਿਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00041",
      "start_time": 396.105,
      "end_time": 404.245,
      "transcript": "ਪੂਰਿ ਰਹਿਓ, ਪੂਰਨੁ ਸਭ ਠਾਇ"
    },
    {
      "section_id": "section-00042",
      "start_time": 404.595,
      "end_time": 412.605,
      "transcript": "ਨਾਨਾ ਬਿਧਿ ਕਰਿ, ਬਨਤ ਬਨਾਈ"
    },
    {
      "section_id": "section-00043",
      "start_time": 413.125,
      "end_time": 421.395,
      "transcript": "ਅਪਨੀ ਕੀਮਤਿ, ਆਪੇ ਪਾਈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 421.395,
      "end_time": 429.855,
      "transcript": "ਸਭ ਘਟ ਤਿਸ ਕੇ, ਸਭ ਤਿਸ ਕੇ ਠਾਉ"
    },
    {
      "section_id": "section-00045",
      "start_time": 429.855,
      "end_time": 438.245,
      "transcript": "ਜਪਿ ਜਪਿ ਜੀਵੈ, ਨਾਨਕ ਹਰਿ ਨਾਉ"
    },
    {
      "section_id": "section-00046",
      "start_time": 446.675,
      "end_time": 454.795,
      "transcript": "ਨਾਮ ਕੇ ਧਾਰੇ, ਸਗਲੇ ਜੰਤ"
    },
    {
      "section_id": "section-00047",
      "start_time": 455.115,
      "end_time": 463.015,
      "transcript": "ਨਾਮ ਕੇ ਧਾਰੇ, ਖੰਡ ਬ੍ਰਹਮੰਡ"
    },
    {
      "section_id": "section-00048",
      "start_time": 463.495,
      "end_time": 471.445,
      "transcript": "ਨਾਮ ਕੇ ਧਾਰੇ, ਸਿਮ੍ਰਿਤਿ ਬੇਦ ਪੁਰਾਨ"
    },
    {
      "section_id": "section-00049",
      "start_time": 471.885,
      "end_time": 480.195,
      "transcript": "ਨਾਮ ਕੇ ਧਾਰੇ, ਸੁਨਨ ਗਿਆਨ ਧਿਆਨ"
    },
    {
      "section_id": "section-00050",
      "start_time": 480.195,
      "end_time": 488.285,
      "transcript": "ਨਾਮ ਕੇ ਧਾਰੇ, ਆਗਾਸ ਪਾਤਾਲ"
    },
    {
      "section_id": "section-00051",
      "start_time": 488.705,
      "end_time": 496.705,
      "transcript": "ਨਾਮ ਕੇ ਧਾਰੇ, ਸਗਲ ਆਕਾਰ"
    },
    {
      "section_id": "section-00052",
      "start_time": 497.135,
      "end_time": 505.145,
      "transcript": "ਨਾਮ ਕੇ ਧਾਰੇ, ਪੁਰੀਆ ਸਭ ਭਵਨ"
    },
    {
      "section_id": "section-00053",
      "start_time": 505.575,
      "end_time": 513.88,
      "transcript": "ਨਾਮ ਕੈ ਸੰਗਿ, ਉਧਰੇ ਸੁਨਿ ਸ੍ਰਵਨ"
    },
    {
      "section_id": "section-00054",
      "start_time": 513.88,
      "end_time": 522.25,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ, ਆਪਨੈ ਨਾਮਿ ਲਾਏ"
    },
    {
      "section_id": "section-00055",
      "start_time": 522.25,
      "end_time": 530.535,
      "transcript": "ਨਾਨਕ ਚਉਥੇ ਪਦ ਮਹਿ, ਸੋ ਜਨੁ ਗਤਿ ਪਾਏ"
    },
    {
      "section_id": "section-00056",
      "start_time": 539.025,
      "end_time": 547.365,
      "transcript": "ਰੂਪੁ ਸਤਿ, ਜਾ ਕਾ ਸਤਿ ਅਸਥਾਨੁ"
    },
    {
      "section_id": "section-00057",
      "start_time": 547.365,
      "end_time": 555.96,
      "transcript": "ਪੁਰਖੁ ਸਤਿ, ਕੇਵਲ ਪਰਧਾਨੁ"
    },
    {
      "section_id": "section-00058",
      "start_time": 555.96,
      "end_time": 563.785,
      "transcript": "ਕਰਤੂਤਿ ਸਤਿ, ਸਤਿ ਜਾ ਕੀ ਬਾਣੀ"
    },
    {
      "section_id": "section-00059",
      "start_time": 564.36,
      "end_time": 572.405,
      "transcript": "ਸਤਿ ਪੁਰਖ, ਸਭ ਮਾਹਿ ਸਮਾਣੀ"
    },
    {
      "section_id": "section-00060",
      "start_time": 572.405,
      "end_time": 580.86,
      "transcript": "ਸਤਿ ਕਰਮੁ, ਜਾ ਕੀ ਰਚਨਾ ਸਤਿ"
    },
    {
      "section_id": "section-00061",
      "start_time": 580.86,
      "end_time": 588.945,
      "transcript": "ਮੂਲੁ ਸਤਿ, ਸਤਿ ਉਤਪਤਿ"
    },
    {
      "section_id": "section-00062",
      "start_time": 589.44,
      "end_time": 597.315,
      "transcript": "ਸਤਿ ਕਰਣੀ, ਨਿਰਮਲ ਨਿਰਮਲੀ"
    },
    {
      "section_id": "section-00063",
      "start_time": 597.765,
      "end_time": 605.895,
      "transcript": "ਜਿਸਹਿ ਬੁਝਾਏ, ਤਿਸਹਿ ਸਭ ਭਲੀ"
    },
    {
      "section_id": "section-00064",
      "start_time": 606.32,
      "end_time": 614.0,
      "transcript": "ਸਤਿ ਨਾਮੁ ਪ੍ਰਭ ਕਾ ਸੁਖਦਾਈ"
    },
    {
      "section_id": "section-00065",
      "start_time": 614.0,
      "end_time": 622.755,
      "transcript": "ਬਿਸ੍ਵਾਸੁ ਸਤਿ, ਨਾਨਕ ਗੁਰ ਤੇ ਪਾਈ"
    },
    {
      "section_id": "section-00066",
      "start_time": 631.44,
      "end_time": 639.478,
      "transcript": "ਸਤਿ ਬਚਨ, ਸਾਧੂ ਉਪਦੇਸ"
    },
    {
      "section_id": "section-00067",
      "start_time": 639.478,
      "end_time": 647.895,
      "transcript": "ਸਤਿ ਤੇ ਜਨ, ਜਾ ਕੈ ਰਿਦੈ ਪ੍ਰਵੇਸ"
    },
    {
      "section_id": "section-00068",
      "start_time": 648.215,
      "end_time": 656.285,
      "transcript": "ਸਤਿ ਨਿਰਤਿ, ਬੂਝੈ ਜੇ ਕੋਇ"
    },
    {
      "section_id": "section-00069",
      "start_time": 656.505,
      "end_time": 664.395,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਤਾ ਕੀ ਗਤਿ ਹੋਇ"
    },
    {
      "section_id": "section-00070",
      "start_time": 664.955,
      "end_time": 673.092,
      "transcript": "ਆਪਿ ਸਤਿ, ਕੀਆ ਸਭੁ ਸਤਿ"
    },
    {
      "section_id": "section-00071",
      "start_time": 673.092,
      "end_time": 681.495,
      "transcript": "ਆਪੇ ਜਾਨੈ, ਅਪਨੀ ਮਿਤਿ ਗਤਿ"
    },
    {
      "section_id": "section-00072",
      "start_time": 681.495,
      "end_time": 690.24,
      "transcript": "ਜਿਸ ਕੀ ਸ੍ਰਿਸਟਿ, ਸੁ ਕਰਣੈਹਾਰੁ"
    },
    {
      "section_id": "section-00073",
      "start_time": 690.24,
      "end_time": 698.37,
      "transcript": "ਅਵਰ ਨ ਬੂਝਿ, ਕਰਤ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00074",
      "start_time": 698.37,
      "end_time": 706.785,
      "transcript": "ਕਰਤੇ ਕੀ ਮਿਤਿ, ਨ ਜਾਨੈ ਕੀਆ"
    },
    {
      "section_id": "section-00075",
      "start_time": 706.785,
      "end_time": 715.255,
      "transcript": "ਨਾਨਕ ਜੋ ਤਿਸੁ ਭਾਵੈ, ਸੋ ਵਰਤੀਆ"
    },
    {
      "section_id": "section-00076",
      "start_time": 723.8,
      "end_time": 731.405,
      "transcript": "ਬਿਸਮਨ ਬਿਸਮ, ਭਏ ਬਿਸਮਾਦ"
    },
    {
      "section_id": "section-00077",
      "start_time": 732.115,
      "end_time": 740.245,
      "transcript": "ਜਿਨਿ ਬੂਝਿਆ, ਤਿਸੁ ਆਇਆ ਸ੍ਵਾਦ"
    },
    {
      "section_id": "section-00078",
      "start_time": 740.64,
      "end_time": 748.595,
      "transcript": "ਪ੍ਰਭ ਕੈ ਰੰਗਿ, ਰਾਚਿ ਜਨ ਰਹੇ"
    },
    {
      "section_id": "section-00079",
      "start_time": 749.095,
      "end_time": 757.165,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਪਦਾਰਥ ਲਹੇ"
    },
    {
      "section_id": "section-00080",
      "start_time": 757.525,
      "end_time": 765.495,
      "transcript": "ਓਇ ਦਾਤੇ, ਦੁਖ ਕਾਟਨਹਾਰ"
    },
    {
      "section_id": "section-00081",
      "start_time": 765.905,
      "end_time": 773.855,
      "transcript": "ਜਾ ਕੈ ਸੰਗਿ, ਤਰੈ ਸੰਸਾਰ"
    },
    {
      "section_id": "section-00082",
      "start_time": 774.295,
      "end_time": 782.735,
      "transcript": "ਜਨ ਕਾ ਸੇਵਕੁ, ਸੋ ਵਡਭਾਗੀ"
    },
    {
      "section_id": "section-00083",
      "start_time": 782.735,
      "end_time": 791.08,
      "transcript": "ਜਨ ਕੈ ਸੰਗਿ, ਏਕ ਲਿਵ ਲਾਗੀ"
    },
    {
      "section_id": "section-00084",
      "start_time": 791.08,
      "end_time": 799.296,
      "transcript": "ਗੁਨ ਗੋਬਿਦ, ਕੀਰਤਨੁ ਜਨੁ ਗਾਵੈ"
    },
    {

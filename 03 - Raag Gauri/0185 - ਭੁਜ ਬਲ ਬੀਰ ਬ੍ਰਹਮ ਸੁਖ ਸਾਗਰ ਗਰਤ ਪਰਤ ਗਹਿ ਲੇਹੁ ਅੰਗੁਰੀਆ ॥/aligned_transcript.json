    {
      "section_id": "section-00003",
      "start_time": 30.8,
      "end_time": 36.765,
      "transcript": "ਸ੍ਰਵਨਿ ਨ ਸੁਰਤਿ ਨੈਨ ਸੁੰਦਰ ਨਹੀ"

{
  "audio_file": "0243 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.355,
      "end_time": 15.614,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 31.633,
      "end_time": 38.4,
      "transcript": "ਦੇਇ ਮੁਹਾਰ, ਲਗਾਮੁ ਪਹਿਰਾਵਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 38.4,
      "end_time": 44.805,
      "transcript": "ਸਗਲ ਤ ਜੀਨੁ, ਗਗਨ ਦਉਰਾਵਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.805,
      "end_time": 51.36,
      "transcript": "ਅਪਨੈ ਬੀਚਾਰਿ, ਅਸਵਾਰੀ ਕੀਜੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 51.36,
      "end_time": 61.185,
      "transcript": "ਸਹਜ ਕੈ ਪਾਵੜੈ, ਪਗੁ ਧਰਿ ਲੀਜੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.76,
      "end_time": 74.36,
      "transcript": "ਚਲੁ ਰੇ ਬੈਕੁੰਠ, ਤੁਝਹਿ ਲੇ ਤਾਰਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 74.36,
      "end_time": 80.88,
      "transcript": "ਹਿਚਹਿ ਤ, ਪ੍ਰੇਮ ਕੈ ਚਾਬੁਕ ਮਾਰਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 80.88,
      "end_time": 87.375,
      "transcript": "ਕਹਤ ਕਬੀਰ, ਭਲੇ ਅਸਵਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 87.375,
      "end_time": 93.445,
      "transcript": "ਬੇਦ ਕਤੇਬ ਤੇ, ਰਹਹਿ ਨਿਰਾਰਾ"
    }
  ]
}

{
  "audio_file": "0150 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.125,
      "end_time": 7.235,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.32,
      "end_time": 21.52,
      "transcript": "ਨਿਤਪ੍ਰਤਿ ਨਾਵਣੁ, ਰਾਮ ਸਰਿ ਕੀਜੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.52,
      "end_time": 28.675,
      "transcript": "ਝੋਲਿ ਮਹਾ ਰਸੁ, ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਪੀਜੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 39.117,
      "end_time": 46.195,
      "transcript": "ਨਿਰਮਲ ਉਦਕੁ, ਗੋਵਿੰਦ ਕਾ ਨਾਮ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.52,
      "end_time": 53.501,
      "transcript": "ਮਜਨੁ ਕਰਤ, ਪੂਰਨ ਸਭਿ ਕਾਮ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.501,
      "end_time": 60.96,
      "transcript": "ਸੰਤਸੰਗਿ, ਤਹ ਗੋਸਟਿ ਹੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.96,
      "end_time": 68.0,
      "transcript": "ਕੋਟਿ ਜਨਮ ਕੇ, ਕਿਲਵਿਖ ਖੋਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.0,
      "end_time": 75.12,
      "transcript": "ਸਿਮਰਹਿ ਸਾਧ, ਕਰਹਿ ਆਨੰਦੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.12,
      "end_time": 82.2,
      "transcript": "ਮਨਿ ਤਨਿ ਰਵਿਆ, ਪਰਮਾਨੰਦੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.2,
      "end_time": 89.145,
      "transcript": "ਜਿਸਹਿ ਪਰਾਪਤਿ, ਹਰਿ ਚਰਣ ਨਿਧਾਨ"
    },
    {
      "section_id": "section-00011",
      "start_time": 89.485,
      "end_time": 96.165,
      "transcript": "ਨਾਨਕ ਦਾਸ, ਤਿਸਹਿ ਕੁਰਬਾਨ"
    }
  ]
}

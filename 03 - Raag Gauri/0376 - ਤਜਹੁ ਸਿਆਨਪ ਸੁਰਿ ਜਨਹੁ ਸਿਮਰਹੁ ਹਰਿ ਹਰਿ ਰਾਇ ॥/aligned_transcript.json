{
  "audio_file": "0210 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.155,
      "end_time": 7.47,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.47,
      "end_time": 14.975,
      "transcript": "ਤਜਹੁ ਸਿਆਨਪ ਸੁਰਿ ਜਨਹੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 15.68,
      "end_time": 25.376,
      "transcript": "ਸਿਮਰਹੁ ਹਰਿ ਹਰਿ ਰਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.376,
      "end_time": 37.468,
      "transcript": "ਏਕ ਆਸ ਹਰਿ ਮਨਿ ਰਖਹੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.468,
      "end_time": 53.515,
      "transcript": "ਨਾਨਕ ਦੂਖੁ ਭਰਮੁ ਭਉ ਜਾਇ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 72.225,
      "end_time": 80.225,
      "transcript": "ਮਾਨੁਖ ਕੀ ਟੇਕ, ਬ੍ਰਿਥੀ ਸਭ ਜਾਨੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 80.615,
      "end_time": 88.575,
      "transcript": "ਦੇਵਨ ਕਉ, ਏਕੈ ਭਗਵਾਨੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 88.96,
      "end_time": 96.775,
      "transcript": "ਜਿਸ ਕੈ ਦੀਐ, ਰਹੈ ਅਘਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 97.24,
      "end_time": 105.795,
      "transcript": "ਬਹੁਰਿ, ਨ ਤ੍ਰਿਸਨਾ ਲਾਗੈ ਆਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 113.605,
      "end_time": 121.655,
      "transcript": "ਮਾਰੈ, ਰਾਖੈ ਏਕੋ ਆਪਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 121.945,
      "end_time": 129.995,
      "transcript": "ਮਾਨੁਖ ਕੈ, ਕਿਛੁ ਨਾਹੀ ਹਾਥਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 130.24,
      "end_time": 138.255,
      "transcript": "ਤਿਸ ਕਾ ਹੁਕਮੁ ਬੂਝਿ, ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 138.56,
      "end_time": 146.595,
      "transcript": "ਤਿਸ ਕਾ ਨਾਮੁ, ਰਖੁ ਕੰਠਿ ਪਰੋਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 147.0,
      "end_time": 154.815,
      "transcript": "ਸਿਮਰਿ ਸਿਮਰਿ, ਸਿਮਰਿ ਪ੍ਰਭੁ ਸੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 155.275,
      "end_time": 163.315,
      "transcript": "ਨਾਨਕ, ਬਿਘਨੁ ਨ ਲਾਗੈ ਕੋਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 171.825,
      "end_time": 179.745,
      "transcript": "ਉਸਤਤਿ ਮਨ ਮਹਿ, ਕਰਿ ਨਿਰੰਕਾਰ"
    },
    {
      "section_id": "section-00017",
      "start_time": 180.2,
      "end_time": 188.195,
      "transcript": "ਕਰਿ ਮਨ ਮੇਰੇ, ਸਤਿ ਬਿਉਹਾਰ"
    },
    {
      "section_id": "section-00018",
      "start_time": 188.52,
      "end_time": 196.425,
      "transcript": "ਨਿਰਮਲ ਰਸਨਾ, ਅੰਮ੍ਰਿਤੁ ਪੀਉ"
    },
    {
      "section_id": "section-00019",
      "start_time": 196.92,
      "end_time": 205.255,
      "transcript": "ਸਦਾ ਸੁਹੇਲਾ, ਕਰਿ ਲੇਹਿ ਜੀਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 213.228,
      "end_time": 221.475,
      "transcript": "ਨੈਨਹੁ ਪੇਖੁ, ਠਾਕੁਰ ਕਾ ਰੰਗੁ"
    },
    {
      "section_id": "section-00021",
      "start_time": 221.84,
      "end_time": 229.745,
      "transcript": "ਸਾਧਸੰਗਿ, ਬਿਨਸੈ ਸਭ ਸੰਗੁ"
    },
    {
      "section_id": "section-00022",
      "start_time": 230.2,
      "end_time": 238.215,
      "transcript": "ਚਰਨ ਚਲਉ, ਮਾਰਗਿ ਗੋਬਿੰਦ"
    },
    {
      "section_id": "section-00023",
      "start_time": 238.52,
      "end_time": 246.305,
      "transcript": "ਮਿਟਹਿ ਪਾਪ, ਜਪੀਐ ਹਰਿ ਬਿੰਦ"
    },
    {
      "section_id": "section-00024",
      "start_time": 246.76,
      "end_time": 254.545,
      "transcript": "ਕਰ ਹਰਿ ਕਰਮ, ਸ੍ਰਵਨਿ ਹਰਿ ਕਥਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 255.04,
      "end_time": 263.365,
      "transcript": "ਹਰਿ ਦਰਗਹ ਨਾਨਕ, ਊਜਲ ਮਥਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 271.495,
      "end_time": 279.055,
      "transcript": "ਬਡਭਾਗੀ ਤੇ ਜਨ, ਜਗ ਮਾਹਿ"
    },
    {
      "section_id": "section-00027",
      "start_time": 279.68,
      "end_time": 287.555,
      "transcript": "ਸਦਾ ਸਦਾ, ਹਰਿ ਕੇ ਗੁਨ ਗਾਹਿ"
    },
    {
      "section_id": "section-00028",
      "start_time": 287.775,
      "end_time": 295.495,
      "transcript": "ਰਾਮ ਨਾਮ, ਜੋ ਕਰਹਿ ਬੀਚਾਰ"
    },
    {
      "section_id": "section-00029",
      "start_time": 296.04,
      "end_time": 304.145,
      "transcript": "ਸੇ ਧਨਵੰਤ ਗਨੀ, ਸੰਸਾਰ"
    },
    {
      "section_id": "section-00030",
      "start_time": 312.325,
      "end_time": 320.275,
      "transcript": "ਮਨਿ ਤਨਿ ਮੁਖਿ, ਬੋਲਹਿ ਹਰਿ ਮੁਖੀ"
    },
    {
      "section_id": "section-00031",
      "start_time": 320.68,
      "end_time": 328.595,
      "transcript": "ਸਦਾ ਸਦਾ, ਜਾਨਹੁ ਤੇ ਸੁਖੀ"
    },
    {
      "section_id": "section-00032",
      "start_time": 328.88,
      "end_time": 336.765,
      "transcript": "ਏਕੋ ਏਕੁ, ਏਕੁ ਪਛਾਨੈ"
    },
    {
      "section_id": "section-00033",
      "start_time": 337.12,
      "end_time": 344.905,
      "transcript": "ਇਤ ਉਤ ਕੀ, ਓਹੁ ਸੋਝੀ ਜਾਨੈ"
    },
    {
      "section_id": "section-00034",
      "start_time": 345.36,
      "end_time": 353.155,
      "transcript": "ਨਾਮ ਸੰਗਿ, ਜਿਸ ਕਾ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00035",
      "start_time": 353.565,
      "end_time": 362.715,
      "transcript": "ਨਾਨਕ, ਤਿਨਹਿ ਨਿਰੰਜਨੁ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00036",
      "start_time": 373.765,
      "end_time": 381.625,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਆਪਨ ਆਪੁ ਸੁਝੈ"
    },
    {
      "section_id": "section-00037",
      "start_time": 382.0,
      "end_time": 390.142,
      "transcript": "ਤਿਸ ਕੀ ਜਾਨਹੁ, ਤ੍ਰਿਸਨਾ ਬੁਝੈ"
    },
    {
      "section_id": "section-00038",
      "start_time": 390.142,
      "end_time": 397.955,
      "transcript": "ਸਾਧਸੰਗਿ, ਹਰਿ ਹਰਿ ਜਸੁ ਕਹਤ"
    },
    {
      "section_id": "section-00039",
      "start_time": 398.44,
      "end_time": 406.255,
      "transcript": "ਸਰਬ ਰੋਗ ਤੇ, ਓਹੁ ਹਰਿ ਜਨੁ ਰਹਤ"
    },
    {
      "section_id": "section-00040",
      "start_time": 414.84,
      "end_time": 422.78,
      "transcript": "ਅਨਦਿਨੁ ਕੀਰਤਨੁ, ਕੇਵਲ ਬਖੵਾਨੁ"
    },
    {
      "section_id": "section-00041",
      "start_time": 422.78,
      "end_time": 430.875,
      "transcript": "ਗ੍ਰਿਹਸਤ ਮਹਿ, ਸੋਈ ਨਿਰਬਾਨੁ"
    },
    {
      "section_id": "section-00042",
      "start_time": 431.2,
      "end_time": 439.36,
      "transcript": "ਏਕ ਊਪਰਿ, ਜਿਸੁ ਜਨ ਕੀ ਆਸਾ"
    },
    {
      "section_id": "section-00043",
      "start_time": 439.36,
      "end_time": 447.475,
      "transcript": "ਤਿਸ ਕੀ ਕਟੀਐ, ਜਮ ਕੀ ਫਾਸਾ"
    },
    {
      "section_id": "section-00044",
      "start_time": 447.475,
      "end_time": 455.424,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਕੀ, ਜਿਸੁ ਮਨਿ ਭੂਖ"
    },
    {
      "section_id": "section-00045",
      "start_time": 455.424,
      "end_time": 463.725,
      "transcript": "ਨਾਨਕ ਤਿਸਹਿ, ਨ ਲਾਗਹਿ ਦੂਖ"
    },
    {
      "section_id": "section-00046",
      "start_time": 471.965,
      "end_time": 479.995,
      "transcript": "ਜਿਸ ਕਉ ਹਰਿ ਪ੍ਰਭੁ, ਮਨਿ ਚਿਤਿ ਆਵੈ"
    },
    {
      "section_id": "section-00047",
      "start_time": 479.995,
      "end_time": 488.36,
      "transcript": "ਸੋ ਸੰਤੁ ਸੁਹੇਲਾ, ਨਹੀ ਡੁਲਾਵੈ"
    },
    {
      "section_id": "section-00048",
      "start_time": 488.36,
      "end_time": 496.155,
      "transcript": "ਜਿਸੁ ਪ੍ਰਭੁ ਅਪੁਨਾ, ਕਿਰਪਾ ਕਰੈ"
    },
    {
      "section_id": "section-00049",
      "start_time": 496.6,
      "end_time": 504.685,
      "transcript": "ਸੋ ਸੇਵਕੁ, ਕਹੁ ਕਿਸ ਤੇ ਡਰੈ"
    },
    {
      "section_id": "section-00050",
      "start_time": 512.563,
      "end_time": 520.808,
      "transcript": "ਜੈਸਾ ਸਾ, ਤੈਸਾ ਦ੍ਰਿਸਟਾਇਆ"
    },
    {
      "section_id": "section-00051",
      "start_time": 520.808,
      "end_time": 528.975,
      "transcript": "ਅਪੁਨੇ ਕਾਰਜ ਮਹਿ, ਆਪਿ ਸਮਾਇਆ"
    },
    {
      "section_id": "section-00052",
      "start_time": 529.24,
      "end_time": 537.255,
      "transcript": "ਸੋਧਤ ਸੋਧਤ, ਸੋਧਤ ਸੀਝਿਆ"
    },
    {
      "section_id": "section-00053",
      "start_time": 537.255,
      "end_time": 545.395,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਤਤੁ ਸਭੁ ਬੂਝਿਆ"
    },
    {
      "section_id": "section-00054",
      "start_time": 545.395,
      "end_time": 553.265,
      "transcript": "ਜਬ ਦੇਖਉ, ਤਬ ਸਭੁ ਕਿਛੁ ਮੂਲੁ"
    },
    {
      "section_id": "section-00055",
      "start_time": 553.675,
      "end_time": 561.755,
      "transcript": "ਨਾਨਕ ਸੋ ਸੂਖਮੁ, ਸੋਈ ਅਸਥੂਲੁ"
    },
    {
      "section_id": "section-00056",
      "start_time": 569.855,
      "end_time": 577.595,
      "transcript": "ਨਹ ਕਿਛੁ ਜਨਮੈ, ਨਹ ਕਿਛੁ ਮਰੈ"
    },
    {
      "section_id": "section-00057",
      "start_time": 578.015,
      "end_time": 585.885,
      "transcript": "ਆਪਨ ਚਲਿਤੁ, ਆਪ ਹੀ ਕਰੈ"
    },
    {
      "section_id": "section-00058",
      "start_time": 586.205,
      "end_time": 593.915,
      "transcript": "ਆਵਨੁ ਜਾਵਨੁ, ਦ੍ਰਿਸਟਿ ਅਨਦ੍ਰਿਸਟਿ"
    },
    {
      "section_id": "section-00059",
      "start_time": 594.325,
      "end_time": 602.305,
      "transcript": "ਆਗਿਆਕਾਰੀ, ਧਾਰੀ ਸਭ ਸ੍ਰਿਸਟਿ"
    },
    {
      "section_id": "section-00060",
      "start_time": 610.485,
      "end_time": 618.68,
      "transcript": "ਆਪੇ ਆਪਿ, ਸਗਲ ਮਹਿ ਆਪਿ"
    },
    {
      "section_id": "section-00061",
      "start_time": 618.68,
      "end_time": 626.435,
      "transcript": "ਅਨਿਕ ਜੁਗਤਿ ਰਚਿ, ਥਾਪਿ ਉਥਾਪਿ"
    },
    {
      "section_id": "section-00062",
      "start_time": 626.76,
      "end_time": 634.789,
      "transcript": "ਅਬਿਨਾਸੀ, ਨਾਹੀ ਕਿਛੁ ਖੰਡ"
    },
    {
      "section_id": "section-00063",
      "start_time": 634.789,
      "end_time": 642.64,
      "transcript": "ਧਾਰਣ ਧਾਰਿ ਰਹਿਓ, ਬ੍ਰਹਮੰਡ"
    },
    {
      "section_id": "section-00064",
      "start_time": 642.64,
      "end_time": 650.645,
      "transcript": "ਅਲਖ ਅਭੇਵ, ਪੁਰਖ ਪਰਤਾਪ"
    },
    {
      "section_id": "section-00065",
      "start_time": 651.035,
      "end_time": 659.502,
      "transcript": "ਆਪਿ ਜਪਾਏ, ਤ ਨਾਨਕ ਜਾਪ"
    },
    {
      "section_id": "section-00066",
      "start_time": 670.983,
      "end_time": 678.825,
      "transcript": "ਜਿਨ ਪ੍ਰਭੁ ਜਾਤਾ, ਸੁ ਸੋਭਾਵੰਤ"
    },
    {
      "section_id": "section-00067",
      "start_time": 679.32,
      "end_time": 687.165,
      "transcript": "ਸਗਲ ਸੰਸਾਰੁ, ਉਧਰੈ ਤਿਨ ਮੰਤ"
    },
    {
      "section_id": "section-00068",
      "start_time": 687.4,
      "end_time": 695.545,
      "transcript": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ, ਸਗਲ ਉਧਾਰਨ"
    },
    {
      "section_id": "section-00069",
      "start_time": 695.545,
      "end_time": 703.935,
      "transcript": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ, ਦੂਖ ਬਿਸਾਰਨ"
    },
    {
      "section_id": "section-00070",
      "start_time": 711.795,
      "end_time": 719.795,
      "transcript": "ਆਪੇ ਮੇਲਿ ਲਏ, ਕਿਰਪਾਲ"
    },
    {
      "section_id": "section-00071",
      "start_time": 719.925,
      "end_time": 727.685,
      "transcript": "ਗੁਰ ਕਾ ਸਬਦੁ ਜਪਿ, ਭਏ ਨਿਹਾਲ"
    },
    {
      "section_id": "section-00072",
      "start_time": 728.04,
      "end_time": 736.035,
      "transcript": "ਉਨ ਕੀ ਸੇਵਾ, ਸੋਈ ਲਾਗੈ"
    },
    {
      "section_id": "section-00073",
      "start_time": 736.035,
      "end_time": 743.935,
      "transcript": "ਜਿਸ ਨੋ ਕ੍ਰਿਪਾ ਕਰਹਿ, ਬਡਭਾਗੈ"
    },
    {
      "section_id": "section-00074",
      "start_time": 744.265,
      "end_time": 751.895,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਪਾਵਹਿ ਬਿਸ੍ਰਾਮੁ"
    },
    {
      "section_id": "section-00075",
      "start_time": 752.405,
      "end_time": 760.964,
      "transcript": "ਨਾਨਕ ਤਿਨ ਪੁਰਖ ਕਉ, ਊਤਮ ਕਰਿ ਮਾਨੁ"
    },
    {
      "section_id": "section-00076",
      "start_time": 768.336,
      "end_time": 776.195,
      "transcript": "ਜੋ ਕਿਛੁ ਕਰੈ, ਸੁ ਪ੍ਰਭ ਕੈ ਰੰਗਿ"
    },
    {
      "section_id": "section-00077",
      "start_time": 776.68,
      "end_time": 784.475,
      "transcript": "ਸਦਾ ਸਦਾ, ਬਸੈ ਹਰਿ ਸੰਗਿ"
    },
    {
      "section_id": "section-00078",
      "start_time": 784.84,
      "end_time": 792.475,
      "transcript": "ਸਹਜ ਸੁਭਾਇ ਹੋਵੈ, ਸੋ ਹੋਇ"
    },
    {
      "section_id": "section-00079",
      "start_time": 792.88,
      "end_time": 801.325,
      "transcript": "ਕਰਣੈਹਾਰੁ, ਪਛਾਣੈ ਸੋਇ"
    },
    {
      "section_id": "section-00080",
      "start_time": 808.911,
      "end_time": 816.895,
      "transcript": "ਪ੍ਰਭ ਕਾ ਕੀਆ, ਜਨ ਮੀਠ ਲਗਾਨਾ"
    },
    {
      "section_id": "section-00081",
      "start_time": 817.095,
      "end_time": 825.32,
      "transcript": "ਜੈਸਾ ਸਾ, ਤੈਸਾ ਦ੍ਰਿਸਟਾਨਾ"
    },
    {
      "section_id": "section-00082",
      "start_time": 825.32,
      "end_time": 833.055,
      "transcript": "ਜਿਸ ਤੇ ਉਪਜੇ, ਤਿਸੁ ਮਾਹਿ ਸਮਾਏ"
    },
    {
      "section_id": "section-00083",
      "start_time": 833.44,
      "end_time": 841.185,
      "transcript": "ਓਇ ਸੁਖ ਨਿਧਾਨ, ਉਨਹੂ ਬਨਿ ਆਏ"
    },
    {
      "section_id": "section-00084",
      "start_time": 841.585,
      "end_time": 849.458,
      "transcript": "ਆਪਸ ਕਉ, ਆਪਿ ਦੀਨੋ ਮਾਨੁ"
    },
    {

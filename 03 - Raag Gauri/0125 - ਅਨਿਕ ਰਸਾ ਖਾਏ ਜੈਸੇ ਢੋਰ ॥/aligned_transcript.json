{
  "audio_file": "0144 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.12,
      "end_time": 6.555,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.08,
      "end_time": 19.145,
      "transcript": "ਅਨਿਕ ਰਸਾ ਖਾਏ, ਜੈਸੇ ਢੋਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.52,
      "end_time": 25.605,
      "transcript": "ਮੋਹ ਕੀ ਜੇਵਰੀ, ਬਾਧਿਓ ਚੋਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.96,
      "end_time": 32.34,
      "transcript": "ਮਿਰਤਕ ਦੇਹ, ਸਾਧਸੰਗ ਬਿਹੂਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.34,
      "end_time": 40.395,
      "transcript": "ਆਵਤ ਜਾਤ, ਜੋਨੀ ਦੁਖ ਖੀਨਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.52,
      "end_time": 55.0,
      "transcript": "ਅਨਿਕ ਬਸਤ੍ਰ, ਸੁੰਦਰ ਪਹਿਰਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.0,
      "end_time": 61.431,
      "transcript": "ਜਿਉ ਡਰਨਾ, ਖੇਤ ਮਾਹਿ ਡਰਾਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.431,
      "end_time": 67.525,
      "transcript": "ਸਗਲ ਸਰੀਰ, ਆਵਤ ਸਭ ਕਾਮ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.88,
      "end_time": 74.385,
      "transcript": "ਨਿਹਫਲ ਮਾਨੁਖੁ, ਜਪੈ ਨਹੀ ਨਾਮ"
    },
    {
      "section_id": "section-00010",
      "start_time": 80.8,
      "end_time": 87.029,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਾ ਕਉ ਭਏ ਦਇਆਲਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.029,
      "end_time": 93.595,
      "transcript": "ਸਾਧਸੰਗਿ ਮਿਲਿ, ਭਜਹਿ ਗੁੋਪਾਲਾ"
    }
  ]
}

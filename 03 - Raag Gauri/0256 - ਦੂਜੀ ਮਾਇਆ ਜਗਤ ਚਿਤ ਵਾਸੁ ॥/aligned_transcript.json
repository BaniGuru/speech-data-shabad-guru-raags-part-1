{
  "audio_file": "0169 APb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.965,
      "end_time": 11.825,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 31.04,
      "end_time": 38.4,
      "transcript": "ਦੂਜੀ ਮਾਇਆ, ਜਗਤ ਚਿਤ ਵਾਸੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 38.4,
      "end_time": 45.72,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ, ਅਹੰਕਾਰ ਬਿਨਾਸੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.72,
      "end_time": 52.89,
      "transcript": "ਦੂਜਾ ਕਉਣੁ ਕਹਾ, ਨਹੀ ਕੋਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.89,
      "end_time": 64.156,
      "transcript": "ਸਭ ਮਹਿ, ਏਕੁ ਨਿਰੰਜਨੁ ਸੋਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 74.885,
      "end_time": 81.975,
      "transcript": "ਦੂਜੀ ਦੁਰਮਤਿ, ਆਖੈ ਦੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 82.325,
      "end_time": 89.625,
      "transcript": "ਆਵੈ ਜਾਇ, ਮਰਿ ਦੂਜਾ ਹੋਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 89.625,
      "end_time": 97.075,
      "transcript": "ਧਰਣਿ ਗਗਨ, ਨਹ ਦੇਖਉ ਦੋਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 97.075,
      "end_time": 104.64,
      "transcript": "ਨਾਰੀ ਪੁਰਖ, ਸਬਾਈ ਲੋਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 104.64,
      "end_time": 111.715,
      "transcript": "ਰਵਿ ਸਸਿ ਦੇਖਉ, ਦੀਪਕ ਉਜਿਆਲਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 111.955,
      "end_time": 119.48,
      "transcript": "ਸਰਬ ਨਿਰੰਤਰਿ, ਪ੍ਰੀਤਮੁ ਬਾਲਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 119.48,
      "end_time": 126.275,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਮੇਰਾ ਚਿਤੁ ਲਾਇਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 126.275,
      "end_time": 134.08,
      "transcript": "ਸਤਿਗੁਰਿ, ਮੋ ਕਉ ਏਕੁ ਬੁਝਾਇਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 134.08,
      "end_time": 141.075,
      "transcript": "ਏਕੁ ਨਿਰੰਜਨੁ, ਗੁਰਮੁਖਿ ਜਾਤਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 141.405,
      "end_time": 148.615,
      "transcript": "ਦੂਜਾ ਮਾਰਿ, ਸਬਦਿ ਪਛਾਤਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 148.84,
      "end_time": 156.04,
      "transcript": "ਏਕੋ ਹੁਕਮੁ ਵਰਤੈ, ਸਭ ਲੋਈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 156.04,
      "end_time": 162.925,
      "transcript": "ਏਕਸੁ ਤੇ, ਸਭ ਓਪਤਿ ਹੋਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 162.925,
      "end_time": 170.475,
      "transcript": "ਰਾਹ ਦੋਵੈ, ਖਸਮੁ ਏਕੋ ਜਾਣੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 170.475,
      "end_time": 177.845,
      "transcript": "ਗੁਰ ਕੈ ਸਬਦਿ, ਹੁਕਮੁ ਪਛਾਣੁ"
    },
    {
      "section_id": "section-00020",
      "start_time": 177.845,
      "end_time": 185.165,
      "transcript": "ਸਗਲ ਰੂਪ ਵਰਨ, ਮਨ ਮਾਹੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 185.165,
      "end_time": 191.48,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਏਕੋ ਸਾਲਾਹੀ"
    }
  ]
}

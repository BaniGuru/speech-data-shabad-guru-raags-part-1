    {
      "section_id": "section-00023",
      "start_time": 166.08,
      "end_time": 172.39,
      "transcript": "ਘਰੁ ਜਾਇ ਪਾਵਹਿ ਰੰਗ ਮਹਲੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 172.39,
      "end_time": 178.365,
      "transcript": "ਗੁਰੁ ਮੇਲੇ ਹਰਿ ਮੇਲਾਇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 178.88,
      "end_time": 184.865,
      "transcript": "ਮਨ ਕਰਹਲਾ ਤੂੰ ਮੀਤੁ ਮੇਰਾ"

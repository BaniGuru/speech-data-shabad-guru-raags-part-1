    {
      "section_id": "section-00007",
      "start_time": 54.565,
      "end_time": 60.545,
      "transcript": "ਗਲਿ ਮਿਲਿਆ ਪਿਆਰਾ ਆਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.04,
      "end_time": 68.955,
      "transcript": "ਮਨ ਕਰਹਲਾ, ਸਤਿਗੁਰੁ ਪੁਰਖੁ ਧਿਆਇ ਰਹਾਉ"

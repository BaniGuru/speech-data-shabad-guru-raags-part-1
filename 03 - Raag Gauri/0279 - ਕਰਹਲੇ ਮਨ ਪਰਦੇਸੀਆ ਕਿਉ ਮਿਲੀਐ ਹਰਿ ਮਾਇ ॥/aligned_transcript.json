      "section_id": "section-00043",
      "start_time": 293.326,
      "end_time": 299.525,
      "transcript": "ਗੁਰ ਆਗੈ ਕਰਿ ਜੋਦੜੀ"
    },
    {
      "section_id": "section-00044",
      "start_time": 300.0,
      "end_time": 305.525,
      "transcript": "ਜਨ ਨਾਨਕ ਹਰਿ ਮੇਲਾਇ"

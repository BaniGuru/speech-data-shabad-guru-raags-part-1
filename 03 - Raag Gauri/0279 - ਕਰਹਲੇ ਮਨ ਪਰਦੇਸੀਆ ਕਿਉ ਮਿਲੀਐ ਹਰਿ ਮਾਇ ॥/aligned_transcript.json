    {
      "section_id": "section-00013",
      "start_time": 102.335,
      "end_time": 108.045,
      "transcript": "ਮਨ ਕਰਹਲਾ ਅਤਿ ਨਿਰਮਲਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 108.56,
      "end_time": 114.742,
      "transcript": "ਮਲੁ ਲਾਗੀ ਹਉਮੈ ਆਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 114.742,
      "end_time": 120.845,
      "transcript": "ਪਰਤਖਿ ਪਿਰੁ ਘਰਿ ਨਾਲਿ ਪਿਆਰਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 121.36,
      "end_time": 127.255,
      "transcript": "ਵਿਛੁੜਿ ਚੋਟਾ ਖਾਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 127.76,
      "end_time": 133.595,
      "transcript": "ਮਨ ਕਰਹਲਾ ਮੇਰੇ ਪ੍ਰੀਤਮਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 134.08,
      "end_time": 139.795,
      "transcript": "ਹਰਿ ਰਿਦੈ ਭਾਲਿ ਭਾਲਾਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 140.24,
      "end_time": 146.395,
      "transcript": "ਉਪਾਇ ਕਿਤੈ ਨ ਲਭਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 146.845,
      "end_time": 152.895,
      "transcript": "ਗੁਰੁ ਹਿਰਦੈ ਹਰਿ ਦੇਖਾਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 153.36,
      "end_time": 159.255,
      "transcript": "ਮਨ ਕਰਹਲਾ ਮੇਰੇ ਪ੍ਰੀਤਮਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 159.8,
      "end_time": 165.575,
      "transcript": "ਦਿਨੁ ਰੈਣਿ ਹਰਿ ਲਿਵ ਲਾਇ"

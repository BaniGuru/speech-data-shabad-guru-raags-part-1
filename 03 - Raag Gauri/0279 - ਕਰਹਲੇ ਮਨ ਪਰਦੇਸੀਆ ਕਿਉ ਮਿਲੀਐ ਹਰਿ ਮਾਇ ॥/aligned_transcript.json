    },
    {
      "section_id": "section-00031",
      "start_time": 217.395,
      "end_time": 223.165,
      "transcript": "ਹਰਿ ਅੰਮ੍ਰਿਤ ਸਰੁ ਗੁਰਿ ਪੂਰਿਆ"

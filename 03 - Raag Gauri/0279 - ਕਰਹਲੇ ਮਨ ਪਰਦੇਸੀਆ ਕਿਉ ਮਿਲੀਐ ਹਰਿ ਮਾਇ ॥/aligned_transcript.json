    {
      "section_id": "section-00038",
      "start_time": 262.28,
      "end_time": 268.145,
      "transcript": "ਹਰਿ ਖਰਚੁ ਲੀਆ ਪਤਿ ਪਾਇ"
    },
    {
      "section_id": "section-00039",
      "start_time": 268.645,
      "end_time": 275.0,
      "transcript": "ਹਰਿ ਦਰਗਹ ਪੈਨਾਇਆ"

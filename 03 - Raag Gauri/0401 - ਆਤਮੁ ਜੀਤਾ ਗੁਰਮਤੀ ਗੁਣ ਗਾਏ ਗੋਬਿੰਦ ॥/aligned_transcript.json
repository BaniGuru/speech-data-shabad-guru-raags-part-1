  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 6.075,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.655,
      "end_time": 22.035,
      "transcript": "ਆਤਮੁ ਜੀਤਾ ਗੁਰਮਤੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.665,
      "end_time": 29.835,
      "transcript": "ਗੁਣ ਗਾਏ ਗੋਬਿੰਦ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.68,
      "end_time": 38.135,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦੀ ਭੈ ਮਿਟੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.585,
      "end_time": 48.925,
      "transcript": "ਨਾਨਕ ਬਿਨਸੀ ਚਿੰਦ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.44,
      "end_time": 62.647,
      "transcript": "ਅਮਾਵਸ ਆਤਮ ਸੁਖੀ ਭਏ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.647,
      "end_time": 67.065,
      "transcript": "ਸੰਤੋਖੁ ਦੀਆ ਗੁਰਦੇਵ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.065,
      "end_time": 71.503,
      "transcript": "ਮਨੁ ਤਨੁ ਸੀਤਲੁ ਸਾਂਤਿ ਸਹਜ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.503,
      "end_time": 76.16,
      "transcript": "ਲਾਗਾ ਪ੍ਰਭ ਕੀ ਸੇਵ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.16,
      "end_time": 80.501,
      "transcript": "ਟੂਟੇ ਬੰਧਨ ਬਹੁ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.501,
      "end_time": 84.92,
      "transcript": "ਸਫਲ ਪੂਰਨ ਤਾ ਕੇ ਕਾਮ"
    },
    {
      "section_id": "section-00012",
      "start_time": 84.92,
      "end_time": 89.242,
      "transcript": "ਦੁਰਮਤਿ ਮਿਟੀ ਹਉਮੈ ਛੁਟੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 89.242,
      "end_time": 93.525,
      "transcript": "ਸਿਮਰਤ ਹਰਿ ਕੋ ਨਾਮ"
    },
    {
      "section_id": "section-00014",
      "start_time": 93.64,
      "end_time": 101.985,
      "transcript": "ਸਰਨਿ ਗਹੀ ਪਾਰਬ੍ਰਹਮ ਕੀ, ਮਿਟਿਆ ਆਵਾ ਗਵਨ"
    },
    {
      "section_id": "section-00015",
      "start_time": 102.515,
      "end_time": 110.945,
      "transcript": "ਆਪਿ ਤਰਿਆ ਕੁਟੰਬ ਸਿਉ, ਗੁਣ ਗੁਬਿੰਦ ਪ੍ਰਭ ਰਵਨ"
    },
    {
      "section_id": "section-00016",
      "start_time": 111.32,
      "end_time": 119.645,
      "transcript": "ਹਰਿ ਕੀ ਟਹਲ ਕਮਾਵਣੀ, ਜਪੀਐ ਪ੍ਰਭ ਕਾ ਨਾਮੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 120.16,
      "end_time": 131.063,
      "transcript": "ਗੁਰ ਪੂਰੇ ਤੇ ਪਾਇਆ, ਨਾਨਕ ਸੁਖ ਬਿਸ੍ਰਾਮੁ"
    }
  ]
}

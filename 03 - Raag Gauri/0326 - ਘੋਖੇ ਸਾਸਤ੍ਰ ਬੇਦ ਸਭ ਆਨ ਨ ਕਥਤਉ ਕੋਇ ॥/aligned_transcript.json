{
  "audio_file": "0191 G Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.185,
      "end_time": 6.136,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.136,
      "end_time": 14.077,
      "transcript": "ਘੋਖੇ ਸਾਸਤ੍ਰ ਬੇਦ ਸਭ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.077,
      "end_time": 21.728,
      "transcript": "ਆਨ ਨ ਕਥਤਉ ਕੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.728,
      "end_time": 29.421,
      "transcript": "ਆਦਿ ਜੁਗਾਦੀ ਹੁਣਿ ਹੋਵਤ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.421,
      "end_time": 37.875,
      "transcript": "ਨਾਨਕ ਏਕੈ ਸੋਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.32,
      "end_time": 51.871,
      "transcript": "ਘਘਾ ਘਾਲਹੁ ਮਨਹਿ ਏਹ, ਬਿਨੁ ਹਰਿ ਦੂਸਰ ਨਾਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.871,
      "end_time": 60.304,
      "transcript": "ਨਹ ਹੋਆ ਨਹ ਹੋਵਨਾ, ਜਤ ਕਤ ਓਹੀ ਸਮਾਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.304,
      "end_time": 64.725,
      "transcript": "ਘੂਲਹਿ ਤਉ ਮਨ, ਜਉ ਆਵਹਿ ਸਰਨਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.725,
      "end_time": 68.886,
      "transcript": "ਨਾਮ ਤਤੁ ਕਲਿ ਮਹਿ, ਪੁਨਹਚਰਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.886,
      "end_time": 73.28,
      "transcript": "ਘਾਲਿ ਘਾਲਿ, ਅਨਿਕ ਪਛੁਤਾਵਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 73.28,
      "end_time": 77.523,
      "transcript": "ਬਿਨੁ ਹਰਿ ਭਗਤਿ, ਕਹਾ ਥਿਤਿ ਪਾਵਹਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 77.523,
      "end_time": 86.08,
      "transcript": "ਘੋਲਿ ਮਹਾ ਰਸੁ, ਅੰਮ੍ਰਿਤੁ ਤਿਹ ਪੀਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 86.08,
      "end_time": 90.905,
      "transcript": "ਨਾਨਕ ਹਰਿ ਗੁਰਿ, ਜਾ ਕਉ ਦੀਆ"
    }
  ]
}

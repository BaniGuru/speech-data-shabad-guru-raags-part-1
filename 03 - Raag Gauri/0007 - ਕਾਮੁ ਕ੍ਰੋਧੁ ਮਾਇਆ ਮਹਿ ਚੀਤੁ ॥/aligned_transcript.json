{
  "audio_file": "0116 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.28,
      "end_time": 6.685,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.133,
      "end_time": 21.21,
      "transcript": "ਕਾਮੁ ਕ੍ਰੋਧੁ, ਮਾਇਆ ਮਹਿ ਚੀਤੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.21,
      "end_time": 28.04,
      "transcript": "ਝੂਠ ਵਿਕਾਰਿ, ਜਾਗੈ ਹਿਤ ਚੀਤੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.04,
      "end_time": 35.111,
      "transcript": "ਪੂੰਜੀ ਪਾਪ ਲੋਭ ਕੀ ਕੀਤੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.111,
      "end_time": 42.236,
      "transcript": "ਤਰੁ ਤਾਰੀ ਮਨਿ ਨਾਮੁ ਸੁਚੀਤੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.236,
      "end_time": 49.154,
      "transcript": "ਵਾਹੁ ਵਾਹੁ ਸਾਚੇ, ਮੈ ਤੇਰੀ ਟੇਕ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.154,
      "end_time": 56.316,
      "transcript": "ਹਉ ਪਾਪੀ ਤੂੰ ਨਿਰਮਲੁ ਏਕ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.4,
      "end_time": 70.267,
      "transcript": "ਅਗਨਿ ਪਾਣੀ, ਬੋਲੈ ਭੜਵਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.267,
      "end_time": 77.39,
      "transcript": "ਜਿਹਵਾ ਇੰਦ੍ਰੀ, ਏਕੁ ਸੁਆਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.39,
      "end_time": 84.463,
      "transcript": "ਦਿਸਟਿ ਵਿਕਾਰੀ, ਨਾਹੀ ਭਉ ਭਾਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.463,
      "end_time": 91.755,
      "transcript": "ਆਪੁ ਮਾਰੇ, ਤਾ ਪਾਏ ਨਾਉ"
    },
    {
      "section_id": "section-00012",
      "start_time": 91.755,
      "end_time": 98.899,
      "transcript": "ਸਬਦਿ ਮਰੈ, ਫਿਰਿ ਮਰਣੁ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 98.899,
      "end_time": 105.607,
      "transcript": "ਬਿਨੁ ਮੂਏ ਕਿਉ ਪੂਰਾ ਹੋਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 105.607,
      "end_time": 112.826,
      "transcript": "ਪਰਪੰਚਿ ਵਿਆਪਿ ਰਹਿਆ ਮਨੁ ਦੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 112.826,
      "end_time": 119.86,
      "transcript": "ਥਿਰੁ ਨਾਰਾਇਣੁ, ਕਰੇ ਸੁ ਹੋਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 119.86,
      "end_time": 126.969,
      "transcript": "ਬੋਹਿਥਿ ਚੜਉ, ਜਾ ਆਵੈ ਵਾਰੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 126.969,
      "end_time": 133.963,
      "transcript": "ਠਾਕੇ ਬੋਹਿਥ, ਦਰਗਹ ਮਾਰ"
    },
    {
      "section_id": "section-00018",
      "start_time": 133.963,
      "end_time": 140.923,
      "transcript": "ਸਚੁ ਸਾਲਾਹੀ, ਧੰਨੁ ਗੁਰਦੁਆਰੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 140.923,
      "end_time": 147.868,
      "transcript": "ਨਾਨਕ ਦਰਿ ਘਰਿ ਏਕੰਕਾਰੁ"
    }
  ]
}

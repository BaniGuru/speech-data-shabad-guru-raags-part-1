      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 35.425,
      "end_time": 41.565,
      "transcript": "ਸੁਰਤਿ ਸਿਮ੍ਰਿਤਿ ਦੁਇ ਕੰਨੀ ਮੁੰਦਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 41.565,
      "end_time": 47.875,
      "transcript": "ਪਰਮਿਤਿ ਬਾਹਰਿ ਖਿੰਥਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 48.135,
      "end_time": 54.32,
      "transcript": "ਸੁੰਨ ਗੁਫਾ ਮਹਿ ਆਸਣੁ ਬੈਸਣੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 54.32,
      "end_time": 60.314,
      "transcript": "ਕਲਪ ਬਿਬਰਜਿਤ ਪੰਥਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 60.314,
      "end_time": 66.54,
      "transcript": "ਮੇਰੇ ਰਾਜਨ, ਮੈ ਬੈਰਾਗੀ ਜੋਗੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.54,
      "end_time": 75.075,
      "transcript": "ਮਰਤ ਨ ਸੋਗ ਬਿਓਗੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 82.24,
      "end_time": 88.44,
      "transcript": "ਖੰਡ ਬ੍ਰਹਮੰਡ ਮਹਿ ਸਿੰਙੀ ਮੇਰਾ ਬਟੂਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 88.44,
      "end_time": 94.379,
      "transcript": "ਸਭੁ ਜਗੁ ਭਸਮਾਧਾਰੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 94.379,
      "end_time": 100.92,
      "transcript": "ਤਾੜੀ ਲਾਗੀ ਤ੍ਰਿਪਲੁ ਪਲਟੀਐ"
    },
    {
      "section_id": "section-00011",
      "start_time": 100.92,
      "end_time": 106.615,
      "transcript": "ਛੂਟੈ ਹੋਇ ਪਸਾਰੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 113.28,
      "end_time": 119.44,
      "transcript": "ਮਨੁ ਪਵਨੁ ਦੁਇ ਤੂੰਬਾ ਕਰੀ ਹੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 119.44,
      "end_time": 125.48,
      "transcript": "ਜੁਗ ਜੁਗ ਸਾਰਦ ਸਾਜੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 125.48,
      "end_time": 131.84,
      "transcript": "ਥਿਰੁ ਭਈ ਤੰਤੀ ਤੂਟਸਿ ਨਾਹੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 131.84,
      "end_time": 137.555,
      "transcript": "ਅਨਹਦ ਕਿੰਗੁਰੀ ਬਾਜੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 137.895,
      "end_time": 143.93,
      "transcript": "ਸੁਨਿ ਮਨ ਮਗਨ ਭਏ ਹੈ ਪੂਰੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 143.93,
      "end_time": 150.111,
      "transcript": "ਮਾਇਆ ਡੋਲ ਨ ਲਾਗੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 150.111,
      "end_time": 156.345,
      "transcript": "ਕਹੁ ਕਬੀਰ ਤਾ ਕਉ ਪੁਨਰਪਿ ਜਨਮੁ ਨਹੀ"
    },
    {
      "section_id": "section-00019",
      "start_time": 156.345,
      "end_time": 161.895,
      "transcript": "ਖੇਲਿ ਗਇਓ ਬੈਰਾਗੀ"
    }
  ]

    {
      "section_id": "section-00003",
      "start_time": 37.72,
      "end_time": 45.56,
      "transcript": "ਤੁਮ ਹਰਿ ਸੇਤੀ, ਰਾਤੇ ਸੰਤਹੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.56,
      "end_time": 52.907,
      "transcript": "ਨਿਬਾਹਿ ਲੇਹੁ ਮੋ ਕਉ ਪੁਰਖ ਬਿਧਾਤੇ"

    {
      "section_id": "section-00012",
      "start_time": 116.48,
      "end_time": 123.829,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਰਾਖਹੁ ਸੰਗੇ"

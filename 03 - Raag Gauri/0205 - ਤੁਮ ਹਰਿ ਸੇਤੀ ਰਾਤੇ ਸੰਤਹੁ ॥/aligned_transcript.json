    {
      "section_id": "section-00007",
      "start_time": 77.4,
      "end_time": 84.735,
      "transcript": "ਤੁਮ ਪੂਰਨ ਪੁਰਖ ਬਿਧਾਤੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 85.245,
      "end_time": 92.725,
      "transcript": "ਰਾਖਹੁ ਸਰਣਿ ਅਨਾਥ ਦੀਨ ਕਉ"

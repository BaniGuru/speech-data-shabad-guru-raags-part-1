      "section_id": "section-00001",
      "start_time": 0.105,
      "end_time": 7.507,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.96,
      "end_time": 26.435,
      "transcript": "ਸਭਹੂ ਕੋ ਰਸੁ ਹਰਿ ਹੋ ਰਹਾਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.08,
      "end_time": 44.265,
      "transcript": "ਕਾਹੂ ਜੋਗ ਕਾਹੂ ਭੋਗ, ਕਾਹੂ ਗਿਆਨ ਕਾਹੂ ਧਿਆਨ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.265,
      "end_time": 51.455,
      "transcript": "ਕਾਹੂ ਹੋ, ਡੰਡ ਧਰਿ ਹੋ"
    },
    {
      "section_id": "section-00005",
      "start_time": 51.8,
      "end_time": 58.965,
      "transcript": "ਕਾਹੂ ਜਾਪ ਕਾਹੂ ਤਾਪ, ਕਾਹੂ ਪੂਜਾ ਹੋਮ ਨੇਮ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.965,
      "end_time": 66.643,
      "transcript": "ਕਾਹੂ ਹੋ, ਗਉਨੁ ਕਰਿ ਹੋ"
    },
    {
      "section_id": "section-00007",
      "start_time": 73.745,
      "end_time": 80.841,
      "transcript": "ਕਾਹੂ ਤੀਰ ਕਾਹੂ ਨੀਰ, ਕਾਹੂ ਬੇਦ ਬੀਚਾਰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 80.841,
      "end_time": 87.823,
      "transcript": "ਨਾਨਕਾ, ਭਗਤਿ ਪ੍ਰਿਅ ਹੋ"
    }
  ]

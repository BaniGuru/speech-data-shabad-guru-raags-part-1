{
  "audio_file": "0116 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.921,
      "end_time": 15.141,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 32.651,
      "end_time": 40.392,
      "transcript": "ਜਾਤੋ ਜਾਇ, ਕਹਾ ਤੇ ਆਵੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 40.392,
      "end_time": 47.219,
      "transcript": "ਕਹ ਉਪਜੈ, ਕਹ ਜਾਇ ਸਮਾਵੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 47.219,
      "end_time": 54.755,
      "transcript": "ਕਿਉ ਬਾਧਿਓ, ਕਿਉ ਮੁਕਤੀ ਪਾਵੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 54.755,
      "end_time": 61.87,
      "transcript": "ਕਿਉ ਅਬਿਨਾਸੀ ਸਹਜਿ ਸਮਾਵੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 61.87,
      "end_time": 68.715,
      "transcript": "ਨਾਮੁ ਰਿਦੈ, ਅੰਮ੍ਰਿਤੁ ਮੁਖਿ ਨਾਮੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 68.715,
      "end_time": 76.285,
      "transcript": "ਨਰਹਰ ਨਾਮੁ, ਨਰਹਰ ਨਿਹਕਾਮੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 83.56,
      "end_time": 90.521,
      "transcript": "ਸਹਜੇ ਆਵੈ, ਸਹਜੇ ਜਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 90.521,
      "end_time": 97.435,
      "transcript": "ਮਨ ਤੇ ਉਪਜੈ, ਮਨ ਮਾਹਿ ਸਮਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 97.435,
      "end_time": 104.746,
      "transcript": "ਗੁਰਮੁਖਿ ਮੁਕਤੋ, ਬੰਧੁ ਨ ਪਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.746,
      "end_time": 111.799,
      "transcript": "ਸਬਦੁ ਬੀਚਾਰਿ, ਛੁਟੈ ਹਰਿ ਨਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 111.799,
      "end_time": 118.929,
      "transcript": "ਤਰਵਰ ਪੰਖੀ, ਬਹੁ ਨਿਸਿ ਬਾਸੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 118.929,
      "end_time": 126.129,
      "transcript": "ਸੁਖ ਦੁਖੀਆ ਮਨਿ ਮੋਹ ਵਿਣਾਸੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 126.129,
      "end_time": 133.13,
      "transcript": "ਸਾਝ ਬਿਹਾਗ, ਤਕਹਿ ਆਗਾਸੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 133.13,
      "end_time": 140.289,
      "transcript": "ਦਹ ਦਿਸਿ ਧਾਵਹਿ, ਕਰਮਿ ਲਿਖਿਆਸੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 140.289,
      "end_time": 147.61,
      "transcript": "ਨਾਮ ਸੰਜੋਗੀ, ਗੋਇਲਿ ਥਾਟੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 147.61,
      "end_time": 154.619,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ, ਫੂਟੈ ਬਿਖੁ ਮਾਟੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 154.619,
      "end_time": 161.731,
      "transcript": "ਬਿਨੁ ਵਖਰ ਸੂਨੋ ਘਰੁ ਹਾਟੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 161.731,
      "end_time": 169.097,
      "transcript": "ਗੁਰ ਮਿਲਿ ਖੋਲੇ ਬਜਰ ਕਪਾਟ"
    },
    {
      "section_id": "section-00020",
      "start_time": 169.097,
      "end_time": 176.203,
      "transcript": "ਸਾਧੁ ਮਿਲੈ, ਪੂਰਬ ਸੰਜੋਗ"
    },
    {
      "section_id": "section-00021",
      "start_time": 176.203,
      "end_time": 183.236,
      "transcript": "ਸਚਿ ਰਹਸੇ, ਪੂਰੇ ਹਰਿ ਲੋਗ"
    },
    {
      "section_id": "section-00022",
      "start_time": 183.236,
      "end_time": 190.546,
      "transcript": "ਮਨੁ ਤਨੁ ਦੇ, ਲੈ ਸਹਜਿ ਸੁਭਾਇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 190.546,
      "end_time": 197.164,
      "transcript": "ਨਾਨਕ ਤਿਨ ਕੈ ਲਾਗਉ ਪਾਇ"
    }
  ]
}

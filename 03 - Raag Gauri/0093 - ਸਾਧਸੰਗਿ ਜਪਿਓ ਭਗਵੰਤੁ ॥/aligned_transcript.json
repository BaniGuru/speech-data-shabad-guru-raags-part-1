{
  "audio_file": "0138 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 7.553,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.2,
      "end_time": 21.044,
      "transcript": "ਸਾਧਸੰਗਿ, ਜਪਿਓ ਭਗਵੰਤੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.044,
      "end_time": 28.2,
      "transcript": "ਕੇਵਲ ਨਾਮੁ, ਦੀਓ ਗੁਰਿ ਮੰਤੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.2,
      "end_time": 35.24,
      "transcript": "ਤਜਿ ਅਭਿਮਾਨ, ਭਏ ਨਿਰਵੈਰ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.24,
      "end_time": 42.12,
      "transcript": "ਆਠ ਪਹਰ, ਪੂਜਹੁ ਗੁਰ ਪੈਰ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.12,
      "end_time": 49.16,
      "transcript": "ਅਬ ਮਤਿ ਬਿਨਸੀ, ਦੁਸਟ ਬਿਗਾਨੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.16,
      "end_time": 59.991,
      "transcript": "ਜਬ ਤੇ ਸੁਣਿਆ ਹਰਿ ਜਸੁ ਕਾਨੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.24,
      "end_time": 77.24,
      "transcript": "ਸਹਜ ਸੂਖ, ਆਨੰਦ ਨਿਧਾਨ"
    },
    {
      "section_id": "section-00009",
      "start_time": 77.24,
      "end_time": 84.041,
      "transcript": "ਰਾਖਨਹਾਰ, ਰਖਿ ਲੇਇ ਨਿਦਾਨ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.041,
      "end_time": 91.084,
      "transcript": "ਦੂਖ ਦਰਦ ਬਿਨਸੇ ਭੈ ਭਰਮ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.084,
      "end_time": 98.422,
      "transcript": "ਆਵਣ ਜਾਣ ਰਖੇ ਕਰਿ ਕਰਮ"
    },
    {
      "section_id": "section-00012",
      "start_time": 105.32,
      "end_time": 112.36,
      "transcript": "ਪੇਖੈ ਬੋਲੈ ਸੁਣੈ ਸਭੁ ਆਪਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.36,
      "end_time": 119.32,
      "transcript": "ਸਦਾ ਸੰਗਿ, ਤਾ ਕਉ ਮਨ ਜਾਪਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 119.32,
      "end_time": 126.28,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਭਇਓ ਪਰਗਾਸੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 126.28,
      "end_time": 133.604,
      "transcript": "ਪੂਰਿ ਰਹੇ, ਏਕੈ ਗੁਣਤਾਸੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 140.12,
      "end_time": 147.2,
      "transcript": "ਕਹਤ ਪਵਿਤ੍ਰ ਸੁਣਤ ਪੁਨੀਤ"
    },
    {
      "section_id": "section-00017",
      "start_time": 147.2,
      "end_time": 154.08,
      "transcript": "ਗੁਣ ਗੋਵਿੰਦ, ਗਾਵਹਿ ਨਿਤ ਨੀਤ"
    },
    {
      "section_id": "section-00018",
      "start_time": 154.08,
      "end_time": 161.0,
      "transcript": "ਕਹੁ ਨਾਨਕ ਜਾ ਕਉ ਹੋਹੁ ਕ੍ਰਿਪਾਲ"
    },
    {
      "section_id": "section-00019",
      "start_time": 161.0,
      "end_time": 167.96,
      "transcript": "ਤਿਸੁ ਜਨ ਕੀ ਸਭ ਪੂਰਨ ਘਾਲ"
    }
  ]
}

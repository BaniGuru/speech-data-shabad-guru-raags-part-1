{
  "audio_file": "0243 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.115,
      "end_time": 6.505,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.819,
      "end_time": 19.395,
      "transcript": "ਆਪੇ ਪਾਵਕੁ, ਆਪੇ ਪਵਨਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.605,
      "end_time": 26.055,
      "transcript": "ਜਾਰੈ ਖਸਮੁ, ਤ ਰਾਖੈ ਕਵਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.055,
      "end_time": 32.305,
      "transcript": "ਰਾਮ ਜਪਤ, ਤਨੁ ਜਰਿ ਕੀ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.585,
      "end_time": 42.265,
      "transcript": "ਰਾਮ ਨਾਮ, ਚਿਤੁ ਰਹਿਆ ਸਮਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.0,
      "end_time": 55.445,
      "transcript": "ਕਾ ਕੋ ਜਰੈ, ਕਾਹਿ ਹੋਇ ਹਾਨਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.445,
      "end_time": 62.12,
      "transcript": "ਨਟ ਵਟ ਖੇਲੈ, ਸਾਰਿਗਪਾਨਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.12,
      "end_time": 68.64,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਅਖਰ ਦੁਇ ਭਾਖਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.64,
      "end_time": 74.785,
      "transcript": "ਹੋਇਗਾ ਖਸਮੁ, ਤ ਲੇਇਗਾ ਰਾਖਿ"
    }
  ]
}

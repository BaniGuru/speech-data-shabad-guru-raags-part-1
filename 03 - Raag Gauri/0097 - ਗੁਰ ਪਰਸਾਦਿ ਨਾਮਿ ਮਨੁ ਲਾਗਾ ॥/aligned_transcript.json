{
  "audio_file": "0139 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.92,
      "end_time": 7.386,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.386,
      "end_time": 14.225,
      "transcript": "ਗੁਰ ਪਰਸਾਦਿ, ਨਾਮਿ ਮਨੁ ਲਾਗਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.225,
      "end_time": 21.198,
      "transcript": "ਜਨਮ ਜਨਮ ਕਾ, ਸੋਇਆ ਜਾਗਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.198,
      "end_time": 27.721,
      "transcript": "ਅੰਮ੍ਰਿਤ ਗੁਣ, ਉਚਰੈ ਪ੍ਰਭ ਬਾਣੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 27.721,
      "end_time": 35.34,
      "transcript": "ਪੂਰੇ ਗੁਰ ਕੀ, ਸੁਮਤਿ ਪਰਾਣੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.28,
      "end_time": 48.04,
      "transcript": "ਪ੍ਰਭ ਸਿਮਰਤ, ਕੁਸਲ ਸਭਿ ਪਾਏ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.04,
      "end_time": 56.163,
      "transcript": "ਘਰਿ ਬਾਹਰਿ ਸੁਖ ਸਹਜ ਸਬਾਏ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.36,
      "end_time": 67.92,
      "transcript": "ਸੋਈ ਪਛਾਤਾ, ਜਿਨਹਿ ਉਪਾਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.92,
      "end_time": 74.494,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਪ੍ਰਭਿ ਆਪਿ ਮਿਲਾਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.494,
      "end_time": 81.24,
      "transcript": "ਬਾਹ ਪਕਰਿ, ਲੀਨੋ ਕਰਿ ਅਪਨਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.24,
      "end_time": 87.88,
      "transcript": "ਹਰਿ ਹਰਿ ਕਥਾ, ਸਦਾ ਜਪੁ ਜਪਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.88,
      "end_time": 94.48,
      "transcript": "ਮੰਤ੍ਰੁ ਤੰਤ੍ਰੁ, ਅਉਖਧੁ ਪੁਨਹਚਾਰੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 94.48,
      "end_time": 101.16,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਜੀਅ ਪ੍ਰਾਨ ਅਧਾਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 101.16,
      "end_time": 107.72,
      "transcript": "ਸਾਚਾ ਧਨੁ, ਪਾਇਓ ਹਰਿ ਰੰਗਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 107.72,
      "end_time": 114.36,
      "transcript": "ਦੁਤਰੁ ਤਰੇ, ਸਾਧ ਕੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 114.36,
      "end_time": 121.0,
      "transcript": "ਸੁਖਿ ਬੈਸਹੁ, ਸੰਤ ਸਜਨ ਪਰਵਾਰੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 121.0,
      "end_time": 127.64,
      "transcript": "ਹਰਿ ਧਨੁ ਖਟਿਓ, ਜਾ ਕਾ ਨਾਹਿ ਸੁਮਾਰੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 127.64,
      "end_time": 134.1,
      "transcript": "ਜਿਸਹਿ ਪਰਾਪਤਿ, ਤਿਸੁ ਗੁਰੁ ਦੇਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 134.1,
      "end_time": 141.32,
      "transcript": "ਨਾਨਕ ਬਿਰਥਾ ਕੋਇ ਨ ਹੇਇ"
    }
  ]
}

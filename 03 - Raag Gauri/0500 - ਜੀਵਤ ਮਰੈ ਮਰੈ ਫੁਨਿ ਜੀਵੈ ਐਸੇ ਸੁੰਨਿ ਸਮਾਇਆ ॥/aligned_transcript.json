{
  "audio_file": "0245 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 8.875,
      "transcript": "ਗਉੜੀ ਜੀਵਤ ਮਰੈ ਮਰੈ ਫੁਨਿ ਜੀਵੈ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.88,
      "end_time": 16.675,
      "transcript": "ਐਸੇ ਸੁੰਨਿ ਸਮਾਇਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.52,
      "end_time": 25.415,
      "transcript": "ਅੰਜਨ ਮਾਹਿ ਨਿਰੰਜਨਿ ਰਹੀਐ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.295,
      "end_time": 33.685,
      "transcript": "ਬਹੁੜਿ ਨ ਭਵਜਲਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.215,
      "end_time": 50.405,
      "transcript": "ਮੇਰੇ ਰਾਮ, ਐਸਾ ਖੀਰੁ ਬਿਲੋਈਐ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.015,
      "end_time": 58.955,
      "transcript": "ਗੁਰਮਤਿ ਮਨੂਆ ਅਸਥਿਰੁ ਰਾਖਹੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 58.955,
      "end_time": 67.845,
      "transcript": "ਇਨ ਬਿਧਿ ਅੰਮ੍ਰਿਤੁ ਪੀਓਈਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.585,
      "end_time": 83.535,
      "transcript": "ਗੁਰ ਕੈ ਬਾਣਿ ਬਜਰ ਕਲ ਛੇਦੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.0,
      "end_time": 91.585,
      "transcript": "ਪ੍ਰਗਟਿਆ ਪਦੁ ਪਰਗਾਸਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.24,
      "end_time": 99.655,
      "transcript": "ਸਕਤਿ ਅਧੇਰ ਜੇਵੜੀ ਭ੍ਰਮੁ ਚੂਕਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 100.52,
      "end_time": 107.825,
      "transcript": "ਨਿਹਚਲੁ ਸਿਵ ਘਰਿ ਬਾਸਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 116.96,
      "end_time": 124.705,
      "transcript": "ਤਿਨਿ ਬਿਨੁ ਬਾਣੈ ਧਨਖੁ ਚਢਾਈਐ"
    },
    {
      "section_id": "section-00013",
      "start_time": 125.28,
      "end_time": 132.785,
      "transcript": "ਇਹੁ ਜਗੁ ਬੇਧਿਆ ਭਾਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 133.395,
      "end_time": 141.005,
      "transcript": "ਦਹ ਦਿਸ ਬੂਡੀ ਪਵਨੁ ਝੁਲਾਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 141.68,
      "end_time": 148.995,
      "transcript": "ਡੋਰਿ ਰਹੀ ਲਿਵ ਲਾਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 149.84,
      "end_time": 157.365,
      "transcript": "ਉਨਮਨਿ ਮਨੂਆ ਸੁੰਨਿ ਸਮਾਨਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 157.96,
      "end_time": 165.515,
      "transcript": "ਦੁਬਿਧਾ ਦੁਰਮਤਿ ਭਾਗੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 166.2,
      "end_time": 173.525,
      "transcript": "ਕਹੁ ਕਬੀਰ ਅਨਭਉ ਇਕੁ ਦੇਖਿਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 174.285,
      "end_time": 181.085,
      "transcript": "ਰਾਮ ਨਾਮਿ ਲਿਵ ਲਾਗੀ"
    }
  ]
}

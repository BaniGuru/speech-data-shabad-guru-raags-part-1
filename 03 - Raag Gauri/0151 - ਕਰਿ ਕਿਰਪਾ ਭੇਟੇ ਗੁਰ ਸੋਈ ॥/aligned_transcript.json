{
  "audio_file": "0148 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.765,
      "end_time": 17.175,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 27.965,
      "end_time": 36.005,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਭੇਟੇ ਗੁਰ ਸੋਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.005,
      "end_time": 44.116,
      "transcript": "ਤਿਤੁ ਬਲਿ, ਰੋਗੁ ਨ ਬਿਆਪੈ ਕੋਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.116,
      "end_time": 52.515,
      "transcript": "ਰਾਮ ਰਮਣ, ਤਰਣ ਭੈ ਸਾਗਰ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.515,
      "end_time": 61.152,
      "transcript": "ਸਰਣਿ ਸੂਰ, ਫਾਰੇ ਜਮ ਕਾਗਰ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 81.4,
      "end_time": 89.368,
      "transcript": "ਸਤਿਗੁਰਿ ਮੰਤ੍ਰੁ ਦੀਓ, ਹਰਿ ਨਾਮ"
    },
    {
      "section_id": "section-00007",
      "start_time": 89.368,
      "end_time": 97.235,
      "transcript": "ਇਹ ਆਸਰ, ਪੂਰਨ ਭਏ ਕਾਮ"
    },
    {
      "section_id": "section-00008",
      "start_time": 97.335,
      "end_time": 105.745,
      "transcript": "ਜਪ ਤਪ ਸੰਜਮ, ਪੂਰੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 105.945,
      "end_time": 113.645,
      "transcript": "ਗੁਰ ਕਿਰਪਾਲ, ਹਰਿ ਭਏ ਸਹਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 114.205,
      "end_time": 122.025,
      "transcript": "ਮਾਨ ਮੋਹ ਖੋਏ, ਗੁਰਿ ਭਰਮ"
    },
    {
      "section_id": "section-00011",
      "start_time": 122.36,
      "end_time": 129.165,
      "transcript": "ਪੇਖੁ ਨਾਨਕ, ਪਸਰੇ ਪਾਰਬ੍ਰਹਮ"
    }
  ]
}

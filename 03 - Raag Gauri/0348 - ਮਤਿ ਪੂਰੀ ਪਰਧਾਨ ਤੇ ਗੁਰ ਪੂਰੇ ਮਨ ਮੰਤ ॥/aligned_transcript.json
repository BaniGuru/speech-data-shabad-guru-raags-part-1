  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.635,
      "end_time": 2.923,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 10.415,
      "end_time": 16.475,
      "transcript": "ਮਤਿ ਪੂਰੀ ਪਰਧਾਨ ਤੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.645,
      "end_time": 21.975,
      "transcript": "ਗੁਰ ਪੂਰੇ ਮਨ ਮੰਤ"
    },
    {
      "section_id": "section-00004",
      "start_time": 22.48,
      "end_time": 27.905,
      "transcript": "ਜਿਹ ਜਾਨਿਓ ਪ੍ਰਭੁ ਆਪੁਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.345,
      "end_time": 33.765,
      "transcript": "ਨਾਨਕ ਤੇ ਭਗਵੰਤ"
    },
    {
      "section_id": "section-00006",
      "start_time": 34.24,
      "end_time": 35.895,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 45.4,
      "end_time": 53.13,
      "transcript": "ਮਮਾ, ਜਾਹੂ ਮਰਮੁ ਪਛਾਨਾ ਭੇਟਤ ਸਾਧਸੰਗ, ਪਤੀਆਨਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 53.13,
      "end_time": 57.145,
      "transcript": "ਦੁਖ ਸੁਖ ਉਆ ਕੈ, ਸਮਤ ਬੀਚਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 57.145,
      "end_time": 61.17,
      "transcript": "ਨਰਕ ਸੁਰਗ ਰਹਤ ਅਉਤਾਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 61.17,
      "end_time": 68.92,
      "transcript": "ਤਾਹੂ ਸੰਗ, ਤਾਹੂ ਨਿਰਲੇਪਾ ਪੂਰਨ ਘਟ ਘਟ, ਪੁਰਖ ਬਿਸੇਖਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 68.92,
      "end_time": 77.105,
      "transcript": "ਉਆ ਰਸ ਮਹਿ, ਉਆਹੂ ਸੁਖੁ ਪਾਇਆ ਨਾਨਕ, ਲਿਪਤ ਨਹੀ ਤਿਹ ਮਾਇਆ"
    }
  ]
}

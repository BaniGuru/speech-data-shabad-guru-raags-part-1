{
  "audio_file": "0190 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.213,
      "end_time": 11.335,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 21.445,
      "end_time": 28.425,
      "transcript": "ਆਵਤ ਹੁਕਮਿ ਬਿਨਾਸ ਹੁਕਮਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 28.425,
      "end_time": 35.105,
      "transcript": "ਆਗਿਆ ਭਿੰਨ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.605,
      "end_time": 41.965,
      "transcript": "ਆਵਨ ਜਾਨਾ ਤਿਹ ਮਿਟੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.475,
      "end_time": 53.108,
      "transcript": "ਨਾਨਕ ਜਿਹ ਮਨਿ ਸੋਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 64.285,
      "end_time": 68.835,
      "transcript": "ਏਊ ਜੀਅ, ਬਹੁਤੁ ਗ੍ਰਭ ਵਾਸੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 68.835,
      "end_time": 73.68,
      "transcript": "ਮੋਹ ਮਗਨ, ਮੀਠ ਜੋਨਿ ਫਾਸੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 73.68,
      "end_time": 78.173,
      "transcript": "ਇਨਿ ਮਾਇਆ, ਤ੍ਰੈ ਗੁਣ ਬਸਿ ਕੀਨੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 78.173,
      "end_time": 82.72,
      "transcript": "ਆਪਨ ਮੋਹ, ਘਟੇ ਘਟਿ ਦੀਨੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.72,
      "end_time": 87.32,
      "transcript": "ਏ ਸਾਜਨ, ਕਛੁ ਕਹਹੁ ਉਪਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.32,
      "end_time": 91.71,
      "transcript": "ਜਾ ਤੇ ਤਰਉ, ਬਿਖਮ ਇਹ ਮਾਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 91.71,
      "end_time": 95.865,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਸਤਸੰਗਿ ਮਿਲਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 95.865,
      "end_time": 100.933,
      "transcript": "ਨਾਨਕ ਤਾ ਕੈ, ਨਿਕਟਿ ਨ ਮਾਏ"
    }
  ]
}

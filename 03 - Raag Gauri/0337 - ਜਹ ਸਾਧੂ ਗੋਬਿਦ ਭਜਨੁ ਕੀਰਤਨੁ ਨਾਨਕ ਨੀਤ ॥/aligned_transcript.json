  "audio_file": "0193 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.76,
      "end_time": 7.279,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.873,
      "end_time": 21.56,
      "transcript": "ਜਹ ਸਾਧੂ ਗੋਬਿਦ ਭਜਨੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.56,
      "end_time": 27.755,
      "transcript": "ਕੀਰਤਨੁ ਨਾਨਕ ਨੀਤ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.16,
      "end_time": 34.51,
      "transcript": "ਣਾ ਹਉ ਣਾ ਤੂੰ ਣਹ ਛੁਟਹਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.51,
      "end_time": 44.535,
      "transcript": "ਨਿਕਟਿ ਨ ਜਾਈਅਹੁ ਦੂਤ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.783,
      "end_time": 62.075,
      "transcript": "ਣਾਣਾ ਰਣ ਤੇ ਸੀਝੀਐ, ਆਤਮ ਜੀਤੈ ਕੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.075,
      "end_time": 70.285,
      "transcript": "ਹਉਮੈ ਅਨ ਸਿਉ ਲਰਿ ਮਰੈ, ਸੋ ਸੋਭਾ ਦੂ ਹੋਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.64,
      "end_time": 78.755,
      "transcript": "ਮਣੀ ਮਿਟਾਇ ਜੀਵਤ ਮਰੈ, ਗੁਰ ਪੂਰੇ ਉਪਦੇਸ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.04,
      "end_time": 87.469,
      "transcript": "ਮਨੂਆ ਜੀਤੈ ਹਰਿ ਮਿਲੈ, ਤਿਹ ਸੂਰਤਣ ਵੇਸ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.469,
      "end_time": 95.435,
      "transcript": "ਣਾ ਕੋ ਜਾਣੈ ਆਪਣੋ, ਏਕਹਿ ਟੇਕ ਅਧਾਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.88,
      "end_time": 103.855,
      "transcript": "ਰੈਣਿ ਦਿਣਸੁ ਸਿਮਰਤ ਰਹੈ, ਸੋ ਪ੍ਰਭੁ ਪੁਰਖੁ ਅਪਾਰ"
    },
    {
      "section_id": "section-00012",
      "start_time": 104.005,
      "end_time": 112.55,
      "transcript": "ਰੇਣ ਸਗਲ ਇਆ ਮਨੁ ਕਰੈ, ਏਊ ਕਰਮ ਕਮਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.55,
      "end_time": 122.205,
      "transcript": "ਹੁਕਮੈ ਬੂਝੈ ਸਦਾ ਸੁਖੁ, ਨਾਨਕ ਲਿਖਿਆ ਪਾਇ"
    }
  ]
}

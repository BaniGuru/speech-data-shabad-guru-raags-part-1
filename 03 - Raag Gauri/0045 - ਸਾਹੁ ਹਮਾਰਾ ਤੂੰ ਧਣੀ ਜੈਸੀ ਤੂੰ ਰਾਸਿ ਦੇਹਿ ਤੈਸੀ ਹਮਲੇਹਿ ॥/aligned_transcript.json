    {
      "section_id": "section-00017",
      "start_time": 163.096,
      "end_time": 170.823,
      "transcript": "ਜਿਸੁ ਕ੍ਰਿਪਾਲੁ ਹੋਇ ਪ੍ਰਭੁ ਦੇਈ"

{
  "audio_file": "0171 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.185,
      "end_time": 8.415,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.84,
      "end_time": 24.982,
      "transcript": "ਹਉਮੈ ਕਰਤ ਭੇਖੀ, ਨਹੀ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 24.982,
      "end_time": 33.41,
      "transcript": "ਗੁਰਮੁਖਿ ਭਗਤਿ, ਵਿਰਲੇ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.41,
      "end_time": 41.685,
      "transcript": "ਹਉ ਹਉ ਕਰਤ, ਨਹੀ ਸਚੁ ਪਾਈਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 41.685,
      "end_time": 54.145,
      "transcript": "ਹਉਮੈ ਜਾਇ, ਪਰਮ ਪਦੁ ਪਾਈਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 57.785,
      "end_time": 66.485,
      "transcript": "ਹਉਮੈ ਕਰਿ, ਰਾਜੇ ਬਹੁ ਧਾਵਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.72,
      "end_time": 74.775,
      "transcript": "ਹਉਮੈ ਖਪਹਿ, ਜਨਮਿ ਮਰਿ ਆਵਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.055,
      "end_time": 83.165,
      "transcript": "ਹਉਮੈ ਨਿਵਰੈ, ਗੁਰਸਬਦੁ ਵੀਚਾਰੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 83.165,
      "end_time": 91.84,
      "transcript": "ਚੰਚਲ ਮਤਿ ਤਿਆਗੈ, ਪੰਚ ਸੰਘਾਰੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.84,
      "end_time": 99.947,
      "transcript": "ਅੰਤਰਿ ਸਾਚੁ, ਸਹਜ ਘਰਿ ਆਵਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 99.947,
      "end_time": 108.641,
      "transcript": "ਰਾਜਨੁ ਜਾਣਿ, ਪਰਮ ਗਤਿ ਪਾਵਹਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 116.625,
      "end_time": 124.94,
      "transcript": "ਸਚੁ ਕਰਣੀ, ਗੁਰੁ ਭਰਮੁ ਚੁਕਾਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 124.94,
      "end_time": 133.58,
      "transcript": "ਨਿਰਭਉ ਕੈ ਘਰਿ, ਤਾੜੀ ਲਾਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 133.58,
      "end_time": 141.96,
      "transcript": "ਹਉ ਹਉ ਕਰਿ ਮਰਣਾ, ਕਿਆ ਪਾਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 141.96,
      "end_time": 150.24,
      "transcript": "ਪੂਰਾ ਗੁਰੁ ਭੇਟੇ, ਸੋ ਝਗਰੁ ਚੁਕਾਵੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 150.24,
      "end_time": 158.527,
      "transcript": "ਜੇਤੀ ਹੈ, ਤੇਤੀ ਕਿਹੁ ਨਾਹੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 158.527,
      "end_time": 166.9,
      "transcript": "ਗੁਰਮੁਖਿ ਗਿਆਨ ਭੇਟਿ, ਗੁਣ ਗਾਹੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 166.9,
      "end_time": 175.029,
      "transcript": "ਹਉਮੈ ਬੰਧਨ, ਬੰਧਿ ਭਵਾਵੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 175.029,
      "end_time": 183.472,
      "transcript": "ਨਾਨਕ, ਰਾਮ ਭਗਤਿ ਸੁਖੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 183.472,
      "end_time": 193.355,
      "transcript": "ਨਾਨਕ, ਰਾਮ ਭਗਤਿ ਸੁਖੁ ਪਾਵੈ"
    }
  ]
}

    {
      "section_id": "section-00012",
      "start_time": 117.035,
      "end_time": 123.615,
      "transcript": "ਜਿਸੁ ਲੜਿ ਲਗਿਐ ਜੀਵੀਐ"
    },
    {
      "section_id": "section-00013",
      "start_time": 124.0,
      "end_time": 130.365,
      "transcript": "ਭਵਜਲੁ ਪਈਐ ਪਾਰਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 130.665,
      "end_time": 137.48,
      "transcript": "ਮਿਲਿ ਸਾਧੂ ਸੰਗਿ ਉਧਾਰੁ ਹੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 137.48,
      "end_time": 144.33,
      "transcript": "ਮੁਖ ਊਜਲ ਦਰਬਾਰਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 144.33,
      "end_time": 151.355,
      "transcript": "ਜੀਵਨ ਰੂਪ ਗੋਪਾਲ ਜਸੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 151.56,
      "end_time": 158.232,
      "transcript": "ਸੰਤ ਜਨਾ ਕੀ ਰਾਸਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 158.232,
      "end_time": 165.322,
      "transcript": "ਨਾਨਕ ਉਬਰੇ ਨਾਮੁ ਜਪਿ"

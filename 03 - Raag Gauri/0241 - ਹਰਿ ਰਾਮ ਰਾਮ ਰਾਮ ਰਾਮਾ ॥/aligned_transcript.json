  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 13.965,
      "transcript": "ਗਉੜੀ ਮਾਝ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 27.731,
      "end_time": 34.752,
      "transcript": "ਹਰਿ ਰਾਮ ਰਾਮ, ਰਾਮ ਰਾਮਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 34.752,
      "end_time": 41.865,
      "transcript": "ਜਪਿ, ਪੂਰਨ ਹੋਏ ਕਾਮਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 48.805,
      "end_time": 55.471,
      "transcript": "ਰਾਮ ਗੋਬਿੰਦ ਜਪੇਦਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 55.471,
      "end_time": 62.115,
      "transcript": "ਹੋਆ ਮੁਖੁ ਪਵਿਤ੍ਰੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.56,
      "end_time": 69.339,
      "transcript": "ਹਰਿ ਜਸੁ ਸੁਣੀਐ ਜਿਸ ਤੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 69.339,
      "end_time": 75.895,
      "transcript": "ਸੋਈ ਭਾਈ ਮਿਤ੍ਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.28,
      "end_time": 82.785,
      "transcript": "ਸਭਿ ਪਦਾਰਥ ਸਭਿ ਫਲਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 83.2,
      "end_time": 89.695,
      "transcript": "ਸਰਬ ਗੁਣਾ ਜਿਸੁ ਮਾਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.0,
      "end_time": 96.645,
      "transcript": "ਕਿਉ ਗੋਬਿੰਦੁ ਮਨਹੁ ਵਿਸਾਰੀਐ"
    },
    {
      "section_id": "section-00011",
      "start_time": 96.645,
      "end_time": 103.992,
      "transcript": "ਜਿਸੁ ਸਿਮਰਤ ਦੁਖ ਜਾਹਿ"

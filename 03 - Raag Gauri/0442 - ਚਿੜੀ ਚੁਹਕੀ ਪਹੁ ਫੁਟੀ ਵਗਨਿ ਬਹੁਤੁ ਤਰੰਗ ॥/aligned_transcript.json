      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.415,
      "end_time": 32.922,
      "transcript": "ਚਿੜੀ ਚੁਹਕੀ ਪਹੁ ਫੁਟੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.922,
      "end_time": 39.16,
      "transcript": "ਵਗਨਿ ਬਹੁਤੁ ਤਰੰਗ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.16,
      "end_time": 45.695,
      "transcript": "ਅਚਰਜ ਰੂਪ ਸੰਤਨ ਰਚੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.695,
      "end_time": 52.04,
      "transcript": "ਨਾਨਕ ਨਾਮਹਿ ਰੰਗ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.04,
      "end_time": 58.801,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 65.08,
      "end_time": 77.84,
      "transcript": "ਘਰ ਮੰਦਰ ਖੁਸੀਆ ਤਹੀ, ਜਹ ਤੂ ਆਵਹਿ ਚਿਤਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 77.84,
      "end_time": 84.046,
      "transcript": "ਦੁਨੀਆ ਕੀਆ ਵਡਿਆਈਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.046,
      "end_time": 90.5,
      "transcript": "ਨਾਨਕ ਸਭਿ ਕੁਮਿਤ"
    },
    {
      "section_id": "section-00011",
      "start_time": 90.5,
      "end_time": 94.245,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 102.92,
      "end_time": 111.125,
      "transcript": "ਹਰਿ ਧਨੁ ਸਚੀ ਰਾਸਿ ਹੈ, ਕਿਨੈ ਵਿਰਲੈ ਜਾਤਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 111.4,
      "end_time": 119.505,
      "transcript": "ਤਿਸੈ ਪਰਾਪਤਿ ਭਾਇਰਹੁ, ਜਿਸੁ ਦੇਇ ਬਿਧਾਤਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 119.84,
      "end_time": 128.299,
      "transcript": "ਮਨ ਤਨ ਭੀਤਰਿ ਮਉਲਿਆ, ਹਰਿ ਰੰਗਿ ਜਨੁ ਰਾਤਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 128.299,
      "end_time": 136.345,
      "transcript": "ਸਾਧਸੰਗਿ ਗੁਣ ਗਾਇਆ, ਸਭਿ ਦੋਖਹ ਖਾਤਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 136.555,
      "end_time": 146.065,
      "transcript": "ਨਾਨਕ ਸੋਈ ਜੀਵਿਆ, ਜਿਨਿ ਇਕੁ ਪਛਾਤਾ"
    }
  ]
}

{
  "audio_file": "0196 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.345,
      "end_time": 8.255,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.455,
      "end_time": 20.625,
      "transcript": "ਆਏ ਪ੍ਰਭ ਸਰਨਾਗਤੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.08,
      "end_time": 27.105,
      "transcript": "ਕਿਰਪਾ ਨਿਧਿ ਦਇਆਲ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.52,
      "end_time": 33.875,
      "transcript": "ਏਕ ਅਖਰੁ ਹਰਿ ਮਨਿ ਬਸਤ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.875,
      "end_time": 40.185,
      "transcript": "ਨਾਨਕ ਹੋਤ ਨਿਹਾਲ"
    },
    {
      "section_id": "section-00006",
      "start_time": 40.52,
      "end_time": 43.805,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.08,
      "end_time": 57.32,
      "transcript": "ਅਖਰ ਮਹਿ, ਤ੍ਰਿਭਵਨ ਪ੍ਰਭਿ ਧਾਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.32,
      "end_time": 61.61,
      "transcript": "ਅਖਰ ਕਰਿ ਕਰਿ, ਬੇਦ ਬੀਚਾਰੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 61.61,
      "end_time": 65.8,
      "transcript": "ਅਖਰ, ਸਾਸਤ੍ਰ ਸਿੰਮ੍ਰਿਤਿ ਪੁਰਾਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 65.8,
      "end_time": 70.025,
      "transcript": "ਅਖਰ, ਨਾਦ ਕਥਨ ਵਖੵਾਨਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 70.025,
      "end_time": 74.25,
      "transcript": "ਅਖਰ ਮੁਕਤਿ ਜੁਗਤਿ, ਭੈ ਭਰਮਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 74.25,
      "end_time": 78.52,
      "transcript": "ਅਖਰ ਕਰਮ ਕਿਰਤਿ, ਸੁਚ ਧਰਮਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 78.52,
      "end_time": 82.609,
      "transcript": "ਦ੍ਰਿਸਟਿਮਾਨ, ਅਖਰ ਹੈ ਜੇਤਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 82.609,
      "end_time": 88.269,
      "transcript": "ਨਾਨਕ ਪਾਰਬ੍ਰਹਮ ਨਿਰਲੇਪਾ"
    }
  ]
}

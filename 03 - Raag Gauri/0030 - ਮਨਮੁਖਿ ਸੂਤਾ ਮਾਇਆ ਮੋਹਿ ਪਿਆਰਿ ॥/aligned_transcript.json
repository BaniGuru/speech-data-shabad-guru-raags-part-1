{
  "audio_file": "0121 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.28,
      "end_time": 6.95,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.92,
      "end_time": 19.24,
      "transcript": "ਮਨਮੁਖਿ ਸੂਤਾ, ਮਾਇਆ ਮੋਹਿ ਪਿਆਰਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.24,
      "end_time": 25.56,
      "transcript": "ਗੁਰਮੁਖਿ ਜਾਗੇ, ਗੁਣ ਗਿਆਨ ਬੀਚਾਰਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.56,
      "end_time": 31.88,
      "transcript": "ਸੇ ਜਨ ਜਾਗੇ, ਜਿਨ ਨਾਮ ਪਿਆਰਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.88,
      "end_time": 38.32,
      "transcript": "ਸਹਜੇ ਜਾਗੈ, ਸਵੈ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 38.32,
      "end_time": 48.275,
      "transcript": "ਪੂਰੇ ਗੁਰ ਤੇ ਬੂਝੈ ਜਨੁ ਕੋਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.64,
      "end_time": 57.36,
      "transcript": "ਅਸੰਤੁ ਅਨਾੜੀ, ਕਦੇ ਨ ਬੂਝੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.36,
      "end_time": 63.76,
      "transcript": "ਕਥਨੀ ਕਰੇ, ਤੈ ਮਾਇਆ ਨਾਲਿ ਲੂਝੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.76,
      "end_time": 70.16,
      "transcript": "ਅੰਧੁ ਅਗਿਆਨੀ, ਕਦੇ ਨ ਸੀਝੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.16,
      "end_time": 76.6,
      "transcript": "ਇਸੁ ਜੁਗ ਮਹਿ ਰਾਮ ਨਾਮਿ ਨਿਸਤਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 76.6,
      "end_time": 82.902,
      "transcript": "ਵਿਰਲਾ ਕੋ ਪਾਏ, ਗੁਰ ਸਬਦਿ ਵੀਚਾਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 82.902,
      "end_time": 89.009,
      "transcript": "ਆਪਿ ਤਰੈ, ਸਗਲੇ ਕੁਲ ਉਧਾਰਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 89.009,
      "end_time": 95.339,
      "transcript": "ਇਸੁ ਕਲਿਜੁਗ ਮਹਿ, ਕਰਮ ਧਰਮੁ ਨ ਕੋਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 95.339,
      "end_time": 101.924,
      "transcript": "ਕਲੀ ਕਾ ਜਨਮੁ, ਚੰਡਾਲ ਕੈ ਘਰਿ ਹੋਈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 101.924,
      "end_time": 108.866,
      "transcript": "ਨਾਨਕ ਨਾਮ ਬਿਨਾ ਕੋ ਮੁਕਤਿ ਨ ਹੋਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 114.517,
      "end_time": 122.28,
      "transcript": "ਨਾਨਕ ਨਾਮ ਬਿਨਾ ਕੋ ਮੁਕਤਿ ਨ ਹੋਈ"
    }
  ]
}

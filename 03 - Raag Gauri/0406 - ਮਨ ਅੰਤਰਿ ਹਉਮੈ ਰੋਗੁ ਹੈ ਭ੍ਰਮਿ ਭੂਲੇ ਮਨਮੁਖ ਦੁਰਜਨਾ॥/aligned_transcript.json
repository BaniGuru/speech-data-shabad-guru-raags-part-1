{
  "audio_file": "0224 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.345,
      "end_time": 4.845,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 5.96,
      "end_time": 13.495,
      "transcript": "ਮਨ ਅੰਤਰਿ ਹਉਮੈ ਰੋਗੁ ਹੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 13.8,
      "end_time": 20.675,
      "transcript": "ਭ੍ਰਮਿ ਭੂਲੇ ਮਨਮੁਖ ਦੁਰਜਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.575,
      "end_time": 29.27,
      "transcript": "ਨਾਨਕ ਰੋਗੁ ਗਵਾਇ ਮਿਲਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.27,
      "end_time": 40.949,
      "transcript": "ਸਤਿਗੁਰ ਸਾਧੂ ਸਜਨਾ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.56,
      "end_time": 55.805,
      "transcript": "ਮਨੁ ਤਨੁ ਰਤਾ ਰੰਗ ਸਿਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.175,
      "end_time": 62.015,
      "transcript": "ਗੁਰਮੁਖਿ ਹਰਿ ਗੁਣਤਾਸੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.751,
      "end_time": 71.125,
      "transcript": "ਜਨ ਨਾਨਕ ਹਰਿ ਸਰਣਾਗਤੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.52,
      "end_time": 82.825,
      "transcript": "ਹਰਿ ਮੇਲੇ ਗੁਰ ਸਾਬਾਸਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 86.996,
      "end_time": 95.45,
      "transcript": "ਤੂ ਕਰਤਾ ਪੁਰਖੁ ਅਗੰਮੁ ਹੈ, ਕਿਸੁ ਨਾਲਿ ਤੂ ਵੜੀਐ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.45,
      "end_time": 103.88,
      "transcript": "ਤੁਧੁ ਜੇਵਡੁ ਹੋਇ ਸੁ ਆਖੀਐ, ਤੁਧੁ ਜੇਹਾ ਤੂਹੈ ਪੜੀਐ"
    },
    {
      "section_id": "section-00012",
      "start_time": 103.88,
      "end_time": 111.935,
      "transcript": "ਤੂ ਘਟਿ ਘਟਿ ਇਕੁ ਵਰਤਦਾ, ਗੁਰਮੁਖਿ ਪਰਗੜੀਐ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.48,
      "end_time": 120.425,
      "transcript": "ਤੂ ਸਚਾ ਸਭਸ ਦਾ ਖਸਮੁ ਹੈ, ਸਭ ਦੂ ਤੂ ਚੜੀਐ"
    },
    {
      "section_id": "section-00014",
      "start_time": 120.72,
      "end_time": 130.18,
      "transcript": "ਤੂ ਕਰਹਿ ਸੁ ਸਚੇ ਹੋਇਸੀ, ਤਾ ਕਾਇਤੁ ਕੜੀਐ"
    }
  ]
}

      "start_time": 0.115,
      "end_time": 6.683,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.72,
      "end_time": 20.104,
      "transcript": "ਥਾਕੇ ਬਹੁ ਬਿਧਿ ਘਾਲਤੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.104,
      "end_time": 26.275,
      "transcript": "ਤ੍ਰਿਪਤਿ ਨ ਤ੍ਰਿਸਨਾ ਲਾਥ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.595,
      "end_time": 33.13,
      "transcript": "ਸੰਚਿ ਸੰਚਿ ਸਾਕਤ ਮੂਏ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.13,
      "end_time": 43.175,
      "transcript": "ਨਾਨਕ ਮਾਇਆ ਨ ਸਾਥ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.862,
      "end_time": 60.085,
      "transcript": "ਥਥਾ ਥਿਰੁ ਕੋਊ ਨਹੀ, ਕਾਇ ਪਸਾਰਹੁ ਪਾਵ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.52,
      "end_time": 68.79,
      "transcript": "ਅਨਿਕ ਬੰਚ ਬਲ ਛਲ ਕਰਹੁ, ਮਾਇਆ ਏਕ ਉਪਾਵ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.79,
      "end_time": 77.015,
      "transcript": "ਥੈਲੀ ਸੰਚਹੁ ਸ੍ਰਮੁ ਕਰਹੁ, ਥਾਕਿ ਪਰਹੁ ਗਾਵਾਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 77.015,
      "end_time": 85.245,
      "transcript": "ਮਨ ਕੈ ਕਾਮਿ ਨ ਆਵਈ, ਅੰਤੇ ਅਉਸਰ ਬਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 85.68,
      "end_time": 93.695,
      "transcript": "ਥਿਤਿ ਪਾਵਹੁ ਗੋਬਿਦ ਭਜਹੁ, ਸੰਤਹ ਕੀ ਸਿਖ ਲੇਹੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.08,
      "end_time": 102.165,
      "transcript": "ਪ੍ਰੀਤਿ ਕਰਹੁ ਸਦ ਏਕ ਸਿਉ, ਇਆ ਸਾਚਾ ਅਸਨੇਹੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 102.48,
      "end_time": 110.642,
      "transcript": "ਕਾਰਨ ਕਰਨ ਕਰਾਵਨੋ, ਸਭ ਬਿਧਿ ਏਕੈ ਹਾਥ"
    },
    {
      "section_id": "section-00013",
      "start_time": 110.642,
      "end_time": 119.118,
      "transcript": "ਜਿਤੁ ਜਿਤੁ ਲਾਵਹੁ ਤਿਤੁ ਤਿਤੁ ਲਗਹਿ, ਨਾਨਕ ਜੰਤ ਅਨਾਥ"
    },
    {
      "section_id": "section-00014",
      "start_time": 119.118,
      "end_time": 129.589,
      "transcript": "ਜਿਤੁ ਜਿਤੁ ਲਾਵਹੁ ਤਿਤੁ ਤਿਤੁ ਲਗਹਿ, ਨਾਨਕ ਜੰਤ ਅਨਾਥ"
    }
  ]
}

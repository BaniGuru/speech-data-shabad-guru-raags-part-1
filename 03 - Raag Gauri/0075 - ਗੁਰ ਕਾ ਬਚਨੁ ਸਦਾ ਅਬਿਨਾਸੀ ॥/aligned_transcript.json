  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.805,
      "end_time": 8.198,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.86,
      "end_time": 23.387,
      "transcript": "ਗੁਰ ਕਾ ਬਚਨੁ, ਸਦਾ ਅਬਿਨਾਸੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.387,
      "end_time": 30.918,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਕਟੀ ਜਮ ਫਾਸੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.918,
      "end_time": 38.8,
      "transcript": "ਗੁਰ ਕਾ ਬਚਨੁ, ਜੀਅ ਕੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.8,
      "end_time": 45.981,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਰਚੈ ਰਾਮ ਕੈ ਰੰਗਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.981,
      "end_time": 54.08,
      "transcript": "ਜੋ ਗੁਰਿ ਦੀਆ, ਸੁ ਮਨ ਕੈ ਕਾਮਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.08,
      "end_time": 65.554,
      "transcript": "ਸੰਤ ਕਾ ਕੀਆ ਸਤਿ ਕਰਿ ਮਾਨਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.8,
      "end_time": 84.48,
      "transcript": "ਗੁਰ ਕਾ ਬਚਨੁ, ਅਟਲ ਅਛੇਦ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.48,
      "end_time": 91.615,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਕਟੇ ਭ੍ਰਮ ਭੇਦ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.615,
      "end_time": 99.72,
      "transcript": "ਗੁਰ ਕਾ ਬਚਨੁ, ਕਤਹੁ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 99.72,
      "end_time": 106.881,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਹਰਿ ਕੇ ਗੁਣ ਗਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.881,
      "end_time": 114.96,
      "transcript": "ਗੁਰ ਕਾ ਬਚਨੁ, ਜੀਅ ਕੈ ਸਾਥ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.96,
      "end_time": 122.474,
      "transcript": "ਗੁਰ ਕਾ ਬਚਨੁ, ਅਨਾਥ ਕੋ ਨਾਥ"
    },
    {
      "section_id": "section-00014",
      "start_time": 122.474,
      "end_time": 130.2,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਨਰਕਿ ਨ ਪਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 130.2,
      "end_time": 137.59,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ ਰਸਨਾ ਅੰਮ੍ਰਿਤੁ ਰਵੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 137.8,
      "end_time": 145.48,
      "transcript": "ਗੁਰ ਕਾ ਬਚਨੁ, ਪਰਗਟੁ ਸੰਸਾਰਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 145.48,
      "end_time": 152.643,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਨ ਆਵੈ ਹਾਰਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 152.643,
      "end_time": 160.524,
      "transcript": "ਜਿਸੁ ਜਨ ਹੋਏ, ਆਪਿ ਕ੍ਰਿਪਾਲ"
    },
    {
      "section_id": "section-00019",
      "start_time": 160.524,
      "end_time": 168.153,
      "transcript": "ਨਾਨਕ ਸਤਿਗੁਰ ਸਦਾ ਦਇਆਲ"
    },
    {

{
  "audio_file": "0221 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 2.307,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.76,
      "end_time": 19.318,
      "transcript": "ਤੀਨਿ ਬਿਆਪਹਿ ਜਗਤ ਕਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.318,
      "end_time": 27.006,
      "transcript": "ਤੁਰੀਆ ਪਾਵੈ ਕੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.006,
      "end_time": 34.895,
      "transcript": "ਨਾਨਕ ਸੰਤ ਨਿਰਮਲ ਭਏ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.075,
      "end_time": 46.785,
      "transcript": "ਜਿਨ ਮਨਿ ਵਸਿਆ ਸੋਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.12,
      "end_time": 59.365,
      "transcript": "ਤ੍ਰਿਤੀਆ ਤ੍ਰੈ ਗੁਣ ਬਿਖੈ ਫਲ, ਕਬ ਉਤਮ ਕਬ ਨੀਚੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.365,
      "end_time": 67.92,
      "transcript": "ਨਰਕ ਸੁਰਗ ਭ੍ਰਮਤਉ ਘਣੋ, ਸਦਾ ਸੰਘਾਰੈ ਮੀਚੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.92,
      "end_time": 76.025,
      "transcript": "ਹਰਖ ਸੋਗ ਸਹਸਾ ਸੰਸਾਰੁ, ਹਉ ਹਉ ਕਰਤ ਬਿਹਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.025,
      "end_time": 84.624,
      "transcript": "ਜਿਨਿ ਕੀਏ ਤਿਸਹਿ ਨ ਜਾਣਨੀ, ਚਿਤਵਹਿ ਅਨਿਕ ਉਪਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.624,
      "end_time": 92.667,
      "transcript": "ਆਧਿ ਬਿਆਧਿ ਉਪਾਧਿ ਰਸ, ਕਬਹੁ ਨ ਤੂਟੈ ਤਾਪ"
    },
    {
      "section_id": "section-00011",
      "start_time": 92.667,
      "end_time": 100.725,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਪੂਰਨ ਧਨੀ, ਨਹ ਬੂਝੈ ਪਰਤਾਪ"
    },
    {
      "section_id": "section-00012",
      "start_time": 100.865,
      "end_time": 108.855,
      "transcript": "ਮੋਹ ਭਰਮ ਬੂਡਤ ਘਣੋ, ਮਹਾ ਨਰਕ ਮਹਿ ਵਾਸ"
    },
    {
      "section_id": "section-00013",
      "start_time": 109.16,
      "end_time": 118.245,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਰਾਖਿ ਲੇਹੁ, ਨਾਨਕ ਤੇਰੀ ਆਸ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.64,
      "end_time": 17.475,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 29.0,
      "end_time": 37.734,
      "transcript": "ਤਉ ਕਿਰਪਾ ਤੇ, ਮਾਰਗੁ ਪਾਈਐ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.734,
      "end_time": 46.88,
      "transcript": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ, ਨਾਮੁ ਧਿਆਈਐ"
    },
    {
      "section_id": "section-00004",
      "start_time": 46.88,
      "end_time": 55.72,
      "transcript": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ, ਬੰਧਨ ਛੁਟੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 55.72,
      "end_time": 64.355,
      "transcript": "ਤਉ ਕਿਰਪਾ ਤੇ, ਹਉਮੈ ਤੁਟੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 64.355,
      "end_time": 73.004,
      "transcript": "ਤੁਮ ਲਾਵਹੁ ਤਉ ਲਾਗਹ ਸੇਵ"
    },
    {
      "section_id": "section-00007",
      "start_time": 73.004,
      "end_time": 86.478,
      "transcript": "ਹਮ ਤੇ ਕਛੂ ਨ ਹੋਵੈ ਦੇਵ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 95.2,
      "end_time": 103.96,
      "transcript": "ਤੁਧੁ ਭਾਵੈ ਤਾ ਗਾਵਾ ਬਾਣੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 103.96,
      "end_time": 112.6,
      "transcript": "ਤੁਧੁ ਭਾਵੈ ਤਾ ਸਚੁ ਵਖਾਣੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 112.6,
      "end_time": 121.2,
      "transcript": "ਤੁਧੁ ਭਾਵੈ ਤਾ ਸਤਿਗੁਰ ਮਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 121.2,
      "end_time": 129.606,
      "transcript": "ਸਰਬ ਸੁਖਾ ਪ੍ਰਭ ਤੇਰੀ ਦਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 129.606,
      "end_time": 138.198,
      "transcript": "ਜੋ ਤੁਧੁ ਭਾਵੈ, ਸੋ ਨਿਰਮਲ ਕਰਮਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 138.198,
      "end_time": 147.0,
      "transcript": "ਜੋ ਤੁਧੁ ਭਾਵੈ, ਸੋ ਸਚੁ ਧਰਮਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 147.0,
      "end_time": 155.56,
      "transcript": "ਸਰਬ ਨਿਧਾਨ ਗੁਣ, ਤੁਮ ਹੀ ਪਾਸਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 155.56,
      "end_time": 164.08,
      "transcript": "ਤੂੰ ਸਾਹਿਬੁ, ਸੇਵਕ ਅਰਦਾਸਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 164.08,
      "end_time": 172.68,
      "transcript": "ਮਨੁ ਤਨੁ ਨਿਰਮਲੁ ਹੋਇ ਹਰਿ ਰੰਗਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 172.68,
      "end_time": 181.074,
      "transcript": "ਸਰਬ ਸੁਖਾ, ਪਾਵਉ ਸਤਸੰਗਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 181.074,
      "end_time": 189.452,
      "transcript": "ਨਾਮਿ ਤੇਰੈ, ਰਹੈ ਮਨੁ ਰਾਤਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 189.452,
      "end_time": 197.552,
      "transcript": "ਇਹੁ ਕਲਿਆਣੁ, ਨਾਨਕ ਕਰਿ ਜਾਤਾ"
    }
  ]
}

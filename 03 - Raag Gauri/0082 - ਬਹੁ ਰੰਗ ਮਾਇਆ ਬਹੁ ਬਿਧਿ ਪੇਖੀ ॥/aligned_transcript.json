{
  "audio_file": "0135 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.119,
      "end_time": 7.887,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.809,
      "end_time": 22.075,
      "transcript": "ਬਹੁ ਰੰਗ ਮਾਇਆ, ਬਹੁ ਬਿਧਿ ਪੇਖੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.075,
      "end_time": 29.36,
      "transcript": "ਕਲਮ ਕਾਗਦ, ਸਿਆਨਪ ਲੇਖੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.36,
      "end_time": 36.779,
      "transcript": "ਮਹਰ ਮਲੂਕ ਹੋਇ ਦੇਖਿਆ ਖਾਨ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.779,
      "end_time": 44.13,
      "transcript": "ਤਾ ਤੇ ਨਾਹੀ ਮਨੁ ਤ੍ਰਿਪਤਾਨ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.13,
      "end_time": 51.6,
      "transcript": "ਸੋ ਸੁਖੁ ਮੋ ਕਉ, ਸੰਤ ਬਤਾਵਹੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.6,
      "end_time": 63.092,
      "transcript": "ਤ੍ਰਿਸਨਾ ਬੂਝੈ ਮਨੁ ਤ੍ਰਿਪਤਾਵਹੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.04,
      "end_time": 77.32,
      "transcript": "ਅਸੁ ਪਵਨ ਹਸਤਿ ਅਸਵਾਰੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 77.32,
      "end_time": 84.476,
      "transcript": "ਚੋਆ ਚੰਦਨੁ, ਸੇਜ ਸੁੰਦਰਿ ਨਾਰੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.476,
      "end_time": 91.68,
      "transcript": "ਨਟ ਨਾਟਿਕ, ਆਖਾਰੇ ਗਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.84,
      "end_time": 98.48,
      "transcript": "ਤਾ ਮਹਿ ਮਨਿ ਸੰਤੋਖੁ ਨ ਪਾਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.08,
      "end_time": 106.24,
      "transcript": "ਤਖਤੁ ਸਭਾ, ਮੰਡਨ ਦੋਲੀਚੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 106.24,
      "end_time": 113.316,
      "transcript": "ਸਗਲ ਮੇਵੇ, ਸੁੰਦਰ ਬਾਗੀਚੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 113.316,
      "end_time": 120.592,
      "transcript": "ਆਖੇੜ ਬਿਰਤਿ, ਰਾਜਨ ਕੀ ਲੀਲਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 120.592,
      "end_time": 127.7,
      "transcript": "ਮਨੁ ਨ ਸੁਹੇਲਾ, ਪਰਪੰਚੁ ਹੀਲਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 128.24,
      "end_time": 135.28,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਸੰਤਨ ਸਚੁ ਕਹਿਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 135.28,
      "end_time": 142.219,
      "transcript": "ਸਰਬ ਸੂਖ, ਇਹੁ ਆਨੰਦੁ ਲਹਿਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 142.714,
      "end_time": 149.86,
      "transcript": "ਸਾਧਸੰਗਿ, ਹਰਿ ਕੀਰਤਨੁ ਗਾਈਐ"
    },
    {
      "section_id": "section-00019",
      "start_time": 149.86,
      "end_time": 156.66,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਵਡਭਾਗੀ ਪਾਈਐ"
    },
    {
      "section_id": "section-00020",
      "start_time": 157.082,
      "end_time": 164.173,
      "transcript": "ਜਾ ਕੈ ਹਰਿ ਧਨੁ, ਸੋਈ ਸੁਹੇਲਾ"
    },
    {
      "section_id": "section-00021",
      "start_time": 164.173,
      "end_time": 174.791,
      "transcript": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਸਾਧਸੰਗਿ ਮੇਲਾ ਰਹਾਉ ਦੂਜਾ"
    }
  ]
}

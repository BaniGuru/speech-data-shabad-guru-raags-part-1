{
  "audio_file": "0196 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.2,
      "end_time": 9.073,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.56,
      "end_time": 23.775,
      "transcript": "ਸਤਿ ਕਹਉ ਸੁਨਿ ਮਨ ਮੇਰੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.775,
      "end_time": 30.495,
      "transcript": "ਸਰਨਿ ਪਰਹੁ ਹਰਿ ਰਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.92,
      "end_time": 37.47,
      "transcript": "ਉਕਤਿ ਸਿਆਨਪ ਸਗਲ ਤਿਆਗਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.47,
      "end_time": 44.435,
      "transcript": "ਨਾਨਕ ਲਏ ਸਮਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.76,
      "end_time": 48.854,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.945,
      "end_time": 62.52,
      "transcript": "ਸਸਾ, ਸਿਆਨਪ ਛਾਡੁ ਇਆਨਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.52,
      "end_time": 66.92,
      "transcript": "ਹਿਕਮਤਿ ਹੁਕਮਿ, ਨ ਪ੍ਰਭੁ ਪਤੀਆਨਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.92,
      "end_time": 71.205,
      "transcript": "ਸਹਸ ਭਾਤਿ, ਕਰਹਿ ਚਤੁਰਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.205,
      "end_time": 75.615,
      "transcript": "ਸੰਗਿ ਤੁਹਾਰੈ, ਏਕ ਨ ਜਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 75.615,
      "end_time": 79.8,
      "transcript": "ਸੋਊ ਸੋਊ ਜਪਿ, ਦਿਨ ਰਾਤੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 79.8,
      "end_time": 84.555,
      "transcript": "ਰੇ ਜੀਅ, ਚਲੈ ਤੁਹਾਰੈ ਸਾਥੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 84.555,
      "end_time": 88.895,
      "transcript": "ਸਾਧ ਸੇਵਾ, ਲਾਵੈ ਜਿਹ ਆਪੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 88.895,
      "end_time": 94.58,
      "transcript": "ਨਾਨਕ ਤਾ ਕਉ, ਦੂਖੁ ਨ ਬਿਆਪੈ"
    }
  ]
}

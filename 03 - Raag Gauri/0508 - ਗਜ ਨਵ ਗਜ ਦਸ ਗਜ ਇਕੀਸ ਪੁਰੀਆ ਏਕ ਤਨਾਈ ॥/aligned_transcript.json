  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.185,
      "end_time": 3.528,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.195,
      "end_time": 18.4,
      "transcript": "ਗਜ ਨਵ ਗਜ ਦਸ ਗਜ ਇਕੀਸ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.4,
      "end_time": 24.105,
      "transcript": "ਪੁਰੀਆ ਏਕ ਤਨਾਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.64,
      "end_time": 30.76,
      "transcript": "ਸਾਠ ਸੂਤ ਨਵ ਖੰਡ ਬਹਤਰਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.76,
      "end_time": 36.215,
      "transcript": "ਪਾਟੁ ਲਗੋ ਅਧਿਕਾਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 36.84,
      "end_time": 42.605,
      "transcript": "ਗਈ ਬੁਨਾਵਨ, ਮਾਹੋ"
    },
    {
      "section_id": "section-00007",
      "start_time": 42.96,
      "end_time": 50.765,
      "transcript": "ਘਰ ਛੋਡਿਐ, ਜਾਇ ਜੁਲਾਹੋ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.96,
      "end_time": 63.803,
      "transcript": "ਗਜੀ ਨ ਮਿਨੀਐ ਤੋਲਿ ਨ ਤੁਲੀਐ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.803,
      "end_time": 69.605,
      "transcript": "ਪਾਚਨੁ ਸੇਰ ਅਢਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.015,
      "end_time": 76.08,
      "transcript": "ਜੌ ਕਰਿ ਪਾਚਨੁ ਬੇਗਿ ਨ ਪਾਵੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 76.08,
      "end_time": 81.775,
      "transcript": "ਝਗਰੁ ਕਰੈ ਘਰਹਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 82.2,
      "end_time": 88.2,
      "transcript": "ਦਿਨ ਕੀ ਬੈਠ ਖਸਮ ਕੀ ਬਰਕਸ"
    },
    {
      "section_id": "section-00013",
      "start_time": 88.2,
      "end_time": 94.068,
      "transcript": "ਇਹ ਬੇਲਾ ਕਤ ਆਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 94.068,
      "end_time": 100.27,
      "transcript": "ਛੂਟੇ ਕੂੰਡੇ ਭੀਗੈ ਪੁਰੀਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 100.27,
      "end_time": 105.975,
      "transcript": "ਚਲਿਓ ਜੁਲਾਹੋ ਰੀਸਾਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 106.4,
      "end_time": 112.52,
      "transcript": "ਛੋਛੀ ਨਲੀ ਤੰਤੁ ਨਹੀ ਨਿਕਸੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 112.52,
      "end_time": 118.585,
      "transcript": "ਨਤਰ ਰਹੀ ਉਰਝਾਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 118.72,
      "end_time": 124.88,
      "transcript": "ਛੋਡਿ ਪਸਾਰੁ ਈਹਾ ਰਹੁ ਬਪੁਰੀ"
    },
    {
      "section_id": "section-00019",
      "start_time": 124.88,
      "end_time": 130.045,
      "transcript": "ਕਹੁ ਕਬੀਰ ਸਮਝਾਈ"
    }
  ]
}

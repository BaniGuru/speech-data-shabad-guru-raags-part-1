{
  "audio_file": "0214 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 6.345,
      "end_time": 13.275,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 23.8,
      "end_time": 30.465,
      "transcript": "ਸਤਿ ਪੁਰਖੁ ਜਿਨਿ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 30.88,
      "end_time": 37.475,
      "transcript": "ਸਤਿਗੁਰੁ ਤਿਸ ਕਾ ਨਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 37.84,
      "end_time": 44.265,
      "transcript": "ਤਿਸ ਕੈ ਸੰਗਿ ਸਿਖੁ ਉਧਰੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.605,
      "end_time": 55.155,
      "transcript": "ਨਾਨਕ ਹਰਿ ਗੁਨ ਗਾਉ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 63.96,
      "end_time": 70.805,
      "transcript": "ਸਤਿਗੁਰੁ ਸਿਖ ਕੀ, ਕਰੈ ਪ੍ਰਤਿਪਾਲ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.805,
      "end_time": 77.68,
      "transcript": "ਸੇਵਕ ਕਉ, ਗੁਰੁ ਸਦਾ ਦਇਆਲ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.68,
      "end_time": 84.095,
      "transcript": "ਸਿਖ ਕੀ ਗੁਰੁ, ਦੁਰਮਤਿ ਮਲੁ ਹਿਰੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.405,
      "end_time": 91.16,
      "transcript": "ਗੁਰ ਬਚਨੀ, ਹਰਿ ਨਾਮੁ ਉਚਰੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.16,
      "end_time": 97.765,
      "transcript": "ਸਤਿਗੁਰੁ ਸਿਖ ਕੇ, ਬੰਧਨ ਕਾਟੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.765,
      "end_time": 104.52,
      "transcript": "ਗੁਰ ਕਾ ਸਿਖੁ, ਬਿਕਾਰ ਤੇ ਹਾਟੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 104.52,
      "end_time": 111.08,
      "transcript": "ਸਤਿਗੁਰੁ ਸਿਖ ਕਉ, ਨਾਮ ਧਨੁ ਦੇਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 111.08,
      "end_time": 117.615,
      "transcript": "ਗੁਰ ਕਾ ਸਿਖੁ, ਵਡਭਾਗੀ ਹੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 117.96,
      "end_time": 124.365,
      "transcript": "ਸਤਿਗੁਰੁ ਸਿਖ ਕਾ, ਹਲਤੁ ਪਲਤੁ ਸਵਾਰੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 124.365,
      "end_time": 131.195,
      "transcript": "ਨਾਨਕ ਸਤਿਗੁਰੁ ਸਿਖ ਕਉ, ਜੀਅ ਨਾਲਿ ਸਮਾਰੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 137.92,
      "end_time": 144.56,
      "transcript": "ਗੁਰ ਕੈ ਗ੍ਰਿਹਿ, ਸੇਵਕੁ ਜੋ ਰਹੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 144.56,
      "end_time": 151.105,
      "transcript": "ਗੁਰ ਕੀ ਆਗਿਆ, ਮਨ ਮਹਿ ਸਹੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 151.105,
      "end_time": 157.59,
      "transcript": "ਆਪਸ ਕਉ, ਕਰਿ ਕਛੁ ਨ ਜਨਾਵੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 157.59,
      "end_time": 164.118,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਰਿਦੈ ਸਦ ਧਿਆਵੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 164.118,
      "end_time": 170.955,
      "transcript": "ਮਨੁ ਬੇਚੈ, ਸਤਿਗੁਰ ਕੈ ਪਾਸਿ"
    },
    {
      "section_id": "section-00021",
      "start_time": 170.955,
      "end_time": 177.515,
      "transcript": "ਤਿਸੁ ਸੇਵਕ ਕੇ, ਕਾਰਜ ਰਾਸਿ"
    },
    {
      "section_id": "section-00022",
      "start_time": 177.515,
      "end_time": 184.28,
      "transcript": "ਸੇਵਾ ਕਰਤ, ਹੋਇ ਨਿਹਕਾਮੀ"
    },
    {
      "section_id": "section-00023",
      "start_time": 184.28,
      "end_time": 190.855,
      "transcript": "ਤਿਸ ਕਉ, ਹੋਤ ਪਰਾਪਤਿ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 190.855,
      "end_time": 197.405,
      "transcript": "ਅਪਨੀ ਕ੍ਰਿਪਾ, ਜਿਸੁ ਆਪਿ ਕਰੇਇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 197.405,
      "end_time": 204.364,
      "transcript": "ਨਾਨਕ ਸੋ ਸੇਵਕੁ, ਗੁਰ ਕੀ ਮਤਿ ਲੇਇ"
    },
    {
      "section_id": "section-00026",
      "start_time": 210.718,
      "end_time": 217.6,
      "transcript": "ਬੀਸ ਬਿਸਵੇ, ਗੁਰ ਕਾ ਮਨੁ ਮਾਨੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 217.6,
      "end_time": 224.185,
      "transcript": "ਸੋ ਸੇਵਕੁ, ਪਰਮੇਸੁਰ ਕੀ ਗਤਿ ਜਾਨੈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 224.185,
      "end_time": 230.84,
      "transcript": "ਸੋ ਸਤਿਗੁਰੁ, ਜਿਸੁ ਰਿਦੈ ਹਰਿ ਨਾਉ"
    },
    {
      "section_id": "section-00029",
      "start_time": 230.84,
      "end_time": 237.44,
      "transcript": "ਅਨਿਕ ਬਾਰ, ਗੁਰ ਕਉ ਬਲਿ ਜਾਉ"
    },
    {
      "section_id": "section-00030",
      "start_time": 237.44,
      "end_time": 244.05,
      "transcript": "ਸਰਬ ਨਿਧਾਨ, ਜੀਅ ਕਾ ਦਾਤਾ"
    },
    {
      "section_id": "section-00031",
      "start_time": 244.05,
      "end_time": 250.445,
      "transcript": "ਆਠ ਪਹਰ, ਪਾਰਬ੍ਰਹਮ ਰੰਗਿ ਰਾਤਾ"
    },
    {
      "section_id": "section-00032",
      "start_time": 250.445,
      "end_time": 257.165,
      "transcript": "ਬ੍ਰਹਮ ਮਹਿ ਜਨੁ, ਜਨ ਮਹਿ ਪਾਰਬ੍ਰਹਮੁ"
    },
    {
      "section_id": "section-00033",
      "start_time": 257.165,
      "end_time": 263.575,
      "transcript": "ਏਕਹਿ ਆਪਿ, ਨਹੀ ਕਛੁ ਭਰਮੁ"
    },
    {
      "section_id": "section-00034",
      "start_time": 263.575,
      "end_time": 270.165,
      "transcript": "ਸਹਸ ਸਿਆਨਪ, ਲਇਆ ਨ ਜਾਈਐ"
    },
    {
      "section_id": "section-00035",
      "start_time": 270.165,
      "end_time": 276.855,
      "transcript": "ਨਾਨਕ ਐਸਾ ਗੁਰੁ, ਬਡਭਾਗੀ ਪਾਈਐ"
    },
    {
      "section_id": "section-00036",
      "start_time": 283.395,
      "end_time": 290.04,
      "transcript": "ਸਫਲ ਦਰਸਨੁ, ਪੇਖਤ ਪੁਨੀਤ"
    },
    {
      "section_id": "section-00037",
      "start_time": 290.04,
      "end_time": 296.65,
      "transcript": "ਪਰਸਤ ਚਰਨ ਗਤਿ, ਨਿਰਮਲ ਰੀਤਿ"
    },
    {
      "section_id": "section-00038",
      "start_time": 296.65,
      "end_time": 302.855,
      "transcript": "ਭੇਟਤ ਸੰਗਿ, ਰਾਮ ਗੁਨ ਰਵੇ"
    },
    {
      "section_id": "section-00039",
      "start_time": 303.215,
      "end_time": 309.415,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਕੀ ਦਰਗਹ ਗਵੇ"
    },
    {
      "section_id": "section-00040",
      "start_time": 309.76,
      "end_time": 316.205,
      "transcript": "ਸੁਨਿ ਕਰਿ ਬਚਨ, ਕਰਨ ਆਘਾਨੇ"
    },
    {
      "section_id": "section-00041",
      "start_time": 316.205,
      "end_time": 322.785,
      "transcript": "ਮਨਿ ਸੰਤੋਖੁ, ਆਤਮ ਪਤੀਆਨੇ"
    },
    {
      "section_id": "section-00042",
      "start_time": 322.785,
      "end_time": 329.315,
      "transcript": "ਪੂਰਾ ਗੁਰੁ, ਅਖੵਓ ਜਾ ਕਾ ਮੰਤ੍ਰ"
    },
    {
      "section_id": "section-00043",
      "start_time": 329.315,
      "end_time": 335.825,
      "transcript": "ਅੰਮ੍ਰਿਤ ਦ੍ਰਿਸਟਿ ਪੇਖੈ, ਹੋਇ ਸੰਤ"
    },
    {
      "section_id": "section-00044",
      "start_time": 335.825,
      "end_time": 342.255,
      "transcript": "ਗੁਣ ਬਿਅੰਤ, ਕੀਮਤਿ ਨਹੀ ਪਾਇ"
    },
    {
      "section_id": "section-00045",
      "start_time": 342.255,
      "end_time": 348.985,
      "transcript": "ਨਾਨਕ ਜਿਸੁ ਭਾਵੈ, ਤਿਸੁ ਲਏ ਮਿਲਾਇ"
    },
    {
      "section_id": "section-00046",
      "start_time": 355.525,
      "end_time": 362.2,
      "transcript": "ਜਿਹਬਾ ਏਕ, ਉਸਤਤਿ ਅਨੇਕ"
    },
    {
      "section_id": "section-00047",
      "start_time": 362.2,
      "end_time": 368.615,
      "transcript": "ਸਤਿ ਪੁਰਖ, ਪੂਰਨ ਬਿਬੇਕ"
    },
    {
      "section_id": "section-00048",
      "start_time": 368.615,
      "end_time": 375.2,
      "transcript": "ਕਾਹੂ ਬੋਲ, ਨ ਪਹੁਚਤ ਪ੍ਰਾਨੀ"
    },
    {
      "section_id": "section-00049",
      "start_time": 375.2,
      "end_time": 381.535,
      "transcript": "ਅਗਮ ਅਗੋਚਰ, ਪ੍ਰਭ ਨਿਰਬਾਨੀ"
    },
    {
      "section_id": "section-00050",
      "start_time": 381.535,
      "end_time": 388.245,
      "transcript": "ਨਿਰਾਹਾਰ ਨਿਰਵੈਰ ਸੁਖਦਾਈ"
    },
    {
      "section_id": "section-00051",
      "start_time": 388.245,
      "end_time": 394.83,
      "transcript": "ਤਾ ਕੀ ਕੀਮਤਿ, ਕਿਨੈ ਨ ਪਾਈ"
    },
    {
      "section_id": "section-00052",
      "start_time": 394.83,
      "end_time": 401.36,
      "transcript": "ਅਨਿਕ ਭਗਤ, ਬੰਦਨ ਨਿਤ ਕਰਹਿ"
    },
    {
      "section_id": "section-00053",
      "start_time": 401.36,
      "end_time": 407.905,
      "transcript": "ਚਰਨ ਕਮਲ, ਹਿਰਦੈ ਸਿਮਰਹਿ"
    },
    {
      "section_id": "section-00054",
      "start_time": 407.905,
      "end_time": 414.239,
      "transcript": "ਸਦ ਬਲਿਹਾਰੀ, ਸਤਿਗੁਰ ਅਪਨੇ"
    },
    {
      "section_id": "section-00055",
      "start_time": 414.239,
      "end_time": 420.985,
      "transcript": "ਨਾਨਕ ਜਿਸੁ ਪ੍ਰਸਾਦਿ, ਐਸਾ ਪ੍ਰਭੁ ਜਪਨੇ"
    },
    {
      "section_id": "section-00056",
      "start_time": 427.56,
      "end_time": 434.07,
      "transcript": "ਇਹੁ ਹਰਿ ਰਸੁ, ਪਾਵੈ ਜਨੁ ਕੋਇ"
    },
    {
      "section_id": "section-00057",
      "start_time": 434.07,
      "end_time": 440.64,
      "transcript": "ਅੰਮ੍ਰਿਤੁ ਪੀਵੈ, ਅਮਰੁ ਸੋ ਹੋਇ"
    },
    {
      "section_id": "section-00058",
      "start_time": 440.64,
      "end_time": 446.984,
      "transcript": "ਉਸੁ ਪੁਰਖ ਕਾ, ਨਾਹੀ ਕਦੇ ਬਿਨਾਸ"
    },
    {
      "section_id": "section-00059",
      "start_time": 446.984,
      "end_time": 453.515,
      "transcript": "ਜਾ ਕੈ ਮਨਿ, ਪ੍ਰਗਟੇ ਗੁਨਤਾਸ"
    },
    {
      "section_id": "section-00060",
      "start_time": 453.515,
      "end_time": 460.015,
      "transcript": "ਆਠ ਪਹਰ, ਹਰਿ ਕਾ ਨਾਮੁ ਲੇਇ"
    },
    {
      "section_id": "section-00061",
      "start_time": 460.28,
      "end_time": 466.445,
      "transcript": "ਸਚੁ ਉਪਦੇਸੁ, ਸੇਵਕ ਕਉ ਦੇਇ"
    },
    {
      "section_id": "section-00062",
      "start_time": 466.8,
      "end_time": 473.44,
      "transcript": "ਮੋਹ ਮਾਇਆ ਕੈ ਸੰਗਿ, ਨ ਲੇਪੁ"
    },
    {
      "section_id": "section-00063",
      "start_time": 473.44,
      "end_time": 480.0,
      "transcript": "ਮਨ ਮਹਿ ਰਾਖੈ, ਹਰਿ ਹਰਿ ਏਕੁ"
    },
    {
      "section_id": "section-00064",
      "start_time": 480.0,
      "end_time": 486.43,
      "transcript": "ਅੰਧਕਾਰ, ਦੀਪਕ ਪਰਗਾਸੇ"
    },
    {
      "section_id": "section-00065",
      "start_time": 486.43,
      "end_time": 492.945,
      "transcript": "ਨਾਨਕ ਭਰਮ ਮੋਹ ਦੁਖ, ਤਹ ਤੇ ਨਾਸੇ"
    },
    {
      "section_id": "section-00066",
      "start_time": 499.6,
      "end_time": 506.08,
      "transcript": "ਤਪਤਿ ਮਾਹਿ, ਠਾਢਿ ਵਰਤਾਈ"
    },
    {
      "section_id": "section-00067",
      "start_time": 506.08,
      "end_time": 512.55,
      "transcript": "ਅਨਦੁ ਭਇਆ, ਦੁਖ ਨਾਠੇ ਭਾਈ"
    },
    {
      "section_id": "section-00068",
      "start_time": 512.55,
      "end_time": 519.36,
      "transcript": "ਜਨਮ ਮਰਨ ਕੇ, ਮਿਟੇ ਅੰਦੇਸੇ"
    },
    {
      "section_id": "section-00069",
      "start_time": 519.36,
      "end_time": 525.8,
      "transcript": "ਸਾਧੂ ਕੇ, ਪੂਰਨ ਉਪਦੇਸੇ"
    },
    {
      "section_id": "section-00070",
      "start_time": 525.8,
      "end_time": 532.135,
      "transcript": "ਭਉ ਚੂਕਾ, ਨਿਰਭਉ ਹੋਇ ਬਸੇ"
    },
    {
      "section_id": "section-00071",
      "start_time": 532.4,
      "end_time": 538.535,
      "transcript": "ਸਗਲ ਬਿਆਧਿ, ਮਨ ਤੇ ਖੈ ਨਸੇ"
    },
    {
      "section_id": "section-00072",
      "start_time": 538.815,
      "end_time": 545.255,
      "transcript": "ਜਿਸ ਕਾ ਸਾ, ਤਿਨਿ ਕਿਰਪਾ ਧਾਰੀ"
    },
    {
      "section_id": "section-00073",
      "start_time": 545.255,
      "end_time": 551.93,
      "transcript": "ਸਾਧਸੰਗਿ, ਜਪਿ ਨਾਮੁ ਮੁਰਾਰੀ"
    },
    {
      "section_id": "section-00074",
      "start_time": 551.93,
      "end_time": 558.29,
      "transcript": "ਥਿਤਿ ਪਾਈ, ਚੂਕੇ ਭ੍ਰਮ ਗਵਨ"
    },
    {
      "section_id": "section-00075",
      "start_time": 558.29,
      "end_time": 564.955,
      "transcript": "ਸੁਨਿ ਨਾਨਕ, ਹਰਿ ਹਰਿ ਜਸੁ ਸ੍ਰਵਨ"
    },
    {
      "section_id": "section-00076",
      "start_time": 571.525,
      "end_time": 578.12,
      "transcript": "ਨਿਰਗੁਨੁ ਆਪਿ, ਸਰਗੁਨੁ ਭੀ ਓਹੀ"
    },
    {
      "section_id": "section-00077",
      "start_time": 578.12,
      "end_time": 584.4,
      "transcript": "ਕਲਾ ਧਾਰਿ ਜਿਨਿ, ਸਗਲੀ ਮੋਹੀ"
    },
    {
      "section_id": "section-00078",
      "start_time": 584.4,
      "end_time": 591.115,
      "transcript": "ਅਪਨੇ ਚਰਿਤ, ਪ੍ਰਭਿ ਆਪਿ ਬਨਾਏ"
    },
    {
      "section_id": "section-00079",
      "start_time": 591.115,
      "end_time": 597.72,
      "transcript": "ਅਪੁਨੀ ਕੀਮਤਿ, ਆਪੇ ਪਾਏ"
    },
    {
      "section_id": "section-00080",
      "start_time": 597.72,
      "end_time": 604.28,
      "transcript": "ਹਰਿ ਬਿਨੁ ਦੂਜਾ, ਨਾਹੀ ਕੋਇ"
    },
    {
      "section_id": "section-00081",
      "start_time": 604.28,
      "end_time": 610.92,
      "transcript": "ਸਰਬ ਨਿਰੰਤਰਿ, ਏਕੋ ਸੋਇ"
    },
    {
      "section_id": "section-00082",
      "start_time": 610.92,
      "end_time": 617.405,
      "transcript": "ਓਤਿ ਪੋਤਿ, ਰਵਿਆ ਰੂਪ ਰੰਗ"
    },
    {
      "section_id": "section-00083",
      "start_time": 617.405,
      "end_time": 623.755,
      "transcript": "ਭਏ ਪ੍ਰਗਾਸ, ਸਾਧ ਕੈ ਸੰਗ"
    },
    {
      "section_id": "section-00084",
      "start_time": 623.755,
      "end_time": 630.242,
      "transcript": "ਰਚਿ ਰਚਨਾ, ਅਪਨੀ ਕਲ ਧਾਰੀ"
    },

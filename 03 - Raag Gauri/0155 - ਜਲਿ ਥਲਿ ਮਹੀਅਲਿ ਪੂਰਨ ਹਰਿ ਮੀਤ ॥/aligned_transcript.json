{
  "audio_file": "0148 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.605,
      "end_time": 8.135,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.165,
      "end_time": 23.555,
      "transcript": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ, ਪੂਰਨ ਹਰਿ ਮੀਤ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.96,
      "end_time": 31.345,
      "transcript": "ਭ੍ਰਮ ਬਿਨਸੇ, ਗਾਏ ਗੁਣ ਨੀਤ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.8,
      "end_time": 39.385,
      "transcript": "ਊਠਤ ਸੋਵਤ, ਹਰਿ ਸੰਗਿ ਪਹਰੂਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.385,
      "end_time": 46.76,
      "transcript": "ਜਾ ਕੈ ਸਿਮਰਣਿ, ਜਮ ਨਹੀ ਡਰੂਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.771,
      "end_time": 66.535,
      "transcript": "ਚਰਣ ਕਮਲ ਪ੍ਰਭ, ਰਿਦੈ ਨਿਵਾਸੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.8,
      "end_time": 74.575,
      "transcript": "ਸਗਲ ਦੂਖ ਕਾ, ਹੋਇਆ ਨਾਸੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.575,
      "end_time": 82.015,
      "transcript": "ਆਸਾ ਮਾਣੁ ਤਾਣੁ, ਧਨੁ ਏਕ"
    },
    {
      "section_id": "section-00009",
      "start_time": 82.56,
      "end_time": 89.695,
      "transcript": "ਸਾਚੇ ਸਾਹ ਕੀ, ਮਨ ਮਹਿ ਟੇਕ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.195,
      "end_time": 97.695,
      "transcript": "ਮਹਾ ਗਰੀਬ, ਜਨ ਸਾਧ ਅਨਾਥ"
    },
    {
      "section_id": "section-00011",
      "start_time": 98.075,
      "end_time": 105.335,
      "transcript": "ਨਾਨਕ ਪ੍ਰਭਿ ਰਾਖੇ, ਦੇ ਹਾਥ"
    }
  ]
}

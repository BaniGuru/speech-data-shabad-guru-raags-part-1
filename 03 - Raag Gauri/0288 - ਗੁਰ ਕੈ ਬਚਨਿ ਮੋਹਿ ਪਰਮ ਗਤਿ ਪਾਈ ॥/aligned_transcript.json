{
  "audio_file": "0182 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.745,
      "end_time": 18.115,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 29.075,
      "end_time": 36.645,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਮੋਹਿ ਪਰਮ ਗਤਿ ਪਾਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.645,
      "end_time": 43.565,
      "transcript": "ਗੁਰਿ ਪੂਰੈ, ਮੇਰੀ ਪੈਜ ਰਖਾਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.12,
      "end_time": 51.275,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਧਿਆਇਓ ਮੋਹਿ ਨਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 51.635,
      "end_time": 59.236,
      "transcript": "ਗੁਰ ਪਰਸਾਦਿ, ਮੋਹਿ ਮਿਲਿਆ ਥਾਉ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 70.165,
      "end_time": 77.115,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਸੁਣਿ ਰਸਨ ਵਖਾਣੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 77.435,
      "end_time": 84.295,
      "transcript": "ਗੁਰ ਕਿਰਪਾ ਤੇ, ਅੰਮ੍ਰਿਤ ਮੇਰੀ ਬਾਣੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.705,
      "end_time": 91.815,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਮਿਟਿਆ ਮੇਰਾ ਆਪੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 91.815,
      "end_time": 99.125,
      "transcript": "ਗੁਰ ਕੀ ਦਇਆ ਤੇ, ਮੇਰਾ ਵਡ ਪਰਤਾਪੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 99.125,
      "end_time": 106.35,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਮਿਟਿਆ ਮੇਰਾ ਭਰਮੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 106.35,
      "end_time": 113.475,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਪੇਖਿਓ ਸਭੁ ਬ੍ਰਹਮੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 113.475,
      "end_time": 120.92,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਕੀਨੋ ਰਾਜੁ ਜੋਗੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 120.92,
      "end_time": 128.434,
      "transcript": "ਗੁਰ ਕੈ ਸੰਗਿ, ਤਰਿਆ ਸਭੁ ਲੋਗੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 135.4,
      "end_time": 142.345,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਮੇਰੇ ਕਾਰਜ ਸਿਧਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 142.605,
      "end_time": 149.375,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਪਾਇਆ ਨਾਉ ਨਿਧਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 149.88,
      "end_time": 157.155,
      "transcript": "ਜਿਨਿ ਜਿਨਿ ਕੀਨੀ, ਮੇਰੇ ਗੁਰ ਕੀ ਆਸਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 157.155,
      "end_time": 164.285,
      "transcript": "ਤਿਸ ਕੀ ਕਟੀਐ, ਜਮ ਕੀ ਫਾਸਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 164.285,
      "end_time": 171.565,
      "transcript": "ਗੁਰ ਕੈ ਬਚਨਿ, ਜਾਗਿਆ ਮੇਰਾ ਕਰਮੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 171.565,
      "end_time": 178.315,
      "transcript": "ਨਾਨਕ, ਗੁਰੁ ਭੇਟਿਆ ਪਾਰਬ੍ਰਹਮੁ"
    }
  ]
}

{
  "audio_file": "0218 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.715,
      "end_time": 8.455,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 19.095,
      "end_time": 27.215,
      "transcript": "ਜੀਅ ਜੰਤ ਕੇ ਠਾਕੁਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 27.795,
      "end_time": 35.595,
      "transcript": "ਆਪੇ ਵਰਤਣਹਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 36.125,
      "end_time": 43.855,
      "transcript": "ਨਾਨਕ ਏਕੋ ਪਸਰਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.315,
      "end_time": 55.315,
      "transcript": "ਦੂਜਾ ਕਹ ਦ੍ਰਿਸਟਾਰ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 66.975,
      "end_time": 75.895,
      "transcript": "ਆਪਿ ਕਥੈ, ਆਪਿ ਸੁਨਨੈਹਾਰੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.385,
      "end_time": 84.985,
      "transcript": "ਆਪਹਿ ਏਕੁ, ਆਪਿ ਬਿਸਥਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 85.365,
      "end_time": 93.955,
      "transcript": "ਜਾ ਤਿਸੁ ਭਾਵੈ, ਤਾ ਸ੍ਰਿਸਟਿ ਉਪਾਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 94.485,
      "end_time": 102.995,
      "transcript": "ਆਪਨੈ ਭਾਣੈ, ਲਏ ਸਮਾਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 103.36,
      "end_time": 111.675,
      "transcript": "ਤੁਮ ਤੇ ਭਿੰਨ, ਨਹੀ ਕਿਛੁ ਹੋਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 112.195,
      "end_time": 120.705,
      "transcript": "ਆਪਨ ਸੂਤਿ, ਸਭੁ ਜਗਤੁ ਪਰੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 120.705,
      "end_time": 129.205,
      "transcript": "ਜਾ ਕਉ ਪ੍ਰਭ ਜੀਉ, ਆਪਿ ਬੁਝਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 129.655,
      "end_time": 138.305,
      "transcript": "ਸਚੁ ਨਾਮੁ, ਸੋਈ ਜਨੁ ਪਾਏ"
    },
    {
      "section_id": "section-00014",
      "start_time": 138.625,
      "end_time": 146.955,
      "transcript": "ਸੋ ਸਮਦਰਸੀ, ਤਤ ਕਾ ਬੇਤਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 147.415,
      "end_time": 156.486,
      "transcript": "ਨਾਨਕ, ਸਗਲ ਸ੍ਰਿਸਟਿ ਕਾ ਜੇਤਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 165.155,
      "end_time": 173.785,
      "transcript": "ਜੀਅ ਜੰਤ੍ਰ ਸਭ, ਤਾ ਕੈ ਹਾਥ"
    },
    {
      "section_id": "section-00017",
      "start_time": 174.135,
      "end_time": 182.851,
      "transcript": "ਦੀਨ ਦਇਆਲ, ਅਨਾਥ ਕੋ ਨਾਥੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 182.851,
      "end_time": 191.555,
      "transcript": "ਜਿਸੁ ਰਾਖੈ, ਤਿਸੁ ਕੋਇ ਨ ਮਾਰੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 191.915,
      "end_time": 200.8,
      "transcript": "ਸੋ ਮੂਆ, ਜਿਸੁ ਮਨਹੁ ਬਿਸਾਰੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 200.8,
      "end_time": 209.27,
      "transcript": "ਤਿਸੁ ਤਜਿ, ਅਵਰ ਕਹਾ ਕੋ ਜਾਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 209.27,
      "end_time": 217.895,
      "transcript": "ਸਭ ਸਿਰਿ, ਏਕੁ ਨਿਰੰਜਨ ਰਾਇ"
    },
    {
      "section_id": "section-00022",
      "start_time": 218.345,
      "end_time": 227.04,
      "transcript": "ਜੀਅ ਕੀ ਜੁਗਤਿ, ਜਾ ਕੈ ਸਭ ਹਾਥਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 227.04,
      "end_time": 235.425,
      "transcript": "ਅੰਤਰਿ ਬਾਹਰਿ, ਜਾਨਹੁ ਸਾਥਿ"
    },
    {
      "section_id": "section-00024",
      "start_time": 235.795,
      "end_time": 243.995,
      "transcript": "ਗੁਨ ਨਿਧਾਨ, ਬੇਅੰਤ ਅਪਾਰ"
    },
    {
      "section_id": "section-00025",
      "start_time": 244.435,
      "end_time": 252.545,
      "transcript": "ਨਾਨਕ ਦਾਸ, ਸਦਾ ਬਲਿਹਾਰ"
    },
    {
      "section_id": "section-00026",
      "start_time": 261.995,
      "end_time": 270.325,
      "transcript": "ਪੂਰਨ ਪੂਰਿ ਰਹੇ, ਦਇਆਲ"
    },
    {
      "section_id": "section-00027",
      "start_time": 270.725,
      "end_time": 279.135,
      "transcript": "ਸਭ ਊਪਰਿ, ਹੋਵਤ ਕਿਰਪਾਲ"
    },
    {
      "section_id": "section-00028",
      "start_time": 279.475,
      "end_time": 288.185,
      "transcript": "ਅਪਨੇ ਕਰਤਬ, ਜਾਨੈ ਆਪਿ"
    },
    {
      "section_id": "section-00029",
      "start_time": 288.185,
      "end_time": 297.0,
      "transcript": "ਅੰਤਰਜਾਮੀ, ਰਹਿਓ ਬਿਆਪਿ"
    },
    {
      "section_id": "section-00030",
      "start_time": 297.0,
      "end_time": 305.135,
      "transcript": "ਪ੍ਰਤਿਪਾਲੈ, ਜੀਅਨ ਬਹੁ ਭਾਤਿ"
    },
    {
      "section_id": "section-00031",
      "start_time": 305.585,
      "end_time": 314.095,
      "transcript": "ਜੋ ਜੋ ਰਚਿਓ, ਸੁ ਤਿਸਹਿ ਧਿਆਤਿ"
    },
    {
      "section_id": "section-00032",
      "start_time": 314.305,
      "end_time": 322.643,
      "transcript": "ਜਿਸੁ ਭਾਵੈ, ਤਿਸੁ ਲਏ ਮਿਲਾਇ"
    },
    {
      "section_id": "section-00033",
      "start_time": 322.643,
      "end_time": 331.185,
      "transcript": "ਭਗਤਿ ਕਰਹਿ, ਹਰਿ ਕੇ ਗੁਣ ਗਾਇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 331.185,
      "end_time": 339.465,
      "transcript": "ਮਨ ਅੰਤਰਿ, ਬਿਸ੍ਵਾਸੁ ਕਰਿ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00035",
      "start_time": 339.805,
      "end_time": 348.465,
      "transcript": "ਕਰਨਹਾਰੁ, ਨਾਨਕ ਇਕੁ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00036",
      "start_time": 357.305,
      "end_time": 365.735,
      "transcript": "ਜਨੁ ਲਾਗਾ, ਹਰਿ ਏਕੈ ਨਾਇ"
    },
    {
      "section_id": "section-00037",
      "start_time": 366.16,
      "end_time": 374.455,
      "transcript": "ਤਿਸ ਕੀ ਆਸ, ਨ ਬਿਰਥੀ ਜਾਇ"
    },
    {
      "section_id": "section-00038",
      "start_time": 374.96,
      "end_time": 383.265,
      "transcript": "ਸੇਵਕ ਕਉ, ਸੇਵਾ ਬਨਿ ਆਈ"
    },
    {
      "section_id": "section-00039",
      "start_time": 383.655,
      "end_time": 391.975,
      "transcript": "ਹੁਕਮੁ ਬੂਝਿ, ਪਰਮ ਪਦੁ ਪਾਈ"
    },
    {
      "section_id": "section-00040",
      "start_time": 392.24,
      "end_time": 400.295,
      "transcript": "ਇਸ ਤੇ ਊਪਰਿ, ਨਹੀ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00041",
      "start_time": 400.825,
      "end_time": 409.33,
      "transcript": "ਜਾ ਕੈ ਮਨਿ ਬਸਿਆ ਨਿਰੰਕਾਰੁ"
    },
    {
      "section_id": "section-00042",
      "start_time": 409.33,
      "end_time": 417.405,
      "transcript": "ਬੰਧਨ ਤੋਰਿ, ਭਏ ਨਿਰਵੈਰ"
    },
    {
      "section_id": "section-00043",
      "start_time": 417.96,
      "end_time": 426.045,
      "transcript": "ਅਨਦਿਨੁ ਪੂਜਹਿ, ਗੁਰ ਕੇ ਪੈਰ"
    },
    {
      "section_id": "section-00044",
      "start_time": 426.4,
      "end_time": 434.529,
      "transcript": "ਇਹ ਲੋਕ ਸੁਖੀਏ, ਪਰਲੋਕ ਸੁਹੇਲੇ"
    },
    {
      "section_id": "section-00045",
      "start_time": 434.529,
      "end_time": 443.125,
      "transcript": "ਨਾਨਕ ਹਰਿ ਪ੍ਰਭਿ, ਆਪਹਿ ਮੇਲੇ"
    },
    {
      "section_id": "section-00046",
      "start_time": 451.785,
      "end_time": 459.895,
      "transcript": "ਸਾਧਸੰਗਿ ਮਿਲਿ, ਕਰਹੁ ਅਨੰਦ"
    },
    {
      "section_id": "section-00047",
      "start_time": 460.505,
      "end_time": 468.645,
      "transcript": "ਗੁਨ ਗਾਵਹੁ, ਪ੍ਰਭ ਪਰਮਾਨੰਦ"
    },
    {
      "section_id": "section-00048",
      "start_time": 468.985,
      "end_time": 477.28,
      "transcript": "ਰਾਮ ਨਾਮ ਤਤੁ, ਕਰਹੁ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00049",
      "start_time": 477.28,
      "end_time": 485.96,
      "transcript": "ਦ੍ਰੁਲਭ ਦੇਹ ਕਾ, ਕਰਹੁ ਉਧਾਰੁ"
    },
    {
      "section_id": "section-00050",
      "start_time": 485.96,
      "end_time": 494.44,
      "transcript": "ਅੰਮ੍ਰਿਤ ਬਚਨ, ਹਰਿ ਕੇ ਗੁਨ ਗਾਉ"
    },
    {
      "section_id": "section-00051",
      "start_time": 494.44,
      "end_time": 501.88,
      "transcript": "ਪ੍ਰਾਨ ਤਰਨ ਕਾ, ਇਹੈ ਸੁਆਉ"
    },
    {
      "section_id": "section-00052",
      "start_time": 502.855,
      "end_time": 510.815,
      "transcript": "ਆਠ ਪਹਰ, ਪ੍ਰਭ ਪੇਖਹੁ ਨੇਰਾ"
    },
    {
      "section_id": "section-00053",
      "start_time": 511.095,
      "end_time": 519.335,
      "transcript": "ਮਿਟੈ ਅਗਿਆਨੁ, ਬਿਨਸੈ ਅੰਧੇਰਾ"
    },
    {
      "section_id": "section-00054",
      "start_time": 519.76,
      "end_time": 528.038,
      "transcript": "ਸੁਨਿ ਉਪਦੇਸੁ, ਹਿਰਦੈ ਬਸਾਵਹੁ"
    },
    {
      "section_id": "section-00055",
      "start_time": 528.038,
      "end_time": 536.535,
      "transcript": "ਮਨ ਇਛੇ, ਨਾਨਕ ਫਲ ਪਾਵਹੁ"
    },
    {
      "section_id": "section-00056",
      "start_time": 545.24,
      "end_time": 553.165,
      "transcript": "ਹਲਤੁ ਪਲਤੁ ਦੁਇ, ਲੇਹੁ ਸਵਾਰਿ"
    },
    {
      "section_id": "section-00057",
      "start_time": 553.825,
      "end_time": 562.055,
      "transcript": "ਰਾਮ ਨਾਮੁ, ਅੰਤਰਿ ਉਰਿ ਧਾਰਿ"
    },
    {
      "section_id": "section-00058",
      "start_time": 562.195,
      "end_time": 570.965,
      "transcript": "ਪੂਰੇ ਗੁਰ ਕੀ, ਪੂਰੀ ਦੀਖਿਆ"
    },
    {
      "section_id": "section-00059",
      "start_time": 570.965,
      "end_time": 579.405,
      "transcript": "ਜਿਸੁ ਮਨਿ ਬਸੈ, ਤਿਸੁ ਸਾਚੁ ਪਰੀਖਿਆ"
    },
    {
      "section_id": "section-00060",
      "start_time": 579.405,
      "end_time": 587.475,
      "transcript": "ਮਨਿ ਤਨਿ, ਨਾਮੁ ਜਪਹੁ ਲਿਵ ਲਾਇ"
    },
    {
      "section_id": "section-00061",
      "start_time": 587.885,
      "end_time": 596.27,
      "transcript": "ਦੂਖੁ ਦਰਦੁ, ਮਨ ਤੇ ਭਉ ਜਾਇ"
    },
    {
      "section_id": "section-00062",
      "start_time": 596.27,
      "end_time": 604.655,
      "transcript": "ਸਚੁ ਵਾਪਾਰੁ, ਕਰਹੁ ਵਾਪਾਰੀ"
    },
    {
      "section_id": "section-00063",
      "start_time": 605.005,
      "end_time": 613.415,
      "transcript": "ਦਰਗਹ ਨਿਬਹੈ, ਖੇਪ ਤੁਮਾਰੀ"
    },
    {
      "section_id": "section-00064",
      "start_time": 613.8,
      "end_time": 621.905,
      "transcript": "ਏਕਾ ਟੇਕ, ਰਖਹੁ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00065",
      "start_time": 622.205,
      "end_time": 630.655,
      "transcript": "ਨਾਨਕ, ਬਹੁਰਿ ਨ ਆਵਹਿ ਜਾਹਿ"
    },
    {
      "section_id": "section-00066",
      "start_time": 639.087,
      "end_time": 647.475,
      "transcript": "ਤਿਸ ਤੇ ਦੂਰਿ, ਕਹਾ ਕੋ ਜਾਇ"
    },
    {
      "section_id": "section-00067",
      "start_time": 647.975,
      "end_time": 656.155,
      "transcript": "ਉਬਰੈ, ਰਾਖਨਹਾਰੁ ਧਿਆਇ"
    },
    {
      "section_id": "section-00068",
      "start_time": 656.415,
      "end_time": 664.475,
      "transcript": "ਨਿਰਭਉ ਜਪੈ, ਸਗਲ ਭਉ ਮਿਟੈ"
    },
    {
      "section_id": "section-00069",
      "start_time": 665.08,
      "end_time": 673.075,
      "transcript": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ, ਪ੍ਰਾਣੀ ਛੁਟੈ"
    },
    {
      "section_id": "section-00070",
      "start_time": 673.405,
      "end_time": 681.615,
      "transcript": "ਜਿਸੁ ਪ੍ਰਭੁ ਰਾਖੈ, ਤਿਸੁ ਨਾਹੀ ਦੂਖ"
    },
    {
      "section_id": "section-00071",
      "start_time": 681.895,
      "end_time": 690.44,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਮਨਿ ਹੋਵਤ ਸੂਖ"
    },
    {
      "section_id": "section-00072",
      "start_time": 690.44,
      "end_time": 698.375,
      "transcript": "ਚਿੰਤਾ ਜਾਇ, ਮਿਟੈ ਅਹੰਕਾਰੁ"
    },
    {
      "section_id": "section-00073",
      "start_time": 699.0,
      "end_time": 707.52,
      "transcript": "ਤਿਸੁ ਜਨ ਕਉ, ਕੋਇ ਨ ਪਹੁਚਨਹਾਰੁ"
    },
    {
      "section_id": "section-00074",
      "start_time": 707.52,
      "end_time": 715.365,
      "transcript": "ਸਿਰ ਊਪਰਿ ਠਾਢਾ ਗੁਰੁ ਸੂਰਾ"
    },
    {
      "section_id": "section-00075",
      "start_time": 715.795,
      "end_time": 724.235,
      "transcript": "ਨਾਨਕ, ਤਾ ਕੇ ਕਾਰਜ ਪੂਰਾ"
    },
    {
      "section_id": "section-00076",
      "start_time": 732.885,
      "end_time": 741.065,
      "transcript": "ਮਤਿ ਪੂਰੀ, ਅੰਮ੍ਰਿਤੁ ਜਾ ਕੀ ਦ੍ਰਿਸਟਿ"
    },
    {
      "section_id": "section-00077",
      "start_time": 741.065,
      "end_time": 749.93,
      "transcript": "ਦਰਸਨੁ ਪੇਖਤ, ਉਧਰਤ ਸ੍ਰਿਸਟਿ"
    },
    {
      "section_id": "section-00078",
      "start_time": 749.93,
      "end_time": 758.095,
      "transcript": "ਚਰਨ ਕਮਲ, ਜਾ ਕੇ ਅਨੂਪ"
    },
    {
      "section_id": "section-00079",
      "start_time": 758.605,
      "end_time": 766.655,
      "transcript": "ਸਫਲ ਦਰਸਨੁ, ਸੁੰਦਰ ਹਰਿ ਰੂਪ"
    },
    {
      "section_id": "section-00080",
      "start_time": 767.08,
      "end_time": 775.515,
      "transcript": "ਧੰਨੁ ਸੇਵਾ, ਸੇਵਕੁ ਪਰਵਾਨੁ"
    },
    {
      "section_id": "section-00081",
      "start_time": 775.515,
      "end_time": 783.905,
      "transcript": "ਅੰਤਰਜਾਮੀ, ਪੁਰਖੁ ਪ੍ਰਧਾਨੁ"
    },
    {
      "section_id": "section-00082",
      "start_time": 783.905,
      "end_time": 792.375,
      "transcript": "ਜਿਸੁ ਮਨਿ ਬਸੈ, ਸੁ ਹੋਤ ਨਿਹਾਲੁ"
    },
    {
      "section_id": "section-00083",
      "start_time": 792.375,
      "end_time": 800.795,
      "transcript": "ਤਾ ਕੈ ਨਿਕਟਿ, ਨ ਆਵਤ ਕਾਲੁ"
    },
    {
      "section_id": "section-00084",
      "start_time": 801.0,
      "end_time": 809.205,
      "transcript": "ਅਮਰ ਭਏ, ਅਮਰਾ ਪਦੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00085",
      "start_time": 809.205,
      "end_time": 817.771,
      "transcript": "ਸਾਧਸੰਗਿ, ਨਾਨਕ ਹਰਿ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00086",
      "start_time": 817.771,

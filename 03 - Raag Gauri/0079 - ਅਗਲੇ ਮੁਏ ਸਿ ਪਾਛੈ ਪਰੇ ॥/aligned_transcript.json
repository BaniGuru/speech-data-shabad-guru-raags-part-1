{
  "audio_file": "0134 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.07,
      "end_time": 6.303,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.353,
      "end_time": 18.56,
      "transcript": "ਅਗਲੇ ਮੁਏ, ਸਿ ਪਾਛੈ ਪਰੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.56,
      "end_time": 24.518,
      "transcript": "ਜੋ ਉਬਰੇ, ਸੇ ਬੰਧਿ ਲਕੁ ਖਰੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.518,
      "end_time": 30.76,
      "transcript": "ਜਿਹ ਧੰਧੇ ਮਹਿ, ਓਇ ਲਪਟਾਏ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.76,
      "end_time": 36.92,
      "transcript": "ਉਨ ਤੇ ਦੁਗੁਣ, ਦਿੜੀ ਉਨ ਮਾਏ"
    },
    {
      "section_id": "section-00006",
      "start_time": 36.92,
      "end_time": 42.799,
      "transcript": "ਓਹ ਬੇਲਾ, ਕਛੁ ਚੀਤਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 42.799,
      "end_time": 52.482,
      "transcript": "ਬਿਨਸਿ ਜਾਇ ਤਾਹੂ ਲਪਟਾਵੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.36,
      "end_time": 64.52,
      "transcript": "ਆਸਾ ਬੰਧੀ, ਮੂਰਖ ਦੇਹ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.52,
      "end_time": 70.64,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ, ਲਪਟਿਓ ਅਸਨੇਹ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.64,
      "end_time": 76.713,
      "transcript": "ਸਿਰ ਊਪਰਿ, ਠਾਢੋ ਧਰਮ ਰਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 76.713,
      "end_time": 82.96,
      "transcript": "ਮੀਠੀ ਕਰਿ ਕਰਿ, ਬਿਖਿਆ ਖਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 82.96,
      "end_time": 89.12,
      "transcript": "ਹਉ ਬੰਧਉ, ਹਉ ਸਾਧਉ ਬੈਰੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 89.12,
      "end_time": 95.138,
      "transcript": "ਹਮਰੀ ਭੂਮਿ, ਕਉਣੁ ਘਾਲੈ ਪੈਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 95.138,
      "end_time": 101.52,
      "transcript": "ਹਉ ਪੰਡਿਤੁ, ਹਉ ਚਤੁਰੁ ਸਿਆਣਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 101.52,
      "end_time": 107.72,
      "transcript": "ਕਰਣੈਹਾਰੁ, ਨ ਬੁਝੈ ਬਿਗਾਨਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 107.72,
      "end_time": 113.88,
      "transcript": "ਅਪੁਨੀ ਗਤਿ ਮਿਤਿ, ਆਪੇ ਜਾਨੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 113.88,
      "end_time": 120.0,
      "transcript": "ਕਿਆ ਕੋ ਕਹੈ, ਕਿਆ ਆਖਿ ਵਖਾਨੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 120.0,
      "end_time": 126.175,
      "transcript": "ਜਿਤੁ ਜਿਤੁ ਲਾਵਹਿ, ਤਿਤੁ ਤਿਤੁ ਲਗਨਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 126.175,
      "end_time": 132.48,
      "transcript": "ਅਪਨਾ ਭਲਾ, ਸਭ ਕਾਹੂ ਮੰਗਨਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 132.48,
      "end_time": 138.528,
      "transcript": "ਸਭ ਕਿਛੁ ਤੇਰਾ, ਤੂੰ ਕਰਣੈਹਾਰੁ"
    },
    {
      "section_id": "section-00021",
      "start_time": 138.528,
      "end_time": 144.812,
      "transcript": "ਅੰਤੁ ਨਾਹੀ ਕਿਛੁ ਪਾਰਾਵਾਰੁ"
    },
    {
      "section_id": "section-00022",
      "start_time": 144.812,
      "end_time": 150.853,
      "transcript": "ਦਾਸ ਅਪਨੇ ਕਉ ਦੀਜੈ ਦਾਨੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 150.853,
      "end_time": 156.868,
      "transcript": "ਕਬਹੂ ਨ ਵਿਸਰੈ, ਨਾਨਕ ਨਾਮੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 156.868,
      "end_time": 163.098,
      "transcript": "ਦਾਸ ਅਪਨੇ ਕਉ ਦੀਜੈ ਦਾਨੁ"
    },
    {
      "section_id": "section-00025",
      "start_time": 163.098,
      "end_time": 169.377,
      "transcript": "ਕਬਹੂ ਨ ਵਿਸਰੈ, ਨਾਨਕ ਨਾਮੁ"

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.075,
      "end_time": 4.805,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.355,
      "end_time": 18.845,
      "transcript": "ਜਾਚਕੁ ਮੰਗੈ ਦਾਨੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.265,
      "end_time": 25.745,
      "transcript": "ਦੇਹਿ ਪਿਆਰਿਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.205,
      "end_time": 32.725,
      "transcript": "ਦੇਵਣਹਾਰੁ ਦਾਤਾਰੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.24,
      "end_time": 40.015,
      "transcript": "ਮੈ ਨਿਤ ਚਿਤਾਰਿਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.64,
      "end_time": 53.215,
      "transcript": "ਨਿਖੁਟਿ ਨ ਜਾਈ ਮੂਲਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.44,
      "end_time": 60.155,
      "transcript": "ਅਤੁਲ ਭੰਡਾਰਿਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.535,
      "end_time": 66.955,
      "transcript": "ਨਾਨਕ ਸਬਦੁ ਅਪਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.44,
      "end_time": 73.755,
      "transcript": "ਤਿਨਿ ਸਭੁ ਕਿਛੁ ਸਾਰਿਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.08,
      "end_time": 77.555,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.445,
      "end_time": 90.755,
      "transcript": "ਸਿਖਹੁ ਸਬਦੁ ਪਿਆਰਿਹੋ"
    },
    {
      "section_id": "section-00012",
      "start_time": 91.185,
      "end_time": 97.605,
      "transcript": "ਜਨਮ ਮਰਨ ਕੀ ਟੇਕ"
    },
    {
      "section_id": "section-00013",
      "start_time": 98.08,
      "end_time": 104.485,
      "transcript": "ਮੁਖ ਊਜਲ ਸਦਾ ਸੁਖੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 104.865,
      "end_time": 111.095,
      "transcript": "ਨਾਨਕ ਸਿਮਰਤ ਏਕ"
    },
    {
      "section_id": "section-00015",
      "start_time": 111.64,
      "end_time": 114.665,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 114.96,
      "end_time": 123.585,
      "transcript": "ਓਥੈ ਅੰਮ੍ਰਿਤੁ ਵੰਡੀਐ, ਸੁਖੀਆ ਹਰਿ ਕਰਣੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 123.8,
      "end_time": 132.611,
      "transcript": "ਜਮ ਕੈ ਪੰਥਿ ਨ ਪਾਈਅਹਿ, ਫਿਰਿ ਨਾਹੀ ਮਰਣੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 132.611,
      "end_time": 141.655,
      "transcript": "ਜਿਸ ਨੋ ਆਇਆ ਪ੍ਰੇਮ ਰਸੁ, ਤਿਸੈ ਹੀ ਜਰਣੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 141.655,
      "end_time": 150.085,
      "transcript": "ਬਾਣੀ ਉਚਰਹਿ ਸਾਧ ਜਨ, ਅਮਿਉ ਚਲਹਿ ਝਰਣੇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 150.32,
      "end_time": 160.015,
      "transcript": "ਪੇਖਿ ਦਰਸਨੁ ਨਾਨਕੁ ਜੀਵਿਆ, ਮਨ ਅੰਦਰਿ ਧਰਣੇ"
    }
  ]
}

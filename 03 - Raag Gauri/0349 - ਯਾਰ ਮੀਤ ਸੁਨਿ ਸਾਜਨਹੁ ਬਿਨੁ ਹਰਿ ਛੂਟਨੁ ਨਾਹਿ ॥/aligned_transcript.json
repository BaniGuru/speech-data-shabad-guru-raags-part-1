{
  "audio_file": "0195 BPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 6.08,
      "end_time": 11.815,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.215,
      "end_time": 18.195,
      "transcript": "ਯਾਰ ਮੀਤ ਸੁਨਿ ਸਾਜਨਹੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.195,
      "end_time": 24.067,
      "transcript": "ਬਿਨੁ ਹਰਿ ਛੂਟਨੁ ਨਾਹਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.067,
      "end_time": 30.22,
      "transcript": "ਨਾਨਕ ਤਿਹ ਬੰਧਨ ਕਟੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.22,
      "end_time": 36.065,
      "transcript": "ਗੁਰ ਕੀ ਚਰਨੀ ਪਾਹਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 36.28,
      "end_time": 37.955,
      "transcript": "ਪਵੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 47.4,
      "end_time": 55.16,
      "transcript": "ਯਯਾ, ਜਤਨ ਕਰਤ ਬਹੁ ਬਿਧੀਆ ਏਕ ਨਾਮ ਬਿਨੁ, ਕਹ ਲਉ ਸਿਧੀਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 55.16,
      "end_time": 62.825,
      "transcript": "ਯਾਹੂ ਜਤਨ ਕਰਿ, ਹੋਤ ਛੁਟਾਰਾ ਉਆਹੂ ਜਤਨ, ਸਾਧ ਸੰਗਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 62.825,
      "end_time": 70.64,
      "transcript": "ਯਾ ਉਬਰਨ ਧਾਰੈ, ਸਭੁ ਕੋਊ ਉਆਹਿ ਜਪੇ ਬਿਨੁ, ਉਬਰ ਨ ਹੋਊ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.64,
      "end_time": 78.16,
      "transcript": "ਯਾਹੂ ਤਰਨ ਤਾਰਨ, ਸਮਰਾਥਾ ਰਾਖਿ ਲੇਹੁ, ਨਿਰਗੁਨ ਨਰਨਾਥਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 78.16,
      "end_time": 82.275,
      "transcript": "ਮਨ ਬਚ ਕ੍ਰਮ, ਜਿਹ ਆਪਿ ਜਨਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 82.275,
      "end_time": 86.735,
      "transcript": "ਨਾਨਕ, ਤਿਹ ਮਤਿ ਪ੍ਰਗਟੀ ਆਈ"
    }
  ]
}

{
  "audio_file": "0213 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 28.775,
      "end_time": 42.003,
      "transcript": "ਸਲੋਕੁ ਆਦਿ ਸਚੁ, ਜੁਗਾਦਿ ਸਚੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 42.003,
      "end_time": 55.625,
      "transcript": "ਹੈ ਭਿ ਸਚੁ, ਨਾਨਕ ਹੋਸੀ ਭਿ ਸਚੁ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 56.56,
      "end_time": 64.605,
      "transcript": "ਚਰਨ ਸਤਿ, ਸਤਿ ਪਰਸਨਹਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 65.16,
      "end_time": 73.44,
      "transcript": "ਪੂਜਾ ਸਤਿ, ਸਤਿ ਸੇਵਦਾਰ"
    },
    {
      "section_id": "section-00005",
      "start_time": 73.44,
      "end_time": 81.165,
      "transcript": "ਦਰਸਨੁ ਸਤਿ, ਸਤਿ ਪੇਖਨਹਾਰ"
    },
    {
      "section_id": "section-00006",
      "start_time": 81.665,
      "end_time": 89.965,
      "transcript": "ਨਾਮੁ ਸਤਿ, ਸਤਿ ਧਿਆਵਨਹਾਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 89.965,
      "end_time": 97.735,
      "transcript": "ਆਪਿ ਸਤਿ, ਸਤਿ ਸਭ ਧਾਰੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 98.265,
      "end_time": 105.945,
      "transcript": "ਆਪੇ ਗੁਣ, ਆਪੇ ਗੁਣਕਾਰੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 106.52,
      "end_time": 114.165,
      "transcript": "ਸਬਦੁ ਸਤਿ, ਸਤਿ ਪ੍ਰਭੁ ਬਕਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 114.72,
      "end_time": 122.415,
      "transcript": "ਸੁਰਤਿ ਸਤਿ, ਸਤਿ ਜਸੁ ਸੁਨਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 122.795,
      "end_time": 130.545,
      "transcript": "ਬੁਝਨਹਾਰ ਕਉ, ਸਤਿ ਸਭ ਹੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 130.995,
      "end_time": 139.285,
      "transcript": "ਨਾਨਕ ਸਤਿ, ਸਤਿ ਪ੍ਰਭੁ ਸੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 151.84,
      "end_time": 159.515,
      "transcript": "ਸਤਿ ਸਰੂਪੁ, ਰਿਦੈ ਜਿਨਿ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 160.04,
      "end_time": 168.187,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਤਿਨਿ ਮੂਲੁ ਪਛਾਨਿਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 168.187,
      "end_time": 176.44,
      "transcript": "ਜਾ ਕੈ ਰਿਦੈ, ਬਿਸ੍ਵਾਸੁ ਪ੍ਰਭ ਆਇਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 176.44,
      "end_time": 184.64,
      "transcript": "ਤਤੁ ਗਿਆਨੁ, ਤਿਸੁ ਮਨਿ ਪ੍ਰਗਟਾਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 184.64,
      "end_time": 192.765,
      "transcript": "ਭੈ ਤੇ, ਨਿਰਭਉ ਹੋਇ ਬਸਾਨਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 192.765,
      "end_time": 201.01,
      "transcript": "ਜਿਸ ਤੇ ਉਪਜਿਆ, ਤਿਸੁ ਮਾਹਿ ਸਮਾਨਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 201.01,
      "end_time": 208.625,
      "transcript": "ਬਸਤੁ ਮਾਹਿ ਲੇ ਬਸਤੁ ਗਡਾਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 209.28,
      "end_time": 217.285,
      "transcript": "ਤਾ ਕਉ ਭਿੰਨ, ਨ ਕਹਨਾ ਜਾਈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 217.465,
      "end_time": 225.31,
      "transcript": "ਬੂਝੈ ਬੂਝਨਹਾਰੁ ਬਿਬੇਕ"
    },
    {
      "section_id": "section-00022",
      "start_time": 225.31,
      "end_time": 234.08,
      "transcript": "ਨਾਰਾਇਨ ਮਿਲੇ ਨਾਨਕ ਏਕ"
    },
    {
      "section_id": "section-00023",
      "start_time": 234.08,
      "end_time": 242.32,
      "transcript": "ਠਾਕੁਰ ਕਾ ਸੇਵਕੁ, ਆਗਿਆਕਾਰੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 242.32,
      "end_time": 250.489,
      "transcript": "ਠਾਕੁਰ ਕਾ ਸੇਵਕੁ, ਸਦਾ ਪੂਜਾਰੀ"
    },
    {
      "section_id": "section-00025",
      "start_time": 250.489,
      "end_time": 258.435,
      "transcript": "ਠਾਕੁਰ ਕੇ ਸੇਵਕ ਕੈ, ਮਨਿ ਪਰਤੀਤਿ"
    },
    {
      "section_id": "section-00026",
      "start_time": 258.96,
      "end_time": 267.2,
      "transcript": "ਠਾਕੁਰ ਕੇ ਸੇਵਕ ਕੀ, ਨਿਰਮਲ ਰੀਤਿ"
    },
    {
      "section_id": "section-00027",
      "start_time": 267.2,
      "end_time": 275.295,
      "transcript": "ਠਾਕੁਰ ਕਉ, ਸੇਵਕੁ ਜਾਨੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00028",
      "start_time": 275.44,
      "end_time": 283.62,
      "transcript": "ਪ੍ਰਭ ਕਾ ਸੇਵਕੁ, ਨਾਮ ਕੈ ਰੰਗਿ"
    },
    {
      "section_id": "section-00029",
      "start_time": 283.62,
      "end_time": 291.847,
      "transcript": "ਸੇਵਕ ਕਉ, ਪ੍ਰਭ ਪਾਲਨਹਾਰਾ"
    },
    {
      "section_id": "section-00030",
      "start_time": 291.847,
      "end_time": 300.202,
      "transcript": "ਸੇਵਕ ਕੀ, ਰਾਖੈ ਨਿਰੰਕਾਰਾ"
    },
    {
      "section_id": "section-00031",
      "start_time": 300.202,
      "end_time": 308.376,
      "transcript": "ਸੋ ਸੇਵਕੁ, ਜਿਸੁ ਦਇਆ ਪ੍ਰਭੁ ਧਾਰੈ"
    },
    {
      "section_id": "section-00032",
      "start_time": 308.376,
      "end_time": 316.915,
      "transcript": "ਨਾਨਕ ਸੋ ਸੇਵਕੁ, ਸਾਸਿ ਸਾਸਿ ਸਮਾਰੈ"
    },
    {
      "section_id": "section-00033",
      "start_time": 333.605,
      "end_time": 341.725,
      "transcript": "ਅਪੁਨੇ ਜਨ ਕਾ, ਪਰਦਾ ਢਾਕੈ"
    },
    {
      "section_id": "section-00034",
      "start_time": 342.0,
      "end_time": 350.18,
      "transcript": "ਅਪਨੇ ਸੇਵਕ ਕੀ, ਸਰਪਰ ਰਾਖੈ"
    },
    {
      "section_id": "section-00035",
      "start_time": 350.18,
      "end_time": 357.915,
      "transcript": "ਅਪਨੇ ਦਾਸ ਕਉ, ਦੇਇ ਵਡਾਈ"
    },
    {
      "section_id": "section-00036",
      "start_time": 358.455,
      "end_time": 366.295,
      "transcript": "ਅਪਨੇ ਸੇਵਕ ਕਉ, ਨਾਮੁ ਜਪਾਈ"
    },
    {
      "section_id": "section-00037",
      "start_time": 366.68,
      "end_time": 374.885,
      "transcript": "ਅਪਨੇ ਸੇਵਕ ਕੀ, ਆਪਿ ਪਤਿ ਰਾਖੈ"
    },
    {
      "section_id": "section-00038",
      "start_time": 374.885,
      "end_time": 383.155,
      "transcript": "ਤਾ ਕੀ ਗਤਿ ਮਿਤਿ, ਕੋਇ ਨ ਲਾਖੈ"
    },
    {
      "section_id": "section-00039",
      "start_time": 383.155,
      "end_time": 391.38,
      "transcript": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ ਕਉ, ਕੋ ਨ ਪਹੂਚੈ"
    },
    {
      "section_id": "section-00040",
      "start_time": 391.38,
      "end_time": 399.375,
      "transcript": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ, ਊਚ ਤੇ ਊਚੇ"
    },
    {
      "section_id": "section-00041",
      "start_time": 399.375,
      "end_time": 407.945,
      "transcript": "ਜੋ ਪ੍ਰਭਿ, ਅਪਨੀ ਸੇਵਾ ਲਾਇਆ"
    },
    {
      "section_id": "section-00042",
      "start_time": 407.945,
      "end_time": 416.225,
      "transcript": "ਨਾਨਕ ਸੋ ਸੇਵਕੁ, ਦਹ ਦਿਸਿ ਪ੍ਰਗਟਾਇਆ"
    },
    {
      "section_id": "section-00043",
      "start_time": 416.225,
      "end_time": 424.53,
      "transcript": "ਨੀਕੀ ਕੀਰੀ ਮਹਿ, ਕਲ ਰਾਖੈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 424.53,
      "end_time": 432.665,
      "transcript": "ਭਸਮ ਕਰੈ, ਲਸਕਰ ਕੋਟਿ ਲਾਖੈ"
    },
    {
      "section_id": "section-00045",
      "start_time": 432.665,
      "end_time": 441.035,
      "transcript": "ਜਿਸ ਕਾ ਸਾਸੁ, ਨ ਕਾਢਤ ਆਪਿ"
    },
    {
      "section_id": "section-00046",
      "start_time": 441.24,
      "end_time": 448.835,
      "transcript": "ਤਾ ਕਉ ਰਾਖਤ, ਦੇ ਕਰਿ ਹਾਥ"
    },
    {
      "section_id": "section-00047",
      "start_time": 449.395,
      "end_time": 457.155,
      "transcript": "ਮਾਨਸ ਜਤਨ ਕਰਤ, ਬਹੁ ਭਾਤਿ"
    },
    {
      "section_id": "section-00048",
      "start_time": 457.68,
      "end_time": 465.385,
      "transcript": "ਤਿਸ ਕੇ ਕਰਤਬ, ਬਿਰਥੇ ਜਾਤਿ"
    },
    {
      "section_id": "section-00049",
      "start_time": 465.905,
      "end_time": 473.635,
      "transcript": "ਮਾਰੈ ਨ ਰਾਖੈ, ਅਵਰੁ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00050",
      "start_time": 474.28,
      "end_time": 482.015,
      "transcript": "ਸਰਬ ਜੀਆ ਕਾ, ਰਾਖਾ ਸੋਇ"
    },
    {
      "section_id": "section-00051",
      "start_time": 482.68,
      "end_time": 490.666,
      "transcript": "ਕਾਹੇ ਸੋਚ ਕਰਹਿ, ਰੇ ਪ੍ਰਾਣੀ"
    },
    {
      "section_id": "section-00052",
      "start_time": 490.666,
      "end_time": 499.255,
      "transcript": "ਜਪਿ ਨਾਨਕ, ਪ੍ਰਭ ਅਲਖ ਵਿਡਾਣੀ"
    },
    {
      "section_id": "section-00053",
      "start_time": 499.255,
      "end_time": 507.6,
      "transcript": "ਬਾਰੰ ਬਾਰ ਬਾਰ, ਪ੍ਰਭੁ ਜਪੀਐ"
    },
    {
      "section_id": "section-00054",
      "start_time": 507.6,
      "end_time": 515.745,
      "transcript": "ਪੀ ਅੰਮ੍ਰਿਤੁ, ਇਹੁ ਮਨੁ ਤਨੁ ਧ੍ਰਪੀਐ"
    },
    {
      "section_id": "section-00055",
      "start_time": 515.875,
      "end_time": 523.705,
      "transcript": "ਨਾਮ ਰਤਨੁ, ਜਿਨਿ ਗੁਰਮੁਖਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00056",
      "start_time": 524.2,
      "end_time": 531.975,
      "transcript": "ਤਿਸੁ ਕਿਛੁ ਅਵਰੁ, ਨਾਹੀ ਦ੍ਰਿਸਟਾਇਆ"
    },
    {
      "section_id": "section-00057",
      "start_time": 532.505,
      "end_time": 540.325,
      "transcript": "ਨਾਮੁ ਧਨੁ, ਨਾਮੋ ਰੂਪੁ ਰੰਗੁ"
    },
    {
      "section_id": "section-00058",
      "start_time": 540.835,
      "end_time": 548.965,
      "transcript": "ਨਾਮੋ ਸੁਖੁ, ਹਰਿ ਨਾਮ ਕਾ ਸੰਗੁ"
    },
    {
      "section_id": "section-00059",
      "start_time": 549.125,
      "end_time": 557.331,
      "transcript": "ਨਾਮ ਰਸਿ, ਜੋ ਜਨ ਤ੍ਰਿਪਤਾਨੇ"
    },
    {
      "section_id": "section-00060",
      "start_time": 557.331,
      "end_time": 565.856,
      "transcript": "ਮਨ ਤਨ, ਨਾਮਹਿ ਨਾਮਿ ਸਮਾਨੇ"
    },
    {
      "section_id": "section-00061",
      "start_time": 565.856,
      "end_time": 574.151,
      "transcript": "ਊਠਤ ਬੈਠਤ ਸੋਵਤ ਨਾਮ"
    },
    {
      "section_id": "section-00062",
      "start_time": 574.151,
      "end_time": 582.615,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਨ ਕੈ ਸਦ ਕਾਮ"
    },
    {
      "section_id": "section-00063",
      "start_time": 595.215,
      "end_time": 603.315,
      "transcript": "ਬੋਲਹੁ ਜਸੁ ਜਿਹਬਾ, ਦਿਨੁ ਰਾਤਿ"
    },
    {
      "section_id": "section-00064",
      "start_time": 603.6,
      "end_time": 611.455,
      "transcript": "ਪ੍ਰਭਿ ਅਪਨੈ ਜਨ, ਕੀਨੀ ਦਾਤਿ"
    },
    {
      "section_id": "section-00065",
      "start_time": 612.08,
      "end_time": 619.825,
      "transcript": "ਕਰਹਿ ਭਗਤਿ, ਆਤਮ ਕੈ ਚਾਇ"
    },
    {
      "section_id": "section-00066",
      "start_time": 620.36,
      "end_time": 628.195,
      "transcript": "ਪ੍ਰਭ ਅਪਨੇ ਸਿਉ, ਰਹਹਿ ਸਮਾਇ"
    },
    {
      "section_id": "section-00067",
      "start_time": 628.715,
      "end_time": 637.07,
      "transcript": "ਜੋ ਹੋਆ, ਹੋਵਤ ਸੋ ਜਾਨੈ"
    },
    {
      "section_id": "section-00068",
      "start_time": 637.07,
      "end_time": 645.17,
      "transcript": "ਪ੍ਰਭ ਅਪਨੇ ਕਾ, ਹੁਕਮੁ ਪਛਾਨੈ"
    },
    {
      "section_id": "section-00069",
      "start_time": 645.17,
      "end_time": 653.76,
      "transcript": "ਤਿਸ ਕੀ ਮਹਿਮਾ, ਕਉਨ ਬਖਾਨਉ"
    },
    {
      "section_id": "section-00070",
      "start_time": 653.76,
      "end_time": 661.977,
      "transcript": "ਤਿਸ ਕਾ ਗੁਨੁ ਕਹਿ, ਏਕ ਨ ਜਾਨਉ"
    },
    {
      "section_id": "section-00071",
      "start_time": 661.977,
      "end_time": 669.815,
      "transcript": "ਆਠ ਪਹਰ, ਪ੍ਰਭ ਬਸਹਿ ਹਜੂਰੇ"
    },
    {
      "section_id": "section-00072",
      "start_time": 670.44,
      "end_time": 678.575,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਸੇਈ ਜਨ ਪੂਰੇ"
    },
    {
      "section_id": "section-00073",
      "start_time": 678.72,
      "end_time": 686.415,
      "transcript": "ਮਨ ਮੇਰੇ, ਤਿਨ ਕੀ ਓਟ ਲੇਹਿ"
    },
    {
      "section_id": "section-00074",
      "start_time": 686.92,
      "end_time": 695.043,
      "transcript": "ਮਨੁ ਤਨੁ ਅਪਨਾ, ਤਿਨ ਜਨ ਦੇਹਿ"
    },
    {
      "section_id": "section-00075",
      "start_time": 695.043,
      "end_time": 703.375,
      "transcript": "ਜਿਨਿ ਜਨਿ, ਅਪਨਾ ਪ੍ਰਭੂ ਪਛਾਤਾ"
    },
    {
      "section_id": "section-00076",
      "start_time": 703.56,
      "end_time": 711.76,
      "transcript": "ਸੋ ਜਨੁ, ਸਰਬ ਥੋਕ ਕਾ ਦਾਤਾ"
    },
    {
      "section_id": "section-00077",
      "start_time": 711.76,
      "end_time": 719.605,
      "transcript": "ਤਿਸ ਕੀ ਸਰਨਿ, ਸਰਬ ਸੁਖ ਪਾਵਹਿ"
    },
    {
      "section_id": "section-00078",
      "start_time": 720.08,
      "end_time": 727.955,
      "transcript": "ਤਿਸ ਕੈ ਦਰਸਿ, ਸਭ ਪਾਪ ਮਿਟਾਵਹਿ"
    },
    {
      "section_id": "section-00079",
      "start_time": 728.4,
      "end_time": 736.68,
      "transcript": "ਅਵਰ ਸਿਆਨਪ, ਸਗਲੀ ਛਾਡੁ"
    },
    {
      "section_id": "section-00080",
      "start_time": 736.68,
      "end_time": 744.779,
      "transcript": "ਤਿਸੁ ਜਨ ਕੀ, ਤੂ ਸੇਵਾ ਲਾਗੁ"
    },
    {
      "section_id": "section-00081",
      "start_time": 744.779,
      "end_time": 753.195,
      "transcript": "ਆਵਨੁ ਜਾਨੁ, ਨ ਹੋਵੀ ਤੇਰਾ"
    },
    {
      "section_id": "section-00082",
      "start_time": 753.195,
      "end_time": 762.118,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਜਨ ਕੇ ਪੂਜਹੁ ਸਦ ਪੈਰਾ"
    },
    {
      "section_id": "section-00083",
      "start_time": 778.48,
      "end_time": 786.612,
      "transcript": "ਆਵਨੁ ਜਾਨੁ, ਨ ਹੋਵੀ ਤੇਰਾ"
    },
    {
      "section_id": "section-00084",

{
  "audio_file": "0134 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.326,
      "end_time": 12.685,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 30.798,
      "end_time": 36.903,
      "transcript": "ਜਿਨਿ ਕੀਤਾ, ਮਾਟੀ ਤੇ ਰਤਨੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.903,
      "end_time": 43.173,
      "transcript": "ਗਰਭ ਮਹਿ ਰਾਖਿਆ, ਜਿਨਿ ਕਰਿ ਜਤਨੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 43.173,
      "end_time": 49.48,
      "transcript": "ਜਿਨਿ ਦੀਨੀ, ਸੋਭਾ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 49.48,
      "end_time": 55.586,
      "transcript": "ਤਿਸੁ ਪ੍ਰਭ ਕਉ, ਆਠ ਪਹਰ ਧਿਆਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 55.586,
      "end_time": 62.04,
      "transcript": "ਰਮਈਆ ਰੇਨੁ ਸਾਧ ਜਨ ਪਾਵਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.04,
      "end_time": 71.62,
      "transcript": "ਗੁਰ ਮਿਲਿ ਅਪੁਨਾ ਖਸਮੁ ਧਿਆਵਉ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.6,
      "end_time": 83.8,
      "transcript": "ਜਿਨਿ ਕੀਤਾ, ਮੂੜ ਤੇ ਬਕਤਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 83.8,
      "end_time": 90.04,
      "transcript": "ਜਿਨਿ ਕੀਤਾ, ਬੇਸੁਰਤ ਤੇ ਸੁਰਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.04,
      "end_time": 96.36,
      "transcript": "ਜਿਸੁ ਪਰਸਾਦਿ, ਨਵੈ ਨਿਧਿ ਪਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 96.36,
      "end_time": 102.294,
      "transcript": "ਸੋ ਪ੍ਰਭੁ, ਮਨ ਤੇ ਬਿਸਰਤ ਨਾਹੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 102.294,
      "end_time": 108.661,
      "transcript": "ਜਿਨਿ ਦੀਆ, ਨਿਥਾਵੇ ਕਉ ਥਾਨੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 108.661,
      "end_time": 114.751,
      "transcript": "ਜਿਨਿ ਦੀਆ, ਨਿਮਾਨੇ ਕਉ ਮਾਨੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 114.751,
      "end_time": 120.969,
      "transcript": "ਜਿਨਿ ਕੀਨੀ, ਸਭ ਪੂਰਨ ਆਸਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 120.969,
      "end_time": 127.147,
      "transcript": "ਸਿਮਰਉ ਦਿਨੁ ਰੈਨਿ, ਸਾਸ ਗਿਰਾਸਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 127.147,
      "end_time": 133.64,
      "transcript": "ਜਿਸੁ ਪ੍ਰਸਾਦਿ, ਮਾਇਆ ਸਿਲਕ ਕਾਟੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 133.64,
      "end_time": 139.8,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਅੰਮ੍ਰਿਤੁ ਬਿਖੁ ਖਾਟੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 139.8,
      "end_time": 145.919,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਇਸ ਤੇ ਕਿਛੁ ਨਾਹੀ"
    },
    {
      "section_id": "section-00019",
      "start_time": 145.919,
      "end_time": 152.12,
      "transcript": "ਰਾਖਨਹਾਰੇ ਕਉ, ਸਾਲਾਹੀ"
    }
  ]
}

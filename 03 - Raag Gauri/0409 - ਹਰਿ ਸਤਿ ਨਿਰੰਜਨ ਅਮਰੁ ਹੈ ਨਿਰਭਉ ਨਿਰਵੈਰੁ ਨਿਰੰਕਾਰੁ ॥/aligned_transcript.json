  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.32,
      "end_time": 13.161,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.161,
      "end_time": 32.35,
      "transcript": "ਮਹਲਾ ਚੌਥਾ ਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 43.8,
      "end_time": 51.435,
      "transcript": "ਹਰਿ ਸਤਿ ਨਿਰੰਜਨ ਅਮਰੁ ਹੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 52.28,
      "end_time": 59.795,
      "transcript": "ਨਿਰਭਉ ਨਿਰਵੈਰੁ ਨਿਰੰਕਾਰੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 60.64,
      "end_time": 68.495,
      "transcript": "ਜਿਨ ਜਪਿਆ ਇਕ ਮਨਿ ਇਕ ਚਿਤਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.72,
      "end_time": 76.462,
      "transcript": "ਤਿਨ ਲਥਾ ਹਉਮੈ ਭਾਰੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.462,
      "end_time": 84.295,
      "transcript": "ਜਿਨ ਗੁਰਮੁਖਿ ਹਰਿ ਆਰਾਧਿਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.88,
      "end_time": 92.125,
      "transcript": "ਤਿਨ ਸੰਤ ਜਨਾ ਜੈਕਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 92.88,
      "end_time": 100.52,
      "transcript": "ਕੋਈ ਨਿੰਦਾ ਕਰੇ ਪੂਰੇ ਸਤਿਗੁਰੂ ਕੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 100.52,
      "end_time": 107.901,
      "transcript": "ਤਿਸ ਨੋ ਫਿਟੁ ਫਿਟੁ ਕਹੈ ਸਭੁ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 107.901,
      "end_time": 116.455,
      "transcript": "ਸਤਿਗੁਰ ਵਿਚਿ ਆਪਿ ਵਰਤਦਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 116.455,
      "end_time": 123.385,
      "transcript": "ਹਰਿ ਆਪੇ ਰਖਣਹਾਰੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 123.995,
      "end_time": 131.993,
      "transcript": "ਧਨੁ ਧੰਨੁ ਗੁਰੂ ਗੁਣ ਗਾਵਦਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 131.993,
      "end_time": 139.76,
      "transcript": "ਤਿਸ ਨੋ ਸਦਾ ਸਦਾ ਨਮਸਕਾਰੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 139.76,
      "end_time": 146.605,
      "transcript": "ਜਨ ਨਾਨਕ ਤਿਨ ਕਉ ਵਾਰਿਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 147.535,
      "end_time": 154.635,
      "transcript": "ਜਿਨ ਜਪਿਆ ਸਿਰਜਣਹਾਰੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 155.105,
      "end_time": 159.305,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 167.185,
      "end_time": 175.027,
      "transcript": "ਆਪੇ ਧਰਤੀ ਸਾਜੀਅਨੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 175.027,
      "end_time": 181.885,
      "transcript": "ਆਪੇ ਆਕਾਸੁ"
    },
    {
      "section_id": "section-00020",
      "start_time": 182.745,
      "end_time": 190.295,
      "transcript": "ਵਿਚਿ ਆਪੇ ਜੰਤ ਉਪਾਇਅਨੁ"
    },
    {
      "section_id": "section-00021",
      "start_time": 190.44,
      "end_time": 197.941,
      "transcript": "ਮੁਖਿ ਆਪੇ ਦੇਇ ਗਿਰਾਸੁ"
    },
    {
      "section_id": "section-00022",
      "start_time": 197.941,
      "end_time": 205.853,
      "transcript": "ਸਭੁ ਆਪੇ ਆਪਿ ਵਰਤਦਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 205.853,
      "end_time": 212.905,
      "transcript": "ਆਪੇ ਹੀ ਗੁਣਤਾਸੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 213.68,
      "end_time": 221.087,
      "transcript": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਧਿਆਇ ਤੂ"
    },
    {
      "section_id": "section-00025",
      "start_time": 221.087,
      "end_time": 231.265,
      "transcript": "ਸਭਿ ਕਿਲਵਿਖ ਕਟੇ ਤਾਸੁ ਪਉੜੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 231.72,
      "end_time": 239.968,
      "transcript": "ਤੂ ਸਚਾ ਸਾਹਿਬੁ ਸਚੁ ਹੈ, ਸਚੁ ਸਚੇ ਭਾਵੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 239.968,
      "end_time": 248.705,
      "transcript": "ਜੋ ਤੁਧੁ ਸਚੁ ਸਲਾਹਦੇ, ਤਿਨ ਜਮ ਕੰਕਰੁ ਨੇੜਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 248.705,
      "end_time": 256.6,
      "transcript": "ਤਿਨ ਕੇ ਮੁਖ ਦਰਿ ਉਜਲੇ, ਜਿਨ ਹਰਿ ਹਿਰਦੈ ਸਚਾ ਭਾਵੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 256.6,
      "end_time": 264.76,
      "transcript": "ਕੂੜਿਆਰ ਪਿਛਾਹਾ ਸਟੀਅਨਿ, ਕੂੜੁ ਹਿਰਦੈ ਕਪਟੁ ਮਹਾ ਦੁਖੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 264.76,
      "end_time": 275.625,
      "transcript": "ਮੁਹ ਕਾਲੇ ਕੂੜਿਆਰੀਆ, ਕੂੜਿਆਰ ਕੂੜੋ ਹੋਇ ਜਾਵੈ"
    }
  ]
}

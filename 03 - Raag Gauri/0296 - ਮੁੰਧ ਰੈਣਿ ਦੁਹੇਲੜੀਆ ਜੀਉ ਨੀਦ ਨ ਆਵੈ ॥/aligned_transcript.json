    {
      "section_id": "section-00018",
      "start_time": 153.445,
      "end_time": 159.431,
      "transcript": "ਬਿਨੁ ਉਰ ਧਾਰੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 159.431,
      "end_time": 166.12,
      "transcript": "ਨਾਹ ਬਿਨੁ ਘਰ ਵਾਸੁ ਨਾਹੀ"

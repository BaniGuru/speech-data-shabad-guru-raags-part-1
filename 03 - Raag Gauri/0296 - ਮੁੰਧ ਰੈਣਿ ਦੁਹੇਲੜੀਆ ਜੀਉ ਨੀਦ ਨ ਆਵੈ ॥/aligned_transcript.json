    {
      "section_id": "section-00014",
      "start_time": 127.76,
      "end_time": 133.715,
      "transcript": "ਬਿਨੁ ਪਿਰ ਨੀਦ ਨ ਆਵਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 134.24,
      "end_time": 140.175,
      "transcript": "ਮੁੰਧ ਨਿਮਾਨੜੀਆ ਜੀਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 140.665,
      "end_time": 146.54,
      "transcript": "ਬਿਨੁ ਧਨੀ ਪਿਆਰੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 146.54,
      "end_time": 152.945,
      "transcript": "ਕਿਉ ਸੁਖੁ ਪਾਵੈਗੀ"

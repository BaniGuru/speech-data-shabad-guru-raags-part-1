    {
      "section_id": "section-00045",
      "start_time": 329.605,
      "end_time": 336.21,
      "transcript": "ਸਾਜਨ ਰਹੰਸੇ ਦੁਸਟ ਵਿਆਪੇ"
    },
    {
      "section_id": "section-00046",
      "start_time": 336.21,
      "end_time": 342.025,
      "transcript": "ਸਾਚੁ ਜਪਿ ਸਚੁ ਲਾਹਓ"

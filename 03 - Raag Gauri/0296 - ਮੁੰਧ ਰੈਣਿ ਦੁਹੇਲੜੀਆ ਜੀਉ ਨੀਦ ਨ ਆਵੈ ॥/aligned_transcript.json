    {
      "section_id": "section-00008",
      "start_time": 89.317,
      "end_time": 95.801,
      "transcript": "ਕੇਵ ਨੈਣੀ ਦੇਖਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 95.801,
      "end_time": 102.135,
      "transcript": "ਸੀਗਾਰ ਮਿਠ ਰਸ ਭੋਗ ਭੋਜਨ"
    },
    {
      "section_id": "section-00010",
      "start_time": 102.135,
      "end_time": 108.145,
      "transcript": "ਸਭੁ ਝੂਠੁ ਕਿਤੈ ਨ ਲੇਖਏ"
    },
    {
      "section_id": "section-00011",
      "start_time": 108.72,
      "end_time": 114.965,
      "transcript": "ਮੈ ਮਤ ਜੋਬਨਿ ਗਰਬਿ ਗਾਲੀ"

      "start_time": 63.895,
      "end_time": 70.252,
      "transcript": "ਸਾ ਧਨ ਦੁਬਲੀਆ ਜੀਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 70.252,
      "end_time": 76.806,
      "transcript": "ਪਿਰ ਕੈ ਹਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 82.605,
      "end_time": 89.317,
      "transcript": "ਧਨ ਥੀਈ ਦੁਬਲਿ ਕੰਤ ਹਾਵੈ"

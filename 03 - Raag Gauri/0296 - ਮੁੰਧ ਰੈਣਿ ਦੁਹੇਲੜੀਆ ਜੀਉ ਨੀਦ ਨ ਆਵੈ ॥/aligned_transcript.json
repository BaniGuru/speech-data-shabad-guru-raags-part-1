  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 12.671,
      "end_time": 25.062,
      "transcript": "ੴ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00002",
      "start_time": 25.062,
      "end_time": 38.079,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਪੂਰਬੀ ਛੰਤ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 51.045,
      "end_time": 57.435,
      "transcript": "ਮੁੰਧ ਰੈਣਿ ਦੁਹੇਲੜੀਆ ਜੀਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 57.435,
      "end_time": 63.385,
      "transcript": "ਨੀਦ ਨ ਆਵੈ"

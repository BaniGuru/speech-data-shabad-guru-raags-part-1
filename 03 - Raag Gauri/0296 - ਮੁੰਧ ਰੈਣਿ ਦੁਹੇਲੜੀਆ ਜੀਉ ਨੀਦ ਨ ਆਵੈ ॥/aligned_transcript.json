      "section_id": "section-00012",
      "start_time": 114.965,
      "end_time": 120.875,
      "transcript": "ਦੁਧਾ ਥਣੀ ਨ ਆਵਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 121.075,
      "end_time": 127.76,
      "transcript": "ਨਾਨਕ ਸਾ ਧਨ ਮਿਲੈ ਮਿਲਾਈ"

{
  "audio_file": "0149 F PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 6.525,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.795,
      "end_time": 19.035,
      "transcript": "ਸਾ ਮਤਿ ਨਿਰਮਲ, ਕਹੀਅਤ ਧੀਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.035,
      "end_time": 25.345,
      "transcript": "ਰਾਮ ਰਸਾਇਣੁ, ਪੀਵਤ ਬੀਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.64,
      "end_time": 31.835,
      "transcript": "ਹਰਿ ਕੇ ਚਰਣ, ਹਿਰਦੈ ਕਰਿ ਓਟ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.04,
      "end_time": 41.785,
      "transcript": "ਜਨਮ ਮਰਣ ਤੇ, ਹੋਵਤ ਛੋਟ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.16,
      "end_time": 54.485,
      "transcript": "ਸੋ ਤਨੁ ਨਿਰਮਲੁ, ਜਿਤੁ ਉਪਜੈ ਨ ਪਾਪੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.485,
      "end_time": 61.08,
      "transcript": "ਰਾਮ ਰੰਗਿ, ਨਿਰਮਲ ਪਰਤਾਪੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.08,
      "end_time": 67.275,
      "transcript": "ਸਾਧਸੰਗਿ, ਮਿਟਿ ਜਾਤ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.48,
      "end_time": 73.955,
      "transcript": "ਸਭ ਤੇ ਊਚ, ਏਹੋ ਉਪਕਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 80.4,
      "end_time": 86.748,
      "transcript": "ਪ੍ਰੇਮ ਭਗਤਿ, ਰਾਤੇ ਗੋਪਾਲ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.748,
      "end_time": 92.835,
      "transcript": "ਨਾਨਕ ਜਾਚੈ, ਸਾਧ ਰਵਾਲ"
    }
  ]
}

{
  "audio_file": "0174 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.075,
      "end_time": 6.74,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.925,
      "end_time": 19.52,
      "transcript": "ਗੁਰਮੁਖਿ ਸੇਵਾ, ਪ੍ਰਾਨ ਅਧਾਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.52,
      "end_time": 25.96,
      "transcript": "ਹਰਿ ਜੀਉ, ਰਾਖਹੁ ਹਿਰਦੈ ਉਰ ਧਾਰਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.96,
      "end_time": 32.36,
      "transcript": "ਗੁਰਮੁਖਿ ਸੋਭਾ, ਸਾਚ ਦੁਆਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.36,
      "end_time": 38.745,
      "transcript": "ਪੰਡਿਤ ਹਰਿ ਪੜੁ, ਤਜਹੁ ਵਿਕਾਰਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 38.745,
      "end_time": 48.445,
      "transcript": "ਗੁਰਮੁਖਿ, ਭਉਜਲੁ ਉਤਰਹੁ ਪਾਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.96,
      "end_time": 61.135,
      "transcript": "ਗੁਰਮੁਖਿ ਵਿਚਹੁ, ਹਉਮੈ ਜਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.52,
      "end_time": 67.685,
      "transcript": "ਗੁਰਮੁਖਿ, ਮੈਲੁ ਨ ਲਾਗੈ ਆਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.04,
      "end_time": 74.52,
      "transcript": "ਗੁਰਮੁਖਿ, ਨਾਮੁ ਵਸੈ ਮਨਿ ਆਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.52,
      "end_time": 80.94,
      "transcript": "ਗੁਰਮੁਖਿ, ਕਰਮ ਧਰਮ ਸਚਿ ਹੋਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.94,
      "end_time": 87.445,
      "transcript": "ਗੁਰਮੁਖਿ, ਅਹੰਕਾਰੁ ਜਲਾਏ ਦੋਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.445,
      "end_time": 94.185,
      "transcript": "ਗੁਰਮੁਖਿ ਨਾਮਿ ਰਤੇ, ਸੁਖੁ ਹੋਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 100.675,
      "end_time": 107.2,
      "transcript": "ਆਪਣਾ ਮਨੁ ਪਰਬੋਧਹੁ, ਬੂਝਹੁ ਸੋਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 107.2,
      "end_time": 113.64,
      "transcript": "ਲੋਕ ਸਮਝਾਵਹੁ, ਸੁਣੇ ਨ ਕੋਈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 113.64,
      "end_time": 120.08,
      "transcript": "ਗੁਰਮੁਖਿ ਸਮਝਹੁ, ਸਦਾ ਸੁਖੁ ਹੋਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 120.08,
      "end_time": 126.6,
      "transcript": "ਮਨਮੁਖਿ ਡੰਫੁ, ਬਹੁਤੁ ਚਤੁਰਾਈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 126.6,
      "end_time": 132.788,
      "transcript": "ਜੋ ਕਿਛੁ ਕਮਾਵੈ, ਸੁ ਥਾਇ ਨ ਪਾਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 132.788,
      "end_time": 139.445,
      "transcript": "ਆਵੈ ਜਾਵੈ, ਠਉਰ ਨ ਕਾਈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 145.84,
      "end_time": 152.2,
      "transcript": "ਮਨਮੁਖ ਕਰਮ ਕਰੇ, ਬਹੁਤੁ ਅਭਿਮਾਨਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 152.2,
      "end_time": 158.68,
      "transcript": "ਬਗ ਜਿਉ, ਲਾਇ ਬਹੈ ਨਿਤ ਧਿਆਨਾ"
    },
    {
      "section_id": "section-00021",
      "start_time": 158.68,
      "end_time": 165.145,
      "transcript": "ਜਮਿ ਪਕੜਿਆ, ਤਬ ਹੀ ਪਛੁਤਾਨਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 171.505,
      "end_time": 178.12,
      "transcript": "ਬਿਨੁ ਸਤਿਗੁਰ ਸੇਵੇ, ਮੁਕਤਿ ਨ ਹੋਈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 178.12,
      "end_time": 184.6,
      "transcript": "ਗੁਰ ਪਰਸਾਦੀ, ਮਿਲੈ ਹਰਿ ਸੋਈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 184.6,
      "end_time": 191.0,
      "transcript": "ਗੁਰੁ ਦਾਤਾ, ਜੁਗ ਚਾਰੇ ਹੋਈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 191.0,
      "end_time": 196.935,
      "transcript": "ਗੁਰਮੁਖਿ ਜਾਤਿ ਪਤਿ, ਨਾਮੇ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 197.48,
      "end_time": 203.84,
      "transcript": "ਸਾਇਰ ਕੀ ਪੁਤ੍ਰੀ, ਬਿਦਾਰਿ ਗਵਾਈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 203.84,
      "end_time": 209.615,
      "transcript": "ਨਾਨਕ ਬਿਨੁ ਨਾਵੈ, ਝੂਠੀ ਚਤੁਰਾਈ"
    }
  ]
}

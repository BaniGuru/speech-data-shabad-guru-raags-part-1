{
  "audio_file": "0191 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.56,
      "end_time": 6.035,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.692,
      "end_time": 14.402,
      "transcript": "ਅਤਿ ਸੁੰਦਰ ਕੁਲੀਨ ਚਤੁਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.402,
      "end_time": 21.837,
      "transcript": "ਮੁਖਿ ਙਿਆਨੀ ਧਨਵੰਤ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.837,
      "end_time": 29.656,
      "transcript": "ਮਿਰਤਕ ਕਹੀਅਹਿ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.656,
      "end_time": 38.095,
      "transcript": "ਜਿਹ ਪ੍ਰੀਤਿ ਨਹੀ ਭਗਵੰਤ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.44,
      "end_time": 47.96,
      "transcript": "ਙੰਙਾ, ਖਟੁ ਸਾਸਤ੍ਰ ਹੋਇ ਙਿਆਤਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 47.96,
      "end_time": 52.08,
      "transcript": "ਪੂਰਕੁ ਕੁੰਭਕ ਰੇਚਕ, ਕਰਮਾਤਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 52.08,
      "end_time": 56.235,
      "transcript": "ਙਿਆਨ ਧਿਆਨ, ਤੀਰਥ ਇਸਨਾਨੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 56.235,
      "end_time": 60.51,
      "transcript": "ਸੋਮਪਾਕ, ਅਪਰਸ ਉਦਿਆਨੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 60.51,
      "end_time": 64.76,
      "transcript": "ਰਾਮ ਨਾਮ ਸੰਗਿ, ਮਨਿ ਨਹੀ ਹੇਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 64.76,
      "end_time": 68.96,
      "transcript": "ਜੋ ਕਛੁ ਕੀਨੋ, ਸੋਊ ਅਨੇਤਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 68.96,
      "end_time": 73.09,
      "transcript": "ਉਆ ਤੇ ਊਤਮੁ ਗਨਉ, ਚੰਡਾਲਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 73.09,
      "end_time": 78.679,
      "transcript": "ਨਾਨਕ ਜਿਹ ਮਨਿ, ਬਸਹਿ ਗੁਪਾਲਾ"
    }
  ]
}

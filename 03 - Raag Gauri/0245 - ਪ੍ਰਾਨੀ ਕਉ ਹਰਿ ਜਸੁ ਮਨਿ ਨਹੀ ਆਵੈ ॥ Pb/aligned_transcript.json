    {
      "section_id": "section-00009",
      "start_time": 76.8,
      "end_time": 83.865,
      "transcript": "ਭੁਗਤਿ ਮੁਕਤਿ ਕਾ ਕਾਰਨੁ ਸੁਆਮੀ"

    {
      "section_id": "section-00004",
      "start_time": 30.84,
      "end_time": 41.905,
      "transcript": "ਕਹੁ ਕੈਸੇ ਗੁਨ ਗਾਵੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.16,
      "end_time": 53.245,
      "transcript": "ਪੂਤ ਮੀਤ ਮਾਇਆ ਮਮਤਾ ਸਿਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.84,
      "end_time": 60.835,
      "transcript": "ਇਹ ਬਿਧਿ ਆਪੁ ਬੰਧਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.4,
      "end_time": 68.485,
      "transcript": "ਮ੍ਰਿਗ ਤ੍ਰਿਸਨਾ ਜਿਉ ਝੂਠੋ ਇਹੁ ਜਗ"
    },
    {
      "section_id": "section-00008",
      "start_time": 69.155,
      "end_time": 76.315,
      "transcript": "ਦੇਖਿ ਤਾਸਿ ਉਠਿ ਧਾਵੈ"

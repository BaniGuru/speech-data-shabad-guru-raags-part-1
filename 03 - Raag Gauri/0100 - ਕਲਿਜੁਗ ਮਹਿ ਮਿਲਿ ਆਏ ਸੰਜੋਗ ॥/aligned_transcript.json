{
  "audio_file": "0140 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.25,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.36,
      "end_time": 21.338,
      "transcript": "ਕਲਿਜੁਗ ਮਹਿ, ਮਿਲਿ ਆਏ ਸੰਜੋਗ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.338,
      "end_time": 28.754,
      "transcript": "ਜਿਚਰੁ ਆਗਿਆ, ਤਿਚਰੁ ਭੋਗਹਿ ਭੋਗ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.68,
      "end_time": 42.513,
      "transcript": "ਜਲੈ ਨ ਪਾਈਐ, ਰਾਮ ਸਨੇਹੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.513,
      "end_time": 49.765,
      "transcript": "ਕਿਰਤਿ ਸੰਜੋਗਿ, ਸਤੀ ਉਠਿ ਹੋਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 60.28,
      "end_time": 67.24,
      "transcript": "ਦੇਖਾ ਦੇਖੀ, ਮਨਹਠਿ ਜਲਿ ਜਾਈਐ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.24,
      "end_time": 74.52,
      "transcript": "ਪ੍ਰਿਅ ਸੰਗੁ ਨ ਪਾਵੈ, ਬਹੁ ਜੋਨਿ ਭਵਾਈਐ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.52,
      "end_time": 81.52,
      "transcript": "ਸੀਲ ਸੰਜਮਿ, ਪ੍ਰਿਅ ਆਗਿਆ ਮਾਨੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.52,
      "end_time": 88.478,
      "transcript": "ਤਿਸੁ ਨਾਰੀ ਕਉ, ਦੁਖੁ ਨ ਜਮਾਨੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.478,
      "end_time": 95.84,
      "transcript": "ਕਹੁ ਨਾਨਕ ਜਿਨਿ ਪ੍ਰਿਉ ਪਰਮੇਸਰੁ ਕਰਿ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.84,
      "end_time": 102.81,
      "transcript": "ਧੰਨੁ ਸਤੀ, ਦਰਗਹ ਪਰਵਾਨਿਆ"
    }
  ]
}

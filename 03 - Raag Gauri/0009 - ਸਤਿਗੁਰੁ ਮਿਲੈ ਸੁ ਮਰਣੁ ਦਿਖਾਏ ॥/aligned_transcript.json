{
  "audio_file": "0116 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.008,
      "end_time": 6.564,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.08,
      "end_time": 21.042,
      "transcript": "ਸਤਿਗੁਰੁ ਮਿਲੈ, ਸੁ ਮਰਣੁ ਦਿਖਾਏ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.042,
      "end_time": 27.886,
      "transcript": "ਮਰਣ ਰਹਣ, ਰਸੁ ਅੰਤਰਿ ਭਾਏ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.886,
      "end_time": 35.008,
      "transcript": "ਗਰਬੁ ਨਿਵਾਰਿ, ਗਗਨ ਪੁਰੁ ਪਾਏ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.008,
      "end_time": 42.088,
      "transcript": "ਮਰਣੁ ਲਿਖਾਇ ਆਏ ਨਹੀ ਰਹਣਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.088,
      "end_time": 49.332,
      "transcript": "ਹਰਿ ਜਪਿ ਜਾਪਿ, ਰਹਣੁ ਹਰਿ ਸਰਣਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.36,
      "end_time": 63.271,
      "transcript": "ਸਤਿਗੁਰੁ ਮਿਲੈ, ਤ ਦੁਬਿਧਾ ਭਾਗੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.271,
      "end_time": 70.146,
      "transcript": "ਕਮਲੁ ਬਿਗਾਸਿ, ਮਨੁ ਹਰਿ ਪ੍ਰਭ ਲਾਗੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.146,
      "end_time": 77.3,
      "transcript": "ਜੀਵਤੁ ਮਰੈ, ਮਹਾ ਰਸੁ ਆਗੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.3,
      "end_time": 84.402,
      "transcript": "ਸਤਿਗੁਰਿ ਮਿਲਿਐ, ਸਚ ਸੰਜਮਿ ਸੂਚਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.402,
      "end_time": 91.386,
      "transcript": "ਗੁਰ ਕੀ ਪਉੜੀ, ਊਚੋ ਊਚਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 91.386,
      "end_time": 98.413,
      "transcript": "ਕਰਮਿ ਮਿਲੈ, ਜਮ ਕਾ ਭਉ ਮੂਚਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 98.413,
      "end_time": 105.628,
      "transcript": "ਗੁਰਿ ਮਿਲਿਐ ਮਿਲਿ ਅੰਕਿ ਸਮਾਇਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 105.628,
      "end_time": 112.636,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਘਰੁ ਮਹਲੁ ਦਿਖਾਇਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 112.636,
      "end_time": 119.72,
      "transcript": "ਨਾਨਕ ਹਉਮੈ ਮਾਰਿ ਮਿਲਾਇਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 119.72,
      "end_time": 127.722,
      "transcript": "ਨਾਨਕ ਹਉਮੈ ਮਾਰਿ ਮਿਲਾਇਆ"
    }
  ]
}

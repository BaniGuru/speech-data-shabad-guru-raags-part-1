{
  "audio_file": "0145 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 6.427,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.739,
      "end_time": 19.375,
      "transcript": "ਕਣ ਬਿਨਾ, ਜੈਸੇ ਥੋਥਰ ਤੁਖਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.605,
      "end_time": 25.828,
      "transcript": "ਨਾਮ ਬਿਹੂਨ, ਸੂਨੇ ਸੇ ਮੁਖਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.828,
      "end_time": 32.435,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਜਪਹੁ ਨਿਤ ਪ੍ਰਾਣੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.735,
      "end_time": 42.405,
      "transcript": "ਨਾਮ ਬਿਹੂਨ, ਧ੍ਰਿਗੁ ਦੇਹ ਬਿਗਾਨੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.885,
      "end_time": 55.4,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਨਾਹੀ ਮੁਖਿ ਭਾਗੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.4,
      "end_time": 61.785,
      "transcript": "ਭਰਤ ਬਿਹੂਨ, ਕਹਾ ਸੋਹਾਗੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.785,
      "end_time": 68.075,
      "transcript": "ਨਾਮੁ ਬਿਸਾਰਿ, ਲਗੈ ਅਨ ਸੁਆਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.44,
      "end_time": 74.695,
      "transcript": "ਤਾ ਕੀ ਆਸ, ਨ ਪੂਜੈ ਕਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.92,
      "end_time": 81.27,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਪ੍ਰਭ ਅਪਨੀ ਦਾਤਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.27,
      "end_time": 87.405,
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਜਪੈ, ਦਿਨ ਰਾਤਿ"
    }
  ]
}

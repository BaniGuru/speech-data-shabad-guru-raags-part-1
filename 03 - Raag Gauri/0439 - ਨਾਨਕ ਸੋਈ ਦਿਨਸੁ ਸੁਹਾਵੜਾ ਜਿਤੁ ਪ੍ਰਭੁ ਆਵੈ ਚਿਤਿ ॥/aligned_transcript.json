  "audio_file": "0235 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.215,
      "end_time": 6.891,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.891,
      "end_time": 18.205,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.415,
      "end_time": 39.295,
      "transcript": "ਨਾਨਕ ਸੋਈ ਦਿਨਸੁ ਸੁਹਾਵੜਾ, ਜਿਤੁ ਪ੍ਰਭੁ ਆਵੈ ਚਿਤਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 39.72,
      "end_time": 52.535,
      "transcript": "ਜਿਤੁ ਦਿਨਿ ਵਿਸਰੈ ਪਾਰਬ੍ਰਹਮੁ, ਫਿਟੁ ਭਲੇਰੀ ਰੁਤਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.535,
      "end_time": 59.205,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 65.615,
      "end_time": 71.815,
      "transcript": "ਨਾਨਕ ਮਿਤ੍ਰਾਈ ਤਿਸੁ ਸਿਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 72.2,
      "end_time": 78.485,
      "transcript": "ਸਭ ਕਿਛੁ ਜਿਸ ਕੈ ਹਾਥਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 78.485,
      "end_time": 84.895,
      "transcript": "ਕੁਮਿਤ੍ਰਾ ਸੇਈ ਕਾਂਢੀਅਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 85.28,
      "end_time": 91.245,
      "transcript": "ਇਕ ਵਿਖ ਨ ਚਲਹਿ ਸਾਥਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.76,
      "end_time": 96.175,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.08,
      "end_time": 112.305,
      "transcript": "ਅੰਮ੍ਰਿਤੁ ਨਾਮੁ ਨਿਧਾਨੁ ਹੈ, ਮਿਲਿ ਪੀਵਹੁ ਭਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 112.305,
      "end_time": 120.955,
      "transcript": "ਜਿਸੁ ਸਿਮਰਤ ਸੁਖੁ ਪਾਈਐ, ਸਭ ਤਿਖਾ ਬੁਝਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 120.955,
      "end_time": 129.415,
      "transcript": "ਕਰਿ ਸੇਵਾ ਪਾਰਬ੍ਰਹਮ ਗੁਰ, ਭੁਖ ਰਹੈ ਨ ਕਾਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 129.76,
      "end_time": 137.96,
      "transcript": "ਸਗਲ ਮਨੋਰਥ ਪੁੰਨਿਆ, ਅਮਰਾ ਪਦੁ ਪਾਈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 137.96,
      "end_time": 148.085,
      "transcript": "ਤੁਧੁ ਜੇਵਡੁ ਤੂਹੈ ਪਾਰਬ੍ਰਹਮ, ਨਾਨਕ ਸਰਣਾਈ"
    }
  ]
}

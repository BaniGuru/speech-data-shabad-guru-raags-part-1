{
  "audio_file": "0175 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.56,
      "end_time": 18.325,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 34.285,
      "end_time": 41.12,
      "transcript": "ਬ੍ਰਹਮਾ ਮੂਲੁ, ਵੇਦ ਅਭਿਆਸਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 41.12,
      "end_time": 47.36,
      "transcript": "ਤਿਸ ਤੇ ਉਪਜੇ, ਦੇਵ ਮੋਹ ਪਿਆਸਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 47.36,
      "end_time": 53.68,
      "transcript": "ਤ੍ਰੈ ਗੁਣ ਭਰਮੇ, ਨਾਹੀ ਨਿਜ ਘਰਿ ਵਾਸਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.68,
      "end_time": 59.915,
      "transcript": "ਹਮ ਹਰਿ ਰਾਖੇ, ਸਤਿਗੁਰੂ ਮਿਲਾਇਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 59.915,
      "end_time": 70.035,
      "transcript": "ਅਨਦਿਨੁ ਭਗਤਿ, ਹਰਿ ਨਾਮੁ ਦ੍ਰਿੜਾਇਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.242,
      "end_time": 81.84,
      "transcript": "ਤ੍ਰੈ ਗੁਣ ਬਾਣੀ ਬ੍ਰਹਮ, ਜੰਜਾਲਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 81.84,
      "end_time": 88.16,
      "transcript": "ਪੜਿ ਵਾਦੁ ਵਖਾਣਹਿ, ਸਿਰਿ ਮਾਰੇ ਜਮਕਾਲਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 88.16,
      "end_time": 94.325,
      "transcript": "ਤਤੁ ਨ ਚੀਨਹਿ, ਬੰਨਹਿ ਪੰਡ ਪਰਾਲਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 94.325,
      "end_time": 100.61,
      "transcript": "ਮਨਮੁਖ ਅਗਿਆਨਿ, ਕੁਮਾਰਗਿ ਪਾਏ"
    },
    {
      "section_id": "section-00011",
      "start_time": 100.61,
      "end_time": 107.04,
      "transcript": "ਹਰਿ ਨਾਮੁ ਬਿਸਾਰਿਆ, ਬਹੁ ਕਰਮ ਦ੍ਰਿੜਾਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 107.04,
      "end_time": 113.245,
      "transcript": "ਭਵਜਲਿ ਡੂਬੇ, ਦੂਜੈ ਭਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 113.245,
      "end_time": 119.58,
      "transcript": "ਮਾਇਆ ਕਾ ਮੁਹਤਾਜੁ, ਪੰਡਿਤੁ ਕਹਾਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 119.58,
      "end_time": 125.92,
      "transcript": "ਬਿਖਿਆ ਰਾਤਾ, ਬਹੁਤੁ ਦੁਖੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 125.92,
      "end_time": 132.205,
      "transcript": "ਜਮ ਕਾ ਗਲਿ ਜੇਵੜਾ, ਨਿਤ ਕਾਲੁ ਸੰਤਾਵੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 132.205,
      "end_time": 138.76,
      "transcript": "ਗੁਰਮੁਖਿ, ਜਮਕਾਲੁ ਨੇੜਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 138.76,
      "end_time": 145.08,
      "transcript": "ਹਉਮੈ ਦੂਜਾ, ਸਬਦਿ ਜਲਾਵੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 145.08,
      "end_time": 151.13,
      "transcript": "ਨਾਮੇ ਰਾਤੇ, ਹਰਿ ਗੁਣ ਗਾਵੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 151.13,
      "end_time": 157.71,
      "transcript": "ਮਾਇਆ ਦਾਸੀ, ਭਗਤਾ ਕੀ ਕਾਰ ਕਮਾਵੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 157.71,
      "end_time": 164.07,
      "transcript": "ਚਰਣੀ ਲਾਗੈ, ਤਾ ਮਹਲੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 164.07,
      "end_time": 170.505,
      "transcript": "ਸਦ ਹੀ ਨਿਰਮਲੁ, ਸਹਜਿ ਸਮਾਵੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 170.505,
      "end_time": 176.675,
      "transcript": "ਹਰਿ ਕਥਾ ਸੁਣਹਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 176.96,
      "end_time": 183.32,
      "transcript": "ਸੇ ਧਨਵੰਤ ਦਿਸਹਿ ਜੁਗ ਮਾਹੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 183.32,
      "end_time": 189.683,
      "transcript": "ਤਿਨ ਕਉ ਸਭਿ ਨਿਵਹਿ"
    },
    {
      "section_id": "section-00025",
      "start_time": 189.683,
      "end_time": 195.965,
      "transcript": "ਅਨਦਿਨੁ ਪੂਜ ਕਰਾਹੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 196.28,
      "end_time": 202.545,
      "transcript": "ਸਹਜੇ ਗੁਣ ਰਵਹਿ ਸਾਚੇ, ਮਨ ਮਾਹੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 202.8,
      "end_time": 209.04,
      "transcript": "ਪੂਰੈ ਸਤਿਗੁਰਿ, ਸਬਦੁ ਸੁਣਾਇਆ"
    },
    {
      "section_id": "section-00028",
      "start_time": 209.04,
      "end_time": 215.44,
      "transcript": "ਤ੍ਰੈ ਗੁਣ ਮੇਟੇ, ਚਉਥੈ ਚਿਤੁ ਲਾਇਆ"
    },
    {
      "section_id": "section-00029",
      "start_time": 215.44,
      "end_time": 221.545,
      "transcript": "ਨਾਨਕ ਹਉਮੈ ਮਾਰਿ, ਬ੍ਰਹਮ ਮਿਲਾਇਆ"
    }
  ]
}

{
  "audio_file": "0177 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.385,
      "end_time": 17.775,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 34.195,
      "end_time": 40.56,
      "transcript": "ਮਨ ਹੀ ਮਨੁ ਸਵਾਰਿਆ, ਭੈ ਸਹਜਿ ਸੁਭਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 40.56,
      "end_time": 46.84,
      "transcript": "ਸਬਦਿ ਮਨੁ ਰੰਗਿਆ, ਲਿਵ ਲਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 46.84,
      "end_time": 52.96,
      "transcript": "ਨਿਜ ਘਰਿ ਵਸਿਆ, ਪ੍ਰਭ ਕੀ ਰਜਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.96,
      "end_time": 59.205,
      "transcript": "ਸਤਿਗੁਰੁ ਸੇਵਿਐ, ਜਾਇ ਅਭਿਮਾਨੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 59.205,
      "end_time": 68.715,
      "transcript": "ਗੋਵਿਦੁ ਪਾਈਐ, ਗੁਣੀ ਨਿਧਾਨੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 74.825,
      "end_time": 81.085,
      "transcript": "ਮਨੁ ਬੈਰਾਗੀ, ਜਾ ਸਬਦਿ ਭਉ ਖਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 81.085,
      "end_time": 87.26,
      "transcript": "ਮੇਰਾ ਪ੍ਰਭੁ ਨਿਰਮਲਾ, ਸਭ ਤੈ ਰਹਿਆ ਸਮਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 87.26,
      "end_time": 93.52,
      "transcript": "ਗੁਰ ਕਿਰਪਾ ਤੇ, ਮਿਲੈ ਮਿਲਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 93.52,
      "end_time": 99.84,
      "transcript": "ਹਰਿ ਦਾਸਨ ਕੋ ਦਾਸੁ, ਸੁਖੁ ਪਾਏ"
    },
    {
      "section_id": "section-00011",
      "start_time": 99.84,
      "end_time": 106.24,
      "transcript": "ਮੇਰਾ ਹਰਿ ਪ੍ਰਭੁ, ਇਨ ਬਿਧਿ ਪਾਇਆ ਜਾਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.24,
      "end_time": 112.435,
      "transcript": "ਹਰਿ ਕਿਰਪਾ ਤੇ, ਰਾਮ ਗੁਣ ਗਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.435,
      "end_time": 118.725,
      "transcript": "ਧ੍ਰਿਗੁ ਬਹੁ ਜੀਵਣੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 118.725,
      "end_time": 125.04,
      "transcript": "ਜਿਤੁ ਹਰਿ ਨਾਮਿ ਨ ਲਗੈ ਪਿਆਰੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 125.04,
      "end_time": 131.44,
      "transcript": "ਧ੍ਰਿਗੁ ਸੇਜ ਸੁਖਾਲੀ, ਕਾਮਣਿ ਮੋਹ ਗੁਬਾਰੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 131.44,
      "end_time": 137.73,
      "transcript": "ਤਿਨ ਸਫਲੁ ਜਨਮੁ, ਜਿਨ ਨਾਮੁ ਅਧਾਰੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 137.73,
      "end_time": 143.855,
      "transcript": "ਧ੍ਰਿਗੁ ਧ੍ਰਿਗੁ ਗ੍ਰਿਹੁ ਕੁਟੰਬੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 144.12,
      "end_time": 150.055,
      "transcript": "ਜਿਤੁ ਹਰਿ ਪ੍ਰੀਤਿ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 150.52,
      "end_time": 156.605,
      "transcript": "ਸੋਈ ਹਮਾਰਾ ਮੀਤੁ"
    },
    {
      "section_id": "section-00020",
      "start_time": 156.805,
      "end_time": 162.895,
      "transcript": "ਜੋ ਹਰਿ ਗੁਣ ਗਾਵੈ ਸੋਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 163.28,
      "end_time": 169.513,
      "transcript": "ਹਰਿ ਨਾਮ ਬਿਨਾ, ਮੈ ਅਵਰੁ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00022",
      "start_time": 169.513,
      "end_time": 175.79,
      "transcript": "ਸਤਿਗੁਰ ਤੇ ਹਮ, ਗਤਿ ਪਤਿ ਪਾਈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 175.79,
      "end_time": 182.01,
      "transcript": "ਹਰਿ ਨਾਮੁ ਧਿਆਇਆ, ਦੂਖੁ ਸਗਲ ਮਿਟਾਈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 182.01,
      "end_time": 188.32,
      "transcript": "ਸਦਾ ਅਨੰਦੁ, ਹਰਿ ਨਾਮਿ ਲਿਵ ਲਾਈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 188.32,
      "end_time": 194.295,
      "transcript": "ਗੁਰਿ ਮਿਲਿਐ, ਹਮ ਕਉ ਸਰੀਰ ਸੁਧਿ ਭਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 194.68,
      "end_time": 200.835,
      "transcript": "ਹਉਮੈ ਤ੍ਰਿਸਨਾ, ਸਭ ਅਗਨਿ ਬੁਝਈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 200.835,
      "end_time": 206.975,
      "transcript": "ਬਿਨਸੇ ਕ੍ਰੋਧ, ਖਿਮਾ ਗਹਿ ਲਈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 207.24,
      "end_time": 213.565,
      "transcript": "ਹਰਿ ਆਪੇ ਕ੍ਰਿਪਾ ਕਰੇ, ਨਾਮੁ ਦੇਵੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 213.565,
      "end_time": 219.751,
      "transcript": "ਗੁਰਮੁਖਿ ਰਤਨੁ, ਕੋ ਵਿਰਲਾ ਲੇਵੈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 219.751,
      "end_time": 226.205,
      "transcript": "ਨਾਨਕੁ ਗੁਣ ਗਾਵੈ, ਹਰਿ ਅਲਖ ਅਭੇਵੈ"
    }
  ]
}

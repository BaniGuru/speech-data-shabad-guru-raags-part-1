{
  "audio_file": "0254 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.085,
      "end_time": 16.895,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਰਵਿਦਾਸ ਜੀ ਕੇ ਪਦੇ ਗਉੜੀ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 17.48,
      "end_time": 31.145,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 45.225,
      "end_time": 52.815,
      "transcript": "ਮੇਰੀ ਸੰਗਤਿ ਪੋਚ, ਸੋਚ ਦਿਨੁ ਰਾਤੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 53.04,
      "end_time": 60.395,
      "transcript": "ਮੇਰਾ ਕਰਮੁ ਕੁਟਿਲਤਾ, ਜਨਮੁ ਕੁਭਾਂਤੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 67.675,
      "end_time": 74.885,
      "transcript": "ਰਾਮ ਗੁਸਈਆ, ਜੀਅ ਕੇ ਜੀਵਨਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 75.24,
      "end_time": 83.815,
      "transcript": "ਮੋਹਿ ਨ ਬਿਸਾਰਹੁ, ਮੈ ਜਨੁ ਤੇਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 90.015,
      "end_time": 96.875,
      "transcript": "ਮੇਰੀ ਹਰਹੁ ਬਿਪਤਿ, ਜਨ ਕਰਹੁ ਸੁਭਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 97.48,
      "end_time": 104.715,
      "transcript": "ਚਰਣ ਨ ਛਾਡਉ, ਸਰੀਰ ਕਲ ਜਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 104.715,
      "end_time": 112.04,
      "transcript": "ਕਹੁ ਰਵਿਦਾਸ, ਪਰਉ ਤੇਰੀ ਸਾਭਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 112.04,
      "end_time": 119.385,
      "transcript": "ਬੇਗਿ ਮਿਲਹੁ ਜਨ, ਕਰਿ ਨ ਬਿਲਾਂਬਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 126.315,
      "end_time": 133.135,
      "transcript": "ਬੇਗਮ ਪੁਰਾ, ਸਹਰ ਕੋ ਨਾਉ"
    },
    {
      "section_id": "section-00012",
      "start_time": 133.545,
      "end_time": 140.185,
      "transcript": "ਦੂਖੁ ਅੰਦੋਹੁ ਨਹੀ, ਤਿਹਿ ਠਾਉ"
    },
    {
      "section_id": "section-00013",
      "start_time": 140.725,
      "end_time": 147.705,
      "transcript": "ਨਾਂ ਤਸਵੀਸ, ਖਿਰਾਜੁ ਨ ਮਾਲੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 148.04,
      "end_time": 155.185,
      "transcript": "ਖਉਫੁ ਨ ਖਤਾ, ਨ ਤਰਸੁ ਜਵਾਲੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 162.2,
      "end_time": 168.885,
      "transcript": "ਅਬ ਮੋਹਿ, ਖੂਬ ਵਤਨ ਗਹ ਪਾਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 169.48,
      "end_time": 177.585,
      "transcript": "ਊਹਾਂ ਖੈਰਿ ਸਦਾ, ਮੇਰੇ ਭਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 183.88,
      "end_time": 190.495,
      "transcript": "ਕਾਇਮੁ ਦਾਇਮੁ, ਸਦਾ ਪਾਤਿਸਾਹੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 190.96,
      "end_time": 197.605,
      "transcript": "ਦੋਮ ਨ ਸੇਮ, ਏਕ ਸੋ ਆਹੀ"
    },
    {
      "section_id": "section-00019",
      "start_time": 198.12,
      "end_time": 204.635,
      "transcript": "ਆਬਾਦਾਨੁ, ਸਦਾ ਮਸਹੂਰ"
    },
    {
      "section_id": "section-00020",
      "start_time": 205.16,
      "end_time": 212.295,
      "transcript": "ਊਹਾਂ ਗਨੀ ਬਸਹਿ, ਮਾਮੂਰ"
    },
    {
      "section_id": "section-00021",
      "start_time": 212.295,
      "end_time": 219.48,
      "transcript": "ਤਿਉ ਤਿਉ ਸੈਲ ਕਰਹਿ, ਜਿਉ ਭਾਵੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 219.48,
      "end_time": 226.56,
      "transcript": "ਮਹਰਮ ਮਹਲ, ਨ ਕੋ ਅਟਕਾਵੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 226.56,
      "end_time": 233.355,
      "transcript": "ਕਹਿ ਰਵਿਦਾਸ, ਖਲਾਸ ਚਮਾਰਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 233.725,
      "end_time": 240.875,
      "transcript": "ਜੋ ਹਮ ਸਹਰੀ, ਸੁ ਮੀਤੁ ਹਮਾਰਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 247.84,
      "end_time": 257.203,
      "transcript": "ਜੋ ਹਮ ਸਹਰੀ, ਸੁ ਮੀਤੁ ਹਮਾਰਾ"
    }
  ]
}

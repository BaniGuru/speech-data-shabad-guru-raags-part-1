    {
      "section_id": "section-00007",
      "start_time": 62.44,
      "end_time": 69.795,
      "transcript": "ਜੋ ਪ੍ਰਭ ਕੀ ਹਰਿ ਕਥਾ ਸੁਨਾਵੈ"

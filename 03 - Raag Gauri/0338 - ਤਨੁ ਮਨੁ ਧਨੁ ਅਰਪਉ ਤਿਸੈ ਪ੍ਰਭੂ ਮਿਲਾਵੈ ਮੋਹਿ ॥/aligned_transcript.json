{
  "audio_file": "0193 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.759,
      "end_time": 7.246,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.0,
      "end_time": 21.434,
      "transcript": "ਤਨੁ ਮਨੁ ਧਨੁ ਅਰਪਉ ਤਿਸੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.434,
      "end_time": 27.885,
      "transcript": "ਪ੍ਰਭੂ ਮਿਲਾਵੈ ਮੋਹਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.115,
      "end_time": 34.617,
      "transcript": "ਨਾਨਕ ਭ੍ਰਮ ਭਉ ਕਾਟੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.617,
      "end_time": 44.227,
      "transcript": "ਚੂਕੈ ਜਮ ਕੀ ਜੋਹ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.8,
      "end_time": 61.915,
      "transcript": "ਤਤਾ ਤਾ ਸਿਉ ਪ੍ਰੀਤਿ ਕਰਿ, ਗੁਣ ਨਿਧਿ ਗੋਬਿਦ ਰਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.24,
      "end_time": 70.645,
      "transcript": "ਫਲ ਪਾਵਹਿ ਮਨ ਬਾਛਤੇ, ਤਪਤਿ ਤੁਹਾਰੀ ਜਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.645,
      "end_time": 78.715,
      "transcript": "ਤ੍ਰਾਸ ਮਿਟੈ ਜਮ ਪੰਥ ਕੀ, ਜਾਸੁ ਬਸੈ ਮਨਿ ਨਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.04,
      "end_time": 87.18,
      "transcript": "ਗਤਿ ਪਾਵਹਿ ਮਤਿ ਹੋਇ ਪ੍ਰਗਾਸ ਮਹਲੀ, ਪਾਵਹਿ ਠਾਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.18,
      "end_time": 95.498,
      "transcript": "ਤਾਹੂ ਸੰਗਿ ਨ ਧਨੁ ਚਲੈ, ਗ੍ਰਿਹ ਜੋਬਨ ਨਹ ਰਾਜ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.498,
      "end_time": 103.695,
      "transcript": "ਸੰਤਸੰਗਿ ਸਿਮਰਤ ਰਹਹੁ, ਇਹੈ ਤੁਹਾਰੈ ਕਾਜ"
    },
    {
      "section_id": "section-00012",
      "start_time": 104.12,
      "end_time": 112.065,
      "transcript": "ਤਾਤਾ ਕਛੂ ਨ ਹੋਈ ਹੈ, ਜਉ ਤਾਪ ਨਿਵਾਰੈ ਆਪ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.52,
      "end_time": 121.775,
      "transcript": "ਪ੍ਰਤਿਪਾਲੈ ਨਾਨਕ ਹਮਹਿ, ਆਪਹਿ ਮਾਈ ਬਾਪ"
    }
  ]
}

{
  "audio_file": "0146 F Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.965,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.48,
      "end_time": 18.605,
      "transcript": "ਸਿਮਰਤ ਸੁਆਮੀ, ਕਿਲਵਿਖ ਨਾਸੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.605,
      "end_time": 24.935,
      "transcript": "ਸੂਖ ਸਹਜ, ਆਨੰਦ ਨਿਵਾਸੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.935,
      "end_time": 31.32,
      "transcript": "ਰਾਮ ਜਨਾ ਕਉ, ਰਾਮ ਭਰੋਸਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.32,
      "end_time": 38.865,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਸਭੁ ਮਿਟਿਓ ਅੰਦੇਸਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.8,
      "end_time": 52.605,
      "transcript": "ਸਾਧਸੰਗਿ, ਕਛੁ ਭਉ ਨ ਭਰਾਤੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.0,
      "end_time": 59.24,
      "transcript": "ਗੁਣ ਗੋਪਾਲ, ਗਾਈਅਹਿ ਦਿਨੁ ਰਾਤੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.24,
      "end_time": 65.48,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਪ੍ਰਭ ਬੰਧਨ ਛੋਟ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.48,
      "end_time": 71.955,
      "transcript": "ਚਰਣ ਕਮਲ ਕੀ, ਦੀਨੀ ਓਟ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.84,
      "end_time": 84.08,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਮਨਿ ਭਈ ਪਰਤੀਤਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.08,
      "end_time": 90.185,
      "transcript": "ਨਿਰਮਲ ਜਸੁ, ਪੀਵਹਿ ਜਨ ਨੀਤਿ"
    }
  ]
}

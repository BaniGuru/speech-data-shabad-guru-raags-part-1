{
  "audio_file": "0124 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.52,
      "end_time": 7.409,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.64,
      "end_time": 21.742,
      "transcript": "ਸਤਿਗੁਰ ਸੇਵਾ, ਸਫਲ ਹੈ ਬਣੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.742,
      "end_time": 28.74,
      "transcript": "ਜਿਤੁ ਮਿਲਿ ਹਰਿ ਨਾਮੁ ਧਿਆਇਆ ਹਰਿ ਧਣੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.0,
      "end_time": 35.69,
      "transcript": "ਜਿਨ ਹਰਿ ਜਪਿਆ, ਤਿਨ ਪੀਛੈ ਛੂਟੀ ਘਣੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.12,
      "end_time": 43.24,
      "transcript": "ਗੁਰਸਿਖ ਹਰਿ ਬੋਲਹੁ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.24,
      "end_time": 53.651,
      "transcript": "ਹਰਿ ਬੋਲਤ ਸਭ ਪਾਪ ਲਹਿ ਜਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.0,
      "end_time": 68.2,
      "transcript": "ਜਬ ਗੁਰੁ ਮਿਲਿਆ, ਤਬ ਮਨੁ ਵਸਿ ਆਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.2,
      "end_time": 75.28,
      "transcript": "ਧਾਵਤ ਪੰਚ ਰਹੇ, ਹਰਿ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.28,
      "end_time": 81.9,
      "transcript": "ਅਨਦਿਨੁ ਨਗਰੀ, ਹਰਿ ਗੁਣ ਗਾਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.4,
      "end_time": 89.52,
      "transcript": "ਸਤਿਗੁਰ ਪਗ ਧੂਰਿ, ਜਿਨਾ ਮੁਖਿ ਲਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 89.52,
      "end_time": 96.68,
      "transcript": "ਤਿਨ ਕੂੜ ਤਿਆਗੇ, ਹਰਿ ਲਿਵ ਲਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 96.68,
      "end_time": 103.68,
      "transcript": "ਤੇ ਹਰਿ ਦਰਗਹ, ਮੁਖ ਊਜਲ ਭਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 103.68,
      "end_time": 110.84,
      "transcript": "ਗੁਰ ਸੇਵਾ, ਆਪਿ ਹਰਿ ਭਾਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 110.84,
      "end_time": 117.759,
      "transcript": "ਕ੍ਰਿਸਨੁ ਬਲਭਦ੍ਰੁ, ਗੁਰ ਪਗ ਲਗਿ ਧਿਆਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 117.759,
      "end_time": 124.73,
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ, ਹਰਿ ਆਪਿ ਤਰਾਵੈ"
    }
  ]
}

{
  "audio_file": "0136 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.102,
      "end_time": 8.684,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 17.152,
      "end_time": 25.723,
      "transcript": "ਮਨੁ ਮੰਦਰੁ ਤਨੁ ਸਾਜੀ ਬਾਰਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.723,
      "end_time": 34.32,
      "transcript": "ਇਸ ਹੀ ਮਧੇ, ਬਸਤੁ ਅਪਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 34.32,
      "end_time": 42.8,
      "transcript": "ਇਸ ਹੀ ਭੀਤਰਿ, ਸੁਨੀਅਤ ਸਾਹੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.8,
      "end_time": 50.914,
      "transcript": "ਕਵਨੁ ਬਾਪਾਰੀ, ਜਾ ਕਾ ਊਹਾ ਵਿਸਾਹੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.914,
      "end_time": 59.664,
      "transcript": "ਨਾਮ ਰਤਨ, ਕੋ ਕੋ ਬਿਉਹਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.664,
      "end_time": 67.806,
      "transcript": "ਅੰਮ੍ਰਿਤ ਭੋਜਨੁ ਕਰੇ ਆਹਾਰੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.806,
      "end_time": 72.486,
      "transcript": "ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.04,
      "end_time": 89.6,
      "transcript": "ਮਨੁ ਤਨੁ ਅਰਪੀ, ਸੇਵ ਕਰੀਜੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 89.6,
      "end_time": 97.811,
      "transcript": "ਕਵਨ ਸੁ ਜੁਗਤਿ, ਜਿਤੁ ਕਰਿ ਭੀਜੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.811,
      "end_time": 106.64,
      "transcript": "ਪਾਇ ਲਗਉ ਤਜਿ ਮੇਰਾ ਤੇਰੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.64,
      "end_time": 114.942,
      "transcript": "ਕਵਨੁ ਸੁ ਜਨੁ, ਜੋ ਸਉਦਾ ਜੋਰੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.942,
      "end_time": 123.68,
      "transcript": "ਮਹਲੁ ਸਾਹ ਕਾ, ਕਿਨ ਬਿਧਿ ਪਾਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 123.68,
      "end_time": 131.835,
      "transcript": "ਕਵਨ ਸੁ ਬਿਧਿ ਜਿਤੁ ਭੀਤਰਿ ਬੁਲਾਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 132.12,
      "end_time": 140.72,
      "transcript": "ਤੂੰ ਵਡ ਸਾਹੁ ਜਾ ਕੇ ਕੋਟਿ ਵਣਜਾਰੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 140.72,
      "end_time": 149.164,
      "transcript": "ਕਵਨੁ ਸੁ ਦਾਤਾ, ਲੇ ਸੰਚਾਰੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 149.164,
      "end_time": 157.3,
      "transcript": "ਖੋਜਤ ਖੋਜਤ, ਨਿਜ ਘਰੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 157.3,
      "end_time": 165.984,
      "transcript": "ਅਮੋਲ ਰਤਨੁ, ਸਾਚੁ ਦਿਖਲਾਇਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 165.984,
      "end_time": 174.604,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਜਬ ਮੇਲੇ ਸਾਹਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 174.604,
      "end_time": 182.864,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਗੁਰ ਕੈ ਵੇਸਾਹਿ"
    }
  ]
}

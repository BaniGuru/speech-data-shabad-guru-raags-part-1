{
  "audio_file": "0236 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 4.795,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.815,
      "end_time": 18.43,
      "transcript": "ਨਾਨਕ ਆਏ ਸੇ ਪਰਵਾਣੁ ਹੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.43,
      "end_time": 24.615,
      "transcript": "ਜਿਨ ਹਰਿ ਵੁਠਾ ਚਿਤਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.055,
      "end_time": 31.426,
      "transcript": "ਗਾਲੀ੍ ਅਲ ਪਲਾਲੀਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.426,
      "end_time": 37.926,
      "transcript": "ਕੰਮਿ ਨ ਆਵਹਿ ਮਿਤ"
    },
    {
      "section_id": "section-00006",
      "start_time": 37.926,
      "end_time": 41.67,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.285,
      "end_time": 54.485,
      "transcript": "ਪਾਰਬ੍ਰਹਮੁ ਪ੍ਰਭੁ ਦ੍ਰਿਸਟੀ ਆਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 54.875,
      "end_time": 60.995,
      "transcript": "ਪੂਰਨ ਅਗਮ ਬਿਸਮਾਦ"
    },
    {
      "section_id": "section-00009",
      "start_time": 61.6,
      "end_time": 67.795,
      "transcript": "ਨਾਨਕ ਰਾਮ ਨਾਮੁ ਧਨੁ ਕੀਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.2,
      "end_time": 74.315,
      "transcript": "ਪੂਰੇ ਗੁਰ ਪਰਸਾਦਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 74.88,
      "end_time": 77.815,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 78.16,
      "end_time": 86.365,
      "transcript": "ਧੋਹੁ ਨ ਚਲੀ ਖਸਮ ਨਾਲਿ, ਲਬਿ ਮੋਹਿ ਵਿਗੁਤੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 86.68,
      "end_time": 95.205,
      "transcript": "ਕਰਤਬ ਕਰਨਿ ਭਲੇਰਿਆ, ਮਦਿ ਮਾਇਆ ਸੁਤੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 95.205,
      "end_time": 103.465,
      "transcript": "ਫਿਰਿ ਫਿਰਿ ਜੂਨਿ ਭਵਾਈਅਨਿ, ਜਮ ਮਾਰਗਿ ਮੁਤੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 104.075,
      "end_time": 112.025,
      "transcript": "ਕੀਤਾ ਪਾਇਨਿ ਆਪਣਾ, ਦੁਖ ਸੇਤੀ ਜੁਤੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 112.32,
      "end_time": 121.301,
      "transcript": "ਨਾਨਕ ਨਾਇ ਵਿਸਾਰਿਐ, ਸਭ ਮੰਦੀ ਰੁਤੇ"
    }
  ]
}

{
  "audio_file": "0179 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.825,
      "end_time": 14.988,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ ਅਸਟਪਦੀਆ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.72,
      "end_time": 32.745,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 44.855,
      "end_time": 52.575,
      "transcript": "ਜਬ ਇਹੁ, ਮਨ ਮਹਿ ਕਰਤ ਗੁਮਾਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 52.575,
      "end_time": 60.055,
      "transcript": "ਤਬ ਇਹੁ, ਬਾਵਰੁ ਫਿਰਤ ਬਿਗਾਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 60.055,
      "end_time": 67.61,
      "transcript": "ਜਬ ਇਹੁ ਹੂਆ, ਸਗਲ ਕੀ ਰੀਨਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.61,
      "end_time": 74.965,
      "transcript": "ਤਾ ਤੇ ਰਮਈਆ, ਘਟਿ ਘਟਿ ਚੀਨਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 74.965,
      "end_time": 82.52,
      "transcript": "ਸਹਜ ਸੁਹੇਲਾ, ਫਲੁ ਮਸਕੀਨੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 82.52,
      "end_time": 90.045,
      "transcript": "ਸਤਿਗੁਰ ਅਪੁਨੈ, ਮੋਹਿ ਦਾਨੁ ਦੀਨੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 101.105,
      "end_time": 108.395,
      "transcript": "ਜਬ ਕਿਸ ਕਉ, ਇਹੁ ਜਾਨਸਿ ਮੰਦਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 108.64,
      "end_time": 115.801,
      "transcript": "ਤਬ ਸਗਲੇ, ਇਸੁ ਮੇਲਹਿ ਫੰਦਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 115.801,
      "end_time": 123.295,
      "transcript": "ਮੇਰ ਤੇਰ, ਜਬ ਇਨਹਿ ਚੁਕਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 123.295,
      "end_time": 130.46,
      "transcript": "ਤਾ ਤੇ ਇਸੁ ਸੰਗਿ, ਨਹੀ ਬੈਰਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 130.46,
      "end_time": 137.715,
      "transcript": "ਜਬ ਇਨਿ, ਅਪੁਨੀ ਅਪਨੀ ਧਾਰੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 138.12,
      "end_time": 145.115,
      "transcript": "ਤਬ ਇਸ ਕਉ, ਹੈ ਮੁਸਕਲੁ ਭਾਰੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 145.425,
      "end_time": 152.405,
      "transcript": "ਜਬ ਇਨਿ, ਕਰਣੈਹਾਰੁ ਪਛਾਤਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 152.84,
      "end_time": 159.755,
      "transcript": "ਤਬ ਇਸ ਨੋ, ਨਾਹੀ ਕਿਛੁ ਤਾਤਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 160.24,
      "end_time": 167.375,
      "transcript": "ਜਬ ਇਨਿ, ਅਪੁਨੋ ਬਾਧਿਓ ਮੋਹਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 167.655,
      "end_time": 174.605,
      "transcript": "ਆਵੈ ਜਾਇ, ਸਦਾ ਜਮਿ ਜੋਹਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 175.045,
      "end_time": 182.56,
      "transcript": "ਜਬ ਇਸ ਤੇ, ਸਭ ਬਿਨਸੇ ਭਰਮਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 182.56,
      "end_time": 189.655,
      "transcript": "ਭੇਦੁ ਨਾਹੀ, ਹੈ ਪਾਰਬ੍ਰਹਮਾ"
    },
    {
      "section_id": "section-00021",
      "start_time": 197.055,
      "end_time": 204.6,
      "transcript": "ਜਬ ਇਨਿ, ਕਿਛੁ ਕਰਿ ਮਾਨੇ ਭੇਦਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 204.6,
      "end_time": 211.965,
      "transcript": "ਤਬ ਤੇ ਦੂਖ, ਡੰਡ ਅਰੁ ਖੇਦਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 211.965,
      "end_time": 219.295,
      "transcript": "ਜਬ ਇਨਿ, ਏਕੋ ਏਕੀ ਬੂਝਿਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 219.295,
      "end_time": 226.605,
      "transcript": "ਤਬ ਤੇ ਇਸ ਨੋ, ਸਭੁ ਕਿਛੁ ਸੂਝਿਆ"
    },
    {
      "section_id": "section-00025",
      "start_time": 234.2,
      "end_time": 241.41,
      "transcript": "ਜਬ ਇਹੁ ਧਾਵੈ, ਮਾਇਆ ਅਰਥੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 241.41,
      "end_time": 248.885,
      "transcript": "ਨਹ ਤ੍ਰਿਪਤਾਵੈ, ਨਹ ਤਿਸ ਲਾਥੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 248.885,
      "end_time": 255.945,
      "transcript": "ਜਬ ਇਸ ਤੇ, ਇਹੁ ਹੋਇਓ ਜਉਲਾ"
    },
    {
      "section_id": "section-00028",
      "start_time": 256.52,
      "end_time": 263.84,
      "transcript": "ਪੀਛੈ ਲਾਗਿ ਚਲੀ, ਉਠਿ ਕਉਲਾ"
    },
    {
      "section_id": "section-00029",
      "start_time": 263.84,
      "end_time": 271.145,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਜਉ ਸਤਿਗੁਰੁ ਮਿਲਿਓ"
    },
    {
      "section_id": "section-00030",
      "start_time": 271.145,
      "end_time": 278.42,
      "transcript": "ਮਨ ਮੰਦਰ ਮਹਿ, ਦੀਪਕੁ ਜਲਿਓ"
    },
    {
      "section_id": "section-00031",
      "start_time": 278.42,
      "end_time": 285.445,
      "transcript": "ਜੀਤ ਹਾਰ ਕੀ ਸੋਝੀ ਕਰੀ"
    },
    {
      "section_id": "section-00032",
      "start_time": 285.96,
      "end_time": 292.855,
      "transcript": "ਤਉ ਇਸੁ ਘਰ ਕੀ, ਕੀਮਤਿ ਪਰੀ"
    },
    {
      "section_id": "section-00033",
      "start_time": 293.4,
      "end_time": 300.565,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਸਭੁ ਕਿਛੁ ਏਕੈ"
    },
    {
      "section_id": "section-00034",
      "start_time": 300.815,
      "end_time": 308.055,
      "transcript": "ਆਪੇ ਬੁਧਿ ਬੀਚਾਰਿ ਬਿਬੇਕੈ"
    },
    {
      "section_id": "section-00035",
      "start_time": 308.055,
      "end_time": 315.055,
      "transcript": "ਦੂਰਿ ਨ ਨੇਰੈ, ਸਭ ਕੈ ਸੰਗਾ"
    },
    {
      "section_id": "section-00036",
      "start_time": 315.515,
      "end_time": 322.265,
      "transcript": "ਸਚੁ ਸਾਲਾਹਣੁ, ਨਾਨਕ ਹਰਿ ਰੰਗਾ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.265,
      "end_time": 5.765,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.375,
      "end_time": 21.08,
      "transcript": "ਆਠ ਪਹਰ ਗੁਨ ਗਾਈਅਹਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.08,
      "end_time": 27.065,
      "transcript": "ਤਜੀਅਹਿ ਅਵਰਿ ਜੰਜਾਲ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.6,
      "end_time": 33.855,
      "transcript": "ਜਮਕੰਕਰੁ ਜੋਹਿ ਨ ਸਕਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.135,
      "end_time": 43.975,
      "transcript": "ਨਾਨਕ ਪ੍ਰਭੂ ਦਇਆਲ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.88,
      "end_time": 62.105,
      "transcript": "ਅਸਟਮੀ ਅਸਟ ਸਿਧਿ ਨਵ ਨਿਧਿ ਸਗਲ ਪਦਾਰਥ, ਪੂਰਨ ਬੁਧਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.105,
      "end_time": 66.56,
      "transcript": "ਕਵਲ ਪ੍ਰਗਾਸ ਸਦਾ ਆਨੰਦ"
    },
    {
      "section_id": "section-00008",
      "start_time": 66.56,
      "end_time": 70.655,
      "transcript": "ਨਿਰਮਲ ਰੀਤਿ, ਨਿਰੋਧਰ ਮੰਤ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.655,
      "end_time": 74.725,
      "transcript": "ਸਗਲ ਧਰਮ, ਪਵਿਤ੍ਰ ਇਸਨਾਨੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.725,
      "end_time": 79.24,
      "transcript": "ਸਭ ਮਹਿ ਊਚ, ਬਿਸੇਖ ਗਿਆਨੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.24,
      "end_time": 87.715,
      "transcript": "ਹਰਿ ਹਰਿ ਭਜਨੁ, ਪੂਰੇ ਗੁਰ ਸੰਗਿ ਜਪਿ ਤਰੀਐ ਨਾਨਕ, ਨਾਮ ਹਰਿ ਰੰਗਿ"
    }
  ]
}

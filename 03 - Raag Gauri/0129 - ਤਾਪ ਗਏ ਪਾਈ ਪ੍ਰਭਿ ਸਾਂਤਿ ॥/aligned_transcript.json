{
  "audio_file": "0144 FPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.135,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.48,
      "end_time": 18.575,
      "transcript": "ਤਾਪ ਗਏ, ਪਾਈ ਪ੍ਰਭਿ ਸਾਂਤਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.575,
      "end_time": 24.92,
      "transcript": "ਸੀਤਲ ਭਏ, ਕੀਨੀ ਪ੍ਰਭ ਦਾਤਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.92,
      "end_time": 30.855,
      "transcript": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ, ਭਏ ਸੁਹੇਲੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.855,
      "end_time": 38.875,
      "transcript": "ਜਨਮ ਜਨਮ ਕੇ, ਬਿਛੁਰੇ ਮੇਲੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.72,
      "end_time": 53.0,
      "transcript": "ਸਿਮਰਤ ਸਿਮਰਤ, ਪ੍ਰਭ ਕਾ ਨਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.0,
      "end_time": 59.195,
      "transcript": "ਸਗਲ ਰੋਗ ਕਾ, ਬਿਨਸਿਆ ਥਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.195,
      "end_time": 65.095,
      "transcript": "ਸਹਜਿ ਸੁਭਾਇ, ਬੋਲੈ ਹਰਿ ਬਾਣੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.465,
      "end_time": 71.685,
      "transcript": "ਆਠ ਪਹਰ, ਪ੍ਰਭ ਸਿਮਰਹੁ ਪ੍ਰਾਣੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.84,
      "end_time": 83.995,
      "transcript": "ਦੂਖੁ ਦਰਦੁ ਜਮੁ, ਨੇੜਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.995,
      "end_time": 90.205,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜੋ ਹਰਿ ਗੁਨ ਗਾਵੈ"
    }
  ]
}

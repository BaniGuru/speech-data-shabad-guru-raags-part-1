{
  "audio_file": "0222 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.213,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.725,
      "end_time": 20.281,
      "transcript": "ਨਾਰਾਇਣੁ ਨਹ ਸਿਮਰਿਓ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.281,
      "end_time": 26.535,
      "transcript": "ਮੋਹਿਓ ਸੁਆਦ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.115,
      "end_time": 33.305,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਬਿਸਾਰਿਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.76,
      "end_time": 43.865,
      "transcript": "ਨਰਕ ਸੁਰਗ ਅਵਤਾਰ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.495,
      "end_time": 62.0,
      "transcript": "ਨਉਮੀ ਨਵੇ ਛਿਦ੍ਰ ਅਪਵੀਤ ਹਰਿ ਨਾਮੁ ਨ ਜਪਹਿ, ਕਰਤ ਬਿਪਰੀਤਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.0,
      "end_time": 66.068,
      "transcript": "ਪਰ ਤ੍ਰਿਅ ਰਮਹਿ, ਬਕਹਿ ਸਾਧ ਨਿੰਦ"
    },
    {
      "section_id": "section-00008",
      "start_time": 66.068,
      "end_time": 70.365,
      "transcript": "ਕਰਨ ਨ ਸੁਨਹੀ, ਹਰਿ ਜਸੁ ਬਿੰਦ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.365,
      "end_time": 74.585,
      "transcript": "ਹਿਰਹਿ ਪਰ ਦਰਬੁ, ਉਦਰ ਕੈ ਤਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.585,
      "end_time": 78.628,
      "transcript": "ਅਗਨਿ ਨ ਨਿਵਰੈ, ਤ੍ਰਿਸਨਾ ਨ ਬੁਝਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 78.628,
      "end_time": 87.189,
      "transcript": "ਹਰਿ ਸੇਵਾ ਬਿਨੁ, ਏਹ ਫਲ ਲਾਗੇ ਨਾਨਕ ਪ੍ਰਭ ਬਿਸਰਤ, ਮਰਿ ਜਮਹਿ ਅਭਾਗੇ"
    }
  ]
}

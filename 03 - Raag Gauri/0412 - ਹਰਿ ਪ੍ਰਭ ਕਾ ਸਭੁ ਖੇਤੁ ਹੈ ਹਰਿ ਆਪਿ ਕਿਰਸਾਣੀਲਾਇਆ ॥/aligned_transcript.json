{
  "audio_file": "0226 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.2,
      "end_time": 7.759,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.759,
      "end_time": 15.127,
      "transcript": "ਮਹਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 15.127,
      "end_time": 20.587,
      "transcript": "ਚੌਥਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.56,
      "end_time": 38.465,
      "transcript": "ਹਰਿ ਪ੍ਰਭ ਕਾ ਸਭੁ ਖੇਤੁ ਹੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.0,
      "end_time": 45.925,
      "transcript": "ਹਰਿ ਆਪਿ ਕਿਰਸਾਣੀ ਲਾਇਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.315,
      "end_time": 53.45,
      "transcript": "ਗੁਰਮੁਖਿ ਬਖਸਿ ਜਮਾਈਅਨੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.45,
      "end_time": 60.215,
      "transcript": "ਮਨਮੁਖੀ ਮੂਲੁ ਗਵਾਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.88,
      "end_time": 68.005,
      "transcript": "ਸਭੁ ਕੋ ਬੀਜੇ ਆਪਣੇ ਭਲੇ ਨੋ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.005,
      "end_time": 74.675,
      "transcript": "ਹਰਿ ਭਾਵੈ ਸੋ ਖੇਤੁ ਜਮਾਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.225,
      "end_time": 81.885,
      "transcript": "ਗੁਰਸਿਖੀ ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਬੀਜਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 82.44,
      "end_time": 89.345,
      "transcript": "ਹਰਿ ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਫਲੁ ਅੰਮ੍ਰਿਤੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 89.345,
      "end_time": 96.64,
      "transcript": "ਜਮੁ ਚੂਹਾ ਕਿਰਸ ਨਿਤ ਕੁਰਕਦਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 96.64,
      "end_time": 103.325,
      "transcript": "ਹਰਿ ਕਰਤੈ ਮਾਰਿ ਕਢਾਇਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 103.72,
      "end_time": 110.75,
      "transcript": "ਕਿਰਸਾਣੀ ਜੰਮੀ ਭਾਉ ਕਰਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 110.75,
      "end_time": 117.445,
      "transcript": "ਹਰਿ ਬੋਹਲ ਬਖਸ ਜਮਾਇਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 117.88,
      "end_time": 124.8,
      "transcript": "ਤਿਨ ਕਾ ਕਾੜਾ ਅੰਦੇਸਾ ਸਭੁ ਲਾਹਿਓਨੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 124.8,
      "end_time": 132.01,
      "transcript": "ਜਿਨੀ ਸਤਿਗੁਰੁ ਪੁਰਖੁ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 132.01,
      "end_time": 138.475,
      "transcript": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਅਰਾਧਿਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 139.115,
      "end_time": 146.155,
      "transcript": "ਆਪਿ ਤਰਿਆ ਸਭੁ ਜਗਤੁ ਤਰਾਇਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 147.295,
      "end_time": 153.285,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00021",
      "start_time": 162.235,
      "end_time": 168.995,
      "transcript": "ਸਾਰਾ ਦਿਨੁ ਲਾਲਚਿ ਅਟਿਆ"
    },
    {
      "section_id": "section-00022",
      "start_time": 169.52,
      "end_time": 175.995,
      "transcript": "ਮਨਮੁਖਿ ਹੋਰੇ ਗਲਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 176.715,
      "end_time": 183.435,
      "transcript": "ਰਾਤੀ ਊਘੈ ਦਬਿਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 183.975,
      "end_time": 190.445,
      "transcript": "ਨਵੇ ਸੋਤ ਸਭਿ ਢਿਲਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 191.065,
      "end_time": 198.155,
      "transcript": "ਮਨਮੁਖਾ ਦੈ ਸਿਰਿ ਜੋਰਾ ਅਮਰੁ ਹੈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 198.155,
      "end_time": 204.795,
      "transcript": "ਨਿਤ ਦੇਵਹਿ ਭਲਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 205.215,
      "end_time": 212.215,
      "transcript": "ਜੋਰਾ ਦਾ ਆਖਿਆ ਪੁਰਖ ਕਮਾਵਦੇ"
    },
    {
      "section_id": "section-00028",
      "start_time": 212.215,
      "end_time": 219.215,
      "transcript": "ਸੇ ਅਪਵਿਤ ਅਮੇਧ ਖਲਾ"
    },
    {
      "section_id": "section-00029",
      "start_time": 219.48,
      "end_time": 226.56,
      "transcript": "ਕਾਮਿ ਵਿਆਪੇ ਕੁਸੁਧ ਨਰ"
    },
    {
      "section_id": "section-00030",
      "start_time": 226.56,
      "end_time": 233.085,
      "transcript": "ਸੇ ਜੋਰਾ ਪੁਛਿ ਚਲਾ"
    },
    {
      "section_id": "section-00031",
      "start_time": 233.52,
      "end_time": 240.065,
      "transcript": "ਸਤਿਗੁਰ ਕੈ ਆਖਿਐ ਜੋ ਚਲੈ"
    },
    {
      "section_id": "section-00032",
      "start_time": 240.56,
      "end_time": 247.075,
      "transcript": "ਸੋ ਸਤਿ ਪੁਰਖੁ ਭਲ ਭਲਾ"
    },
    {
      "section_id": "section-00033",
      "start_time": 247.435,
      "end_time": 261.275,
      "transcript": "ਜੋਰਾ ਪੁਰਖ ਸਭਿ ਆਪਿ ਉਪਾਇਅਨੁ, ਹਰਿ ਖੇਲ ਸਭਿ ਖਿਲਾ"
    },
    {
      "section_id": "section-00034",
      "start_time": 261.52,
      "end_time": 268.293,
      "transcript": "ਸਭ ਤੇਰੀ ਬਣਤ ਬਣਾਵਣੀ"
    },
    {
      "section_id": "section-00035",
      "start_time": 268.293,
      "end_time": 278.455,
      "transcript": "ਨਾਨਕ ਭਲ ਭਲਾ ਪਉੜੀ"
    },
    {
      "section_id": "section-00036",
      "start_time": 288.68,
      "end_time": 297.265,
      "transcript": "ਤੂ ਵੇਪਰਵਾਹੁ ਅਥਾਹੁ ਹੈ, ਅਤੁਲੁ ਕਿਉ ਤੁਲੀਐ"
    },
    {
      "section_id": "section-00037",
      "start_time": 297.68,
      "end_time": 306.115,
      "transcript": "ਸੇ ਵਡਭਾਗੀ ਜਿ ਤੁਧੁ ਧਿਆਇਦੇ, ਜਿਨ ਸਤਿਗੁਰੁ ਮਿਲੀਐ"
    },
    {
      "section_id": "section-00038",
      "start_time": 306.6,
      "end_time": 315.135,
      "transcript": "ਸਤਿਗੁਰ ਕੀ ਬਾਣੀ ਸਤਿ ਸਰੂਪੁ ਹੈ, ਗੁਰਬਾਣੀ ਬਣੀਐ"
    },
    {
      "section_id": "section-00039",
      "start_time": 315.52,
      "end_time": 324.39,
      "transcript": "ਸਤਿਗੁਰ ਕੀ ਰੀਸੈ ਹੋਰਿ ਕਚੁ ਪਿਚੁ ਬੋਲਦੇ, ਸੇ ਕੂੜਿਆਰ ਕੂੜੇ ਝੜਿ ਪੜੀਐ"
    },
    {
      "section_id": "section-00040",
      "start_time": 324.39,
      "end_time": 333.175,
      "transcript": "ਓਨਾ੍ ਅੰਦਰਿ ਹੋਰੁ ਮੁਖਿ ਹੋਰੁ ਹੈ, ਬਿਖੁ ਮਾਇਆ ਨੋ ਝਖਿ ਮਰਦੇ ਕੜੀਐ"
    }
  ]
}

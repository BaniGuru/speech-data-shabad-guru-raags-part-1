{
  "audio_file": "0147 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.175,
      "end_time": 7.253,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.797,
      "end_time": 19.215,
      "transcript": "ਪ੍ਰਭ ਕੇ ਚਰਨ, ਮਨ ਮਾਹਿ ਧਿਆਨੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.215,
      "end_time": 25.71,
      "transcript": "ਸਗਲ ਤੀਰਥ, ਮਜਨ ਇਸਨਾਨੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.71,
      "end_time": 32.099,
      "transcript": "ਹਰਿ ਦਿਨੁ, ਹਰਿ ਸਿਮਰਨੁ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.099,
      "end_time": 41.875,
      "transcript": "ਕੋਟਿ ਜਨਮ ਕੀ, ਮਲੁ ਲਹਿ ਜਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.36,
      "end_time": 54.8,
      "transcript": "ਹਰਿ ਕੀ ਕਥਾ, ਰਿਦ ਮਾਹਿ ਬਸਾਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.8,
      "end_time": 61.243,
      "transcript": "ਮਨ ਬਾਂਛਤ, ਸਗਲੇ ਫਲ ਪਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.243,
      "end_time": 67.665,
      "transcript": "ਜੀਵਨ ਮਰਣੁ, ਜਨਮੁ ਪਰਵਾਨੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.665,
      "end_time": 74.335,
      "transcript": "ਜਾ ਕੈ ਰਿਦੈ, ਵਸੈ ਭਗਵਾਨੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.335,
      "end_time": 80.699,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਸੇਈ ਜਨ ਪੂਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.699,
      "end_time": 86.895,
      "transcript": "ਜਿਨਾ ਪਰਾਪਤਿ, ਸਾਧੂ ਧੂਰੇ"
    }
  ]
}

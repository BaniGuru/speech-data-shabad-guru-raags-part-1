    {
      "section_id": "section-00002",
      "start_time": 12.44,
      "end_time": 18.175,
      "transcript": "ਭਲੇ ਦਿਨਸ, ਭਲੇ ਸੰਜੋਗ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.52,
      "end_time": 24.435,
      "transcript": "ਜਿਤੁ ਭੇਟੇ, ਪਾਰਬ੍ਰਹਮ ਨਿਰਜੋਗ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.8,
      "end_time": 30.845,
      "transcript": "ਓਹ ਬੇਲਾ ਕਉ, ਹਉ ਬਲਿ ਜਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.845,
      "end_time": 38.525,
      "transcript": "ਜਿਤੁ ਮੇਰਾ ਮਨੁ, ਜਪੈ ਹਰਿ ਨਾਉ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.52,
      "end_time": 52.68,
      "transcript": "ਸਫਲ ਮੂਰਤੁ, ਸਫਲ ਓਹ ਘਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.68,
      "end_time": 59.0,
      "transcript": "ਜਿਤੁ ਰਸਨਾ ਉਚਰੈ, ਹਰਿ ਹਰੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.0,
      "end_time": 65.32,
      "transcript": "ਸਫਲੁ ਓਹੁ ਮਾਥਾ, ਸੰਤ ਨਮਸਕਾਰਸਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.32,
      "end_time": 71.933,
      "transcript": "ਚਰਣ ਪੁਨੀਤ, ਚਲਹਿ ਹਰਿ ਮਾਰਗਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.828,
      "end_time": 83.917,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਭਲਾ ਮੇਰਾ ਕਰਮ"

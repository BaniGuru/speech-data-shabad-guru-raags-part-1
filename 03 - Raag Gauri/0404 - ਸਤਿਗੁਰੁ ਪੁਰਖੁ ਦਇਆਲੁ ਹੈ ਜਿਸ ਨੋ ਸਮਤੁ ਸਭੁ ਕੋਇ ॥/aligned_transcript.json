  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.655,
      "end_time": 13.678,
      "transcript": "ਗਉੜੀ ਕੀ ਵਾਰ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.678,
      "end_time": 27.972,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 31.16,
      "end_time": 36.418,
      "transcript": "ਇਕਓਅੰਕਾਰਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 36.418,
      "end_time": 54.56,
      "transcript": "ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ਅ"
    },
    {
      "section_id": "section-00005",
      "start_time": 56.08,
      "end_time": 61.695,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 63.32,
      "end_time": 71.587,
      "transcript": "ਸਤਿਗੁਰੁ ਪੁਰਖੁ ਦਇਆਲੁ ਹੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 71.587,
      "end_time": 79.435,
      "transcript": "ਜਿਸ ਨੋ ਸਮਤੁ ਸਭੁ ਕੋਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 79.88,
      "end_time": 87.705,
      "transcript": "ਏਕ ਦ੍ਰਿਸਟਿ ਕਰਿ ਦੇਖਦਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 88.0,
      "end_time": 94.92,
      "transcript": "ਮਨ ਭਾਵਨੀ ਤੇ ਸਿਧਿ ਹੋਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 95.768,
      "end_time": 103.595,
      "transcript": "ਸਤਿਗੁਰ ਵਿਚਿ ਅੰਮ੍ਰਿਤੁ ਹੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.04,
      "end_time": 110.655,
      "transcript": "ਹਰਿ ਉਤਮੁ ਹਰਿ ਪਦੁ ਸੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 111.965,
      "end_time": 119.535,
      "transcript": "ਨਾਨਕ ਕਿਰਪਾ ਤੇ ਹਰਿ ਧਿਆਈਐ"
    },
    {
      "section_id": "section-00013",
      "start_time": 119.96,
      "end_time": 131.625,
      "transcript": "ਗੁਰਮੁਖਿ ਪਾਵੈ ਕੋਇ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 139.64,
      "end_time": 147.025,
      "transcript": "ਹਉਮੈ ਮਾਇਆ ਸਭ ਬਿਖੁ ਹੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 147.48,
      "end_time": 154.932,
      "transcript": "ਨਿਤ ਜਗਿ ਤੋਟਾ ਸੰਸਾਰਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 154.932,
      "end_time": 162.675,
      "transcript": "ਲਾਹਾ ਹਰਿ ਧਨੁ ਖਟਿਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 163.095,
      "end_time": 170.705,
      "transcript": "ਗੁਰਮੁਖਿ ਸਬਦੁ ਵੀਚਾਰਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 178.96,
      "end_time": 186.345,
      "transcript": "ਹਉਮੈ ਮੈਲੁ ਬਿਖੁ ਉਤਰੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 186.72,
      "end_time": 194.375,
      "transcript": "ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਹਰਿ ਉਰ ਧਾਰਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 194.52,
      "end_time": 202.035,
      "transcript": "ਸਭਿ ਕਾਰਜ ਤਿਨ ਕੇ ਸਿਧਿ ਹਹਿ"
    },
    {
      "section_id": "section-00021",
      "start_time": 202.36,
      "end_time": 209.904,
      "transcript": "ਜਿਨ ਗੁਰਮੁਖਿ ਕਿਰਪਾ ਧਾਰਿ"
    },
    {
      "section_id": "section-00022",
      "start_time": 209.904,
      "end_time": 217.92,
      "transcript": "ਨਾਨਕ ਜੋ ਧੁਰਿ ਮਿਲੇ ਸੇ ਮਿਲਿ ਰਹੇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 217.92,
      "end_time": 229.505,
      "transcript": "ਹਰਿ ਮੇਲੇ ਸਿਰਜਣਹਾਰਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 233.84,
      "end_time": 242.115,
      "transcript": "ਤੂ ਸਚਾ ਸਾਹਿਬੁ ਸਚੁ ਹੈ, ਸਚੁ ਸਚਾ ਗੋਸਾਈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 242.115,
      "end_time": 250.681,
      "transcript": "ਤੁਧੁਨੋ ਸਭ ਧਿਆਇਦੀ, ਸਭ ਲਗੈ ਤੇਰੀ ਪਾਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 250.681,
      "end_time": 258.12,
      "transcript": "ਤੇਰੀ ਸਿਫਤਿ ਸੁਆਲਿਉ ਸਰੂਪ ਹੈ, ਜਿਨਿ ਕੀਤੀ ਤਿਸੁ ਪਾਰਿ ਲਘਾਈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 259.054,
      "end_time": 267.245,
      "transcript": "ਗੁਰਮੁਖਾ ਨੋ ਫਲੁ ਪਾਇਦਾ, ਸਚਿ ਨਾਮਿ ਸਮਾਈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 267.56,
      "end_time": 276.745,
      "transcript": "ਵਡੇ ਮੇਰੇ ਸਾਹਿਬਾ, ਵਡੀ ਤੇਰੀ ਵਡਿਆਈ"
    }
  ]
}

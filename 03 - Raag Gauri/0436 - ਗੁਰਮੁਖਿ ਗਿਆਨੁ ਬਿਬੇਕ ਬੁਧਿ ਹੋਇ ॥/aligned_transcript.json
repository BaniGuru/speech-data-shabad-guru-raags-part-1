{
  "audio_file": "0234 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.265,
      "end_time": 14.055,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 24.015,
      "end_time": 32.285,
      "transcript": "ਗੁਰਮੁਖਿ ਗਿਆਨੁ, ਬਿਬੇਕ ਬੁਧਿ ਹੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 32.88,
      "end_time": 41.216,
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਵੈ, ਹਿਰਦੈ ਹਾਰੁ ਪਰੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.216,
      "end_time": 49.895,
      "transcript": "ਪਵਿਤੁ ਪਾਵਨੁ ਪਰਮ ਬੀਚਾਰੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 50.275,
      "end_time": 58.295,
      "transcript": "ਜਿ ਓਸੁ ਮਿਲੈ, ਤਿਸੁ ਪਾਰਿ ਉਤਾਰੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.96,
      "end_time": 66.975,
      "transcript": "ਅੰਤਰਿ ਹਰਿ ਨਾਮੁ, ਬਾਸਨਾ ਸਮਾਣੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.56,
      "end_time": 75.555,
      "transcript": "ਹਰਿ ਦਰਿ ਸੋਭਾ, ਮਹਾ ਉਤਮ ਬਾਣੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.015,
      "end_time": 84.035,
      "transcript": "ਜਿ ਪੁਰਖੁ ਸੁਣੈ, ਸੁ ਹੋਇ ਨਿਹਾਲੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.575,
      "end_time": 92.655,
      "transcript": "ਨਾਨਕ ਸਤਿਗੁਰ ਮਿਲਿਐ, ਪਾਇਆ ਨਾਮੁ ਧਨੁ ਮਾਲੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.655,
      "end_time": 97.579,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 105.92,
      "end_time": 113.955,
      "transcript": "ਸਤਿਗੁਰ ਕੇ ਜੀਅ ਕੀ ਸਾਰ ਨ ਜਾਪੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 114.535,
      "end_time": 122.815,
      "transcript": "ਕਿ ਪੂਰੈ ਸਤਿਗੁਰ ਭਾਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 122.815,
      "end_time": 131.475,
      "transcript": "ਗੁਰਸਿਖਾਂ ਅੰਦਰਿ ਸਤਿਗੁਰੂ ਵਰਤੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 131.475,
      "end_time": 139.705,
      "transcript": "ਜੋ ਸਿਖਾਂ ਨੋ ਲੋਚੈ ਸੋ ਗੁਰ ਖੁਸੀ ਆਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 139.705,
      "end_time": 148.16,
      "transcript": "ਸਤਿਗੁਰੁ ਆਖੈ ਸੁ ਕਾਰ ਕਮਾਵਨਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 148.16,
      "end_time": 152.475,
      "transcript": "ਸੁ ਜਪੁ ਕਮਾਵਹਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 152.475,
      "end_time": 164.455,
      "transcript": "ਗੁਰਸਿਖਾਂ ਕੀ ਘਾਲ ਸਚਾ ਥਾਇ ਪਾਵੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 165.12,
      "end_time": 173.242,
      "transcript": "ਵਿਣੁ ਸਤਿਗੁਰ ਕੇ ਹੁਕਮੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 173.242,
      "end_time": 181.92,
      "transcript": "ਜਿ ਗੁਰਸਿਖਾਂ ਪਾਸਹੁ ਕੰਮੁ ਕਰਾਇਆ ਲੋੜੇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 181.92,
      "end_time": 190.13,
      "transcript": "ਤਿਸੁ ਗੁਰਸਿਖੁ ਫਿਰਿ ਨੇੜਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 190.13,
      "end_time": 198.395,
      "transcript": "ਗੁਰ ਸਤਿਗੁਰ ਅਗੈ ਕੋ ਜੀਉ ਲਾਇ ਘਾਲੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 198.395,
      "end_time": 206.365,
      "transcript": "ਤਿਸੁ ਅਗੈ ਗੁਰਸਿਖੁ ਕਾਰ ਕਮਾਵੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 206.705,
      "end_time": 214.665,
      "transcript": "ਜਿ ਠਗੀ ਆਵੈ ਠਗੀ ਉਠਿ ਜਾਇ"
    },
    {
      "section_id": "section-00024",
      "start_time": 215.12,
      "end_time": 223.257,
      "transcript": "ਤਿਸੁ ਨੇੜੈ ਗੁਰਸਿਖੁ ਮੂਲਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 223.52,
      "end_time": 231.305,
      "transcript": "ਬ੍ਰਹਮੁ ਬੀਚਾਰੁ, ਨਾਨਕੁ ਆਖਿ ਸੁਣਾਵੈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 231.815,
      "end_time": 240.28,
      "transcript": "ਜਿ ਵਿਣੁ ਸਤਿਗੁਰ ਕੇ ਮਨੁ ਮੰਨੇ ਕੰਮੁ ਕਰਾਏ"
    },
    {
      "section_id": "section-00027",
      "start_time": 240.28,
      "end_time": 250.592,
      "transcript": "ਸੋ ਜੰਤੁ ਮਹਾ ਦੁਖੁ ਪਾਵੈ ਪਉੜੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 260.24,
      "end_time": 265.1,
      "transcript": "ਤੂੰ ਸਚਾ ਸਾਹਿਬੁ ਅਤਿ ਵਡਾ"
    },
    {
      "section_id": "section-00029",
      "start_time": 265.1,
      "end_time": 269.575,
      "transcript": "ਤੁਹਿ ਜੇਵਡੁ ਤੂੰ ਵਡ ਵਡੇ"
    },
    {
      "section_id": "section-00030",
      "start_time": 269.575,
      "end_time": 279.055,
      "transcript": "ਜਿਸੁ ਤੂੰ ਮੇਲਹਿ ਸੋ ਤੁਧੁ ਮਿਲੈ, ਤੂੰ ਆਪੇ ਬਖਸਿ ਲੈਹਿ ਲੇਖਾ ਛਡੇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 279.055,
      "end_time": 288.44,
      "transcript": "ਜਿਸ ਨੋ ਤੂੰ ਆਪਿ ਮਿਲਾਇਦਾ, ਸੋ ਸਤਿਗੁਰੁ ਸੇਵੇ ਮਨੁ ਗਡ ਗਡੇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 288.44,
      "end_time": 297.64,
      "transcript": "ਤੂੰ ਸਚਾ ਸਾਹਿਬੁ ਸਚੁ ਤੂ, ਸਭੁ ਜੀਉ ਪਿੰਡੁ ਚੰਮੁ ਤੇਰਾ ਹਡੇ"
    },
    {
      "section_id": "section-00033",
      "start_time": 297.64,
      "end_time": 309.591,
      "transcript": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਰਖੁ ਤੂੰ ਸਚਿਆ, ਨਾਨਕ ਮਨਿ ਆਸ ਤੇਰੀ ਵਡ ਵਡੇ ਸੁਧੁ"
    }
  ]
}

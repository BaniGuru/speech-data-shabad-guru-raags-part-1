{
  "audio_file": "0170 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.28,
      "end_time": 7.175,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.44,
      "end_time": 21.4,
      "transcript": "ਚੋਆ ਚੰਦਨੁ, ਅੰਕਿ ਚੜਾਵਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.4,
      "end_time": 28.36,
      "transcript": "ਪਾਟ ਪਟੰਬਰ, ਪਹਿਰਿ ਹਢਾਵਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.36,
      "end_time": 35.22,
      "transcript": "ਬਿਨੁ ਹਰਿ ਨਾਮ, ਕਹਾ ਸੁਖੁ ਪਾਵਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.22,
      "end_time": 42.28,
      "transcript": "ਕਿਆ ਪਹਿਰਉ, ਕਿਆ ਓਢਿ ਦਿਖਾਵਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.28,
      "end_time": 49.307,
      "transcript": "ਬਿਨੁ ਜਗਦੀਸ, ਕਹਾ ਸੁਖੁ ਪਾਵਉ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.089,
      "end_time": 63.335,
      "transcript": "ਕਾਨੀ ਕੁੰਡਲ, ਗਲਿ ਮੋਤੀਅਨ ਕੀ ਮਾਲਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.335,
      "end_time": 70.44,
      "transcript": "ਲਾਲ ਨਿਹਾਲੀ, ਫੂਲ ਗੁਲਾਲਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.44,
      "end_time": 77.275,
      "transcript": "ਬਿਨੁ ਜਗਦੀਸ, ਕਹਾ ਸੁਖੁ ਭਾਲਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.275,
      "end_time": 84.065,
      "transcript": "ਨੈਨ ਸਲੋਨੀ, ਸੁੰਦਰ ਨਾਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.52,
      "end_time": 91.395,
      "transcript": "ਖੋੜ ਸੀਗਾਰ ਕਰੈ, ਅਤਿ ਪਿਆਰੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 91.64,
      "end_time": 98.205,
      "transcript": "ਬਿਨੁ ਜਗਦੀਸ ਭਜੇ, ਨਿਤ ਖੁਆਰੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 98.695,
      "end_time": 106.0,
      "transcript": "ਦਰ ਘਰ ਮਹਲਾ, ਸੇਜ ਸੁਖਾਲੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 106.0,
      "end_time": 113.12,
      "transcript": "ਅਹਿਨਿਸਿ, ਫੂਲ ਬਿਛਾਵੈ ਮਾਲੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 113.12,
      "end_time": 120.32,
      "transcript": "ਬਿਨੁ ਹਰਿ ਨਾਮ, ਸੁ ਦੇਹ ਦੁਖਾਲੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 120.32,
      "end_time": 127.295,
      "transcript": "ਹੈਵਰ ਗੈਵਰ, ਨੇਜੇ ਵਾਜੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 127.295,
      "end_time": 134.375,
      "transcript": "ਲਸਕਰ ਨੇਬ, ਖਵਾਸੀ ਪਾਜੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 134.375,
      "end_time": 141.5,
      "transcript": "ਬਿਨੁ ਜਗਦੀਸ, ਝੂਠੇ ਦਿਵਾਜੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 141.5,
      "end_time": 148.56,
      "transcript": "ਸਿਧੁ ਕਹਾਵਉ, ਰਿਧਿ ਸਿਧਿ ਬੁਲਾਵਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 148.56,
      "end_time": 155.525,
      "transcript": "ਤਾਜ ਕੁਲਹ, ਸਿਰਿ ਛਤ੍ਰੁ ਬਨਾਵਉ"
    },
    {
      "section_id": "section-00021",
      "start_time": 155.525,
      "end_time": 162.135,
      "transcript": "ਬਿਨੁ ਜਗਦੀਸ, ਕਹਾ ਸਚੁ ਪਾਵਉ"
    },
    {
      "section_id": "section-00022",
      "start_time": 162.135,
      "end_time": 169.66,
      "transcript": "ਖਾਨੁ ਮਲੂਕੁ, ਕਹਾਵਉ ਰਾਜਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 169.66,
      "end_time": 176.68,
      "transcript": "ਅਬੇ ਤਬੇ, ਕੂੜੇ ਹੈ ਪਾਜਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 176.68,
      "end_time": 183.285,
      "transcript": "ਬਿਨੁ ਗੁਰਸਬਦ ਨ, ਸਵਰਸਿ ਕਾਜਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 183.636,
      "end_time": 190.551,
      "transcript": "ਹਉਮੈ ਮਮਤਾ, ਗੁਰ ਸਬਦਿ ਵਿਸਾਰੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 190.643,
      "end_time": 197.635,
      "transcript": "ਗੁਰਮਤਿ ਜਾਨਿਆ, ਰਿਦੈ ਮੁਰਾਰੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 197.635,
      "end_time": 204.511,
      "transcript": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ, ਸਰਣਿ ਤੁਮਾਰੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 204.511,
      "end_time": 211.74,
      "transcript": "ਹਉਮੈ ਮਮਤਾ ਗੁਰ ਸਬਦਿ ਵਿਸਾਰੀ"
    },
    {
      "section_id": "section-00029",
      "start_time": 211.74,
      "end_time": 218.865,
      "transcript": "ਗੁਰਮਤਿ ਜਾਨਿਆ, ਰਿਦੈ ਮੁਰਾਰੀ"
    },
    {
      "section_id": "section-00030",
      "start_time": 218.865,
      "end_time": 226.715,
      "transcript": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ, ਸਰਣਿ ਤੁਮਾਰੀ"
    }
  ]
}

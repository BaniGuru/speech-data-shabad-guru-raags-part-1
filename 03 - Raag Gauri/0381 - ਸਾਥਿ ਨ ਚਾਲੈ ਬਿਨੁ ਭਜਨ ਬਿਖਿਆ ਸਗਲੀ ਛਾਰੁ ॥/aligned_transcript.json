{
  "audio_file": "0215 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.085,
      "end_time": 12.148,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 24.12,
      "end_time": 32.335,
      "transcript": "ਸਾਥਿ ਨ ਚਾਲੈ ਬਿਨੁ ਭਜਨ"
    },
    {
      "section_id": "section-00003",
      "start_time": 32.76,
      "end_time": 40.455,
      "transcript": "ਬਿਖਿਆ ਸਗਲੀ ਛਾਰੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.44,
      "end_time": 49.365,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਕਮਾਵਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 49.995,
      "end_time": 60.995,
      "transcript": "ਨਾਨਕ ਇਹੁ ਧਨੁ ਸਾਰੁ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 73.195,
      "end_time": 82.465,
      "transcript": "ਸੰਤ ਜਨਾ ਮਿਲਿ, ਕਰਹੁ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 83.0,
      "end_time": 91.875,
      "transcript": "ਏਕੁ ਸਿਮਰਿ, ਨਾਮ ਆਧਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 92.36,
      "end_time": 101.665,
      "transcript": "ਅਵਰਿ ਉਪਾਵ ਸਭਿ ਮੀਤ ਬਿਸਾਰਹੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 101.665,
      "end_time": 110.87,
      "transcript": "ਚਰਨ ਕਮਲ, ਰਿਦ ਮਹਿ ਉਰਿ ਧਾਰਹੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 110.87,
      "end_time": 119.885,
      "transcript": "ਕਰਨ ਕਾਰਨ, ਸੋ ਪ੍ਰਭੁ ਸਮਰਥੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 119.885,
      "end_time": 128.945,
      "transcript": "ਦ੍ਰਿੜੁ ਕਰਿ ਗਹਹੁ, ਨਾਮੁ ਹਰਿ ਵਥੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 129.44,
      "end_time": 138.055,
      "transcript": "ਇਹੁ ਧਨੁ ਸੰਚਹੁ, ਹੋਵਹੁ ਭਗਵੰਤ"
    },
    {
      "section_id": "section-00013",
      "start_time": 138.48,
      "end_time": 147.44,
      "transcript": "ਸੰਤ ਜਨਾ ਕਾ, ਨਿਰਮਲ ਮੰਤ"
    },
    {
      "section_id": "section-00014",
      "start_time": 147.44,
      "end_time": 156.085,
      "transcript": "ਏਕ ਆਸ, ਰਾਖਹੁ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 156.6,
      "end_time": 165.285,
      "transcript": "ਸਰਬ ਰੋਗ, ਨਾਨਕ ਮਿਟਿ ਜਾਹਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 174.465,
      "end_time": 183.395,
      "transcript": "ਜਿਸੁ ਧਨ ਕਉ, ਚਾਰਿ ਕੁੰਟ ਉਠਿ ਧਾਵਹਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 183.395,
      "end_time": 192.625,
      "transcript": "ਸੋ ਧਨੁ, ਹਰਿ ਸੇਵਾ ਤੇ ਪਾਵਹਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 192.625,
      "end_time": 201.195,
      "transcript": "ਜਿਸੁ ਸੁਖ ਕਉ, ਨਿਤ ਬਾਛਹਿ ਮੀਤ"
    },
    {
      "section_id": "section-00019",
      "start_time": 201.585,
      "end_time": 210.51,
      "transcript": "ਸੋ ਸੁਖੁ, ਸਾਧੂ ਸੰਗਿ ਪਰੀਤਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 210.51,
      "end_time": 219.297,
      "transcript": "ਜਿਸੁ ਸੋਭਾ ਕਉ, ਕਰਹਿ ਭਲੀ ਕਰਨੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 219.297,
      "end_time": 227.995,
      "transcript": "ਸਾ ਸੋਭਾ, ਭਜੁ ਹਰਿ ਕੀ ਸਰਨੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 228.36,
      "end_time": 236.715,
      "transcript": "ਅਨਿਕ ਉਪਾਵੀ, ਰੋਗੁ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 236.715,
      "end_time": 245.53,
      "transcript": "ਰੋਗੁ ਮਿਟੈ, ਹਰਿ ਅਵਖਧੁ ਲਾਇ"
    },
    {
      "section_id": "section-00024",
      "start_time": 245.53,
      "end_time": 254.381,
      "transcript": "ਸਰਬ ਨਿਧਾਨ ਮਹਿ, ਹਰਿ ਨਾਮੁ ਨਿਧਾਨੁ"
    },
    {
      "section_id": "section-00025",
      "start_time": 254.381,
      "end_time": 263.005,
      "transcript": "ਜਪਿ ਨਾਨਕ, ਦਰਗਹਿ ਪਰਵਾਨੁ"
    },
    {
      "section_id": "section-00026",
      "start_time": 272.025,
      "end_time": 280.435,
      "transcript": "ਮਨੁ ਪਰਬੋਧਹੁ, ਹਰਿ ਕੈ ਨਾਇ"
    },
    {
      "section_id": "section-00027",
      "start_time": 280.885,
      "end_time": 289.415,
      "transcript": "ਦਹ ਦਿਸਿ ਧਾਵਤ, ਆਵੈ ਠਾਇ"
    },
    {
      "section_id": "section-00028",
      "start_time": 289.8,
      "end_time": 298.095,
      "transcript": "ਤਾ ਕਉ ਬਿਘਨੁ, ਨ ਲਾਗੈ ਕੋਇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 298.545,
      "end_time": 307.035,
      "transcript": "ਜਾ ਕੈ ਰਿਦੈ, ਬਸੈ ਹਰਿ ਸੋਇ"
    },
    {
      "section_id": "section-00030",
      "start_time": 307.44,
      "end_time": 315.855,
      "transcript": "ਕਲਿ ਤਾਤੀ, ਠਾਂਢਾ ਹਰਿ ਨਾਉ"
    },
    {
      "section_id": "section-00031",
      "start_time": 316.28,
      "end_time": 324.96,
      "transcript": "ਸਿਮਰਿ ਸਿਮਰਿ, ਸਦਾ ਸੁਖ ਪਾਉ"
    },
    {
      "section_id": "section-00032",
      "start_time": 324.96,
      "end_time": 333.385,
      "transcript": "ਭਉ ਬਿਨਸੈ, ਪੂਰਨ ਹੋਇ ਆਸ"
    },
    {
      "section_id": "section-00033",
      "start_time": 333.875,
      "end_time": 342.335,
      "transcript": "ਭਗਤਿ ਭਾਇ, ਆਤਮ ਪਰਗਾਸ"
    },
    {
      "section_id": "section-00034",
      "start_time": 342.72,
      "end_time": 350.935,
      "transcript": "ਤਿਤੁ ਘਰਿ ਜਾਇ ਬਸੈ ਅਬਿਨਾਸੀ"
    },
    {
      "section_id": "section-00035",
      "start_time": 351.225,
      "end_time": 360.035,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਕਾਟੀ ਜਮ ਫਾਸੀ"
    },
    {
      "section_id": "section-00036",
      "start_time": 369.12,
      "end_time": 377.785,
      "transcript": "ਤਤੁ ਬੀਚਾਰੁ, ਕਹੈ ਜਨੁ ਸਾਚਾ"
    },
    {
      "section_id": "section-00037",
      "start_time": 377.785,
      "end_time": 386.66,
      "transcript": "ਜਨਮਿ ਮਰੈ, ਸੋ ਕਾਚੋ ਕਾਚਾ"
    },
    {
      "section_id": "section-00038",
      "start_time": 386.66,
      "end_time": 395.085,
      "transcript": "ਆਵਾ ਗਵਨੁ ਮਿਟੈ, ਪ੍ਰਭ ਸੇਵ"
    },
    {
      "section_id": "section-00039",
      "start_time": 395.515,
      "end_time": 404.131,
      "transcript": "ਆਪੁ ਤਿਆਗਿ, ਸਰਨਿ ਗੁਰਦੇਵ"
    },
    {
      "section_id": "section-00040",
      "start_time": 404.131,
      "end_time": 413.04,
      "transcript": "ਇਉ ਰਤਨ ਜਨਮ ਕਾ, ਹੋਇ ਉਧਾਰੁ"
    },
    {
      "section_id": "section-00041",
      "start_time": 413.04,
      "end_time": 421.442,
      "transcript": "ਹਰਿ ਹਰਿ ਸਿਮਰਿ, ਪ੍ਰਾਨ ਆਧਾਰੁ"
    },
    {
      "section_id": "section-00042",
      "start_time": 421.442,
      "end_time": 429.775,
      "transcript": "ਅਨਿਕ ਉਪਾਵ, ਨ ਛੂਟਨਹਾਰੇ"
    },
    {
      "section_id": "section-00043",
      "start_time": 430.135,
      "end_time": 438.815,
      "transcript": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ, ਬੇਦ ਬੀਚਾਰੇ"
    },
    {
      "section_id": "section-00044",
      "start_time": 438.965,
      "end_time": 447.135,
      "transcript": "ਹਰਿ ਕੀ ਭਗਤਿ, ਕਰਹੁ ਮਨੁ ਲਾਇ"
    },
    {
      "section_id": "section-00045",
      "start_time": 447.68,
      "end_time": 455.805,
      "transcript": "ਮਨਿ ਬੰਛਤ, ਨਾਨਕ ਫਲ ਪਾਇ"
    },
    {
      "section_id": "section-00046",
      "start_time": 464.945,
      "end_time": 473.315,
      "transcript": "ਸੰਗਿ ਨ ਚਾਲਸਿ, ਤੇਰੈ ਧਨਾ"
    },
    {
      "section_id": "section-00047",
      "start_time": 473.68,
      "end_time": 482.065,
      "transcript": "ਤੂੰ ਕਿਆ ਲਪਟਾਵਹਿ, ਮੂਰਖ ਮਨਾ"
    },
    {
      "section_id": "section-00048",
      "start_time": 482.255,
      "end_time": 490.805,
      "transcript": "ਸੁਤ ਮੀਤ, ਕੁਟੰਬ ਅਰੁ ਬਨਿਤਾ"
    },
    {
      "section_id": "section-00049",
      "start_time": 491.08,
      "end_time": 499.44,
      "transcript": "ਇਨ ਤੇ ਕਹਹੁ ਤੁਮ, ਕਵਨ ਸਨਾਥਾ"
    },
    {
      "section_id": "section-00050",
      "start_time": 499.44,
      "end_time": 507.843,
      "transcript": "ਰਾਜ ਰੰਗ, ਮਾਇਆ ਬਿਸਥਾਰ"
    },
    {
      "section_id": "section-00051",
      "start_time": 507.843,
      "end_time": 516.295,
      "transcript": "ਇਨ ਤੇ ਕਹਹੁ, ਕਵਨ ਛੁਟਕਾਰ"
    },
    {
      "section_id": "section-00052",
      "start_time": 516.72,
      "end_time": 525.2,
      "transcript": "ਅਸੁ ਹਸਤੀ, ਰਥ ਅਸਵਾਰੀ"
    },
    {
      "section_id": "section-00053",
      "start_time": 525.2,
      "end_time": 533.6,
      "transcript": "ਝੂਠਾ ਡੰਫੁ, ਝੂਠੁ ਪਾਸਾਰੀ"
    },
    {
      "section_id": "section-00054",
      "start_time": 533.6,
      "end_time": 542.025,
      "transcript": "ਜਿਨਿ ਦੀਏ, ਤਿਸੁ ਬੁਝੈ ਨ ਬਿਗਾਨਾ"
    },
    {
      "section_id": "section-00055",
      "start_time": 542.505,
      "end_time": 551.155,
      "transcript": "ਨਾਮੁ ਬਿਸਾਰਿ, ਨਾਨਕ ਪਛੁਤਾਨਾ"
    },
    {
      "section_id": "section-00056",
      "start_time": 559.835,
      "end_time": 568.465,
      "transcript": "ਗੁਰ ਕੀ ਮਤਿ, ਤੂੰ ਲੇਹਿ ਇਆਨੇ"
    },
    {
      "section_id": "section-00057",
      "start_time": 568.465,
      "end_time": 577.24,
      "transcript": "ਭਗਤਿ ਬਿਨਾ, ਬਹੁ ਡੂਬੇ ਸਿਆਨੇ"
    },
    {
      "section_id": "section-00058",
      "start_time": 577.24,
      "end_time": 585.435,
      "transcript": "ਹਰਿ ਕੀ ਭਗਤਿ, ਕਰਹੁ ਮਨ ਮੀਤ"
    },
    {
      "section_id": "section-00059",
      "start_time": 585.775,
      "end_time": 594.005,
      "transcript": "ਨਿਰਮਲ ਹੋਇ, ਤੁਮਾ੍ਰੋ ਚੀਤ"
    },
    {
      "section_id": "section-00060",
      "start_time": 594.425,
      "end_time": 602.8,
      "transcript": "ਚਰਨ ਕਮਲ, ਰਾਖਹੁ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00061",
      "start_time": 602.8,
      "end_time": 611.345,
      "transcript": "ਜਨਮ ਜਨਮ ਕੇ, ਕਿਲਬਿਖ ਜਾਹਿ"
    },
    {
      "section_id": "section-00062",
      "start_time": 611.735,
      "end_time": 620.155,
      "transcript": "ਆਪਿ ਜਪਹੁ, ਅਵਰਾ ਨਾਮੁ ਜਪਾਵਹੁ"
    },
    {
      "section_id": "section-00063",
      "start_time": 620.155,
      "end_time": 629.04,
      "transcript": "ਸੁਨਤ ਕਹਤ, ਰਹਤ ਗਤਿ ਪਾਵਹੁ"
    },
    {
      "section_id": "section-00064",
      "start_time": 629.04,
      "end_time": 637.445,
      "transcript": "ਸਾਰ ਭੂਤ ਸਤਿ, ਹਰਿ ਕੋ ਨਾਉ"
    },
    {
      "section_id": "section-00065",
      "start_time": 637.445,
      "end_time": 645.965,
      "transcript": "ਸਹਜਿ ਸੁਭਾਇ, ਨਾਨਕ ਗੁਨ ਗਾਉ"
    },
    {
      "section_id": "section-00066",
      "start_time": 654.905,
      "end_time": 663.205,
      "transcript": "ਗੁਨ ਗਾਵਤ, ਤੇਰੀ ਉਤਰਸਿ ਮੈਲੁ"
    },
    {
      "section_id": "section-00067",
      "start_time": 663.625,
      "end_time": 671.975,
      "transcript": "ਬਿਨਸਿ ਜਾਇ, ਹਉਮੈ ਬਿਖੁ ਫੈਲੁ"
    },
    {
      "section_id": "section-00068",
      "start_time": 672.345,
      "end_time": 680.495,
      "transcript": "ਹੋਹਿ ਅਚਿੰਤੁ, ਬਸੈ ਸੁਖ ਨਾਲਿ"
    },
    {
      "section_id": "section-00069",
      "start_time": 680.495,
      "end_time": 689.425,
      "transcript": "ਸਾਸਿ ਗ੍ਰਾਸਿ, ਹਰਿ ਨਾਮੁ ਸਮਾਲਿ"
    },
    {
      "section_id": "section-00070",
      "start_time": 689.425,
      "end_time": 697.615,
      "transcript": "ਛਾਡਿ ਸਿਆਨਪ, ਸਗਲੀ ਮਨਾ"
    },
    {
      "section_id": "section-00071",
      "start_time": 698.16,
      "end_time": 706.395,
      "transcript": "ਸਾਧਸੰਗਿ, ਪਾਵਹਿ ਸਚੁ ਧਨਾ"
    },
    {
      "section_id": "section-00072",
      "start_time": 706.8,
      "end_time": 715.085,
      "transcript": "ਹਰਿ ਪੂੰਜੀ ਸੰਚਿ, ਕਰਹੁ ਬਿਉਹਾਰੁ"
    },
    {
      "section_id": "section-00073",
      "start_time": 715.085,
      "end_time": 723.425,
      "transcript": "ਈਹਾ ਸੁਖੁ, ਦਰਗਹ ਜੈਕਾਰੁ"
    },
    {
      "section_id": "section-00074",
      "start_time": 723.96,
      "end_time": 731.895,
      "transcript": "ਸਰਬ ਨਿਰੰਤਰਿ, ਏਕੋ ਦੇਖੁ"
    },
    {
      "section_id": "section-00075",
      "start_time": 732.375,
      "end_time": 740.795,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਾ ਕੈ ਮਸਤਕਿ ਲੇਖੁ"
    },
    {
      "section_id": "section-00076",
      "start_time": 749.52,
      "end_time": 757.805,
      "transcript": "ਏਕੋ ਜਪਿ, ਏਕੋ ਸਾਲਾਹਿ"
    },
    {
      "section_id": "section-00077",
      "start_time": 758.24,
      "end_time": 766.785,
      "transcript": "ਏਕੁ ਸਿਮਰਿ, ਏਕੋ ਮਨ ਆਹਿ"
    },
    {
      "section_id": "section-00078",
      "start_time": 766.785,
      "end_time": 775.165,
      "transcript": "ਏਕਸ ਕੇ, ਗੁਨ ਗਾਉ ਅਨੰਤ"
    },
    {
      "section_id": "section-00079",
      "start_time": 775.36,
      "end_time": 783.645,
      "transcript": "ਮਨਿ ਤਨਿ ਜਾਪਿ, ਏਕ ਭਗਵੰਤ"
    },
    {
      "section_id": "section-00080",
      "start_time": 784.0,
      "end_time": 792.105,
      "transcript": "ਏਕੋ ਏਕੁ, ਏਕੁ ਹਰਿ ਆਪਿ"
    },
    {
      "section_id": "section-00081",
      "start_time": 792.68,
      "end_time": 800.982,
      "transcript": "ਪੂਰਨ ਪੂਰਿ, ਰਹਿਓ ਪ੍ਰਭੁ ਬਿਆਪਿ"
    },
    {
      "section_id": "section-00082",
      "start_time": 800.982,
      "end_time": 809.255,
      "transcript": "ਅਨਿਕ ਬਿਸਥਾਰ, ਏਕ ਤੇ ਭਏ"
    },
    {
      "section_id": "section-00083",
      "start_time": 809.8,
      "end_time": 817.885,
      "transcript": "ਏਕੁ ਅਰਾਧਿ, ਪਰਾਛਤ ਗਏ"
    },
    {
      "section_id": "section-00084",
      "start_time": 818.32,
      "end_time": 826.315,
      "transcript": "ਮਨ ਤਨ ਅੰਤਰਿ, ਏਕੁ ਪ੍ਰਭੁ ਰਾਤਾ"
    },
    {
      "section_id": "section-00085",
      "start_time": 826.765,
      "end_time": 834.885,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਨਾਨਕ ਇਕੁ ਜਾਤਾ"

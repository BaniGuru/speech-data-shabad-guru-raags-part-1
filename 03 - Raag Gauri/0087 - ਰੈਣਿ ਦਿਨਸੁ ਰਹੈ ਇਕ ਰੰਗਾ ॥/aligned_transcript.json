{
  "audio_file": "0136 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.038,
      "end_time": 8.589,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 17.055,
      "end_time": 25.513,
      "transcript": "ਰੈਣਿ ਦਿਨਸੁ, ਰਹੈ ਇਕ ਰੰਗਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.513,
      "end_time": 34.016,
      "transcript": "ਪ੍ਰਭ ਕਉ ਜਾਣੈ, ਸਦ ਹੀ ਸੰਗਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 34.016,
      "end_time": 42.56,
      "transcript": "ਠਾਕੁਰ ਨਾਮੁ, ਕੀਓ ਉਨਿ ਵਰਤਨਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.56,
      "end_time": 50.961,
      "transcript": "ਤ੍ਰਿਪਤਿ ਅਘਾਵਨੁ, ਹਰਿ ਕੈ ਦਰਸਨਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.961,
      "end_time": 59.291,
      "transcript": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ, ਮਨ ਤਨ ਹਰੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.291,
      "end_time": 63.619,
      "transcript": "ਗੁਰ ਪੂਰੇ ਕੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.619,
      "end_time": 72.372,
      "transcript": "ਸਰਨੀ ਪਰੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 80.72,
      "end_time": 89.139,
      "transcript": "ਚਰਣ ਕਮਲ, ਆਤਮ ਆਧਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 89.139,
      "end_time": 97.64,
      "transcript": "ਏਕੁ ਨਿਹਾਰਹਿ, ਆਗਿਆਕਾਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.64,
      "end_time": 106.04,
      "transcript": "ਏਕੋ ਬਨਜੁ, ਏਕੋ ਬਿਉਹਾਰੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.04,
      "end_time": 114.193,
      "transcript": "ਅਵਰੁ ਨ ਜਾਨਹਿ, ਬਿਨੁ ਨਿਰੰਕਾਰੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.193,
      "end_time": 122.82,
      "transcript": "ਹਰਖ ਸੋਗ, ਦੁਹਹੂੰ ਤੇ ਮੁਕਤੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 122.82,
      "end_time": 131.109,
      "transcript": "ਸਦਾ ਅਲਿਪਤੁ, ਜੋਗ ਅਰੁ ਜੁਗਤੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 131.109,
      "end_time": 139.68,
      "transcript": "ਦੀਸਹਿ ਸਭ ਮਹਿ, ਸਭ ਤੇ ਰਹਤੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 139.68,
      "end_time": 147.842,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਕਾ, ਓਇ ਧਿਆਨੁ ਧਰਤੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 147.842,
      "end_time": 156.04,
      "transcript": "ਸੰਤਨ ਕੀ ਮਹਿਮਾ, ਕਵਨ ਵਖਾਨਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 156.04,
      "end_time": 164.495,
      "transcript": "ਅਗਾਧਿ ਬੋਧਿ, ਕਿਛੁ ਮਿਤਿ ਨਹੀ ਜਾਨਉ"
    },
    {
      "section_id": "section-00019",
      "start_time": 164.495,
      "end_time": 173.095,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਮੋਹਿ ਕਿਰਪਾ ਕੀਜੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 173.095,
      "end_time": 181.417,
      "transcript": "ਧੂਰਿ ਸੰਤਨ ਕੀ, ਨਾਨਕ ਦੀਜੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 181.431,
      "end_time": 191.484,
      "transcript": "ਧੂਰਿ ਸੰਤਨ ਕੀ, ਨਾਨਕ ਦੀਜੈ\n"
    }
  ]
}

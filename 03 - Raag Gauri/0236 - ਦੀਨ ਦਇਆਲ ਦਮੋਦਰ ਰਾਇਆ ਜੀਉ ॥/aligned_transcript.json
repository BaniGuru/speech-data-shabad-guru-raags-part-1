{
  "audio_file": "0164 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.365,
      "end_time": 9.004,
      "transcript": "ਰਾਗੁ ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.004,
      "end_time": 17.764,
      "transcript": "ਮਾਝ₁ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.12,
      "end_time": 30.345,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 50.455,
      "end_time": 57.795,
      "transcript": "ਦੀਨ ਦਇਆਲ, ਦਮੋਦਰ ਰਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 57.795,
      "end_time": 68.145,
      "transcript": "ਕੋਟਿ ਜਨਾ ਕਰਿ, ਸੇਵ ਲਗਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.6,
      "end_time": 75.84,
      "transcript": "ਭਗਤ ਵਛਲੁ, ਤੇਰਾ ਬਿਰਦੁ ਰਖਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.84,
      "end_time": 86.392,
      "transcript": "ਪੂਰਨ ਸਭਨੀ ਜਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 93.48,
      "end_time": 100.6,
      "transcript": "ਕਿਉ ਪੇਖਾ ਪ੍ਰੀਤਮੁ, ਕਵਣ ਸੁਕਰਣੀ ਜੀਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 100.6,
      "end_time": 107.5,
      "transcript": "ਸੰਤਾ ਦਾਸੀ, ਸੇਵਾ ਚਰਣੀ ਜੀਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 107.5,
      "end_time": 117.575,
      "transcript": "ਇਹੁ ਜੀਉ ਵਤਾਈ, ਬਲਿ ਬਲਿ ਜਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 118.12,
      "end_time": 128.365,
      "transcript": "ਤਿਸੁ, ਨਿਵਿ ਨਿਵਿ ਲਾਗਉ ਪਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00012",
      "start_time": 128.88,
      "end_time": 135.985,
      "transcript": "ਪੋਥੀ ਪੰਡਿਤ, ਬੇਦ ਖੋਜੰਤਾ ਜੀਉ"
    },
    {
      "section_id": "section-00013",
      "start_time": 135.985,
      "end_time": 146.235,
      "transcript": "ਹੋਇ ਬੈਰਾਗੀ, ਤੀਰਥਿ ਨਾਵੰਤਾ ਜੀਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 146.76,
      "end_time": 153.855,
      "transcript": "ਗੀਤ ਨਾਦ, ਕੀਰਤਨੁ ਗਾਵੰਤਾ ਜੀਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 153.855,
      "end_time": 164.185,
      "transcript": "ਹਰਿ, ਨਿਰਭਉ ਨਾਮੁ ਧਿਆਈ ਜੀਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 164.675,
      "end_time": 171.647,
      "transcript": "ਭਏ ਕ੍ਰਿਪਾਲ, ਸੁਆਮੀ ਮੇਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 171.647,
      "end_time": 178.92,
      "transcript": "ਪਤਿਤ ਪਵਿਤ, ਲਗਿ ਗੁਰ ਕੇ ਪੈਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 178.92,
      "end_time": 189.215,
      "transcript": "ਭ੍ਰਮੁ ਭਉ ਕਾਟਿ, ਕੀਏ ਨਿਰਵੈਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00019",
      "start_time": 189.68,
      "end_time": 200.035,
      "transcript": "ਗੁਰ, ਮਨ ਕੀ ਆਸ ਪੂਰਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 200.385,
      "end_time": 207.68,
      "transcript": "ਜਿਨਿ ਨਾਉ ਪਾਇਆ, ਸੋ ਧਨਵੰਤਾ ਜੀਉ"
    },
    {
      "section_id": "section-00021",
      "start_time": 207.68,
      "end_time": 214.84,
      "transcript": "ਜਿਨਿ ਪ੍ਰਭੁ ਧਿਆਇਆ, ਸੁ ਸੋਭਾਵੰਤਾ ਜੀਉ"
    },
    {
      "section_id": "section-00022",
      "start_time": 214.84,
      "end_time": 225.435,
      "transcript": "ਜਿਸੁ ਸਾਧੂ ਸੰਗਤਿ, ਤਿਸੁ ਸਭ ਸੁਕਰਣੀ ਜੀਉ"
    },
    {
      "section_id": "section-00023",
      "start_time": 225.435,
      "end_time": 235.585,
      "transcript": "ਜਨ ਨਾਨਕ, ਸਹਜਿ ਸਮਾਈ ਜੀਉ"
    }
  ]
}

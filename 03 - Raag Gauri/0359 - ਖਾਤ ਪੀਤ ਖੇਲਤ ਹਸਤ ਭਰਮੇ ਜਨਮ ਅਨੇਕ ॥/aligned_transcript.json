{
  "audio_file": "0196 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.275,
      "end_time": 6.924,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.795,
      "end_time": 20.92,
      "transcript": "ਖਾਤ ਪੀਤ ਖੇਲਤ ਹਸਤ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.92,
      "end_time": 27.305,
      "transcript": "ਭਰਮੇ ਜਨਮ ਅਨੇਕ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.305,
      "end_time": 33.746,
      "transcript": "ਭਵਜਲ ਤੇ ਕਾਢਹੁ ਪ੍ਰਭੂ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.746,
      "end_time": 44.445,
      "transcript": "ਨਾਨਕ ਤੇਰੀ ਟੇਕ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.6,
      "end_time": 62.12,
      "transcript": "ਖੇਲਤ ਖੇਲਤ ਆਇਓ, ਅਨਿਕ ਜੋਨਿ ਦੁਖ ਪਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.12,
      "end_time": 70.115,
      "transcript": "ਖੇਦ ਮਿਟੇ ਸਾਧੂ ਮਿਲਤ, ਸਤਿਗੁਰ ਬਚਨ ਸਮਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.56,
      "end_time": 79.025,
      "transcript": "ਖਿਮਾ ਗਹੀ ਸਚੁ ਸੰਚਿਓ, ਖਾਇਓ ਅੰਮ੍ਰਿਤੁ ਨਾਮ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.12,
      "end_time": 87.35,
      "transcript": "ਖਰੀ ਕ੍ਰਿਪਾ ਠਾਕੁਰ ਭਈ, ਅਨਦ ਸੂਖ ਬਿਸ੍ਰਾਮ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.35,
      "end_time": 95.865,
      "transcript": "ਖੇਪ ਨਿਬਾਹੀ ਬਹੁਤੁ ਲਾਭ, ਘਰਿ ਆਏ ਪਤਿਵੰਤ"
    },
    {
      "section_id": "section-00011",
      "start_time": 96.2,
      "end_time": 104.378,
      "transcript": "ਖਰਾ ਦਿਲਾਸਾ ਗੁਰਿ ਦੀਆ, ਆਇ ਮਿਲੇ ਭਗਵੰਤ"
    },
    {
      "section_id": "section-00012",
      "start_time": 104.378,
      "end_time": 112.957,
      "transcript": "ਆਪਨ ਕੀਆ ਕਰਹਿ ਆਪਿ, ਆਗੈ ਪਾਛੈ ਆਪਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.957,
      "end_time": 122.63,
      "transcript": "ਨਾਨਕ ਸੋਊ ਸਰਾਹੀਐ, ਜਿ ਘਟਿ ਘਟਿ ਰਹਿਆ ਬਿਆਪਿ"
    }
  ]
}

{
  "audio_file": "0239 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.2,
      "end_time": 7.28,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.52,
      "end_time": 21.8,
      "transcript": "ਸੰਧਿਆ ਪ੍ਰਾਤ, ਇਸ੍ਨਾਨੁ ਕਰਾਹੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.8,
      "end_time": 29.04,
      "transcript": "ਜਿਉ ਭਏ ਦਾਦੁਰ, ਪਾਨੀ ਮਾਹੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.04,
      "end_time": 36.24,
      "transcript": "ਜਉ ਪੈ, ਰਾਮ ਰਾਮ ਰਤਿ ਨਾਹੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.24,
      "end_time": 43.475,
      "transcript": "ਤੇ ਸਭਿ, ਧਰਮ ਰਾਇ ਕੈ ਜਾਹੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.8,
      "end_time": 57.84,
      "transcript": "ਕਾਇਆ ਰਤਿ, ਬਹੁ ਰੂਪ ਰਚਾਹੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.84,
      "end_time": 65.015,
      "transcript": "ਤਿਨ ਕਉ ਦਇਆ, ਸੁਪਨੈ ਭੀ ਨਾਹੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 65.015,
      "end_time": 72.44,
      "transcript": "ਚਾਰਿ ਚਰਨ, ਕਹਹਿ ਬਹੁ ਆਗਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 72.44,
      "end_time": 79.565,
      "transcript": "ਸਾਧੂ ਸੁਖੁ ਪਾਵਹਿ, ਕਲਿ ਸਾਗਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.565,
      "end_time": 86.72,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਬਹੁ ਕਾਇ ਕਰੀਜੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.72,
      "end_time": 93.185,
      "transcript": "ਸਰਬਸੁ ਛੋਡਿ, ਮਹਾ ਰਸੁ ਪੀਜੈ"
    }
  ]
}

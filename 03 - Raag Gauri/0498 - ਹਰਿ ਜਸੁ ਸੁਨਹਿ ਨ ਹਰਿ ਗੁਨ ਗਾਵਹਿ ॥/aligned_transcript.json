  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.115,
      "end_time": 8.225,
      "transcript": "ਗਉੜੀ ਚੇਤੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.32,
      "end_time": 15.085,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 15.085,
      "end_time": 22.345,
      "transcript": "ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.8,
      "end_time": 43.356,
      "transcript": "ਹਰਿ ਜਸੁ ਸੁਨਹਿ ਨ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.356,
      "end_time": 48.19,
      "transcript": "ਹਰਿ ਗੁਨ ਗਾਵਹਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.19,
      "end_time": 57.395,
      "transcript": "ਬਾਤਨ ਹੀ ਅਸਮਾਨੁ ਗਿਰਾਵਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.72,
      "end_time": 75.475,
      "transcript": "ਐਸੇ ਲੋਗਨ ਸਿਉ, ਕਿਆ ਕਹੀਐ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.765,
      "end_time": 84.84,
      "transcript": "ਜੋ ਪ੍ਰਭ ਕੀਏ ਭਗਤਿ ਤੇ ਬਾਹਜ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.84,
      "end_time": 94.375,
      "transcript": "ਤਿਨ ਤੇ ਸਦਾ ਡਰਾਨੇ ਰਹੀਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 102.515,
      "end_time": 111.28,
      "transcript": "ਆਪਿ ਨ ਦੇਹਿ, ਚੁਰੂ ਭਰਿ ਪਾਨੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 111.28,
      "end_time": 119.775,
      "transcript": "ਤਿਹ ਨਿੰਦਹਿ, ਜਿਹ ਗੰਗਾ ਆਨੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 120.52,
      "end_time": 128.635,
      "transcript": "ਬੈਠਤ ਉਠਤ, ਕੁਟਿਲਤਾ ਚਾਲਹਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 129.085,
      "end_time": 137.525,
      "transcript": "ਆਪੁ ਗਏ, ਅਉਰਨ ਹੂ ਘਾਲਹਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 146.64,
      "end_time": 155.295,
      "transcript": "ਛਾਡਿ ਕੁਚਰਚਾ, ਆਨ ਨ ਜਾਨਹਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 155.295,
      "end_time": 164.065,
      "transcript": "ਬ੍ਰਹਮਾ ਹੂ ਕੋ, ਕਹਿਓ ਨ ਮਾਨਹਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 164.295,
      "end_time": 172.935,
      "transcript": "ਆਪੁ ਗਏ, ਅਉਰਨ ਹੂ ਖੋਵਹਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 172.935,
      "end_time": 181.7,
      "transcript": "ਆਗਿ ਲਗਾਇ, ਮੰਦਰ ਮੈ ਸੋਵਹਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 181.7,
      "end_time": 190.249,
      "transcript": "ਅਵਰਨ ਹਸਤ, ਆਪ ਹਹਿ ਕਾਂਨੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 190.249,
      "end_time": 199.311,
      "transcript": "ਤਿਨ ਕਉ ਦੇਖਿ, ਕਬੀਰ ਲਜਾਨੇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 208.04,
      "end_time": 217.025,
      "transcript": "ਤਿਨ ਕਉ ਦੇਖਿ, ਕਬੀਰ ਲਜਾਨੇ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.385,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.8,
      "end_time": 22.8,
      "transcript": "ਦੁਖ ਬਿਨਸੇ ਸਹਸਾ ਗਇਓ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.8,
      "end_time": 29.915,
      "transcript": "ਸਰਨਿ ਗਹੀ ਹਰਿ ਰਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.76,
      "end_time": 38.135,
      "transcript": "ਮਨਿ ਚਿੰਦੇ ਫਲ ਪਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.665,
      "end_time": 48.885,
      "transcript": "ਨਾਨਕ ਹਰਿ ਗੁਨ ਗਾਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.055,
      "end_time": 66.145,
      "transcript": "ਕੋਈ ਗਾਵੈ ਕੋ ਸੁਣੈ, ਕੋਈ ਕਰੈ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.64,
      "end_time": 75.035,
      "transcript": "ਕੋ ਉਪਦੇਸੈ ਕੋ ਦ੍ਰਿੜੈ, ਤਿਸ ਕਾ ਹੋਇ ਉਧਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.32,
      "end_time": 83.585,
      "transcript": "ਕਿਲਬਿਖ ਕਾਟੈ ਹੋਇ ਨਿਰਮਲਾ, ਜਨਮ ਜਨਮ ਮਲੁ ਜਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.0,
      "end_time": 92.56,
      "transcript": "ਹਲਤਿ ਪਲਤਿ ਮੁਖੁ ਊਜਲਾ, ਨਹ ਪੋਹੈ ਤਿਸੁ ਮਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.56,
      "end_time": 100.815,
      "transcript": "ਸੋ ਸੁਰਤਾ ਸੋ ਬੈਸਨੋ, ਸੋ ਗਿਆਨੀ ਧਨਵੰਤੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 101.16,
      "end_time": 109.325,
      "transcript": "ਸੋ ਸੂਰਾ ਕੁਲਵੰਤੁ ਸੋਇ, ਜਿਨਿ ਭਜਿਆ ਭਗਵੰਤੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 109.6,
      "end_time": 117.815,
      "transcript": "ਖਤ੍ਰੀ ਬ੍ਰਾਹਮਣੁ ਸੂਦੁ ਬੈਸੁ, ਉਧਰੈ ਸਿਮਰਿ ਚੰਡਾਲ"
    },
    {
      "section_id": "section-00013",
      "start_time": 118.0,
      "end_time": 126.179,
      "transcript": "ਜਿਨਿ ਜਾਨਿਓ ਪ੍ਰਭੁ ਆਪਨਾ, ਨਾਨਕ ਤਿਸਹਿ ਰਵਾਲ"
    },
    {
      "section_id": "section-00014",
      "start_time": 126.179,
      "end_time": 138.445,
      "transcript": "ਜਿਨਿ ਜਾਨਿਓ ਪ੍ਰਭੁ ਆਪਨਾ, ਨਾਨਕ ਤਿਸਹਿ ਰਵਾਲ"
    }
  ]
}

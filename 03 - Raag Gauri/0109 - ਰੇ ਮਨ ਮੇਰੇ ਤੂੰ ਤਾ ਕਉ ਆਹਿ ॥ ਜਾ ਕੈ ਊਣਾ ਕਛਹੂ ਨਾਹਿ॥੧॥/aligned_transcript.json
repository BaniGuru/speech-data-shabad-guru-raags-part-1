{
  "audio_file": "0141 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.102,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.2,
      "end_time": 18.16,
      "transcript": "ਰੇ ਮਨ ਮੇਰੇ, ਤੂੰ ਤਾ ਕਉ ਆਹਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.16,
      "end_time": 24.121,
      "transcript": "ਜਾ ਕੈ ਊਣਾ, ਕਛਹੂ ਨਾਹਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.121,
      "end_time": 30.48,
      "transcript": "ਹਰਿ ਸਾ ਪ੍ਰੀਤਮੁ, ਕਰਿ ਮਨ ਮੀਤ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.48,
      "end_time": 39.667,
      "transcript": "ਪ੍ਰਾਨ ਅਧਾਰੁ, ਰਾਖਹੁ ਸਦ ਚੀਤ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.68,
      "end_time": 51.566,
      "transcript": "ਰੇ ਮਨ ਮੇਰੇ, ਤੂੰ ਤਾ ਕਉ ਸੇਵਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.566,
      "end_time": 57.642,
      "transcript": "ਆਦਿ ਪੁਰਖ, ਅਪਰੰਪਰ ਦੇਵ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.642,
      "end_time": 63.656,
      "transcript": "ਤਿਸੁ ਊਪਰਿ, ਮਨ ਕਰਿ ਤੂੰ ਆਸਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.656,
      "end_time": 69.745,
      "transcript": "ਆਦਿ ਜੁਗਾਦਿ, ਜਾ ਕਾ ਭਰਵਾਸਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.0,
      "end_time": 81.904,
      "transcript": "ਜਾ ਕੀ ਪ੍ਰੀਤਿ, ਸਦਾ ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.904,
      "end_time": 87.475,
      "transcript": "ਨਾਨਕੁ ਗਾਵੈ, ਗੁਰ ਮਿਲਿ ਸੋਇ"
    }
  ]
}

{
  "audio_file": "0203 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.445,
      "end_time": 13.143,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 23.72,
      "end_time": 32.418,
      "transcript": "ਅਗਮ ਅਗਾਧਿ, ਪਾਰਬ੍ਰਹਮੁ ਸੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 32.418,
      "end_time": 40.925,
      "transcript": "ਜੋ ਜੋ ਕਹੈ, ਸੁ ਮੁਕਤਾ ਹੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.48,
      "end_time": 49.615,
      "transcript": "ਸੁਨਿ ਮੀਤਾ, ਨਾਨਕੁ ਬਿਨਵੰਤਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 50.2,
      "end_time": 60.025,
      "transcript": "ਸਾਧ ਜਨਾ ਕੀ, ਅਚਰਜ ਕਥਾ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 72.04,
      "end_time": 80.995,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਮੁਖ ਊਜਲ ਹੋਤ"
    },
    {
      "section_id": "section-00007",
      "start_time": 81.72,
      "end_time": 90.755,
      "transcript": "ਸਾਧਸੰਗਿ, ਮਲੁ ਸਗਲੀ ਖੋਤ"
    },
    {
      "section_id": "section-00008",
      "start_time": 91.36,
      "end_time": 100.235,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਮਿਟੈ ਅਭਿਮਾਨੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 100.855,
      "end_time": 110.055,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਪ੍ਰਗਟੈ ਸੁਗਿਆਨੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 110.195,
      "end_time": 119.145,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਬੁਝੈ ਪ੍ਰਭੁ ਨੇਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 119.76,
      "end_time": 128.595,
      "transcript": "ਸਾਧਸੰਗਿ, ਸਭੁ ਹੋਤ ਨਿਬੇਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 129.2,
      "end_time": 138.025,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਪਾਏ ਨਾਮ ਰਤਨੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 138.68,
      "end_time": 147.485,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਏਕ ਊਪਰਿ ਜਤਨੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 148.04,
      "end_time": 156.895,
      "transcript": "ਸਾਧ ਕੀ ਮਹਿਮਾ, ਬਰਨੈ ਕਉਨੁ ਪ੍ਰਾਨੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 157.375,
      "end_time": 166.495,
      "transcript": "ਨਾਨਕ ਸਾਧ ਕੀ ਸੋਭਾ, ਪ੍ਰਭ ਮਾਹਿ ਸਮਾਨੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 176.16,
      "end_time": 184.925,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਅਗੋਚਰੁ ਮਿਲੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 185.565,
      "end_time": 194.405,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਸਦਾ ਪਰਫੁਲੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 195.04,
      "end_time": 204.205,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਆਵਹਿ ਬਸਿ ਪੰਚਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 204.205,
      "end_time": 213.465,
      "transcript": "ਸਾਧਸੰਗਿ, ਅੰਮ੍ਰਿਤ ਰਸੁ ਭੁੰਚਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 213.465,
      "end_time": 222.425,
      "transcript": "ਸਾਧਸੰਗਿ, ਹੋਇ ਸਭ ਕੀ ਰੇਨ"
    },
    {
      "section_id": "section-00021",
      "start_time": 222.975,
      "end_time": 231.715,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਮਨੋਹਰ ਬੈਨ"
    },
    {
      "section_id": "section-00022",
      "start_time": 232.205,
      "end_time": 240.875,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਨ ਕਤਹੂੰ ਧਾਵੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 241.475,
      "end_time": 250.255,
      "transcript": "ਸਾਧਸੰਗਿ, ਅਸਥਿਤਿ ਮਨੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 250.695,
      "end_time": 259.705,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਮਾਇਆ ਤੇ ਭਿੰਨ"
    },
    {
      "section_id": "section-00025",
      "start_time": 260.0,
      "end_time": 269.015,
      "transcript": "ਸਾਧਸੰਗਿ, ਨਾਨਕ ਪ੍ਰਭ ਸੁਪ੍ਰਸੰਨ"
    },
    {
      "section_id": "section-00026",
      "start_time": 278.44,
      "end_time": 287.005,
      "transcript": "ਸਾਧਸੰਗਿ, ਦੁਸਮਨ ਸਭਿ ਮੀਤ"
    },
    {
      "section_id": "section-00027",
      "start_time": 287.76,
      "end_time": 296.405,
      "transcript": "ਸਾਧੂ ਕੈ ਸੰਗਿ, ਮਹਾ ਪੁਨੀਤ"
    },
    {
      "section_id": "section-00028",
      "start_time": 297.04,
      "end_time": 305.695,
      "transcript": "ਸਾਧਸੰਗਿ, ਕਿਸ ਸਿਉ ਨਹੀ ਬੈਰੁ"
    },
    {
      "section_id": "section-00029",
      "start_time": 306.28,
      "end_time": 314.495,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਨ ਬੀਗਾ ਪੈਰੁ"
    },
    {
      "section_id": "section-00030",
      "start_time": 315.48,
      "end_time": 324.245,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਨਾਹੀ ਕੋ ਮੰਦਾ"
    },
    {
      "section_id": "section-00031",
      "start_time": 324.72,
      "end_time": 333.295,
      "transcript": "ਸਾਧਸੰਗਿ, ਜਾਨੇ ਪਰਮਾਨੰਦਾ"
    },
    {
      "section_id": "section-00032",
      "start_time": 333.92,
      "end_time": 342.565,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਨਾਹੀ ਹਉ ਤਾਪੁ"
    },
    {
      "section_id": "section-00033",
      "start_time": 343.12,
      "end_time": 351.625,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਤਜੈ ਸਭੁ ਆਪੁ"
    },
    {
      "section_id": "section-00034",
      "start_time": 352.195,
      "end_time": 360.805,
      "transcript": "ਆਪੇ ਜਾਨੈ, ਸਾਧ ਬਡਾਈ"
    },
    {
      "section_id": "section-00035",
      "start_time": 361.325,
      "end_time": 370.415,
      "transcript": "ਨਾਨਕ ਸਾਧ, ਪ੍ਰਭੂ ਬਨਿ ਆਈ"
    },
    {
      "section_id": "section-00036",
      "start_time": 380.0,
      "end_time": 388.875,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਨ ਕਬਹੂ ਧਾਵੈ"
    },
    {
      "section_id": "section-00037",
      "start_time": 388.875,
      "end_time": 398.29,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਸਦਾ ਸੁਖੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00038",
      "start_time": 398.29,
      "end_time": 407.72,
      "transcript": "ਸਾਧਸੰਗਿ, ਬਸਤੁ ਅਗੋਚਰ ਲਹੈ"
    },
    {
      "section_id": "section-00039",
      "start_time": 407.72,
      "end_time": 416.265,
      "transcript": "ਸਾਧੂ ਕੈ ਸੰਗਿ, ਅਜਰੁ ਸਹੈ"
    },
    {
      "section_id": "section-00040",
      "start_time": 416.88,
      "end_time": 425.425,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਬਸੈ ਥਾਨਿ ਊਚੈ"
    },
    {
      "section_id": "section-00041",
      "start_time": 426.04,
      "end_time": 434.955,
      "transcript": "ਸਾਧੂ ਕੈ ਸੰਗਿ, ਮਹਲਿ ਪਹੂਚੈ"
    },
    {
      "section_id": "section-00042",
      "start_time": 434.955,
      "end_time": 443.915,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਦ੍ਰਿੜੈ ਸਭਿ ਧਰਮ"
    },
    {
      "section_id": "section-00043",
      "start_time": 444.4,
      "end_time": 452.945,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਕੇਵਲ ਪਾਰਬ੍ਰਹਮ"
    },
    {
      "section_id": "section-00044",
      "start_time": 453.52,
      "end_time": 462.055,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਪਾਏ ਨਾਮ ਨਿਧਾਨ"
    },
    {
      "section_id": "section-00045",
      "start_time": 462.555,
      "end_time": 471.485,
      "transcript": "ਨਾਨਕ, ਸਾਧੂ ਕੈ ਕੁਰਬਾਨ"
    },
    {
      "section_id": "section-00046",
      "start_time": 480.92,
      "end_time": 489.425,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਸਭ ਕੁਲ ਉਧਾਰੈ"
    },
    {
      "section_id": "section-00047",
      "start_time": 490.12,
      "end_time": 498.555,
      "transcript": "ਸਾਧਸੰਗਿ, ਸਾਜਨ ਮੀਤ ਕੁਟੰਬ ਨਿਸਤਾਰੈ"
    },
    {
      "section_id": "section-00048",
      "start_time": 499.28,
      "end_time": 508.215,
      "transcript": "ਸਾਧੂ ਕੈ ਸੰਗਿ, ਸੋ ਧਨੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00049",
      "start_time": 508.215,
      "end_time": 517.355,
      "transcript": "ਜਿਸੁ ਧਨ ਤੇ, ਸਭੁ ਕੋ ਵਰਸਾਵੈ"
    },
    {
      "section_id": "section-00050",
      "start_time": 517.355,
      "end_time": 526.525,
      "transcript": "ਸਾਧਸੰਗਿ, ਧਰਮ ਰਾਇ ਕਰੇ ਸੇਵਾ"
    },
    {
      "section_id": "section-00051",
      "start_time": 526.96,
      "end_time": 535.815,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਸੋਭਾ ਸੁਰਦੇਵਾ"
    },
    {
      "section_id": "section-00052",
      "start_time": 536.165,
      "end_time": 545.195,
      "transcript": "ਸਾਧੂ ਕੈ ਸੰਗਿ, ਪਾਪ ਪਲਾਇਨ"
    },
    {
      "section_id": "section-00053",
      "start_time": 545.195,
      "end_time": 554.45,
      "transcript": "ਸਾਧਸੰਗਿ, ਅੰਮ੍ਰਿਤ ਗੁਨ ਗਾਇਨ"
    },
    {
      "section_id": "section-00054",
      "start_time": 554.45,
      "end_time": 563.635,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਸ੍ਰਬ ਥਾਨ ਗੰਮਿ"
    },
    {
      "section_id": "section-00055",
      "start_time": 563.635,
      "end_time": 572.565,
      "transcript": "ਨਾਨਕ ਸਾਧ ਕੈ ਸੰਗਿ, ਸਫਲ ਜਨੰਮ"
    },
    {
      "section_id": "section-00056",
      "start_time": 581.96,
      "end_time": 590.465,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਨਹੀ ਕਛੁ ਘਾਲ"
    },
    {
      "section_id": "section-00057",
      "start_time": 591.045,
      "end_time": 599.805,
      "transcript": "ਦਰਸਨੁ ਭੇਟਤ, ਹੋਤ ਨਿਹਾਲ"
    },
    {
      "section_id": "section-00058",
      "start_time": 600.4,
      "end_time": 609.175,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਕਲੂਖਤ ਹਰੈ"
    },
    {
      "section_id": "section-00059",
      "start_time": 609.68,
      "end_time": 618.305,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਨਰਕ ਪਰਹਰੈ"
    },
    {
      "section_id": "section-00060",
      "start_time": 618.88,
      "end_time": 627.665,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਈਹਾ ਊਹਾ ਸੁਹੇਲਾ"
    },
    {
      "section_id": "section-00061",
      "start_time": 627.995,
      "end_time": 636.495,
      "transcript": "ਸਾਧਸੰਗਿ, ਬਿਛੁਰਤ ਹਰਿ ਮੇਲਾ"
    },
    {
      "section_id": "section-00062",
      "start_time": 637.08,
      "end_time": 645.725,
      "transcript": "ਜੋ ਇਛੈ, ਸੋਈ ਫਲੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00063",
      "start_time": 646.335,
      "end_time": 655.195,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਨ ਬਿਰਥਾ ਜਾਵੈ"
    },
    {
      "section_id": "section-00064",
      "start_time": 655.195,
      "end_time": 664.46,
      "transcript": "ਪਾਰਬ੍ਰਹਮੁ, ਸਾਧ ਰਿਦ ਬਸੈ"
    },
    {
      "section_id": "section-00065",
      "start_time": 664.46,
      "end_time": 673.805,
      "transcript": "ਨਾਨਕ ਉਧਰੈ, ਸਾਧ ਸੁਨਿ ਰਸੈ"
    },
    {
      "section_id": "section-00066",
      "start_time": 683.32,
      "end_time": 691.835,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਸੁਨਉ ਹਰਿ ਨਾਉ"
    },
    {
      "section_id": "section-00067",
      "start_time": 692.6,
      "end_time": 700.985,
      "transcript": "ਸਾਧਸੰਗਿ, ਹਰਿ ਕੇ ਗੁਨ ਗਾਉ"
    },
    {
      "section_id": "section-00068",
      "start_time": 701.8,
      "end_time": 710.495,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਨ ਮਨ ਤੇ ਬਿਸਰੈ"
    },
    {
      "section_id": "section-00069",
      "start_time": 711.12,
      "end_time": 719.555,
      "transcript": "ਸਾਧਸੰਗਿ, ਸਰਪਰ ਨਿਸਤਰੈ"
    },
    {
      "section_id": "section-00070",
      "start_time": 720.36,
      "end_time": 729.595,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਲਗੈ ਪ੍ਰਭੁ ਮੀਠਾ"
    },
    {
      "section_id": "section-00071",
      "start_time": 729.595,
      "end_time": 738.81,
      "transcript": "ਸਾਧੂ ਕੈ ਸੰਗਿ, ਘਟਿ ਘਟਿ ਡੀਠਾ"
    },
    {
      "section_id": "section-00072",
      "start_time": 738.81,
      "end_time": 747.565,
      "transcript": "ਸਾਧਸੰਗਿ, ਭਏ ਆਗਿਆਕਾਰੀ"
    },
    {
      "section_id": "section-00073",
      "start_time": 748.24,
      "end_time": 756.885,
      "transcript": "ਸਾਧਸੰਗਿ, ਗਤਿ ਭਈ ਹਮਾਰੀ"
    },
    {
      "section_id": "section-00074",
      "start_time": 757.48,
      "end_time": 766.165,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਮਿਟੇ ਸਭਿ ਰੋਗ"
    },
    {
      "section_id": "section-00075",
      "start_time": 766.685,
      "end_time": 775.795,
      "transcript": "ਨਾਨਕ, ਸਾਧ ਭੇਟੇ ਸੰਜੋਗ"
    },
    {
      "section_id": "section-00076",
      "start_time": 785.28,
      "end_time": 794.33,
      "transcript": "ਸਾਧ ਕੀ ਮਹਿਮਾ, ਬੇਦ ਨ ਜਾਨਹਿ"
    },
    {
      "section_id": "section-00077",
      "start_time": 794.33,
      "end_time": 803.555,
      "transcript": "ਜੇਤਾ ਸੁਨਹਿ, ਤੇਤਾ ਬਖਿਆਨਹਿ"
    },
    {
      "section_id": "section-00078",
      "start_time": 803.555,
      "end_time": 812.425,
      "transcript": "ਸਾਧ ਕੀ ਉਪਮਾ, ਤਿਹੁ ਗੁਣ ਤੇ ਦੂਰਿ"
    },
    {
      "section_id": "section-00079",
      "start_time": 812.885,
      "end_time": 821.535,
      "transcript": "ਸਾਧ ਕੀ ਉਪਮਾ, ਰਹੀ ਭਰਪੂਰਿ"
    },
    {
      "section_id": "section-00080",
      "start_time": 822.075,
      "end_time": 830.745,
      "transcript": "ਸਾਧ ਕੀ ਸੋਭਾ ਕਾ, ਨਾਹੀ ਅੰਤ"
    },
    {
      "section_id": "section-00081",
      "start_time": 831.32,
      "end_time": 839.545,
      "transcript": "ਸਾਧ ਕੀ ਸੋਭਾ, ਸਦਾ ਬੇਅੰਤ"
    },
    {
      "section_id": "section-00082",
      "start_time": 840.44,
      "end_time": 849.385,
      "transcript": "ਸਾਧ ਕੀ ਸੋਭਾ, ਊਚ ਤੇ ਊਚੀ"
    },
    {
      "section_id": "section-00083",
      "start_time": 849.385,
      "end_time": 858.525,
      "transcript": "ਸਾਧ ਕੀ ਸੋਭਾ, ਮੂਚ ਤੇ ਮੂਚੀ"
    },
    {
      "section_id": "section-00084",

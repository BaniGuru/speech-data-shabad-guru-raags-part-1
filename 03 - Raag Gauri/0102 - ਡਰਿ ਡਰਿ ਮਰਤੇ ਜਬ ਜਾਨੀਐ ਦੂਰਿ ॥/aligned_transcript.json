{
  "audio_file": "0140 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.114,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.16,
      "end_time": 21.036,
      "transcript": "ਡਰਿ ਡਰਿ ਮਰਤੇ, ਜਬ ਜਾਨੀਐ ਦੂਰਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.036,
      "end_time": 28.272,
      "transcript": "ਡਰੁ ਚੂਕਾ, ਦੇਖਿਆ ਭਰਪੂਰਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.44,
      "end_time": 42.28,
      "transcript": "ਸਤਿਗੁਰ ਅਪਨੇ ਕਉ, ਬਲਿਹਾਰੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.28,
      "end_time": 49.485,
      "transcript": "ਛੋਡਿ ਨ ਜਾਈ, ਸਰਪਰ ਤਾਰੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.2,
      "end_time": 74.12,
      "transcript": "ਦੂਖੁ ਰੋਗੁ ਸੋਗੁ, ਬਿਸਰੈ ਜਬ ਨਾਮੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 74.12,
      "end_time": 80.992,
      "transcript": "ਸਦਾ ਅਨੰਦੁ, ਜਾ ਹਰਿ ਗੁਣ ਗਾਮੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 80.992,
      "end_time": 88.32,
      "transcript": "ਬੁਰਾ ਭਲਾ, ਕੋਈ ਨ ਕਹੀਜੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 88.32,
      "end_time": 95.48,
      "transcript": "ਛੋਡਿ ਮਾਨੁ, ਹਰਿ ਚਰਨ ਗਹੀਜੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 95.48,
      "end_time": 102.445,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਗੁਰ ਮੰਤ੍ਰੁ ਚਿਤਾਰਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 102.445,
      "end_time": 109.035,
      "transcript": "ਸੁਖੁ ਪਾਵਹਿ, ਸਾਚੈ ਦਰਬਾਰਿ"
    }
  ]
}

{
  "audio_file": "0124 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.28,
      "end_time": 8.27,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.84,
      "end_time": 22.57,
      "transcript": "ਮਾਤਾ ਪ੍ਰੀਤਿ ਕਰੇ, ਪੁਤੁ ਖਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.04,
      "end_time": 29.88,
      "transcript": "ਮੀਨੇ ਪ੍ਰੀਤਿ ਭਈ ਜਲਿ ਨਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.12,
      "end_time": 36.82,
      "transcript": "ਸਤਿਗੁਰ ਪ੍ਰੀਤਿ, ਗੁਰਸਿਖ ਮੁਖਿ ਪਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.32,
      "end_time": 44.44,
      "transcript": "ਤੇ ਹਰਿ ਜਨ, ਹਰਿ ਮੇਲਹੁ ਹਮ ਪਿਆਰੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.44,
      "end_time": 55.044,
      "transcript": "ਜਿਨ ਮਿਲਿਆ ਦੁਖ ਜਾਹਿ ਹਮਾਰੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.56,
      "end_time": 69.92,
      "transcript": "ਜਿਉ ਮਿਲਿ ਬਛਰੇ, ਗਊ ਪ੍ਰੀਤਿ ਲਗਾਵੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 69.92,
      "end_time": 77.16,
      "transcript": "ਕਾਮਨਿ ਪ੍ਰੀਤਿ, ਜਾ ਪਿਰੁ ਘਰਿ ਆਵੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 77.16,
      "end_time": 83.88,
      "transcript": "ਹਰਿ ਜਨ ਪ੍ਰੀਤਿ, ਜਾ ਹਰਿ ਜਸੁ ਗਾਵੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.44,
      "end_time": 91.68,
      "transcript": "ਸਾਰਿੰਗ ਪ੍ਰੀਤਿ, ਬਸੈ ਜਲ ਧਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.68,
      "end_time": 98.96,
      "transcript": "ਨਰਪਤਿ ਪ੍ਰੀਤਿ, ਮਾਇਆ ਦੇਖਿ ਪਸਾਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 98.96,
      "end_time": 105.7,
      "transcript": "ਹਰਿ ਜਨ ਪ੍ਰੀਤਿ, ਜਪੈ ਨਿਰੰਕਾਰਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 106.24,
      "end_time": 113.48,
      "transcript": "ਨਰ ਪ੍ਰਾਣੀ ਪ੍ਰੀਤਿ, ਮਾਇਆ ਧਨੁ ਖਾਟੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 113.48,
      "end_time": 120.72,
      "transcript": "ਗੁਰਸਿਖ ਪ੍ਰੀਤਿ, ਗੁਰੁ ਮਿਲੈ ਗਲਾਟੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 120.72,
      "end_time": 127.6,
      "transcript": "ਜਨ ਨਾਨਕ ਪ੍ਰੀਤਿ, ਸਾਧ ਪਗ ਚਾਟੇ"
    }
  ]
}

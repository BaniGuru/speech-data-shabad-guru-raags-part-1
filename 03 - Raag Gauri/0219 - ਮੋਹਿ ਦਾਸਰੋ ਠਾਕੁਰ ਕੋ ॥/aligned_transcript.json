{
  "audio_file": "0160 E PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.148,
      "transcript": "ਗਉੜੀ₃ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.205,
      "end_time": 22.435,
      "transcript": "ਮੋਹਿ ਦਾਸਰੋ, ਠਾਕੁਰ ਕੋ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.615,
      "end_time": 31.147,
      "transcript": "ਧਾਨੁ, ਪ੍ਰਭ ਕਾ ਖਾਨਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.14,
      "end_time": 45.76,
      "transcript": "ਐਸੋ ਹੈ ਰੇ, ਖਸਮੁ ਹਮਾਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.76,
      "end_time": 53.4,
      "transcript": "ਖਿਨ ਮਹਿ, ਸਾਜਿ ਸਵਾਰਣਹਾਰਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.4,
      "end_time": 60.713,
      "transcript": "ਕਾਮੁ ਕਰੀ, ਜੇ ਠਾਕੁਰ ਭਾਵਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.713,
      "end_time": 68.52,
      "transcript": "ਗੀਤ ਚਰਿਤ, ਪ੍ਰਭ ਕੇ ਗੁਨ ਗਾਵਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.52,
      "end_time": 76.08,
      "transcript": "ਸਰਣਿ ਪਰਿਓ, ਠਾਕੁਰ ਵਜੀਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.08,
      "end_time": 83.72,
      "transcript": "ਤਿਨਾ ਦੇਖਿ, ਮੇਰਾ ਮਨੁ ਧੀਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.72,
      "end_time": 91.04,
      "transcript": "ਏਕ ਟੇਕ, ਏਕੋ ਆਧਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.04,
      "end_time": 97.56,
      "transcript": "ਜਨ ਨਾਨਕ, ਹਰਿ ਕੀ ਲਾਗਾ ਕਾਰਾ"
    }
  ]
}

{
  "audio_file": "0254 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 10.692,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਵਾਰ ਕਬੀਰ ਜੀਉ ਕੇ ਸਤਵੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 31.145,
      "end_time": 40.015,
      "transcript": "ਬਾਰ ਬਾਰ, ਹਰਿ ਕੇ ਗੁਨ ਗਾਵਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 40.495,
      "end_time": 51.575,
      "transcript": "ਗੁਰ ਗਮਿ ਭੇਦੁ, ਸੁ ਹਰਿ ਕਾ ਪਾਵਉ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 59.04,
      "end_time": 67.465,
      "transcript": "ਆਦਿਤ, ਕਰੈ ਭਗਤਿ ਆਰੰਭ"
    },
    {
      "section_id": "section-00005",
      "start_time": 68.12,
      "end_time": 76.475,
      "transcript": "ਕਾਇਆ ਮੰਦਰ, ਮਨਸਾ ਥੰਭ"
    },
    {
      "section_id": "section-00006",
      "start_time": 76.96,
      "end_time": 85.375,
      "transcript": "ਅਹਿਨਿਸਿ ਅਖੰਡ, ਸੁਰਹੀ ਜਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 85.96,
      "end_time": 94.385,
      "transcript": "ਤਉ ਅਨਹਦ ਬੇਣੁ, ਸਹਜ ਮਹਿ ਬਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 94.92,
      "end_time": 103.135,
      "transcript": "ਸੋਮਵਾਰਿ, ਸਸਿ ਅੰਮ੍ਰਿਤੁ ਝਰੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 103.88,
      "end_time": 112.175,
      "transcript": "ਚਾਖਤ ਬੇਗਿ, ਸਗਲ ਬਿਖ ਹਰੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 112.715,
      "end_time": 120.915,
      "transcript": "ਬਾਣੀ ਰੋਕਿਆ ਰਹੈ ਦੁਆਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 121.56,
      "end_time": 129.855,
      "transcript": "ਤਉ ਮਨੁ ਮਤਵਾਰੋ, ਪੀਵਨਹਾਰ"
    },
    {
      "section_id": "section-00012",
      "start_time": 130.375,
      "end_time": 138.695,
      "transcript": "ਮੰਗਲਵਾਰੇ, ਲੇ ਮਾਹੀਤਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 139.32,
      "end_time": 147.505,
      "transcript": "ਪੰਚ ਚੋਰ ਕੀ, ਜਾਣੈ ਰੀਤਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 148.16,
      "end_time": 156.145,
      "transcript": "ਘਰ ਛੋਡੇਂ, ਬਾਹਰਿ ਜਿਨਿ ਜਾਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 156.805,
      "end_time": 165.135,
      "transcript": "ਨਾਤਰੁ ਖਰਾ, ਰਿਸੈ ਹੈ ਰਾਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 165.535,
      "end_time": 173.875,
      "transcript": "ਬੁਧਵਾਰਿ, ਬੁਧਿ ਕਰੈ ਪ੍ਰਗਾਸ"
    },
    {
      "section_id": "section-00017",
      "start_time": 174.48,
      "end_time": 182.645,
      "transcript": "ਹਿਰਦੈ ਕਮਲ ਮਹਿ, ਹਰਿ ਕਾ ਬਾਸ"
    },
    {
      "section_id": "section-00018",
      "start_time": 183.215,
      "end_time": 191.425,
      "transcript": "ਗੁਰ ਮਿਲਿ, ਦੋਊ ਏਕ ਸਮ ਧਰੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 192.0,
      "end_time": 200.495,
      "transcript": "ਉਰਧ ਪੰਕ, ਲੈ ਸੂਧਾ ਕਰੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 209.525,
      "end_time": 217.705,
      "transcript": "ਬ੍ਰਿਹਸਪਤਿ, ਬਿਖਿਆ ਦੇਇ ਬਹਾਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 218.4,
      "end_time": 226.575,
      "transcript": "ਤੀਨਿ ਦੇਵ, ਏਕ ਸੰਗਿ ਲਾਇ"
    },
    {
      "section_id": "section-00022",
      "start_time": 227.12,
      "end_time": 235.075,
      "transcript": "ਤੀਨਿ ਨਦੀ, ਤਹ ਤ੍ਰਿਕੁਟੀ ਮਾਹਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 235.76,
      "end_time": 243.985,
      "transcript": "ਅਹਿਨਿਸਿ, ਕਸਮਲ ਧੋਵਹਿ ਨਾਹਿ"
    },
    {
      "section_id": "section-00024",
      "start_time": 244.4,
      "end_time": 252.495,
      "transcript": "ਸੁਕ੍ਰਿਤੁ ਸਹਾਰੈ, ਸੁ ਇਹ ਬ੍ਰਤਿ ਚੜੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 253.12,
      "end_time": 261.215,
      "transcript": "ਅਨਦਿਨ, ਆਪਿ ਆਪ ਸਿਉ ਲੜੈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 261.84,
      "end_time": 270.28,
      "transcript": "ਸੁਰਖੀ ਪਾਂਚਉ, ਰਾਖੈ ਸਬੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 270.28,
      "end_time": 278.615,
      "transcript": "ਤਉ ਦੂਜੀ ਦ੍ਰਿਸਟਿ, ਨ ਪੈਸੈ ਕਬੈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 279.2,
      "end_time": 287.315,
      "transcript": "ਥਾਵਰ, ਥਿਰੁ ਕਰਿ ਰਾਖੈ ਸੋਇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 288.0,
      "end_time": 296.105,
      "transcript": "ਜੋਤਿ ਦੀ ਵਟੀ, ਘਟ ਮਹਿ ਜੋਇ"
    },
    {
      "section_id": "section-00030",
      "start_time": 296.705,
      "end_time": 304.905,
      "transcript": "ਬਾਹਰਿ ਭੀਤਰਿ, ਭਇਆ ਪ੍ਰਗਾਸੁ"
    },
    {
      "section_id": "section-00031",
      "start_time": 305.36,
      "end_time": 314.029,
      "transcript": "ਤਬ ਹੂਆ, ਸਗਲ ਕਰਮ ਕਾ ਨਾਸੁ"
    },
    {
      "section_id": "section-00032",
      "start_time": 314.029,
      "end_time": 322.325,
      "transcript": "ਜਬ ਲਗੁ ਘਟ ਮਹਿ, ਦੂਜੀ ਆਨ"
    },
    {
      "section_id": "section-00033",
      "start_time": 322.92,
      "end_time": 330.965,
      "transcript": "ਤਉ ਲਉ, ਮਹਲਿ ਨ ਲਾਭੈ ਜਾਨ"
    },
    {
      "section_id": "section-00034",
      "start_time": 331.6,
      "end_time": 340.239,
      "transcript": "ਰਮਤ ਰਾਮ ਸਿਉ ਲਾਗੋ ਰੰਗੁ"
    },
    {
      "section_id": "section-00035",
      "start_time": 340.239,
      "end_time": 349.286,
      "transcript": "ਕਹਿ ਕਬੀਰ, ਤਬ ਨਿਰਮਲ ਅੰਗ"
    },
    {
      "section_id": "section-00036",
      "start_time": 366.004,
      "end_time": 374.455,
      "transcript": "ਰਮਤ ਰਾਮ ਸਿਉ ਲਾਗੋ ਰੰਗੁ"
    },
    {
      "section_id": "section-00037",
      "start_time": 375.095,
      "end_time": 385.385,
      "transcript": "ਕਹਿ ਕਬੀਰ, ਤਬ ਨਿਰਮਲ ਅੰਗ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.56,
      "end_time": 7.789,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.04,
      "end_time": 21.724,
      "transcript": "ਪ੍ਰਾਣੀ ਜਾਣੈ, ਇਹੁ ਤਨੁ ਮੇਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.12,
      "end_time": 29.28,
      "transcript": "ਬਹੁਰਿ ਬਹੁਰਿ, ਉਆਹੂ ਲਪਟੇਰਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.28,
      "end_time": 36.265,
      "transcript": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ, ਗਿਰਸਤ ਕਾ ਫਾਸਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.265,
      "end_time": 43.21,
      "transcript": "ਹੋਨੁ ਨ ਪਾਈਐ, ਰਾਮ ਕੇ ਦਾਸਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.68,
      "end_time": 50.442,
      "transcript": "ਕਵਨ ਸੁ ਬਿਧਿ, ਜਿਤੁ ਰਾਮ ਗੁਣ ਗਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.442,
      "end_time": 61.38,
      "transcript": "ਕਵਨ ਸੁ ਮਤਿ ਜਿਤੁ ਤਰੈ ਇਹ ਮਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 69.04,
      "end_time": 76.19,
      "transcript": "ਜੋ ਭਲਾਈ, ਸੋ ਬੁਰਾ ਜਾਨੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.19,
      "end_time": 82.94,
      "transcript": "ਸਾਚੁ ਕਹੈ, ਸੋ ਬਿਖੈ ਸਮਾਨੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.343,
      "end_time": 90.365,
      "transcript": "ਜਾਣੈ ਨਾਹੀ, ਜੀਤ ਅਰੁ ਹਾਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 90.365,
      "end_time": 97.684,
      "transcript": "ਇਹੁ ਵਲੇਵਾ, ਸਾਕਤ ਸੰਸਾਰ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.684,
      "end_time": 105.13,
      "transcript": "ਜੋ ਹਲਾਹਲ, ਸੋ ਪੀਵੈ ਬਉਰਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 105.4,
      "end_time": 112.26,
      "transcript": "ਅੰਮ੍ਰਿਤੁ ਨਾਮੁ, ਜਾਨੈ ਕਰਿ ਕਉਰਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 112.76,
      "end_time": 119.795,
      "transcript": "ਸਾਧਸੰਗ ਕੈ, ਨਾਹੀ ਨੇਰਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 119.795,
      "end_time": 126.68,
      "transcript": "ਲਖ ਚਉਰਾਸੀਹ, ਭ੍ਰਮਤਾ ਫੇਰਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 127.28,
      "end_time": 134.44,
      "transcript": "ਏਕੈ ਜਾਲਿ, ਫਹਾਏ ਪੰਖੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 134.44,
      "end_time": 141.368,
      "transcript": "ਰਸਿ ਰਸਿ ਭੋਗ ਕਰਹਿ ਬਹੁ ਰੰਗੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 141.368,
      "end_time": 148.751,
      "transcript": "ਕਹੁ ਨਾਨਕ ਜਿਸੁ ਭਏ ਕ੍ਰਿਪਾਲ"
    },
    {
      "section_id": "section-00019",
      "start_time": 148.751,
      "end_time": 155.853,
      "transcript": "ਗੁਰਿ ਪੂਰੈ ਤਾ ਕੇ ਕਾਟੇ ਜਾਲ"
    },
    {

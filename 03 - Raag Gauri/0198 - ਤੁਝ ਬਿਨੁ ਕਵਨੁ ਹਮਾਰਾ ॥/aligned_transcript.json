  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 7.035,
      "transcript": "ਗਉੜੀ₄ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.52,
      "end_time": 22.986,
      "transcript": "ਤੁਝ ਬਿਨੁ, ਕਵਨੁ ਹਮਾਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.986,
      "end_time": 35.198,
      "transcript": "ਮੇਰੇ ਪ੍ਰੀਤਮ, ਪ੍ਰਾਨ ਅਧਾਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 46.88,
      "end_time": 53.935,
      "transcript": "ਅੰਤਰ ਕੀ ਬਿਧਿ ਤੁਮ ਹੀ ਜਾਨੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 54.44,
      "end_time": 61.515,
      "transcript": "ਤੁਮ ਹੀ ਸਜਨ ਸੁਹੇਲੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.24,
      "end_time": 69.245,
      "transcript": "ਸਰਬ ਸੁਖਾ ਮੈ ਤੁਝ ਤੇ ਪਾਏ"
    },
    {
      "section_id": "section-00007",
      "start_time": 69.8,
      "end_time": 76.965,
      "transcript": "ਮੇਰੇ ਠਾਕੁਰ ਅਗਹ ਅਤੋਲੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.56,
      "end_time": 84.725,
      "transcript": "ਬਰਨਿ ਨ ਸਾਕਉ ਤੁਮਰੇ ਰੰਗਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 85.205,
      "end_time": 92.335,
      "transcript": "ਗੁਣ ਨਿਧਾਨ ਸੁਖਦਾਤੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.92,
      "end_time": 100.165,
      "transcript": "ਅਗਮ ਅਗੋਚਰ ਪ੍ਰਭ ਅਬਿਨਾਸੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 100.64,
      "end_time": 107.835,
      "transcript": "ਪੂਰੇ ਗੁਰ ਤੇ ਜਾਤੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 115.92,
      "end_time": 123.68,
      "transcript": "ਭ੍ਰਮੁ ਭਉ ਕਾਟਿ ਕੀਏ ਨਿਹਕੇਵਲ"
    },
    {
      "section_id": "section-00013",
      "start_time": 123.68,
      "end_time": 130.645,
      "transcript": "ਜਬ ਤੇ ਹਉਮੈ ਮਾਰੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 131.32,
      "end_time": 138.385,
      "transcript": "ਜਨਮ ਮਰਣ ਕੋ ਚੂਕੋ ਸਹਸਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 138.975,
      "end_time": 146.055,
      "transcript": "ਸਾਧਸੰਗਤਿ ਦਰਸਾਰੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 146.68,
      "end_time": 154.124,
      "transcript": "ਚਰਣ ਪਖਾਰਿ ਕਰਉ ਗੁਰ ਸੇਵਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 154.124,
      "end_time": 161.565,
      "transcript": "ਬਾਰਿ ਜਾਉ ਲਖ ਬਰੀਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 162.08,
      "end_time": 169.607,
      "transcript": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਇਹੁ ਭਉਜਲੁ ਤਰਿਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 169.607,
      "end_time": 176.775,
      "transcript": "ਜਨ ਨਾਨਕ ਪ੍ਰਿਅ ਸੰਗਿ ਮਿਰੀਆ"
    }
  ]
}

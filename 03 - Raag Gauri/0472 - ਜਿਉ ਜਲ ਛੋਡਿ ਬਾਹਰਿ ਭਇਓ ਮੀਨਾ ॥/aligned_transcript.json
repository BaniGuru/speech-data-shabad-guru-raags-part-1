{
  "audio_file": "0240 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.023,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ ਪੰਚਪਦੇ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.765,
      "end_time": 17.842,
      "transcript": "ਜਿਉ ਜਲ ਛੋਡਿ, ਬਾਹਰਿ ਭਇਓ ਮੀਨਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.842,
      "end_time": 24.2,
      "transcript": "ਪੂਰਬ ਜਨਮ, ਹਉ ਤਪ ਕਾ ਹੀਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.2,
      "end_time": 30.32,
      "transcript": "ਅਬ ਕਹੁ ਰਾਮ, ਕਵਨ ਗਤਿ ਮੋਰੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.32,
      "end_time": 39.705,
      "transcript": "ਤਜੀ ਲੇ ਬਨਾਰਸ, ਮਤਿ ਭਈ ਥੋਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.745,
      "end_time": 52.12,
      "transcript": "ਸਗਲ ਜਨਮੁ, ਸਿਵ ਪੁਰੀ ਗਵਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.12,
      "end_time": 58.32,
      "transcript": "ਮਰਤੀ ਬਾਰ, ਮਗਹਰਿ ਉਠਿ ਆਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.32,
      "end_time": 64.52,
      "transcript": "ਬਹੁਤੁ ਬਰਸ, ਤਪੁ ਕੀਆ ਕਾਸੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.52,
      "end_time": 70.565,
      "transcript": "ਮਰਨੁ ਭਇਆ, ਮਗਹਰ ਕੀ ਬਾਸੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.76,
      "end_time": 76.84,
      "transcript": "ਕਾਸੀ ਮਗਹਰ, ਸਮ ਬੀਚਾਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 76.84,
      "end_time": 82.535,
      "transcript": "ਓਛੀ ਭਗਤਿ, ਕੈਸੇ ਉਤਰਸਿ ਪਾਰੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 83.0,
      "end_time": 89.16,
      "transcript": "ਕਹੁ ਗੁਰ ਗਜ ਸਿਵ, ਸਭੁ ਕੋ ਜਾਨੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 89.16,
      "end_time": 95.217,
      "transcript": "ਮੁਆ ਕਬੀਰੁ, ਰਮਤ ਸ੍ਰੀ ਰਾਮੈ"
    }
  ]
}

{
  "audio_file": "0241 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 7.205,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.72,
      "end_time": 21.355,
      "transcript": "ਪਿੰਡਿ ਮੂਐ, ਜੀਉ ਕਿਹ ਘਰਿ ਜਾਤਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.355,
      "end_time": 28.845,
      "transcript": "ਸਬਦਿ ਅਤੀਤਿ ਅਨਾਹਦਿ ਰਾਤਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.845,
      "end_time": 36.11,
      "transcript": "ਜਿਨਿ ਰਾਮੁ ਜਾਨਿਆ, ਤਿਨਹਿ ਪਛਾਨਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.11,
      "end_time": 43.44,
      "transcript": "ਜਿਉ ਗੂੰਗੇ, ਸਾਕਰ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.44,
      "end_time": 50.38,
      "transcript": "ਐਸਾ ਗਿਆਨੁ ਕਥੈ, ਬਨਵਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.38,
      "end_time": 57.099,
      "transcript": "ਮਨ ਰੇ ਪਵਨ ਦ੍ਰਿੜ ਸੁਖਮਨ ਨਾਰੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.099,
      "end_time": 61.29,
      "transcript": "ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.255,
      "end_time": 75.315,
      "transcript": "ਸੋ ਗੁਰੁ ਕਰਹੁ, ਜਿ ਬਹੁਰਿ ਨ ਕਰਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.315,
      "end_time": 82.415,
      "transcript": "ਸੋ ਪਦੁ ਰਵਹੁ, ਜਿ ਬਹੁਰਿ ਨ ਰਵਨਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 82.415,
      "end_time": 89.595,
      "transcript": "ਸੋ ਧਿਆਨੁ ਧਰਹੁ, ਜਿ ਬਹੁਰਿ ਨ ਧਰਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 89.595,
      "end_time": 96.87,
      "transcript": "ਐਸੇ ਮਰਹੁ, ਜਿ ਬਹੁਰਿ ਨ ਮਰਨਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 96.87,
      "end_time": 103.87,
      "transcript": "ਉਲਟੀ ਗੰਗਾ, ਜਮੁਨ ਮਿਲਾਵਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 103.87,
      "end_time": 110.815,
      "transcript": "ਬਿਨੁ ਜਲ ਸੰਗਮ, ਮਨ ਮਹਿ ਨਾ੍ਵਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 110.815,
      "end_time": 118.36,
      "transcript": "ਲੋਚਾ ਸਮਸਰਿ, ਇਹੁ ਬਿਉਹਾਰਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 118.36,
      "end_time": 125.445,
      "transcript": "ਤਤੁ ਬੀਚਾਰਿ, ਕਿਆ ਅਵਰਿ ਬੀਚਾਰਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 125.445,
      "end_time": 132.54,
      "transcript": "ਅਪੁ ਤੇਜੁ ਬਾਇ, ਪ੍ਰਿਥਮੀ ਆਕਾਸਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 132.54,
      "end_time": 139.635,
      "transcript": "ਐਸੀ ਰਹਤ ਰਹਉ, ਹਰਿ ਪਾਸਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 139.635,
      "end_time": 146.655,
      "transcript": "ਕਹੈ ਕਬੀਰ, ਨਿਰੰਜਨ ਧਿਆਵਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 146.655,
      "end_time": 153.265,
      "transcript": "ਤਿਤੁ ਘਰਿ ਜਾਉ, ਜਿ ਬਹੁਰਿ ਨ ਆਵਉ"
    }
  ]
}

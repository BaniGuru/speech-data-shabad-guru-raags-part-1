{
  "audio_file": "0130 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.526,
      "end_time": 16.066,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਮਾਝ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 30.601,
      "end_time": 38.082,
      "transcript": "ਗੁਰਮੁਖਿ ਜਿੰਦੂ, ਜਪਿ ਨਾਮੁ ਕਰੰਮਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 38.082,
      "end_time": 45.409,
      "transcript": "ਮਤਿ ਮਾਤਾ ਮਤਿ ਜੀਉ, ਨਾਮੁ ਮੁਖਿ ਰਾਮਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.409,
      "end_time": 52.632,
      "transcript": "ਸੰਤੋਖੁ ਪਿਤਾ ਕਰਿ, ਗੁਰੁ ਪੁਰਖੁ ਅਜਨਮਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.632,
      "end_time": 60.146,
      "transcript": "ਵਡਭਾਗੀ ਮਿਲੁ ਰਾਮਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.8,
      "end_time": 75.065,
      "transcript": "ਗੁਰੁ ਜੋਗੀ ਪੁਰਖੁ ਮਿਲਿਆ, ਰੰਗੁ ਮਾਣੀ ਜੀਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.065,
      "end_time": 82.273,
      "transcript": "ਗੁਰੁ ਹਰਿ ਰੰਗਿ ਰਤੜਾ, ਸਦਾ ਨਿਰਬਾਣੀ ਜੀਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 82.273,
      "end_time": 89.773,
      "transcript": "ਵਡਭਾਗੀ ਮਿਲੁ, ਸੁਘੜ ਸੁਜਾਣੀ ਜੀਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 89.773,
      "end_time": 96.954,
      "transcript": "ਮੇਰਾ ਮਨੁ ਤਨੁ, ਹਰਿ ਰੰਗਿ ਭਿੰਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 96.954,
      "end_time": 104.354,
      "transcript": "ਆਵਹੁ ਸੰਤਹੁ ਮਿਲਿ ਨਾਮੁ ਜਪਾਹਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.354,
      "end_time": 111.745,
      "transcript": "ਵਿਚਿ ਸੰਗਤਿ ਨਾਮੁ ਸਦਾ ਲੈ ਲਾਹਾ ਜੀਉ"
    },
    {
      "section_id": "section-00012",
      "start_time": 111.745,
      "end_time": 119.146,
      "transcript": "ਕਰਿ ਸੇਵਾ ਸੰਤਾ, ਅੰਮ੍ਰਿਤੁ ਮੁਖਿ ਪਾਹਾ ਜੀਉ"
    },
    {
      "section_id": "section-00013",
      "start_time": 119.146,
      "end_time": 126.915,
      "transcript": "ਮਿਲੁ ਪੂਰਬਿ ਲਿਖਿਅੜੇ ਧੁਰਿ ਕਰਮਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 134.04,
      "end_time": 141.205,
      "transcript": "ਸਾਵਣਿ ਵਰਸੁ, ਅੰਮ੍ਰਿਤਿ ਜਗੁ ਛਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 141.205,
      "end_time": 148.523,
      "transcript": "ਮਨੁ ਮੋਰੁ ਕੁਹੁਕਿਅੜਾ, ਸਬਦੁ ਮੁਖਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 148.523,
      "end_time": 155.735,
      "transcript": "ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਵੁਠੜਾ, ਮਿਲਿਆ ਹਰਿ ਰਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 155.735,
      "end_time": 162.91,
      "transcript": "ਜਨ ਨਾਨਕ ਪ੍ਰੇਮਿ ਰਤੰਨਾ"
    }
  ]
}

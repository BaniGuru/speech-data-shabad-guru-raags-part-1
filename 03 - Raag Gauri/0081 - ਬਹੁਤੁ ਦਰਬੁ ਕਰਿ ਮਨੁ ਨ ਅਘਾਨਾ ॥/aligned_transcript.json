{
  "audio_file": "0135 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.168,
      "end_time": 7.483,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.794,
      "end_time": 22.157,
      "transcript": "ਬਹੁਤੁ ਦਰਬੁ ਕਰਿ, ਮਨੁ ਨ ਅਘਾਨਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.157,
      "end_time": 29.516,
      "transcript": "ਅਨਿਕ ਰੂਪ ਦੇਖਿ, ਨਹ ਪਤੀਆਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.516,
      "end_time": 36.842,
      "transcript": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਉਰਝਿਓ ਜਾਨਿ ਮੇਰੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.842,
      "end_time": 44.12,
      "transcript": "ਓਹ ਬਿਨਸੈ, ਓਇ ਭਸਮੈ ਢੇਰੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.516,
      "end_time": 51.96,
      "transcript": "ਬਿਨੁ ਹਰਿ ਭਜਨ, ਦੇਖਉ ਬਿਲਲਾਤੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.96,
      "end_time": 63.15,
      "transcript": "ਧ੍ਰਿਗੁ ਤਨੁ ਧ੍ਰਿਗੁ ਧਨੁ ਮਾਇਆ ਸੰਗਿ ਰਾਤੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.48,
      "end_time": 77.43,
      "transcript": "ਜਿਉ ਬਿਗਾਰੀ ਕੈ ਸਿਰਿ, ਦੀਜਹਿ ਦਾਮ"
    },
    {
      "section_id": "section-00009",
      "start_time": 77.84,
      "end_time": 84.78,
      "transcript": "ਓਇ ਖਸਮੈ ਕੈ ਗ੍ਰਿਹਿ, ਉਨ ਦੂਖ ਸਹਾਮ"
    },
    {
      "section_id": "section-00010",
      "start_time": 85.24,
      "end_time": 92.403,
      "transcript": "ਜਿਉ ਸੁਪਨੈ, ਹੋਇ ਬੈਸਤ ਰਾਜਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 92.403,
      "end_time": 99.689,
      "transcript": "ਨੇਤ੍ਰ ਪਸਾਰੈ, ਤਾ ਨਿਰਾਰਥ ਕਾਜਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.689,
      "end_time": 107.22,
      "transcript": "ਜਿਉ ਰਾਖਾ, ਖੇਤ ਊਪਰਿ ਪਰਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 107.44,
      "end_time": 114.369,
      "transcript": "ਖੇਤੁ ਖਸਮ ਕਾ, ਰਾਖਾ ਉਠਿ ਜਾਏ"
    },
    {
      "section_id": "section-00014",
      "start_time": 114.369,
      "end_time": 122.029,
      "transcript": "ਉਸੁ ਖੇਤ ਕਾਰਣਿ, ਰਾਖਾ ਕੜੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 122.029,
      "end_time": 129.27,
      "transcript": "ਤਿਸ ਕੈ ਪਾਲੈ, ਕਛੂ ਨ ਪੜੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 129.27,
      "end_time": 136.707,
      "transcript": "ਜਿਸ ਕਾ ਰਾਜੁ, ਤਿਸੈ ਕਾ ਸੁਪਨਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 136.707,
      "end_time": 144.089,
      "transcript": "ਜਿਨਿ ਮਾਇਆ ਦੀਨੀ, ਤਿਨਿ ਲਾਈ ਤ੍ਰਿਸਨਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 144.089,
      "end_time": 151.472,
      "transcript": "ਆਪਿ ਬਿਨਾਹੇ, ਆਪਿ ਕਰੇ ਰਾਸਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 151.472,
      "end_time": 158.798,
      "transcript": "ਨਾਨਕ ਪ੍ਰਭ ਆਗੈ ਅਰਦਾਸਿ"
    }
  ]
}

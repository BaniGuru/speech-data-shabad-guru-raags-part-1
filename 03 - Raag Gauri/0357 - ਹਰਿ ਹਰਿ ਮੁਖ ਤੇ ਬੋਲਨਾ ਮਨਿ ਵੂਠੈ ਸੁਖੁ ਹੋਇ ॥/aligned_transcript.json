{
  "audio_file": "0196 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 6.831,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.44,
      "end_time": 20.755,
      "transcript": "ਹਰਿ ਹਰਿ ਮੁਖ ਤੇ ਬੋਲਨਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.2,
      "end_time": 27.485,
      "transcript": "ਮਨਿ ਵੂਠੈ ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.855,
      "end_time": 34.115,
      "transcript": "ਨਾਨਕ ਸਭ ਮਹਿ ਰਵਿ ਰਹਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.4,
      "end_time": 44.765,
      "transcript": "ਥਾਨ ਥਨੰਤਰਿ ਸੋਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.955,
      "end_time": 63.05,
      "transcript": "ਹੇਰਉ ਘਟਿ ਘਟਿ ਸਗਲ ਕੈ, ਪੂਰਿ ਰਹੇ ਭਗਵਾਨ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.05,
      "end_time": 71.335,
      "transcript": "ਹੋਵਤ ਆਏ ਸਦ ਸਦੀਵ, ਦੁਖ ਭੰਜਨ ਗੁਰ ਗਿਆਨ"
    },
    {
      "section_id": "section-00008",
      "start_time": 71.625,
      "end_time": 80.238,
      "transcript": "ਹਉ ਛੁਟਕੈ ਹੋਇ ਅਨੰਦੁ ਤਿਹ, ਹਉ ਨਾਹੀ ਤਹ ਆਪਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 80.238,
      "end_time": 88.695,
      "transcript": "ਹਤੇ ਦੂਖ ਜਨਮਹ ਮਰਨ, ਸੰਤਸੰਗ ਪਰਤਾਪ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.875,
      "end_time": 93.48,
      "transcript": "ਹਿਤ ਕਰਿ ਨਾਮ ਦ੍ਰਿੜੈ ਦਇਆਲਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 93.48,
      "end_time": 97.56,
      "transcript": "ਸੰਤਹ ਸੰਗਿ ਹੋਤ ਕਿਰਪਾਲਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.56,
      "end_time": 101.792,
      "transcript": "ਓਰੈ, ਕਛੂ ਨ ਕਿਨਹੂ ਕੀਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 101.792,
      "end_time": 107.427,
      "transcript": "ਨਾਨਕ ਸਭੁ ਕਛੁ, ਪ੍ਰਭ ਤੇ ਹੂਆ"
    }
  ]
}

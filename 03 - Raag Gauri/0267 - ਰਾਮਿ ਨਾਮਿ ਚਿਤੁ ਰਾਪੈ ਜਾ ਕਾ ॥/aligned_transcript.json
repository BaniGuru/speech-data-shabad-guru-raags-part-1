{
  "audio_file": "0173 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.215,
      "end_time": 13.135,
      "transcript": "ਗਉੜੀ ਮਹਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.135,
      "end_time": 23.159,
      "transcript": "ਪਹਿਲਾ ਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 35.605,
      "end_time": 43.08,
      "transcript": "ਰਾਮਿ ਨਾਮਿ, ਚਿਤੁ ਰਾਪੈ ਜਾ ਕਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 43.08,
      "end_time": 49.895,
      "transcript": "ਉਪਜੰਪਿ ਦਰਸਨੁ, ਕੀਜੈ ਤਾ ਕਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 50.345,
      "end_time": 57.54,
      "transcript": "ਰਾਮ ਨ ਜਪਹੁ, ਅਭਾਗੁ ਤੁਮਾਰਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 57.54,
      "end_time": 66.325,
      "transcript": "ਜੁਗਿ ਜੁਗਿ ਦਾਤਾ, ਪ੍ਰਭੁ ਰਾਮੁ ਹਮਾਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 72.24,
      "end_time": 78.805,
      "transcript": "ਗੁਰਮਤਿ ਰਾਮੁ ਜਪੈ, ਜਨੁ ਪੂਰਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 79.32,
      "end_time": 86.485,
      "transcript": "ਤਿਤੁ ਘਟ, ਅਨਹਤ ਬਾਜੇ ਤੂਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 86.485,
      "end_time": 93.265,
      "transcript": "ਜੋ ਜਨ, ਰਾਮ ਭਗਤਿ ਹਰਿ ਪਿਆਰਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 93.76,
      "end_time": 100.825,
      "transcript": "ਸੇ ਪ੍ਰਭਿ ਰਾਖੇ, ਕਿਰਪਾ ਧਾਰਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 108.095,
      "end_time": 115.25,
      "transcript": "ਜਿਨ ਕੈ ਹਿਰਦੈ, ਹਰਿ ਹਰਿ ਸੋਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 115.25,
      "end_time": 122.72,
      "transcript": "ਤਿਨ ਕਾ ਦਰਸੁ ਪਰਸਿ, ਸੁਖੁ ਹੋਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 122.72,
      "end_time": 129.72,
      "transcript": "ਸਰਬ ਜੀਆ ਮਹਿ, ਏਕੋ ਰਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 129.72,
      "end_time": 136.495,
      "transcript": "ਮਨਮੁਖਿ ਅਹੰਕਾਰੀ, ਫਿਰਿ ਜੂਨੀ ਭਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 137.015,
      "end_time": 143.765,
      "transcript": "ਸੋ ਬੂਝੈ, ਜੋ ਸਤਿਗੁਰੁ ਪਾਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 144.36,
      "end_time": 151.535,
      "transcript": "ਹਉਮੈ ਮਾਰੇ, ਗੁਰਸਬਦੇ ਪਾਏ"
    },
    {
      "section_id": "section-00017",
      "start_time": 158.92,
      "end_time": 165.635,
      "transcript": "ਅਰਧ ਉਰਧ ਕੀ ਸੰਧਿ, ਕਿਉ ਜਾਨੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 166.165,
      "end_time": 173.42,
      "transcript": "ਗੁਰਮੁਖਿ ਸੰਧਿ ਮਿਲੈ, ਮਨੁ ਮਾਨੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 173.42,
      "end_time": 180.64,
      "transcript": "ਹਮ ਪਾਪੀ ਨਿਰਗੁਣ ਕਉ, ਗੁਣੁ ਕਰੀਐ"
    },
    {
      "section_id": "section-00020",
      "start_time": 180.64,
      "end_time": 189.635,
      "transcript": "ਪ੍ਰਭ ਹੋਇ ਦਇਆਲੁ, ਨਾਨਕ ਜਨ ਤਰੀਐ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.465,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.465,
      "end_time": 13.318,
      "transcript": "ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.6,
      "end_time": 31.12,
      "transcript": "ਨਗਨ ਫਿਰਤ, ਜੌ ਪਾਈਐ ਜੋਗੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.12,
      "end_time": 38.465,
      "transcript": "ਬਨ ਕਾ ਮਿਰਗੁ, ਮੁਕਤਿ ਸਭੁ ਹੋਗੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.465,
      "end_time": 45.63,
      "transcript": "ਕਿਆ ਨਾਗੇ, ਕਿਆ ਬਾਧੇ ਚਾਮ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.63,
      "end_time": 53.135,
      "transcript": "ਜਬ ਨਹੀ ਚੀਨਸਿ, ਆਤਮ ਰਾਮ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.602,
      "end_time": 67.64,
      "transcript": "ਮੂਡ ਮੁੰਡਾਏ, ਜੌ ਸਿਧਿ ਪਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.64,
      "end_time": 74.92,
      "transcript": "ਮੁਕਤੀ ਭੇਡ, ਨ ਗਈਆ ਕਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 74.92,
      "end_time": 82.08,
      "transcript": "ਬਿੰਦੁ ਰਾਖਿ, ਜੌ ਤਰੀਐ ਭਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.08,
      "end_time": 89.145,
      "transcript": "ਖੁਸਰੈ ਕਿਉ ਨ, ਪਰਮ ਗਤਿ ਪਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 89.145,
      "end_time": 96.355,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਸੁਨਹੁ ਨਰ ਭਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 96.355,
      "end_time": 103.155,
      "transcript": "ਰਾਮ ਨਾਮ ਬਿਨੁ, ਕਿਨਿ ਗਤਿ ਪਾਈ"
    }
  ]
}

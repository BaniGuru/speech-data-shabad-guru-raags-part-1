{
  "audio_file": "0181 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.125,
      "end_time": 7.308,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.32,
      "end_time": 21.185,
      "transcript": "ਹਰਿ ਸਿਉ ਜੁਰੈ, ਤ ਸਭੁ ਕੋ ਮੀਤੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.185,
      "end_time": 28.4,
      "transcript": "ਹਰਿ ਸਿਉ ਜੁਰੈ, ਤ ਨਿਹਚਲੁ ਚੀਤੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.4,
      "end_time": 35.425,
      "transcript": "ਹਰਿ ਸਿਉ ਜੁਰੈ, ਨ ਵਿਆਪੈ ਕਾੜਾ੍"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.425,
      "end_time": 42.48,
      "transcript": "ਹਰਿ ਸਿਉ ਜੁਰੈ, ਤ ਹੋਇ ਨਿਸਤਾਰਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.48,
      "end_time": 49.455,
      "transcript": "ਰੇ ਮਨ ਮੇਰੇ, ਤੂੰ ਹਰਿ ਸਿਉ ਜੋਰੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.455,
      "end_time": 56.835,
      "transcript": "ਕਾਜਿ ਤੁਹਾਰੈ, ਨਾਹੀ ਹੋਰੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.505,
      "end_time": 81.345,
      "transcript": "ਵਡੇ ਵਡੇ, ਜੋ ਦੁਨੀਆਦਾਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.72,
      "end_time": 88.455,
      "transcript": "ਕਾਹੂ ਕਾਜਿ ਨਾਹੀ, ਗਾਵਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.8,
      "end_time": 95.631,
      "transcript": "ਹਰਿ ਕਾ ਦਾਸੁ, ਨੀਚ ਕੁਲੁ ਸੁਣਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.631,
      "end_time": 103.0,
      "transcript": "ਤਿਸ ਕੈ ਸੰਗਿ, ਖਿਨ ਮਹਿ ਉਧਰਹਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 103.0,
      "end_time": 109.665,
      "transcript": "ਕੋਟਿ ਮਜਨ, ਜਾ ਕੈ ਸੁਣਿ ਨਾਮ"
    },
    {
      "section_id": "section-00013",
      "start_time": 110.0,
      "end_time": 116.685,
      "transcript": "ਕੋਟਿ ਪੂਜਾ, ਜਾ ਕੈ ਹੈ ਧਿਆਨ"
    },
    {
      "section_id": "section-00014",
      "start_time": 117.08,
      "end_time": 123.925,
      "transcript": "ਕੋਟਿ ਪੁੰਨ, ਸੁਣਿ ਹਰਿ ਕੀ ਬਾਣੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 123.925,
      "end_time": 131.04,
      "transcript": "ਕੋਟਿ ਫਲਾ, ਗੁਰ ਤੇ ਬਿਧਿ ਜਾਣੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 131.04,
      "end_time": 137.745,
      "transcript": "ਮਨ ਅਪੁਨੇ ਮਹਿ, ਫਿਰਿ ਫਿਰਿ ਚੇਤ"
    },
    {
      "section_id": "section-00017",
      "start_time": 138.04,
      "end_time": 144.755,
      "transcript": "ਬਿਨਸਿ ਜਾਹਿ, ਮਾਇਆ ਕੇ ਹੇਤ"
    },
    {
      "section_id": "section-00018",
      "start_time": 145.12,
      "end_time": 151.975,
      "transcript": "ਹਰਿ ਅਬਿਨਾਸੀ, ਤੁਮਰੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 151.975,
      "end_time": 158.955,
      "transcript": "ਮਨ ਮੇਰੇ, ਰਚੁ ਰਾਮ ਕੈ ਰੰਗਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 158.955,
      "end_time": 165.795,
      "transcript": "ਜਾ ਕੈ ਕਾਮਿ, ਉਤਰੈ ਸਭ ਭੂਖ"
    },
    {
      "section_id": "section-00021",
      "start_time": 166.175,
      "end_time": 172.835,
      "transcript": "ਜਾ ਕੈ ਕਾਮਿ, ਨ ਜੋਹਹਿ ਦੂਤ"
    },
    {
      "section_id": "section-00022",
      "start_time": 173.28,
      "end_time": 179.995,
      "transcript": "ਜਾ ਕੈ ਕਾਮਿ, ਤੇਰਾ ਵਡ ਗਮਰੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 179.995,
      "end_time": 187.345,
      "transcript": "ਜਾ ਕੈ ਕਾਮਿ, ਹੋਵਹਿ ਤੂੰ ਅਮਰੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 194.345,
      "end_time": 201.115,
      "transcript": "ਜਾ ਕੇ ਚਾਕਰ ਕਉ, ਨਹੀ ਡਾਨ"
    },
    {
      "section_id": "section-00025",
      "start_time": 201.405,
      "end_time": 208.065,
      "transcript": "ਜਾ ਕੇ ਚਾਕਰ ਕਉ, ਨਹੀ ਬਾਨ"
    },
    {
      "section_id": "section-00026",
      "start_time": 208.315,
      "end_time": 215.44,
      "transcript": "ਜਾ ਕੈ ਦਫਤਰਿ, ਪੁਛੈ ਨ ਲੇਖਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 215.44,
      "end_time": 222.56,
      "transcript": "ਤਾ ਕੀ ਚਾਕਰੀ, ਕਰਹੁ ਬਿਸੇਖਾ"
    },
    {
      "section_id": "section-00028",
      "start_time": 222.56,
      "end_time": 229.265,
      "transcript": "ਜਾ ਕੈ, ਊਨ ਨਾਹੀ ਕਾਹੂ ਬਾਤ"
    },
    {
      "section_id": "section-00029",
      "start_time": 229.48,
      "end_time": 236.355,
      "transcript": "ਏਕਹਿ ਆਪਿ, ਅਨੇਕਹਿ ਭਾਤਿ"
    },
    {
      "section_id": "section-00030",
      "start_time": 236.355,
      "end_time": 243.045,
      "transcript": "ਜਾ ਕੀ ਦ੍ਰਿਸਟਿ, ਹੋਇ ਸਦਾ ਨਿਹਾਲ"
    },
    {
      "section_id": "section-00031",
      "start_time": 243.185,
      "end_time": 250.48,
      "transcript": "ਮਨ ਮੇਰੇ, ਕਰਿ ਤਾ ਕੀ ਘਾਲ"
    },
    {
      "section_id": "section-00032",
      "start_time": 250.48,
      "end_time": 257.445,
      "transcript": "ਨਾ ਕੋ ਚਤੁਰੁ, ਨਾਹੀ ਕੋ ਮੂੜਾ"
    },
    {
      "section_id": "section-00033",
      "start_time": 257.445,
      "end_time": 264.6,
      "transcript": "ਨਾ ਕੋ ਹੀਣੁ, ਨਾਹੀ ਕੋ ਸੂਰਾ"
    },
    {
      "section_id": "section-00034",
      "start_time": 264.6,
      "end_time": 271.265,
      "transcript": "ਜਿਤੁ ਕੋ ਲਾਇਆ, ਤਿਤ ਹੀ ਲਾਗਾ"
    },
    {
      "section_id": "section-00035",
      "start_time": 271.665,
      "end_time": 278.375,
      "transcript": "ਸੋ ਸੇਵਕੁ, ਨਾਨਕ ਜਿਸੁ ਭਾਗਾ"
    }
  ]
}

{
  "audio_file": "0170 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.106,
      "end_time": 19.854,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 29.007,
      "end_time": 37.0,
      "transcript": "ਐਸੋ ਦਾਸੁ ਮਿਲੈ, ਸੁਖੁ ਹੋਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.0,
      "end_time": 44.52,
      "transcript": "ਦੁਖੁ ਵਿਸਰੈ, ਪਾਵੈ ਸਚੁ ਸੋਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.52,
      "end_time": 51.565,
      "transcript": "ਦਰਸਨੁ ਦੇਖਿ, ਭਈ ਮਤਿ ਪੂਰੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 51.915,
      "end_time": 59.715,
      "transcript": "ਅਠਸਠਿ ਮਜਨੁ, ਚਰਨਹ ਧੂਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 66.895,
      "end_time": 74.27,
      "transcript": "ਨੇਤ੍ਰ ਸੰਤੋਖੇ, ਏਕ ਲਿਵ ਤਾਰਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 74.27,
      "end_time": 81.395,
      "transcript": "ਜਿਹਵਾ ਸੂਚੀ, ਹਰਿ ਰਸ ਸਾਰਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 81.395,
      "end_time": 89.24,
      "transcript": "ਸਚੁ ਕਰਣੀ, ਅਭ ਅੰਤਰਿ ਸੇਵਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 89.24,
      "end_time": 96.41,
      "transcript": "ਮਨੁ ਤ੍ਰਿਪਤਾਸਿਆ, ਅਲਖ ਅਭੇਵਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 96.41,
      "end_time": 104.0,
      "transcript": "ਜਹ ਜਹ ਦੇਖਉ, ਤਹ ਤਹ ਸਾਚਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.0,
      "end_time": 111.29,
      "transcript": "ਬਿਨੁ ਬੂਝੇ, ਝਗਰਤ ਜਗੁ ਕਾਚਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 111.29,
      "end_time": 118.415,
      "transcript": "ਗੁਰੁ ਸਮਝਾਵੈ, ਸੋਝੀ ਹੋਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 118.415,
      "end_time": 125.725,
      "transcript": "ਗੁਰਮੁਖਿ ਵਿਰਲਾ, ਬੂਝੈ ਕੋਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 125.725,
      "end_time": 132.925,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਰਾਖਹੁ ਰਖਵਾਲੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 132.925,
      "end_time": 140.16,
      "transcript": "ਬਿਨੁ ਬੂਝੇ, ਪਸੂ ਭਏ ਬੇਤਾਲੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 140.16,
      "end_time": 147.32,
      "transcript": "ਗੁਰਿ ਕਹਿਆ, ਅਵਰੁ ਨਹੀ ਦੂਜਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 147.32,
      "end_time": 154.375,
      "transcript": "ਕਿਸੁ ਕਹੁ ਦੇਖਿ, ਕਰਉ ਅਨ ਪੂਜਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 154.375,
      "end_time": 161.235,
      "transcript": "ਸੰਤ ਹੇਤਿ, ਪ੍ਰਭਿ ਤ੍ਰਿਭਵਣ ਧਾਰੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 161.235,
      "end_time": 168.105,
      "transcript": "ਆਤਮੁ ਚੀਨੈ, ਸੁ ਤਤੁ ਬੀਚਾਰੇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 168.72,
      "end_time": 175.84,
      "transcript": "ਸਾਚੁ ਰਿਦੈ, ਸਚੁ ਪ੍ਰੇਮ ਨਿਵਾਸ"
    },
    {
      "section_id": "section-00021",
      "start_time": 175.84,
      "end_time": 182.525,
      "transcript": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ, ਹਮ ਤਾ ਕੇ ਦਾਸ"
    }
  ]
}

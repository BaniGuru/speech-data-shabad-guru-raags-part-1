{
  "audio_file": "0117 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.24,
      "end_time": 6.934,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.12,
      "end_time": 20.818,
      "transcript": "ਜਨਮਿ ਮਰੈ, ਤ੍ਰੈ ਗੁਣ ਹਿਤਕਾਰੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.818,
      "end_time": 27.855,
      "transcript": "ਚਾਰੇ ਬੇਦ, ਕਥਹਿ ਆਕਾਰੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.855,
      "end_time": 35.057,
      "transcript": "ਤੀਨਿ ਅਵਸਥਾ ਕਹਹਿ ਵਖਿਆਨੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.057,
      "end_time": 41.898,
      "transcript": "ਤੁਰੀਆਵਸਥਾ, ਸਤਿਗੁਰ ਤੇ ਹਰਿ ਜਾਨੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.898,
      "end_time": 48.86,
      "transcript": "ਰਾਮ ਭਗਤਿ, ਗੁਰ ਸੇਵਾ ਤਰਣਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.86,
      "end_time": 56.059,
      "transcript": "ਬਾਹੁੜਿ ਜਨਮੁ ਨ ਹੋਇ ਹੈ ਮਰਣਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.12,
      "end_time": 69.69,
      "transcript": "ਚਾਰਿ ਪਦਾਰਥ, ਕਹੈ ਸਭੁ ਕੋਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 69.69,
      "end_time": 76.596,
      "transcript": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ, ਪੰਡਿਤ ਮੁਖਿ ਸੋਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.596,
      "end_time": 83.929,
      "transcript": "ਬਿਨੁ ਗੁਰ ਅਰਥੁ ਬੀਚਾਰੁ ਨ ਪਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.929,
      "end_time": 90.97,
      "transcript": "ਮੁਕਤਿ ਪਦਾਰਥੁ, ਭਗਤਿ ਹਰਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 90.97,
      "end_time": 98.157,
      "transcript": "ਜਾ ਕੈ ਹਿਰਦੈ, ਵਸਿਆ ਹਰਿ ਸੋਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 98.157,
      "end_time": 105.021,
      "transcript": "ਗੁਰਮੁਖਿ ਭਗਤਿ, ਪਰਾਪਤਿ ਹੋਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 105.021,
      "end_time": 112.142,
      "transcript": "ਹਰਿ ਕੀ ਭਗਤਿ, ਮੁਕਤਿ ਆਨੰਦੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 112.142,
      "end_time": 119.082,
      "transcript": "ਗੁਰਮਤਿ ਪਾਏ, ਪਰਮਾਨੰਦੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 119.082,
      "end_time": 126.284,
      "transcript": "ਜਿਨਿ ਪਾਇਆ ਗੁਰਿ ਦੇਖਿ ਦਿਖਾਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 126.284,
      "end_time": 133.377,
      "transcript": "ਆਸਾ ਮਾਹਿ, ਨਿਰਾਸੁ ਬੁਝਾਇਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 133.377,
      "end_time": 140.324,
      "transcript": "ਦੀਨਾ ਨਾਥੁ, ਸਰਬ ਸੁਖਦਾਤਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 140.324,
      "end_time": 148.675,
      "transcript": "ਨਾਨਕ ਹਰਿ ਚਰਣੀ ਮਨੁ ਰਾਤਾ"
    }
  ]
}

{
  "audio_file": "0146 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.225,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.345,
      "end_time": 18.331,
      "transcript": "ਰਾਮ ਰੰਗੁ, ਕਦੇ ਉਤਰਿ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.331,
      "end_time": 24.92,
      "transcript": "ਗੁਰੁ ਪੂਰਾ, ਜਿਸੁ ਦੇਇ ਬੁਝਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.92,
      "end_time": 31.105,
      "transcript": "ਹਰਿ ਰੰਗਿ ਰਾਤਾ, ਸੋ ਮਨੁ ਸਾਚਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.105,
      "end_time": 38.915,
      "transcript": "ਲਾਲ ਰੰਗ, ਪੂਰਨ ਪੁਰਖੁ ਬਿਧਾਤਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.735,
      "end_time": 53.12,
      "transcript": "ਸੰਤਹ ਸੰਗਿ ਬੈਸਿ, ਗੁਨ ਗਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.12,
      "end_time": 59.345,
      "transcript": "ਤਾ ਕਾ ਰੰਗੁ, ਨ ਉਤਰੈ ਜਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.345,
      "end_time": 65.6,
      "transcript": "ਬਿਨੁ ਹਰਿ ਸਿਮਰਨ, ਸੁਖੁ ਨਹੀ ਪਾਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.6,
      "end_time": 71.945,
      "transcript": "ਆਨ ਰੰਗ ਫੀਕੇ, ਸਭ ਮਾਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.965,
      "end_time": 84.215,
      "transcript": "ਗੁਰਿ ਰੰਗੇ, ਸੇ ਭਏ ਨਿਹਾਲ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.32,
      "end_time": 90.275,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਗੁਰ ਭਏ ਹੈ ਦਇਆਲ"
    }
  ]
}

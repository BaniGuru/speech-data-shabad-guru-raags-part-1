  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 2.118,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 8.48,
      "end_time": 15.714,
      "transcript": "ਞਤਨ ਕਰਹੁ ਤੁਮ ਅਨਿਕ ਬਿਧਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 15.714,
      "end_time": 22.789,
      "transcript": "ਰਹਨੁ ਨ ਪਾਵਹੁ ਮੀਤ"
    },
    {
      "section_id": "section-00004",
      "start_time": 22.789,
      "end_time": 29.225,
      "transcript": "ਜੀਵਤ ਰਹਹੁ ਹਰਿ ਹਰਿ ਭਜਹੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.605,
      "end_time": 38.225,
      "transcript": "ਨਾਨਕ ਨਾਮ ਪਰੀਤਿ ਪਵੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.8,
      "end_time": 48.432,
      "transcript": "ਞੰਞਾ ਞਾਣਹੁ ਦ੍ਰਿੜੁ ਸਹੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.432,
      "end_time": 52.605,
      "transcript": "ਬਿਨਸਿ ਜਾਤ ਏਹ ਹੇਤ"
    },
    {
      "section_id": "section-00008",
      "start_time": 52.965,
      "end_time": 57.205,
      "transcript": "ਗਣਤੀ ਗਣਉ ਨ ਗਣਿ ਸਕਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 57.205,
      "end_time": 61.48,
      "transcript": "ਊਠਿ ਸਿਧਾਰੇ ਕੇਤ"
    },
    {
      "section_id": "section-00010",
      "start_time": 61.48,
      "end_time": 65.947,
      "transcript": "ਞੋ ਪੇਖਉ ਸੋ ਬਿਨਸਤਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 65.947,
      "end_time": 70.049,
      "transcript": "ਕਾ ਸਿਉ ਕਰੀਐ ਸੰਗੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 70.049,
      "end_time": 78.485,
      "transcript": "ਞਾਣਹੁ ਇਆ ਬਿਧਿ ਸਹੀ ਚਿਤ ਝੂਠਉ ਮਾਇਆ ਰੰਗੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 78.665,
      "end_time": 83.308,
      "transcript": "ਞਾਣਤ ਸੋਈ ਸੰਤੁ ਸੁਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 83.308,
      "end_time": 87.451,
      "transcript": "ਭ੍ਰਮ ਤੇ ਕੀਚਿਤ ਭਿੰਨ"
    },
    {
      "section_id": "section-00015",
      "start_time": 87.451,
      "end_time": 95.735,
      "transcript": "ਅੰਧ ਕੂਪ ਤੇ ਤਿਹ ਕਢਹੁ ਜਿਹ ਹੋਵਹੁ ਸੁਪ੍ਰਸੰਨ"
    },
    {
      "section_id": "section-00016",
      "start_time": 95.96,
      "end_time": 104.065,
      "transcript": "ਞਾ ਕੈ ਹਾਥਿ ਸਮਰਥ, ਤੇ ਕਾਰਨ ਕਰਨੈ ਜੋਗ"
    },
    {
      "section_id": "section-00017",
      "start_time": 104.36,
      "end_time": 113.505,
      "transcript": "ਨਾਨਕ ਤਿਹ ਉਸਤਤਿ ਕਰਉ, ਞਾਹੂ ਕੀਓ ਸੰਜੋਗ"
    }
  ]
}

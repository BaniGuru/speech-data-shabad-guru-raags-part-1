    {
      "section_id": "section-00008",
      "start_time": 62.14,
      "end_time": 69.44,
      "transcript": "ਜਬ ਲਗੁ, ਮਨਿ ਬੈਕੁੰਠ ਕੀ ਆਸ"
    },
    {
      "section_id": "section-00009",
      "start_time": 69.44,
      "end_time": 75.959,
      "transcript": "ਤਬ ਲਗੁ, ਹੋਇ ਨਹੀ ਚਰਨ ਨਿਵਾਸੁ"

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.745,
      "transcript": "ਗਉੜੀ ਮਾਲਾ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.255,
      "end_time": 22.96,
      "transcript": "ਭਾਵਨੁ ਤਿਆਗਿਓ ਰੀ, ਤਿਆਗਿਓ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.96,
      "end_time": 30.455,
      "transcript": "ਤਿਆਗਿਓ, ਮੈ ਗੁਰ ਮਿਲਿ ਤਿਆਗਿਓ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.455,
      "end_time": 38.18,
      "transcript": "ਸਰਬ ਸੁਖ ਆਨੰਦ ਮੰਗਲ ਰਸ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.18,
      "end_time": 45.953,
      "transcript": "ਮਾਨਿ ਗੋਬਿੰਦੈ ਆਗਿਓ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.585,
      "end_time": 61.12,
      "transcript": "ਮਾਨੁ ਅਭਿਮਾਨੁ ਦੋਊ ਸਮਾਨੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.12,
      "end_time": 68.88,
      "transcript": "ਮਸਤਕੁ ਡਾਰਿ ਗੁਰ ਪਾਗਿਓ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.88,
      "end_time": 76.56,
      "transcript": "ਸੰਪਤ ਹਰਖੁ ਨ ਆਪਤ ਦੂਖਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.56,
      "end_time": 83.725,
      "transcript": "ਰੰਗੁ ਠਾਕੁਰੈ ਲਾਗਿਓ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.115,
      "end_time": 91.72,
      "transcript": "ਬਾਸ ਬਾਸਰੀ ਏਕੈ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.72,
      "end_time": 98.945,
      "transcript": "ਉਦਿਆਨ ਦ੍ਰਿਸਟਾਗਿਓ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.255,
      "end_time": 106.775,
      "transcript": "ਨਿਰਭਉ ਭਏ ਸੰਤ ਭ੍ਰਮੁ ਡਾਰਿਓ"
    },
    {
      "section_id": "section-00013",
      "start_time": 106.775,
      "end_time": 114.415,
      "transcript": "ਪੂਰਨ ਸਰਬਾਗਿਓ"
    },
    {
      "section_id": "section-00014",
      "start_time": 114.415,
      "end_time": 122.16,
      "transcript": "ਜੋ ਕਿਛੁ ਕਰਤੈ ਕਾਰਣੁ ਕੀਨੋ"
    },
    {
      "section_id": "section-00015",
      "start_time": 122.16,
      "end_time": 129.365,
      "transcript": "ਮਨਿ ਬੁਰੋ ਨ ਲਾਗਿਓ"
    },
    {
      "section_id": "section-00016",
      "start_time": 129.575,
      "end_time": 136.935,
      "transcript": "ਸਾਧਸੰਗਤਿ ਪਰਸਾਦਿ ਸੰਤਨ ਕੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 136.935,
      "end_time": 144.535,
      "transcript": "ਸੋਇਓ ਮਨੁ ਜਾਗਿਓ"
    },
    {
      "section_id": "section-00018",
      "start_time": 144.845,
      "end_time": 152.56,
      "transcript": "ਜਨ ਨਾਨਕ ਓੜਿ ਤੁਹਾਰੀ ਪਰਿਓ"
    },
    {
      "section_id": "section-00019",
      "start_time": 152.56,
      "end_time": 159.765,
      "transcript": "ਆਇਓ ਸਰਣਾਗਿਓ"
    },
    {
      "section_id": "section-00020",
      "start_time": 159.975,
      "end_time": 167.567,
      "transcript": "ਨਾਮ ਰੰਗ ਸਹਜ ਰਸ ਮਾਣੇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 167.567,
      "end_time": 174.655,
      "transcript": "ਫਿਰਿ ਦੂਖੁ ਨ ਲਾਗਿਓ"
    }
  ]
}

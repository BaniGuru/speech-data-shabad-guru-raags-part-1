  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.085,
      "end_time": 5.29,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.915,
      "end_time": 21.745,
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਨਾਮੁ ਜਪੁ ਜਪਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.745,
      "end_time": 29.205,
      "transcript": "ਅੰਤਰਿ ਬਾਹਰਿ ਰੰਗਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.505,
      "end_time": 37.095,
      "transcript": "ਗੁਰਿ ਪੂਰੈ ਉਪਦੇਸਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.095,
      "end_time": 48.425,
      "transcript": "ਨਰਕੁ ਨਾਹਿ ਸਾਧਸੰਗਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.44,
      "end_time": 57.675,
      "transcript": "ਨੰਨਾ, ਨਰਕਿ ਪਰਹਿ ਤੇ ਨਾਹੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.675,
      "end_time": 62.015,
      "transcript": "ਜਾ ਕੈ ਮਨਿ ਤਨਿ, ਨਾਮੁ ਬਸਾਹੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.015,
      "end_time": 66.31,
      "transcript": "ਨਾਮੁ ਨਿਧਾਨੁ, ਗੁਰਮੁਖਿ ਜੋ ਜਪਤੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.31,
      "end_time": 70.575,
      "transcript": "ਬਿਖੁ ਮਾਇਆ ਮਹਿ, ਨਾ ਓਇ ਖਪਤੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.575,
      "end_time": 74.79,
      "transcript": "ਨੰਨਾਕਾਰੁ, ਨ ਹੋਤਾ ਤਾ ਕਹੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 74.79,
      "end_time": 78.98,
      "transcript": "ਨਾਮੁ ਮੰਤ੍ਰੁ, ਗੁਰਿ ਦੀਨੋ ਜਾ ਕਹੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 78.98,
      "end_time": 83.2,
      "transcript": "ਨਿਧਿ ਨਿਧਾਨ, ਹਰਿ ਅੰਮ੍ਰਿਤ ਪੂਰੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 83.2,
      "end_time": 88.225,
      "transcript": "ਤਹ ਬਾਜੇ ਨਾਨਕ, ਅਨਹਦ ਤੂਰੇ"
    }
  ]
}

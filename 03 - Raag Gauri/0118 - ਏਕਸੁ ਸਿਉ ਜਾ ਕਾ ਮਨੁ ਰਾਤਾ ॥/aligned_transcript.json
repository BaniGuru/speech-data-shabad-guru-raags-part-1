{
  "audio_file": "0143 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.595,
      "end_time": 16.345,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 27.92,
      "end_time": 35.755,
      "transcript": "ਏਕਸੁ ਸਿਉ, ਜਾ ਕਾ ਮਨੁ ਰਾਤਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 35.965,
      "end_time": 43.725,
      "transcript": "ਵਿਸਰੀ ਤਿਸੈ, ਪਰਾਈ ਤਾਤਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.165,
      "end_time": 52.415,
      "transcript": "ਬਿਨੁ ਗੋਬਿੰਦ, ਨ ਦੀਸੈ ਕੋਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.415,
      "end_time": 61.125,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਕਰਤਾ ਸੋਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 80.715,
      "end_time": 89.215,
      "transcript": "ਮਨਹਿ ਕਮਾਵੈ, ਮੁਖਿ ਹਰਿ ਹਰਿ ਬੋਲੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 89.215,
      "end_time": 97.45,
      "transcript": "ਸੋ ਜਨੁ, ਇਤ ਉਤ ਕਤਹਿ ਨ ਡੋਲੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 97.45,
      "end_time": 105.295,
      "transcript": "ਜਾ ਕੈ ਹਰਿ ਧਨੁ, ਸੋ ਸਚ ਸਾਹੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 105.785,
      "end_time": 113.705,
      "transcript": "ਗੁਰਿ ਪੂਰੈ, ਕਰਿ ਦੀਨੋ ਵਿਸਾਹੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 113.985,
      "end_time": 122.031,
      "transcript": "ਜੀਵਨ ਪੁਰਖੁ, ਮਿਲਿਆ ਹਰਿ ਰਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 122.031,
      "end_time": 129.555,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਪਰਮ ਪਦੁ ਪਾਇਆ"
    }
  ]
}

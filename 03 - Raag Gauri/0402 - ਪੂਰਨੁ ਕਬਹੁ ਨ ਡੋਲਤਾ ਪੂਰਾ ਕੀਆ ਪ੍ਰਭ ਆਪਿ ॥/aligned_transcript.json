{
  "audio_file": "0223 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.24,
      "end_time": 6.525,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.045,
      "end_time": 22.655,
      "transcript": "ਪੂਰਨੁ ਕਬਹੁ ਨ ਡੋਲਤਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.04,
      "end_time": 30.135,
      "transcript": "ਪੂਰਾ ਕੀਆ ਪ੍ਰਭ ਆਪਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.845,
      "end_time": 38.195,
      "transcript": "ਦਿਨੁ ਦਿਨੁ ਚੜੈ ਸਵਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.815,
      "end_time": 49.085,
      "transcript": "ਨਾਨਕ ਹੋਤ ਨ ਘਾਟਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.24,
      "end_time": 66.605,
      "transcript": "ਪੂਰਨਮਾ ਪੂਰਨ ਪ੍ਰਭ ਏਕੁ, ਕਰਣ ਕਾਰਣ ਸਮਰਥੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.08,
      "end_time": 75.8,
      "transcript": "ਜੀਅ ਜੰਤ ਦਇਆਲ ਪੁਰਖੁ, ਸਭ ਊਪਰਿ ਜਾ ਕਾ ਹਥੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.8,
      "end_time": 84.095,
      "transcript": "ਗੁਣ ਨਿਧਾਨ ਗੋਬਿੰਦ ਗੁਰ, ਕੀਆ ਜਾ ਕਾ ਹੋਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.52,
      "end_time": 92.965,
      "transcript": "ਅੰਤਰਜਾਮੀ ਪ੍ਰਭੁ ਸੁਜਾਨੁ, ਅਲਖ ਨਿਰੰਜਨ ਸੋਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 93.295,
      "end_time": 101.455,
      "transcript": "ਪਾਰਬ੍ਰਹਮੁ ਪਰਮੇਸਰੋ, ਸਭ ਬਿਧਿ ਜਾਨਣਹਾਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 101.88,
      "end_time": 110.325,
      "transcript": "ਸੰਤ ਸਹਾਈ ਸਰਨਿ ਜੋਗੁ, ਆਠ ਪਹਰ ਨਮਸਕਾਰ"
    },
    {
      "section_id": "section-00012",
      "start_time": 110.64,
      "end_time": 118.83,
      "transcript": "ਅਕਥ ਕਥਾ ਨਹ ਬੂਝੀਐ, ਸਿਮਰਹੁ ਹਰਿ ਕੇ ਚਰਨ"
    },
    {
      "section_id": "section-00013",
      "start_time": 118.83,
      "end_time": 130.218,
      "transcript": "ਪਤਿਤ ਉਧਾਰਨ ਅਨਾਥ ਨਾਥ, ਨਾਨਕ ਪ੍ਰਭ ਕੀ ਸਰਨ"
    }
  ]
}

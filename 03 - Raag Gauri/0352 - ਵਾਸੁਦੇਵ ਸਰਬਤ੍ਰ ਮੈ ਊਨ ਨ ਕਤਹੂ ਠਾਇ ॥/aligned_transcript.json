  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.415,
      "end_time": 10.575,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 10.575,
      "end_time": 16.215,
      "transcript": "ਵਾਸੁਦੇਵ ਸਰਬਤ੍ਰ ਮੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.6,
      "end_time": 22.095,
      "transcript": "ਊਨ ਨ ਕਤਹੂ ਠਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 22.68,
      "end_time": 28.075,
      "transcript": "ਅੰਤਰਿ ਬਾਹਰਿ ਸੰਗਿ ਹੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.465,
      "end_time": 34.065,
      "transcript": "ਨਾਨਕ ਕਾਇ ਦੁਰਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 34.44,
      "end_time": 36.005,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 45.68,
      "end_time": 53.15,
      "transcript": "ਵਵਾ ਵੈਰੁ, ਨ ਕਰੀਐ ਕਾਹੂ ਘਟ ਘਟ ਅੰਤਰਿ, ਬ੍ਰਹਮ ਸਮਾਹੂ"
    },
    {
      "section_id": "section-00008",
      "start_time": 53.15,
      "end_time": 60.96,
      "transcript": "ਵਾਸੁਦੇਵ, ਜਲ ਥਲ ਮਹਿ ਰਵਿਆ ਗੁਰ ਪ੍ਰਸਾਦਿ, ਵਿਰਲੈ ਹੀ ਗਵਿਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 60.96,
      "end_time": 68.585,
      "transcript": "ਵੈਰ ਵਿਰੋਧ ਮਿਟੇ, ਤਿਹ ਮਨ ਤੇ ਹਰਿ ਕੀਰਤਨੁ, ਗੁਰਮੁਖਿ ਜੋ ਸੁਨਤੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.585,
      "end_time": 76.899,
      "transcript": "ਵਰਨ ਚਿਹਨ, ਸਗਲਹ ਤੇ ਰਹਤਾ ਨਾਨਕ ਹਰਿ ਹਰਿ, ਗੁਰਮੁਖਿ ਜੋ ਕਹਤਾ"
    }
  ]
}

{
  "audio_file": "0244 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.188,
      "end_time": 12.5,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.5,
      "end_time": 19.124,
      "transcript": "ਭੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.124,
      "end_time": 28.502,
      "transcript": "ਸੋਰਠਿ ਭੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 46.197,
      "end_time": 54.515,
      "transcript": "ਰੇ ਜੀਅ ਨਿਲਜ, ਲਾਜ ਤੁੋਹਿ ਨਾਹੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 54.96,
      "end_time": 62.939,
      "transcript": "ਹਰਿ ਤਜਿ ਕਤ ਕਾਹੂ ਕੇ ਜਾਂਹੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.939,
      "end_time": 67.888,
      "transcript": "ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.755,
      "end_time": 80.244,
      "transcript": "ਜਾ ਕੋ ਠਾਕੁਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 80.244,
      "end_time": 84.415,
      "transcript": "ਊਚਾ ਹੋਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.595,
      "end_time": 88.747,
      "transcript": "ਸੋ ਜਨੁ ਪਰ ਘਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.747,
      "end_time": 93.006,
      "transcript": "ਜਾਤ ਨ ਸੋਹੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 93.006,
      "end_time": 97.336,
      "transcript": "ਸੋ ਸਾਹਿਬੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.336,
      "end_time": 101.415,
      "transcript": "ਰਹਿਆ ਭਰਪੂਰਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 101.585,
      "end_time": 105.739,
      "transcript": "ਸਦਾ ਸੰਗਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 105.739,
      "end_time": 110.046,
      "transcript": "ਨਾਹੀ ਹਰਿ ਦੂਰਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 110.046,
      "end_time": 118.537,
      "transcript": "ਕਵਲਾ, ਚਰਨ ਸਰਨ ਹੈ ਜਾ ਕੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 118.537,
      "end_time": 126.595,
      "transcript": "ਕਹੁ ਜਨ, ਕਾ ਨਾਹੀ ਘਰ ਤਾ ਕੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 127.065,
      "end_time": 135.588,
      "transcript": "ਸਭੁ ਕੋਊ ਕਹੈ, ਜਾਸੁ ਕੀ ਬਾਤਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 135.588,
      "end_time": 143.505,
      "transcript": "ਸੋ ਸੰਮ੍ਰਥੁ, ਨਿਜ ਪਤਿ ਹੈ ਦਾਤਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 144.16,
      "end_time": 152.355,
      "transcript": "ਕਹੈ ਕਬੀਰੁ, ਪੂਰਨ ਜਗ ਸੋਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 152.545,
      "end_time": 160.937,
      "transcript": "ਜਾ ਕੇ ਹਿਰਦੈ, ਅਵਰੁ ਨ ਹੋਈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 169.172,
      "end_time": 177.685,
      "transcript": "ਕਉਨੁ ਕੋ ਪੂਤੁ, ਪਿਤਾ ਕੋ ਕਾ ਕੋ"
    },
    {
      "section_id": "section-00022",
      "start_time": 178.24,
      "end_time": 186.075,
      "transcript": "ਕਉਨੁ ਮਰੈ, ਕੋ ਦੇਇ ਸੰਤਾਪੋ"
    },
    {
      "section_id": "section-00023",
      "start_time": 186.68,
      "end_time": 194.986,
      "transcript": "ਹਰਿ ਠਗ, ਜਗ ਕਉ ਠਗਉਰੀ ਲਾਈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 194.986,
      "end_time": 203.157,
      "transcript": "ਹਰਿ ਕੇ ਬਿਓਗ ਕੈਸੇ ਜੀਅਉ ਮੇਰੀ ਮਾਈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 203.267,
      "end_time": 207.92,
      "transcript": "ਰਹਾਉ"
    },
    {
      "section_id": "section-00026",
      "start_time": 216.267,
      "end_time": 224.475,
      "transcript": "ਕਉਨ ਕੋ ਪੁਰਖੁ, ਕਉਨ ਕੀ ਨਾਰੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 224.68,
      "end_time": 232.785,
      "transcript": "ਇਆ ਤਤ, ਲੇਹੁ ਸਰੀਰ ਬਿਚਾਰੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 233.16,
      "end_time": 241.533,
      "transcript": "ਕਹਿ ਕਬੀਰ, ਠਗ ਸਿਉ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00029",
      "start_time": 241.533,
      "end_time": 249.946,
      "transcript": "ਗਈ ਠਗਉਰੀ, ਠਗੁ ਪਹਿਚਾਨਿਆ"
    },
    {
      "section_id": "section-00030",
      "start_time": 258.48,
      "end_time": 266.445,
      "transcript": "ਅਬ ਮੋ ਕਉ, ਭਏ ਰਾਜਾ ਰਾਮ ਸਹਾਈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 266.725,
      "end_time": 270.986,
      "transcript": "ਜਨਮ ਮਰਨ ਕਟਿ"
    },
    {
      "section_id": "section-00032",
      "start_time": 270.986,
      "end_time": 279.245,
      "transcript": "ਪਰਮ ਗਤਿ ਪਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00033",
      "start_time": 287.595,
      "end_time": 295.865,
      "transcript": "ਸਾਧੂ ਸੰਗਤਿ, ਦੀਓ ਰਲਾਇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 295.865,
      "end_time": 303.904,
      "transcript": "ਪੰਚ ਦੂਤ ਤੇ, ਲੀਓ ਛਡਾਇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 303.904,
      "end_time": 312.0,
      "transcript": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ, ਜਪਉ ਜਪੁ ਰਸਨਾ"
    },
    {
      "section_id": "section-00036",
      "start_time": 312.0,
      "end_time": 320.314,
      "transcript": "ਅਮੋਲ ਦਾਸੁ, ਕਰਿ ਲੀਨੋ ਅਪਨਾ"
    },
    {
      "section_id": "section-00037",
      "start_time": 320.314,
      "end_time": 328.765,
      "transcript": "ਸਤਿਗੁਰ ਕੀਨੋ ਪਰਉਪਕਾਰੁ"
    },
    {
      "section_id": "section-00038",
      "start_time": 329.005,
      "end_time": 336.831,
      "transcript": "ਕਾਢਿ ਲੀਨ, ਸਾਗਰ ਸੰਸਾਰ"
    },
    {
      "section_id": "section-00039",
      "start_time": 336.831,
      "end_time": 345.56,
      "transcript": "ਚਰਨ ਕਮਲ ਸਿਉ, ਲਾਗੀ ਪ੍ਰੀਤਿ"
    },
    {
      "section_id": "section-00040",
      "start_time": 345.56,
      "end_time": 353.135,
      "transcript": "ਗੋਬਿੰਦੁ ਬਸੈ, ਨਿਤਾ ਨਿਤ ਚੀਤ"
    },
    {
      "section_id": "section-00041",
      "start_time": 362.135,
      "end_time": 370.335,
      "transcript": "ਮਾਇਆ ਤਪਤਿ, ਬੁਝਿਆ ਅੰਗਿਆਰੁ"
    },
    {
      "section_id": "section-00042",
      "start_time": 370.455,
      "end_time": 378.458,
      "transcript": "ਮਨਿ ਸੰਤੋਖੁ, ਨਾਮੁ ਆਧਾਰੁ"
    },
    {
      "section_id": "section-00043",
      "start_time": 378.458,
      "end_time": 386.943,
      "transcript": "ਜਲਿ ਥਲਿ ਪੂਰਿ ਰਹੇ, ਪ੍ਰਭ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00044",
      "start_time": 386.943,
      "end_time": 395.311,
      "transcript": "ਜਤ ਪੇਖਉ, ਤਤ ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00045",
      "start_time": 395.311,
      "end_time": 403.813,
      "transcript": "ਅਪਨੀ ਭਗਤਿ, ਆਪ ਹੀ ਦ੍ਰਿੜਾਈ"
    },
    {
      "section_id": "section-00046",
      "start_time": 403.813,
      "end_time": 411.795,
      "transcript": "ਪੂਰਬ ਲਿਖਤੁ ਮਿਲਿਆ, ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00047",
      "start_time": 412.2,
      "end_time": 420.32,
      "transcript": "ਜਿਸੁ ਕ੍ਰਿਪਾ ਕਰੇ, ਤਿਸੁ ਪੂਰਨ ਸਾਜ"
    },
    {
      "section_id": "section-00048",
      "start_time": 420.32,
      "end_time": 428.892,
      "transcript": "ਕਬੀਰ ਕੋ ਸੁਆਮੀ, ਗਰੀਬ ਨਿਵਾਜ"
    },
    {
      "section_id": "section-00049",
      "start_time": 437.035,
      "end_time": 445.31,
      "transcript": "ਜਲਿ ਹੈ ਸੂਤਕੁ ਥਲਿ ਹੈ ਸੂਤਕੁ"
    },
    {
      "section_id": "section-00050",
      "start_time": 445.31,
      "end_time": 453.155,
      "transcript": "ਸੂਤਕ ਓਪਤਿ ਹੋਈ"
    },
    {
      "section_id": "section-00051",
      "start_time": 453.635,
      "end_time": 462.04,
      "transcript": "ਜਨਮੇ ਸੂਤਕੁ ਮੂਏ ਫੁਨਿ ਸੂਤਕੁ"
    },
    {
      "section_id": "section-00052",
      "start_time": 462.04,
      "end_time": 469.625,
      "transcript": "ਸੂਤਕ ਪਰਜ ਬਿਗੋਈ"
    },
    {
      "section_id": "section-00053",
      "start_time": 470.255,
      "end_time": 478.541,
      "transcript": "ਕਹੁ ਰੇ ਪੰਡੀਆ, ਕਉਨ ਪਵੀਤਾ"
    },
    {
      "section_id": "section-00054",
      "start_time": 478.541,
      "end_time": 486.363,
      "transcript": "ਐਸਾ ਗਿਆਨੁ ਜਪਹੁ ਮੇਰੇ ਮੀਤਾ"
    },
    {
      "section_id": "section-00055",
      "start_time": 486.363,
      "end_time": 490.741,
      "transcript": "ਰਹਾਉ"
    },
    {
      "section_id": "section-00056",
      "start_time": 498.8,
      "end_time": 507.48,
      "transcript": "ਨੈਨਹੁ ਸੂਤਕੁ ਬੈਨਹੁ ਸੂਤਕੁ"
    },
    {
      "section_id": "section-00057",
      "start_time": 507.48,
      "end_time": 515.483,
      "transcript": "ਸੂਤਕੁ ਸ੍ਰਵਨੀ ਹੋਈ"
    },
    {
      "section_id": "section-00058",
      "start_time": 515.483,
      "end_time": 523.872,
      "transcript": "ਊਠਤ ਬੈਠਤ ਸੂਤਕੁ ਲਾਗੈ"
    },
    {
      "section_id": "section-00059",
      "start_time": 523.872,
      "end_time": 531.925,
      "transcript": "ਸੂਤਕੁ ਪਰੈ ਰਸੋਈ"
    },
    {
      "section_id": "section-00060",
      "start_time": 531.925,
      "end_time": 540.299,
      "transcript": "ਫਾਸਨ ਕੀ ਬਿਧਿ ਸਭੁ ਕੋਊ ਜਾਨੈ"
    },
    {
      "section_id": "section-00061",
      "start_time": 540.299,
      "end_time": 548.204,
      "transcript": "ਛੂਟਨ ਕੀ ਇਕੁ ਕੋਈ"
    },
    {
      "section_id": "section-00062",
      "start_time": 548.204,
      "end_time": 556.405,
      "transcript": "ਕਹਿ ਕਬੀਰ ਰਾਮੁ ਰਿਦੈ ਬਿਚਾਰੈ"
    },
    {
      "section_id": "section-00063",
      "start_time": 556.625,
      "end_time": 565.085,
      "transcript": "ਸੂਤਕੁ ਤਿਨੈ ਨ ਹੋਈ"
    }
  ]
}

{
  "audio_file": "0130 CPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.32,
      "end_time": 14.983,
      "transcript": "ਗਉੜੀ ਮਾਝ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 29.48,
      "end_time": 36.605,
      "transcript": "ਆਉ ਸਖੀ ਗੁਣ ਕਾਮਣ ਕਰੀਹਾ ਜੀਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.605,
      "end_time": 43.733,
      "transcript": "ਮਿਲਿ ਸੰਤ ਜਨਾ ਰੰਗੁ ਮਾਣਿਹ ਰਲੀਆ ਜੀਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 43.733,
      "end_time": 50.948,
      "transcript": "ਗੁਰ ਦੀਪਕੁ ਗਿਆਨੁ, ਸਦਾ ਮਨਿ ਬਲੀਆ ਜੀਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 50.948,
      "end_time": 58.154,
      "transcript": "ਹਰਿ ਤੁਠੈ ਢੁਲਿ ਢੁਲਿ ਮਿਲੀਆ ਜੀਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 65.279,
      "end_time": 72.58,
      "transcript": "ਮੇਰੈ ਮਨਿ ਤਨਿ ਪ੍ਰੇਮੁ ਲਗਾ, ਹਰਿ ਢੋਲੇ ਜੀਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 72.58,
      "end_time": 79.726,
      "transcript": "ਮੈ ਮੇਲੇ ਮਿਤ੍ਰੁ, ਸਤਿਗੁਰੁ ਵੇਚੋਲੇ ਜੀਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 79.726,
      "end_time": 86.957,
      "transcript": "ਮਨੁ ਦੇਵਾਂ ਸੰਤਾ, ਮੇਰਾ ਪ੍ਰਭੁ ਮੇਲੇ ਜੀਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 86.957,
      "end_time": 94.25,
      "transcript": "ਹਰਿ ਵਿਟੜਿਅਹੁ, ਸਦਾ ਘੋਲੇ ਜੀਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 94.25,
      "end_time": 101.667,
      "transcript": "ਵਸੁ ਮੇਰੇ ਪਿਆਰਿਆ ਵਸੁ ਮੇਰੇ ਗੋਵਿਦਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 101.667,
      "end_time": 108.581,
      "transcript": "ਹਰਿ ਕਰਿ ਕਿਰਪਾ ਮਨਿ ਵਸੁ ਜੀਉ"
    },
    {
      "section_id": "section-00012",
      "start_time": 108.581,
      "end_time": 115.827,
      "transcript": "ਮਨਿ ਚਿੰਦਿਅੜਾ ਫਲੁ ਪਾਇਆ ਮੇਰੇ ਗੋਵਿੰਦਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 115.827,
      "end_time": 122.915,
      "transcript": "ਗੁਰੁ ਪੂਰਾ ਵੇਖਿ ਵਿਗਸੁ ਜੀਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 122.915,
      "end_time": 129.906,
      "transcript": "ਹਰਿ ਨਾਮੁ ਮਿਲਿਆ ਸੋਹਾਗਣੀ ਮੇਰੇ ਗੋਵਿੰਦਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 129.906,
      "end_time": 137.291,
      "transcript": "ਮਨਿ ਅਨਦਿਨੁ ਅਨਦੁ ਰਹਸੁ ਜੀਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 137.291,
      "end_time": 144.382,
      "transcript": "ਹਰਿ ਪਾਇਅੜਾ ਵਡਭਾਗੀਈ ਮੇਰੇ ਗੋਵਿੰਦਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 144.382,
      "end_time": 151.871,
      "transcript": "ਨਿਤ ਲੈ ਲਾਹਾ ਮਨਿ ਹਸੁ ਜੀਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 158.8,
      "end_time": 165.812,
      "transcript": "ਹਰਿ ਆਪਿ ਉਪਾਏ ਹਰਿ ਆਪੇ ਵੇਖੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 165.812,
      "end_time": 172.73,
      "transcript": "ਹਰਿ ਆਪੇ ਕਾਰੈ ਲਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 172.73,
      "end_time": 180.091,
      "transcript": "ਇਕਿ ਖਾਵਹਿ ਬਖਸ ਤੋਟਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 180.091,
      "end_time": 187.101,
      "transcript": "ਇਕਨਾ ਫਕਾ ਪਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00022",
      "start_time": 187.101,
      "end_time": 194.288,
      "transcript": "ਇਕਿ ਰਾਜੇ ਤਖਤਿ ਬਹਹਿ ਨਿਤ ਸੁਖੀਏ"
    },
    {
      "section_id": "section-00023",
      "start_time": 194.288,
      "end_time": 201.345,
      "transcript": "ਇਕਨਾ ਭਿਖ ਮੰਗਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00024",
      "start_time": 201.345,
      "end_time": 208.599,
      "transcript": "ਸਭੁ ਇਕੋ ਸਬਦੁ ਵਰਤਦਾ ਮੇਰੇ ਗੋਵਿਦਾ"
    },
    {

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.192,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.24,
      "end_time": 18.006,
      "transcript": "ਮੀਤੁ ਕਰੈ, ਸੋਈ ਹਮ ਮਾਨਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.006,
      "end_time": 24.224,
      "transcript": "ਮੀਤ ਕੇ ਕਰਤਬ, ਕੁਸਲ ਸਮਾਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.224,
      "end_time": 30.36,
      "transcript": "ਏਕਾ ਟੇਕ, ਮੇਰੈ ਮਨਿ ਚੀਤ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.36,
      "end_time": 39.708,
      "transcript": "ਜਿਸੁ ਕਿਛੁ ਕਰਣਾ, ਸੁ ਹਮਰਾ ਮੀਤ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.45,
      "end_time": 51.496,
      "transcript": "ਮੀਤੁ ਹਮਾਰਾ ਵੇਪਰਵਾਹਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.496,
      "end_time": 57.514,
      "transcript": "ਗੁਰ ਕਿਰਪਾ ਤੇ, ਮੋਹਿ ਅਸਨਾਹਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.514,
      "end_time": 63.591,
      "transcript": "ਮੀਤੁ ਹਮਾਰਾ ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.591,
      "end_time": 69.886,
      "transcript": "ਸਮਰਥ ਪੁਰਖੁ, ਪਾਰਬ੍ਰਹਮੁ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.04,
      "end_time": 81.937,
      "transcript": "ਹਮ ਦਾਸੇ, ਤੁਮ ਠਾਕੁਰ ਮੇਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.937,
      "end_time": 87.958,
      "transcript": "ਮਾਨੁ ਮਹਤੁ, ਨਾਨਕ ਪ੍ਰਭੁ ਤੇਰੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 88.062,

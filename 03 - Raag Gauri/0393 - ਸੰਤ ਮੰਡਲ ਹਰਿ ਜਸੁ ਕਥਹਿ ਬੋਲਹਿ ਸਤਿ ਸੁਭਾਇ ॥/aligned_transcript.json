{
  "audio_file": "0222 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.0,
      "end_time": 6.748,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.92,
      "end_time": 20.395,
      "transcript": "ਸੰਤ ਮੰਡਲ ਹਰਿ ਜਸੁ ਕਥਹਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.395,
      "end_time": 26.645,
      "transcript": "ਬੋਲਹਿ ਸਤਿ ਸੁਭਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.175,
      "end_time": 33.565,
      "transcript": "ਨਾਨਕ ਮਨੁ ਸੰਤੋਖੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.84,
      "end_time": 44.241,
      "transcript": "ਏਕਸੁ ਸਿਉ ਲਿਵ ਲਾਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.765,
      "end_time": 62.593,
      "transcript": "ਸਪਤਮਿ ਸੰਚਹੁ ਨਾਮ ਧਨੁ, ਟੂਟਿ ਨ ਜਾਹਿ ਭੰਡਾਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.593,
      "end_time": 71.205,
      "transcript": "ਸੰਤਸੰਗਤਿ ਮਹਿ ਪਾਈਐ, ਅੰਤੁ ਨ ਪਾਰਾਵਾਰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 71.205,
      "end_time": 79.831,
      "transcript": "ਆਪੁ ਤਜਹੁ ਗੋਬਿੰਦ ਭਜਹੁ, ਸਰਨਿ ਪਰਹੁ ਹਰਿ ਰਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.831,
      "end_time": 88.442,
      "transcript": "ਦੂਖ ਹਰੈ ਭਵਜਲੁ ਤਰੈ, ਮਨ ਚਿੰਦਿਆ ਫਲੁ ਪਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.442,
      "end_time": 97.165,
      "transcript": "ਆਠ ਪਹਰ ਮਨਿ ਹਰਿ ਜਪੈ, ਸਫਲੁ ਜਨਮੁ ਪਰਵਾਣੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.325,
      "end_time": 105.945,
      "transcript": "ਅੰਤਰਿ ਬਾਹਰਿ ਸਦਾ ਸੰਗਿ, ਕਰਨੈਹਾਰੁ ਪਛਾਣੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.24,
      "end_time": 114.644,
      "transcript": "ਸੋ ਸਾਜਨੁ ਸੋ ਸਖਾ ਮੀਤੁ, ਜੋ ਹਰਿ ਕੀ ਮਤਿ ਦੇਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.644,
      "end_time": 123.345,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਬਲਿਹਾਰਣੈ, ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪੇਇ"
    }
  ]
}

{
  "audio_file": "0229 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.275,
      "end_time": 6.568,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.568,
      "end_time": 18.041,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.04,
      "end_time": 32.57,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਸਤਿਗੁਰੁ ਮੇਲਿਓਨੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.57,
      "end_time": 38.615,
      "transcript": "ਮੁਖਿ ਗੁਰਮੁਖਿ ਨਾਮੁ ਧਿਆਇਸੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.2,
      "end_time": 45.055,
      "transcript": "ਸੋ ਕਰੇ ਜਿ ਸਤਿਗੁਰ ਭਾਵਸੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.56,
      "end_time": 51.485,
      "transcript": "ਗੁਰੁ ਪੂਰਾ ਘਰੀ ਵਸਾਇਸੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.915,
      "end_time": 58.105,
      "transcript": "ਜਿਨ ਅੰਦਰਿ ਨਾਮੁ ਨਿਧਾਨੁ ਹੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.48,
      "end_time": 64.525,
      "transcript": "ਤਿਨ ਕਾ ਭਉ ਸਭੁ ਗਵਾਇਸੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.96,
      "end_time": 71.395,
      "transcript": "ਜਿਨ ਰਖਣ ਕਉ ਹਰਿ ਆਪਿ ਹੋਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.395,
      "end_time": 77.515,
      "transcript": "ਹੋਰ ਕੇਤੀ ਝਖਿ ਝਖਿ ਜਾਇਸੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.825,
      "end_time": 83.965,
      "transcript": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਧਿਆਇ ਤੂ"
    },
    {
      "section_id": "section-00012",
      "start_time": 84.36,
      "end_time": 90.49,
      "transcript": "ਹਰਿ ਹਲਤਿ ਪਲਤਿ ਛੋਡਾਇਸੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 90.49,
      "end_time": 97.773,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 103.635,
      "end_time": 109.665,
      "transcript": "ਗੁਰਸਿਖਾ ਕੈ ਮਨਿ ਭਾਵਦੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 110.095,
      "end_time": 116.45,
      "transcript": "ਗੁਰ ਸਤਿਗੁਰ ਕੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 116.45,
      "end_time": 122.795,
      "transcript": "ਹਰਿ ਰਾਖਹੁ ਪੈਜ ਸਤਿਗੁਰੂ ਕੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 122.795,
      "end_time": 128.705,
      "transcript": "ਨਿਤ ਚੜੈ ਸਵਾਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 129.2,
      "end_time": 135.6,
      "transcript": "ਗੁਰ ਸਤਿਗੁਰ ਕੈ ਮਨਿ ਪਾਰਬ੍ਰਹਮੁ ਹੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 135.6,
      "end_time": 141.335,
      "transcript": "ਪਾਰਬ੍ਰਹਮੁ ਛਡਾਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 141.92,
      "end_time": 148.28,
      "transcript": "ਗੁਰ ਸਤਿਗੁਰ ਤਾਣੁ ਦੀਬਾਣੁ ਹਰਿ"
    },
    {
      "section_id": "section-00021",
      "start_time": 148.28,
      "end_time": 154.105,
      "transcript": "ਤਿਨਿ ਸਭ ਆਣਿ ਨਿਵਾਈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 154.56,
      "end_time": 160.92,
      "transcript": "ਜਿਨੀ ਡਿਠਾ ਮੇਰਾ ਸਤਿਗੁਰੁ ਭਾਉ ਕਰਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 160.92,
      "end_time": 166.955,
      "transcript": "ਤਿਨ ਕੇ ਸਭਿ ਪਾਪ ਗਵਾਈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 167.32,
      "end_time": 173.205,
      "transcript": "ਹਰਿ ਦਰਗਹ ਤੇ ਮੁਖ ਉਜਲੇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 173.595,
      "end_time": 179.685,
      "transcript": "ਬਹੁ ਸੋਭਾ ਪਾਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 180.04,
      "end_time": 186.245,
      "transcript": "ਜਨੁ ਨਾਨਕੁ ਮੰਗੈ ਧੂੜਿ ਤਿਨ"
    },
    {
      "section_id": "section-00027",
      "start_time": 186.245,
      "end_time": 192.63,
      "transcript": "ਜੋ ਗੁਰ ਕੇ ਸਿਖ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 192.63,
      "end_time": 196.755,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00029",
      "start_time": 204.715,
      "end_time": 212.96,
      "transcript": "ਹਉ ਆਖਿ ਸਲਾਹੀ ਸਿਫਤਿ ਸਚੁ, ਸਚੁ ਸਚੇ ਕੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 212.96,
      "end_time": 220.84,
      "transcript": "ਸਾਲਾਹੀ ਸਚੁ ਸਲਾਹ ਸਚੁ, ਸਚੁ ਕੀਮਤਿ ਕਿਨੈ ਨ ਪਾਈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 220.84,
      "end_time": 229.21,
      "transcript": "ਸਚੁ ਸਚਾ ਰਸੁ ਜਿਨੀ ਚਖਿਆ, ਸੇ ਤ੍ਰਿਪਤਿ ਰਹੇ ਆਘਾਈ"
    },
    {
      "section_id": "section-00032",
      "start_time": 229.21,
      "end_time": 237.44,
      "transcript": "ਇਹੁ ਹਰਿ ਰਸੁ ਸੇਈ ਜਾਣਦੇ, ਜਿਉ ਗੂੰਗੈ ਮਿਠਿਆਈ ਖਾਈ"
    },
    {
      "section_id": "section-00033",
      "start_time": 237.44,
      "end_time": 245.035,
      "transcript": "ਗੁਰਿ ਪੂਰੈ ਹਰਿ ਪ੍ਰਭੁ ਸੇਵਿਆ, ਮਨਿ ਵਜੀ ਵਾਧਾਈ"
    },
    {
      "section_id": "section-00034",
      "start_time": 245.525,
      "end_time": 249.815,
      "transcript": "ਮਨਿ ਵਜੀ ਵਾਧਾਈ"
    }
  ]
}

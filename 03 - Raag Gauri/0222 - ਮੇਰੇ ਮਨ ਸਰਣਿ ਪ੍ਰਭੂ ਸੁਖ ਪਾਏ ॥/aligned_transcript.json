    {
      "section_id": "section-00020",
      "start_time": 175.32,
      "end_time": 182.885,
      "transcript": "ਮੁਕਤੁ ਭਇਆ ਬੰਧਨ ਗੁਰਿ ਖੋਲੇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 183.4,
      "end_time": 190.895,
      "transcript": "ਜਨ ਨਾਨਕ ਹਰਿ ਗੁਣ ਗਾਏ"
    }
  ]

{
  "audio_file": "0224 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.265,
      "end_time": 4.775,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.2,
      "end_time": 21.745,
      "transcript": "ਮੈ ਮਨਿ ਤਨਿ ਪ੍ਰੇਮੁ ਪਿਰੰਮ ਕਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.12,
      "end_time": 28.695,
      "transcript": "ਅਠੇ ਪਹਰ ਲਗੰਨਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.84,
      "end_time": 37.328,
      "transcript": "ਜਨ ਨਾਨਕ ਕਿਰਪਾ ਧਾਰਿ ਪ੍ਰਭ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.328,
      "end_time": 43.435,
      "transcript": "ਸਤਿਗੁਰ ਸੁਖਿ ਵਸੰਨਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.055,
      "end_time": 49.565,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.0,
      "end_time": 64.255,
      "transcript": "ਜਿਨ ਅੰਦਰਿ ਪ੍ਰੀਤਿ ਪਿਰੰਮ ਕੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.68,
      "end_time": 72.141,
      "transcript": "ਜਿਉ ਬੋਲਨਿ ਤਿਵੈ ਸੋਹੰਨਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 72.141,
      "end_time": 79.765,
      "transcript": "ਨਾਨਕ ਹਰਿ ਆਪੇ ਜਾਣਦਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.895,
      "end_time": 87.473,
      "transcript": "ਜਿਨਿ ਲਾਈ ਪ੍ਰੀਤਿ ਪਿਰੰਨਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.473,
      "end_time": 91.555,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 95.806,
      "end_time": 104.24,
      "transcript": "ਤੂ ਕਰਤਾ ਆਪਿ ਅਭੁਲੁ ਹੈ, ਭੁਲਣ ਵਿਚਿ ਨਾਹੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 104.24,
      "end_time": 112.042,
      "transcript": "ਤੂ ਕਰਹਿ ਸੁ ਸਚੇ ਭਲਾ ਹੈ, ਗੁਰ ਸਬਦਿ ਬੁਝਾਹੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 112.042,
      "end_time": 121.075,
      "transcript": "ਤੂ ਕਰਣ ਕਾਰਣ ਸਮਰਥੁ ਹੈ, ਦੂਜਾ ਕੋ ਨਾਹੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 121.075,
      "end_time": 129.265,
      "transcript": "ਤੂ ਸਾਹਿਬੁ ਅਗਮੁ ਦਇਆਲੁ ਹੈ, ਸਭਿ ਤੁਧੁ ਧਿਆਹੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 129.6,
      "end_time": 138.725,
      "transcript": "ਸਭਿ ਜੀਅ ਤੇਰੇ ਤੂ ਸਭਸ ਦਾ, ਤੂ ਸਭ ਛਡਾਹੀ"
    }
  ]
}

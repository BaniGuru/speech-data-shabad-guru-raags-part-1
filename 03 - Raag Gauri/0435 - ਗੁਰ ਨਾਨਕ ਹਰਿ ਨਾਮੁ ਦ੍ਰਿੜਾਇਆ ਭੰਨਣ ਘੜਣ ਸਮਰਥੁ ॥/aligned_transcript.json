      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.327,
      "end_time": 18.895,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 30.295,
      "end_time": 39.165,
      "transcript": "ਗੁਰ ਨਾਨਕ ਹਰਿ ਨਾਮੁ ਦ੍ਰਿੜਾਇਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 39.88,
      "end_time": 48.585,
      "transcript": "ਭੰਨਣ ਘੜਣ ਸਮਰਥੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 49.24,
      "end_time": 58.487,
      "transcript": "ਪ੍ਰਭੁ ਸਦਾ ਸਮਾਲਹਿ ਮਿਤ੍ਰ ਤੂ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.487,
      "end_time": 67.265,
      "transcript": "ਦੁਖੁ ਸਬਾਇਆ ਲਥੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.745,
      "end_time": 73.119,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 82.32,
      "end_time": 90.975,
      "transcript": "ਖੁਧਿਆਵੰਤੁ ਨ ਜਾਣਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 91.675,
      "end_time": 100.595,
      "transcript": "ਲਾਜ ਕੁਲਾਜ ਕੁਬੋਲੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 101.085,
      "end_time": 109.945,
      "transcript": "ਨਾਨਕੁ ਮਾਂਗੈ ਨਾਮੁ ਹਰਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 110.52,
      "end_time": 121.945,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਸੰਜੋਗੁ ਪਉੜੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 132.88,
      "end_time": 142.715,
      "transcript": "ਜੇਵੇਹੇ ਕਰਮ ਕਮਾਵਦਾ, ਤੇਵੇਹੇ ਫਲਤੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 143.36,
      "end_time": 153.035,
      "transcript": "ਚਬੇ ਤਤਾ ਲੋਹ ਸਾਰੁ, ਵਿਚਿ ਸੰਘੈ ਪਲਤੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 153.6,
      "end_time": 163.365,
      "transcript": "ਘਤਿ ਗਲਾਵਾਂ ਚਾਲਿਆ, ਤਿਨਿ ਦੂਤਿ ਅਮਲ ਤੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 164.015,
      "end_time": 173.685,
      "transcript": "ਕਾਈ ਆਸ ਨ ਪੁੰਨੀਆ, ਨਿਤ ਪਰ ਮਲੁ ਹਿਰਤੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 174.32,
      "end_time": 183.895,
      "transcript": "ਕੀਆ ਨ ਜਾਣੈ ਅਕਿਰਤਘਣ, ਵਿਚਿ ਜੋਨੀ ਫਿਰਤੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 184.48,
      "end_time": 194.025,
      "transcript": "ਸਭੇ ਧਿਰਾਂ ਨਿਖੁਟੀਅਸੁ, ਹਿਰਿ ਲਈਅਸੁ ਧਰ ਤੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 194.56,
      "end_time": 203.985,
      "transcript": "ਵਿਝਣ ਕਲਹ ਨ ਦੇਵਦਾ, ਤਾਂ ਲਇਆ ਕਰਤੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 204.565,
      "end_time": 209.6,
      "transcript": "ਜੋ ਜੋ ਕਰਤੇ ਅਹੰਮੇਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 209.6,
      "end_time": 215.165,
      "transcript": "ਝੜਿ ਧਰਤੀ ਪੜਤੇ"
    }
  ]
}

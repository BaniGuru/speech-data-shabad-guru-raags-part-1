{
  "audio_file": "0190 G Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.217,
      "end_time": 5.897,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.52,
      "end_time": 19.555,
      "transcript": "ਆਤਮ ਰਸੁ ਜਿਹ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.0,
      "end_time": 25.395,
      "transcript": "ਹਰਿ ਰੰਗ ਸਹਜੇ ਮਾਣੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.365,
      "end_time": 32.825,
      "transcript": "ਨਾਨਕ ਧਨਿ ਧਨਿ ਧੰਨਿ ਜਨ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.825,
      "end_time": 42.595,
      "transcript": "ਆਏ ਤੇ ਪਰਵਾਣੁ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.075,
      "end_time": 56.68,
      "transcript": "ਆਇਆ ਸਫਲ, ਤਾਹੂ ਕੋ ਗਨੀਐ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.68,
      "end_time": 60.792,
      "transcript": "ਜਾਸੁ ਰਸਨ, ਹਰਿ ਹਰਿ ਜਸੁ ਭਨੀਐ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.792,
      "end_time": 64.96,
      "transcript": "ਆਇ ਬਸਹਿ, ਸਾਧੂ ਕੈ ਸੰਗੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.96,
      "end_time": 68.961,
      "transcript": "ਅਨਦਿਨੁ, ਨਾਮੁ ਧਿਆਵਹਿ ਰੰਗੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.961,
      "end_time": 73.48,
      "transcript": "ਆਵਤ ਸੋ ਜਨੁ, ਨਾਮਹਿ ਰਾਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 73.48,
      "end_time": 77.56,
      "transcript": "ਜਾ ਕਉ, ਦਇਆ ਮਇਆ ਬਿਧਾਤਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 77.56,
      "end_time": 85.892,
      "transcript": "ਏਕਹਿ ਆਵਨ, ਫਿਰਿ ਜੋਨਿ ਨ ਆਇਆ ਨਾਨਕ, ਹਰਿ ਕੈ ਦਰਸਿ ਸਮਾਇਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 85.892,
      "end_time": 90.985,
      "transcript": "ਨਾਨਕ, ਹਰਿ ਕੈ ਦਰਸਿ ਸਮਾਇਆ"
    }
  ]
}

{
  "audio_file": "0143 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.135,
      "end_time": 8.087,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.855,
      "end_time": 23.84,
      "transcript": "ਕਰ ਕਰਿ ਟਹਲ, ਰਸਨਾ ਗੁਣ ਗਾਵਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.84,
      "end_time": 31.84,
      "transcript": "ਚਰਨ ਠਾਕੁਰ ਕੈ ਮਾਰਗਿ, ਧਾਵਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.84,
      "end_time": 39.76,
      "transcript": "ਭਲੋ ਸਮੋ, ਸਿਮਰਨ ਕੀ ਬਰੀਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.76,
      "end_time": 47.699,
      "transcript": "ਸਿਮਰਤ ਨਾਮੁ, ਭੈ ਪਾਰਿ ਉਤਰੀਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.325,
      "end_time": 75.32,
      "transcript": "ਨੇਤ੍ਰ, ਸੰਤਨ ਕਾ ਦਰਸਨੁ ਪੇਖੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.32,
      "end_time": 83.07,
      "transcript": "ਪ੍ਰਭ ਅਵਿਨਾਸੀ, ਮਨ ਮਹਿ ਲੇਖੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 83.07,
      "end_time": 90.465,
      "transcript": "ਸੁਣਿ ਕੀਰਤਨੁ, ਸਾਧ ਪਹਿ ਜਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 90.935,
      "end_time": 98.345,
      "transcript": "ਜਨਮ ਮਰਣ ਕੀ, ਤ੍ਰਾਸ ਮਿਟਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 98.84,
      "end_time": 106.52,
      "transcript": "ਚਰਣ ਕਮਲ ਠਾਕੁਰ, ਉਰਿ ਧਾਰਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 106.52,
      "end_time": 113.6,
      "transcript": "ਦੁਲਭ ਦੇਹ, ਨਾਨਕ ਨਿਸਤਾਰਿ"
    }
  ]
}

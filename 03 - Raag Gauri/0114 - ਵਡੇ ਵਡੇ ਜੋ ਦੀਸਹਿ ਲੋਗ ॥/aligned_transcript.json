{
  "audio_file": "0142 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.125,
      "end_time": 7.975,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.905,
      "end_time": 23.456,
      "transcript": "ਵਡੇ ਵਡੇ, ਜੋ ਦੀਸਹਿ ਲੋਗ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.456,
      "end_time": 31.245,
      "transcript": "ਤਿਨ ਕਉ ਬਿਆਪੈ, ਚਿੰਤਾ ਰੋਗ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.88,
      "end_time": 39.365,
      "transcript": "ਕਉਨ ਵਡਾ, ਮਾਇਆ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.645,
      "end_time": 47.986,
      "transcript": "ਸੋ ਵਡਾ, ਜਿਨਿ ਰਾਮ ਲਿਵ ਲਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.4,
      "end_time": 74.985,
      "transcript": "ਭੂਮੀਆ, ਭੂਮਿ ਊਪਰਿ ਨਿਤ ਲੁਝੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.32,
      "end_time": 82.805,
      "transcript": "ਛੋਡਿ ਚਲੈ, ਤ੍ਰਿਸਨਾ ਨਹੀ ਬੁਝੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 83.24,
      "end_time": 90.825,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਇਹੁ ਤਤੁ ਬੀਚਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 90.825,
      "end_time": 98.125,
      "transcript": "ਬਿਨੁ ਹਰਿ ਭਜਨ, ਨਾਹੀ ਛੁਟਕਾਰਾ"
    }
  ]
}

{
  "audio_file": "0149 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.245,
      "end_time": 13.515,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 29.56,
      "end_time": 35.99,
      "transcript": "ਪਉ ਸਰਣਾਈ, ਜਿਨਿ ਹਰਿ ਜਾਤੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 35.99,
      "end_time": 42.255,
      "transcript": "ਮਨੁ ਤਨੁ ਸੀਤਲੁ, ਚਰਣ ਹਰਿ ਰਾਤੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 42.48,
      "end_time": 48.685,
      "transcript": "ਭੈ ਭੰਜਨ ਪ੍ਰਭ, ਮਨਿ ਨ ਬਸਾਹੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 49.0,
      "end_time": 58.705,
      "transcript": "ਡਰਪਤ ਡਰਪਤ, ਜਨਮ ਬਹੁਤੁ ਜਾਹੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 65.035,
      "end_time": 71.565,
      "transcript": "ਜਾ ਕੈ ਰਿਦੈ, ਬਸਿਓ ਹਰਿ ਨਾਮ"
    },
    {
      "section_id": "section-00007",
      "start_time": 71.76,
      "end_time": 77.905,
      "transcript": "ਸਗਲ ਮਨੋਰਥ, ਤਾ ਕੇ ਪੂਰਨ ਕਾਮ"
    },
    {
      "section_id": "section-00008",
      "start_time": 78.28,
      "end_time": 84.84,
      "transcript": "ਜਨਮੁ ਜਰਾ ਮਿਰਤੁ, ਜਿਸੁ ਵਾਸਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.84,
      "end_time": 91.315,
      "transcript": "ਸੋ ਸਮਰਥੁ, ਸਿਮਰਿ ਸਾਸਿ ਗਿਰਾਸਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 97.715,
      "end_time": 103.985,
      "transcript": "ਮੀਤੁ ਸਾਜਨੁ ਸਖਾ, ਪ੍ਰਭੁ ਏਕ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.265,
      "end_time": 110.305,
      "transcript": "ਨਾਮੁ ਸੁਆਮੀ ਕਾ, ਨਾਨਕ ਟੇਕ"
    }
  ]
}

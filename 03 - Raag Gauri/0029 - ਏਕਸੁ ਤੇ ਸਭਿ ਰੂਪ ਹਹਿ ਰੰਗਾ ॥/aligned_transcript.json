{
  "audio_file": "0121 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.0,
      "end_time": 6.897,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.88,
      "end_time": 19.36,
      "transcript": "ਏਕਸੁ ਤੇ, ਸਭਿ ਰੂਪ ਹਹਿ ਰੰਗਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.36,
      "end_time": 25.8,
      "transcript": "ਪਉਣੁ ਪਾਣੀ ਬੈਸੰਤਰੁ, ਸਭਿ ਸਹਲੰਗਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.8,
      "end_time": 32.28,
      "transcript": "ਭਿੰਨ ਭਿੰਨ ਵੇਖੈ, ਹਰਿ ਪ੍ਰਭੁ ਰੰਗਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.28,
      "end_time": 38.8,
      "transcript": "ਏਕੁ ਅਚਰਜੁ, ਏਕੋ ਹੈ ਸੋਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 38.8,
      "end_time": 48.993,
      "transcript": "ਗੁਰਮੁਖਿ ਵੀਚਾਰੇ ਵਿਰਲਾ ਕੋਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.68,
      "end_time": 58.2,
      "transcript": "ਸਹਜਿ ਭਵੈ, ਪ੍ਰਭੁ ਸਭਨੀ ਥਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.2,
      "end_time": 64.553,
      "transcript": "ਕਹਾ ਗੁਪਤੁ ਪ੍ਰਗਟੁ, ਪ੍ਰਭਿ ਬਣਤ ਬਣਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.553,
      "end_time": 71.0,
      "transcript": "ਆਪੇ ਸੁਤਿਆ ਦੇਇ ਜਗਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.0,
      "end_time": 77.56,
      "transcript": "ਤਿਸ ਕੀ ਕੀਮਤਿ, ਕਿਨੈ ਨ ਹੋਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.56,
      "end_time": 84.08,
      "transcript": "ਕਹਿ ਕਹਿ ਕਥਨੁ, ਕਹੈ ਸਭੁ ਕੋਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 84.08,
      "end_time": 90.56,
      "transcript": "ਗੁਰ ਸਬਦਿ ਸਮਾਵੈ, ਬੂਝੈ ਹਰਿ ਸੋਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 90.56,
      "end_time": 96.743,
      "transcript": "ਸੁਣਿ ਸੁਣਿ ਵੇਖੈ, ਸਬਦਿ ਮਿਲਾਏ"
    },
    {
      "section_id": "section-00014",
      "start_time": 96.743,
      "end_time": 103.348,
      "transcript": "ਵਡੀ ਵਡਿਆਈ, ਗੁਰ ਸੇਵਾ ਤੇ ਪਾਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 103.348,
      "end_time": 109.66,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ, ਹਰਿ ਨਾਮਿ ਸਮਾਏ"
    }
  ]
}

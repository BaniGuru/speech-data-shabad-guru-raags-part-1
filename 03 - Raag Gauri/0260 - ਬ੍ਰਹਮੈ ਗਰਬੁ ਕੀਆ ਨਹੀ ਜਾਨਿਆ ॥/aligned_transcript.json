{
  "audio_file": "0170 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.965,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.44,
      "end_time": 21.475,
      "transcript": "ਬ੍ਰਹਮੈ ਗਰਬੁ ਕੀਆ, ਨਹੀ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.475,
      "end_time": 28.72,
      "transcript": "ਬੇਦ ਕੀ ਬਿਪਤਿ ਪੜੀ, ਪਛੁਤਾਨਿਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.72,
      "end_time": 35.88,
      "transcript": "ਜਹ ਪ੍ਰਭ ਸਿਮਰੇ, ਤਹੀ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.88,
      "end_time": 43.0,
      "transcript": "ਐਸਾ ਗਰਬੁ, ਬੁਰਾ ਸੰਸਾਰੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.0,
      "end_time": 49.945,
      "transcript": "ਜਿਸੁ ਗੁਰੁ ਮਿਲੈ, ਤਿਸੁ ਗਰਬੁ ਨਿਵਾਰੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.12,
      "end_time": 64.16,
      "transcript": "ਬਲਿ ਰਾਜਾ, ਮਾਇਆ ਅਹੰਕਾਰੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.16,
      "end_time": 71.24,
      "transcript": "ਜਗਨ ਕਰੈ, ਬਹੁ ਭਾਰ ਅਫਾਰੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.24,
      "end_time": 78.28,
      "transcript": "ਬਿਨੁ ਗੁਰ ਪੂਛੇ, ਜਾਇ ਪਇਆਰੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.28,
      "end_time": 85.38,
      "transcript": "ਹਰੀਚੰਦੁ ਦਾਨੁ ਕਰੈ, ਜਸੁ ਲੇਵੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.38,
      "end_time": 92.35,
      "transcript": "ਬਿਨੁ ਗੁਰ ਅੰਤੁ ਨ ਪਾਇ, ਅਭੇਵੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 92.35,
      "end_time": 99.48,
      "transcript": "ਆਪਿ ਭੁਲਾਇ, ਆਪੇ ਮਤਿ ਦੇਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 99.48,
      "end_time": 106.52,
      "transcript": "ਦੁਰਮਤਿ ਹਰਣਾਖਸੁ ਦੁਰਾਚਾਰੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 106.52,
      "end_time": 113.48,
      "transcript": "ਪ੍ਰਭੁ ਨਾਰਾਇਣੁ, ਗਰਬ ਪ੍ਰਹਾਰੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 113.48,
      "end_time": 120.095,
      "transcript": "ਪ੍ਰਹਲਾਦ ਉਧਾਰੇ, ਕਿਰਪਾ ਧਾਰੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 120.6,
      "end_time": 127.41,
      "transcript": "ਭੂਲੋ ਰਾਵਣੁ, ਮੁਗਧੁ ਅਚੇਤਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 127.41,
      "end_time": 134.64,
      "transcript": "ਲੂਟੀ ਲੰਕਾ, ਸੀਸ ਸਮੇਤਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 134.64,
      "end_time": 141.605,
      "transcript": "ਗਰਬਿ ਗਇਆ, ਬਿਨੁ ਸਤਿਗੁਰ ਹੇਤਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 141.605,
      "end_time": 148.88,
      "transcript": "ਸਹਸਬਾਹੁ, ਮਧੁ ਕੀਟ ਮਹਿਖਾਸਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 148.88,
      "end_time": 155.96,
      "transcript": "ਹਰਣਾਖਸੁ ਲੇ, ਨਖਹੁ ਬਿਧਾਸਾ"
    },
    {
      "section_id": "section-00021",
      "start_time": 155.96,
      "end_time": 162.925,
      "transcript": "ਦੈਤ ਸੰਘਾਰੇ, ਬਿਨੁ ਭਗਤਿ ਅਭਿਆਸਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 162.925,
      "end_time": 170.01,
      "transcript": "ਜਰਾਸੰਧਿ, ਕਾਲਜਮੁਨ ਸੰਘਾਰੇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 170.01,
      "end_time": 177.08,
      "transcript": "ਰਕਤਬੀਜੁ, ਕਾਲੁਨੇਮੁ ਬਿਦਾਰੇ"
    },
    {
      "section_id": "section-00024",
      "start_time": 177.08,
      "end_time": 183.635,
      "transcript": "ਦੈਤ ਸੰਘਾਰਿ, ਸੰਤ ਨਿਸਤਾਰੇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 184.095,
      "end_time": 190.825,
      "transcript": "ਆਪੇ ਸਤਿਗੁਰੁ, ਸਬਦੁ ਬੀਚਾਰੇ"
    },
    {
      "section_id": "section-00026",
      "start_time": 191.24,
      "end_time": 198.255,
      "transcript": "ਦੂਜੈ ਭਾਇ, ਦੈਤ ਸੰਘਾਰੇ"
    },
    {
      "section_id": "section-00027",
      "start_time": 198.255,
      "end_time": 205.095,
      "transcript": "ਗੁਰਮੁਖਿ, ਸਾਚਿ ਭਗਤਿ ਨਿਸਤਾਰੇ"
    },
    {
      "section_id": "section-00028",
      "start_time": 205.435,
      "end_time": 212.445,
      "transcript": "ਬੂਡਾ ਦੁਰਜੋਧਨੁ, ਪਤਿ ਖੋਈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 212.445,
      "end_time": 219.49,
      "transcript": "ਰਾਮੁ ਨ ਜਾਨਿਆ, ਕਰਤਾ ਸੋਈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 219.49,
      "end_time": 226.72,
      "transcript": "ਜਨ ਕਉ ਦੂਖਿ ਪਚੈ, ਦੁਖੁ ਹੋਈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 226.72,
      "end_time": 233.69,
      "transcript": "ਜਨਮੇਜੈ, ਗੁਰਸਬਦੁ ਨ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00032",
      "start_time": 233.69,
      "end_time": 240.695,
      "transcript": "ਕਿਉ ਸੁਖੁ ਪਾਵੈ, ਭਰਮਿ ਭੁਲਾਨਿਆ"
    },
    {
      "section_id": "section-00033",
      "start_time": 240.695,
      "end_time": 247.925,
      "transcript": "ਇਕੁ ਤਿਲੁ ਭੂਲੇ, ਬਹੁਰਿ ਪਛੁਤਾਨਿਆ"
    },
    {
      "section_id": "section-00034",
      "start_time": 247.925,
      "end_time": 255.015,
      "transcript": "ਕੰਸੁ ਕੇਸੁ ਚਾਂਡੂਰੁ ਨ ਕੋਈ"
    },
    {
      "section_id": "section-00035",
      "start_time": 255.015,
      "end_time": 262.005,
      "transcript": "ਰਾਮੁ ਨ ਚੀਨਿਆ, ਅਪਨੀ ਪਤਿ ਖੋਈ"
    },
    {
      "section_id": "section-00036",
      "start_time": 262.005,
      "end_time": 269.2,
      "transcript": "ਬਿਨੁ ਜਗਦੀਸ, ਨ ਰਾਖੈ ਕੋਈ"
    },
    {
      "section_id": "section-00037",
      "start_time": 269.2,
      "end_time": 276.235,
      "transcript": "ਬਿਨੁ ਗੁਰ, ਗਰਬੁ ਨ ਮੇਟਿਆ ਜਾਇ"
    },
    {
      "section_id": "section-00038",
      "start_time": 276.235,
      "end_time": 283.295,
      "transcript": "ਗੁਰਮਤਿ ਧਰਮੁ ਧੀਰਜੁ, ਹਰਿ ਨਾਇ"
    },
    {
      "section_id": "section-00039",
      "start_time": 283.295,
      "end_time": 289.955,
      "transcript": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ, ਗੁਣ ਗਾਇ"
    }
  ]
}

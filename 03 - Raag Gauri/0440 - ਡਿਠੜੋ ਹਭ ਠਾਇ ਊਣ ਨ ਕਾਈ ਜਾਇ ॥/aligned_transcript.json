      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.667,
      "end_time": 18.285,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.76,
      "end_time": 33.085,
      "transcript": "ਡਿਠੜੋ ਹਭ ਠਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.48,
      "end_time": 39.615,
      "transcript": "ਊਣ ਨ ਕਾਈ ਜਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 40.105,
      "end_time": 46.715,
      "transcript": "ਨਾਨਕ ਲਧਾ ਤਿਨ ਸੁਆਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.715,
      "end_time": 53.08,
      "transcript": "ਜਿਨਾ ਸਤਿਗੁਰੁ ਭੇਟਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.08,
      "end_time": 60.708,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 66.315,
      "end_time": 79.205,
      "transcript": "ਦਾਮਨੀ ਚਮਤਕਾਰ, ਤਿਉ ਵਰਤਾਰਾ ਜਗ ਖੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.205,
      "end_time": 91.865,
      "transcript": "ਵਥੁ ਸੁਹਾਵੀ ਸਾਇ, ਨਾਨਕ ਨਾਉ ਜਪੰਦੋ ਤਿਸੁ ਧਣੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.16,
      "end_time": 95.855,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.48,
      "end_time": 112.675,
      "transcript": "ਸਿਮ੍ਰਿਤਿ ਸਾਸਤ੍ਰ ਸੋਧਿ ਸਭਿ, ਕਿਨੈ ਕੀਮ ਨ ਜਾਣੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 112.96,
      "end_time": 121.245,
      "transcript": "ਜੋ ਜਨੁ ਭੇਟੈ ਸਾਧਸੰਗਿ, ਸੋ ਹਰਿ ਰੰਗੁ ਮਾਣੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 121.72,
      "end_time": 129.815,
      "transcript": "ਸਚੁ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ, ਏਹ ਰਤਨਾ ਖਾਣੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 130.2,
      "end_time": 138.465,
      "transcript": "ਮਸਤਕਿ ਹੋਵੈ ਲਿਖਿਆ, ਹਰਿ ਸਿਮਰਿ ਪਰਾਣੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 138.84,
      "end_time": 148.885,
      "transcript": "ਤੋਸਾ ਦਿਚੈ ਸਚੁ ਨਾਮੁ, ਨਾਨਕ ਮਿਹਮਾਣੀ"
    }
  ]
}

{
  "audio_file": "0174 CPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.474,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.825,
      "end_time": 19.094,
      "transcript": "ਇਸੁ ਜੁਗ ਕਾ ਧਰਮੁ, ਪੜਹੁ ਤੁਮ ਭਾਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.094,
      "end_time": 25.68,
      "transcript": "ਪੂਰੈ ਗੁਰਿ, ਸਭ ਸੋਝੀ ਪਾਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.68,
      "end_time": 32.11,
      "transcript": "ਐਥੈ ਅਗੈ, ਹਰਿ ਨਾਮੁ ਸਖਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.11,
      "end_time": 38.184,
      "transcript": "ਰਾਮ ਪੜਹੁ, ਮਨਿ ਕਰਹੁ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 38.184,
      "end_time": 48.005,
      "transcript": "ਗੁਰ ਪਰਸਾਦੀ, ਮੈਲੁ ਉਤਾਰੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.6,
      "end_time": 61.0,
      "transcript": "ਵਾਦਿ ਵਿਰੋਧਿ, ਨ ਪਾਇਆ ਜਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.0,
      "end_time": 67.46,
      "transcript": "ਮਨੁ ਤਨੁ ਫੀਕਾ, ਦੂਜੈ ਭਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.46,
      "end_time": 74.04,
      "transcript": "ਗੁਰ ਕੈ ਸਬਦਿ, ਸਚਿ ਲਿਵ ਲਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.04,
      "end_time": 80.44,
      "transcript": "ਹਉਮੈ ਮੈਲਾ, ਇਹੁ ਸੰਸਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.44,
      "end_time": 86.88,
      "transcript": "ਨਿਤ ਤੀਰਥਿ ਨਾਵੈ, ਨ ਜਾਇ ਅਹੰਕਾਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 86.88,
      "end_time": 93.215,
      "transcript": "ਬਿਨੁ ਗੁਰ ਭੇਟੇ, ਜਮੁ ਕਰੇ ਖੁਆਰਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 99.675,
      "end_time": 106.28,
      "transcript": "ਸੋ ਜਨੁ ਸਾਚਾ, ਜਿ ਹਉਮੈ ਮਾਰੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 106.28,
      "end_time": 112.465,
      "transcript": "ਗੁਰ ਕੈ ਸਬਦਿ, ਪੰਚ ਸੰਘਾਰੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 112.805,
      "end_time": 119.245,
      "transcript": "ਆਪਿ ਤਰੈ, ਸਗਲੇ ਕੁਲ ਤਾਰੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 119.245,
      "end_time": 125.64,
      "transcript": "ਮਾਇਆ ਮੋਹਿ, ਨਟਿ ਬਾਜੀ ਪਾਈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 125.64,
      "end_time": 131.87,
      "transcript": "ਮਨਮੁਖ ਅੰਧ, ਰਹੇ ਲਪਟਾਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 131.87,
      "end_time": 138.605,
      "transcript": "ਗੁਰਮੁਖਿ ਅਲਿਪਤ, ਰਹੇ ਲਿਵ ਲਾਈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 144.92,
      "end_time": 150.865,
      "transcript": "ਬਹੁਤੇ ਭੇਖ ਕਰੈ, ਭੇਖਧਾਰੀ"
    },
    {
      "section_id": "section-00020",
      "start_time": 151.24,
      "end_time": 157.325,
      "transcript": "ਅੰਤਰਿ ਤਿਸਨਾ, ਫਿਰੈ ਅਹੰਕਾਰੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 157.695,
      "end_time": 163.735,
      "transcript": "ਆਪੁ ਨ ਚੀਨੈ, ਬਾਜੀ ਹਾਰੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 164.08,
      "end_time": 170.44,
      "transcript": "ਕਾਪੜ ਪਹਿਰਿ, ਕਰੇ ਚਤੁਰਾਈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 170.44,
      "end_time": 176.68,
      "transcript": "ਮਾਇਆ ਮੋਹਿ ਅਤਿ ਭਰਮਿ ਭੁਲਾਈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 176.68,
      "end_time": 183.135,
      "transcript": "ਬਿਨੁ ਗੁਰ ਸੇਵੇ, ਬਹੁਤੁ ਦੁਖੁ ਪਾਈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 189.275,
      "end_time": 195.64,
      "transcript": "ਨਾਮਿ ਰਤੇ, ਸਦਾ ਬੈਰਾਗੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 195.64,
      "end_time": 201.833,
      "transcript": "ਗ੍ਰਿਹੀ ਅੰਤਰਿ, ਸਾਚਿ ਲਿਵ ਲਾਗੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 201.833,
      "end_time": 208.144,
      "transcript": "ਨਾਨਕ ਸਤਿਗੁਰੁ ਸੇਵਹਿ, ਸੇ ਵਡਭਾਗੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 208.258,
      "end_time": 214.612,
      "transcript": "ਗ੍ਰਿਹੀ ਅੰਤਰਿ, ਸਾਚਿ ਲਿਵ ਲਾਗੀ"
    },
    {
      "section_id": "section-00029",
      "start_time": 214.76,
      "end_time": 221.755,
      "transcript": "ਨਾਨਕ ਸਤਿਗੁਰੁ ਸੇਵਹਿ, ਸੇ ਵਡਭਾਗੀ"
    }
  ]
}

{
  "audio_file": "0144 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.055,
      "end_time": 14.062,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 30.745,
      "end_time": 37.705,
      "transcript": "ਰਾਖਿ ਲੀਆ, ਗੁਰਿ ਪੂਰੈ ਆਪਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 38.04,
      "end_time": 44.305,
      "transcript": "ਮਨਮੁਖ ਕਉ, ਲਾਗੋ ਸੰਤਾਪੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 44.715,
      "end_time": 50.605,
      "transcript": "ਗੁਰੂ ਗੁਰੂ, ਜਪਿ ਮੀਤ ਹਮਾਰੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 51.08,
      "end_time": 58.925,
      "transcript": "ਮੁਖ ਊਜਲ, ਹੋਵਹਿ ਦਰਬਾਰੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 66.92,
      "end_time": 73.142,
      "transcript": "ਗੁਰ ਕੇ ਚਰਣ, ਹਿਰਦੈ ਵਸਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 73.142,
      "end_time": 79.84,
      "transcript": "ਦੁਖ ਦੁਸਮਨ, ਤੇਰੀ ਹਤੈ ਬਲਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 79.84,
      "end_time": 86.08,
      "transcript": "ਗੁਰ ਕਾ ਸਬਦੁ, ਤੇਰੈ ਸੰਗਿ ਸਹਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 86.08,
      "end_time": 93.105,
      "transcript": "ਦਇਆਲ ਭਏ, ਸਗਲੇ ਜੀਅ ਭਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 99.48,
      "end_time": 105.515,
      "transcript": "ਗੁਰਿ ਪੂਰੈ, ਜਬ ਕਿਰਪਾ ਕਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 105.92,
      "end_time": 112.465,
      "transcript": "ਭਨਤਿ ਨਾਨਕ, ਮੇਰੀ ਪੂਰੀ ਪਰੀ"
    }
  ]
}

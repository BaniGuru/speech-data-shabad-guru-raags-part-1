{
  "audio_file": "0207 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.215,
      "end_time": 18.135,
      "transcript": "ਸਲੋਕੁ ਕਰਣ ਕਾਰਣ ਪ੍ਰਭੁ ਏਕੁ ਹੈ"
    },
    {
      "section_id": "section-00002",
      "start_time": 18.135,
      "end_time": 25.055,
      "transcript": "ਦੂਸਰ ਨਾਹੀ ਕੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.145,
      "end_time": 37.744,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਬਲਿਹਾਰਣੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 37.744,
      "end_time": 45.935,
      "transcript": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਸੋਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.396,
      "end_time": 55.125,
      "transcript": "ਇ ਇ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 73.72,
      "end_time": 81.655,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਕਰਨੈ ਜੋਗੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 82.2,
      "end_time": 90.165,
      "transcript": "ਜੋ ਤਿਸੁ ਭਾਵੈ, ਸੋਈ ਹੋਗੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 90.64,
      "end_time": 98.405,
      "transcript": "ਖਿਨ ਮਹਿ, ਥਾਪਿ ਉਥਾਪਨਹਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 99.0,
      "end_time": 107.24,
      "transcript": "ਅੰਤੁ ਨਹੀ ਕਿਛੁ ਪਾਰਾਵਾਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 107.24,
      "end_time": 115.185,
      "transcript": "ਹੁਕਮੇ ਧਾਰਿ, ਅਧਰ ਰਹਾਵੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 115.72,
      "end_time": 123.92,
      "transcript": "ਹੁਕਮੇ ਉਪਜੈ, ਹੁਕਮਿ ਸਮਾਵੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 123.92,
      "end_time": 131.635,
      "transcript": "ਹੁਕਮੇ, ਊਚ ਨੀਚ ਬਿਉਹਾਰ"
    },
    {
      "section_id": "section-00013",
      "start_time": 132.16,
      "end_time": 140.005,
      "transcript": "ਹੁਕਮੇ, ਅਨਿਕ ਰੰਗ ਪਰਕਾਰ"
    },
    {
      "section_id": "section-00014",
      "start_time": 140.52,
      "end_time": 148.345,
      "transcript": "ਕਰਿ ਕਰਿ ਦੇਖੈ, ਅਪਨੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 148.785,
      "end_time": 157.005,
      "transcript": "ਨਾਨਕ ਸਭ ਮਹਿ, ਰਹਿਆ ਸਮਾਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 169.24,
      "end_time": 177.44,
      "transcript": "ਪ੍ਰਭ ਭਾਵੈ, ਮਾਨੁਖ ਗਤਿ ਪਾਵੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 177.44,
      "end_time": 185.6,
      "transcript": "ਪ੍ਰਭ ਭਾਵੈ, ਤਾ ਪਾਥਰ ਤਰਾਵੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 185.6,
      "end_time": 193.72,
      "transcript": "ਪ੍ਰਭ ਭਾਵੈ, ਬਿਨੁ ਸਾਸ ਤੇ ਰਾਖੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 193.72,
      "end_time": 201.825,
      "transcript": "ਪ੍ਰਭ ਭਾਵੈ, ਤਾ ਹਰਿ ਗੁਣ ਭਾਖੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 210.12,
      "end_time": 217.815,
      "transcript": "ਪ੍ਰਭ ਭਾਵੈ, ਤਾ ਪਤਿਤ ਉਧਾਰੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 218.355,
      "end_time": 226.025,
      "transcript": "ਆਪਿ ਕਰੈ, ਆਪਨ ਬੀਚਾਰੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 226.485,
      "end_time": 234.275,
      "transcript": "ਦੁਹਾ ਸਿਰਿਆ ਕਾ, ਆਪਿ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00023",
      "start_time": 234.84,
      "end_time": 242.485,
      "transcript": "ਖੇਲੈ ਬਿਗਸੈ, ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 243.04,
      "end_time": 250.715,
      "transcript": "ਜੋ ਭਾਵੈ, ਸੋ ਕਾਰ ਕਰਾਵੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 251.125,
      "end_time": 259.32,
      "transcript": "ਨਾਨਕ ਦ੍ਰਿਸਟੀ, ਅਵਰੁ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 259.32,
      "end_time": 267.285,
      "transcript": "ਕਹੁ ਮਾਨੁਖ ਤੇ, ਕਿਆ ਹੋਇ ਆਵੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 267.285,
      "end_time": 275.6,
      "transcript": "ਜੋ ਤਿਸੁ ਭਾਵੈ, ਸੋਈ ਕਰਾਵੈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 275.6,
      "end_time": 283.185,
      "transcript": "ਇਸ ਕੈ ਹਾਥਿ ਹੋਇ, ਤਾ ਸਭੁ ਕਿਛੁ ਲੇਇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 283.76,
      "end_time": 292.051,
      "transcript": "ਜੋ ਤਿਸੁ ਭਾਵੈ, ਸੋਈ ਕਰੇਇ"
    },
    {
      "section_id": "section-00030",
      "start_time": 300.24,
      "end_time": 307.895,
      "transcript": "ਅਨਜਾਨਤ, ਬਿਖਿਆ ਮਹਿ ਰਚੈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 308.375,
      "end_time": 316.115,
      "transcript": "ਜੇ ਜਾਨਤ, ਆਪਨ ਆਪ ਬਚੈ"
    },
    {
      "section_id": "section-00032",
      "start_time": 316.52,
      "end_time": 324.68,
      "transcript": "ਭਰਮੇ ਭੂਲਾ, ਦਹ ਦਿਸਿ ਧਾਵੈ"
    },
    {
      "section_id": "section-00033",
      "start_time": 324.68,
      "end_time": 332.8,
      "transcript": "ਨਿਮਖ ਮਾਹਿ, ਚਾਰਿ ਕੁੰਟ ਫਿਰਿ ਆਵੈ"
    },
    {
      "section_id": "section-00034",
      "start_time": 332.8,
      "end_time": 340.395,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਜਿਸੁ ਅਪਨੀ ਭਗਤਿ ਦੇਇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 340.935,
      "end_time": 348.982,
      "transcript": "ਨਾਨਕ ਤੇ ਜਨ, ਨਾਮਿ ਮਿਲੇਇ"
    },
    {
      "section_id": "section-00036",
      "start_time": 348.982,
      "end_time": 356.735,
      "transcript": "ਖਿਨ ਮਹਿ, ਨੀਚ ਕੀਟ ਕਉ ਰਾਜ"
    },
    {
      "section_id": "section-00037",
      "start_time": 357.24,
      "end_time": 364.505,
      "transcript": "ਪਾਰਬ੍ਰਹਮ, ਗਰੀਬ ਨਿਵਾਜ"
    },
    {
      "section_id": "section-00038",
      "start_time": 365.36,
      "end_time": 373.37,
      "transcript": "ਜਾ ਕਾ, ਦ੍ਰਿਸਟਿ ਕਛੂ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00039",
      "start_time": 373.37,
      "end_time": 381.18,
      "transcript": "ਤਿਸੁ ਤਤਕਾਲ, ਦਹ ਦਿਸ ਪ੍ਰਗਟਾਵੈ"
    },
    {
      "section_id": "section-00040",
      "start_time": 389.366,
      "end_time": 397.285,
      "transcript": "ਜਾ ਕਉ, ਅਪੁਨੀ ਕਰੈ ਬਖਸੀਸ"
    },
    {
      "section_id": "section-00041",
      "start_time": 397.64,
      "end_time": 405.355,
      "transcript": "ਤਾ ਕਾ ਲੇਖਾ, ਨ ਗਨੈ ਜਗਦੀਸ"
    },
    {
      "section_id": "section-00042",
      "start_time": 405.645,
      "end_time": 413.8,
      "transcript": "ਜੀਉ ਪਿੰਡੁ, ਸਭ ਤਿਸ ਕੀ ਰਾਸਿ"
    },
    {
      "section_id": "section-00043",
      "start_time": 413.8,
      "end_time": 421.475,
      "transcript": "ਘਟਿ ਘਟਿ, ਪੂਰਨ ਬ੍ਰਹਮ ਪ੍ਰਗਾਸ"
    },
    {
      "section_id": "section-00044",
      "start_time": 421.88,
      "end_time": 429.485,
      "transcript": "ਅਪਨੀ ਬਣਤ, ਆਪਿ ਬਨਾਈ"
    },
    {
      "section_id": "section-00045",
      "start_time": 429.935,
      "end_time": 436.535,
      "transcript": "ਨਾਨਕ ਜੀਵੈ, ਦੇਖਿ ਬਡਾਈ"
    },
    {
      "section_id": "section-00046",
      "start_time": 438.12,
      "end_time": 445.998,
      "transcript": "ਇਸ ਕਾ ਬਲੁ, ਨਾਹੀ ਇਸੁ ਹਾਥ"
    },
    {
      "section_id": "section-00047",
      "start_time": 445.998,
      "end_time": 452.4,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਸਰਬ ਕੋ ਨਾਥ"
    },
    {
      "section_id": "section-00048",
      "start_time": 454.32,
      "end_time": 462.125,
      "transcript": "ਆਗਿਆਕਾਰੀ, ਬਪੁਰਾ ਜੀਉ"
    },
    {
      "section_id": "section-00049",
      "start_time": 462.125,
      "end_time": 469.545,
      "transcript": "ਜੋ ਤਿਸੁ ਭਾਵੈ, ਸੋਈ ਫੁਨਿ ਥੀਉ"
    },
    {
      "section_id": "section-00050",
      "start_time": 478.36,
      "end_time": 486.44,
      "transcript": "ਕਬਹੂ, ਊਚ ਨੀਚ ਮਹਿ ਬਸੈ"
    },
    {
      "section_id": "section-00051",
      "start_time": 486.44,
      "end_time": 494.325,
      "transcript": "ਕਬਹੂ, ਸੋਗ ਹਰਖ ਰੰਗਿ ਹਸੈ"
    },
    {
      "section_id": "section-00052",
      "start_time": 494.325,
      "end_time": 502.115,
      "transcript": "ਕਬਹੂ, ਨਿੰਦ ਚਿੰਦ ਬਿਉਹਾਰ"
    },
    {
      "section_id": "section-00053",
      "start_time": 502.6,
      "end_time": 510.295,
      "transcript": "ਕਬਹੂ, ਊਭ ਅਕਾਸ ਪਇਆਲ"
    },
    {
      "section_id": "section-00054",
      "start_time": 510.76,
      "end_time": 518.265,
      "transcript": "ਕਬਹੂ, ਬੇਤਾ ਬ੍ਰਹਮ ਬੀਚਾਰ"
    },
    {
      "section_id": "section-00055",
      "start_time": 518.785,
      "end_time": 526.595,
      "transcript": "ਨਾਨਕ, ਆਪਿ ਮਿਲਾਵਣਹਾਰ"
    },
    {
      "section_id": "section-00056",
      "start_time": 534.84,
      "end_time": 542.485,
      "transcript": "ਕਬਹੂ, ਨਿਰਤਿ ਕਰੈ ਬਹੁ ਭਾਤਿ"
    },
    {
      "section_id": "section-00057",
      "start_time": 542.96,
      "end_time": 550.215,
      "transcript": "ਕਬਹੂ, ਸੋਇ ਰਹੈ ਦਿਨੁ ਰਾਤਿ"
    },
    {
      "section_id": "section-00058",
      "start_time": 550.315,
      "end_time": 558.565,
      "transcript": "ਕਬਹੂ, ਮਹਾ ਕ੍ਰੋਧ ਬਿਕਰਾਲ"
    },
    {
      "section_id": "section-00059",
      "start_time": 559.0,
      "end_time": 566.965,
      "transcript": "ਕਬਹੂੰ, ਸਰਬ ਕੀ ਹੋਤ ਰਵਾਲ"
    },
    {
      "section_id": "section-00060",
      "start_time": 566.965,
      "end_time": 574.505,
      "transcript": "ਕਬਹੂ, ਹੋਇ ਬਹੈ ਬਡ ਰਾਜਾ"
    },
    {
      "section_id": "section-00061",
      "start_time": 575.0,
      "end_time": 582.655,
      "transcript": "ਕਬਹੁ, ਭੇਖਾਰੀ ਨੀਚ ਕਾ ਸਾਜਾ"
    },
    {
      "section_id": "section-00062",
      "start_time": 583.08,
      "end_time": 591.08,
      "transcript": "ਕਬਹੂ, ਅਪਕੀਰਤਿ ਮਹਿ ਆਵੈ"
    },
    {
      "section_id": "section-00063",
      "start_time": 591.08,
      "end_time": 599.08,
      "transcript": "ਕਬਹੂ, ਭਲਾ ਭਲਾ ਕਹਾਵੈ"
    },
    {
      "section_id": "section-00064",
      "start_time": 599.08,
      "end_time": 606.865,
      "transcript": "ਜਿਉ ਪ੍ਰਭੁ ਰਾਖੈ, ਤਿਵ ਹੀ ਰਹੈ"
    },
    {
      "section_id": "section-00065",
      "start_time": 606.865,
      "end_time": 614.965,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਨਾਨਕ ਸਚੁ ਕਹੈ"
    },
    {
      "section_id": "section-00066",
      "start_time": 627.16,
      "end_time": 635.14,
      "transcript": "ਕਬਹੂ, ਹੋਇ ਪੰਡਿਤੁ ਕਰੇ ਬਖੵਾਨੁ"
    },
    {
      "section_id": "section-00067",
      "start_time": 635.14,
      "end_time": 643.22,
      "transcript": "ਕਬਹੂ, ਮੋਨਿਧਾਰੀ ਲਾਵੈ ਧਿਆਨੁ"
    },
    {
      "section_id": "section-00068",
      "start_time": 643.22,
      "end_time": 650.825,
      "transcript": "ਕਬਹੂ, ਤਟ ਤੀਰਥ ਇਸਨਾਨ"
    },
    {
      "section_id": "section-00069",
      "start_time": 651.32,
      "end_time": 659.015,
      "transcript": "ਕਬਹੂ, ਸਿਧ ਸਾਧਿਕ ਮੁਖਿ ਗਿਆਨ"
    },
    {
      "section_id": "section-00070",
      "start_time": 667.48,
      "end_time": 675.085,
      "transcript": "ਕਬਹੂ, ਕੀਟ ਹਸਤਿ ਪਤੰਗ ਹੋਇ ਜੀਆ"
    },
    {
      "section_id": "section-00071",
      "start_time": 675.6,
      "end_time": 683.245,
      "transcript": "ਅਨਿਕ ਜੋਨਿ, ਭਰਮੈ ਭਰਮੀਆ"
    },
    {
      "section_id": "section-00072",
      "start_time": 683.685,
      "end_time": 691.68,
      "transcript": "ਨਾਨਾ ਰੂਪ, ਜਿਉ ਸ੍ਵਾਗੀ ਦਿਖਾਵੈ"
    },
    {
      "section_id": "section-00073",
      "start_time": 691.68,
      "end_time": 699.535,
      "transcript": "ਜਿਉ ਪ੍ਰਭ ਭਾਵੈ, ਤਿਵੈ ਨਚਾਵੈ"
    },
    {
      "section_id": "section-00074",
      "start_time": 699.535,
      "end_time": 707.235,
      "transcript": "ਜੋ ਤਿਸੁ ਭਾਵੈ, ਸੋਈ ਹੋਇ"
    },
    {
      "section_id": "section-00075",
      "start_time": 707.745,
      "end_time": 715.785,
      "transcript": "ਨਾਨਕ, ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00076",
      "start_time": 727.64,
      "end_time": 735.71,
      "transcript": "ਕਬਹੂ, ਸਾਧਸੰਗਤਿ ਇਹੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00077",
      "start_time": 735.71,
      "end_time": 742.6,
      "transcript": "ਉਸੁ ਅਸਥਾਨ ਤੇ, ਬਹੁਰਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00078",
      "start_time": 743.8,
      "end_time": 751.275,
      "transcript": "ਅੰਤਰਿ ਹੋਇ, ਗਿਆਨ ਪਰਗਾਸੁ"
    },
    {
      "section_id": "section-00079",
      "start_time": 751.76,
      "end_time": 759.575,
      "transcript": "ਉਸੁ ਅਸਥਾਨ ਕਾ, ਨਹੀ ਬਿਨਾਸੁ"
    },
    {
      "section_id": "section-00080",
      "start_time": 767.68,
      "end_time": 775.745,
      "transcript": "ਮਨ ਤਨ ਨਾਮਿ ਰਤੇ, ਇਕ ਰੰਗਿ"
    },
    {
      "section_id": "section-00081",
      "start_time": 775.745,
      "end_time": 783.245,
      "transcript": "ਸਦਾ ਬਸਹਿ, ਪਾਰਬ੍ਰਹਮ ਕੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00082",
      "start_time": 783.695,
      "end_time": 791.74,
      "transcript": "ਜਿਉ ਜਲ ਮਹਿ ਜਲੁ, ਆਇ ਖਟਾਨਾ"
    },
    {
      "section_id": "section-00083",
      "start_time": 791.74,
      "end_time": 799.65,
      "transcript": "ਤਿਉ ਜੋਤੀ ਸੰਗਿ ਜੋਤਿ ਸਮਾਨਾ"
    },
    {
      "section_id": "section-00084",
      "start_time": 799.65,
      "end_time": 807.495,
      "transcript": "ਮਿਟਿ ਗਏ ਗਵਨ, ਪਾਏ ਬਿਸ੍ਰਾਮ"
    },
    {
      "section_id": "section-00085",
      "start_time": 807.495,
      "end_time": 814.797,
      "transcript": "ਨਾਨਕ ਪ੍ਰਭ ਕੈ, ਸਦ ਕੁਰਬਾਨ"
    },
    {
      "section_id": "section-00086",
      "start_time": 831.76,
      "end_time": 839.255,

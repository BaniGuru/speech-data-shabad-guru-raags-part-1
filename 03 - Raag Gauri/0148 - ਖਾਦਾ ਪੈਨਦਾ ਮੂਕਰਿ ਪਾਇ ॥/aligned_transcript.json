{
  "audio_file": "0147 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.185,
      "end_time": 7.336,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.86,
      "end_time": 19.28,
      "transcript": "ਖਾਦਾ ਪੈਨਦਾ, ਮੂਕਰਿ ਪਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.28,
      "end_time": 25.72,
      "transcript": "ਤਿਸ ਨੋ ਜੋਹਹਿ, ਦੂਤ ਧਰਮ ਰਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.72,
      "end_time": 32.144,
      "transcript": "ਤਿਸੁ ਸਿਉ ਬੇਮੁਖੁ, ਜਿਨਿ ਜੀਉ ਪਿੰਡੁ ਦੀਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.144,
      "end_time": 41.905,
      "transcript": "ਕੋਟਿ ਜਨਮ, ਭਰਮਹਿ ਬਹੁ ਜੂਨਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.095,
      "end_time": 54.44,
      "transcript": "ਸਾਕਤ ਕੀ, ਐਸੀ ਹੈ ਰੀਤਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.44,
      "end_time": 60.585,
      "transcript": "ਜੋ ਕਿਛੁ ਕਰੈ, ਸਗਲ ਬਿਪਰੀਤਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.805,
      "end_time": 67.095,
      "transcript": "ਜੀਉ ਪ੍ਰਾਣ, ਜਿਨਿ ਮਨੁ ਤਨੁ ਧਾਰਿਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.095,
      "end_time": 73.55,
      "transcript": "ਸੋਈ ਠਾਕੁਰੁ, ਮਨਹੁ ਬਿਸਾਰਿਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 73.55,
      "end_time": 79.88,
      "transcript": "ਬਧੇ ਬਿਕਾਰ, ਲਿਖੇ ਬਹੁ ਕਾਗਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.88,
      "end_time": 86.465,
      "transcript": "ਨਾਨਕ ਉਧਰੁ, ਕ੍ਰਿਪਾ ਸੁਖ ਸਾਗਰ"
    },
    {
      "section_id": "section-00012",
      "start_time": 86.465,
      "end_time": 92.775,
      "transcript": "ਪਾਰਬ੍ਰਹਮ, ਤੇਰੀ ਸਰਣਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 92.775,
      "end_time": 102.115,
      "transcript": "ਬੰਧਨ ਕਾਟਿ, ਤਰੈ ਹਰਿ ਨਾਇ ਰਹਾਉ ਦੂਜਾ"
    }
  ]
}

  "audio_file": "0195 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.735,
      "end_time": 10.555,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.08,
      "end_time": 16.62,
      "transcript": "ਲਾਲਚ ਝੂਠ ਬਿਖੈ ਬਿਆਧਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.62,
      "end_time": 22.335,
      "transcript": "ਇਆ ਦੇਹੀ ਮਹਿ ਬਾਸ"
    },
    {
      "section_id": "section-00004",
      "start_time": 22.84,
      "end_time": 28.755,
      "transcript": "ਹਰਿ ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਗੁਰਮੁਖਿ ਪੀਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.755,
      "end_time": 34.365,
      "transcript": "ਨਾਨਕ ਸੂਖਿ ਨਿਵਾਸ"
    },
    {
      "section_id": "section-00006",
      "start_time": 34.76,
      "end_time": 36.315,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 45.743,
      "end_time": 53.64,
      "transcript": "ਲਲਾ, ਲਾਵਉ ਅਉਖਧ ਜਾਹੂ ਦੂਖ ਦਰਦ, ਤਿਹ ਮਿਟਹਿ ਖਿਨਾਹੂ"
    },
    {
      "section_id": "section-00008",
      "start_time": 53.64,
      "end_time": 61.3,
      "transcript": "ਨਾਮ ਅਉਖਧੁ, ਜਿਹ ਰਿਦੈ ਹਿਤਾਵੈ ਤਾਹਿ, ਰੋਗੁ ਸੁਪਨੈ ਨਹੀ ਆਵੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 61.3,
      "end_time": 68.915,
      "transcript": "ਹਰਿ ਅਉਖਧੁ, ਸਭ ਘਟ ਹੈ ਭਾਈ ਗੁਰ ਪੂਰੇ ਬਿਨੁ, ਬਿਧਿ ਨ ਬਨਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.915,
      "end_time": 77.015,
      "transcript": "ਗੁਰਿ ਪੂਰੈ, ਸੰਜਮੁ ਕਰਿ ਦੀਆ ਨਾਨਕ ਤਉ ਫਿਰਿ, ਦੂਖ ਨ ਥੀਆ"
    }
  ]
}

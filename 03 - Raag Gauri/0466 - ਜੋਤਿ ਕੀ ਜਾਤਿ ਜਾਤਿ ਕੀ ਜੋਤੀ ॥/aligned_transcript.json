{
  "audio_file": "0239 F Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 6.925,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.96,
      "end_time": 20.96,
      "transcript": "ਜੋਤਿ ਕੀ ਜਾਤਿ, ਜਾਤਿ ਕੀ ਜੋਤੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.96,
      "end_time": 27.85,
      "transcript": "ਤਿਤੁ ਲਾਗੇ, ਕੰਚੂਆ ਫਲ ਮੋਤੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.85,
      "end_time": 34.8,
      "transcript": "ਕਵਨੁ ਸੁ ਘਰੁ, ਜੋ ਨਿਰਭਉ ਕਹੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.8,
      "end_time": 41.777,
      "transcript": "ਭਉ ਭਜਿ ਜਾਇ, ਅਭੈ ਹੋਇ ਰਹੀਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.64,
      "end_time": 55.6,
      "transcript": "ਤਟਿ ਤੀਰਥਿ, ਨਹੀ ਮਨੁ ਪਤੀਆਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.6,
      "end_time": 62.505,
      "transcript": "ਚਾਰ ਅਚਾਰ, ਰਹੇ ਉਰਝਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.505,
      "end_time": 69.4,
      "transcript": "ਪਾਪ ਪੁੰਨ ਦੁਇ, ਏਕ ਸਮਾਨ"
    },
    {
      "section_id": "section-00009",
      "start_time": 69.4,
      "end_time": 76.06,
      "transcript": "ਨਿਜ ਘਰਿ ਪਾਰਸੁ, ਤਜਹੁ ਗੁਨ ਆਨ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.06,
      "end_time": 83.36,
      "transcript": "ਕਬੀਰ ਨਿਰਗੁਣ, ਨਾਮ ਨ ਰੋਸੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.36,
      "end_time": 89.565,
      "transcript": "ਇਸੁ ਪਰਚਾਇ, ਪਰਚਿ ਰਹੁ ਏਸੁ"
    }
  ]
}

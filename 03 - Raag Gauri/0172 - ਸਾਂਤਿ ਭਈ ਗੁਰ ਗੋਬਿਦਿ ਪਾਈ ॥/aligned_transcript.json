{
  "audio_file": "0151 C PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.105,
      "end_time": 7.273,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.417,
      "end_time": 18.525,
      "transcript": "ਸਾਂਤਿ ਭਈ, ਗੁਰ ਗੋਬਿਦਿ ਪਾਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.525,
      "end_time": 27.945,
      "transcript": "ਤਾਪ ਪਾਪ ਬਿਨਸੇ, ਮੇਰੇ ਭਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.906,
      "end_time": 40.32,
      "transcript": "ਰਾਮ ਨਾਮੁ, ਨਿਤ ਰਸਨ ਬਖਾਨ"
    },
    {
      "section_id": "section-00005",
      "start_time": 40.32,
      "end_time": 46.364,
      "transcript": "ਬਿਨਸੇ ਰੋਗ, ਭਏ ਕਲਿਆਨ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.364,
      "end_time": 52.575,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਗੁਣ ਅਗਮ ਬੀਚਾਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.8,
      "end_time": 58.835,
      "transcript": "ਸਾਧੂ ਸੰਗਮਿ, ਹੈ ਨਿਸਤਾਰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.905,
      "end_time": 71.075,
      "transcript": "ਨਿਰਮਲ ਗੁਣ, ਗਾਵਹੁ ਨਿਤ ਨੀਤ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.075,
      "end_time": 77.32,
      "transcript": "ਗਈ ਬਿਆਧਿ, ਉਬਰੇ ਜਨ ਮੀਤ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.32,
      "end_time": 83.485,
      "transcript": "ਮਨ ਬਚ ਕ੍ਰਮ, ਪ੍ਰਭੁ ਅਪਨਾ ਧਿਆਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.485,
      "end_time": 89.335,
      "transcript": "ਨਾਨਕ ਦਾਸ, ਤੇਰੀ ਸਰਣਾਈ"
    }
  ]
}

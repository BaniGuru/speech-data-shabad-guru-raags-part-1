{
  "audio_file": "0235 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.075,
      "end_time": 18.865,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 26.6,
      "end_time": 39.405,
      "transcript": "ਅੰਤਰਿ ਚਿੰਤਾ ਨੈਣੀ ਸੁਖੀ, ਮੂਲਿ ਨ ਉਤਰੈ ਭੁਖ"
    },
    {
      "section_id": "section-00003",
      "start_time": 39.595,
      "end_time": 51.775,
      "transcript": "ਨਾਨਕ ਸਚੇ ਨਾਮ ਬਿਨੁ, ਕਿਸੈ ਨ ਲਥੋ ਦੁਖੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 52.155,
      "end_time": 58.825,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 65.086,
      "end_time": 71.56,
      "transcript": "ਮੁਠੜੇ ਸੇਈ ਸਾਥ"
    },
    {
      "section_id": "section-00006",
      "start_time": 71.56,
      "end_time": 77.79,
      "transcript": "ਜਿਨੀ ਸਚੁ ਨ ਲਦਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 77.79,
      "end_time": 84.24,
      "transcript": "ਨਾਨਕ ਸੇ ਸਾਬਾਸਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.24,
      "end_time": 94.285,
      "transcript": "ਜਿਨੀ ਗੁਰ ਮਿਲਿ ਇਕੁ ਪਛਾਣਿਆ ਪਉੜੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 103.2,
      "end_time": 111.4,
      "transcript": "ਜਿਥੈ ਬੈਸਨਿ ਸਾਧ ਜਨ, ਸੋ ਥਾਨੁ ਸੁਹੰਦਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 111.4,
      "end_time": 119.84,
      "transcript": "ਓਇ ਸੇਵਨਿ ਸੰਮ੍ਰਿਥੁ ਆਪਣਾ, ਬਿਨਸੈ ਸਭੁ ਮੰਦਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 119.84,
      "end_time": 128.44,
      "transcript": "ਪਤਿਤ ਉਧਾਰਣ ਪਾਰਬ੍ਰਹਮ, ਸੰਤ ਬੇਦੁ ਕਹੰਦਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 128.44,
      "end_time": 137.12,
      "transcript": "ਭਗਤਿ ਵਛਲੁ ਤੇਰਾ ਬਿਰਦੁ ਹੈ, ਜੁਗਿ ਜੁਗਿ ਵਰਤੰਦਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 137.12,
      "end_time": 146.619,
      "transcript": "ਨਾਨਕੁ ਜਾਚੈ ਏਕੁ ਨਾਮੁ, ਮਨਿ ਤਨਿ ਭਾਵੰਦਾ"
    }
  ]
}

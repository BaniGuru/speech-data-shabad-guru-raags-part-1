  "audio_file": "0193 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.255,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.995,
      "end_time": 20.887,
      "transcript": "ਡੰਡਉਤਿ ਬੰਦਨ ਅਨਿਕ ਬਾਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.887,
      "end_time": 26.935,
      "transcript": "ਸਰਬ ਕਲਾ ਸਮਰਥ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.305,
      "end_time": 33.672,
      "transcript": "ਡੋਲਨ ਤੇ ਰਾਖਹੁ ਪ੍ਰਭੂ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.672,
      "end_time": 43.195,
      "transcript": "ਨਾਨਕ ਦੇ ਕਰਿ ਹਥ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.315,
      "end_time": 62.11,
      "transcript": "ਡਡਾ ਡੇਰਾ ਇਹੁ ਨਹੀ, ਜਹ ਡੇਰਾ ਤਹ ਜਾਨੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.11,
      "end_time": 70.345,
      "transcript": "ਉਆ ਡੇਰਾ ਕਾ ਸੰਜਮੋ, ਗੁਰ ਕੈ ਸਬਦਿ ਪਛਾਨੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.68,
      "end_time": 74.774,
      "transcript": "ਇਆ ਡੇਰਾ ਕਉ, ਸ੍ਰਮੁ ਕਰਿ ਘਾਲੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 74.774,
      "end_time": 79.32,
      "transcript": "ਜਾ ਕਾ ਤਸੂ, ਨਹੀ ਸੰਗਿ ਚਾਲੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.32,
      "end_time": 83.365,
      "transcript": "ਉਆ ਡੇਰਾ ਕੀ, ਸੋ ਮਿਤਿ ਜਾਨੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.365,
      "end_time": 87.72,
      "transcript": "ਜਾ ਕਉ ਦ੍ਰਿਸਟਿ, ਪੂਰਨ ਭਗਵਾਨੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.72,
      "end_time": 92.0,
      "transcript": "ਡੇਰਾ ਨਿਹਚਲੁ ਸਚੁ, ਸਾਧਸੰਗ ਪਾਇਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 92.0,
      "end_time": 97.483,
      "transcript": "ਨਾਨਕ ਤੇ ਜਨ, ਨਹ ਡੋਲਾਇਆ"
    }
  ]
}

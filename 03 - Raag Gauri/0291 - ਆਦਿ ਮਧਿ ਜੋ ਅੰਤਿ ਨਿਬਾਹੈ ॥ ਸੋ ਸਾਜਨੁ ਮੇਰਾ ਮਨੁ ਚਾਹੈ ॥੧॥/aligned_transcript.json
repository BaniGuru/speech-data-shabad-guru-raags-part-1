  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 7.631,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.32,
      "end_time": 20.895,
      "transcript": "ਆਦਿ ਮਧਿ, ਜੋ ਅੰਤਿ ਨਿਬਾਹੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.895,
      "end_time": 28.2,
      "transcript": "ਸੋ ਸਾਜਨੁ, ਮੇਰਾ ਮਨੁ ਚਾਹੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.2,
      "end_time": 35.015,
      "transcript": "ਹਰਿ ਕੀ ਪ੍ਰੀਤਿ, ਸਦਾ ਸੰਗਿ ਚਾਲੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.015,
      "end_time": 42.125,
      "transcript": "ਦਇਆਲ ਪੁਰਖ ਪੂਰਨ ਪ੍ਰਤਿਪਾਲੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.68,
      "end_time": 59.535,
      "transcript": "ਬਿਨਸਤ ਨਾਹੀ, ਛੋਡਿ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.535,
      "end_time": 66.72,
      "transcript": "ਜਹ ਪੇਖਾ, ਤਹ ਰਹਿਆ ਸਮਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 66.72,
      "end_time": 73.255,
      "transcript": "ਸੁੰਦਰੁ ਸੁਘੜੁ, ਚਤੁਰੁ ਜੀਅ ਦਾਤਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 73.68,
      "end_time": 80.569,
      "transcript": "ਭਾਈ ਪੂਤੁ ਪਿਤਾ ਪ੍ਰਭੁ ਮਾਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 80.569,
      "end_time": 87.56,
      "transcript": "ਜੀਵਨ ਪ੍ਰਾਨ ਅਧਾਰ, ਮੇਰੀ ਰਾਸਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.56,
      "end_time": 94.445,
      "transcript": "ਪ੍ਰੀਤਿ ਲਾਈ, ਕਰਿ ਰਿਦੈ ਨਿਵਾਸਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 94.445,
      "end_time": 101.61,
      "transcript": "ਮਾਇਆ ਸਿਲਕ ਕਾਟੀ, ਗੋਪਾਲਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 101.61,
      "end_time": 108.758,
      "transcript": "ਕਰਿ ਅਪੁਨਾ ਲੀਨੋ, ਨਦਰਿ ਨਿਹਾਲਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 115.68,
      "end_time": 122.275,
      "transcript": "ਸਿਮਰਿ ਸਿਮਰਿ, ਕਾਟੇ ਸਭਿ ਰੋਗ"
    },
    {
      "section_id": "section-00015",
      "start_time": 122.64,
      "end_time": 129.325,
      "transcript": "ਚਰਣ ਧਿਆਨ, ਸਰਬ ਸੁਖ ਭੋਗ"
    },
    {
      "section_id": "section-00016",
      "start_time": 129.325,
      "end_time": 136.63,
      "transcript": "ਪੂਰਨ ਪੁਰਖੁ, ਨਵਤਨੁ ਨਿਤ ਬਾਲਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 136.63,
      "end_time": 143.66,
      "transcript": "ਹਰਿ ਅੰਤਰਿ ਬਾਹਰਿ, ਸੰਗਿ ਰਖਵਾਲਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 143.66,
      "end_time": 150.57,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਹਰਿ ਹਰਿ ਪਦੁ ਚੀਨ"
    },
    {
      "section_id": "section-00019",
      "start_time": 150.57,
      "end_time": 157.386,
      "transcript": "ਸਰਬਸੁ ਨਾਮੁ, ਭਗਤ ਕਉ ਦੀਨ"
    },
    {
      "section_id": "section-00020",
      "start_time": 157.386,

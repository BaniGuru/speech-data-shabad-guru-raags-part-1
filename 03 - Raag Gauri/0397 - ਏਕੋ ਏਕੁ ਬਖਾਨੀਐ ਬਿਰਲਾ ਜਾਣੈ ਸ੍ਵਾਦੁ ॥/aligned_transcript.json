  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.226,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.36,
      "end_time": 19.525,
      "transcript": "ਏਕੋ ਏਕੁ ਬਖਾਨੀਐ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.865,
      "end_time": 25.815,
      "transcript": "ਬਿਰਲਾ ਜਾਣੈ ਸ੍ਵਾਦੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.365,
      "end_time": 32.435,
      "transcript": "ਗੁਣ ਗੋਬਿੰਦ ਨ ਜਾਣੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.855,
      "end_time": 42.825,
      "transcript": "ਨਾਨਕ ਸਭੁ ਬਿਸਮਾਦੁ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.64,
      "end_time": 56.84,
      "transcript": "ਏਕਾਦਸੀ, ਨਿਕਟਿ ਪੇਖਹੁ ਹਰਿ ਰਾਮੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.84,
      "end_time": 60.915,
      "transcript": "ਇੰਦ੍ਰੀ ਬਸਿ ਕਰਿ, ਸੁਣਹੁ ਹਰਿ ਨਾਮੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.915,
      "end_time": 65.235,
      "transcript": "ਮਨਿ ਸੰਤੋਖੁ, ਸਰਬ ਜੀਅ ਦਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.235,
      "end_time": 69.38,
      "transcript": "ਇਨ ਬਿਧਿ, ਬਰਤੁ ਸੰਪੂਰਨ ਭਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 69.38,
      "end_time": 73.434,
      "transcript": "ਧਾਵਤ ਮਨੁ ਰਾਖੈ, ਇਕ ਠਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 73.434,
      "end_time": 77.597,
      "transcript": "ਮਨੁ ਤਨੁ ਸੁਧੁ ਜਪਤ ਹਰਿ ਨਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 77.597,
      "end_time": 85.702,
      "transcript": "ਸਭ ਮਹਿ, ਪੂਰਿ ਰਹੇ ਪਾਰਬ੍ਰਹਮ ਨਾਨਕ ਹਰਿ ਕੀਰਤਨੁ ਕਰਿ, ਅਟਲ ਏਹੁ ਧਰਮ ਨਾਨਕ"
    },
    {
      "section_id": "section-00013",
      "start_time": 85.702,
      "end_time": 90.631,
      "transcript": "ਹਰਿ ਕੀਰਤਨੁ ਕਰਿ, ਅਟਲ ਏਹੁ "
    }
  ]
}

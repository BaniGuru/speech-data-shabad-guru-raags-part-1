{
  "audio_file": "0148 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.195,
      "end_time": 8.005,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.395,
      "end_time": 23.765,
      "transcript": "ਆਠ ਪਹਰ, ਸੰਗੀ ਬਟਵਾਰੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 24.4,
      "end_time": 31.775,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਪ੍ਰਭਿ ਲਏ ਨਿਵਾਰੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.36,
      "end_time": 39.815,
      "transcript": "ਐਸਾ ਹਰਿ ਰਸੁ, ਰਮਹੁ ਸਭੁ ਕੋਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 40.24,
      "end_time": 48.165,
      "transcript": "ਸਰਬ ਕਲਾ, ਪੂਰਨ ਪ੍ਰਭੁ ਸੋਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.025,
      "end_time": 75.815,
      "transcript": "ਮਹਾ ਤਪਤਿ, ਸਾਗਰ ਸੰਸਾਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.04,
      "end_time": 83.635,
      "transcript": "ਪ੍ਰਭ ਖਿਨ ਮਹਿ, ਪਾਰਿ ਉਤਾਰਣਹਾਰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.12,
      "end_time": 91.585,
      "transcript": "ਅਨਿਕ ਬੰਧਨ, ਤੋਰੇ ਨਹੀ ਜਾਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 92.08,
      "end_time": 99.585,
      "transcript": "ਸਿਮਰਤ ਨਾਮ, ਮੁਕਤਿ ਫਲ ਪਾਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 100.08,
      "end_time": 107.966,
      "transcript": "ਉਕਤਿ ਸਿਆਨਪ, ਇਸ ਤੇ ਕਛੁ ਨਾਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 107.966,
      "end_time": 115.215,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਨਾਨਕ ਗੁਣ ਗਾਹਿ"
    }
  ]
}

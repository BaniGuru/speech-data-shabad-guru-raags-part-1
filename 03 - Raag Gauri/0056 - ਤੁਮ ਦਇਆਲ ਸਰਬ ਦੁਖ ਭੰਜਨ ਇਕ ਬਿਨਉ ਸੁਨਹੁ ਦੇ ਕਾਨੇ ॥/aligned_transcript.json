{
  "audio_file": "0128 APb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.9,
      "end_time": 18.23,
      "transcript": "ਗਉੜੀ ਪੂਰਬੀ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 35.2,
      "end_time": 41.914,
      "transcript": "ਤੁਮ ਦਇਆਲ ਸਰਬ ਦੁਖ ਭੰਜਨ"
    },
    {
      "section_id": "section-00003",
      "start_time": 41.914,
      "end_time": 48.313,
      "transcript": "ਇਕ ਬਿਨਉ ਸੁਨਹੁ ਦੇ ਕਾਨੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 48.313,
      "end_time": 54.8,
      "transcript": "ਜਿਸ ਤੇ ਤੁਮ ਹਰਿ ਜਾਨੇ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 54.8,
      "end_time": 61.362,
      "transcript": "ਸੋ ਸਤਿਗੁਰੁ ਮੇਲਿ ਮੇਰਾ ਪ੍ਰਾਨੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.16,
      "end_time": 68.384,
      "transcript": "ਰਾਮ ਹਮ ਸਤਿਗੁਰ ਪਾਰਬ੍ਰਹਮ ਕਰਿ ਮਾਨੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 68.76,
      "end_time": 75.01,
      "transcript": "ਹਮ ਮੂੜ ਮੁਗਧ ਅਸੁਧ ਮਤਿ ਹੋਤੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.32,
      "end_time": 84.302,
      "transcript": "ਗੁਰ ਸਤਿਗੁਰ ਕੈ ਬਚਨਿ ਹਰਿ ਹਮ ਜਾਨੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 91.289,
      "end_time": 97.888,
      "transcript": "ਜਿਤਨੇ ਰਸ ਅਨ ਰਸ ਹਮ ਦੇਖੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 97.888,
      "end_time": 104.52,
      "transcript": "ਸਭ ਤਿਤਨੇ ਫੀਕ ਫੀਕਾਨੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.52,
      "end_time": 111.0,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ ਅੰਮ੍ਰਿਤ ਰਸੁ ਚਾਖਿਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 111.0,
      "end_time": 117.154,
      "transcript": "ਮਿਲਿ ਸਤਿਗੁਰ ਮੀਠ ਰਸ ਗਾਨੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 117.154,
      "end_time": 123.88,
      "transcript": "ਜਿਨ ਕਉ ਗੁਰੁ ਸਤਿਗੁਰੁ ਨਹੀ ਭੇਟਿਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 123.88,
      "end_time": 130.28,
      "transcript": "ਤੇ ਸਾਕਤ ਮੂੜ ਦਿਵਾਨੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 130.28,
      "end_time": 136.737,
      "transcript": "ਤਿਨ ਕੇ ਕਰਮਹੀਨ ਧੁਰਿ ਪਾਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 136.737,
      "end_time": 143.004,
      "transcript": "ਦੇਖਿ ਦੀਪਕੁ ਮੋਹਿ ਪਚਾਨੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 143.004,
      "end_time": 149.6,
      "transcript": "ਜਿਨ ਕਉ ਤੁਮ ਦਇਆ ਕਰਿ ਮੇਲਹੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 149.6,
      "end_time": 155.703,
      "transcript": "ਤੇ ਹਰਿ ਹਰਿ ਸੇਵ ਲਗਾਨੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 155.703,
      "end_time": 161.88,
      "transcript": "ਜਨ ਨਾਨਕ ਹਰਿ ਹਰਿ ਹਰਿ ਜਪਿ ਪ੍ਰਗਟੇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 162.28,
      "end_time": 168.228,
      "transcript": "ਮਤਿ ਗੁਰਮਤਿ ਨਾਮਿ ਸਮਾਨੇ"
    }
  ]
}

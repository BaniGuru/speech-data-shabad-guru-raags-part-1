{
  "audio_file": "0192 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.44,
      "end_time": 8.765,
      "transcript": "ਙਣਿ ਘਾਲੇ ਸਭ ਦਿਵਸ ਸਾਸ"
    },
    {
      "section_id": "section-00002",
      "start_time": 8.765,
      "end_time": 15.835,
      "transcript": "ਨਹ ਬਢਨ ਘਟਨ ਤਿਲੁ ਸਾਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.385,
      "end_time": 23.557,
      "transcript": "ਜੀਵਨ ਲੋਰਹਿ ਭਰਮ ਮੋਹ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.557,
      "end_time": 33.225,
      "transcript": "ਨਾਨਕ ਤੇਊ ਗਵਾਰ ਪਉੜੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.256,
      "end_time": 44.2,
      "transcript": "ਙੰਙਾ ਙ੍ਰਾਸੈ ਕਾਲੁ ਤਿਹ, ਜੋ ਸਾਕਤ ਪ੍ਰਭਿ ਕੀਨ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.2,
      "end_time": 48.442,
      "transcript": "ਅਨਿਕ ਜੋਨਿ ਜਨਮਹਿ ਮਰਹਿ, ਆਤਮ ਰਾਮੁ ਨ ਚੀਨ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.442,
      "end_time": 57.788,
      "transcript": "ਙਿਆਨ ਧਿਆਨ, ਤਾਹੂ ਕਉ ਆਏ ਕਰਿ ਕਿਰਪਾ, ਜਿਹ ਆਪਿ ਦਿਵਾਏ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.788,
      "end_time": 62.52,
      "transcript": "ਙਣਤੀ ਙਣੀ, ਨਹੀ ਕੋਊ ਛੂਟੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 62.52,
      "end_time": 66.81,
      "transcript": "ਕਾਚੀ ਗਾਗਰਿ, ਸਰਪਰ ਫੂਟੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 66.81,
      "end_time": 71.24,
      "transcript": "ਸੋ ਜੀਵਤ, ਜਿਹ ਜੀਵਤ ਜਪਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 71.24,
      "end_time": 76.475,
      "transcript": "ਪ੍ਰਗਟ ਭਏ ਨਾਨਕ, ਨਹ ਛਪਿਆ"
    }
  ]
}

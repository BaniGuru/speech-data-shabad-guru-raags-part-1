{
  "audio_file": "0153 B PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.145,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.396,
      "end_time": 18.8,
      "transcript": "ਅਪਨੇ ਸੇਵਕ ਕਉ, ਆਪਿ ਸਹਾਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.8,
      "end_time": 25.035,
      "transcript": "ਨਿਤ ਪ੍ਰਤਿਪਾਰੈ, ਬਾਪ ਜੈਸੇ ਮਾਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.035,
      "end_time": 31.315,
      "transcript": "ਪ੍ਰਭ ਕੀ ਸਰਨਿ, ਉਬਰੈ ਸਭ ਕੋਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.315,
      "end_time": 40.505,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਪੂਰਨ ਸਚੁ ਸੋਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.68,
      "end_time": 52.88,
      "transcript": "ਅਬ ਮਨਿ ਬਸਿਆ, ਕਰਨੈਹਾਰਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.88,
      "end_time": 59.16,
      "transcript": "ਭੈ ਬਿਨਸੇ, ਆਤਮ ਸੁਖ ਸਾਰਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.16,
      "end_time": 65.34,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਅਪਨੇ ਜਨ ਰਾਖੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.34,
      "end_time": 71.65,
      "transcript": "ਜਨਮ ਜਨਮ ਕੇ, ਕਿਲਬਿਖ ਲਾਥੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.65,
      "end_time": 77.705,
      "transcript": "ਕਹਨੁ ਨ ਜਾਇ, ਪ੍ਰਭ ਕੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.705,
      "end_time": 84.115,
      "transcript": "ਨਾਨਕ ਦਾਸ, ਸਦਾ ਸਰਨਾਈ"
    }
  ]
}

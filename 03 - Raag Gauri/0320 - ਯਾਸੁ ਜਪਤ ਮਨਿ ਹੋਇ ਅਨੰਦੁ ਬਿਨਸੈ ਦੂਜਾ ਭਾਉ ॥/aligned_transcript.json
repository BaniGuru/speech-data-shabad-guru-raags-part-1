  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.965,
      "end_time": 9.025,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 19.465,
      "end_time": 27.562,
      "transcript": "ਯਾਸੁ ਜਪਤ ਮਨਿ ਹੋਇ ਅਨੰਦੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 27.562,
      "end_time": 35.594,
      "transcript": "ਬਿਨਸੈ ਦੂਜਾ ਭਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.594,
      "end_time": 43.165,
      "transcript": "ਦੂਖ ਦਰਦ ਤ੍ਰਿਸਨਾ ਬੁਝੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.165,
      "end_time": 52.596,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਸਮਾਉ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 57.76,
      "end_time": 62.225,
      "transcript": "ਯਯਾ, ਜਾਰਉ ਦੁਰਮਤਿ ਦੋਊ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.225,
      "end_time": 66.615,
      "transcript": "ਤਿਸਹਿ ਤਿਆਗਿ, ਸੁਖ ਸਹਜੇ ਸੋਊ"
    },
    {
      "section_id": "section-00008",
      "start_time": 66.615,
      "end_time": 70.93,
      "transcript": "ਯਯਾ, ਜਾਇ ਪਰਹੁ ਸੰਤ ਸਰਨਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.93,
      "end_time": 75.249,
      "transcript": "ਜਿਹ ਆਸਰ, ਇਆ ਭਵਜਲੁ ਤਰਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.249,
      "end_time": 79.431,
      "transcript": "ਯਯਾ, ਜਨਮਿ ਨ ਆਵੈ ਸੋਊ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.431,
      "end_time": 83.76,
      "transcript": "ਏਕ ਨਾਮ ਲੇ, ਮਨਹਿ ਪਰੋਊ"
    },
    {
      "section_id": "section-00012",
      "start_time": 83.76,
      "end_time": 92.186,
      "transcript": "ਯਯਾ ਜਨਮੁ ਨ ਹਾਰੀਐ, ਗੁਰ ਪੂਰੇ ਕੀ ਟੇਕ"
    },
    {
      "section_id": "section-00013",
      "start_time": 92.186,
      "end_time": 101.875,
      "transcript": "ਨਾਨਕ ਤਿਹ ਸੁਖੁ ਪਾਇਆ, ਜਾ ਕੈ ਹੀਅਰੈ ਏਕ"
    }
  ]
}

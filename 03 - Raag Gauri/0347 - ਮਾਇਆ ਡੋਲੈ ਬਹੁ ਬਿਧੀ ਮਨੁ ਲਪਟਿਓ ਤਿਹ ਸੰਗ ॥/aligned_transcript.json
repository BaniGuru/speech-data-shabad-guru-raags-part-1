    {
      "section_id": "section-00002",
      "start_time": 12.301,
      "end_time": 19.695,
      "transcript": "ਮਾਇਆ ਡੋਲੈ ਬਹੁ ਬਿਧੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.255,
      "end_time": 27.425,
      "transcript": "ਮਨੁ ਲਪਟਿਓ ਤਿਹ ਸੰਗ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.745,
      "end_time": 35.12,
      "transcript": "ਮਾਗਨ ਤੇ ਜਿਹ ਤੁਮ ਰਖਹੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.12,
      "end_time": 46.095,
      "transcript": "ਸੁ ਨਾਨਕ ਨਾਮਹਿ ਰੰਗ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.735,
      "end_time": 55.0,
      "transcript": "ਮਮਾ, ਮਾਗਨਹਾਰ ਇਆਨਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.0,
      "end_time": 59.44,
      "transcript": "ਦੇਨਹਾਰ, ਦੇ ਰਹਿਓ ਸੁਜਾਨਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.44,
      "end_time": 63.595,
      "transcript": "ਜੋ ਦੀਨੋ, ਸੋ ਏਕਹਿ ਬਾਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.595,
      "end_time": 67.756,
      "transcript": "ਮਨ ਮੂਰਖ, ਕਹ ਕਰਹਿ ਪੁਕਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 67.756,
      "end_time": 71.955,
      "transcript": "ਜਉ ਮਾਗਹਿ, ਤਉ ਮਾਗਹਿ ਬੀਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 71.955,
      "end_time": 76.24,
      "transcript": "ਜਾ ਤੇ ਕੁਸਲ, ਨ ਕਾਹੂ ਥੀਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 76.24,
      "end_time": 80.405,
      "transcript": "ਮਾਗਨਿ ਮਾਗ ਤ, ਏਕਹਿ ਮਾਗ"
    },
    {
      "section_id": "section-00013",
      "start_time": 80.405,
      "end_time": 84.64,
      "transcript": "ਨਾਨਕ ਜਾ ਤੇ, ਪਰਹਿ ਪਰਾਗ"
    },
    {
      "section_id": "section-00014",
      "start_time": 84.64,

{
  "audio_file": "0241 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.245,
      "end_time": 6.915,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.295,
      "end_time": 21.055,
      "transcript": "ਜਿਹ ਮਰਨੈ, ਸਭੁ ਜਗਤੁ ਤਰਾਸਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.055,
      "end_time": 28.44,
      "transcript": "ਸੋ ਮਰਨਾ, ਗੁਰ ਸਬਦਿ ਪ੍ਰਗਾਸਿਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.44,
      "end_time": 35.45,
      "transcript": "ਅਬ ਕੈਸੇ ਮਰਉ, ਮਰਨਿ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.45,
      "end_time": 46.4,
      "transcript": "ਮਰਿ ਮਰਿ ਜਾਤੇ, ਜਿਨ ਰਾਮੁ ਨ ਜਾਨਿਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.24,
      "end_time": 60.48,
      "transcript": "ਮਰਨੋ ਮਰਨੁ, ਕਹੈ ਸਭੁ ਕੋਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.48,
      "end_time": 67.6,
      "transcript": "ਸਹਜੇ ਮਰੈ, ਅਮਰੁ ਹੋਇ ਸੋਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.6,
      "end_time": 74.225,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਮਨਿ ਭਇਆ ਅਨੰਦਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 74.575,
      "end_time": 81.002,
      "transcript": "ਗਇਆ ਭਰਮੁ, ਰਹਿਆ ਪਰਮਾਨੰਦਾ"
    }
  ]
}

{
  "audio_file": "0231 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.505,
      "end_time": 9.482,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.482,
      "end_time": 23.436,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.44,
      "end_time": 44.605,
      "transcript": "ਸਾਕਤ ਜਾਇ ਨਿਵਹਿ ਗੁਰ ਆਗੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.105,
      "end_time": 53.315,
      "transcript": "ਮਨਿ ਖੋਟੇ ਕੂੜਿ ਕੂੜਿਆਰੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.775,
      "end_time": 62.005,
      "transcript": "ਜਾ ਗੁਰੁ ਕਹੈ ਉਠਹੁ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.305,
      "end_time": 70.065,
      "transcript": "ਬਹਿ ਜਾਹਿ ਘੁਸਰਿ ਬਗੁਲਾਰੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.815,
      "end_time": 78.775,
      "transcript": "ਗੁਰਸਿਖਾ ਅੰਦਰਿ ਸਤਿਗੁਰੁ ਵਰਤੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 79.4,
      "end_time": 86.785,
      "transcript": "ਚੁਣਿ ਕਢੇ ਲਧੋਵਾਰੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 87.8,
      "end_time": 96.12,
      "transcript": "ਓਇ ਅਗੈ ਪਿਛੈ ਬਹਿ ਮੁਹੁ ਛਪਾਇਨਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 96.12,
      "end_time": 104.635,
      "transcript": "ਨ ਰਲਨੀ ਖੋਟੇਆਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 104.84,
      "end_time": 112.765,
      "transcript": "ਓਨਾ ਦਾ ਭਖੁ ਸੁ ਓਥੈ ਨਾਹੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 113.235,
      "end_time": 121.085,
      "transcript": "ਜਾਇ ਕੂੜੁ ਲਹਨਿ ਭੇਡਾਰੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 121.765,
      "end_time": 129.855,
      "transcript": "ਜੇ ਸਾਕਤੁ ਨਰੁ ਖਾਵਾਈਐ ਲੋਚੀਐ"
    },
    {
      "section_id": "section-00014",
      "start_time": 130.245,
      "end_time": 138.185,
      "transcript": "ਬਿਖੁ ਕਢੈ ਮੁਖਿ ਉਗਲਾਰੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 138.68,
      "end_time": 147.08,
      "transcript": "ਹਰਿ ਸਾਕਤ ਸੇਤੀ ਸੰਗੁ ਨ ਕਰੀਅਹੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 147.08,
      "end_time": 154.625,
      "transcript": "ਓਇ ਮਾਰੇ ਸਿਰਜਣਹਾਰੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 155.52,
      "end_time": 163.755,
      "transcript": "ਜਿਸ ਕਾ ਇਹੁ ਖੇਲੁ ਸੋਈ ਕਰਿ ਵੇਖੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 163.755,
      "end_time": 171.725,
      "transcript": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਸਮਾਰੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 172.165,
      "end_time": 177.385,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 185.255,
      "end_time": 193.285,
      "transcript": "ਸਤਿਗੁਰੁ ਪੁਰਖੁ ਅਗੰਮੁ ਹੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 193.76,
      "end_time": 201.615,
      "transcript": "ਜਿਸੁ ਅੰਦਰਿ ਹਰਿ ਉਰਿ ਧਾਰਿਆ"
    },
    {
      "section_id": "section-00022",
      "start_time": 202.08,
      "end_time": 209.875,
      "transcript": "ਸਤਿਗੁਰੂ ਨੋ ਅਪੜਿ ਕੋਇ ਨ ਸਕਈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 210.275,
      "end_time": 218.025,
      "transcript": "ਜਿਸੁ ਵਲਿ ਸਿਰਜਣਹਾਰਿਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 218.52,
      "end_time": 226.155,
      "transcript": "ਸਤਿਗੁਰੂ ਕਾ ਖੜਗੁ ਸੰਜੋਉ ਹਰਿ ਭਗਤਿ ਹੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 226.72,
      "end_time": 234.195,
      "transcript": "ਜਿਤੁ ਕਾਲੁ ਕੰਟਕੁ ਮਾਰਿ ਵਿਡਾਰਿਆ"
    },
    {
      "section_id": "section-00026",
      "start_time": 234.88,
      "end_time": 243.04,
      "transcript": "ਸਤਿਗੁਰੂ ਕਾ ਰਖਣਹਾਰਾ ਹਰਿ ਆਪਿ ਹੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 243.04,
      "end_time": 250.685,
      "transcript": "ਸਤਿਗੁਰੂ ਕੈ ਪਿਛੈ ਹਰਿ ਸਭਿ ਉਬਾਰਿਆ"
    },
    {
      "section_id": "section-00028",
      "start_time": 251.24,
      "end_time": 259.52,
      "transcript": "ਜੋ ਮੰਦਾ ਚਿਤਵੈ ਪੂਰੇ ਸਤਿਗੁਰੂ ਕਾ"
    },
    {
      "section_id": "section-00029",
      "start_time": 259.52,
      "end_time": 267.055,
      "transcript": "ਸੋ ਆਪਿ ਉਪਾਵਣਹਾਰੈ ਮਾਰਿਆ"
    },
    {
      "section_id": "section-00030",
      "start_time": 267.72,
      "end_time": 275.525,
      "transcript": "ਏਹ ਗਲ ਹੋਵੈ ਹਰਿ ਦਰਗਹ ਸਚੇ ਕੀ"
    },
    {
      "section_id": "section-00031",
      "start_time": 275.885,
      "end_time": 286.445,
      "transcript": "ਜਨ ਨਾਨਕ ਅਗਮੁ ਵੀਚਾਰਿਆ ਪਉੜੀ"
    },
    {
      "section_id": "section-00032",
      "start_time": 291.84,
      "end_time": 300.785,
      "transcript": "ਸਚੁ ਸੁਤਿਆ ਜਿਨੀ ਅਰਾਧਿਆ, ਜਾ ਉਠੇ ਤਾ ਸਚੁ ਚਵੇ"
    },
    {
      "section_id": "section-00033",
      "start_time": 300.785,
      "end_time": 310.04,
      "transcript": "ਸੇ ਵਿਰਲੇ ਜੁਗ ਮਹਿ ਜਾਣੀਅਹਿ, ਜੋ ਗੁਰਮੁਖਿ ਸਚੁ ਰਵੇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 310.04,
      "end_time": 318.795,
      "transcript": "ਹਉ ਬਲਿਹਾਰੀ ਤਿਨ ਕਉ, ਜਿ ਅਨਦਿਨੁ ਸਚੁ ਲਵੇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 319.16,
      "end_time": 328.16,
      "transcript": "ਜਿਨ ਮਨਿ ਤਨਿ ਸਚਾ ਭਾਵਦਾ, ਸੇ ਸਚੀ ਦਰਗਹ ਗਵੇ"
    },
    {
      "section_id": "section-00036",
      "start_time": 328.16,
      "end_time": 338.765,
      "transcript": "ਜਨੁ ਨਾਨਕੁ ਬੋਲੈ ਸਚੁ ਨਾਮੁ, ਸਚੁ ਸਚਾ ਸਦਾ ਨਵੇ"
    }
  ]
}

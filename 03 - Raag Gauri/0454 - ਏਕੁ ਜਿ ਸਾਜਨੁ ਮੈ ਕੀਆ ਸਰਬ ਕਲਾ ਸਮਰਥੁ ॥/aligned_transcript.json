  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.145,
      "end_time": 9.915,
      "transcript": "ਸਲੋਕ ਦੋਹਾ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 20.2,
      "end_time": 28.005,
      "transcript": "ਏਕੁ ਜਿ ਸਾਜਨੁ ਮੈ ਕੀਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 28.56,
      "end_time": 36.275,
      "transcript": "ਸਰਬ ਕਲਾ ਸਮਰਥੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 36.695,
      "end_time": 44.485,
      "transcript": "ਜੀਉ ਹਮਾਰਾ ਖੰਨੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.88,
      "end_time": 52.365,
      "transcript": "ਹਰਿ ਮਨ ਤਨ ਸੰਦੜੀ ਵਥੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.365,
      "end_time": 56.795,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 64.56,
      "end_time": 71.935,
      "transcript": "ਜੇ ਕਰੁ ਗਹਹਿ ਪਿਆਰੜੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 72.4,
      "end_time": 79.645,
      "transcript": "ਤੁਧੁ ਨ ਛੋਡਾ ਮੂਲਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 80.12,
      "end_time": 87.435,
      "transcript": "ਹਰਿ ਛੋਡਨਿ ਸੇ ਦੁਰਜਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.84,
      "end_time": 95.205,
      "transcript": "ਪੜਹਿ ਦੋਜਕ ਕੈ ਸੂਲਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.68,
      "end_time": 98.175,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 103.24,
      "end_time": 111.635,
      "transcript": "ਸਭਿ ਨਿਧਾਨ ਘਰਿ ਜਿਸ ਦੈ, ਹਰਿ ਕਰੇ ਸੁ ਹੋਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.0,
      "end_time": 120.215,
      "transcript": "ਜਪਿ ਜਪਿ ਜੀਵਹਿ ਸੰਤ ਜਨ, ਪਾਪਾ ਮਲੁ ਧੋਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 120.68,
      "end_time": 128.775,
      "transcript": "ਚਰਨ ਕਮਲ ਹਿਰਦੈ ਵਸਹਿ, ਸੰਕਟ ਸਭਿ ਖੋਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 129.165,
      "end_time": 137.615,
      "transcript": "ਗੁਰੁ ਪੂਰਾ ਜਿਸੁ ਭੇਟੀਐ, ਮਰਿ ਜਨਮਿ ਨ ਰੋਵੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 137.615,
      "end_time": 145.675,
      "transcript": "ਪ੍ਰਭ ਦਰਸ ਪਿਆਸ ਨਾਨਕ ਘਣੀ, ਕਿਰਪਾ ਕਰਿ ਦੇਵੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 146.0,
      "end_time": 156.595,
      "transcript": "ਪ੍ਰਭ ਦਰਸ ਪਿਆਸ ਨਾਨਕ ਘਣੀ, ਕਿਰਪਾ ਕਰਿ ਦੇਵੈ"
    }
  ]

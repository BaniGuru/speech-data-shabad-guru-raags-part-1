      "start_time": 0.205,
      "end_time": 7.088,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.28,
      "end_time": 18.36,
      "transcript": "ਧਨੁ ਓਹੁ ਮਸਤਕੁ, ਧਨੁ ਤੇਰੇ ਨੇਤ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.36,
      "end_time": 24.255,
      "transcript": "ਧਨੁ ਓਇ ਭਗਤ, ਜਿਨ ਤੁਮ ਸੰਗਿ ਹੇਤ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.425,
      "end_time": 30.6,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਕੈਸੇ ਸੁਖੁ ਲਹੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.6,
      "end_time": 39.715,
      "transcript": "ਰਸਨਾ, ਰਾਮ ਨਾਮ ਜਸੁ ਕਹੀਐ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.735,
      "end_time": 51.755,
      "transcript": "ਤਿਨ ਊਪਰਿ, ਜਾਈਐ ਕੁਰਬਾਣੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.755,
      "end_time": 57.345,
      "transcript": "ਨਾਨਕ, ਜਿਨਿ ਜਪਿਆ ਨਿਰਬਾਣੁ"

{
  "audio_file": "0160 B PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.195,
      "end_time": 7.431,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.123,
      "end_time": 22.305,
      "transcript": "ਰਸਨਾ ਜਪੀਐ, ਏਕੁ ਨਾਮ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.955,
      "end_time": 30.105,
      "transcript": "ਈਹਾ ਸੁਖੁ ਆਨੰਦੁ ਘਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.76,
      "end_time": 38.504,
      "transcript": "ਆਗੈ ਜੀਅ ਕੈ ਸੰਗਿ ਕਾਮ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.455,
      "end_time": 53.44,
      "transcript": "ਕਟੀਐ ਤੇਰਾ, ਅਹੰ ਰੋਗੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.44,
      "end_time": 61.16,
      "transcript": "ਤੂੰ ਗੁਰ ਪ੍ਰਸਾਦਿ, ਕਰਿ ਰਾਜ ਜੋਗੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.16,
      "end_time": 68.155,
      "transcript": "ਹਰਿ ਰਸੁ, ਜਿਨਿ ਜਨਿ ਚਾਖਿਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.84,
      "end_time": 76.155,
      "transcript": "ਤਾ ਕੀ, ਤ੍ਰਿਸਨਾ ਲਾਥੀਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.585,
      "end_time": 83.685,
      "transcript": "ਹਰਿ ਬਿਸ੍ਰਾਮ, ਨਿਧਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.2,
      "end_time": 91.115,
      "transcript": "ਸੋ ਬਹੁਰਿ, ਨ ਕਤ ਹੀ ਧਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.615,
      "end_time": 98.615,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਜਾ ਕਉ ਗੁਰਿ ਦੀਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.085,
      "end_time": 106.002,
      "transcript": "ਨਾਨਕ ਤਾ ਕਾ, ਭਉ ਗਇਆ"
    }
  ]
}

    {
      "section_id": "section-00006",
      "start_time": 34.96,
      "end_time": 36.525,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 46.12,
      "end_time": 53.645,
      "transcript": "ਸਸਾ, ਸਰਨਿ ਪਰੇ ਅਬ ਹਾਰੇ ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤਿ, ਬੇਦ ਪੂਕਾਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 53.645,
      "end_time": 61.335,
      "transcript": "ਸੋਧਤ ਸੋਧਤ, ਸੋਧਿ ਬੀਚਾਰਾ ਬਿਨੁ ਹਰਿ ਭਜਨ, ਨਹੀ ਛੁਟਕਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 61.335,
      "end_time": 69.12,
      "transcript": "ਸਾਸਿ ਸਾਸਿ, ਹਮ ਭੂਲਨਹਾਰੇ ਤੁਮ ਸਮਰਥ, ਅਗਨਤ ਅਪਾਰੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 69.12,
      "end_time": 77.315,
      "transcript": "ਸਰਨਿ ਪਰੇ ਕੀ, ਰਾਖੁ ਦਇਆਲਾ ਨਾਨਕ, ਤੁਮਰੇ ਬਾਲ ਗੁਪਾਲਾ"
    }

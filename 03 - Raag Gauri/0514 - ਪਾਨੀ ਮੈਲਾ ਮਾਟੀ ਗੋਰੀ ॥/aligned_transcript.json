{
  "audio_file": "0248 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.115,
      "end_time": 3.356,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.56,
      "end_time": 18.58,
      "transcript": "ਪਾਨੀ ਮੈਲਾ, ਮਾਟੀ ਗੋਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.58,
      "end_time": 24.7,
      "transcript": "ਇਸ ਮਾਟੀ ਕੀ ਪੁਤਰੀ ਜੋਰੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.7,
      "end_time": 31.0,
      "transcript": "ਮੈ ਨਾਹੀ, ਕਛੁ ਆਹਿ ਨ ਮੋਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.0,
      "end_time": 38.945,
      "transcript": "ਤਨੁ ਧਨੁ ਸਭੁ ਰਸੁ, ਗੋਬਿੰਦ ਤੋਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.44,
      "end_time": 52.64,
      "transcript": "ਇਸ ਮਾਟੀ ਮਹਿ, ਪਵਨੁ ਸਮਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.64,
      "end_time": 58.88,
      "transcript": "ਝੂਠਾ ਪਰਪੰਚੁ, ਜੋਰਿ ਚਲਾਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.88,
      "end_time": 65.12,
      "transcript": "ਕਿਨਹੂ, ਲਾਖ ਪਾਂਚ ਕੀ ਜੋਰੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.12,
      "end_time": 70.825,
      "transcript": "ਅੰਤ ਕੀ ਬਾਰ, ਗਗਰੀਆ ਫੋਰੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.4,
      "end_time": 77.37,
      "transcript": "ਕਹਿ ਕਬੀਰ, ਇਕ ਨੀਵ ਉਸਾਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.37,
      "end_time": 82.965,
      "transcript": "ਖਿਨ ਮਹਿ ਬਿਨਸਿ ਜਾਇ, ਅਹੰਕਾਰੀ"
    }
  ]
}

      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.341,
      "end_time": 18.817,
      "transcript": "ਮਹਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.817,
      "end_time": 30.77,
      "transcript": "ਚੌਥਾ ਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 40.08,
      "end_time": 48.233,
      "transcript": "ਧੁਰਿ ਮਾਰੇ ਪੂਰੈ ਸਤਿਗੁਰੂ"
    },
    {
      "section_id": "section-00005",
      "start_time": 48.233,
      "end_time": 55.585,
      "transcript": "ਸੇਈ ਹੁਣਿ ਸਤਿਗੁਰਿ ਮਾਰੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 56.4,
      "end_time": 63.88,
      "transcript": "ਜੇ ਮੇਲਣ ਨੋ ਬਹੁਤੇਰਾ ਲੋਚੀਐ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.88,
      "end_time": 71.145,
      "transcript": "ਨ ਦੇਈ ਮਿਲਣ ਕਰਤਾਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 72.28,
      "end_time": 80.023,
      "transcript": "ਸਤਸੰਗਤਿ ਢੋਈ ਨਾ ਲਹਨਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 80.023,
      "end_time": 87.405,
      "transcript": "ਵਿਚਿ ਸੰਗਤਿ ਗੁਰਿ ਵੀਚਾਰੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.96,
      "end_time": 95.348,
      "transcript": "ਕੋਈ ਜਾਇ ਮਿਲੈ ਹੁਣਿ ਓਨਾ ਨੋ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.348,
      "end_time": 102.841,
      "transcript": "ਤਿਸੁ ਮਾਰੇ ਜਮੁ ਜੰਦਾਰੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 103.293,
      "end_time": 110.894,
      "transcript": "ਗੁਰਿ ਬਾਬੈ ਫਿਟਕੇ ਸੇ ਫਿਟੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 110.894,
      "end_time": 118.025,
      "transcript": "ਗੁਰਿ ਅੰਗਦਿ ਕੀਤੇ ਕੂੜਿਆਰੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 118.92,
      "end_time": 126.378,
      "transcript": "ਗੁਰਿ ਤੀਜੀ ਪੀੜੀ ਵੀਚਾਰਿਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 126.378,
      "end_time": 133.395,
      "transcript": "ਕਿਆ ਹਥਿ ਏਨਾ ਵੇਚਾਰੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 134.28,
      "end_time": 141.321,
      "transcript": "ਗੁਰੁ ਚਉਥੀ ਪੀੜੀ ਟਿਕਿਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 141.321,
      "end_time": 148.695,
      "transcript": "ਤਿਨਿ ਨਿੰਦਕ ਦੁਸਟ ਸਭਿ ਤਾਰੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 149.76,
      "end_time": 156.655,
      "transcript": "ਕੋਈ ਪੁਤੁ ਸਿਖੁ ਸੇਵਾ ਕਰੇ ਸਤਿਗੁਰੂ ਕੀ"
    },
    {
      "section_id": "section-00019",
      "start_time": 157.055,
      "end_time": 163.935,
      "transcript": "ਤਿਸੁ ਕਾਰਜ ਸਭਿ ਸਵਾਰੇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 165.04,
      "end_time": 172.583,
      "transcript": "ਜੋ ਇਛੈ ਸੋ ਫਲੁ ਪਾਇਸੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 172.583,
      "end_time": 180.005,
      "transcript": "ਪੁਤੁ ਧਨੁ ਲਖਮੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 180.36,
      "end_time": 186.935,
      "transcript": "ਖੜਿ ਮੇਲੇ ਹਰਿ ਨਿਸਤਾਰੇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 188.04,
      "end_time": 195.135,
      "transcript": "ਸਭਿ ਨਿਧਾਨ ਸਤਿਗੁਰੂ ਵਿਚਿ"
    },
    {
      "section_id": "section-00024",
      "start_time": 195.68,
      "end_time": 202.545,
      "transcript": "ਜਿਸੁ ਅੰਦਰਿ ਹਰਿ ਉਰ ਧਾਰੇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 203.28,
      "end_time": 210.404,
      "transcript": "ਸੋ ਪਾਏ ਪੂਰਾ ਸਤਿਗੁਰੂ"
    },
    {
      "section_id": "section-00026",
      "start_time": 210.404,
      "end_time": 217.555,
      "transcript": "ਜਿਸੁ ਲਿਖਿਆ ਲਿਖਤੁ ਲਿਲਾਰੇ"
    },
    {
      "section_id": "section-00027",
      "start_time": 218.48,
      "end_time": 225.651,
      "transcript": "ਜਨੁ ਨਾਨਕੁ ਮਾਗੈ ਧੂੜਿ ਤਿਨ"
    },
    {
      "section_id": "section-00028",
      "start_time": 225.651,
      "end_time": 233.058,
      "transcript": "ਜੋ ਗੁਰਸਿਖ ਮਿਤ ਪਿਆਰੇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 233.058,
      "end_time": 237.871,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00030",
      "start_time": 245.12,
      "end_time": 252.72,
      "transcript": "ਜਿਨ ਕਉ ਆਪਿ ਦੇਇ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00031",
      "start_time": 252.72,
      "end_time": 260.28,
      "transcript": "ਜਗਤੁ ਭੀ ਆਪੇ ਆਣਿ ਤਿਨ ਕਉ ਪੈਰੀ ਪਾਏ"
    },
    {
      "section_id": "section-00032",
      "start_time": 260.28,
      "end_time": 267.8,
      "transcript": "ਡਰੀਐ ਤਾਂ ਜੇ ਕਿਛੁ ਆਪ ਦੂ ਕੀਚੈ"
    },
    {
      "section_id": "section-00033",
      "start_time": 267.8,
      "end_time": 274.345,
      "transcript": "ਸਭੁ ਕਰਤਾ ਆਪਣੀ ਕਲਾ ਵਧਾਏ"
    },
    {
      "section_id": "section-00034",
      "start_time": 275.36,
      "end_time": 282.901,
      "transcript": "ਦੇਖਹੁ ਭਾਈ ਏਹੁ ਅਖਾੜਾ"
    },
    {
      "section_id": "section-00035",
      "start_time": 282.901,
      "end_time": 289.685,
      "transcript": "ਹਰਿ ਪ੍ਰੀਤਮ ਸਚੇ ਕਾ"
    },
    {
      "section_id": "section-00036",
      "start_time": 290.44,
      "end_time": 297.495,
      "transcript": "ਜਿਨਿ ਆਪਣੈ ਜੋਰਿ ਸਭਿ ਆਣਿ ਨਿਵਾਏ"
    },
    {
      "section_id": "section-00037",
      "start_time": 298.035,
      "end_time": 305.52,
      "transcript": "ਆਪਣਿਆ ਭਗਤਾ ਕੀ ਰਖ ਕਰੇ ਹਰਿ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00038",
      "start_time": 305.52,
      "end_time": 313.08,
      "transcript": "ਨਿੰਦਕਾ ਦੁਸਟਾ ਕੇ ਮੁਹ ਕਾਲੇ ਕਰਾਏ"
    },
    {
      "section_id": "section-00039",
      "start_time": 313.08,
      "end_time": 320.64,
      "transcript": "ਸਤਿਗੁਰ ਕੀ ਵਡਿਆਈ ਨਿਤ ਚੜੈ ਸਵਾਈ"
    },
    {
      "section_id": "section-00040",
      "start_time": 320.64,
      "end_time": 328.16,
      "transcript": "ਹਰਿ ਕੀਰਤਿ ਭਗਤਿ ਨਿਤ ਆਪਿ ਕਰਾਏ"
    },
    {
      "section_id": "section-00041",
      "start_time": 328.16,
      "end_time": 335.64,
      "transcript": "ਅਨਦਿਨੁ ਨਾਮੁ ਜਪਹੁ ਗੁਰਸਿਖਹੁ"
    },
    {
      "section_id": "section-00042",
      "start_time": 335.64,
      "end_time": 342.055,
      "transcript": "ਹਰਿ ਕਰਤਾ ਸਤਿਗੁਰੁ ਘਰੀ ਵਸਾਏ"
    },
    {
      "section_id": "section-00043",
      "start_time": 343.08,
      "end_time": 350.64,
      "transcript": "ਸਤਿਗੁਰ ਕੀ ਬਾਣੀ ਸਤਿ ਸਤਿ ਕਰਿ ਜਾਣਹੁ ਗੁਰਸਿਖਹੁ"
    },
    {
      "section_id": "section-00044",
      "start_time": 350.64,
      "end_time": 357.105,
      "transcript": "ਹਰਿ ਕਰਤਾ ਆਪਿ ਮੁਹਹੁ ਕਢਾਏ"
    },
    {
      "section_id": "section-00045",
      "start_time": 358.04,
      "end_time": 365.005,
      "transcript": "ਗੁਰਸਿਖਾ ਕੇ ਮੁਹ ਉਜਲੇ ਕਰੇ ਹਰਿ ਪਿਆਰਾ"
    },
    {
      "section_id": "section-00046",
      "start_time": 365.44,
      "end_time": 372.96,
      "transcript": "ਗੁਰ ਕਾ ਜੈਕਾਰੁ ਸੰਸਾਰਿ ਸਭਤੁ ਕਰਾਏ"
    },
    {
      "section_id": "section-00047",
      "start_time": 372.96,
      "end_time": 379.565,
      "transcript": "ਜਨੁ ਨਾਨਕੁ ਹਰਿ ਕਾ ਦਾਸੁ ਹੈ"
    },
    {
      "section_id": "section-00048",
      "start_time": 380.48,
      "end_time": 389.825,
      "transcript": "ਹਰਿ ਦਾਸਨ ਕੀ ਹਰਿ ਪੈਜ ਰਖਾਏ ਪਉੜੀ"
    },
    {
      "section_id": "section-00049",
      "start_time": 390.28,
      "end_time": 398.825,
      "transcript": "ਤੂ ਸਚਾ ਸਾਹਿਬੁ ਆਪਿ ਹੈ, ਸਚੁ ਸਾਹ ਹਮਾਰੇ"
    },
    {
      "section_id": "section-00050",
      "start_time": 399.2,
      "end_time": 407.514,
      "transcript": "ਸਚੁ ਪੂਜੀ ਨਾਮੁ ਦ੍ਰਿੜਾਇ ਪ੍ਰਭ, ਵਣਜਾਰੇ ਥਾਰੇ"
    },
    {
      "section_id": "section-00051",
      "start_time": 407.514,
      "end_time": 415.585,
      "transcript": "ਸਚੁ ਸੇਵਹਿ ਸਚੁ ਵਣੰਜਿ ਲੈਹਿ, ਗੁਣ ਕਥਹ ਨਿਰਾਰੇ"
    },
    {
      "section_id": "section-00052",
      "start_time": 415.88,
      "end_time": 423.665,
      "transcript": "ਸੇਵਕ ਭਾਇ ਸੇ ਜਨ ਮਿਲੇ, ਗੁਰ ਸਬਦਿ ਸਵਾਰੇ"
    },
    {
      "section_id": "section-00053",
      "start_time": 424.04,
      "end_time": 435.081,
      "transcript": "ਤੂ ਸਚਾ ਸਾਹਿਬੁ ਅਲਖੁ ਹੈ, ਗੁਰ ਸਬਦਿ ਲਖਾਰੇ"
    }
  ]
}

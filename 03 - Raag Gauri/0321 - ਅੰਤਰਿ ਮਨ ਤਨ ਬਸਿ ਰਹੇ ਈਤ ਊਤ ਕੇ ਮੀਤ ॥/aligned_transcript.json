{
  "audio_file": "0191 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.335,
      "end_time": 6.015,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.68,
      "end_time": 14.615,
      "transcript": "ਅੰਤਰਿ ਮਨ ਤਨ ਬਸਿ ਰਹੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.615,
      "end_time": 22.251,
      "transcript": "ਈਤ ਊਤ ਕੇ ਮੀਤ"
    },
    {
      "section_id": "section-00004",
      "start_time": 22.251,
      "end_time": 30.145,
      "transcript": "ਗੁਰਿ ਪੂਰੈ ਉਪਦੇਸਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.145,
      "end_time": 38.465,
      "transcript": "ਨਾਨਕ ਜਪੀਐ ਨੀਤ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.4,
      "end_time": 53.12,
      "transcript": "ਅਨਦਿਨੁ ਸਿਮਰਹੁ ਤਾਸੁ ਕਉ, ਜੋ ਅੰਤਿ ਸਹਾਈ ਹੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.12,
      "end_time": 61.744,
      "transcript": "ਇਹ ਬਿਖਿਆ ਦਿਨ ਚਾਰਿ ਛਿਅ, ਛਾਡਿ ਚਲਿਓ ਸਭੁ ਕੋਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.744,
      "end_time": 66.02,
      "transcript": "ਕਾ ਕੋ, ਮਾਤ ਪਿਤਾ ਸੁਤ ਧੀਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.02,
      "end_time": 70.36,
      "transcript": "ਗ੍ਰਿਹ ਬਨਿਤਾ, ਕਛੁ ਸੰਗਿ ਨ ਲੀਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.36,
      "end_time": 74.6,
      "transcript": "ਐਸੀ ਸੰਚਿ, ਜੁ ਬਿਨਸਤ ਨਾਹੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 74.6,
      "end_time": 78.805,
      "transcript": "ਪਤਿ ਸੇਤੀ, ਅਪੁਨੈ ਘਰਿ ਜਾਹੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 78.805,
      "end_time": 83.065,
      "transcript": "ਸਾਧਸੰਗਿ, ਕਲਿ ਕੀਰਤਨੁ ਗਾਇਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 83.065,
      "end_time": 88.53,
      "transcript": "ਨਾਨਕ ਤੇ ਤੇ, ਬਹੁਰਿ ਨ ਆਇਆ"
    }
  ]
}

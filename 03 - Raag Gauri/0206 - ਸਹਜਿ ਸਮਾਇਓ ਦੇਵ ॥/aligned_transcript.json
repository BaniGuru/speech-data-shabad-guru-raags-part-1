  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.225,
      "end_time": 7.495,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.92,
      "end_time": 23.275,
      "transcript": "ਸਹਜਿ ਸਮਾਇਓ, ਦੇਵ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.275,
      "end_time": 31.235,
      "transcript": "ਮੋ ਕਉ, ਸਤਿਗੁਰ ਭਏ ਦਇਆਲ ਦੇਵ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 39.12,
      "end_time": 46.434,
      "transcript": "ਕਾਟਿ ਜੇਵਰੀ ਕੀਓ ਦਾਸਰੋ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.434,
      "end_time": 54.315,
      "transcript": "ਸੰਤਨ ਟਹਲਾਇਓ"
    },
    {
      "section_id": "section-00006",
      "start_time": 54.48,
      "end_time": 61.825,
      "transcript": "ਏਕ ਨਾਮ ਕੋ ਥੀਓ ਪੂਜਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.2,
      "end_time": 69.355,
      "transcript": "ਮੋ ਕਉ ਅਚਰਜੁ ਗੁਰਹਿ ਦਿਖਾਇਓ"
    },
    {
      "section_id": "section-00008",
      "start_time": 69.96,
      "end_time": 77.055,
      "transcript": "ਭਇਓ ਪ੍ਰਗਾਸੁ ਸਰਬ ਉਜੀਆਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 77.6,
      "end_time": 84.705,
      "transcript": "ਗੁਰ ਗਿਆਨੁ ਮਨਹਿ ਪ੍ਰਗਟਾਇਓ"
    },
    {
      "section_id": "section-00010",
      "start_time": 85.4,
      "end_time": 92.565,
      "transcript": "ਅੰਮ੍ਰਿਤੁ ਨਾਮੁ ਪੀਓ ਮਨੁ ਤ੍ਰਿਪਤਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 92.865,
      "end_time": 100.425,
      "transcript": "ਅਨਭੈ ਠਹਰਾਇਓ"
    },
    {
      "section_id": "section-00012",
      "start_time": 100.88,
      "end_time": 108.075,
      "transcript": "ਮਾਨਿ ਆਗਿਆ ਸਰਬ ਸੁਖ ਪਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 108.56,
      "end_time": 115.735,
      "transcript": "ਦੂਖਹ ਠਾਉ ਗਵਾਇਓ"
    },
    {
      "section_id": "section-00014",
      "start_time": 116.32,
      "end_time": 124.08,
      "transcript": "ਜਉ ਸੁਪ੍ਰਸੰਨ ਭਏ ਪ੍ਰਭ ਠਾਕੁਰ"
    },
    {
      "section_id": "section-00015",
      "start_time": 124.08,
      "end_time": 131.563,
      "transcript": "ਸਭੁ ਆਨਦ ਰੂਪੁ ਦਿਖਾਇਓ"
    },
    {
      "section_id": "section-00016",
      "start_time": 131.563,
      "end_time": 139.4,
      "transcript": "ਨਾ ਕਿਛੁ ਆਵਤ ਨਾ ਕਿਛੁ ਜਾਵਤ"
    },
    {
      "section_id": "section-00017",
      "start_time": 139.4,
      "end_time": 146.833,
      "transcript": "ਸਭੁ ਖੇਲੁ ਕੀਓ ਹਰਿ ਰਾਇਓ"
    },
    {
      "section_id": "section-00018",
      "start_time": 146.833,
      "end_time": 154.205,
      "transcript": "ਕਹੁ ਨਾਨਕ ਅਗਮ ਅਗਮ ਹੈ ਠਾਕੁਰ"
    },
    {
      "section_id": "section-00019",
      "start_time": 154.76,

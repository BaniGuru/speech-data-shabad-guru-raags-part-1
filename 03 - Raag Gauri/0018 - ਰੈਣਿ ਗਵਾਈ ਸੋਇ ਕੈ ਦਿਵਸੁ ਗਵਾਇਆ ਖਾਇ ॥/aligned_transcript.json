      "section_id": "section-00011",
      "start_time": 102.719,
      "end_time": 110.376,
      "transcript": "ਸੇ ਆਏ ਅਨਤ ਗਵਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 110.376,
      "end_time": 117.631,
      "transcript": "ਆਪਣ ਲੀਆ ਜੇ ਮਿਲੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 117.631,
      "end_time": 124.439,
      "transcript": "ਤਾ ਸਭੁ ਕੋ ਭਾਗਠੁ ਹੋਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 124.439,
      "end_time": 132.191,
      "transcript": "ਕਰਮਾ ਉਪਰਿ ਨਿਬੜੈ, ਜੇ ਲੋਚੈ ਸਭੁ ਕੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 132.191,
      "end_time": 139.438,
      "transcript": "ਨਾਨਕ ਕਰਣਾ ਜਿਨਿ ਕੀਆ"

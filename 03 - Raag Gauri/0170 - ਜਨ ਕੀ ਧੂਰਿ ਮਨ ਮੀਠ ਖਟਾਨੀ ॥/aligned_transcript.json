{
  "audio_file": "0151 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.615,
      "end_time": 15.055,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 30.56,
      "end_time": 36.818,
      "transcript": "ਜਨ ਕੀ ਧੂਰਿ, ਮਨ ਮੀਠ ਖਟਾਨੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.818,
      "end_time": 46.699,
      "transcript": "ਪੂਰਬਿ ਕਰਮਿ ਲਿਖਿਆ, ਧੁਰਿ ਪ੍ਰਾਨੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 52.515,
      "end_time": 59.16,
      "transcript": "ਅਹੰਬੁਧਿ, ਮਨ ਪੂਰਿ ਥਿਧਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 59.16,
      "end_time": 65.395,
      "transcript": "ਸਾਧ ਧੂਰਿ ਕਰਿ, ਸੁਧ ਮੰਜਾਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 65.395,
      "end_time": 71.335,
      "transcript": "ਅਨਿਕ ਜਲਾ, ਜੇ ਧੋਵੈ ਦੇਹੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 71.335,
      "end_time": 77.875,
      "transcript": "ਮੈਲੁ ਨ ਉਤਰੈ, ਸੁਧੁ ਨ ਤੇਹੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.159,
      "end_time": 90.48,
      "transcript": "ਸਤਿਗੁਰੁ ਭੇਟਿਓ, ਸਦਾ ਕ੍ਰਿਪਾਲ"
    },
    {
      "section_id": "section-00009",
      "start_time": 90.48,
      "end_time": 96.375,
      "transcript": "ਹਰਿ ਸਿਮਰਿ ਸਿਮਰਿ, ਕਾਟਿਆ ਭਉ ਕਾਲ"
    },
    {
      "section_id": "section-00010",
      "start_time": 96.625,
      "end_time": 102.92,
      "transcript": "ਮੁਕਤਿ ਭੁਗਤਿ ਜੁਗਤਿ, ਹਰਿ ਨਾਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 102.92,
      "end_time": 108.675,
      "transcript": "ਪ੍ਰੇਮ ਭਗਤਿ, ਨਾਨਕ ਗੁਣ ਗਾਉ"
    }
  ]
}

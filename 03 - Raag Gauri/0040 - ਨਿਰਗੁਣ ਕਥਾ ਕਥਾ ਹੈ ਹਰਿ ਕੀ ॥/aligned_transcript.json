{
  "audio_file": "0124 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.88,
      "end_time": 23.34,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 41.6,
      "end_time": 48.96,
      "transcript": "ਨਿਰਗੁਣ ਕਥਾ, ਕਥਾ ਹੈ ਹਰਿ ਕੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 48.96,
      "end_time": 56.24,
      "transcript": "ਭਜੁ ਮਿਲਿ ਸਾਧੂ, ਸੰਗਤਿ ਜਨ ਕੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 56.24,
      "end_time": 63.219,
      "transcript": "ਤਰੁ ਭਉਜਲੁ, ਅਕਥ ਕਥਾ ਸੁਨਿ ਹਰਿ ਕੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 63.219,
      "end_time": 70.76,
      "transcript": "ਗੋਬਿੰਦ ਸਤਸੰਗਤਿ ਮੇਲਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 70.76,
      "end_time": 81.48,
      "transcript": "ਹਰਿ ਰਸੁ ਰਸਨਾ ਰਾਮ ਗੁਨ ਗਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 88.92,
      "end_time": 96.08,
      "transcript": "ਜੋ ਜਨ ਧਿਆਵਹਿ, ਹਰਿ ਹਰਿ ਨਾਮਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 96.08,
      "end_time": 103.28,
      "transcript": "ਤਿਨ ਦਾਸਨਿ ਦਾਸ ਕਰਹੁ ਹਮ ਰਾਮਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 103.28,
      "end_time": 110.31,
      "transcript": "ਜਨ ਕੀ ਸੇਵਾ, ਊਤਮ ਕਾਮਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 110.52,
      "end_time": 117.8,
      "transcript": "ਜੋ ਹਰਿ ਕੀ, ਹਰਿ ਕਥਾ ਸੁਣਾਵੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 117.8,
      "end_time": 125.0,
      "transcript": "ਸੋ ਜਨੁ ਹਮਰੈ ਮਨਿ ਚਿਤਿ ਭਾਵੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 125.0,
      "end_time": 131.85,
      "transcript": "ਜਨ ਪਗ ਰੇਣੁ, ਵਡਭਾਗੀ ਪਾਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 132.32,
      "end_time": 139.56,
      "transcript": "ਸੰਤ ਜਨਾ ਸਿਉ, ਪ੍ਰੀਤਿ ਬਨਿ ਆਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 139.56,
      "end_time": 146.88,
      "transcript": "ਜਿਨ ਕਉ ਲਿਖਤੁ ਲਿਖਿਆ ਧੁਰਿ ਪਾਈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 146.88,
      "end_time": 153.88,
      "transcript": "ਤੇ ਜਨ ਨਾਨਕ, ਨਾਮਿ ਸਮਾਈ"
    }
  ]
}

{
  "audio_file": "0137 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.12,
      "end_time": 6.595,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.32,
      "end_time": 18.32,
      "transcript": "ਨੈਨਹੁ ਨੀਦ, ਪਰ ਦ੍ਰਿਸਟਿ ਵਿਕਾਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.32,
      "end_time": 24.56,
      "transcript": "ਸ੍ਰਵਣ ਸੋਏ, ਸੁਣਿ ਨਿੰਦ ਵੀਚਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.56,
      "end_time": 30.68,
      "transcript": "ਰਸਨਾ ਸੋਈ, ਲੋਭਿ ਮੀਠੈ ਸਾਦਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.68,
      "end_time": 36.8,
      "transcript": "ਮਨੁ ਸੋਇਆ, ਮਾਇਆ ਬਿਸਮਾਦਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 36.8,
      "end_time": 43.08,
      "transcript": "ਇਸੁ ਗ੍ਰਿਹ ਮਹਿ, ਕੋਈ ਜਾਗਤੁ ਰਹੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 43.08,
      "end_time": 50.639,
      "transcript": "ਸਾਬਤੁ ਵਸਤੁ ਓਹੁ ਅਪਨੀ ਲਹੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.44,
      "end_time": 64.427,
      "transcript": "ਸਗਲ ਸਹੇਲੀ, ਅਪਨੈ ਰਸ ਮਾਤੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.427,
      "end_time": 70.8,
      "transcript": "ਗ੍ਰਿਹ ਅਪੁਨੇ ਕੀ, ਖਬਰਿ ਨ ਜਾਤੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.8,
      "end_time": 77.04,
      "transcript": "ਮੁਸਨਹਾਰ, ਪੰਚ ਬਟਵਾਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.04,
      "end_time": 83.2,
      "transcript": "ਸੂਨੇ ਨਗਰਿ, ਪਰੇ ਠਗਹਾਰੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 83.2,
      "end_time": 89.2,
      "transcript": "ਉਨ ਤੇ ਰਾਖੈ, ਬਾਪੁ ਨ ਮਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 89.2,
      "end_time": 95.36,
      "transcript": "ਉਨ ਤੇ ਰਾਖੈ, ਮੀਤੁ ਨ ਭਾਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 95.36,
      "end_time": 101.019,
      "transcript": "ਦਰਬਿ ਸਿਆਣਪ, ਨਾ ਓਇ ਰਹਤੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 101.019,
      "end_time": 107.78,
      "transcript": "ਸਾਧਸੰਗਿ, ਓਇ ਦੁਸਟ ਵਸਿ ਹੋਤੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 113.72,
      "end_time": 119.603,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਮੋਹਿ, ਸਾਰਿੰਗਪਾਣਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 119.603,
      "end_time": 125.96,
      "transcript": "ਸੰਤਨ ਧੂਰਿ, ਸਰਬ ਨਿਧਾਨ"
    },
    {
      "section_id": "section-00018",
      "start_time": 125.96,
      "end_time": 132.04,
      "transcript": "ਸਾਬਤੁ ਪੂੰਜੀ, ਸਤਿਗੁਰ ਸੰਗਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 132.04,
      "end_time": 139.85,
      "transcript": "ਨਾਨਕੁ ਜਾਗੈ, ਪਾਰਬ੍ਰਹਮ ਕੈ ਰੰਗਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 144.28,
      "end_time": 150.285,
      "transcript": "ਸੋ ਜਾਗੈ, ਜਿਸੁ ਪ੍ਰਭੁ ਕਿਰਪਾਲੁ"
    },
    {
      "section_id": "section-00021",
      "start_time": 150.285,
      "end_time": 156.63,
      "transcript": "ਇਹ ਪੂੰਜੀ ਸਾਬਤੁ ਧਨੁ ਮਾਲੁ"
    },
    {
      "section_id": "section-00022",
      "start_time": 156.63,
      "end_time": 162.46,
      "transcript": "ਸੋ ਜਾਗੈ, ਜਿਸੁ ਪ੍ਰਭੁ ਕਿਰਪਾਲੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 162.46,
      "end_time": 172.035,
      "transcript": "ਇਹ ਪੂੰਜੀ ਸਾਬਤੁ ਧਨੁ ਮਾਲੁ ਰਹਾਉ ਦੂਜਾ"
    }
  ]
}

  "audio_file": "0194 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 4.595,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.12,
      "end_time": 20.425,
      "transcript": "ਪਤਿ ਰਾਖੀ ਗੁਰਿ ਪਾਰਬ੍ਰਹਮ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.6,
      "end_time": 28.116,
      "transcript": "ਤਜਿ ਪਰਪੰਚ ਮੋਹ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.116,
      "end_time": 35.92,
      "transcript": "ਨਾਨਕ ਸੋਊ ਆਰਾਧੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.92,
      "end_time": 47.075,
      "transcript": "ਅੰਤੁ ਨ ਪਾਰਾਵਾਰੁ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.608,
      "end_time": 55.92,
      "transcript": "ਪਪਾ ਪਰਮਿਤਿ, ਪਾਰੁ ਨ ਪਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.92,
      "end_time": 60.24,
      "transcript": "ਪਤਿਤ ਪਾਵਨ, ਅਗਮ ਹਰਿ ਰਾਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.24,
      "end_time": 64.455,
      "transcript": "ਹੋਤ ਪੁਨੀਤ, ਕੋਟ ਅਪਰਾਧੂ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.455,
      "end_time": 68.64,
      "transcript": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਜਪਹਿ, ਮਿਲਿ ਸਾਧੂ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.64,
      "end_time": 72.885,
      "transcript": "ਪਰਪਚ ਧ੍ਰੋਹ ਮੋਹ, ਮਿਟਨਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 72.885,
      "end_time": 81.15,
      "transcript": "ਜਾ ਕਉ ਰਾਖਹੁ, ਆਪਿ ਗੁਸਾਈ ਪਾਤਿਸਾਹੁ ਛਤ੍ਰ ਸਿਰ ਸੋਊ"
    },
    {
      "section_id": "section-00012",
      "start_time": 81.15,
      "end_time": 86.035,
      "transcript": "ਨਾਨਕ, ਦੂਸਰ ਅਵਰੁ ਨ ਕੋਊ"
    }
  ]
}

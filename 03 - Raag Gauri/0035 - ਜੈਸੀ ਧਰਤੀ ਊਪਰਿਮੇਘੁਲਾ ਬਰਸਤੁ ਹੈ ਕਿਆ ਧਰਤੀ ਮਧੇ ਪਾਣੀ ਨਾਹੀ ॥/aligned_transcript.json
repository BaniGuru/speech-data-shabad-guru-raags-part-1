    {
      "section_id": "section-00007",
      "start_time": 80.68,
      "end_time": 88.439,
      "transcript": "ਬਾਬਾ ਤੂੰ ਐਸੇ ਭਰਮੁ ਚੁਕਾਹੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 88.439,
      "end_time": 96.123,
      "transcript": "ਜੋ ਕਿਛੁ ਕਰਤੁ ਹੈ ਸੋਈ ਕੋਈ ਹੈ ਰੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 96.123,
      "end_time": 104.201,
      "transcript": "ਤੈਸੇ ਜਾਇ ਸਮਾਹੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 112.209,
      "end_time": 120.546,
      "transcript": "ਇਸਤਰੀ ਪੁਰਖ ਹੋਇ ਕੈ, ਕਿਆ ਓਇ ਕਰਮ ਕਮਾਹੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 120.546,
      "end_time": 128.32,
      "transcript": "ਨਾਨਾ ਰੂਪ ਸਦਾ ਹਹਿ ਤੇਰੇ"

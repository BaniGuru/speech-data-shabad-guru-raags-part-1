    },
    {
      "section_id": "section-00013",
      "start_time": 136.182,
      "end_time": 140.451,
      "transcript": "ਇਤਨੇ ਜਨਮ ਭੂਲਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 140.451,
      "end_time": 152.346,
      "transcript": "ਪਰੇ ਸੇ ਜਾ ਪਾਇਆ ਤਾ ਭੂਲੇ ਨਾਹੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 152.346,
      "end_time": 159.84,
      "transcript": "ਜਾ ਕਾ ਕਾਰਜੁ ਸੋਈ ਪਰੁ ਜਾਣੈ"

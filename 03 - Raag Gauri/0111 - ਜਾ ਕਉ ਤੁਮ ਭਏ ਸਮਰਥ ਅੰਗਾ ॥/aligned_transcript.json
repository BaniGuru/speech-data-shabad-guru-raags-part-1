  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.64,
      "end_time": 17.034,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 27.785,
      "end_time": 35.655,
      "transcript": "ਜਾ ਕਉ ਤੁਮ ਭਏ, ਸਮਰਥ ਅੰਗਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 35.96,
      "end_time": 43.901,
      "transcript": "ਤਾ ਕਉ, ਕਛੁ ਨਾਹੀ ਕਾਲੰਗਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 43.901,
      "end_time": 52.218,
      "transcript": "ਮਾਧਉ, ਜਾ ਕਉ ਹੈ ਆਸ ਤੁਮਾਰੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 52.218,
      "end_time": 60.758,
      "transcript": "ਤਾ ਕਉ, ਕਛੁ ਨਾਹੀ ਸੰਸਾਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 81.025,
      "end_time": 88.835,
      "transcript": "ਜਾ ਕੈ ਹਿਰਦੈ, ਠਾਕੁਰੁ ਹੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 89.32,
      "end_time": 97.262,
      "transcript": "ਤਾ ਕਉ, ਸਹਸਾ ਨਾਹੀ ਕੋਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 97.262,
      "end_time": 105.175,
      "transcript": "ਜਾ ਕਉ, ਤੁਮ ਦੀਨੀ ਪ੍ਰਭ ਧੀਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 105.695,
      "end_time": 113.729,
      "transcript": "ਤਾ ਕੈ, ਨਿਕਟਿ ਨ ਆਵੈ ਪੀਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 113.729,
      "end_time": 121.848,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਮੈ ਸੋ ਗੁਰੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 121.848,
      "end_time": 129.555,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਪੂਰਨ ਦੇਖਾਇਆ"
    }

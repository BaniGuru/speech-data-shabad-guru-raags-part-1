{
  "audio_file": "0137 BPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 6.562,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.56,
      "end_time": 18.381,
      "transcript": "ਬਿਆਪਤ, ਹਰਖ ਸੋਗ ਬਿਸਥਾਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.381,
      "end_time": 24.92,
      "transcript": "ਬਿਆਪਤ, ਸੁਰਗ ਨਰਕ ਅਵਤਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.92,
      "end_time": 31.08,
      "transcript": "ਬਿਆਪਤ ਧਨ, ਨਿਰਧਨ ਪੇਖਿ ਸੋਭਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.08,
      "end_time": 37.039,
      "transcript": "ਮੂਲੁ ਬਿਆਧੀ, ਬਿਆਪਸਿ ਲੋਭਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 37.039,
      "end_time": 43.28,
      "transcript": "ਮਾਇਆ ਬਿਆਪਤ, ਬਹੁ ਪਰਕਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 43.28,
      "end_time": 51.377,
      "transcript": "ਸੰਤ ਜੀਵਹਿ ਪ੍ਰਭ ਓਟ ਤੁਮਾਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.0,
      "end_time": 65.28,
      "transcript": "ਬਿਆਪਤ, ਅਹੰਬੁਧਿ ਕਾ ਮਾਤਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.28,
      "end_time": 71.56,
      "transcript": "ਬਿਆਪਤ, ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਸੰਗਿ ਰਾਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.56,
      "end_time": 77.76,
      "transcript": "ਬਿਆਪਤ, ਹਸਤਿ ਘੋੜੇ ਅਰੁ ਬਸਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.76,
      "end_time": 84.0,
      "transcript": "ਬਿਆਪਤ, ਰੂਪ ਜੋਬਨ ਮਦ ਮਸਤਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 84.0,
      "end_time": 89.784,
      "transcript": "ਬਿਆਪਤ, ਭੂਮਿ ਰੰਕ ਅਰੁ ਰੰਗਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 89.784,
      "end_time": 96.16,
      "transcript": "ਬਿਆਪਤ, ਗੀਤ ਨਾਦ ਸੁਣਿ ਸੰਗਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 96.16,
      "end_time": 102.173,
      "transcript": "ਬਿਆਪਤ, ਸੇਜ ਮਹਲ ਸੀਗਾਰ"
    },
    {
      "section_id": "section-00015",
      "start_time": 102.173,
      "end_time": 108.898,
      "transcript": "ਪੰਚ ਦੂਤ, ਬਿਆਪਤ ਅੰਧਿਆਰ"
    },
    {
      "section_id": "section-00016",
      "start_time": 114.68,
      "end_time": 120.858,
      "transcript": "ਬਿਆਪਤ, ਕਰਮ ਕਰੈ ਹਉ ਫਾਸਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 120.858,
      "end_time": 127.32,
      "transcript": "ਬਿਆਪਤਿ ਗਿਰਸਤ, ਬਿਆਪਤ ਉਦਾਸਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 127.32,
      "end_time": 133.52,
      "transcript": "ਆਚਾਰ ਬਿਉਹਾਰ, ਬਿਆਪਤ ਇਹ ਜਾਤਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 133.52,
      "end_time": 140.532,
      "transcript": "ਸਭ ਕਿਛੁ ਬਿਆਪਤ, ਬਿਨੁ ਹਰਿ ਰੰਗ ਰਾਤ"
    },
    {
      "section_id": "section-00020",
      "start_time": 146.0,
      "end_time": 152.12,
      "transcript": "ਸੰਤਨ ਕੇ ਬੰਧਨ, ਕਾਟੇ ਹਰਿ ਰਾਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 152.12,
      "end_time": 158.44,
      "transcript": "ਤਾ ਕਉ, ਕਹਾ ਬਿਆਪੈ ਮਾਇ"
    },
    {
      "section_id": "section-00022",
      "start_time": 158.44,
      "end_time": 164.48,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਿਨਿ ਧੂਰਿ ਸੰਤ ਪਾਈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 164.48,
      "end_time": 170.62,
      "transcript": "ਤਾ ਕੈ ਨਿਕਟਿ, ਨ ਆਵੈ ਮਾਈ"
    }
  ]
}

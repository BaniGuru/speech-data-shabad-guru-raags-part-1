{
  "audio_file": "0129 BPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.06,
      "end_time": 7.209,
      "transcript": "ਗਉੜੀ ਪੂਰਬੀ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.977,
      "end_time": 20.992,
      "transcript": "ਇਸੁ ਗੜ ਮਹਿ ਹਰਿ ਰਾਮ ਰਾਇ ਹੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.992,
      "end_time": 28.046,
      "transcript": "ਕਿਛੁ ਸਾਦੁ ਨ ਪਾਵੈ ਧੀਠਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.046,
      "end_time": 35.162,
      "transcript": "ਹਰਿ ਦੀਨ ਦਇਆਲਿ ਅਨੁਗ੍ਰਹੁ ਕੀਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.162,
      "end_time": 42.074,
      "transcript": "ਹਰਿ ਗੁਰਸਬਦੀ ਚਖਿ ਡੀਠਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.074,
      "end_time": 51.62,
      "transcript": "ਰਾਮ ਹਰਿ ਕੀਰਤਨੁ ਗੁਰ ਲਿਵ ਮੀਠਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.44,
      "end_time": 62.8,
      "transcript": "ਹਰਿ ਅਗਮੁ ਅਗੋਚਰੁ ਪਾਰਬ੍ਰਹਮੁ ਹੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.8,
      "end_time": 70.44,
      "transcript": "ਮਿਲਿ ਸਤਿਗੁਰ ਲਾਗਿ ਬਸੀਠਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.44,
      "end_time": 77.36,
      "transcript": "ਜਿਨ ਗੁਰ ਬਚਨ ਸੁਖਾਨੇ ਹੀਅਰੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.36,
      "end_time": 84.364,
      "transcript": "ਤਿਨ ਆਗੈ ਆਣਿ ਪਰੀਠਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.364,
      "end_time": 91.4,
      "transcript": "ਮਨਮੁਖ ਹੀਅਰਾ ਅਤਿ ਕਠੋਰੁ ਹੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 91.4,
      "end_time": 98.4,
      "transcript": "ਤਿਨ ਅੰਤਰਿ ਕਾਰ ਕਰੀਠਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 98.4,
      "end_time": 105.4,
      "transcript": "ਬਿਸੀਅਰ ਕਉ ਬਹੁ ਦੂਧੁ ਪੀਆਈਐ"
    },
    {
      "section_id": "section-00014",
      "start_time": 105.4,
      "end_time": 112.36,
      "transcript": "ਬਿਖੁ ਨਿਕਸੈ ਫੋਲਿ ਫੁਲੀਠਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 112.36,
      "end_time": 118.76,
      "transcript": "ਹਰਿ ਪ੍ਰਭ ਆਨਿ ਮਿਲਾਵਹੁ ਗੁਰੁ ਸਾਧੂ"
    },
    {
      "section_id": "section-00016",
      "start_time": 118.76,
      "end_time": 126.36,
      "transcript": "ਘਸਿ ਗਰੁੜੁ ਸਬਦੁ ਮੁਖਿ ਲੀਠਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 126.36,
      "end_time": 132.76,
      "transcript": "ਜਨ ਨਾਨਕ ਗੁਰ ਕੇ ਲਾਲੇ ਗੋਲੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 132.76,
      "end_time": 139.831,
      "transcript": "ਲਗਿ ਸੰਗਤਿ ਕਰੂਆ ਮੀਠਾ"
    }
  ]
}

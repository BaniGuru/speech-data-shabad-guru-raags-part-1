{
  "audio_file": "0134 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.038,
      "end_time": 6.155,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.48,
      "end_time": 18.566,
      "transcript": "ਸੁਣਿ ਹਰਿ ਕਥਾ, ਉਤਾਰੀ ਮੈਲੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.566,
      "end_time": 24.773,
      "transcript": "ਮਹਾ ਪੁਨੀਤ, ਭਏ ਸੁਖ ਸੈਲੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.773,
      "end_time": 31.101,
      "transcript": "ਵਡੈ ਭਾਗਿ, ਪਾਇਆ ਸਾਧਸੰਗੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.101,
      "end_time": 37.263,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਸਿਉ, ਲਾਗੋ ਰੰਗੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 37.263,
      "end_time": 43.398,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪਤ, ਜਨੁ ਤਾਰਿਓ"
    },
    {
      "section_id": "section-00007",
      "start_time": 43.398,
      "end_time": 52.951,
      "transcript": "ਅਗਨਿ ਸਾਗਰੁ ਗੁਰਿ ਪਾਰਿ ਉਤਾਰਿਓ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.84,
      "end_time": 64.926,
      "transcript": "ਕਰਿ ਕੀਰਤਨੁ, ਮਨ ਸੀਤਲ ਭਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.926,
      "end_time": 71.16,
      "transcript": "ਜਨਮ ਜਨਮ ਕੇ, ਕਿਲਵਿਖ ਗਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 71.16,
      "end_time": 77.36,
      "transcript": "ਸਰਬ ਨਿਧਾਨ, ਪੇਖੇ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.36,
      "end_time": 83.48,
      "transcript": "ਅਬ ਢੂਢਨ, ਕਾਹੇ ਕਉ ਜਾਹਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 83.48,
      "end_time": 89.8,
      "transcript": "ਪ੍ਰਭ ਅਪੁਨੇ, ਜਬ ਭਏ ਦਇਆਲ"
    },
    {
      "section_id": "section-00013",
      "start_time": 89.8,
      "end_time": 95.643,
      "transcript": "ਪੂਰਨ ਹੋਈ, ਸੇਵਕ ਘਾਲ"
    },
    {
      "section_id": "section-00014",
      "start_time": 95.643,
      "end_time": 102.08,
      "transcript": "ਬੰਧਨ ਕਾਟਿ, ਕੀਏ ਅਪਨੇ ਦਾਸ"
    },
    {
      "section_id": "section-00015",
      "start_time": 102.08,
      "end_time": 108.28,
      "transcript": "ਸਿਮਰਿ ਸਿਮਰਿ, ਸਿਮਰਿ ਗੁਣਤਾਸ"
    },
    {
      "section_id": "section-00016",
      "start_time": 108.28,
      "end_time": 114.6,
      "transcript": "ਏਕੋ ਮਨਿ, ਏਕੋ ਸਭ ਠਾਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 114.6,
      "end_time": 120.603,
      "transcript": "ਪੂਰਨ ਪੂਰਿ ਰਹਿਓ, ਸਭ ਜਾਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 120.603,
      "end_time": 126.84,
      "transcript": "ਗੁਰਿ ਪੂਰੈ, ਸਭੁ ਭਰਮੁ ਚੁਕਾਇਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 126.84,
      "end_time": 133.02,
      "transcript": "ਹਰਿ ਸਿਮਰਤ, ਨਾਨਕ ਸੁਖੁ ਪਾਇਆ"
    }
  ]
}

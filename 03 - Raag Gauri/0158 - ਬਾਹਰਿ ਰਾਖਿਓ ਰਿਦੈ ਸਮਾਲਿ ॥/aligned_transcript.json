{
  "audio_file": "0149 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.575,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.975,
      "end_time": 19.6,
      "transcript": "ਬਾਹਰਿ ਰਾਖਿਓ, ਰਿਦੈ ਸਮਾਲਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.6,
      "end_time": 26.2,
      "transcript": "ਘਰਿ ਆਏ, ਗੋਵਿੰਦੁ ਲੈ ਨਾਲਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.2,
      "end_time": 32.68,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਸੰਤਨ ਕੈ ਸੰਗਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.68,
      "end_time": 42.525,
      "transcript": "ਮਨੁ ਤਨੁ ਰਾਤਾ, ਰਾਮ ਕੈ ਰੰਗਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.885,
      "end_time": 55.44,
      "transcript": "ਗੁਰ ਪਰਸਾਦੀ, ਸਾਗਰੁ ਤਰਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.44,
      "end_time": 61.515,
      "transcript": "ਜਨਮ ਜਨਮ ਕੇ, ਕਿਲਵਿਖ ਸਭਿ ਹਿਰਿਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.825,
      "end_time": 68.175,
      "transcript": "ਸੋਭਾ ਸੁਰਤਿ, ਨਾਮਿ ਭਗਵੰਤੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.44,
      "end_time": 74.965,
      "transcript": "ਪੂਰੇ ਗੁਰ ਕਾ, ਨਿਰਮਲ ਮੰਤੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 81.32,
      "end_time": 87.864,
      "transcript": "ਚਰਣ ਕਮਲ, ਹਿਰਦੇ ਮਹਿ ਜਾਪੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.864,
      "end_time": 94.105,
      "transcript": "ਨਾਨਕੁ, ਪੇਖਿ ਜੀਵੈ ਪਰਤਾਪੁ"
    }
  ]
}

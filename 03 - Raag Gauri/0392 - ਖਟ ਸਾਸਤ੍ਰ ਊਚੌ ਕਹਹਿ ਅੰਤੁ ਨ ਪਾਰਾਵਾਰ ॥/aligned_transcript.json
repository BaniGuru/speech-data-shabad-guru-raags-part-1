{
  "audio_file": "0222 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.08,
      "end_time": 10.278,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 25.28,
      "end_time": 31.785,
      "transcript": "ਖਟ ਸਾਸਤ੍ਰ ਊਚੌ ਕਹਹਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 32.16,
      "end_time": 38.445,
      "transcript": "ਅੰਤੁ ਨ ਪਾਰਾਵਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.96,
      "end_time": 44.755,
      "transcript": "ਭਗਤ ਸੋਹਹਿ ਗੁਣ ਗਾਵਤੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.675,
      "end_time": 56.275,
      "transcript": "ਨਾਨਕ ਪ੍ਰਭ ਕੈ ਦੁਆਰ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 66.56,
      "end_time": 75.295,
      "transcript": "ਖਸਟਮਿ ਖਟ ਸਾਸਤ੍ਰ ਕਹਹਿ, ਸਿੰਮ੍ਰਿਤਿ ਕਥਹਿ ਅਨੇਕ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.295,
      "end_time": 83.892,
      "transcript": "ਊਤਮੁ ਊਚੌ ਪਾਰਬ੍ਰਹਮੁ, ਗੁਣ ਅੰਤੁ ਨ ਜਾਣਹਿ ਸੇਖ"
    },
    {
      "section_id": "section-00008",
      "start_time": 83.892,
      "end_time": 92.928,
      "transcript": "ਨਾਰਦ ਮੁਨਿ ਜਨ ਸੁਕ ਬਿਆਸ, ਜਸੁ ਗਾਵਤ ਗੋਬਿੰਦ"
    },
    {
      "section_id": "section-00009",
      "start_time": 92.928,
      "end_time": 101.698,
      "transcript": "ਰਸ ਗੀਧੇ ਹਰਿ ਸਿਉ ਬੀਧੇ, ਭਗਤ ਰਚੇ ਭਗਵੰਤ"
    },
    {
      "section_id": "section-00010",
      "start_time": 101.698,
      "end_time": 110.405,
      "transcript": "ਮੋਹ ਮਾਨ ਭ੍ਰਮੁ ਬਿਨਸਿਓ, ਪਾਈ ਸਰਨਿ ਦਇਆਲ"
    },
    {
      "section_id": "section-00011",
      "start_time": 110.585,
      "end_time": 119.265,
      "transcript": "ਚਰਨ ਕਮਲ ਮਨਿ ਤਨਿ ਬਸੇ, ਦਰਸਨੁ ਦੇਖਿ ਨਿਹਾਲ"
    },
    {
      "section_id": "section-00012",
      "start_time": 119.585,
      "end_time": 128.043,
      "transcript": "ਲਾਭੁ ਮਿਲੈ ਤੋਟਾ ਹਿਰੈ, ਸਾਧਸੰਗਿ ਲਿਵ ਲਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 128.043,
      "end_time": 136.846,
      "transcript": "ਖਾਟਿ ਖਜਾਨਾ ਗੁਣ ਨਿਧਿ ਹਰੇ, ਨਾਨਕ ਨਾਮੁ ਧਿਆਇ"
    }
  ]
}

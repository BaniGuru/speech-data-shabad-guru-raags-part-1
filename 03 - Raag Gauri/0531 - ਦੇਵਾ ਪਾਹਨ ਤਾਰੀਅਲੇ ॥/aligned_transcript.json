    {
      "section_id": "section-00007",
      "start_time": 85.595,
      "end_time": 94.24,
      "transcript": "ਚਰਨ ਬਧਿਕ, ਜਨ ਤੇਊ ਮੁਕਤਿ ਭਏ"

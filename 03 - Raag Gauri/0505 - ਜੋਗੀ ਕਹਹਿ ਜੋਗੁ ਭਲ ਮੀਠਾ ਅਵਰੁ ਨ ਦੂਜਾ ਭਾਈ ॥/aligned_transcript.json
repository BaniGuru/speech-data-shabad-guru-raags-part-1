  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 4.439,
      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.155,
      "end_time": 23.0,
      "transcript": "ਜੋਗੀ ਕਹਹਿ ਜੋਗੁ ਭਲ ਮੀਠਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.0,
      "end_time": 29.995,
      "transcript": "ਅਵਰੁ ਨ ਦੂਜਾ ਭਾਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.56,
      "end_time": 38.24,
      "transcript": "ਰੁੰਡਿਤ ਮੁੰਡਿਤ ਏਕੈ ਸਬਦੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.24,
      "end_time": 45.195,
      "transcript": "ਏਇ ਕਹਹਿ ਸਿਧਿ ਪਾਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.84,
      "end_time": 53.52,
      "transcript": "ਹਰਿ ਬਿਨੁ, ਭਰਮਿ ਭੁਲਾਨੇ ਅੰਧਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.52,
      "end_time": 61.16,
      "transcript": "ਜਾ ਪਹਿ ਜਾਉ ਆਪੁ ਛੁਟਕਾਵਨਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.16,
      "end_time": 68.702,
      "transcript": "ਤੇ ਬਾਧੇ ਬਹੁ ਫੰਧਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.355,
      "end_time": 84.115,
      "transcript": "ਜਹ ਤੇ ਉਪਜੀ ਤਹੀ ਸਮਾਨੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.115,
      "end_time": 91.305,
      "transcript": "ਇਹ ਬਿਧਿ ਬਿਸਰੀ ਤਬ ਹੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.76,
      "end_time": 99.017,
      "transcript": "ਪੰਡਿਤ ਗੁਣੀ ਸੂਰ ਹਮ ਦਾਤੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.017,
      "end_time": 106.325,
      "transcript": "ਏਹਿ ਕਹਹਿ ਬਡ ਹਮ ਹੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 106.795,
      "end_time": 114.25,
      "transcript": "ਜਿਸਹਿ ਬੁਝਾਏ ਸੋਈ ਬੂਝੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 114.25,
      "end_time": 121.915,
      "transcript": "ਬਿਨੁ ਬੂਝੇ ਕਿਉ ਰਹੀਐ"
    },
    {
      "section_id": "section-00015",
      "start_time": 122.085,
      "end_time": 129.8,
      "transcript": "ਸਤਿਗੁਰੁ ਮਿਲੈ ਅੰਧੇਰਾ ਚੂਕੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 129.8,
      "end_time": 136.755,
      "transcript": "ਇਨ ਬਿਧਿ ਮਾਣਕੁ ਲਹੀਐ"
    },
    {
      "section_id": "section-00017",
      "start_time": 137.28,
      "end_time": 144.96,
      "transcript": "ਤਜਿ ਬਾਵੇ ਦਾਹਨੇ ਬਿਕਾਰਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 144.96,
      "end_time": 152.005,
      "transcript": "ਹਰਿ ਪਦੁ ਦ੍ਰਿੜੁ ਕਰਿ ਰਹੀਐ"
    },
    {
      "section_id": "section-00019",
      "start_time": 152.435,
      "end_time": 160.04,
      "transcript": "ਕਹੁ ਕਬੀਰ ਗੂੰਗੈ ਗੁੜੁ ਖਾਇਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 160.04,
      "end_time": 167.445,
      "transcript": "ਪੂਛੇ ਤੇ ਕਿਆ ਕਹੀਐ"
    }
  ]
}

{
  "audio_file": "0196 F Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.6,
      "end_time": 6.84,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.36,
      "end_time": 26.015,
      "transcript": "ਹਥਿ ਕਲੰਮ ਅਗੰਮ, ਮਸਤਕਿ ਲਿਖਾਵਤੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.44,
      "end_time": 39.133,
      "transcript": "ਉਰਝਿ ਰਹਿਓ ਸਭ ਸੰਗਿ, ਅਨੂਪ ਰੂਪਾਵਤੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 39.133,
      "end_time": 51.815,
      "transcript": "ਉਸਤਤਿ ਕਹਨੁ ਨ ਜਾਇ, ਮੁਖਹੁ ਤੁਹਾਰੀਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 51.815,
      "end_time": 58.235,
      "transcript": "ਮੋਹੀ ਦੇਖਿ ਦਰਸੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.495,
      "end_time": 68.375,
      "transcript": "ਨਾਨਕ ਬਲਿਹਾਰੀਆ ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 77.755,
      "end_time": 85.993,
      "transcript": "ਹੇ ਅਚੁਤ ਹੇ ਪਾਰਬ੍ਰਹਮ, ਅਬਿਨਾਸੀ ਅਘਨਾਸ"
    },
    {
      "section_id": "section-00008",
      "start_time": 85.993,
      "end_time": 94.285,
      "transcript": "ਹੇ ਪੂਰਨ ਹੇ ਸਰਬ ਮੈ, ਦੁਖ ਭੰਜਨ ਗੁਣਤਾਸ"
    },
    {
      "section_id": "section-00009",
      "start_time": 94.615,
      "end_time": 102.835,
      "transcript": "ਹੇ ਸੰਗੀ ਹੇ ਨਿਰੰਕਾਰ, ਹੇ ਨਿਰਗੁਣ ਸਭ ਟੇਕ"
    },
    {
      "section_id": "section-00010",
      "start_time": 103.24,
      "end_time": 111.275,
      "transcript": "ਹੇ ਗੋਬਿਦ ਹੇ ਗੁਣ ਨਿਧਾਨ, ਜਾ ਕੈ ਸਦਾ ਬਿਬੇਕ"
    },
    {
      "section_id": "section-00011",
      "start_time": 111.475,
      "end_time": 119.735,
      "transcript": "ਹੇ ਅਪਰੰਪਰ ਹਰਿ ਹਰੇ, ਹਹਿ ਭੀ ਹੋਵਨਹਾਰ"
    },
    {
      "section_id": "section-00012",
      "start_time": 120.16,
      "end_time": 128.315,
      "transcript": "ਹੇ ਸੰਤਹ ਕੈ ਸਦਾ ਸੰਗਿ, ਨਿਧਾਰਾ ਆਧਾਰ"
    },
    {
      "section_id": "section-00013",
      "start_time": 128.76,
      "end_time": 136.645,
      "transcript": "ਹੇ ਠਾਕੁਰ ਹਉ ਦਾਸਰੋ, ਮੈ ਨਿਰਗੁਨ ਗੁਨੁ ਨਹੀ ਕੋਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 137.16,
      "end_time": 146.625,
      "transcript": "ਨਾਨਕ ਦੀਜੈ ਨਾਮ ਦਾਨੁ, ਰਾਖਉ ਹੀਐ ਪਰੋਇ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.458,
      "transcript": "ਗਉੜੀ ਬੈਰਾਗਣਿ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.458,
      "end_time": 15.137,
      "transcript": "ਰਹੋਏ ਕੇ ਛੰਤ ਕੇ ਘਰਿ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 15.137,
      "end_time": 22.725,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.48,
      "end_time": 38.24,
      "transcript": "ਹੈ ਕੋਈ, ਰਾਮ ਪਿਆਰੋ ਗਾਵੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.24,
      "end_time": 45.795,
      "transcript": "ਸਰਬ ਕਲਿਆਣ, ਸੂਖ ਸਚੁ ਪਾਵੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.365,
      "end_time": 61.08,
      "transcript": "ਬਨੁ ਬਨੁ, ਖੋਜਤ ਫਿਰਤ ਬੈਰਾਗੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.08,
      "end_time": 68.377,
      "transcript": "ਬਿਰਲੇ ਕਾਹੂ, ਏਕ ਲਿਵ ਲਾਗੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.377,
      "end_time": 75.845,
      "transcript": "ਜਿਨਿ ਹਰਿ ਪਾਇਆ, ਸੇ ਵਡਭਾਗੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.845,
      "end_time": 83.386,
      "transcript": "ਬ੍ਰਹਮਾਦਿਕ ਸਨਕਾਦਿਕ ਚਾਹੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.386,
      "end_time": 90.8,
      "transcript": "ਜੋਗੀ ਜਤੀ ਸਿਧ, ਹਰਿ ਆਹੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 90.8,
      "end_time": 98.045,
      "transcript": "ਜਿਸਹਿ ਪਰਾਪਤਿ, ਸੋ ਹਰਿ ਗੁਣ ਗਾਹੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 98.045,
      "end_time": 105.755,
      "transcript": "ਤਾ ਕੀ ਸਰਣਿ, ਜਿਨ ਬਿਸਰਤ ਨਾਹੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 105.755,
      "end_time": 113.028,
      "transcript": "ਵਡਭਾਗੀ, ਹਰਿ ਸੰਤ ਮਿਲਾਹੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 113.028,
      "end_time": 119.92,
      "transcript": "ਜਨਮ ਮਰਣ ਤਿਹ, ਮੂਲੇ ਨਾਹੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 128.48,
      "end_time": 135.715,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਮਿਲੁ ਪ੍ਰੀਤਮ ਪਿਆਰੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 136.045,
      "end_time": 143.351,
      "transcript": "ਬਿਨਉ ਸੁਨਹੁ ਪ੍ਰਭ ਊਚ ਅਪਾਰੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 143.351,
      "end_time": 150.841,
      "transcript": "ਨਾਨਕੁ ਮਾਂਗਤੁ, ਨਾਮੁ ਅਧਾਰੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 150.841,
      "end_time": 158.379,
      "transcript": "ਬਿਨਉ ਸੁਨਹੁ ਪ੍ਰਭ ਊਚ ਅਪਾਰੇ"
    },
    {
      "section_id": "section-00019",

{
  "audio_file": "0190 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 5.849,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.105,
      "end_time": 20.598,
      "transcript": "ਰਾਚਿ ਰਹੇ ਬਨਿਤਾ ਬਿਨੋਦ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.598,
      "end_time": 27.275,
      "transcript": "ਕੁਸਮ ਰੰਗ ਬਿਖ ਸੋਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.275,
      "end_time": 33.785,
      "transcript": "ਨਾਨਕ ਤਿਹ ਸਰਨੀ ਪਰਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 33.785,
      "end_time": 43.875,
      "transcript": "ਬਿਨਸਿ ਜਾਇ ਮੈ ਮੋਰ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.335,
      "end_time": 62.5,
      "transcript": "ਰੇ ਮਨ ਬਿਨੁ ਹਰਿ ਜਹ ਰਚਹੁ, ਤਹ ਤਹ ਬੰਧਨ ਪਾਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.5,
      "end_time": 70.972,
      "transcript": "ਜਿਹ ਬਿਧਿ ਕਤਹੂ ਨ ਛੂਟੀਐ, ਸਾਕਤ ਤੇਊ ਕਮਾਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.972,
      "end_time": 79.645,
      "transcript": "ਹਉ ਹਉ ਕਰਤੇ ਕਰਮ ਰਤ, ਤਾ ਕੋ ਭਾਰੁ ਅਫਾਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.775,
      "end_time": 88.664,
      "transcript": "ਪ੍ਰੀਤਿ ਨਹੀ ਜਉ ਨਾਮ ਸਿਉ, ਤਉ ਏਊ ਕਰਮ ਬਿਕਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.664,
      "end_time": 96.983,
      "transcript": "ਬਾਧੇ ਜਮ ਕੀ ਜੇਵਰੀ, ਮੀਠੀ ਮਾਇਆ ਰੰਗ"
    },
    {
      "section_id": "section-00011",
      "start_time": 96.983,
      "end_time": 105.66,
      "transcript": "ਭ੍ਰਮ ਕੇ ਮੋਹੇ ਨਹ ਬੁਝਹਿ, ਸੋ ਪ੍ਰਭੁ ਸਦਹੂ ਸੰਗ"
    },
    {
      "section_id": "section-00012",
      "start_time": 105.66,
      "end_time": 114.175,
      "transcript": "ਲੇਖੈ ਗਣਤ ਨ ਛੂਟੀਐ, ਕਾਚੀ ਭੀਤਿ ਨ ਸੁਧਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.4,
      "end_time": 122.712,
      "transcript": "ਜਿਸਹਿ ਬੁਝਾਏ ਨਾਨਕਾ, ਤਿਹ ਗੁਰਮੁਖਿ ਨਿਰਮਲ ਬੁਧਿ"
    }
  ]
}

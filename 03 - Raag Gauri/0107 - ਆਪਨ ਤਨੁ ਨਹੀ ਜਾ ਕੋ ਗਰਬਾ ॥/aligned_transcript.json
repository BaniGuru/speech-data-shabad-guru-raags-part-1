{
  "audio_file": "0141 CPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.165,
      "end_time": 6.945,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.515,
      "end_time": 18.435,
      "transcript": "ਆਪਨ ਤਨੁ ਨਹੀ, ਜਾ ਕੋ ਗਰਬਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.435,
      "end_time": 24.275,
      "transcript": "ਰਾਜ ਮਿਲਖ ਨਹੀ ਆਪਨ ਦਰਬਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.595,
      "end_time": 30.335,
      "transcript": "ਆਪਨ ਨਹੀ, ਕਾ ਕਉ ਲਪਟਾਇਓ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.745,
      "end_time": 39.755,
      "transcript": "ਆਪਨ ਨਾਮੁ, ਸਤਿਗੁਰ ਤੇ ਪਾਇਓ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.04,
      "end_time": 51.715,
      "transcript": "ਸੁਤ ਬਨਿਤਾ, ਆਪਨ ਨਹੀ ਭਾਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.886,
      "end_time": 58.145,
      "transcript": "ਇਸਟ ਮੀਤ, ਆਪ ਬਾਪੁ ਨ ਮਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.145,
      "end_time": 64.385,
      "transcript": "ਸੁਇਨਾ ਰੂਪਾ, ਫੁਨਿ ਨਹੀ ਦਾਮ"
    },
    {
      "section_id": "section-00009",
      "start_time": 64.385,
      "end_time": 70.335,
      "transcript": "ਹੈਵਰ ਗੈਵਰ, ਆਪਨ ਨਹੀ ਕਾਮ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.615,
      "end_time": 82.419,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜੋ ਗੁਰਿ ਬਖਸਿ ਮਿਲਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 82.419,
      "end_time": 88.135,
      "transcript": "ਤਿਸ ਕਾ ਸਭੁ ਕਿਛੁ, ਜਿਸ ਕਾ ਹਰਿ ਰਾਇਆ"
    }
  ]
}

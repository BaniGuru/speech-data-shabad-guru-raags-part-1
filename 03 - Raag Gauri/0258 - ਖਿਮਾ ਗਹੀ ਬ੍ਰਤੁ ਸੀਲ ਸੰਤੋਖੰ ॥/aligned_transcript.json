{
  "audio_file": "0169 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.105,
      "end_time": 7.484,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.72,
      "end_time": 21.855,
      "transcript": "ਖਿਮਾ ਗਹੀ, ਬ੍ਰਤੁ ਸੀਲ ਸੰਤੋਖੰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.855,
      "end_time": 29.19,
      "transcript": "ਰੋਗੁ ਨ ਬਿਆਪੈ, ਨਾ ਜਮ ਦੋਖੰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.19,
      "end_time": 36.245,
      "transcript": "ਮੁਕਤ ਭਏ, ਪ੍ਰਭ ਰੂਪ ਨ ਰੇਖੰ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.245,
      "end_time": 43.545,
      "transcript": "ਜੋਗੀ ਕਉ, ਕੈਸਾ ਡਰੁ ਹੋਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.755,
      "end_time": 54.417,
      "transcript": "ਰੂਖਿ ਬਿਰਖਿ, ਗ੍ਰਿਹਿ ਬਾਹਰਿ ਸੋਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 65.64,
      "end_time": 73.0,
      "transcript": "ਨਿਰਭਉ ਜੋਗੀ, ਨਿਰੰਜਨੁ ਧਿਆਵੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 73.0,
      "end_time": 80.195,
      "transcript": "ਅਨਦਿਨੁ ਜਾਗੈ, ਸਚਿ ਲਿਵ ਲਾਵੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 80.195,
      "end_time": 87.32,
      "transcript": "ਸੋ ਜੋਗੀ, ਮੇਰੈ ਮਨਿ ਭਾਵੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.32,
      "end_time": 94.545,
      "transcript": "ਕਾਲੁ ਜਾਲੁ, ਬ੍ਰਹਮ ਅਗਨੀ ਜਾਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.025,
      "end_time": 102.288,
      "transcript": "ਜਰਾ ਮਰਣ ਗਤੁ, ਗਰਬੁ ਨਿਵਾਰੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 102.288,
      "end_time": 109.565,
      "transcript": "ਆਪਿ ਤਰੈ, ਪਿਤਰੀ ਨਿਸਤਾਰੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 109.565,
      "end_time": 117.2,
      "transcript": "ਸਤਿਗੁਰੁ ਸੇਵੇ, ਸੋ ਜੋਗੀ ਹੋਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 117.2,
      "end_time": 124.415,
      "transcript": "ਭੈ ਰਚਿ ਰਹੈ, ਸੁ ਨਿਰਭਉ ਹੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 124.415,
      "end_time": 131.585,
      "transcript": "ਜੈਸਾ ਸੇਵੈ, ਤੈਸੋ ਹੋਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 131.585,
      "end_time": 139.0,
      "transcript": "ਨਰ ਨਿਹਕੇਵਲ, ਨਿਰਭਉ ਨਾਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 139.0,
      "end_time": 146.56,
      "transcript": "ਅਨਾਥਹ ਨਾਥ ਕਰੇ, ਬਲਿ ਜਾਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 146.56,
      "end_time": 153.845,
      "transcript": "ਪੁਨਰਪਿ ਜਨਮੁ ਨਾਹੀ, ਗੁਣ ਗਾਉ"
    },
    {
      "section_id": "section-00019",
      "start_time": 153.845,
      "end_time": 161.295,
      "transcript": "ਅੰਤਰਿ ਬਾਹਰਿ, ਏਕੋ ਜਾਣੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 161.295,
      "end_time": 168.55,
      "transcript": "ਗੁਰ ਕੈ ਸਬਦੇ, ਆਪੁ ਪਛਾਣੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 168.55,
      "end_time": 175.805,
      "transcript": "ਸਾਚੈ ਸਬਦਿ, ਦਰਿ ਨੀਸਾਣੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 175.805,
      "end_time": 183.325,
      "transcript": "ਸਬਦਿ ਮਰੈ, ਤਿਸੁ ਨਿਜ ਘਰਿ ਵਾਸਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 183.325,
      "end_time": 190.8,
      "transcript": "ਆਵੈ ਨ ਜਾਵੈ, ਚੂਕੈ ਆਸਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 190.8,
      "end_time": 197.915,
      "transcript": "ਗੁਰ ਕੈ ਸਬਦਿ, ਕਮਲੁ ਪਰਗਾਸਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 197.915,
      "end_time": 205.56,
      "transcript": "ਜੋ ਦੀਸੈ, ਸੋ ਆਸ ਨਿਰਾਸਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 205.56,
      "end_time": 212.655,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ ਬਿਖੁ, ਭੂਖ ਪਿਆਸਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 212.655,
      "end_time": 220.16,
      "transcript": "ਨਾਨਕ ਬਿਰਲੇ, ਮਿਲਹਿ ਉਦਾਸਾ"
    },
    {
      "section_id": "section-00028",
      "start_time": 220.16,
      "end_time": 227.085,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ ਬਿਖੁ, ਭੂਖ ਪਿਆਸਾ"
    },
    {
      "section_id": "section-00029",
      "start_time": 227.085,
      "end_time": 235.355,
      "transcript": "ਨਾਨਕ ਬਿਰਲੇ, ਮਿਲਹਿ ਉਦਾਸਾ"
    }
  ]

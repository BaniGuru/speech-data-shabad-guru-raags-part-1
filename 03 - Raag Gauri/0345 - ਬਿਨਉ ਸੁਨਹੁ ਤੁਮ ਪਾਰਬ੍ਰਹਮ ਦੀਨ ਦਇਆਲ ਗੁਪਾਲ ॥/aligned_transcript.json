  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.375,
      "end_time": 4.845,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.285,
      "end_time": 20.805,
      "transcript": "ਬਿਨਉ ਸੁਨਹੁ ਤੁਮ ਪਾਰਬ੍ਰਹਮ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.185,
      "end_time": 28.815,
      "transcript": "ਦੀਨ ਦਇਆਲ ਗੁਪਾਲ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.2,
      "end_time": 36.725,
      "transcript": "ਸੁਖ ਸੰਪੈ ਬਹੁ ਭੋਗ ਰਸ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.725,
      "end_time": 48.095,
      "transcript": "ਨਾਨਕ ਸਾਧ ਰਵਾਲ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.685,
      "end_time": 57.035,
      "transcript": "ਬਬਾ ਬ੍ਰਹਮੁ ਜਾਨਤ, ਤੇ ਬ੍ਰਹਮਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.035,
      "end_time": 61.379,
      "transcript": "ਬੈਸਨੋ ਤੇ ਗੁਰਮੁਖਿ ਸੁਚ ਧਰਮਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.379,
      "end_time": 65.763,
      "transcript": "ਬੀਰਾ, ਆਪਨ ਬੁਰਾ ਮਿਟਾਵੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.763,
      "end_time": 70.07,
      "transcript": "ਤਾਹੂ ਬੁਰਾ, ਨਿਕਟਿ ਨਹੀ ਆਵੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.07,
      "end_time": 74.365,
      "transcript": "ਬਾਧਿਓ ਆਪਨ, ਹਉ ਹਉ ਬੰਧਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 74.365,
      "end_time": 78.8,
      "transcript": "ਦੋਸੁ ਦੇਤ, ਆਗਹ ਕਉ ਅੰਧਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 78.8,
      "end_time": 82.96,
      "transcript": "ਬਾਤ ਚੀਤ, ਸਭ ਰਹੀ ਸਿਆਨਪ"
    },
    {
      "section_id": "section-00013",
      "start_time": 82.96,
      "end_time": 88.175,
      "transcript": "ਜਿਸਹਿ ਜਨਾਵਹੁ, ਸੋ ਜਾਨੈ ਨਾਨਕ"
    }
  ]
}

{
  "audio_file": "0232 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.48,
      "end_time": 4.925,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 21.815,
      "end_time": 29.805,
      "transcript": "ਰਹਦੇ ਖੁਹਦੇ ਨਿੰਦਕ ਮਾਰਿਅਨੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 29.805,
      "end_time": 37.435,
      "transcript": "ਕਰਿ ਆਪੇ ਆਹਰੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 37.855,
      "end_time": 45.425,
      "transcript": "ਸੰਤ ਸਹਾਈ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.895,
      "end_time": 53.265,
      "transcript": "ਵਰਤੈ ਸਭ ਜਾਹਰੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.68,
      "end_time": 65.385,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ ਮੁੰਢਹੁ ਭੁਲੇ ਮੁੰਢ ਤੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 65.475,
      "end_time": 73.295,
      "transcript": "ਕਿਥੈ ਪਾਇਨਿ ਹਥੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 73.76,
      "end_time": 81.12,
      "transcript": "ਤਿੰਨੈ ਮਾਰੇ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.12,
      "end_time": 89.055,
      "transcript": "ਜਿ ਕਰਣ ਕਾਰਣ ਸਮਰਥੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 89.6,
      "end_time": 93.906,
      "transcript": "ਪਉੜੀ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.44,
      "end_time": 106.145,
      "transcript": "ਲੈ ਫਾਹੇ ਰਾਤੀ ਤੁਰਹਿ, ਪ੍ਰਭੁ ਜਾਣੈ ਪ੍ਰਾਣੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.48,
      "end_time": 114.675,
      "transcript": "ਤਕਹਿ ਨਾਰਿ ਪਰਾਈਆ, ਲੁਕਿ ਅੰਦਰਿ ਠਾਣੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.915,
      "end_time": 123.265,
      "transcript": "ਸੰਨੀ੍ ਦੇਨਿ੍ ਵਿਖੰਮ ਥਾਇ, ਮਿਠਾ ਮਦੁ ਮਾਣੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 123.72,
      "end_time": 131.865,
      "transcript": "ਕਰਮੀ ਆਪੋ ਆਪਣੀ, ਆਪੇ ਪਛੁਤਾਣੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 132.08,
      "end_time": 141.855,
      "transcript": "ਅਜਰਾਈਲੁ ਫਰੇਸਤਾ, ਤਿਲ ਪੀੜੇ ਘਾਣੀ"
    }
  ]
}

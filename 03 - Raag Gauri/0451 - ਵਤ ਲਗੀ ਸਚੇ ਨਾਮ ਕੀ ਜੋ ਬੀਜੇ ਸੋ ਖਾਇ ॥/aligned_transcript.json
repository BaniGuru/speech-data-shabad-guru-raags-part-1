      "transcript": "ਵਤ ਲਗੀ ਸਚੇ ਨਾਮ ਕੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.275,
      "end_time": 36.2,
      "transcript": "ਜੋ ਬੀਜੇ ਸੋ ਖਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.2,
      "end_time": 43.555,
      "transcript": "ਤਿਸਹਿ ਪਰਾਪਤਿ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.0,
      "end_time": 51.035,
      "transcript": "ਜਿਸ ਨੋ ਲਿਖਿਆ ਆਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.445,
      "end_time": 55.615,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.115,
      "end_time": 71.08,
      "transcript": "ਮੰਗਣਾ ਤ ਸਚੁ ਇਕੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.08,
      "end_time": 78.245,
      "transcript": "ਜਿਸੁ ਤੁਸਿ ਦੇਵੈ ਆਪਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.72,
      "end_time": 85.945,
      "transcript": "ਜਿਤੁ ਖਾਧੈ ਮਨੁ ਤ੍ਰਿਪਤੀਐ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.255,
      "end_time": 93.255,
      "transcript": "ਨਾਨਕ ਸਾਹਿਬ ਦਾਤਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 93.88,
      "end_time": 96.095,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 100.845,
      "end_time": 109.155,
      "transcript": "ਲਾਹਾ ਜਗ ਮਹਿ ਸੇ ਖਟਹਿ, ਜਿਨ ਹਰਿ ਧਨੁ ਰਾਸਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 109.32,
      "end_time": 117.225,
      "transcript": "ਦੁਤੀਆ ਭਾਉ ਨ ਜਾਣਨੀ, ਸਚੇ ਦੀ ਆਸ"
    },
    {
      "section_id": "section-00015",
      "start_time": 117.6,
      "end_time": 125.485,
      "transcript": "ਨਿਹਚਲੁ ਏਕੁ ਸਰੇਵਿਆ, ਹੋਰੁ ਸਭ ਵਿਣਾਸੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 125.96,
      "end_time": 133.675,
      "transcript": "ਪਾਰਬ੍ਰਹਮੁ ਜਿਸੁ ਵਿਸਰੈ, ਤਿਸੁ ਬਿਰਥਾ ਸਾਸੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 134.2,
      "end_time": 144.275,
      "transcript": "ਕੰਠਿ ਲਾਇ ਜਨ ਰਖਿਆ, ਨਾਨਕ ਬਲਿ ਜਾਸੁ"
    }
  ]
}

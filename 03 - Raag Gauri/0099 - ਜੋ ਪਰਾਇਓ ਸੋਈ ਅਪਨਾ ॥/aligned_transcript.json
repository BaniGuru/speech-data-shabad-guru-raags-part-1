{
  "audio_file": "0140 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.16,
      "end_time": 15.19,
      "transcript": "ਰਾਗੁ ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.19,
      "end_time": 21.57,
      "transcript": "ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.57,
      "end_time": 30.46,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ ਚਉਪਦੇ ਦੁਪਦੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.46,
      "end_time": 42.78,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.48,
      "end_time": 60.655,
      "transcript": "ਜੋ ਪਰਾਇਓ, ਸੋਈ ਅਪਨਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 60.655,
      "end_time": 68.292,
      "transcript": "ਜੋ ਤਜਿ ਛੋਡਨ, ਤਿਸੁ ਸਿਉ ਮਨੁ ਰਚਨਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.52,
      "end_time": 82.557,
      "transcript": "ਕਹਹੁ ਗੁਸਾਈ ਮਿਲੀਐ ਕੇਹ"
    },
    {
      "section_id": "section-00008",
      "start_time": 82.629,
      "end_time": 90.097,
      "transcript": "ਜੋ ਬਿਬਰਜਤ, ਤਿਸ ਸਿਉ ਨੇਹ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 100.48,
      "end_time": 107.628,
      "transcript": "ਝੂਠੁ ਬਾਤ, ਸਾ ਸਚੁ ਕਰਿ ਜਾਤੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 107.628,
      "end_time": 114.674,
      "transcript": "ਸਤਿ ਹੋਵਨੁ ਮਨਿ ਲਗੈ ਨ ਰਾਤੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 114.674,
      "end_time": 122.054,
      "transcript": "ਬਾਵੈ ਮਾਰਗੁ, ਟੇਢਾ ਚਲਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 122.054,
      "end_time": 129.202,
      "transcript": "ਸੀਧਾ ਛੋਡਿ, ਅਪੂਠਾ ਬੁਨਨਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 129.202,
      "end_time": 136.154,
      "transcript": "ਦੁਹਾ ਸਿਰਿਆ ਕਾ, ਖਸਮੁ ਪ੍ਰਭੁ ਸੋਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 136.154,
      "end_time": 143.41,
      "transcript": "ਜਿਸੁ ਮੇਲੇ ਨਾਨਕ, ਸੋ ਮੁਕਤਾ ਹੋਈ"
    }
  ]
}

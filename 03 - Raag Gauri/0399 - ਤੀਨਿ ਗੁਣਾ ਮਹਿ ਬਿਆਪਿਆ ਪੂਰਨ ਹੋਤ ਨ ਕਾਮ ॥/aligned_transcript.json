  "audio_file": "0223 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.2,
      "end_time": 6.658,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.8,
      "end_time": 24.145,
      "transcript": "ਤੀਨਿ ਗੁਣਾ ਮਹਿ ਬਿਆਪਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.08,
      "end_time": 32.485,
      "transcript": "ਪੂਰਨ ਹੋਤ ਨ ਕਾਮ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.28,
      "end_time": 40.905,
      "transcript": "ਪਤਿਤ ਉਧਾਰਣੁ ਮਨਿ ਬਸੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 41.515,
      "end_time": 51.97,
      "transcript": "ਨਾਨਕ ਛੂਟੈ ਨਾਮ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 61.04,
      "end_time": 65.52,
      "transcript": "ਤ੍ਰਉਦਸੀ, ਤੀਨਿ ਤਾਪ ਸੰਸਾਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 65.52,
      "end_time": 70.0,
      "transcript": "ਆਵਤ ਜਾਤ, ਨਰਕ ਅਵਤਾਰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.0,
      "end_time": 74.415,
      "transcript": "ਹਰਿ ਹਰਿ ਭਜਨੁ, ਨ ਮਨ ਮਹਿ ਆਇਓ"
    },
    {
      "section_id": "section-00009",
      "start_time": 74.415,
      "end_time": 78.84,
      "transcript": "ਸੁਖ ਸਾਗਰ ਪ੍ਰਭੁ, ਨਿਮਖ ਨ ਗਾਇਓ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.84,
      "end_time": 83.205,
      "transcript": "ਹਰਖ ਸੋਗ ਕਾ, ਦੇਹ ਕਰਿ ਬਾਧਿਓ"
    },
    {
      "section_id": "section-00011",
      "start_time": 83.205,
      "end_time": 87.55,
      "transcript": "ਦੀਰਘ ਰੋਗੁ ਮਾਇਆ, ਆਸਾਧਿਓ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.55,
      "end_time": 92.095,
      "transcript": "ਦਿਨਹਿ ਬਿਕਾਰ ਕਰਤ, ਸ੍ਰਮੁ ਪਾਇਓ"
    },
    {
      "section_id": "section-00013",
      "start_time": 92.095,
      "end_time": 96.305,
      "transcript": "ਨੈਨੀ ਨੀਦ, ਸੁਪਨ ਬਰੜਾਇਓ"
    },
    {
      "section_id": "section-00014",
      "start_time": 96.305,
      "end_time": 101.035,
      "transcript": "ਹਰਿ ਬਿਸਰਤ, ਹੋਵਤ ਏਹ ਹਾਲ"
    },
    {
      "section_id": "section-00015",
      "start_time": 101.035,
      "end_time": 108.208,
      "transcript": "ਸਰਨਿ ਨਾਨਕ, ਪ੍ਰਭ ਪੁਰਖ ਦਇਆਲ"
    }
  ]
}

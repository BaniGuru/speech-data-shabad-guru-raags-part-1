{
  "audio_file": "0150 C PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 7.295,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.44,
      "end_time": 21.56,
      "transcript": "ਸੋ ਕਿਛੁ ਕਰਿ, ਜਿਤੁ ਮੈਲੁ ਨ ਲਾਗੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.56,
      "end_time": 28.675,
      "transcript": "ਹਰਿ ਕੀਰਤਨ ਮਹਿ, ਏਹੁ ਮਨੁ ਜਾਗੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 39.169,
      "end_time": 46.46,
      "transcript": "ਏਕੋ ਸਿਮਰਿ, ਨ ਦੂਜਾ ਭਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.46,
      "end_time": 53.72,
      "transcript": "ਸੰਤਸੰਗਿ, ਜਪਿ ਕੇਵਲ ਨਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.72,
      "end_time": 60.645,
      "transcript": "ਕਰਮ ਧਰਮ, ਨੇਮ ਬ੍ਰਤ ਪੂਜਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.0,
      "end_time": 68.08,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਬਿਨੁ, ਜਾਨੁ ਨ ਦੂਜਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.08,
      "end_time": 74.815,
      "transcript": "ਤਾ ਕੀ, ਪੂਰਨ ਹੋਈ ਘਾਲ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.16,
      "end_time": 82.205,
      "transcript": "ਜਾ ਕੀ ਪ੍ਰੀਤਿ, ਅਪੁਨੇ ਪ੍ਰਭ ਨਾਲਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.205,
      "end_time": 89.145,
      "transcript": "ਸੋ ਬੈਸਨੋ, ਹੈ ਅਪਰ ਅਪਾਰੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 89.515,
      "end_time": 96.446,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਿਨਿ ਤਜੇ ਬਿਕਾਰ"
    }
  ]
}

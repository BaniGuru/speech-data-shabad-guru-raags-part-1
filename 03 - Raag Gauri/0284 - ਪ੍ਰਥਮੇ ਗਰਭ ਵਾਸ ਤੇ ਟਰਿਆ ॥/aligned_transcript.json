{
  "audio_file": "0180 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.125,
      "end_time": 6.505,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.08,
      "end_time": 19.48,
      "transcript": "ਪ੍ਰਥਮੇ, ਗਰਭ ਵਾਸ ਤੇ ਟਰਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.48,
      "end_time": 25.435,
      "transcript": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ, ਕੁਟੰਬ ਸੰਗਿ ਜੁਰਿਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.96,
      "end_time": 32.26,
      "transcript": "ਭੋਜਨੁ ਅਨਿਕ ਪ੍ਰਕਾਰ, ਬਹੁ ਕਪਰੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.26,
      "end_time": 38.755,
      "transcript": "ਸਰਪਰ ਗਵਨੁ ਕਰਹਿਗੇ, ਬਪੁਰੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 38.755,
      "end_time": 45.2,
      "transcript": "ਕਵਨੁ ਅਸਥਾਨੁ, ਜੋ ਕਬਹੁ ਨ ਟਰੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 45.2,
      "end_time": 54.405,
      "transcript": "ਕਵਨੁ ਸਬਦੁ, ਜਿਤੁ ਦੁਰਮਤਿ ਹਰੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.44,
      "end_time": 67.655,
      "transcript": "ਇੰਦ੍ਰ ਪੁਰੀ ਮਹਿ, ਸਰਪਰ ਮਰਣਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.655,
      "end_time": 74.145,
      "transcript": "ਬ੍ਰਹਮ ਪੁਰੀ, ਨਿਹਚਲੁ ਨਹੀ ਰਹਣਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.145,
      "end_time": 80.605,
      "transcript": "ਸਿਵ ਪੁਰੀ ਕਾ, ਹੋਇਗਾ ਕਾਲਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.605,
      "end_time": 87.055,
      "transcript": "ਤ੍ਰੈ ਗੁਣ ਮਾਇਆ, ਬਿਨਸਿ ਬਿਤਾਲਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.055,
      "end_time": 93.555,
      "transcript": "ਗਿਰਿ ਤਰ ਧਰਣਿ, ਗਗਨ ਅਰੁ ਤਾਰੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 93.555,
      "end_time": 99.525,
      "transcript": "ਰਵਿ ਸਸਿ ਪਵਣੁ, ਪਾਵਕੁ ਨੀਰਾਰੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 100.045,
      "end_time": 106.085,
      "transcript": "ਦਿਨਸੁ ਰੈਣਿ, ਬਰਤ ਅਰੁ ਭੇਦਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 106.545,
      "end_time": 113.085,
      "transcript": "ਸਾਸਤ ਸਿੰਮ੍ਰਿਤਿ, ਬਿਨਸਹਿਗੇ ਬੇਦਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 113.085,
      "end_time": 119.395,
      "transcript": "ਤੀਰਥ ਦੇਵ, ਦੇਹੁਰਾ ਪੋਥੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 119.395,
      "end_time": 126.0,
      "transcript": "ਮਾਲਾ ਤਿਲਕੁ, ਸੋਚ ਪਾਕ ਹੋਤੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 126.0,
      "end_time": 132.345,
      "transcript": "ਧੋਤੀ ਡੰਡਉਤਿ, ਪਰਸਾਦਨ ਭੋਗਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 132.345,
      "end_time": 138.305,
      "transcript": "ਗਵਨੁ ਕਰੈਗੋ, ਸਗਲੋ ਲੋਗਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 138.795,
      "end_time": 145.365,
      "transcript": "ਜਾਤਿ ਵਰਨ, ਤੁਰਕ ਅਰੁ ਹਿੰਦੂ"
    },
    {
      "section_id": "section-00021",
      "start_time": 145.365,
      "end_time": 151.765,
      "transcript": "ਪਸੁ ਪੰਖੀ, ਅਨਿਕ ਜੋਨਿ ਜਿੰਦੂ"
    },
    {
      "section_id": "section-00022",
      "start_time": 151.765,
      "end_time": 158.175,
      "transcript": "ਸਗਲ ਪਾਸਾਰੁ, ਦੀਸੈ ਪਾਸਾਰਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 158.175,
      "end_time": 164.375,
      "transcript": "ਬਿਨਸਿ ਜਾਇਗੋ, ਸਗਲ ਆਕਾਰਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 171.075,
      "end_time": 177.235,
      "transcript": "ਸਹਜ ਸਿਫਤਿ ਭਗਤਿ, ਤਤੁ ਗਿਆਨਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 177.615,
      "end_time": 183.96,
      "transcript": "ਸਦਾ ਅਨੰਦੁ, ਨਿਹਚਲੁ ਸਚੁ ਥਾਨਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 183.96,
      "end_time": 190.76,
      "transcript": "ਤਹਾ ਸੰਗਤਿ, ਸਾਧ ਗੁਣ ਰਸੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 190.76,
      "end_time": 197.2,
      "transcript": "ਅਨਭਉ ਨਗਰੁ, ਤਹਾ ਸਦ ਵਸੈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 197.2,
      "end_time": 203.385,
      "transcript": "ਤਹ ਭਉ ਭਰਮਾ, ਸੋਗੁ ਨ ਚਿੰਤਾ"
    },
    {
      "section_id": "section-00029",
      "start_time": 203.685,
      "end_time": 210.16,
      "transcript": "ਆਵਣੁ ਜਾਵਣੁ, ਮਿਰਤੁ ਨ ਹੋਤਾ"
    },
    {
      "section_id": "section-00030",
      "start_time": 210.16,
      "end_time": 216.68,
      "transcript": "ਤਹ ਸਦਾ ਅਨੰਦ, ਅਨਹਤ ਆਖਾਰੇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 216.68,
      "end_time": 222.595,
      "transcript": "ਭਗਤ ਵਸਹਿ, ਕੀਰਤਨ ਆਧਾਰੇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 223.2,
      "end_time": 229.68,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਕਾ, ਅੰਤੁ ਨ ਪਾਰੁ"
    },
    {
      "section_id": "section-00033",
      "start_time": 229.68,
      "end_time": 236.12,
      "transcript": "ਕਉਣੁ ਕਰੈ, ਤਾ ਕਾ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00034",
      "start_time": 236.12,
      "end_time": 242.43,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਿਸੁ ਕਿਰਪਾ ਕਰੈ"
    },
    {
      "section_id": "section-00035",
      "start_time": 242.43,
      "end_time": 248.938,
      "transcript": "ਨਿਹਚਲ ਥਾਨੁ, ਸਾਧਸੰਗਿ ਤਰੈ"
    },
    {
      "section_id": "section-00036",
      "start_time": 248.938,
      "end_time": 255.347,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਿਸੁ ਕਿਰਪਾ ਕਰੈ"
    },
    {
      "section_id": "section-00037",
      "start_time": 255.347,
      "end_time": 262.455,
      "transcript": "ਨਿਹਚਲ ਥਾਨੁ, ਸਾਧਸੰਗਿ ਤਰੈ"
    }
  ]
}

{
  "audio_file": "0120 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.104,
      "end_time": 17.757,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 34.097,
      "end_time": 41.96,
      "transcript": "ਗੁਰ ਤੇ ਗਿਆਨੁ ਪਾਏ ਜਨੁ ਕੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 41.96,
      "end_time": 49.28,
      "transcript": "ਗੁਰ ਤੇ ਬੂਝੈ ਸੀਝੈ ਸੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 49.28,
      "end_time": 56.52,
      "transcript": "ਗੁਰ ਤੇ ਸਹਜੁ ਸਾਚੁ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 56.52,
      "end_time": 64.124,
      "transcript": "ਗੁਰ ਤੇ ਪਾਏ ਮੁਕਤਿ ਦੁਆਰੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 71.0,
      "end_time": 78.08,
      "transcript": "ਪੂਰੈ ਭਾਗਿ, ਮਿਲੈ ਗੁਰੁ ਆਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 78.08,
      "end_time": 86.901,
      "transcript": "ਸਾਚੈ ਸਹਜਿ ਸਾਚਿ ਸਮਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 92.16,
      "end_time": 99.28,
      "transcript": "ਗੁਰਿ ਮਿਲਿਐ ਤ੍ਰਿਸਨਾ ਅਗਨਿ ਬੁਝਾਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 99.28,
      "end_time": 106.32,
      "transcript": "ਗੁਰ ਤੇ ਸਾਂਤਿ ਵਸੈ ਮਨਿ ਆਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 106.32,
      "end_time": 113.4,
      "transcript": "ਗੁਰ ਤੇ ਪਵਿਤ ਪਾਵਨ ਸੁਚਿ ਹੋਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 113.4,
      "end_time": 120.763,
      "transcript": "ਗੁਰ ਤੇ ਸਬਦਿ ਮਿਲਾਵਾ ਹੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 127.6,
      "end_time": 134.68,
      "transcript": "ਬਾਝੁ ਗੁਰੂ, ਸਭ ਭਰਮਿ ਭੁਲਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 134.68,
      "end_time": 141.407,
      "transcript": "ਬਿਨੁ ਨਾਵੈ, ਬਹੁਤਾ ਦੁਖੁ ਪਾਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 141.407,
      "end_time": 148.72,
      "transcript": "ਗੁਰਮੁਖਿ ਹੋਵੈ ਸੁ ਨਾਮੁ ਧਿਆਈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 148.72,
      "end_time": 156.273,
      "transcript": "ਦਰਸਨਿ ਸਚੈ, ਸਚੀ ਪਤਿ ਹੋਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 162.8,
      "end_time": 169.88,
      "transcript": "ਕਿਸ ਨੋ ਕਹੀਐ, ਦਾਤਾ ਇਕੁ ਸੋਈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 169.88,
      "end_time": 176.88,
      "transcript": "ਕਿਰਪਾ ਕਰੇ, ਸਬਦਿ ਮਿਲਾਵਾ ਹੋਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 176.88,
      "end_time": 183.805,
      "transcript": "ਮਿਲਿ ਪ੍ਰੀਤਮ, ਸਾਚੇ ਗੁਣ ਗਾਵਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 183.805,
      "end_time": 191.557,
      "transcript": "ਨਾਨਕ ਸਾਚੇ ਸਾਚਿ ਸਮਾਵਾ"
    }
  ]
}

{
  "audio_file": "0239 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.205,
      "end_time": 7.21,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.2,
      "end_time": 21.2,
      "transcript": "ਗਰਭ ਵਾਸ ਮਹਿ, ਕੁਲੁ ਨਹੀ ਜਾਤੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.2,
      "end_time": 28.171,
      "transcript": "ਬ੍ਰਹਮ ਬਿੰਦੁ ਤੇ, ਸਭ ਉਤਪਾਤੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.171,
      "end_time": 35.37,
      "transcript": "ਕਹੁ ਰੇ ਪੰਡਿਤ, ਬਾਮਨ ਕਬ ਕੇ ਹੋਏ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.37,
      "end_time": 42.66,
      "transcript": "ਬਾਮਨ ਕਹਿ ਕਹਿ, ਜਨਮੁ ਮਤ ਖੋਏ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.092,
      "end_time": 56.51,
      "transcript": "ਜੌ ਤੂੰ ਬ੍ਰਾਹਮਣੁ, ਬ੍ਰਹਮਣੀ ਜਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.51,
      "end_time": 63.49,
      "transcript": "ਤਉ ਆਨ ਬਾਟ, ਕਾਹੇ ਨਹੀ ਆਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.49,
      "end_time": 70.535,
      "transcript": "ਤੁਮ ਕਤ ਬ੍ਰਾਹਮਣ, ਹਮ ਕਤ ਸੂਦ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.535,
      "end_time": 77.215,
      "transcript": "ਹਮ ਕਤ ਲੋਹੂ, ਤੁਮ ਕਤ ਦੂਧ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.68,
      "end_time": 84.56,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਜੋ ਬ੍ਰਹਮੁ ਬੀਚਾਰੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.56,
      "end_time": 90.945,
      "transcript": "ਸੋ ਬ੍ਰਾਹਮਣੁ, ਕਹੀਅਤੁ ਹੈ ਹਮਾਰੈ"
    }
  ]
}

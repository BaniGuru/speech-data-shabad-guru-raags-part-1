{
  "audio_file": "0152 C PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.12,
      "end_time": 6.215,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.56,
      "end_time": 18.675,
      "transcript": "ਉਦਮੁ ਕਰਤ, ਸੀਤਲ ਮਨ ਭਏ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.675,
      "end_time": 24.915,
      "transcript": "ਮਾਰਗਿ ਚਲਤ, ਸਗਲ ਦੁਖ ਗਏ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.915,
      "end_time": 30.855,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਮਨਿ ਭਏ ਅਨੰਦ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.245,
      "end_time": 37.945,
      "transcript": "ਰਸਿ ਗਾਏ, ਗੁਨ ਪਰਮਾਨੰਦ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.84,
      "end_time": 49.685,
      "transcript": "ਖੇਮ ਭਇਆ, ਕੁਸਲ ਘਰਿ ਆਏ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.16,
      "end_time": 57.745,
      "transcript": "ਭੇਟਤ ਸਾਧਸੰਗਿ, ਗਈ ਬਲਾਏ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 65.695,
      "end_time": 72.04,
      "transcript": "ਨੇਤ੍ਰ ਪੁਨੀਤ, ਪੇਖਤ ਹੀ ਦਰਸ"
    },
    {
      "section_id": "section-00009",
      "start_time": 72.04,
      "end_time": 78.535,
      "transcript": "ਧਨਿ ਮਸਤਕ, ਚਰਨ ਕਮਲ ਹੀ ਪਰਸ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.542,
      "end_time": 91.0,
      "transcript": "ਗੋਬਿੰਦ ਕੀ ਟਹਲ, ਸਫਲ ਇਹ ਕਾਂਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.0,
      "end_time": 97.395,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਪਰਮ ਪਦੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 103.485,
      "end_time": 109.92,
      "transcript": "ਜਨ ਕੀ, ਕੀਨੀ ਆਪਿ ਸਹਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 109.92,
      "end_time": 116.335,
      "transcript": "ਸੁਖੁ ਪਾਇਆ, ਲਗਿ ਦਾਸਹ ਪਾਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 122.735,
      "end_time": 128.83,
      "transcript": "ਆਪੁ ਗਇਆ, ਤਾ ਆਪਹਿ ਭਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 128.83,
      "end_time": 135.235,
      "transcript": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ ਕੀ, ਸਰਨੀ ਪਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 141.44,
      "end_time": 147.765,
      "transcript": "ਜੋ ਚਾਹਤ, ਸੋਈ ਜਬ ਪਾਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 147.765,
      "end_time": 154.325,
      "transcript": "ਤਬ ਢੂੰਢਨ, ਕਹਾ ਕੋ ਜਾਇਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 160.469,
      "end_time": 166.8,
      "transcript": "ਅਸਥਿਰ ਭਏ, ਬਸੇ ਸੁਖ ਆਸਨ"
    },
    {
      "section_id": "section-00019",
      "start_time": 166.8,
      "end_time": 172.88,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਨਾਨਕ ਸੁਖ ਬਾਸਨ"
    }
  ]
}

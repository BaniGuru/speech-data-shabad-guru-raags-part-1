      "end_time": 7.546,
      "transcript": "ਗਉੜੀ ਚੇਤੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.48,
      "end_time": 22.821,
      "transcript": "ਕਤ ਕੀ ਮਾਈ ਬਾਪੁ ਕਤ ਕੇਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.821,
      "end_time": 30.68,
      "transcript": "ਕਿਦੂ ਥਾਵਹੁ ਹਮ ਆਏ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.68,
      "end_time": 37.967,
      "transcript": "ਅਗਨਿ ਬਿੰਬ ਜਲ ਭੀਤਰਿ ਨਿਪਜੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.967,
      "end_time": 45.779,
      "transcript": "ਕਾਹੇ ਕੰਮਿ ਉਪਾਏ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.779,
      "end_time": 53.209,
      "transcript": "ਮੇਰੇ ਸਾਹਿਬਾ, ਕਉਣੁ ਜਾਣੈ ਗੁਣ ਤੇਰੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.209,
      "end_time": 61.684,
      "transcript": "ਕਹੇ ਨ ਜਾਨੀ, ਅਉਗਣ ਮੇਰੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.92,
      "end_time": 76.153,
      "transcript": "ਕੇਤੇ ਰੁਖ ਬਿਰਖ ਹਮ ਚੀਨੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.48,
      "end_time": 84.041,
      "transcript": "ਕੇਤੇ ਪਸੂ ਉਪਾਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.041,
      "end_time": 91.64,
      "transcript": "ਕੇਤੇ ਨਾਗ ਕੁਲੀ ਮਹਿ ਆਏ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.64,
      "end_time": 99.1,
      "transcript": "ਕੇਤੇ ਪੰਖ ਉਡਾਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 99.1,
      "end_time": 106.92,
      "transcript": "ਹਟ ਪਟਣ ਬਿਜ ਮੰਦਰ ਭੰਨੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 106.92,
      "end_time": 114.044,
      "transcript": "ਕਰਿ ਚੋਰੀ ਘਰਿ ਆਵੈ"

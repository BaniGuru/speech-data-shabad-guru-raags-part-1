    {
      "section_id": "section-00014",
      "start_time": 114.044,
      "end_time": 121.796,
      "transcript": "ਅਗਹੁ ਦੇਖੈ ਪਿਛਹੁ ਦੇਖੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 121.796,
      "end_time": 129.092,
      "transcript": "ਤੁਝ ਤੇ ਕਹਾ ਛਪਾਵੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 129.092,
      "end_time": 136.96,
      "transcript": "ਤਟ ਤੀਰਥ ਹਮ ਨਵ ਖੰਡ ਦੇਖੇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 136.96,
      "end_time": 144.37,
      "transcript": "ਹਟ ਪਟਣ ਬਾਜਾਰਾ"

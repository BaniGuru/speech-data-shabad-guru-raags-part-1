{
  "audio_file": "0154 E PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.075,
      "end_time": 7.585,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਪੂਰਬੀ₁ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.585,
      "end_time": 15.085,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.84,
      "end_time": 30.195,
      "transcript": "ਕਿਨ ਬਿਧਿ ਮਿਲੈ ਗੁਸਾਈ, ਮੇਰੇ ਰਾਮ ਰਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.195,
      "end_time": 37.485,
      "transcript": "ਕੋਈ ਐਸਾ ਸੰਤੁ ਸਹਜ ਸੁਖਦਾਤਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.12,
      "end_time": 45.535,
      "transcript": "ਮੋਹਿ ਮਾਰਗੁ ਦੇਇ ਬਤਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.32,
      "end_time": 60.764,
      "transcript": "ਅੰਤਰਿ ਅਲਖੁ ਨ ਜਾਈ ਲਖਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.764,
      "end_time": 67.885,
      "transcript": "ਵਿਚਿ ਪੜਦਾ ਹਉਮੈ ਪਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.315,
      "end_time": 75.465,
      "transcript": "ਮਾਇਆ ਮੋਹਿ ਸਭੋ ਜਗੁ ਸੋਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.0,
      "end_time": 82.995,
      "transcript": "ਇਹੁ ਭਰਮੁ ਕਹਹੁ ਕਿਉ ਜਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.56,
      "end_time": 90.675,
      "transcript": "ਏਕਾ ਸੰਗਤਿ ਇਕਤੁ ਗ੍ਰਿਹਿ ਬਸਤੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.16,
      "end_time": 98.005,
      "transcript": "ਮਿਲਿ ਬਾਤ ਨ ਕਰਤੇ ਭਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 98.64,
      "end_time": 105.545,
      "transcript": "ਏਕ ਬਸਤੁ ਬਿਨੁ ਪੰਚ ਦੁਹੇਲੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 106.0,
      "end_time": 112.935,
      "transcript": "ਓਹ ਬਸਤੁ ਅਗੋਚਰ ਠਾਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 113.52,
      "end_time": 120.555,
      "transcript": "ਜਿਸ ਕਾ ਗ੍ਰਿਹੁ ਤਿਨਿ ਦੀਆ ਤਾਲਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 121.04,
      "end_time": 127.945,
      "transcript": "ਕੁੰਜੀ ਗੁਰ ਸਉਪਾਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 128.56,
      "end_time": 135.535,
      "transcript": "ਅਨਿਕ ਉਪਾਵ ਕਰੇ ਨਹੀ ਪਾਵੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 136.04,
      "end_time": 143.005,
      "transcript": "ਬਿਨੁ ਸਤਿਗੁਰ ਸਰਣਾਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 143.48,
      "end_time": 150.855,
      "transcript": "ਜਿਨ ਕੇ ਬੰਧਨ ਕਾਟੇ ਸਤਿਗੁਰ"
    },
    {
      "section_id": "section-00019",
      "start_time": 150.855,
      "end_time": 157.715,
      "transcript": "ਤਿਨ ਸਾਧਸੰਗਤਿ ਲਿਵ ਲਾਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 158.32,
      "end_time": 165.315,
      "transcript": "ਪੰਚ ਜਨਾ ਮਿਲਿ ਮੰਗਲੁ ਗਾਇਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 165.8,
      "end_time": 172.755,
      "transcript": "ਹਰਿ ਨਾਨਕ ਭੇਦੁ ਨ ਭਾਈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 173.24,
      "end_time": 180.335,
      "transcript": "ਮੇਰੇ ਰਾਮ ਰਾਇ, ਇਨ ਬਿਧਿ ਮਿਲੈ ਗੁਸਾਈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 180.76,
      "end_time": 187.695,
      "transcript": "ਸਹਜੁ ਭਇਆ ਭ੍ਰਮੁ ਖਿਨ ਮਹਿ ਨਾਠਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 188.2,
      "end_time": 195.58,
      "transcript": "ਮਿਲਿ ਜੋਤੀ ਜੋਤਿ ਸਮਾਈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 195.58,
      "end_time": 203.145,
      "transcript": "ਸਹਜੁ ਭਇਆ ਭ੍ਰਮੁ ਖਿਨ ਮਹਿ ਨਾਠਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 203.145,
      "end_time": 210.515,
      "transcript": "ਮਿਲਿ ਜੋਤੀ ਜੋਤਿ ਸਮਾਈ ਰਹਾਉ ਦੂਜਾ"
    }
  ]
}

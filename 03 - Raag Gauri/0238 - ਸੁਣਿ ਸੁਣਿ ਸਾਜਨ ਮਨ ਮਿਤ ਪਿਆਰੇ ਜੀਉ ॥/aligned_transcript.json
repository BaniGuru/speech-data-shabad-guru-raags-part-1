{
  "audio_file": "0164 C PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.36,
      "end_time": 7.633,
      "transcript": "ਗਉੜੀ ਮਾਝ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 18.2,
      "end_time": 25.24,
      "transcript": "ਸੁਣਿ ਸੁਣਿ ਸਾਜਨ, ਮਨ ਮਿਤ ਪਿਆਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.24,
      "end_time": 35.699,
      "transcript": "ਮਨੁ ਤਨੁ ਤੇਰਾ, ਇਹੁ ਜੀਉ ਭਿ ਵਾਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.699,
      "end_time": 42.909,
      "transcript": "ਵਿਸਰੁ ਨਾਹੀ ਪ੍ਰਭ, ਪ੍ਰਾਣ ਅਧਾਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.909,
      "end_time": 53.121,
      "transcript": "ਸਦਾ ਤੇਰੀ ਸਰਣਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 60.76,
      "end_time": 67.92,
      "transcript": "ਜਿਸੁ ਮਿਲਿਐ, ਮਨੁ ਜੀਵੈ ਭਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.92,
      "end_time": 75.0,
      "transcript": "ਗੁਰ ਪਰਸਾਦੀ, ਸੋ ਹਰਿ ਹਰਿ ਪਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.0,
      "end_time": 85.44,
      "transcript": "ਸਭ ਕਿਛੁ ਪ੍ਰਭ ਕਾ, ਪ੍ਰਭ ਕੀਆ ਜਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 85.44,
      "end_time": 95.755,
      "transcript": "ਪ੍ਰਭ ਕਉ, ਸਦ ਬਲਿ ਜਾਈ ਜੀਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 96.2,
      "end_time": 103.355,
      "transcript": "ਏਹੁ ਨਿਧਾਨੁ, ਜਪੈ ਵਡਭਾਗੀ ਜੀਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 103.355,
      "end_time": 114.24,
      "transcript": "ਨਾਮ ਨਿਰੰਜਨ, ਏਕ ਲਿਵ ਲਾਗੀ ਜੀਉ"
    },
    {
      "section_id": "section-00012",
      "start_time": 114.24,
      "end_time": 121.295,
      "transcript": "ਗੁਰੁ ਪੂਰਾ ਪਾਇਆ, ਸਭੁ ਦੁਖੁ ਮਿਟਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00013",
      "start_time": 121.295,
      "end_time": 131.967,
      "transcript": "ਆਠ ਪਹਰ, ਗੁਣ ਗਾਇਆ ਜੀਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 139.24,
      "end_time": 146.4,
      "transcript": "ਰਤਨ ਪਦਾਰਥ, ਹਰਿ ਨਾਮੁ ਤੁਮਾਰਾ ਜੀਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 146.4,
      "end_time": 153.52,
      "transcript": "ਤੂੰ ਸਚਾ ਸਾਹੁ, ਭਗਤੁ ਵਣਜਾਰਾ ਜੀਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 153.52,
      "end_time": 163.653,
      "transcript": "ਹਰਿ ਧਨੁ ਰਾਸਿ ਸਚੁ ਵਾਪਾਰਾ ਜੀਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 163.653,
      "end_time": 174.617,
      "transcript": "ਜਨ ਨਾਨਕ, ਸਦ ਬਲਿਹਾਰਾ ਜੀਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 174.762,
      "end_time": 182.0,
      "transcript": "ਹਰਿ ਧਨੁ ਰਾਸਿ ਸਚੁ ਵਾਪਾਰਾ ਜੀਉ"
    },
    {
      "section_id": "section-00019",
      "start_time": 182.0,
      "end_time": 193.035,
      "transcript": "ਜਨ ਨਾਨਕ, ਸਦ ਬਲਿਹਾਰਾ ਜੀਉ"
    }
  ]

{
  "audio_file": "0183 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.075,
      "end_time": 6.995,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 7.455,
      "end_time": 15.965,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.865,
      "end_time": 29.215,
      "transcript": "ਨਾਰਾਇਣ, ਹਰਿ ਰੰਗ ਰੰਗੋ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.215,
      "end_time": 36.652,
      "transcript": "ਜਪਿ ਜਿਹਵਾ, ਹਰਿ ਏਕ ਮੰਗੋ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.96,
      "end_time": 51.005,
      "transcript": "ਤਜਿ ਹਉਮੈ, ਗੁਰ ਗਿਆਨ ਭਜੋ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.235,
      "end_time": 58.275,
      "transcript": "ਮਿਲਿ ਸੰਗਤਿ, ਧੁਰਿ ਕਰਮ ਲਿਖਿਓ"
    },
    {
      "section_id": "section-00007",
      "start_time": 58.555,
      "end_time": 65.465,
      "transcript": "ਜੋ ਦੀਸੈ, ਸੋ ਸੰਗਿ ਨ ਗਇਓ"
    },
    {
      "section_id": "section-00008",
      "start_time": 65.84,
      "end_time": 72.936,
      "transcript": "ਸਾਕਤੁ ਮੂੜੁ ਲਗੇ, ਪਚਿ ਮੁਇਓ"
    },
    {
      "section_id": "section-00009",
      "start_time": 72.936,
      "end_time": 80.265,
      "transcript": "ਮੋਹਨ ਨਾਮੁ, ਸਦਾ ਰਵਿ ਰਹਿਓ"
    },
    {
      "section_id": "section-00010",
      "start_time": 80.265,
      "end_time": 87.44,
      "transcript": "ਕੋਟਿ ਮਧੇ, ਕਿਨੈ ਗੁਰਮੁਖਿ ਲਹਿਓ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.44,
      "end_time": 94.439,
      "transcript": "ਹਰਿ ਸੰਤਨ, ਕਰਿ ਨਮੋ ਨਮੋ"
    },
    {
      "section_id": "section-00012",
      "start_time": 94.439,
      "end_time": 101.837,
      "transcript": "ਨਉ ਨਿਧਿ ਪਾਵਹਿ, ਅਤੁਲੁ ਸੁਖੋ"
    },
    {
      "section_id": "section-00013",
      "start_time": 101.837,
      "end_time": 109.036,
      "transcript": "ਨੈਨ ਅਲੋਵਉ, ਸਾਧ ਜਨੋ"
    },
    {
      "section_id": "section-00014",
      "start_time": 109.036,
      "end_time": 116.197,
      "transcript": "ਹਿਰਦੈ ਗਾਵਹੁ, ਨਾਮ ਨਿਧੋ"
    },
    {
      "section_id": "section-00015",
      "start_time": 116.197,
      "end_time": 123.509,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ ਲੋਭੁ ਮੋਹੁ ਤਜੋ"
    },
    {
      "section_id": "section-00016",
      "start_time": 123.509,
      "end_time": 130.864,
      "transcript": "ਜਨਮ ਮਰਨ ਦੁਹੁ ਤੇ ਰਹਿਓ"
    },
    {
      "section_id": "section-00017",
      "start_time": 138.0,
      "end_time": 145.2,
      "transcript": "ਦੂਖੁ ਅੰਧੇਰਾ, ਘਰ ਤੇ ਮਿਟਿਓ"
    },
    {
      "section_id": "section-00018",
      "start_time": 145.2,
      "end_time": 152.52,
      "transcript": "ਗੁਰਿ ਗਿਆਨੁ ਦ੍ਰਿੜਾਇਓ, ਦੀਪ ਬਲਿਓ"
    },
    {
      "section_id": "section-00019",
      "start_time": 152.52,
      "end_time": 159.56,
      "transcript": "ਜਿਨਿ ਸੇਵਿਆ, ਸੋ ਪਾਰਿ ਪਰਿਓ"
    },
    {
      "section_id": "section-00020",
      "start_time": 159.56,
      "end_time": 166.688,
      "transcript": "ਜਨ ਨਾਨਕ, ਗੁਰਮੁਖਿ ਜਗਤੁ ਤਰਿਓ"
    }
  ]
}

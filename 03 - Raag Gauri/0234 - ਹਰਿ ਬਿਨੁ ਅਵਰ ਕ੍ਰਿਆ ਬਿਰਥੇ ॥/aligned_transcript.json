{
  "audio_file": "0163 C PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.065,
      "end_time": 7.465,
      "transcript": "ਗਉੜੀ ਮਾਲਾ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.12,
      "end_time": 22.485,
      "transcript": "ਹਰਿ ਬਿਨੁ, ਅਵਰ ਕ੍ਰਿਆ ਬਿਰਥੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.485,
      "end_time": 30.065,
      "transcript": "ਜਪ ਤਪ ਸੰਜਮ ਕਰਮ ਕਮਾਣੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.065,
      "end_time": 37.606,
      "transcript": "ਇਹਿ ਓਰੈ ਮੂਸੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.96,
      "end_time": 52.42,
      "transcript": "ਬਰਤ ਨੇਮ ਸੰਜਮ ਮਹਿ ਰਹਤਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.42,
      "end_time": 59.585,
      "transcript": "ਤਿਨ ਕਾ ਆਢੁ ਨ ਪਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.585,
      "end_time": 67.24,
      "transcript": "ਆਗੈ ਚਲਣੁ ਅਉਰੁ ਹੈ ਭਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.24,
      "end_time": 74.578,
      "transcript": "ਊਂਹਾ ਕਾਮਿ ਨ ਆਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 74.578,
      "end_time": 81.895,
      "transcript": "ਤੀਰਥਿ ਨਾਇ ਅਰੁ ਧਰਨੀ ਭ੍ਰਮਤਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.055,
      "end_time": 89.335,
      "transcript": "ਆਗੈ ਠਉਰ ਨ ਪਾਵੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 89.52,
      "end_time": 97.055,
      "transcript": "ਊਹਾ ਕਾਮਿ ਨ ਆਵੈ ਇਹ ਬਿਧਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.055,
      "end_time": 104.435,
      "transcript": "ਓਹੁ ਲੋਗਨ ਹੀ ਪਤੀਆਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 104.435,
      "end_time": 111.875,
      "transcript": "ਚਤੁਰ ਬੇਦ ਮੁਖ ਬਚਨੀ ਉਚਰੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 111.875,
      "end_time": 119.099,
      "transcript": "ਆਗੈ ਮਹਲੁ ਨ ਪਾਈਐ"
    },
    {
      "section_id": "section-00015",
      "start_time": 119.099,
      "end_time": 126.94,
      "transcript": "ਬੂਝੈ ਨਾਹੀ ਏਕੁ ਸੁਧਾਖਰੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 126.94,
      "end_time": 134.292,
      "transcript": "ਓਹੁ ਸਗਲੀ ਝਾਖ ਝਖਾਈਐ"
    },
    {
      "section_id": "section-00017",
      "start_time": 134.292,
      "end_time": 141.805,
      "transcript": "ਨਾਨਕੁ ਕਹਤੋ ਇਹੁ ਬੀਚਾਰਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 141.805,
      "end_time": 149.275,
      "transcript": "ਜਿ ਕਮਾਵੈ ਸੁ ਪਾਰ ਗਰਾਮੀ"
    },
    {
      "section_id": "section-00019",
      "start_time": 149.275,
      "end_time": 156.86,
      "transcript": "ਗੁਰੁ ਸੇਵਹੁ ਅਰੁ ਨਾਮੁ ਧਿਆਵਹੁ"
    },
    {
      "section_id": "section-00020",
      "start_time": 156.86,
      "end_time": 163.805,
      "transcript": "ਤਿਆਗਹੁ ਮਨਹੁ ਗੁਮਾਨੀ"
    }
  ]
}

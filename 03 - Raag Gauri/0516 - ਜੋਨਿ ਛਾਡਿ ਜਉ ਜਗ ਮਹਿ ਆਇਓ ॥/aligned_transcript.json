{
  "audio_file": "0249 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.035,
      "end_time": 13.786,
      "transcript": "ਗਉੜੀ ਨੌਵੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 30.225,
      "end_time": 36.675,
      "transcript": "ਜੋਨਿ ਛਾਡਿ, ਜਉ ਜਗ ਮਹਿ ਆਇਓ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.675,
      "end_time": 43.085,
      "transcript": "ਲਾਗਤ ਪਵਨ, ਖਸਮੁ ਬਿਸਰਾਇਓ"
    },
    {
      "section_id": "section-00004",
      "start_time": 43.085,
      "end_time": 52.125,
      "transcript": "ਜੀਅਰਾ, ਹਰਿ ਕੇ ਗੁਨਾ ਗਾਉ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 59.12,
      "end_time": 65.52,
      "transcript": "ਗਰਭ ਜੋਨਿ ਮਹਿ, ਉਰਧ ਤਪੁ ਕਰਤਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 65.52,
      "end_time": 71.345,
      "transcript": "ਤਉ ਜਠਰ ਅਗਨਿ ਮਹਿ, ਰਹਤਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 71.84,
      "end_time": 78.025,
      "transcript": "ਲਖ ਚਉਰਾਸੀਹ ਜੋਨਿ, ਭ੍ਰਮਿ ਆਇਓ"
    },
    {
      "section_id": "section-00008",
      "start_time": 78.025,
      "end_time": 84.36,
      "transcript": "ਅਬ ਕੇ ਛੁਟਕੇ, ਠਉਰ ਨ ਠਾਇਓ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.36,
      "end_time": 90.48,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਭਜੁ ਸਾਰਿਗਪਾਨੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.48,
      "end_time": 96.365,
      "transcript": "ਆਵਤ ਦੀਸੈ, ਜਾਤ ਨ ਜਾਨੀ"
    }
  ]
}

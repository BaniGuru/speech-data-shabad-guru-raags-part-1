{
  "audio_file": "0135 APb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.023,
      "end_time": 14.661,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.661,
      "end_time": 22.916,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 41.8,
      "end_time": 49.155,
      "transcript": "ਅਨਿਕ ਜਤਨ, ਨਹੀ ਹੋਤ ਛੁਟਾਰਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 49.155,
      "end_time": 56.76,
      "transcript": "ਬਹੁਤੁ ਸਿਆਣਪ, ਆਗਲ ਭਾਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 57.08,
      "end_time": 64.64,
      "transcript": "ਹਰਿ ਕੀ ਸੇਵਾ, ਨਿਰਮਲ ਹੇਤ"
    },
    {
      "section_id": "section-00006",
      "start_time": 64.64,
      "end_time": 71.91,
      "transcript": "ਪ੍ਰਭ ਕੀ ਦਰਗਹ, ਸੋਭਾ ਸੇਤ"
    },
    {
      "section_id": "section-00007",
      "start_time": 71.91,
      "end_time": 79.76,
      "transcript": "ਮਨ ਮੇਰੇ ਗਹੁ, ਹਰਿ ਨਾਮ ਕਾ ਓਲਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 79.92,
      "end_time": 91.17,
      "transcript": "ਤੁਝੈ ਨ ਲਾਗੈ ਤਾਤਾ ਝੋਲਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 99.04,
      "end_time": 106.6,
      "transcript": "ਜਿਉ ਬੋਹਿਥੁ, ਭੈ ਸਾਗਰ ਮਾਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 106.6,
      "end_time": 113.743,
      "transcript": "ਅੰਧਕਾਰ, ਦੀਪਕ ਦੀਪਾਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 114.16,
      "end_time": 121.345,
      "transcript": "ਅਗਨਿ ਸੀਤ ਕਾ, ਲਾਹਸਿ ਦੂਖ"
    },
    {
      "section_id": "section-00012",
      "start_time": 121.345,
      "end_time": 128.59,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਮਨਿ ਹੋਵਤ ਸੂਖ"
    },
    {
      "section_id": "section-00013",
      "start_time": 129.12,
      "end_time": 136.56,
      "transcript": "ਉਤਰਿ ਜਾਇ, ਤੇਰੇ ਮਨ ਕੀ ਪਿਆਸ"
    },
    {
      "section_id": "section-00014",
      "start_time": 136.64,
      "end_time": 143.75,
      "transcript": "ਪੂਰਨ ਹੋਵੈ, ਸਗਲੀ ਆਸ"
    },
    {
      "section_id": "section-00015",
      "start_time": 143.75,
      "end_time": 151.32,
      "transcript": "ਡੋਲੈ ਨਾਹੀ, ਤੁਮਰਾ ਚੀਤੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 151.32,
      "end_time": 158.598,
      "transcript": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ, ਜਪਿ ਗੁਰਮੁਖਿ ਮੀਤ"
    },
    {
      "section_id": "section-00017",
      "start_time": 158.598,
      "end_time": 166.061,
      "transcript": "ਨਾਮੁ ਅਉਖਧੁ, ਸੋਈ ਜਨੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 166.061,
      "end_time": 173.45,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਆਪਿ ਦਿਵਾਵੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 173.45,
      "end_time": 181.053,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਜਾ ਕੈ ਹਿਰਦੈ ਵਸੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 181.053,
      "end_time": 188.048,
      "transcript": "ਦੂਖੁ ਦਰਦੁ ਤਿਹ, ਨਾਨਕ ਨਸੈ"
    }
  ]
}

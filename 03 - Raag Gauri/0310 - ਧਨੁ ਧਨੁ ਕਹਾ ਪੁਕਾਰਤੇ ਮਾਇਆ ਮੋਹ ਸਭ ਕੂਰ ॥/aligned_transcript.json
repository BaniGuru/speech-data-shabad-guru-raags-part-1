  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.315,
      "end_time": 11.145,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.56,
      "end_time": 17.085,
      "transcript": "ਧਨੁ ਧਨੁ ਕਹਾ ਪੁਕਾਰਤੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.495,
      "end_time": 22.745,
      "transcript": "ਮਾਇਆ ਮੋਹ ਸਭ ਕੂਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.315,
      "end_time": 28.855,
      "transcript": "ਨਾਮ ਬਿਹੂਨੇ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.44,
      "end_time": 38.105,
      "transcript": "ਹੋਤ ਜਾਤ ਸਭੁ ਧੂਰ ਪਵੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.005,
      "end_time": 54.175,
      "transcript": "ਧਧਾ ਧੂਰਿ ਪੁਨੀਤ, ਤੇਰੇ ਜਨੂਆ ਧਨਿ ਤੇਊ, ਜਿਹ ਰੁਚ ਇਆ ਮਨੂਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.175,
      "end_time": 61.84,
      "transcript": "ਧਨੁ ਨਹੀ ਬਾਛਹਿ, ਸੁਰਗ ਨ ਆਛਹਿ ਅਤਿ ਪ੍ਰਿਅ ਪ੍ਰੀਤਿ, ਸਾਧ ਰਜ ਰਾਚਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.84,
      "end_time": 69.425,
      "transcript": "ਧੰਧੇ ਕਹਾ ਬਿਆਪਹਿ, ਤਾਹੂ ਜੋ ਏਕ ਛਾਡਿ, ਅਨ ਕਤਹਿ ਨ ਜਾਹੂ"
    },
    {
      "section_id": "section-00009",
      "start_time": 69.425,
      "end_time": 77.655,
      "transcript": "ਜਾ ਕੈ ਹੀਐ, ਦੀਓ ਪ੍ਰਭ ਨਾਮ ਨਾਨਕ ਸਾਧ ਪੂਰਨ ਭਗਵਾਨ"
    }
  ]
}

{
  "audio_file": "0221 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.08,
      "end_time": 2.671,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.32,
      "end_time": 18.945,
      "transcript": "ਕਰਉ ਬੰਦਨਾ ਅਨਿਕ ਵਾਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.4,
      "end_time": 26.965,
      "transcript": "ਸਰਨਿ ਪਰਉ ਹਰਿ ਰਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.32,
      "end_time": 35.24,
      "transcript": "ਭ੍ਰਮੁ ਕਟੀਐ ਨਾਨਕ ਸਾਧਸੰਗਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.24,
      "end_time": 46.965,
      "transcript": "ਦੁਤੀਆ ਭਾਉ ਮਿਟਾਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.915,
      "end_time": 59.78,
      "transcript": "ਦੁਤੀਆ ਦੁਰਮਤਿ ਦੂਰਿ ਕਰਿ, ਗੁਰ ਸੇਵਾ ਕਰਿ ਨੀਤ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.78,
      "end_time": 68.155,
      "transcript": "ਰਾਮ ਰਤਨੁ ਮਨਿ ਤਨਿ ਬਸੈ, ਤਜਿ ਕਾਮੁ ਕ੍ਰੋਧੁ ਲੋਭੁ ਮੀਤ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.4,
      "end_time": 76.63,
      "transcript": "ਮਰਣੁ ਮਿਟੈ ਜੀਵਨੁ ਮਿਲੈ, ਬਿਨਸਹਿ ਸਗਲ ਕਲੇਸ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.63,
      "end_time": 85.125,
      "transcript": "ਆਪੁ ਤਜਹੁ ਗੋਬਿੰਦ ਭਜਹੁ, ਭਾਉ ਭਗਤਿ ਪਰਵੇਸ"
    },
    {
      "section_id": "section-00010",
      "start_time": 85.125,
      "end_time": 93.362,
      "transcript": "ਲਾਭੁ ਮਿਲੈ ਤੋਟਾ ਹਿਰੈ, ਹਰਿ ਦਰਗਹ ਪਤਿਵੰਤ"
    },
    {
      "section_id": "section-00011",
      "start_time": 93.362,
      "end_time": 101.601,
      "transcript": "ਰਾਮ ਨਾਮ ਧਨੁ ਸੰਚਵੈ, ਸਾਚ ਸਾਹ ਭਗਵੰਤ"
    },
    {
      "section_id": "section-00012",
      "start_time": 101.601,
      "end_time": 110.092,
      "transcript": "ਊਠਤ ਬੈਠਤ ਹਰਿ ਭਜਹੁ, ਸਾਧੂ ਸੰਗਿ ਪਰੀਤਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 110.092,
      "end_time": 119.405,
      "transcript": "ਨਾਨਕ ਦੁਰਮਤਿ ਛੁਟਿ ਗਈ, ਪਾਰਬ੍ਰਹਮ ਬਸੇ ਚੀਤਿ"
    }
  ]
}

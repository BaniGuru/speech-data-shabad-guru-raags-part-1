{
  "audio_file": "0159 A PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.295,
      "end_time": 8.696,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਚੇਤੀ₁"
    },
    {
      "section_id": "section-00002",
      "start_time": 8.696,
      "end_time": 16.935,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.48,
      "end_time": 32.996,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 49.4,
      "end_time": 56.639,
      "transcript": "ਸੁਖੁ ਨਾਹੀ ਰੇ, ਹਰਿ ਭਗਤਿ ਬਿਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 56.639,
      "end_time": 64.16,
      "transcript": "ਜੀਤਿ ਜਨਮੁ ਇਹੁ ਰਤਨੁ ਅਮੋਲਕੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 64.16,
      "end_time": 71.765,
      "transcript": "ਸਾਧਸੰਗਤਿ ਜਪਿ ਇਕ ਖਿਨਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 78.6,
      "end_time": 85.595,
      "transcript": "ਸੁਤ ਸੰਪਤਿ, ਬਨਿਤਾ ਬਿਨੋਦ"
    },
    {
      "section_id": "section-00008",
      "start_time": 85.76,
      "end_time": 92.765,
      "transcript": "ਛੋਡਿ ਗਏ, ਬਹੁ ਲੋਗ ਭੋਗ"
    },
    {
      "section_id": "section-00009",
      "start_time": 93.0,
      "end_time": 99.966,
      "transcript": "ਹੈਵਰ ਗੈਵਰ, ਰਾਜ ਰੰਗ"
    },
    {
      "section_id": "section-00010",
      "start_time": 99.966,
      "end_time": 107.265,
      "transcript": "ਤਿਆਗਿ ਚਲਿਓ ਹੈ, ਮੂੜ ਨੰਗ"
    },
    {
      "section_id": "section-00011",
      "start_time": 114.64,
      "end_time": 121.84,
      "transcript": "ਚੋਆ ਚੰਦਨ, ਦੇਹ ਫੂਲਿਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 121.84,
      "end_time": 128.956,
      "transcript": "ਸੋ ਤਨੁ, ਧਰ ਸੰਗਿ ਰੂਲਿਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 128.956,
      "end_time": 136.44,
      "transcript": "ਮੋਹਿ ਮੋਹਿਆ, ਜਾਨੈ ਦੂਰਿ ਹੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 136.44,
      "end_time": 143.055,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਸਦਾ ਹਦੂਰਿ ਹੈ"
    }
  ]
}

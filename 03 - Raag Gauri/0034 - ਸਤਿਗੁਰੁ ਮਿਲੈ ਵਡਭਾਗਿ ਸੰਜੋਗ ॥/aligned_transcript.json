{
  "audio_file": "0122 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.2,
      "end_time": 7.519,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.48,
      "end_time": 21.228,
      "transcript": "ਸਤਿਗੁਰੁ ਮਿਲੈ, ਵਡਭਾਗਿ ਸੰਜੋਗ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.228,
      "end_time": 28.494,
      "transcript": "ਹਿਰਦੈ ਨਾਮੁ, ਨਿਤ ਹਰਿ ਰਸ ਭੋਗ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.494,
      "end_time": 35.613,
      "transcript": "ਗੁਰਮੁਖਿ ਪ੍ਰਾਣੀ, ਨਾਮੁ ਹਰਿ ਧਿਆਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.613,
      "end_time": 43.487,
      "transcript": "ਜਨਮੁ ਜੀਤਿ ਲਾਹਾ ਨਾਮੁ ਪਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.08,
      "end_time": 57.191,
      "transcript": "ਗਿਆਨੁ ਧਿਆਨੁ, ਗੁਰਸਬਦੁ ਹੈ ਮੀਠਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.191,
      "end_time": 64.16,
      "transcript": "ਗੁਰ ਕਿਰਪਾ ਤੇ, ਕਿਨੈ ਵਿਰਲੈ ਚਖਿ ਡੀਠਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.16,
      "end_time": 71.044,
      "transcript": "ਕਰਮ ਕਾਂਡ, ਬਹੁ ਕਰਹਿ ਅਚਾਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.044,
      "end_time": 78.411,
      "transcript": "ਬਿਨੁ ਨਾਵੈ, ਧ੍ਰਿਗੁ ਧ੍ਰਿਗੁ ਅਹੰਕਾਰ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.411,
      "end_time": 85.56,
      "transcript": "ਬੰਧਨਿ ਬਾਧਿਓ, ਮਾਇਆ ਫਾਸ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.56,
      "end_time": 93.26,
      "transcript": "ਜਨ ਨਾਨਕ ਛੂਟੈ, ਗੁਰ ਪਰਗਾਸ"
    }
  ]
}

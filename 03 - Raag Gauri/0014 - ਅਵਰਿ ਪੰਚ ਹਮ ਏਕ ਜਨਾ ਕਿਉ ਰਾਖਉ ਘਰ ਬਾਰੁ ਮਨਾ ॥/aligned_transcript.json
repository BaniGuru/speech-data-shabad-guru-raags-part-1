  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.8,
      "end_time": 20.729,
      "transcript": "ਗਉੜੀ ਚੇਤੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 38.64,
      "end_time": 46.204,
      "transcript": "ਅਵਰਿ ਪੰਚ ਹਮ ਏਕ ਜਨਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 46.204,
      "end_time": 54.291,
      "transcript": "ਕਿਉ ਰਾਖਉ ਘਰ ਬਾਰੁ ਮਨਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 54.291,
      "end_time": 61.845,
      "transcript": "ਮਾਰਹਿ ਲੂਟਹਿ ਨੀਤ ਨੀਤ"
    },
    {
      "section_id": "section-00005",
      "start_time": 61.845,
      "end_time": 69.828,
      "transcript": "ਕਿਸੁ ਆਗੈ ਕਰੀ ਪੁਕਾਰ ਜਨਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 69.828,
      "end_time": 77.716,
      "transcript": "ਸ੍ਰੀ ਰਾਮ ਨਾਮਾ, ਉਚਰੁ ਮਨਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 77.716,
      "end_time": 85.907,
      "transcript": "ਆਗੈ ਜਮ ਦਲੁ ਬਿਖਮੁ ਘਨਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 93.56,
      "end_time": 101.392,
      "transcript": "ਉਸਾਰਿ ਮੜੋਲੀ ਰਾਖੈ ਦੁਆਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 101.392,
      "end_time": 109.474,
      "transcript": "ਭੀਤਰਿ ਬੈਠੀ ਸਾ ਧਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 109.474,
      "end_time": 117.581,
      "transcript": "ਅੰਮ੍ਰਿਤ ਕੇਲ ਕਰੇ ਨਿਤ ਕਾਮਣਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 117.581,
      "end_time": 125.248,
      "transcript": "ਅਵਰਿ ਲੁਟੇਨਿ ਸੁ ਪੰਚ ਜਨਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 125.248,
      "end_time": 133.286,
      "transcript": "ਢਾਹਿ ਮੜੋਲੀ ਲੂਟਿਆ ਦੇਹੁਰਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 133.286,
      "end_time": 141.294,
      "transcript": "ਸਾ ਧਨ ਪਕੜੀ ਏਕ ਜਨਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 141.294,
      "end_time": 149.044,
      "transcript": "ਜਮ ਡੰਡਾ ਗਲਿ ਸੰਗਲੁ ਪੜਿਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 149.044,
      "end_time": 156.845,
      "transcript": "ਭਾਗਿ ਗਏ ਸੇ ਪੰਚ ਜਨਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 156.845,
      "end_time": 164.707,
      "transcript": "ਕਾਮਣਿ ਲੋੜੈ ਸੁਇਨਾ ਰੁਪਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 164.707,
      "end_time": 172.403,
      "transcript": "ਮਿਤ੍ਰ ਲੁੜੇਨਿ ਸੁ ਖਾਧਾਤਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 172.403,
      "end_time": 180.433,
      "transcript": "ਨਾਨਕ ਪਾਪ ਕਰੇ ਤਿਨ ਕਾਰਣਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 180.433,
      "end_time": 187.848,
      "transcript": "ਜਾਸੀ ਜਮਪੁਰਿ ਬਾਧਾਤਾ"
    }
  ]
}

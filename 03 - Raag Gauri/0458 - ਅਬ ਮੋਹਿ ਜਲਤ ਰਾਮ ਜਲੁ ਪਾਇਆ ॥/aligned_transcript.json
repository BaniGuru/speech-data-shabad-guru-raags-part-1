{
  "audio_file": "0238 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 13.984,
      "end_time": 24.033,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਭਗਤਾਂ ਕੀ ਬਾਣੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 24.033,
      "end_time": 28.69,
      "transcript": "ੴ ਸਤਿਨਾਮੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 28.887,
      "end_time": 37.451,
      "transcript": "ਕਰਤਾ ਪੁਰਖੁ ਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 37.722,
      "end_time": 47.162,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਸ੍ਰੀ ਕਬੀਰ ਜੀਉ ਕੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 47.162,
      "end_time": 53.325,
      "transcript": "ਚਉਪਦੇ ਚੌਦਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.36,
      "end_time": 69.385,
      "transcript": "ਅਬ ਮੋਹਿ ਜਲਤ, ਰਾਮ ਜਲੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 69.845,
      "end_time": 77.701,
      "transcript": "ਰਾਮ ਉਦਕਿ, ਤਨੁ ਜਲਤ ਬੁਝਾਇਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.805,
      "end_time": 92.16,
      "transcript": "ਮਨੁ ਮਾਰਣ ਕਾਰਣਿ, ਬਨ ਜਾਈਐ"
    },
    {
      "section_id": "section-00009",
      "start_time": 92.16,
      "end_time": 99.035,
      "transcript": "ਸੋ ਜਲੁ, ਬਿਨੁ ਭਗਵੰਤ ਨ ਪਾਈਐ"
    },
    {
      "section_id": "section-00010",
      "start_time": 99.64,
      "end_time": 106.525,
      "transcript": "ਜਿਹ ਪਾਵਕ, ਸੁਰਿ ਨਰ ਹੈ ਜਾਰੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 106.895,
      "end_time": 113.655,
      "transcript": "ਰਾਮ ਉਦਕਿ, ਜਨ ਜਲਤ ਉਬਾਰੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 114.2,
      "end_time": 121.56,
      "transcript": "ਭਵ ਸਾਗਰ, ਸੁਖ ਸਾਗਰ ਮਾਹੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 121.56,
      "end_time": 128.255,
      "transcript": "ਪੀਵਿ ਰਹੇ ਜਲ, ਨਿਖੁਟਤ ਨਾਹੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 128.88,
      "end_time": 135.975,
      "transcript": "ਕਹਿ ਕਬੀਰ, ਭਜੁ ਸਾਰਿੰਗਪਾਨੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 135.975,
      "end_time": 143.025,
      "transcript": "ਰਾਮ ਉਦਕਿ, ਮੇਰੀ ਤਿਖਾ ਬੁਝਾਨੀ"
    }
  ]
}

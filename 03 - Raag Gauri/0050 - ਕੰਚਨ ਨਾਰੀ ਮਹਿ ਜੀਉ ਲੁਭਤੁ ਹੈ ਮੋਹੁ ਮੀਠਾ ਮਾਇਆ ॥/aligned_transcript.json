{
  "audio_file": "0126 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.102,
      "end_time": 7.996,
      "transcript": "ਗਉੜੀ ਬੈਰਾਗਣਿ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.2,
      "end_time": 22.447,
      "transcript": "ਕੰਚਨ ਨਾਰੀ ਮਹਿ ਜੀਉ ਲੁਭਤੁ ਹੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.447,
      "end_time": 30.17,
      "transcript": "ਮੋਹੁ ਮੀਠਾ ਮਾਇਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.17,
      "end_time": 37.723,
      "transcript": "ਘਰ ਮੰਦਰ ਘੋੜੇ ਖੁਸੀ, ਮਨੁ ਅਨ ਰਸਿ ਲਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.723,
      "end_time": 45.24,
      "transcript": "ਹਰਿ ਪ੍ਰਭੁ ਚਿਤਿ ਨ ਆਵਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.4,
      "end_time": 52.87,
      "transcript": "ਕਿਉ ਛੂਟਾ ਮੇਰੇ ਹਰਿ ਰਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.87,
      "end_time": 60.703,
      "transcript": "ਮੇਰੇ ਰਾਮ, ਇਹ ਨੀਚ ਕਰਮ ਹਰਿ ਮੇਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.703,
      "end_time": 68.16,
      "transcript": "ਗੁਣਵੰਤਾ ਹਰਿ ਹਰਿ ਦਇਆਲੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.28,
      "end_time": 75.71,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਬਖਸਿ ਅਵਗਣ ਸਭਿ ਮੇਰੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.44,
      "end_time": 87.057,
      "transcript": "ਕਿਛੁ ਰੂਪੁ ਨਹੀ ਕਿਛੁ ਜਾਤਿ ਨਾਹੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.057,
      "end_time": 94.69,
      "transcript": "ਕਿਛੁ ਢੰਗੁ ਨ ਮੇਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 98.4,
      "end_time": 105.754,
      "transcript": "ਕਿਆ ਮੁਹੁ ਲੈ ਬੋਲਹ ਗੁਣ ਬਿਹੂਨ"
    },
    {
      "section_id": "section-00013",
      "start_time": 105.754,
      "end_time": 113.309,
      "transcript": "ਨਾਮੁ ਜਪਿਆ ਨ ਤੇਰਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 113.309,
      "end_time": 120.871,
      "transcript": "ਹਮ ਪਾਪੀ ਸੰਗਿ ਗੁਰ ਉਬਰੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 120.871,
      "end_time": 128.395,
      "transcript": "ਪੁੰਨੁ ਸਤਿਗੁਰ ਕੇਰਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 136.0,
      "end_time": 143.49,
      "transcript": "ਸਭੁ ਜੀਉ ਪਿੰਡੁ ਮੁਖੁ ਨਕੁ ਦੀਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 143.49,
      "end_time": 150.878,
      "transcript": "ਵਰਤਣ ਕਉ ਪਾਣੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 154.674,
      "end_time": 162.118,
      "transcript": "ਅੰਨੁ ਖਾਣਾ ਕਪੜੁ ਪੈਨਣੁ ਦੀਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 162.118,
      "end_time": 169.533,
      "transcript": "ਰਸ ਅਨਿ ਭੋਗਾਣੀ"
    },
    {
      "section_id": "section-00020",
      "start_time": 169.533,
      "end_time": 176.93,
      "transcript": "ਜਿਨਿ ਦੀਏ ਸੁ ਚਿਤਿ ਨ ਆਵਈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 177.28,
      "end_time": 184.85,
      "transcript": "ਪਸੂ ਹਉ ਕਰਿ ਜਾਣੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 192.28,
      "end_time": 199.72,
      "transcript": "ਸਭੁ ਕੀਤਾ ਤੇਰਾ ਵਰਤਦਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 199.72,
      "end_time": 207.71,
      "transcript": "ਤੂੰ ਅੰਤਰਜਾਮੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 211.04,
      "end_time": 218.613,
      "transcript": "ਹਮ ਜੰਤ ਵਿਚਾਰੇ ਕਿਆ ਕਰਹ"
    },
    {
      "section_id": "section-00025",
      "start_time": 218.613,
      "end_time": 225.87,
      "transcript": "ਸਭੁ ਖੇਲੁ ਤੁਮ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 226.0,
      "end_time": 233.401,
      "transcript": "ਜਨ ਨਾਨਕੁ ਹਾਟਿ ਵਿਹਾਝਿਆ"
    },
    {
      "section_id": "section-00027",
      "start_time": 233.401,
      "end_time": 240.28,
      "transcript": "ਹਰਿ ਗੁਲਮ ਗੁਲਾਮੀ"
    }
  ]
}

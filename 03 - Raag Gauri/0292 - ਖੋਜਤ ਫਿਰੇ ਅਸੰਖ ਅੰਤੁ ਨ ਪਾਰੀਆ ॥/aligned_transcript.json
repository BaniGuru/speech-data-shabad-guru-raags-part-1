{
  "audio_file": "0183 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 8.415,
      "end_time": 16.09,
      "transcript": "ਰਾਗੁ ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.09,
      "end_time": 26.525,
      "transcript": "ਮਾਝ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.815,
      "end_time": 40.255,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 73.84,
      "end_time": 81.105,
      "transcript": "ਖੋਜਤ ਫਿਰੇ ਅਸੰਖ"
    },
    {
      "section_id": "section-00005",
      "start_time": 81.105,
      "end_time": 88.585,
      "transcript": "ਅੰਤੁ ਨ ਪਾਰੀਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 88.865,
      "end_time": 96.115,
      "transcript": "ਸੇਈ ਹੋਏ ਭਗਤ"
    },
    {
      "section_id": "section-00007",
      "start_time": 96.415,
      "end_time": 103.795,
      "transcript": "ਜਿਨਾ ਕਿਰਪਾਰੀਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 103.965,
      "end_time": 111.635,
      "transcript": "ਹਉ ਵਾਰੀਆ, ਹਰਿ ਵਾਰੀਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 119.16,
      "end_time": 126.58,
      "transcript": "ਸੁਣਿ ਸੁਣਿ ਪੰਥੁ ਡਰਾਉ, ਬਹੁਤੁ ਭੈਹਾਰੀਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 126.58,
      "end_time": 133.865,
      "transcript": "ਮੈ ਤਕੀ ਓਟ ਸੰਤਾਹ, ਲੇਹੁ ਉਬਾਰੀਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 133.865,
      "end_time": 141.4,
      "transcript": "ਮੋਹਨ ਲਾਲ ਅਨੂਪ, ਸਰਬ ਸਾਧਾਰੀਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 141.4,
      "end_time": 148.625,
      "transcript": "ਗੁਰ ਨਿਵਿ ਨਿਵਿ ਲਾਗਉ ਪਾਇ, ਦੇਹੁ ਦਿਖਾਰੀਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 148.625,
      "end_time": 156.09,
      "transcript": "ਮੈ ਕੀਏ ਮਿਤ੍ਰ ਅਨੇਕ, ਇਕਸੁ ਬਲਿਹਾਰੀਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 156.09,
      "end_time": 163.515,
      "transcript": "ਸਭ ਗੁਣ ਕਿਸ ਹੀ ਨਾਹਿ, ਹਰਿ ਪੂਰ ਭੰਡਾਰੀਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 170.708,
      "end_time": 178.065,
      "transcript": "ਚਹੁ ਦਿਸਿ ਜਪੀਐ ਨਾਉ, ਸੂਖਿ ਸਵਾਰੀਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 178.065,
      "end_time": 185.345,
      "transcript": "ਮੈ ਆਹੀ ਓੜਿ ਤੁਹਾਰਿ, ਨਾਨਕ ਬਲਿਹਾਰੀਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 185.345,
      "end_time": 192.84,
      "transcript": "ਗੁਰਿ ਕਾਢਿਓ ਭੁਜਾ ਪਸਾਰਿ, ਮੋਹ ਕੂਪਾਰੀਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 192.84,
      "end_time": 200.015,
      "transcript": "ਮੈ ਜੀਤਿਓ ਜਨਮੁ ਅਪਾਰੁ, ਬਹੁਰਿ ਨ ਹਾਰੀਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 200.015,
      "end_time": 207.315,
      "transcript": "ਮੈ ਪਾਇਓ ਸਰਬ ਨਿਧਾਨੁ, ਅਕਥੁ ਕਥਾਰੀਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 207.315,
      "end_time": 214.575,
      "transcript": "ਹਰਿ ਦਰਗਹ ਸੋਭਾਵੰਤ, ਬਾਹ ਲੁਡਾਰੀਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 214.575,
      "end_time": 221.835,
      "transcript": "ਜਨ ਨਾਨਕ ਲਧਾ ਰਤਨੁ, ਅਮੋਲੁ ਅਪਾਰੀਆ"
    },
    {
      "section_id": "section-00022",
      "start_time": 221.835,
      "end_time": 228.845,
      "transcript": "ਗੁਰ ਸੇਵਾ ਭਉਜਲੁ ਤਰੀਐ, ਕਹਉ ਪੁਕਾਰੀਆ"
    }
  ]
}

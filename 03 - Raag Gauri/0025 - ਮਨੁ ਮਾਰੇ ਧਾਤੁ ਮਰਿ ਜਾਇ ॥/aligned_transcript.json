{
  "audio_file": "0120 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.836,
      "end_time": 11.4,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.4,
      "end_time": 18.219,
      "transcript": "ਮਨੁ ਮਾਰੇ, ਧਾਤੁ ਮਰਿ ਜਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.219,
      "end_time": 24.958,
      "transcript": "ਬਿਨੁ ਮੂਏ, ਕੈਸੇ ਹਰਿ ਪਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.958,
      "end_time": 31.627,
      "transcript": "ਮਨੁ ਮਰੈ, ਦਾਰੂ ਜਾਣੈ ਕੋਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.627,
      "end_time": 39.351,
      "transcript": "ਮਨੁ ਸਬਦਿ ਮਰੈ, ਬੂਝੈ ਜਨੁ ਸੋਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.92,
      "end_time": 51.6,
      "transcript": "ਜਿਸ ਨੋ ਬਖਸੇ ਦੇ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.6,
      "end_time": 59.741,
      "transcript": "ਗੁਰ ਪਰਸਾਦਿ ਹਰਿ ਵਸੈ ਮਨਿ ਆਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.84,
      "end_time": 71.48,
      "transcript": "ਗੁਰਮੁਖਿ ਕਰਣੀ, ਕਾਰ ਕਮਾਵੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.48,
      "end_time": 78.04,
      "transcript": "ਤਾ ਇਸੁ ਮਨ ਕੀ ਸੋਝੀ ਪਾਵੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.04,
      "end_time": 84.639,
      "transcript": "ਮਨੁ ਮੈ ਮਤੁ, ਮੈਗਲ ਮਿਕਦਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.639,
      "end_time": 91.879,
      "transcript": "ਗੁਰੁ ਅੰਕਸੁ ਮਾਰਿ, ਜੀਵਾਲਣਹਾਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.897,
      "end_time": 104.6,
      "transcript": "ਮਨੁ ਅਸਾਧੁ, ਸਾਧੈ ਜਨੁ ਕੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 104.6,
      "end_time": 111.139,
      "transcript": "ਅਚਰੁ ਚਰੈ, ਤਾ ਨਿਰਮਲੁ ਹੋਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 111.139,
      "end_time": 117.775,
      "transcript": "ਗੁਰਮੁਖਿ ਇਹੁ ਮਨੁ, ਲਇਆ ਸਵਾਰਿ"
    },
    {
      "section_id": "section-00015",
      "start_time": 117.775,
      "end_time": 124.831,
      "transcript": "ਹਉਮੈ ਵਿਚਹੁ, ਤਜੇ ਵਿਕਾਰ"
    },
    {
      "section_id": "section-00016",
      "start_time": 131.16,
      "end_time": 137.599,
      "transcript": "ਜੋ ਧੁਰਿ ਰਾਖਿਅਨੁ, ਮੇਲਿ ਮਿਲਾਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 137.599,
      "end_time": 144.222,
      "transcript": "ਕਦੇ ਨ ਵਿਛੁੜਹਿ, ਸਬਦਿ ਸਮਾਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 144.222,
      "end_time": 150.538,
      "transcript": "ਆਪਣੀ ਕਲਾ ਆਪੇ ਹੀ ਜਾਣੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 150.538,
      "end_time": 157.696,
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਨਾਮੁ ਪਛਾਣੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 163.86,
      "end_time": 172.078,
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਨਾਮੁ ਪਛਾਣੈ"
    }
  ]
}

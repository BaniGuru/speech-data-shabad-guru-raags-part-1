{
  "audio_file": "0243 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.053,
      "end_time": 6.902,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.095,
      "end_time": 19.68,
      "transcript": "ਜਿਹ ਮੁਖਿ, ਪਾਂਚਉ ਅੰਮ੍ਰਿਤ ਖਾਏ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.68,
      "end_time": 26.175,
      "transcript": "ਤਿਹ ਮੁਖ ਦੇਖਤ, ਲੂਕਟ ਲਾਏ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.32,
      "end_time": 32.335,
      "transcript": "ਇਕੁ ਦੁਖੁ, ਰਾਮ ਰਾਇ ਕਾਟਹੁ ਮੇਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.76,
      "end_time": 42.425,
      "transcript": "ਅਗਨਿ ਦਹੈ, ਅਰੁ ਗਰਭ ਬਸੇਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.045,
      "end_time": 55.565,
      "transcript": "ਕਾਇਆ ਬਿਗੂਤੀ, ਬਹੁ ਬਿਧਿ ਭਾਤੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.565,
      "end_time": 61.855,
      "transcript": "ਕੋ ਜਾਰੇ, ਕੋ ਗਡਿ ਲੇ ਮਾਟੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.115,
      "end_time": 68.6,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਹਰਿ ਚਰਣ ਦਿਖਾਵਹੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.6,
      "end_time": 74.695,
      "transcript": "ਪਾਛੈ ਤੇ ਜਮੁ, ਕਿਉ ਨ ਪਠਾਵਹੁ"
    }
  ]
}

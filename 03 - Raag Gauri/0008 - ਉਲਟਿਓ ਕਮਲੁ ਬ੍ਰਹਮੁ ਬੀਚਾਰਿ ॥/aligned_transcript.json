{
  "audio_file": "0116 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.106,
      "end_time": 6.844,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.2,
      "end_time": 21.032,
      "transcript": "ਉਲਟਿਓ ਕਮਲੁ, ਬ੍ਰਹਮੁ ਬੀਚਾਰਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.032,
      "end_time": 28.083,
      "transcript": "ਅੰਮ੍ਰਿਤ ਧਾਰ, ਗਗਨਿ ਦਸ ਦੁਆਰਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.083,
      "end_time": 35.151,
      "transcript": "ਤ੍ਰਿਭਵਣੁ ਬੇਧਿਆ, ਆਪਿ ਮੁਰਾਰਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.151,
      "end_time": 41.874,
      "transcript": "ਰੇ ਮਨ ਮੇਰੇ, ਭਰਮੁ ਨ ਕੀਜੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.874,
      "end_time": 49.31,
      "transcript": "ਮਨਿ ਮਾਨਿਐ ਅੰਮ੍ਰਿਤ ਰਸੁ ਪੀਜੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.16,
      "end_time": 63.053,
      "transcript": "ਜਨਮੁ ਜੀਤਿ, ਮਰਣਿ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.053,
      "end_time": 69.843,
      "transcript": "ਆਪਿ ਮੂਆ, ਮਨੁ ਮਨ ਤੇ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 69.843,
      "end_time": 76.829,
      "transcript": "ਨਜਰਿ ਭਈ, ਘਰੁ ਘਰ ਤੇ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.829,
      "end_time": 84.2,
      "transcript": "ਜਤੁ ਸਤੁ ਤੀਰਥੁ, ਮਜਨੁ ਨਾਮਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.2,
      "end_time": 91.068,
      "transcript": "ਅਧਿਕ ਬਿਥਾਰੁ ਕਰਉ ਕਿਸੁ ਕਾਮਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 91.068,
      "end_time": 98.016,
      "transcript": "ਨਰ ਨਾਰਾਇਣ ਅੰਤਰਜਾਮਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 98.016,
      "end_time": 105.314,
      "transcript": "ਆਨ ਮਨਉ, ਤਉ ਪਰ ਘਰ ਜਾਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 105.314,
      "end_time": 112.233,
      "transcript": "ਕਿਸੁ ਜਾਚਉ, ਨਾਹੀ ਕੋ ਥਾਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 112.233,
      "end_time": 119.07,
      "transcript": "ਨਾਨਕ ਗੁਰਮਤਿ ਸਹਜਿ ਸਮਾਉ"
    }
  ]
}

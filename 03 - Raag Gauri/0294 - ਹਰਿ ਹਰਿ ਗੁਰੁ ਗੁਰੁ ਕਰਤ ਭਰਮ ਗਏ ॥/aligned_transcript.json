  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.008,
      "end_time": 7.195,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.136,
      "end_time": 21.385,
      "transcript": "ਹਰਿ ਹਰਿ ਗੁਰੁ ਗੁਰੁ ਕਰਤ, ਭਰਮ ਗਏ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.785,
      "end_time": 29.204,
      "transcript": "ਮੇਰੈ ਮਨਿ, ਸਭਿ ਸੁਖ ਪਾਇਓ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 36.065,
      "end_time": 43.025,
      "transcript": "ਬਲਤੋ ਜਲਤੋ ਤਉਕਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.335,
      "end_time": 50.6,
      "transcript": "ਗੁਰ ਚੰਦਨੁ ਸੀਤਲਾਇਓ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.6,
      "end_time": 57.475,
      "transcript": "ਅਗਿਆਨ ਅੰਧੇਰਾ ਮਿਟਿ ਗਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.595,
      "end_time": 64.96,
      "transcript": "ਗੁਰ ਗਿਆਨੁ ਦੀਪਾਇਓ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.96,
      "end_time": 72.092,
      "transcript": "ਪਾਵਕੁ ਸਾਗਰੁ ਗਹਰੋ"
    },
    {
      "section_id": "section-00009",
      "start_time": 72.092,
      "end_time": 79.055,
      "transcript": "ਚਰਿ ਸੰਤਨ ਨਾਵ ਤਰਾਇਓ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.315,
      "end_time": 86.56,
      "transcript": "ਨਾ ਹਮ ਕਰਮ ਨ ਧਰਮ ਸੁਚ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.56,
      "end_time": 94.128,
      "transcript": "ਪ੍ਰਭਿ ਗਹਿ ਭੁਜਾ ਆਪਾਇਓ"
    },
    {
      "section_id": "section-00012",
      "start_time": 100.92,
      "end_time": 107.685,
      "transcript": "ਭਉ ਖੰਡਨੁ ਦੁਖ ਭੰਜਨੋ"
    },
    {
      "section_id": "section-00013",
      "start_time": 108.04,
      "end_time": 114.805,
      "transcript": "ਭਗਤਿ ਵਛਲ ਹਰਿ ਨਾਇਓ"
    },
    {
      "section_id": "section-00014",
      "start_time": 115.0,
      "end_time": 122.32,
      "transcript": "ਅਨਾਥਹ ਨਾਥ ਕ੍ਰਿਪਾਲ ਦੀਨ"
    },
    {
      "section_id": "section-00015",
      "start_time": 122.32,
      "end_time": 129.294,
      "transcript": "ਸੰਮ੍ਰਿਥ ਸੰਤ ਓਟਾਇਓ"
    },
    {
      "section_id": "section-00016",
      "start_time": 129.294,
      "end_time": 136.235,
      "transcript": "ਨਿਰਗੁਨੀਆਰੇ ਕੀ ਬੇਨਤੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 136.425,
      "end_time": 143.658,
      "transcript": "ਦੇਹੁ ਦਰਸੁ ਹਰਿ ਰਾਇਓ"
    },
    {
      "section_id": "section-00018",
      "start_time": 143.658,
      "end_time": 150.903,
      "transcript": "ਨਾਨਕ ਸਰਨਿ ਤੁਹਾਰੀ ਠਾਕੁਰ"
    },
    {
      "section_id": "section-00019",
      "start_time": 150.903,
      "end_time": 157.695,
      "transcript": "ਸੇਵਕੁ ਦੁਆਰੈ ਆਇਓ"
    }
  ]
}

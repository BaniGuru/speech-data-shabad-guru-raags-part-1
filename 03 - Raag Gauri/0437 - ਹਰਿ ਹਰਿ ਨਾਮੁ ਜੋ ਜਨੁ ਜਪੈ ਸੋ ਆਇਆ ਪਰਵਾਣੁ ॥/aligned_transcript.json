{
  "audio_file": "0234 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.234,
      "end_time": 13.015,
      "transcript": "ਗਉੜੀ ਕੀ ਵਾਰ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.975,
      "end_time": 23.163,
      "transcript": "ਰਾਇ ਕਮਾਲਦੀ ਮੋਜਦੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.163,
      "end_time": 33.758,
      "transcript": "ਕੀ ਵਾਰ ਕੀ ਧੁਨਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.758,
      "end_time": 43.505,
      "transcript": "ਉਪਰਿ ਗਾਵਣੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.8,
      "end_time": 57.97,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 57.97,
      "end_time": 67.625,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 78.36,
      "end_time": 86.656,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜੋ ਜਨੁ ਜਪੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 86.656,
      "end_time": 95.505,
      "transcript": "ਸੋ ਆਇਆ ਪਰਵਾਣੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 95.505,
      "end_time": 103.635,
      "transcript": "ਤਿਸੁ ਜਨ ਕੈ ਬਲਿਹਾਰਣੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 103.995,
      "end_time": 112.237,
      "transcript": "ਜਿਨਿ ਭਜਿਆ ਪ੍ਰਭੁ ਨਿਰਬਾਣੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 112.237,
      "end_time": 120.525,
      "transcript": "ਜਨਮ ਮਰਨ ਦੁਖੁ ਕਟਿਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 121.12,
      "end_time": 128.925,
      "transcript": "ਹਰਿ ਭੇਟਿਆ ਪੁਰਖੁ ਸੁਜਾਣੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 129.435,
      "end_time": 137.836,
      "transcript": "ਸੰਤ ਸੰਗਿ ਸਾਗਰੁ ਤਰੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 137.836,
      "end_time": 146.025,
      "transcript": "ਜਨ ਨਾਨਕ ਸਚਾ ਤਾਣੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 146.025,
      "end_time": 151.035,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 159.64,
      "end_time": 167.555,
      "transcript": "ਭਲਕੇ ਉਠਿ ਪਰਾਹੁਣਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 168.175,
      "end_time": 176.275,
      "transcript": "ਮੇਰੈ ਘਰਿ ਆਵਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 176.885,
      "end_time": 185.005,
      "transcript": "ਪਾਉ ਪਖਾਲਾ ਤਿਸ ਕੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 185.52,
      "end_time": 193.385,
      "transcript": "ਮਨਿ ਤਨਿ ਨਿਤ ਭਾਵਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 193.905,
      "end_time": 202.56,
      "transcript": "ਨਾਮੁ ਸੁਣੇ ਨਾਮੁ ਸੰਗ੍ਰਹੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 202.56,
      "end_time": 210.325,
      "transcript": "ਨਾਮੇ ਲਿਵ ਲਾਵਉ"
    },
    {
      "section_id": "section-00022",
      "start_time": 210.925,
      "end_time": 218.905,
      "transcript": "ਗ੍ਰਿਹੁ ਧਨੁ ਸਭੁ ਪਵਿਤ੍ਰੁ ਹੋਇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 219.48,
      "end_time": 227.265,
      "transcript": "ਹਰਿ ਕੇ ਗੁਣ ਗਾਵਉ"
    },
    {
      "section_id": "section-00024",
      "start_time": 227.84,
      "end_time": 235.945,
      "transcript": "ਹਰਿ ਨਾਮ ਵਾਪਾਰੀ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 236.275,
      "end_time": 247.325,
      "transcript": "ਵਡਭਾਗੀ ਪਾਵਉ ਪਉੜੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 257.24,
      "end_time": 266.465,
      "transcript": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸੋ ਭਲਾ, ਸਚੁ ਤੇਰਾ ਭਾਣਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 266.84,
      "end_time": 276.095,
      "transcript": "ਤੂ ਸਭ ਮਹਿ ਏਕੁ ਵਰਤਦਾ, ਸਭ ਮਾਹਿ ਸਮਾਣਾ"
    },
    {
      "section_id": "section-00028",
      "start_time": 276.48,
      "end_time": 285.615,
      "transcript": "ਥਾਨ ਥਨੰਤਰਿ ਰਵਿ ਰਹਿਆ, ਜੀਅ ਅੰਦਰਿ ਜਾਣਾ"
    },
    {
      "section_id": "section-00029",
      "start_time": 286.2,
      "end_time": 295.135,
      "transcript": "ਸਾਧਸੰਗਿ ਮਿਲਿ ਪਾਈਐ, ਮਨਿ ਸਚੇ ਭਾਣਾ"
    },
    {
      "section_id": "section-00030",
      "start_time": 295.68,
      "end_time": 305.745,
      "transcript": "ਨਾਨਕ ਪ੍ਰਭ ਸਰਣਾਗਤੀ, ਸਦ ਸਦ ਕੁਰਬਾਣਾ"
    }
  ]
}

{
  "audio_file": "0147 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.745,
      "end_time": 18.175,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 33.727,
      "end_time": 40.125,
      "transcript": "ਹਰਿ ਸਿਮਰਤ, ਸਭਿ ਮਿਟਹਿ ਕਲੇਸ"
    },
    {
      "section_id": "section-00003",
      "start_time": 40.4,
      "end_time": 46.455,
      "transcript": "ਚਰਣ ਕਮਲ, ਮਨ ਮਹਿ ਪਰਵੇਸ"
    },
    {
      "section_id": "section-00004",
      "start_time": 46.8,
      "end_time": 52.915,
      "transcript": "ਉਚਰਹੁ ਰਾਮ ਨਾਮੁ, ਲਖ ਬਾਰੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.24,
      "end_time": 62.845,
      "transcript": "ਅੰਮ੍ਰਿਤ ਰਸੁ ਪੀਵਹੁ, ਪ੍ਰਭ ਪਿਆਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 69.485,
      "end_time": 75.841,
      "transcript": "ਸੂਖ ਸਹਜ ਰਸ, ਮਹਾ ਅਨੰਦਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.841,
      "end_time": 82.155,
      "transcript": "ਜਪਿ ਜਪਿ ਜੀਵੇ, ਪਰਮਾਨੰਦਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 82.68,
      "end_time": 88.745,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ ਲੋਭ, ਮਦ ਖੋਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 89.32,
      "end_time": 95.505,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਕਿਲਬਿਖ ਸਭ ਧੋਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 95.92,
      "end_time": 102.055,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 102.425,
      "end_time": 108.355,
      "transcript": "ਨਾਨਕ ਦੀਜੈ, ਸਾਧ ਰਵਾਲਾ"
    }
  ]
}

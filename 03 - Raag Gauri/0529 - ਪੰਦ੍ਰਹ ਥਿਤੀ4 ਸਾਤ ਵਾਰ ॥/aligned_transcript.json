{
  "audio_file": "0253 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.445,
      "end_time": 6.49,
      "transcript": "ਰਾਗੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.49,
      "end_time": 22.915,
      "transcript": "ਗਉੜੀ ਥਿਤੰੀ ਕਬੀਰ ਜੀ ਕੰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.555,
      "end_time": 29.785,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 39.72,
      "end_time": 47.16,
      "transcript": "ਪੰਦ੍ਰਹ ਥਿਤੰØੀ ਸਾਤ ਵਾਰ"
    },
    {
      "section_id": "section-00005",
      "start_time": 47.16,
      "end_time": 54.56,
      "transcript": "ਕਹਿ ਕਬੀਰ, ਉਰਵਾਰ ਨ ਪਾਰ"
    },
    {
      "section_id": "section-00006",
      "start_time": 54.56,
      "end_time": 61.365,
      "transcript": "ਸਾਧਿਕ ਸਿਧ, ਲਖੈ ਜਉ ਭੇਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.775,
      "end_time": 69.0,
      "transcript": "ਆਪੇ ਕਰਤਾ, ਆਪੇ ਦੇਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 69.0,
      "end_time": 73.317,
      "transcript": "ਥਿਤੰੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 83.57,
      "end_time": 91.005,
      "transcript": "ਅੰਮਾਵਸ ਮਹਿ, ਆਸ ਨਿਵਾਰਹੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.005,
      "end_time": 98.16,
      "transcript": "ਅੰਤਰਜਾਮੀ ਰਾਮੁ ਸਮਾਰਹੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 98.16,
      "end_time": 105.44,
      "transcript": "ਜੀਵਤ ਪਾਵਹੁ ਮੋਖ ਦੁਆਰ"
    },
    {
      "section_id": "section-00012",
      "start_time": 105.44,
      "end_time": 112.68,
      "transcript": "ਅਨਭਉ ਸਬਦੁ, ਤਤੁ ਨਿਜੁ ਸਾਰ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.68,
      "end_time": 119.8,
      "transcript": "ਚਰਨ ਕਮਲ ਗੋਬਿੰਦ, ਰੰਗੁ ਲਾਗਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 119.8,
      "end_time": 126.905,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਭਏ ਮਨ ਨਿਰਮਲ"
    },
    {
      "section_id": "section-00015",
      "start_time": 126.905,
      "end_time": 137.675,
      "transcript": "ਹਰਿ ਕੀਰਤਨ ਮਹਿ ਅਨਦਿਨੁ ਜਾਗਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 148.6,
      "end_time": 155.76,
      "transcript": "ਪਰਿਵਾ, ਪ੍ਰੀਤਮ ਕਰਹੁ ਬੀਚਾਰ"
    },
    {
      "section_id": "section-00017",
      "start_time": 155.76,
      "end_time": 162.725,
      "transcript": "ਘਟ ਮਹਿ ਖੇਲੈ, ਅਘਟ ਅਪਾਰ"
    },
    {
      "section_id": "section-00018",
      "start_time": 162.725,
      "end_time": 169.535,
      "transcript": "ਕਾਲ ਕਲਪਨਾ, ਕਦੇ ਨ ਖਾਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 169.535,
      "end_time": 176.855,
      "transcript": "ਆਦਿ ਪੁਰਖ ਮਹਿ, ਰਹੈ ਸਮਾਇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 184.035,
      "end_time": 191.28,
      "transcript": "ਦੁਤੀਆ, ਦੁਹ ਕਰਿ ਜਾਨੈ ਅੰਗ"
    },
    {
      "section_id": "section-00021",
      "start_time": 191.28,
      "end_time": 198.105,
      "transcript": "ਮਾਇਆ, ਬ੍ਰਹਮ ਰਮੈ ਸਭ ਸੰਗ"
    },
    {
      "section_id": "section-00022",
      "start_time": 198.105,
      "end_time": 205.44,
      "transcript": "ਨਾ ਓਹੁ ਬਢੈ, ਨ ਘਟਤਾ ਜਾਇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 205.44,
      "end_time": 212.41,
      "transcript": "ਅਕੁਲ ਨਿਰੰਜਨ, ਏਕੈ ਭਾਇ"
    },
    {
      "section_id": "section-00024",
      "start_time": 212.41,
      "end_time": 219.375,
      "transcript": "ਤ੍ਰਿਤੀਆ, ਤੀਨੇ ਸਮ ਕਰਿ ਲਿਆਵੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 219.375,
      "end_time": 226.48,
      "transcript": "ਆਨਦ ਮੂਲ, ਪਰਮ ਪਦੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 226.48,
      "end_time": 233.305,
      "transcript": "ਸਾਧਸੰਗਤਿ, ਉਪਜੈ ਬਿਸ੍ਵਾਸ"
    },
    {
      "section_id": "section-00027",
      "start_time": 233.305,
      "end_time": 240.355,
      "transcript": "ਬਾਹਰਿ ਭੀਤਰਿ, ਸਦਾ ਪ੍ਰਗਾਸ"
    },
    {
      "section_id": "section-00028",
      "start_time": 247.395,
      "end_time": 254.48,
      "transcript": "ਚਉਥਹਿ, ਚੰਚਲ ਮਨ ਕਉ ਗਹਹੁ"
    },
    {
      "section_id": "section-00029",
      "start_time": 254.48,
      "end_time": 261.305,
      "transcript": "ਕਾਮ ਕ੍ਰੋਧ ਸੰਗਿ, ਕਬਹੁ ਨ ਬਹਹੁ"
    },
    {
      "section_id": "section-00030",
      "start_time": 261.305,
      "end_time": 268.045,
      "transcript": "ਜਲ ਥਲ ਮਾਹੇ, ਆਪਹਿ ਆਪ"
    },
    {
      "section_id": "section-00031",
      "start_time": 268.465,
      "end_time": 275.48,
      "transcript": "ਆਪੈ ਜਪਹੁ, ਆਪਨਾ ਜਾਪ"
    },
    {
      "section_id": "section-00032",
      "start_time": 275.48,
      "end_time": 282.36,
      "transcript": "ਪਾਂਚੈ, ਪੰਚ ਤਤ ਬਿਸਥਾਰ"
    },
    {
      "section_id": "section-00033",
      "start_time": 282.36,
      "end_time": 289.28,
      "transcript": "ਕਨਿਕ ਕਾਮਿਨੀ ਜੁਗ ਬਿਉਹਾਰ"
    },
    {
      "section_id": "section-00034",
      "start_time": 289.28,
      "end_time": 295.942,
      "transcript": "ਪ੍ਰੇਮ ਸੁਧਾ ਰਸੁ, ਪੀਵੈ ਕੋਇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 295.942,
      "end_time": 303.16,
      "transcript": "ਜਰਾ ਮਰਣ ਦੁਖੁ, ਫੇਰਿ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00036",
      "start_time": 303.16,
      "end_time": 310.055,
      "transcript": "ਛਠਿ, ਖਟੁ ਚਕ੍ਰ ਛਹੂੰ ਦਿਸ ਧਾਇ"
    },
    {
      "section_id": "section-00037",
      "start_time": 310.055,
      "end_time": 317.03,
      "transcript": "ਬਿਨੁ ਪਰਚੈ, ਨਹੀ ਥਿਰਾ ਰਹਾਇ"
    },
    {
      "section_id": "section-00038",
      "start_time": 317.03,
      "end_time": 324.04,
      "transcript": "ਦੁਬਿਧਾ ਮੇਟਿ, ਖਿਮਾ ਗਹਿ ਰਹਹੁ"
    },
    {
      "section_id": "section-00039",
      "start_time": 324.04,
      "end_time": 330.825,
      "transcript": "ਕਰਮ ਧਰਮ ਕੀ, ਸੂਲ ਨ ਸਹਹੁ"
    },
    {
      "section_id": "section-00040",
      "start_time": 330.825,
      "end_time": 337.875,
      "transcript": "ਸਾਤੈਂ, ਸਤਿ ਕਰਿ ਬਾਚਾ ਜਾਣਿ"
    },
    {
      "section_id": "section-00041",
      "start_time": 337.875,
      "end_time": 345.16,
      "transcript": "ਆਤਮ ਰਾਮੁ ਲੇਹੁ ਪਰਵਾਣਿ"
    },
    {
      "section_id": "section-00042",
      "start_time": 345.16,
      "end_time": 351.797,
      "transcript": "ਛੂਟੈ ਸੰਸਾ, ਮਿਟਿ ਜਾਹਿ ਦੁਖ"
    },
    {
      "section_id": "section-00043",
      "start_time": 351.797,
      "end_time": 358.955,
      "transcript": "ਸੁੰਨ ਸਰੋਵਰਿ, ਪਾਵਹੁ ਸੁਖ"
    },
    {
      "section_id": "section-00044",
      "start_time": 366.005,
      "end_time": 372.96,
      "transcript": "ਅਸਟਮੀ, ਅਸਟ ਧਾਤੁ ਕੀ ਕਾਇਆ"
    },
    {
      "section_id": "section-00045",
      "start_time": 372.96,
      "end_time": 379.825,
      "transcript": "ਤਾ ਮਹਿ, ਅਕੁਲ ਮਹਾ ਨਿਧਿ ਰਾਇਆ"
    },
    {
      "section_id": "section-00046",
      "start_time": 379.825,
      "end_time": 386.88,
      "transcript": "ਗੁਰ ਗਮ ਗਿਆਨ, ਬਤਾਵੈ ਭੇਦ"
    },
    {
      "section_id": "section-00047",
      "start_time": 386.88,
      "end_time": 393.715,
      "transcript": "ਉਲਟਾ ਰਹੈ ਅਭੰਗ ਅਛੇਦ"
    },
    {
      "section_id": "section-00048",
      "start_time": 393.715,
      "end_time": 400.675,
      "transcript": "ਨਉਮੀ, ਨਵੈ ਦੁਆਰ ਕਉ ਸਾਧਿ"
    },
    {
      "section_id": "section-00049",
      "start_time": 400.675,
      "end_time": 407.675,
      "transcript": "ਬਹਤੀ ਮਨਸਾ, ਰਾਖਹੁ ਬਾਂਧਿ"
    },
    {
      "section_id": "section-00050",
      "start_time": 407.675,
      "end_time": 414.57,
      "transcript": "ਲੋਭ ਮੋਹ ਸਭ ਬੀਸਰਿ ਜਾਹੁ"
    },
    {
      "section_id": "section-00051",
      "start_time": 414.57,
      "end_time": 421.425,
      "transcript": "ਜੁਗੁ ਜੁਗੁ ਜੀਵਹੁ, ਅਮਰ ਫਲ ਖਾਹੁ"
    },
    {
      "section_id": "section-00052",
      "start_time": 428.525,
      "end_time": 435.385,
      "transcript": "ਦਸਮੀ, ਦਹ ਦਿਸ ਹੋਇ ਅਨੰਦ"
    },
    {
      "section_id": "section-00053",
      "start_time": 435.385,
      "end_time": 442.25,
      "transcript": "ਛੂਟੈ ਭਰਮੁ, ਮਿਲੈ ਗੋਬਿੰਦ"
    },
    {
      "section_id": "section-00054",
      "start_time": 442.25,
      "end_time": 449.215,
      "transcript": "ਜੋਤਿ ਸਰੂਪੀ, ਤਤ ਅਨੂਪ"
    },
    {
      "section_id": "section-00055",
      "start_time": 449.215,
      "end_time": 456.12,
      "transcript": "ਅਮਲ ਨ ਮਲ ਨ, ਛਾਹ ਨਹੀ ਧੂਪ"
    },
    {
      "section_id": "section-00056",
      "start_time": 456.12,
      "end_time": 463.0,
      "transcript": "ਏਕਾਦਸੀ, ਏਕ ਦਿਸ ਧਾਵੈ"
    },
    {
      "section_id": "section-00057",
      "start_time": 463.0,
      "end_time": 469.735,
      "transcript": "ਤਉ ਜੋਨੀ ਸੰਕਟ, ਬਹੁਰਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00058",
      "start_time": 469.735,
      "end_time": 476.475,
      "transcript": "ਸੀਤਲ ਨਿਰਮਲ ਭਇਆ ਸਰੀਰਾ"
    },
    {
      "section_id": "section-00059",
      "start_time": 476.475,
      "end_time": 483.635,
      "transcript": "ਦੂਰਿ ਬਤਾਵਤ, ਪਾਇਆ ਨੀਰਾ"
    },
    {
      "section_id": "section-00060",
      "start_time": 490.505,
      "end_time": 497.52,
      "transcript": "ਬਾਰਸਿ, ਬਾਰਹ ਉਗਵੈ ਸੂਰ"
    },
    {
      "section_id": "section-00061",
      "start_time": 497.52,
      "end_time": 504.065,
      "transcript": "ਅਹਿਨਿਸਿ, ਬਾਜੇ ਅਨਹਦ ਤੂਰ"
    },
    {
      "section_id": "section-00062",
      "start_time": 504.065,
      "end_time": 510.96,
      "transcript": "ਦੇਖਿਆ, ਤਿਹੂੰ ਲੋਕ ਕਾ ਪੀਉ"
    },
    {
      "section_id": "section-00063",
      "start_time": 510.96,
      "end_time": 518.02,
      "transcript": "ਅਚਰਜੁ ਭਇਆ, ਜੀਵ ਤੇ ਸੀਉ"
    },
    {
      "section_id": "section-00064",
      "start_time": 518.02,
      "end_time": 524.96,
      "transcript": "ਤੇਰਸਿ, ਤੇਰਹ ਅਗਮ ਬਖਾਣਿ"
    },
    {
      "section_id": "section-00065",
      "start_time": 524.96,
      "end_time": 531.84,
      "transcript": "ਅਰਧ ਉਰਧ ਬਿਚਿ, ਸਮ ਪਹਿਚਾਣਿ"
    },
    {
      "section_id": "section-00066",
      "start_time": 531.84,
      "end_time": 538.51,
      "transcript": "ਨੀਚ ਊਚ ਨਹੀ ਮਾਨ ਅਮਾਨ"
    },
    {
      "section_id": "section-00067",
      "start_time": 538.51,
      "end_time": 545.245,
      "transcript": "ਬਿਆਪਿਕ ਰਾਮ, ਸਗਲ ਸਾਮਾਨ"
    },
    {
      "section_id": "section-00068",
      "start_time": 545.245,
      "end_time": 552.22,
      "transcript": "ਚਉਦਸਿ, ਚਉਦਹ ਲੋਕ ਮਝਾਰਿ"
    },
    {
      "section_id": "section-00069",
      "start_time": 552.22,
      "end_time": 559.08,
      "transcript": "ਰੋਮ ਰੋਮ ਮਹਿ, ਬਸਹਿ ਮੁਰਾਰਿ"
    },
    {
      "section_id": "section-00070",
      "start_time": 559.08,
      "end_time": 565.84,
      "transcript": "ਸਤ ਸੰਤੋਖ ਕਾ, ਧਰਹੁ ਧਿਆਨ"
    },
    {
      "section_id": "section-00071",
      "start_time": 565.84,
      "end_time": 572.395,
      "transcript": "ਕਥਨੀ ਕਥੀਐ, ਬ੍ਰਹਮ ਗਿਆਨ"
    },
    {
      "section_id": "section-00072",
      "start_time": 572.395,
      "end_time": 579.48,
      "transcript": "ਪੂਨਿਉ, ਪੂਰਾ ਚੰਦ ਅਕਾਸ"
    },
    {
      "section_id": "section-00073",
      "start_time": 579.48,
      "end_time": 586.255,
      "transcript": "ਪਸਰਹਿ ਕਲਾ, ਸਹਜ ਪਰਗਾਸ"
    },
    {
      "section_id": "section-00074",
      "start_time": 586.255,
      "end_time": 592.985,
      "transcript": "ਆਦਿ ਅੰਤਿ ਮਧਿ, ਹੋਇ ਰਹਿਆ ਥੀਰ"
    },
    {
      "section_id": "section-00075",
      "start_time": 592.985,
      "end_time": 599.695,
      "transcript": "ਸੁਖ ਸਾਗਰ ਮਹਿ, ਰਮਹਿ ਕਬੀਰ"
    },
    {
      "section_id": "section-00076",
      "start_time": 599.695,
      "end_time": 607.735,
      "transcript": "ਸੁਖ ਸਾਗਰ ਮਹਿ, ਰਮਹਿ ਕਬੀਰ"
    }
  ]
}

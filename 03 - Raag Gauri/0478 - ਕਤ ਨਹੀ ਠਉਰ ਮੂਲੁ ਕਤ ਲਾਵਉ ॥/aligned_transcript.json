  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.325,
      "end_time": 6.865,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.4,
      "end_time": 21.045,
      "transcript": "ਕਤ ਨਹੀ ਠਉਰ, ਮੂਲੁ ਕਤ ਲਾਵਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.045,
      "end_time": 28.075,
      "transcript": "ਖੋਜਤ ਤਨ ਮਹਿ, ਠਉਰ ਨ ਪਾਵਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.075,
      "end_time": 35.165,
      "transcript": "ਲਾਗੀ ਹੋਇ, ਸੁ ਜਾਨੈ ਪੀਰ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.605,
      "end_time": 45.846,
      "transcript": "ਰਾਮ ਭਗਤਿ, ਅਨੀਆਲੇ ਤੀਰ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.2,
      "end_time": 59.745,
      "transcript": "ਏਕ ਭਾਇ, ਦੇਖਉ ਸਭ ਨਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.28,
      "end_time": 66.875,
      "transcript": "ਕਿਆ ਜਾਨਉ, ਸਹ ਕਉਨ ਪਿਆਰੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.465,
      "end_time": 74.43,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਜਾ ਕੈ ਮਸਤਕਿ ਭਾਗੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 74.43,
      "end_time": 80.865,
      "transcript": "ਸਭ ਪਰਹਰਿ, ਤਾ ਕਉ ਮਿਲੈ ਸੁਹਾਗੁ"
    }
  ]
}

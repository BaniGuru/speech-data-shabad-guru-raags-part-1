{
  "audio_file": "0193 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.445,
      "end_time": 7.285,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.081,
      "end_time": 21.463,
      "transcript": "ਢਾਹਨ ਲਾਗੇ ਧਰਮ ਰਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.463,
      "end_time": 27.977,
      "transcript": "ਕਿਨਹਿ ਨ ਘਾਲਿਓ ਬੰਧ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.977,
      "end_time": 34.545,
      "transcript": "ਨਾਨਕ ਉਬਰੇ ਜਪਿ ਹਰੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.76,
      "end_time": 44.395,
      "transcript": "ਸਾਧਸੰਗਿ ਸਨਬੰਧ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.653,
      "end_time": 62.172,
      "transcript": "ਢਢਾ ਢੂਢਤ ਕਹ ਫਿਰਹੁ, ਢੂਢਨੁ ਇਆ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.172,
      "end_time": 70.34,
      "transcript": "ਸੰਗਿ ਤੁਹਾਰੈ ਪ੍ਰਭੁ ਬਸੈ, ਬਨੁ ਬਨੁ ਕਹਾ ਫਿਰਾਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.34,
      "end_time": 78.855,
      "transcript": "ਢੇਰੀ ਢਾਹਹੁ ਸਾਧਸੰਗਿ, ਅਹੰਬੁਧਿ ਬਿਕਰਾਲ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.28,
      "end_time": 87.365,
      "transcript": "ਸੁਖੁ ਪਾਵਹੁ ਸਹਜੇ ਬਸਹੁ, ਦਰਸਨੁ ਦੇਖਿ ਨਿਹਾਲ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.84,
      "end_time": 96.045,
      "transcript": "ਢੇਰੀ ਜਾਮੈ ਜਮਿ ਮਰੈ, ਗਰਭ ਜੋਨਿ ਦੁਖ ਪਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 96.48,
      "end_time": 104.666,
      "transcript": "ਮੋਹ ਮਗਨ ਲਪਟਤ ਰਹੈ, ਹਉ ਹਉ ਆਵੈ ਜਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 104.666,
      "end_time": 113.115,
      "transcript": "ਢਹਤ ਢਹਤ ਅਬ ਢਹਿ ਪਰੇ, ਸਾਧ ਜਨਾ ਸਰਨਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 113.44,
      "end_time": 122.495,
      "transcript": "ਦੁਖ ਕੇ ਫਾਹੇ ਕਾਟਿਆ, ਨਾਨਕ ਲੀਏ ਸਮਾਇ"
    }
  ]
}

{
  "audio_file": "0140 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.115,
      "end_time": 7.112,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.36,
      "end_time": 21.24,
      "transcript": "ਹਮ ਧਨਵੰਤ ਭਾਗਠ, ਸਚ ਨਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.24,
      "end_time": 29.715,
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਵਹ, ਸਹਜਿ ਸੁਭਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.92,
      "end_time": 53.0,
      "transcript": "ਪੀਊ ਦਾਦੇ ਕਾ, ਖੋਲਿ ਡਿਠਾ ਖਜਾਨਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.0,
      "end_time": 59.901,
      "transcript": "ਤਾ ਮੇਰੈ ਮਨਿ, ਭਇਆ ਨਿਧਾਨਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 59.901,
      "end_time": 67.011,
      "transcript": "ਰਤਨ ਲਾਲ, ਜਾ ਕਾ ਕਛੂ ਨ ਮੋਲੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 67.011,
      "end_time": 74.103,
      "transcript": "ਭਰੇ ਭੰਡਾਰ, ਅਖੂਟ ਅਤੋਲ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.103,
      "end_time": 81.12,
      "transcript": "ਖਾਵਹਿ ਖਰਚਹਿ, ਰਲਿ ਮਿਲਿ ਭਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.12,
      "end_time": 88.209,
      "transcript": "ਤੋਟਿ ਨ ਆਵੈ, ਵਧਦੋ ਜਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.209,
      "end_time": 95.44,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਿਸੁ ਮਸਤਕਿ ਲੇਖੁ ਲਿਖਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.44,
      "end_time": 102.045,
      "transcript": "ਸੁ ਏਤੁ ਖਜਾਨੈ, ਲਇਆ ਰਲਾਇ"
    }
  ]
}

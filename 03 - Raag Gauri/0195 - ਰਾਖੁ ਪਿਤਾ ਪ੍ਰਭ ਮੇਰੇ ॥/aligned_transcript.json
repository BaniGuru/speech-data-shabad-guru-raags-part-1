    {
      "section_id": "section-00002",
      "start_time": 15.675,
      "end_time": 22.745,
      "transcript": "ਰਾਖੁ ਪਿਤਾ ਪ੍ਰਭ ਮੇਰੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.28,
      "end_time": 30.845,
      "transcript": "ਮੋਹਿ ਨਿਰਗੁਨੁ, ਸਭ ਗੁਨ ਤੇਰੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.64,
      "end_time": 45.745,
      "transcript": "ਪੰਚ ਬਿਖਾਦੀ ਏਕੁ ਗਰੀਬਾ"

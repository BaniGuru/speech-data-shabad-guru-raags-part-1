    {
      "section_id": "section-00005",
      "start_time": 46.205,
      "end_time": 53.125,
      "transcript": "ਰਾਖਹੁ ਰਾਖਨਹਾਰੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 54.04,
      "end_time": 61.445,
      "transcript": "ਖੇਦੁ ਕਰਹਿ ਅਰੁ ਬਹੁਤੁ ਸੰਤਾਵਹਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.445,
      "end_time": 68.925,
      "transcript": "ਆਇਓ ਸਰਨਿ ਤੁਹਾਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 69.6,
      "end_time": 76.815,
      "transcript": "ਕਰਿ ਕਰਿ ਹਾਰਿਓ ਅਨਿਕ ਬਹੁ ਭਾਤੀ"

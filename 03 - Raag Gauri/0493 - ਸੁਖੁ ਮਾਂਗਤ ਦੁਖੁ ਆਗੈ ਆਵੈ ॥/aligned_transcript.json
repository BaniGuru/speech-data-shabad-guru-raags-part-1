{
  "audio_file": "0243 F Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.235,
      "end_time": 6.739,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.739,
      "end_time": 13.255,
      "transcript": "ਅਸਟਪਦੀ ਕਬੀਰ ਜੀ ਕੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 13.365,
      "end_time": 19.865,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.165,
      "end_time": 32.55,
      "transcript": "ਸੁਖੁ ਮਾਂਗਤ, ਦੁਖੁ ਆਗੈ ਆਵੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.55,
      "end_time": 38.905,
      "transcript": "ਸੋ ਸੁਖੁ, ਹਮਹੁ ਨ ਮਾਂਗਿਆ ਭਾਵੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 38.905,
      "end_time": 45.56,
      "transcript": "ਬਿਖਿਆ ਅਜਹੁ ਸੁਰਤਿ, ਸੁਖ ਆਸਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 45.56,
      "end_time": 55.015,
      "transcript": "ਕੈਸੇ ਹੋਈ ਹੈ, ਰਾਜਾ ਰਾਮ ਨਿਵਾਸਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.48,
      "end_time": 68.0,
      "transcript": "ਇਸੁ ਸੁਖ ਤੇ, ਸਿਵ ਬ੍ਰਹਮ ਡਰਾਨਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.0,
      "end_time": 74.4,
      "transcript": "ਸੋ ਸੁਖੁ, ਹਮਹੁ ਸਾਚੁ ਕਰਿ ਜਾਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.4,
      "end_time": 80.91,
      "transcript": "ਸਨਕਾਦਿਕ ਨਾਰਦ ਮੁਨਿ ਸੇਖਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.91,
      "end_time": 87.365,
      "transcript": "ਤਿਨ ਭੀ ਤਨ ਮਹਿ, ਮਨੁ ਨਹੀ ਪੇਖਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.365,
      "end_time": 93.575,
      "transcript": "ਇਸੁ ਮਨ ਕਉ, ਕੋਈ ਖੋਜਹੁ ਭਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 93.96,
      "end_time": 100.205,
      "transcript": "ਤਨ ਛੂਟੇ, ਮਨੁ ਕਹਾ ਸਮਾਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 100.205,
      "end_time": 106.96,
      "transcript": "ਗੁਰ ਪਰਸਾਦੀ, ਜੈਦੇਉ ਨਾਮਾਂ"
    },
    {
      "section_id": "section-00015",
      "start_time": 106.96,
      "end_time": 113.415,
      "transcript": "ਭਗਤਿ ਕੈ ਪ੍ਰੇਮਿ, ਇਨ ਹੀ ਹੈ ਜਾਨਾਂ"
    },
    {
      "section_id": "section-00016",
      "start_time": 119.76,
      "end_time": 126.21,
      "transcript": "ਇਸੁ ਮਨ ਕਉ, ਨਹੀ ਆਵਨ ਜਾਨਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 126.21,
      "end_time": 132.695,
      "transcript": "ਜਿਸ ਕਾ ਭਰਮੁ ਗਇਆ, ਤਿਨਿ ਸਾਚੁ ਪਛਾਨਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 132.695,
      "end_time": 139.1,
      "transcript": "ਇਸੁ ਮਨ ਕਉ, ਰੂਪੁ ਨ ਰੇਖਿਆ ਕਾਈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 139.1,
      "end_time": 145.525,
      "transcript": "ਹੁਕਮੇ ਹੋਇਆ, ਹੁਕਮੁ ਬੂਝਿ ਸਮਾਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 151.92,
      "end_time": 158.48,
      "transcript": "ਇਸ ਮਨ ਕਾ, ਕੋਈ ਜਾਨੈ ਭੇਉ"
    },
    {
      "section_id": "section-00021",
      "start_time": 158.48,
      "end_time": 164.896,
      "transcript": "ਇਹ ਮਨਿ, ਲੀਣ ਭਏ ਸੁਖਦੇਉ"
    },
    {
      "section_id": "section-00022",
      "start_time": 164.896,
      "end_time": 171.065,
      "transcript": "ਜੀਉ ਏਕੁ, ਅਰੁ ਸਗਲ ਸਰੀਰਾ"
    },
    {
      "section_id": "section-00023",
      "start_time": 171.4,
      "end_time": 177.445,
      "transcript": "ਇਸੁ ਮਨ ਕਉ, ਰਵਿ ਰਹੇ ਕਬੀਰਾ"
    }
  ]
}

{
  "audio_file": "0159 C PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.105,
      "end_time": 7.582,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.514,
      "end_time": 21.989,
      "transcript": "ਦੀਬਾਨੁ ਹਮਾਰੋ, ਤੁਹੀ ਏਕ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.989,
      "end_time": 29.415,
      "transcript": "ਸੇਵਾ ਥਾਰੀ, ਗੁਰਹਿ ਟੇਕ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 36.256,
      "end_time": 43.646,
      "transcript": "ਅਨਿਕ ਜੁਗਤਿ, ਨਹੀ ਪਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.646,
      "end_time": 50.927,
      "transcript": "ਗੁਰਿ, ਚਾਕਰ ਲੈ ਲਾਇਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.927,
      "end_time": 58.067,
      "transcript": "ਮਾਰੇ, ਪੰਚ ਬਿਖਾਦੀਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 58.067,
      "end_time": 64.985,
      "transcript": "ਗੁਰ ਕਿਰਪਾ ਤੇ, ਦਲੁ ਸਾਧਿਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 72.6,
      "end_time": 79.726,
      "transcript": "ਬਖਸੀਸ ਵਜਹੁ, ਮਿਲਿ ਏਕੁ ਨਾਮ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.726,
      "end_time": 87.02,
      "transcript": "ਸੂਖ ਸਹਜ, ਆਨੰਦ ਬਿਸ੍ਰਾਮ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.02,
      "end_time": 94.065,
      "transcript": "ਪ੍ਰਭ ਕੇ ਚਾਕਰ, ਸੇ ਭਲੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.065,
      "end_time": 100.535,
      "transcript": "ਨਾਨਕ, ਤਿਨ ਮੁਖ ਊਜਲੇ"
    }
  ]
}

      "transcript": "ਗਉੜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.56,
      "end_time": 23.24,
      "transcript": "ਪਾਪੁ ਪੁੰਨੁ ਦੁਇ ਬੈਲ ਬਿਸਾਹੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.24,
      "end_time": 30.305,
      "transcript": "ਪਵਨੁ ਪੂਜੀ ਪਰਗਾਸਿਓ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.84,
      "end_time": 38.655,
      "transcript": "ਤ੍ਰਿਸਨਾ ਗੂਣਿ ਭਰੀ ਘਟ ਭੀਤਰਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.655,
      "end_time": 46.005,
      "transcript": "ਇਨ ਬਿਧਿ ਟਾਂਡ ਬਿਸਾਹਿਓ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.6,
      "end_time": 54.32,
      "transcript": "ਐਸਾ ਨਾਇਕੁ, ਰਾਮੁ ਹਮਾਰਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.32,
      "end_time": 62.01,
      "transcript": "ਸਗਲ ਸੰਸਾਰੁ, ਕੀਓ ਬਨਜਾਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 69.725,
      "end_time": 77.025,
      "transcript": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਦੁਇ ਭਏ ਜਗਾਤੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 77.345,
      "end_time": 84.675,
      "transcript": "ਮਨ ਤਰੰਗ ਬਟਵਾਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 85.12,
      "end_time": 92.96,
      "transcript": "ਪੰਚ ਤਤੁ ਮਿਲਿ ਦਾਨੁ ਨਿਬੇਰਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 92.96,
      "end_time": 99.955,
      "transcript": "ਟਾਂਡਾ ਉਤਰਿਓ ਪਾਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 100.6,
      "end_time": 108.32,
      "transcript": "ਕਹਤ ਕਬੀਰੁ ਸੁਨਹੁ ਰੇ ਸੰਤਹੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 108.32,
      "end_time": 115.435,
      "transcript": "ਅਬ ਐਸੀ ਬਨਿ ਆਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 115.935,
      "end_time": 123.475,
      "transcript": "ਘਾਟੀ ਚਢਤ ਬੈਲੁ ਇਕੁ ਥਾਕਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 123.475,
      "end_time": 130.66,
      "transcript": "ਚਲੋ ਗੋਨਿ ਛਿਟਕਾਈ"
    }
  ]
}

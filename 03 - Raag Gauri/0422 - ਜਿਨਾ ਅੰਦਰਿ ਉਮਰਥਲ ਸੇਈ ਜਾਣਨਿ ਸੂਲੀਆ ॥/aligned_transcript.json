  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 7.28,
      "end_time": 17.583,
      "transcript": "ਸਲੋਕ ਮਹਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 17.583,
      "end_time": 24.323,
      "transcript": "ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 42.325,
      "end_time": 49.915,
      "transcript": "ਜਿਨਾ ਅੰਦਰਿ ਉਮਰਥਲ"
    },
    {
      "section_id": "section-00004",
      "start_time": 49.915,
      "end_time": 58.043,
      "transcript": "ਸੇਈ ਜਾਣਨਿ ਸੂਲੀਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 58.043,
      "end_time": 65.265,
      "transcript": "ਹਰਿ ਜਾਣਹਿ ਸੇਈ ਬਿਰਹੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 65.8,
      "end_time": 73.325,
      "transcript": "ਹਉ ਤਿਨ ਵਿਟਹੁ ਸਦ ਘੁਮਿ ਘੋਲੀਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 80.84,
      "end_time": 87.408,
      "transcript": "ਹਰਿ ਮੇਲਹੁ ਸਜਣੁ ਪੁਰਖੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 87.408,
      "end_time": 95.305,
      "transcript": "ਮੇਰਾ ਸਿਰੁ ਤਿਨ ਵਿਟਹੁ ਤਲ ਰੋਲੀਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 95.52,
      "end_time": 102.8,
      "transcript": "ਜੋ ਸਿਖ ਗੁਰ ਕਾਰ ਕਮਾਵਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 102.8,
      "end_time": 109.929,
      "transcript": "ਹਉ ਗੁਲਮੁ ਤਿਨਾ ਕਾ ਗੋਲੀਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 109.929,
      "end_time": 116.48,
      "transcript": "ਹਰਿ ਰੰਗਿ ਚਲੂਲੈ ਜੋ ਰਤੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 116.48,
      "end_time": 123.895,
      "transcript": "ਤਿਨ ਭਿਨੀ ਹਰਿ ਰੰਗਿ ਚੋਲੀਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 124.2,
      "end_time": 131.175,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਨਾਨਕ ਮੇਲਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 131.175,
      "end_time": 141.855,
      "transcript": "ਗੁਰ ਪਹਿ ਸਿਰੁ ਵੇਚਿਆ ਮੋਲੀਆ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 148.88,
      "end_time": 155.215,
      "transcript": "ਅਉਗਣੀ ਭਰਿਆ ਸਰੀਰੁ ਹੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 155.8,
      "end_time": 162.255,
      "transcript": "ਕਿਉ ਸੰਤਹੁ ਨਿਰਮਲੁ ਹੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 162.8,
      "end_time": 169.612,
      "transcript": "ਗੁਰਮੁਖਿ ਗੁਣ ਵੇਹਾਝੀਅਹਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 169.612,
      "end_time": 176.705,
      "transcript": "ਮਲੁ ਹਉਮੈ ਕਢੈ ਧੋਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 183.56,
      "end_time": 190.195,
      "transcript": "ਸਚੁ ਵਣੰਜਹਿ ਰੰਗ ਸਿਉ"
    },
    {
      "section_id": "section-00020",
      "start_time": 190.52,
      "end_time": 197.105,
      "transcript": "ਸਚੁ ਸਉਦਾ ਹੋਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 197.36,
      "end_time": 203.892,
      "transcript": "ਤੋਟਾ ਮੂਲਿ ਨ ਆਵਈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 203.892,
      "end_time": 210.596,
      "transcript": "ਲਾਹਾ ਹਰਿ ਭਾਵੈ ਸੋਇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 210.596,
      "end_time": 217.415,
      "transcript": "ਨਾਨਕ ਤਿਨ ਸਚੁ ਵਣੰਜਿਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 217.415,
      "end_time": 227.185,
      "transcript": "ਜਿਨਾ ਧੁਰਿ ਲਿਖਿਆ ਪਰਾਪਤਿ ਹੋਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00025",
      "start_time": 231.68,
      "end_time": 239.915,
      "transcript": "ਸਾਲਾਹੀ ਸਚੁ ਸਾਲਾਹਣਾ, ਸਚੁ ਸਚਾ ਪੁਰਖੁ ਨਿਰਾਲੇ"
    },
    {
      "section_id": "section-00026",
      "start_time": 239.915,
      "end_time": 248.335,
      "transcript": "ਸਚੁ ਸੇਵੀ ਸਚੁ ਮਨਿ ਵਸੈ, ਸਚੁ ਸਚਾ ਹਰਿ ਰਖਵਾਲੇ"
    },
    {
      "section_id": "section-00027",
      "start_time": 248.335,
      "end_time": 256.445,
      "transcript": "ਸਚੁ ਸਚਾ ਜਿਨੀ ਅਰਾਧਿਆ, ਸੇ ਜਾਇ ਰਲੇ ਸਚ ਨਾਲੇ"
    },
    {
      "section_id": "section-00028",
      "start_time": 256.8,
      "end_time": 265.095,
      "transcript": "ਸਚੁ ਸਚਾ ਜਿਨੀ ਨ ਸੇਵਿਆ, ਸੇ ਮਨਮੁਖ ਮੂੜ ਬੇਤਾਲੇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 265.095,
      "end_time": 274.025,
      "transcript": "ਓਹ ਆਲੁ ਪਤਾਲੁ ਮੁਹਹੁ ਬੋਲਦੇ, ਜਿਉ ਪੀਤੈ ਮਦਿ ਮਤਵਾਲੇ"
    }
  ]
}

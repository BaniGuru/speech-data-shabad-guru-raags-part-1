    {
      "section_id": "section-00013",
      "start_time": 124.52,
      "end_time": 131.889,
      "transcript": "ਤੂੰ ਗੁਣਵੰਤਾ ਹਰਿ ਹਰਿ ਦਇਆਲੁ"

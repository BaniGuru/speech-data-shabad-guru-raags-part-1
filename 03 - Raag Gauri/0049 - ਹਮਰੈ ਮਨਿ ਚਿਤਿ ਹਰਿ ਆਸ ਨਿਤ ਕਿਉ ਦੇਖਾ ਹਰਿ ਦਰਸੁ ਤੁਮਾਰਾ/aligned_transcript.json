    {
      "section_id": "section-00019",
      "start_time": 181.36,
      "end_time": 188.741,
      "transcript": "ਹਮ ਜੈਸੇ ਅਪਰਾਧੀ ਅਵਰੁ ਕੋਈ ਰਾਖੈ"

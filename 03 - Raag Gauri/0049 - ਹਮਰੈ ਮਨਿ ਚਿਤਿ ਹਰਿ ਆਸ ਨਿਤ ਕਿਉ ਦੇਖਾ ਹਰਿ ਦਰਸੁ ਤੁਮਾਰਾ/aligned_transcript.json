    {
      "section_id": "section-00014",
      "start_time": 131.889,
      "end_time": 139.52,
      "transcript": "ਹਰਿ ਆਪੇ ਬਖਸਿ ਲੈਹਿ ਹਰਿ ਭਾਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 139.68,
      "end_time": 146.32,
      "transcript": "ਹਮ ਅਪਰਾਧੀ ਰਾਖੇ ਗੁਰ ਸੰਗਤੀ"

    {
      "section_id": "section-00005",
      "start_time": 54.92,
      "end_time": 62.713,
      "transcript": "ਹਮਰੈ ਮਨਿ ਚਿਤਿ ਹਰਿ ਬਹੁਤੁ ਪਿਆਰਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.713,
      "end_time": 70.344,
      "transcript": "ਹਉ ਕੁਰਬਾਨੀ ਗੁਰ ਆਪਣੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.344,
      "end_time": 78.046,
      "transcript": "ਜਿਨਿ ਵਿਛੁੜਿਆ ਮੇਲਿਆ ਮੇਰਾ ਸਿਰਜਨਹਾਰਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 78.046,
      "end_time": 86.56,
      "transcript": "ਮੇਰੇ ਰਾਮ ਹਮ ਪਾਪੀ ਸਰਣਿ ਪਰੇ ਹਰਿ ਦੁਆਰਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 86.56,
      "end_time": 93.831,
      "transcript": "ਮਤੁ ਨਿਰਗੁਣ ਹਮ ਮੇਲੈ ਕਬਹੂੰ"

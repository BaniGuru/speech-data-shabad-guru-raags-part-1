      "section_id": "section-00026",
      "start_time": 245.68,
      "end_time": 253.24,
      "transcript": "ਗੁਰ ਸਤਿਗੁਰ ਸੰਗਿ ਕੀਰੇ ਹਮ ਥਾਪੇ"
    },
    {
      "section_id": "section-00027",
      "start_time": 253.24,
      "end_time": 260.5,
      "transcript": "ਧੰਨੁ ਧੰਨੁ ਗੁਰੂ ਨਾਨਕ ਜਨ ਕੇਰਾ"

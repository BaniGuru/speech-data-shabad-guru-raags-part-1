    {
      "section_id": "section-00020",
      "start_time": 188.741,
      "end_time": 196.273,
      "transcript": "ਜੈਸੇ ਹਮ ਸਤਿਗੁਰਿ ਰਾਖਿ ਲੀਏ ਛਡਾਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 196.273,
      "end_time": 203.836,
      "transcript": "ਤੂੰ ਗੁਰੁ ਪਿਤਾ ਤੂੰਹੈ ਗੁਰੁ ਮਾਤਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 203.836,
      "end_time": 211.53,
      "transcript": "ਤੂੰ ਗੁਰੁ ਬੰਧਪੁ ਮੇਰਾ ਸਖਾ ਸਖਾਇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 218.918,
      "end_time": 226.372,
      "transcript": "ਜੋ ਹਮਰੀ ਬਿਧਿ ਹੋਤੀ ਮੇਰੇ ਸਤਿਗੁਰਾ"

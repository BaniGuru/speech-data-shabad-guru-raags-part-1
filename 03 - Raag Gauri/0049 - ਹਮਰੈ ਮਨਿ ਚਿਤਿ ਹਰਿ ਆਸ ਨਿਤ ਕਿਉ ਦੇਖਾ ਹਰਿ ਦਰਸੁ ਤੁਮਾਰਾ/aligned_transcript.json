    {
      "section_id": "section-00025",
      "start_time": 238.04,
      "end_time": 245.68,
      "transcript": "ਹਮ ਰੁਲਤੇ ਫਿਰਤੇ ਕੋਈ ਬਾਤ ਨ ਪੂਛਤਾ"

    {
      "section_id": "section-00024",
      "start_time": 226.372,
      "end_time": 234.29,
      "transcript": "ਸਾ ਬਿਧਿ ਤੁਮ ਹਰਿ ਜਾਣਹੁ ਆਪੇ"

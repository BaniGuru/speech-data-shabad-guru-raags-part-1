{
  "audio_file": "0138 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.16,
      "end_time": 7.73,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.769,
      "end_time": 20.84,
      "transcript": "ਬੰਧਨ ਤੋੜਿ, ਬੋਲਾਵੈ ਰਾਮੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.84,
      "end_time": 27.8,
      "transcript": "ਮਨ ਮਹਿ ਲਾਗੈ ਸਾਚੁ ਧਿਆਨੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.8,
      "end_time": 34.72,
      "transcript": "ਮਿਟਹਿ ਕਲੇਸ, ਸੁਖੀ ਹੋਇ ਰਹੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.72,
      "end_time": 41.56,
      "transcript": "ਐਸਾ ਦਾਤਾ, ਸਤਿਗੁਰੁ ਕਹੀਐ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.56,
      "end_time": 48.44,
      "transcript": "ਸੋ ਸੁਖਦਾਤਾ, ਜਿ ਨਾਮੁ ਜਪਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.44,
      "end_time": 58.88,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਤਿਸੁ ਸੰਗਿ ਮਿਲਾਵੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 69.28,
      "end_time": 76.2,
      "transcript": "ਜਿਸੁ ਹੋਇ ਦਇਆਲੁ, ਤਿਸੁ ਆਪਿ ਮਿਲਾਵੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.2,
      "end_time": 83.02,
      "transcript": "ਸਰਬ ਨਿਧਾਨ, ਗੁਰੂ ਤੇ ਪਾਵੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.02,
      "end_time": 90.16,
      "transcript": "ਆਪੁ ਤਿਆਗਿ, ਮਿਟੈ ਆਵਣ ਜਾਣਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 90.16,
      "end_time": 97.172,
      "transcript": "ਸਾਧ ਕੈ ਸੰਗਿ, ਪਾਰਬ੍ਰਹਮੁ ਪਛਾਣਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 103.816,
      "end_time": 110.8,
      "transcript": "ਜਨ ਊਪਰਿ ਪ੍ਰਭ ਭਏ ਦਇਆਲ"
    },
    {
      "section_id": "section-00013",
      "start_time": 110.8,
      "end_time": 117.68,
      "transcript": "ਜਨ ਕੀ ਟੇਕ, ਏਕ ਗੋਪਾਲ"
    },
    {
      "section_id": "section-00014",
      "start_time": 117.68,
      "end_time": 124.6,
      "transcript": "ਏਕਾ ਲਿਵ, ਏਕੋ ਮਨਿ ਭਾਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 124.6,
      "end_time": 131.686,
      "transcript": "ਸਰਬ ਨਿਧਾਨ, ਜਨ ਕੈ ਹਰਿ ਨਾਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 138.32,
      "end_time": 145.28,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਸਿਉ, ਲਾਗੀ ਪ੍ਰੀਤਿ"
    },
    {
      "section_id": "section-00017",
      "start_time": 145.28,
      "end_time": 152.085,
      "transcript": "ਨਿਰਮਲ ਕਰਣੀ, ਸਾਚੀ ਰੀਤਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 152.085,
      "end_time": 158.975,
      "transcript": "ਗੁਰਿ ਪੂਰੈ, ਮੇਟਿਆ ਅੰਧਿਆਰਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 159.027,
      "end_time": 166.457,
      "transcript": "ਨਾਨਕ ਕਾ ਪ੍ਰਭੁ ਅਪਰ ਅਪਾਰਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 172.687,
      "end_time": 180.52,
      "transcript": "ਨਾਨਕ ਕਾ ਪ੍ਰਭੁ ਅਪਰ ਅਪਾਰਾ"
    }
  ]
}

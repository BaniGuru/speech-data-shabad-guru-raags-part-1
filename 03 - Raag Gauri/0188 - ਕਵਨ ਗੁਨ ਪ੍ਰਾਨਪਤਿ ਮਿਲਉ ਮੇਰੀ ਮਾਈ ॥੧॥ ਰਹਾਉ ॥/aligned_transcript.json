      "transcript": "ਪੂਰਬੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.027,
      "end_time": 40.485,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 71.12,
      "end_time": 78.845,
      "transcript": "ਕਵਨ ਗੁਨ, ਪ੍ਰਾਨਪਤਿ ਮਿਲਉ ਮੇਰੀ ਮਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 87.415,
      "end_time": 95.225,
      "transcript": "ਰੂਪ ਹੀਨ ਬੁਧਿ ਬਲ ਹੀਨੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 95.335,
      "end_time": 103.331,
      "transcript": "ਮੋਹਿ ਪਰਦੇਸਨਿ ਦੂਰ ਤੇ ਆਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 103.331,
      "end_time": 110.965,
      "transcript": "ਨਾਹਿਨ ਦਰਬੁ ਨ ਜੋਬਨ ਮਾਤੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 111.6,
      "end_time": 119.355,
      "transcript": "ਮੋਹਿ ਅਨਾਥ ਕੀ ਕਰਹੁ ਸਮਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 119.355,
      "end_time": 127.585,
      "transcript": "ਖੋਜਤ ਖੋਜਤ ਭਈ ਬੈਰਾਗਨਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 127.585,
      "end_time": 135.045,
      "transcript": "ਪ੍ਰਭ ਦਰਸਨ ਕਉ ਹਉ ਫਿਰਤ ਤਿਸਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 135.675,
      "end_time": 143.225,
      "transcript": "ਦੀਨ ਦਇਆਲ ਕ੍ਰਿਪਾਲ ਪ੍ਰਭ ਨਾਨਕ"
    },
    {
      "section_id": "section-00012",
      "start_time": 143.775,
      "end_time": 151.185,
      "transcript": "ਸਾਧਸੰਗਿ ਮੇਰੀ ਜਲਨਿ ਬੁਝਾਈ"
    }

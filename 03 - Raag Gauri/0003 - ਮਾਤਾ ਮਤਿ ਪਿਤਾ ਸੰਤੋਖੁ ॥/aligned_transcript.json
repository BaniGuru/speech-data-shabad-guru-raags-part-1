{
  "audio_file": "0115 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.144,
      "end_time": 7.113,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.4,
      "end_time": 21.36,
      "transcript": "ਮਾਤਾ ਮਤਿ, ਪਿਤਾ ਸੰਤੋਖੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.96,
      "end_time": 28.64,
      "transcript": "ਸਤੁ ਭਾਈ ਕਰਿ, ਏਹੁ ਵਿਸੇਖੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.16,
      "end_time": 36.16,
      "transcript": "ਕਹਣਾ ਹੈ, ਕਿਛੁ ਕਹਣੁ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.16,
      "end_time": 46.75,
      "transcript": "ਤਉ ਕੁਦਰਤਿ ਕੀਮਤਿ ਨਹੀ ਪਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 54.24,
      "end_time": 61.48,
      "transcript": "ਸਰਮ ਸੁਰਤਿ ਦੁਇ, ਸਸੁਰ ਭਏ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.48,
      "end_time": 68.04,
      "transcript": "ਕਰਣੀ ਕਾਮਣਿ, ਕਰਿ ਮਨ ਲਏ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.72,
      "end_time": 75.689,
      "transcript": "ਸਾਹਾ ਸੰਜੋਗੁ, ਵੀਆਹੁ ਵਿਜੋਗੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.689,
      "end_time": 82.68,
      "transcript": "ਸਚੁ ਸੰਤਤਿ, ਕਹੁ ਨਾਨਕ ਜੋਗੁ"
    }
  ]
}

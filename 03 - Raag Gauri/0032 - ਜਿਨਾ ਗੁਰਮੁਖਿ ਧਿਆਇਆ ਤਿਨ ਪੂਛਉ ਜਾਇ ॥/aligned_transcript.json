{
  "audio_file": "0122 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.19,
      "end_time": 7.711,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.6,
      "end_time": 21.334,
      "transcript": "ਜਿਨਾ ਗੁਰਮੁਖਿ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.334,
      "end_time": 28.627,
      "transcript": "ਤਿਨ ਪੂਛਉ ਜਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.627,
      "end_time": 35.738,
      "transcript": "ਗੁਰ ਸੇਵਾ ਤੇ, ਮਨੁ ਪਤੀਆਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.738,
      "end_time": 43.065,
      "transcript": "ਸੇ ਧਨਵੰਤ, ਹਰਿ ਨਾਮੁ ਕਮਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.065,
      "end_time": 50.436,
      "transcript": "ਪੂਰੇ ਗੁਰ ਤੇ, ਸੋਝੀ ਪਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.436,
      "end_time": 57.365,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਜਪਹੁ ਮੇਰੇ ਭਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.365,
      "end_time": 65.333,
      "transcript": "ਗੁਰਮੁਖਿ ਸੇਵਾ ਹਰਿ ਘਾਲ ਥਾਇ ਪਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.912,
      "end_time": 79.12,
      "transcript": "ਆਪੁ ਪਛਾਣੈ, ਮਨੁ ਨਿਰਮਲੁ ਹੋਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 79.12,
      "end_time": 86.2,
      "transcript": "ਜੀਵਨ ਮੁਕਤਿ, ਹਰਿ ਪਾਵੈ ਸੋਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 86.2,
      "end_time": 93.44,
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਵੈ, ਮਤਿ ਊਤਮ ਹੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 93.44,
      "end_time": 100.202,
      "transcript": "ਸਹਜੇ ਸਹਜਿ, ਸਮਾਵੈ ਸੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 100.202,
      "end_time": 107.76,
      "transcript": "ਦੂਜੈ ਭਾਇ, ਨ ਸੇਵਿਆ ਜਾਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 107.76,
      "end_time": 114.72,
      "transcript": "ਹਉਮੈ ਮਾਇਆ, ਮਹਾ ਬਿਖੁ ਖਾਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 114.72,
      "end_time": 121.84,
      "transcript": "ਪੁਤਿ ਕੁਟੰਬਿ ਗ੍ਰਿਹਿ, ਮੋਹਿਆ ਮਾਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 121.84,
      "end_time": 129.08,
      "transcript": "ਮਨਮੁਖਿ ਅੰਧਾ, ਆਵੈ ਜਾਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 129.08,
      "end_time": 136.16,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਦੇਵੈ ਜਨੁ ਸੋਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 136.16,
      "end_time": 143.2,
      "transcript": "ਅਨਦਿਨੁ ਭਗਤਿ ਗੁਰਸਬਦੀ ਹੋਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 143.2,
      "end_time": 150.239,
      "transcript": "ਗੁਰਮਤਿ ਵਿਰਲਾ, ਬੂਝੈ ਕੋਇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 150.239,
      "end_time": 156.992,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਸਮਾਵੈ ਸੋਇ"
    }
  ]
}

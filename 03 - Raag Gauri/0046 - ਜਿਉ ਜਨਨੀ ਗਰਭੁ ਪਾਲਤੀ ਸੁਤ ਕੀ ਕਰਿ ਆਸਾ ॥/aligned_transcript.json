{
  "audio_file": "0125 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.48,
      "end_time": 8.053,
      "transcript": "ਗਉੜੀ ਬੈਰਾਗਣਿ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.52,
      "end_time": 22.917,
      "transcript": "ਜਿਉ ਜਨਨੀ ਗਰਭੁ ਪਾਲਤੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.917,
      "end_time": 30.031,
      "transcript": "ਸੁਤ ਕੀ ਕਰਿ ਆਸਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.031,
      "end_time": 37.833,
      "transcript": "ਵਡਾ ਹੋਇ ਧਨੁ ਖਾਟਿ ਦੇਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 37.833,
      "end_time": 45.317,
      "transcript": "ਕਰਿ ਭੋਗ ਬਿਲਾਸਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.317,
      "end_time": 53.079,
      "transcript": "ਤਿਉ ਹਰਿ ਜਨ ਪ੍ਰੀਤਿ ਹਰਿ ਰਾਖਦਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.079,
      "end_time": 60.515,
      "transcript": "ਦੇ ਆਪਿ ਹਥਾਸਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.515,
      "end_time": 68.44,
      "transcript": "ਮੇਰੇ ਰਾਮ ਮੈ ਮੂਰਖ, ਹਰਿ ਰਾਖੁ ਮੇਰੇ ਗੁਸਈਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.44,
      "end_time": 76.299,
      "transcript": "ਜਨ ਕੀ ਉਪਮਾ, ਤੁਝਹਿ ਵਡਈਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.56,
      "end_time": 91.194,
      "transcript": "ਮੰਦਰਿ ਘਰਿ ਆਨੰਦੁ ਹਰਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 91.194,
      "end_time": 98.69,
      "transcript": "ਹਰਿ ਜਸੁ ਮਨਿ ਭਾਵੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 98.69,
      "end_time": 106.191,
      "transcript": "ਸਭ ਰਸ ਮੀਠੇ ਮੁਖਿ ਲਗਹਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 106.191,
      "end_time": 113.493,
      "transcript": "ਜਾ ਹਰਿ ਗੁਣ ਗਾਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 113.493,
      "end_time": 121.106,
      "transcript": "ਹਰਿ ਜਨੁ ਪਰਵਾਰੁ ਸਧਾਰੁ ਹੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 121.106,
      "end_time": 128.844,
      "transcript": "ਇਕੀਹ ਕੁਲੀ ਸਭੁ ਜਗਤੁ ਛਡਾਵੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 128.844,
      "end_time": 136.144,
      "transcript": "ਜੋ ਕਿਛੁ ਕੀਆ ਸੋ ਹਰਿ ਕੀਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 136.144,
      "end_time": 144.04,
      "transcript": "ਹਰਿ ਕੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 144.04,
      "end_time": 151.6,
      "transcript": "ਹਰਿ ਜੀਅ ਤੇਰੇ ਤੂੰ ਵਰਤਦਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 151.6,
      "end_time": 159.12,
      "transcript": "ਹਰਿ ਪੂਜ ਕਰਾਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 159.12,
      "end_time": 166.392,
      "transcript": "ਹਰਿ ਭਗਤਿ ਭੰਡਾਰ ਲਹਾਇਦਾ"
    },
    {
      "section_id": "section-00021",
      "start_time": 166.392,
      "end_time": 174.0,
      "transcript": "ਆਪੇ ਵਰਤਾਈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 174.0,
      "end_time": 181.52,
      "transcript": "ਲਾਲਾ ਹਾਟਿ ਵਿਹਾਝਿਆ"
    },
    {
      "section_id": "section-00023",
      "start_time": 181.52,
      "end_time": 188.76,
      "transcript": "ਕਿਆ ਤਿਸੁ ਚਤੁਰਾਈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 188.76,
      "end_time": 196.32,
      "transcript": "ਜੇ ਰਾਜਿ ਬਹਾਲੇ ਤਾ ਹਰਿ ਗੁਲਾਮੁ"
    },
    {
      "section_id": "section-00025",
      "start_time": 196.32,
      "end_time": 203.8,
      "transcript": "ਘਾਸੀ ਕਉ ਹਰਿ ਨਾਮੁ ਕਢਾਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 203.8,
      "end_time": 211.226,
      "transcript": "ਜਨੁ ਨਾਨਕੁ ਹਰਿ ਕਾ ਦਾਸੁ ਹੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 211.226,
      "end_time": 219.62,
      "transcript": "ਹਰਿ ਕੀ ਵਡਿਆਈ"
    }
  ]
}

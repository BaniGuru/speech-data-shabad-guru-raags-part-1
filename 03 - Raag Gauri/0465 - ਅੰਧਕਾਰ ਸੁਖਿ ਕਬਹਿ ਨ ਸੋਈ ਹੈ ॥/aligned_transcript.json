{
  "audio_file": "0239 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.585,
      "end_time": 7.803,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.52,
      "end_time": 20.975,
      "transcript": "ਅੰਧਕਾਰ, ਸੁਖਿ ਕਬਹਿ ਨ ਸੋਈ ਹੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.455,
      "end_time": 28.035,
      "transcript": "ਰਾਜਾ ਰੰਕੁ ਦੋਊ, ਮਿਲਿ ਰੋਈ ਹੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.035,
      "end_time": 35.52,
      "transcript": "ਜਉ ਪੈ, ਰਸਨਾ ਰਾਮੁ ਨ ਕਹਿਬੋ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.52,
      "end_time": 42.625,
      "transcript": "ਉਪਜਤ ਬਿਨਸਤ, ਰੋਵਤ ਰਹਿਬੋ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.44,
      "end_time": 56.48,
      "transcript": "ਜਸ ਦੇਖੀਐ, ਤਰਵਰ ਕੀ ਛਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 56.48,
      "end_time": 63.025,
      "transcript": "ਪ੍ਰਾਨ ਗਏ, ਕਹੁ ਕਾ ਕੀ ਮਾਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.025,
      "end_time": 70.4,
      "transcript": "ਜਸ ਜੰਤੀ ਮਹਿ, ਜੀਉ ਸਮਾਨਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.4,
      "end_time": 77.34,
      "transcript": "ਮੂਏ ਮਰਮੁ, ਕੋ ਕਾ ਕਰ ਜਾਨਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.34,
      "end_time": 84.115,
      "transcript": "ਹੰਸਾ ਸਰਵਰੁ, ਕਾਲੁ ਸਰੀਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.48,
      "end_time": 90.765,
      "transcript": "ਰਾਮ ਰਸਾਇਨ, ਪੀਉ ਰੇ ਕਬੀਰ"
    }
  ]
}

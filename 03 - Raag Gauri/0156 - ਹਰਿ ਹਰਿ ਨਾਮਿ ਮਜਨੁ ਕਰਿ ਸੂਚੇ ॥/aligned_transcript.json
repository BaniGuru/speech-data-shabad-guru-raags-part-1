    {
      "section_id": "section-00007",
      "start_time": 66.595,
      "end_time": 74.395,
      "transcript": "ਜਮ ਕਾ ਮਾਰਗੁ, ਦ੍ਰਿਸਟਿ ਨ ਆਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.395,
      "end_time": 82.105,
      "transcript": "ਮਨ ਬਚ ਕ੍ਰਮ, ਗੋਵਿੰਦ ਅਧਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 82.105,
      "end_time": 90.067,
      "transcript": "ਤਾ ਤੇ ਛੁਟਿਓ, ਬਿਖੁ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.067,
      "end_time": 97.837,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਕੀਨੋ ਅਪਨਾ"

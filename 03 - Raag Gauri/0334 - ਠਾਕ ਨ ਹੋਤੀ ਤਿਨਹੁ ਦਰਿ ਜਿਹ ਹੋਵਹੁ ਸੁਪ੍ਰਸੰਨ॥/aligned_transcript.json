  "audio_file": "0193 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.617,
      "end_time": 11.737,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 18.77,
      "end_time": 25.718,
      "transcript": "ਠਾਕ ਨ ਹੋਤੀ ਤਿਨਹੁ ਦਰਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.718,
      "end_time": 32.47,
      "transcript": "ਜਿਹ ਹੋਵਹੁ ਸੁਪ੍ਰਸੰਨ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.47,
      "end_time": 38.675,
      "transcript": "ਜੋ ਜਨ ਪ੍ਰਭਿ ਅਪੁਨੇ ਕਰੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.675,
      "end_time": 48.935,
      "transcript": "ਨਾਨਕ ਤੇ ਧਨਿ ਧੰਨਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.6,
      "end_time": 62.735,
      "transcript": "ਠਠਾ, ਮਨੂਆ ਠਾਹਹਿ ਨਾਹੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 62.735,
      "end_time": 67.24,
      "transcript": "ਜੋ ਸਗਲ ਤਿਆਗਿ, ਏਕਹਿ ਲਪਟਾਹੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.24,
      "end_time": 71.6,
      "transcript": "ਠਹਕਿ ਠਹਕਿ, ਮਾਇਆ ਸੰਗਿ ਮੂਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.6,
      "end_time": 75.825,
      "transcript": "ਉਆ ਕੈ ਕੁਸਲ, ਨ ਕਤਹੂ ਹੂਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 75.825,
      "end_time": 80.16,
      "transcript": "ਠਾਂਢਿ ਪਰੀ, ਸੰਤਹ ਸੰਗਿ ਬਸਿਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.16,
      "end_time": 84.4,
      "transcript": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ, ਤਹਾ ਜੀਅ ਰਸਿਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 84.4,
      "end_time": 88.475,
      "transcript": "ਠਾਕੁਰ ਅਪੁਨੇ, ਜੋ ਜਨੁ ਭਾਇਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 88.475,
      "end_time": 94.086,
      "transcript": "ਨਾਨਕ, ਉਆ ਕਾ ਮਨੁ ਸੀਤਲਾਇਆ"
    }
  ]
}

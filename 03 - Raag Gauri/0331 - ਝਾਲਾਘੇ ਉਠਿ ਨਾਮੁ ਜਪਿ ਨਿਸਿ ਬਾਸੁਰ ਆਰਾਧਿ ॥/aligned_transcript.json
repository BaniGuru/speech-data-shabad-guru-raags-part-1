{
  "audio_file": "0192 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.215,
      "end_time": 2.822,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.265,
      "end_time": 15.955,
      "transcript": "ਝਾਲਾਘੇ ਉਠਿ ਨਾਮੁ ਜਪਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.4,
      "end_time": 23.362,
      "transcript": "ਨਿਸਿ ਬਾਸੁਰ ਆਰਾਧਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.362,
      "end_time": 29.796,
      "transcript": "ਕਾਰ੍ਹਾ ਤੁਝੈ ਨ ਬਿਆਪਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.796,
      "end_time": 38.845,
      "transcript": "ਨਾਨਕ ਮਿਟੈ ਉਪਾਧਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 44.474,
      "end_time": 49.335,
      "transcript": "ਝਝਾ, ਝੂਰਨੁ ਮਿਟੈ ਤੁਮਾਰੋ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.335,
      "end_time": 53.902,
      "transcript": "ਰਾਮ ਨਾਮ ਸਿਉ, ਕਰਿ ਬਿਉਹਾਰੋ"
    },
    {
      "section_id": "section-00008",
      "start_time": 53.902,
      "end_time": 58.301,
      "transcript": "ਝੂਰਤ ਝੂਰਤ, ਸਾਕਤ ਮੂਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 58.301,
      "end_time": 63.165,
      "transcript": "ਜਾ ਕੈ ਰਿਦੈ, ਹੋਤ ਭਾਉ ਬੀਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 63.165,
      "end_time": 67.415,
      "transcript": "ਝਰਹਿ ਕਸੰਮਲ ਪਾਪ, ਤੇਰੇ ਮਨੂਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 67.415,
      "end_time": 71.76,
      "transcript": "ਅੰਮ੍ਰਿਤ ਕਥਾ, ਸੰਤਸੰਗਿ ਸੁਨੂਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 71.76,
      "end_time": 76.02,
      "transcript": "ਝਰਹਿ, ਕਾਮ ਕ੍ਰੋਧ ਦ੍ਰੁਸਟਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 76.02,
      "end_time": 81.065,
      "transcript": "ਨਾਨਕ, ਜਾ ਕਉ ਕ੍ਰਿਪਾ ਗੁਸਾਈ"
    }
  ]
}

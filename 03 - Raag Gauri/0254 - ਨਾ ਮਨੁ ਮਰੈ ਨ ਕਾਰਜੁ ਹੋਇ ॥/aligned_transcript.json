{
  "audio_file": "0168 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.335,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.885,
      "end_time": 19.155,
      "transcript": "ਨਾ ਮਨੁ ਮਰੈ, ਨ ਕਾਰਜੁ ਹੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.155,
      "end_time": 25.47,
      "transcript": "ਮਨੁ ਵਸਿ ਦੂਤਾ, ਦੁਰਮਤਿ ਦੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.47,
      "end_time": 31.87,
      "transcript": "ਮਨੁ ਮਾਨੈ, ਗੁਰ ਤੇ ਇਕੁ ਹੋਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.87,
      "end_time": 37.745,
      "transcript": "ਨਿਰਗੁਣ ਰਾਮੁ, ਗੁਣਹ ਵਸਿ ਹੋਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 38.395,
      "end_time": 47.625,
      "transcript": "ਆਪੁ ਨਿਵਾਰਿ, ਬੀਚਾਰੇ ਸੋਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.175,
      "end_time": 60.61,
      "transcript": "ਮਨੁ ਭੂਲੋ, ਬਹੁ ਚਿਤੈ ਵਿਕਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.61,
      "end_time": 67.045,
      "transcript": "ਮਨੁ ਭੂਲੋ, ਸਿਰਿ ਆਵੈ ਭਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 67.045,
      "end_time": 73.33,
      "transcript": "ਮਨੁ ਮਾਨੈ, ਹਰਿ ਏਕੰਕਾਰੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 73.33,
      "end_time": 79.96,
      "transcript": "ਮਨੁ ਭੂਲੋ, ਮਾਇਆ ਘਰਿ ਜਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.96,
      "end_time": 86.32,
      "transcript": "ਕਾਮਿ ਬਿਰੂਧਉ, ਰਹੈ ਨ ਠਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 86.32,
      "end_time": 92.61,
      "transcript": "ਹਰਿ ਭਜੁ ਪ੍ਰਾਣੀ, ਰਸਨ ਰਸਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 92.61,
      "end_time": 98.605,
      "transcript": "ਗੈਵਰ ਹੈਵਰ, ਕੰਚਨ ਸੁਤ ਨਾਰੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 99.065,
      "end_time": 105.065,
      "transcript": "ਬਹੁ ਚਿੰਤਾ, ਪਿੜ ਚਾਲੈ ਹਾਰੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 105.545,
      "end_time": 111.465,
      "transcript": "ਜੂਐ ਖੇਲਣੁ, ਕਾਚੀ ਸਾਰੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 111.975,
      "end_time": 117.995,
      "transcript": "ਸੰਪਉ ਸੰਚੀ, ਭਏ ਵਿਕਾਰ"
    },
    {
      "section_id": "section-00017",
      "start_time": 118.48,
      "end_time": 124.96,
      "transcript": "ਹਰਖ ਸੋਕ, ਉਭੇ ਦਰਵਾਰਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 124.96,
      "end_time": 131.155,
      "transcript": "ਸੁਖੁ ਸਹਜੇ, ਜਪਿ ਰਿਦੈ ਮੁਰਾਰਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 131.155,
      "end_time": 137.215,
      "transcript": "ਨਦਰਿ ਕਰੇ, ਤਾ ਮੇਲਿ ਮਿਲਾਏ"
    },
    {
      "section_id": "section-00020",
      "start_time": 137.695,
      "end_time": 144.02,
      "transcript": "ਗੁਣ ਸੰਗ੍ਰਹਿ, ਅਉਗਣ ਸਬਦਿ ਜਲਾਏ"
    },
    {
      "section_id": "section-00021",
      "start_time": 144.02,
      "end_time": 150.405,
      "transcript": "ਗੁਰਮੁਖਿ, ਨਾਮੁ ਪਦਾਰਥੁ ਪਾਏ"
    },
    {
      "section_id": "section-00022",
      "start_time": 150.405,
      "end_time": 156.855,
      "transcript": "ਬਿਨੁ ਨਾਵੈ, ਸਭ ਦੂਖ ਨਿਵਾਸੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 156.855,
      "end_time": 163.315,
      "transcript": "ਮਨਮੁਖ ਮੂੜ, ਮਾਇਆ ਚਿਤ ਵਾਸੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 163.315,
      "end_time": 169.72,
      "transcript": "ਗੁਰਮੁਖਿ ਗਿਆਨੁ, ਧੁਰਿ ਕਰਮਿ ਲਿਖਿਆਸੁ"
    },
    {
      "section_id": "section-00025",
      "start_time": 169.72,
      "end_time": 176.015,
      "transcript": "ਮਨੁ ਚੰਚਲੁ, ਧਾਵਤੁ ਫੁਨਿ ਧਾਵੈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 176.015,
      "end_time": 182.355,
      "transcript": "ਸਾਚੇ ਸੂਚੇ, ਮੈਲੁ ਨ ਭਾਵੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 182.355,
      "end_time": 188.285,
      "transcript": "ਨਾਨਕ, ਗੁਰਮੁਖਿ ਹਰਿ ਗੁਣ ਗਾਵੈ"
    }
  ]
}

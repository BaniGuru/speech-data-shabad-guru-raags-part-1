{
  "audio_file": "0217 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.759,
      "end_time": 11.665,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 18.84,
      "end_time": 25.735,
      "transcript": "ਸਰਗੁਨ ਨਿਰਗੁਨ ਨਿਰੰਕਾਰ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.88,
      "end_time": 32.175,
      "transcript": "ਸੁੰਨ ਸਮਾਧੀ ਆਪਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.655,
      "end_time": 39.275,
      "transcript": "ਆਪਨ ਕੀਆ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.415,
      "end_time": 50.693,
      "transcript": "ਆਪੇ ਹੀ ਫਿਰਿ ਜਾਪਿ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 57.08,
      "end_time": 63.705,
      "transcript": "ਜਬ ਅਕਾਰੁ ਇਹੁ, ਕਛੁ ਨ ਦ੍ਰਿਸਟੇਤਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.705,
      "end_time": 70.175,
      "transcript": "ਪਾਪ ਪੁੰਨ, ਤਬ ਕਹ ਤੇ ਹੋਤਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.175,
      "end_time": 76.84,
      "transcript": "ਜਬ ਧਾਰੀ, ਆਪਨ ਸੁੰਨ ਸਮਾਧਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 76.84,
      "end_time": 83.385,
      "transcript": "ਤਬ ਬੈਰ ਬਿਰੋਧ, ਕਿਸੁ ਸੰਗਿ ਕਮਾਤਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.385,
      "end_time": 90.08,
      "transcript": "ਜਬ ਇਸ ਕਾ, ਬਰਨੁ ਚਿਹਨੁ ਨ ਜਾਪਤ"
    },
    {
      "section_id": "section-00011",
      "start_time": 90.08,
      "end_time": 96.64,
      "transcript": "ਤਬ ਹਰਖ ਸੋਗ, ਕਹੁ ਕਿਸਹਿ ਬਿਆਪਤ"
    },
    {
      "section_id": "section-00012",
      "start_time": 96.64,
      "end_time": 103.24,
      "transcript": "ਜਬ ਆਪਨ ਆਪ, ਆਪਿ ਪਾਰਬ੍ਰਹਮ"
    },
    {
      "section_id": "section-00013",
      "start_time": 103.24,
      "end_time": 109.655,
      "transcript": "ਤਬ ਮੋਹ ਕਹਾ, ਕਿਸੁ ਹੋਵਤ ਭਰਮ"
    },
    {
      "section_id": "section-00014",
      "start_time": 109.855,
      "end_time": 116.275,
      "transcript": "ਆਪਨ ਖੇਲੁ, ਆਪਿ ਵਰਤੀਜਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 116.275,
      "end_time": 123.185,
      "transcript": "ਨਾਨਕ ਕਰਨੈਹਾਰੁ, ਨ ਦੂਜਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 129.32,
      "end_time": 135.776,
      "transcript": "ਜਬ ਹੋਵਤ, ਪ੍ਰਭ ਕੇਵਲ ਧਨੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 135.776,
      "end_time": 142.224,
      "transcript": "ਤਬ ਬੰਧ ਮੁਕਤਿ, ਕਹੁ ਕਿਸ ਕਉ ਗਨੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 142.224,
      "end_time": 148.68,
      "transcript": "ਜਬ ਏਕਹਿ, ਹਰਿ ਅਗਮ ਅਪਾਰ"
    },
    {
      "section_id": "section-00019",
      "start_time": 148.68,
      "end_time": 155.185,
      "transcript": "ਤਬ ਨਰਕ ਸੁਰਗ, ਕਹੁ ਕਉਨ ਅਉਤਾਰ"
    },
    {
      "section_id": "section-00020",
      "start_time": 155.185,
      "end_time": 161.84,
      "transcript": "ਜਬ ਨਿਰਗੁਨ ਪ੍ਰਭ, ਸਹਜ ਸੁਭਾਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 161.84,
      "end_time": 168.285,
      "transcript": "ਤਬ ਸਿਵ ਸਕਤਿ, ਕਹਹੁ ਕਿਤੁ ਠਾਇ"
    },
    {
      "section_id": "section-00022",
      "start_time": 168.285,
      "end_time": 174.88,
      "transcript": "ਜਬ ਆਪਹਿ ਆਪਿ, ਅਪਨੀ ਜੋਤਿ ਧਰੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 174.88,
      "end_time": 181.255,
      "transcript": "ਤਬ ਕਵਨ ਨਿਡਰੁ, ਕਵਨ ਕਤ ਡਰੈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 181.255,
      "end_time": 187.695,
      "transcript": "ਆਪਨ ਚਲਿਤ, ਆਪਿ ਕਰਨੈਹਾਰ"
    },
    {
      "section_id": "section-00025",
      "start_time": 187.695,
      "end_time": 194.255,
      "transcript": "ਨਾਨਕ, ਠਾਕੁਰ ਅਗਮ ਅਪਾਰ"
    },
    {
      "section_id": "section-00026",
      "start_time": 200.475,
      "end_time": 207.36,
      "transcript": "ਅਬਿਨਾਸੀ ਸੁਖ, ਆਪਨ ਆਸਨ"
    },
    {
      "section_id": "section-00027",
      "start_time": 207.36,
      "end_time": 213.81,
      "transcript": "ਤਹ ਜਨਮ ਮਰਨ, ਕਹੁ ਕਹਾ ਬਿਨਾਸਨ"
    },
    {
      "section_id": "section-00028",
      "start_time": 213.81,
      "end_time": 220.295,
      "transcript": "ਜਬ ਪੂਰਨ ਕਰਤਾ, ਪ੍ਰਭੁ ਸੋਇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 220.295,
      "end_time": 226.2,
      "transcript": "ਤਬ ਜਮ ਕੀ ਤ੍ਰਾਸ, ਕਹਹੁ ਕਿਸੁ ਹੋਇ"
    },
    {
      "section_id": "section-00030",
      "start_time": 226.2,
      "end_time": 233.2,
      "transcript": "ਜਬ ਅਬਿਗਤ, ਅਗੋਚਰ ਪ੍ਰਭ ਏਕਾ"
    },
    {
      "section_id": "section-00031",
      "start_time": 233.2,
      "end_time": 239.57,
      "transcript": "ਤਬ ਚਿਤ੍ਰ ਗੁਪਤ, ਕਿਸੁ ਪੂਛਤ ਲੇਖਾ"
    },
    {
      "section_id": "section-00032",
      "start_time": 239.57,
      "end_time": 246.06,
      "transcript": "ਜਬ ਨਾਥ ਨਿਰੰਜਨ, ਅਗੋਚਰ ਅਗਾਧੇ"
    },
    {
      "section_id": "section-00033",
      "start_time": 246.06,
      "end_time": 252.59,
      "transcript": "ਤਬ ਕਉਨ ਛੁਟੇ, ਕਉਨ ਬੰਧਨ ਬਾਧੇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 252.59,
      "end_time": 258.802,
      "transcript": "ਆਪਨ ਆਪ, ਆਪ ਹੀ ਅਚਰਜਾ"
    },
    {
      "section_id": "section-00035",
      "start_time": 258.802,
      "end_time": 265.526,
      "transcript": "ਨਾਨਕ ਆਪਨ ਰੂਪ, ਆਪ ਹੀ ਉਪਰਜਾ"
    },
    {
      "section_id": "section-00036",
      "start_time": 271.92,
      "end_time": 278.21,
      "transcript": "ਜਹ ਨਿਰਮਲ ਪੁਰਖੁ, ਪੁਰਖ ਪਤਿ ਹੋਤਾ"
    },
    {
      "section_id": "section-00037",
      "start_time": 278.21,
      "end_time": 284.605,
      "transcript": "ਤਹ ਬਿਨੁ ਮੈਲੁ, ਕਹਹੁ ਕਿਆ ਧੋਤਾ"
    },
    {
      "section_id": "section-00038",
      "start_time": 284.605,
      "end_time": 291.075,
      "transcript": "ਜਹ ਨਿਰੰਜਨ, ਨਿਰੰਕਾਰ ਨਿਰਬਾਨ"
    },
    {
      "section_id": "section-00039",
      "start_time": 291.075,
      "end_time": 297.375,
      "transcript": "ਤਹ ਕਉਨ ਕਉ ਮਾਨ, ਕਉਨ ਅਭਿਮਾਨ"
    },
    {
      "section_id": "section-00040",
      "start_time": 297.375,
      "end_time": 303.96,
      "transcript": "ਜਹ ਸਰੂਪ, ਕੇਵਲ ਜਗਦੀਸ"
    },
    {
      "section_id": "section-00041",
      "start_time": 303.96,
      "end_time": 310.4,
      "transcript": "ਤਹ ਛਲ ਛਿਦ੍ਰ, ਲਗਤ ਕਹੁ ਕੀਸ"
    },
    {
      "section_id": "section-00042",
      "start_time": 310.4,
      "end_time": 316.8,
      "transcript": "ਜਹ ਜੋਤਿ ਸਰੂਪੀ, ਜੋਤਿ ਸੰਗਿ ਸਮਾਵੈ"
    },
    {
      "section_id": "section-00043",
      "start_time": 316.8,
      "end_time": 323.28,
      "transcript": "ਤਹ ਕਿਸਹਿ ਭੂਖ, ਕਵਨੁ ਤ੍ਰਿਪਤਾਵੈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 323.28,
      "end_time": 329.51,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਕਰਨੈਹਾਰੁ"
    },
    {
      "section_id": "section-00045",
      "start_time": 329.51,
      "end_time": 335.945,
      "transcript": "ਨਾਨਕ ਕਰਤੇ ਕਾ, ਨਾਹਿ ਸੁਮਾਰੁ"
    },
    {
      "section_id": "section-00046",
      "start_time": 342.36,
      "end_time": 348.685,
      "transcript": "ਜਬ ਅਪਨੀ ਸੋਭਾ, ਆਪਨ ਸੰਗਿ ਬਨਾਈ"
    },
    {
      "section_id": "section-00047",
      "start_time": 348.685,
      "end_time": 355.025,
      "transcript": "ਤਬ ਕਵਨ ਮਾਇ ਬਾਪ, ਮਿਤ੍ਰ ਸੁਤ ਭਾਈ"
    },
    {
      "section_id": "section-00048",
      "start_time": 355.025,
      "end_time": 361.56,
      "transcript": "ਜਹ ਸਰਬ ਕਲਾ, ਆਪਹਿ ਪਰਬੀਨ"
    },
    {
      "section_id": "section-00049",
      "start_time": 361.56,
      "end_time": 367.633,
      "transcript": "ਤਹ ਬੇਦ ਕਤੇਬ, ਕਹਾ ਕੋਊ ਚੀਨ"
    },
    {
      "section_id": "section-00050",
      "start_time": 367.633,
      "end_time": 374.315,
      "transcript": "ਜਬ ਆਪਨ ਆਪੁ, ਆਪਿ ਉਰਿ ਧਾਰੈ"
    },
    {
      "section_id": "section-00051",
      "start_time": 374.315,
      "end_time": 380.68,
      "transcript": "ਤਉ ਸਗਨ ਅਪਸਗਨ, ਕਹਾ ਬੀਚਾਰੈ"
    },
    {
      "section_id": "section-00052",
      "start_time": 380.68,
      "end_time": 387.0,
      "transcript": "ਜਹ ਆਪਨ ਊਚ, ਆਪਨ ਆਪਿ ਨੇਰਾ"
    },
    {
      "section_id": "section-00053",
      "start_time": 387.0,
      "end_time": 393.4,
      "transcript": "ਤਹ ਕਉਨ ਠਾਕੁਰੁ, ਕਉਨੁ ਕਹੀਐ ਚੇਰਾ"
    },
    {
      "section_id": "section-00054",
      "start_time": 393.4,
      "end_time": 399.645,
      "transcript": "ਬਿਸਮਨ ਬਿਸਮ, ਰਹੇ ਬਿਸਮਾਦ"
    },
    {
      "section_id": "section-00055",
      "start_time": 399.645,
      "end_time": 406.065,
      "transcript": "ਨਾਨਕ ਅਪਨੀ ਗਤਿ, ਜਾਨਹੁ ਆਪਿ"
    },
    {
      "section_id": "section-00056",
      "start_time": 412.52,
      "end_time": 418.805,
      "transcript": "ਜਹ ਅਛਲ ਅਛੇਦ, ਅਭੇਦ ਸਮਾਇਆ"
    },
    {
      "section_id": "section-00057",
      "start_time": 418.805,
      "end_time": 425.185,
      "transcript": "ਊਹਾ, ਕਿਸਹਿ ਬਿਆਪਤ ਮਾਇਆ"
    },
    {
      "section_id": "section-00058",
      "start_time": 425.185,
      "end_time": 431.56,
      "transcript": "ਆਪਸ ਕਉ, ਆਪਹਿ ਆਦੇਸੁ"
    },
    {
      "section_id": "section-00059",
      "start_time": 431.56,
      "end_time": 438.04,
      "transcript": "ਤਿਹੁ ਗੁਣ ਕਾ, ਨਾਹੀ ਪਰਵੇਸੁ"
    },
    {
      "section_id": "section-00060",
      "start_time": 438.04,
      "end_time": 444.405,
      "transcript": "ਜਹ ਏਕਹਿ ਏਕ, ਏਕ ਭਗਵੰਤਾ"
    },
    {
      "section_id": "section-00061",
      "start_time": 444.405,
      "end_time": 450.81,
      "transcript": "ਤਹ ਕਉਨੁ ਅਚਿੰਤੁ, ਕਿਸੁ ਲਾਗੈ ਚਿੰਤਾ"
    },
    {
      "section_id": "section-00062",
      "start_time": 450.81,
      "end_time": 457.24,
      "transcript": "ਜਹ ਆਪਨ ਆਪੁ, ਆਪਿ ਪਤੀਆਰਾ"
    },
    {
      "section_id": "section-00063",
      "start_time": 457.24,
      "end_time": 463.535,
      "transcript": "ਤਹ ਕਉਨੁ ਕਥੈ, ਕਉਨੁ ਸੁਨਨੈਹਾਰਾ"
    },
    {
      "section_id": "section-00064",
      "start_time": 463.535,
      "end_time": 469.915,
      "transcript": "ਬਹੁ ਬੇਅੰਤ, ਊਚ ਤੇ ਊਚਾ"
    },
    {
      "section_id": "section-00065",
      "start_time": 469.915,
      "end_time": 476.295,
      "transcript": "ਨਾਨਕ ਆਪਸ ਕਉ, ਆਪਹਿ ਪਹੂਚਾ"
    },
    {
      "section_id": "section-00066",
      "start_time": 482.92,
      "end_time": 489.305,
      "transcript": "ਜਹ ਆਪਿ ਰਚਿਓ, ਪਰਪੰਚੁ ਅਕਾਰੁ"
    },
    {
      "section_id": "section-00067",
      "start_time": 489.305,
      "end_time": 495.625,
      "transcript": "ਤਿਹੁ ਗੁਣ ਮਹਿ, ਕੀਨੋ ਬਿਸਥਾਰੁ"
    },
    {
      "section_id": "section-00068",
      "start_time": 495.625,
      "end_time": 502.05,
      "transcript": "ਪਾਪੁ ਪੁੰਨੁ, ਤਹ ਭਈ ਕਹਾਵਤ"
    },
    {
      "section_id": "section-00069",
      "start_time": 502.05,
      "end_time": 508.38,
      "transcript": "ਕੋਊ ਨਰਕ, ਕੋਊ ਸੁਰਗ ਬੰਛਾਵਤ"
    },
    {
      "section_id": "section-00070",
      "start_time": 508.38,
      "end_time": 514.905,
      "transcript": "ਆਲ ਜਾਲ, ਮਾਇਆ ਜੰਜਾਲ"
    },
    {
      "section_id": "section-00071",
      "start_time": 514.905,
      "end_time": 521.26,
      "transcript": "ਹਉਮੈ ਮੋਹ, ਭਰਮ ਭੈ ਭਾਰ"
    },
    {
      "section_id": "section-00072",
      "start_time": 521.26,
      "end_time": 527.76,
      "transcript": "ਦੂਖ ਸੂਖ, ਮਾਨ ਅਪਮਾਨ"
    },
    {
      "section_id": "section-00073",
      "start_time": 527.76,
      "end_time": 533.934,
      "transcript": "ਅਨਿਕ ਪ੍ਰਕਾਰ, ਕੀਓ ਬਖੵਾਨ"
    },
    {
      "section_id": "section-00074",
      "start_time": 533.934,
      "end_time": 540.37,
      "transcript": "ਆਪਨ ਖੇਲੁ, ਆਪਿ ਕਰਿ ਦੇਖੈ"
    },
    {
      "section_id": "section-00075",
      "start_time": 540.37,
      "end_time": 546.725,
      "transcript": "ਖੇਲੁ ਸੰਕੋਚੈ, ਤਉ ਨਾਨਕ ਏਕੈ"
    },
    {
      "section_id": "section-00076",
      "start_time": 553.015,
      "end_time": 559.51,
      "transcript": "ਜਹ ਅਬਿਗਤੁ, ਭਗਤੁ ਤਹ ਆਪਿ"
    },
    {
      "section_id": "section-00077",
      "start_time": 559.51,
      "end_time": 565.815,
      "transcript": "ਜਹ ਪਸਰੈ ਪਾਸਾਰੁ, ਸੰਤ ਪਰਤਾਪਿ"
    },
    {
      "section_id": "section-00078",
      "start_time": 565.815,
      "end_time": 572.277,
      "transcript": "ਦੁਹੂ ਪਾਖ ਕਾ, ਆਪਹਿ ਧਨੀ"
    },
    {
      "section_id": "section-00079",
      "start_time": 572.277,
      "end_time": 578.595,
      "transcript": "ਉਨ ਕੀ ਸੋਭਾ, ਉਨਹੂ ਬਨੀ"
    },
    {
      "section_id": "section-00080",
      "start_time": 578.735,
      "end_time": 585.225,
      "transcript": "ਆਪਹਿ ਕਉਤਕ ਕਰੈ, ਅਨਦ ਚੋਜ"
    },
    {
      "section_id": "section-00081",
      "start_time": 585.225,
      "end_time": 591.6,
      "transcript": "ਆਪਹਿ ਰਸ ਭੋਗਨ, ਨਿਰਜੋਗ"
    },
    {
      "section_id": "section-00082",
      "start_time": 591.6,
      "end_time": 598.08,
      "transcript": "ਜਿਸੁ ਭਾਵੈ, ਤਿਸੁ ਆਪਨ ਨਾਇ ਲਾਵੈ"
    },
    {
      "section_id": "section-00083",
      "start_time": 598.08,
      "end_time": 604.253,
      "transcript": "ਜਿਸੁ ਭਾਵੈ, ਤਿਸੁ ਖੇਲ ਖਿਲਾਵੈ"
    },
    {
      "section_id": "section-00084",
      "start_time": 604.253,
      "end_time": 610.725,
      "transcript": "ਬੇਸੁਮਾਰ ਅਥਾਹ, ਅਗਨਤ ਅਤੋਲੈ"
    },
    {
      "section_id": "section-00085",

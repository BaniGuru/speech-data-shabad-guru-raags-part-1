  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.56,
      "end_time": 6.095,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.68,
      "end_time": 19.905,
      "transcript": "ਸਤਿਗੁਰਿ ਪੂਰੈ ਸੇਵਿਐ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.385,
      "end_time": 26.755,
      "transcript": "ਦੂਖਾ ਕਾ ਹੋਇ ਨਾਸੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.225,
      "end_time": 33.505,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਅਰਾਧਿਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.04,
      "end_time": 40.43,
      "transcript": "ਕਾਰਜੁ ਆਵੈ ਰਾਸਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 40.43,
      "end_time": 43.925,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.625,
      "end_time": 56.925,
      "transcript": "ਜਿਸੁ ਸਿਮਰਤ ਸੰਕਟ ਛੁਟਹਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.36,
      "end_time": 63.535,
      "transcript": "ਅਨਦ ਮੰਗਲ ਬਿਸ੍ਰਾਮ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.985,
      "end_time": 70.56,
      "transcript": "ਨਾਨਕ ਜਪੀਐ ਸਦਾ ਹਰਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.56,
      "end_time": 76.725,
      "transcript": "ਨਿਮਖ ਨ ਬਿਸਰਉ ਨਾਮੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 77.24,
      "end_time": 80.165,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 80.52,
      "end_time": 88.815,
      "transcript": "ਤਿਨ ਕੀ ਸੋਭਾ ਕਿਆ ਗਣੀ, ਜਿਨੀ ਹਰਿ ਹਰਿ ਲਧਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 89.2,
      "end_time": 97.285,
      "transcript": "ਸਾਧਾ ਸਰਣੀ ਜੋ ਪਵੈ, ਸੋ ਛੁਟੈ ਬਧਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 97.56,
      "end_time": 105.775,
      "transcript": "ਗੁਣ ਗਾਵੈ ਅਬਿਨਾਸੀਐ, ਜੋਨਿ ਗਰਭਿ ਨ ਦਧਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 106.24,
      "end_time": 114.355,
      "transcript": "ਗੁਰੁ ਭੇਟਿਆ ਪਾਰਬ੍ਰਹਮੁ ਹਰਿ, ਪੜਿ ਬੁਝਿ ਸਮਧਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 114.64,
      "end_time": 123.785,
      "transcript": "ਨਾਨਕ ਪਾਇਆ ਸੋ ਧਣੀ, ਹਰਿ ਅਗਮ ਅਗਧਾ"
    }
  ]
}

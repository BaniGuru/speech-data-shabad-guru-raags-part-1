{
  "audio_file": "0242 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.145,
      "end_time": 7.488,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.455,
      "end_time": 21.24,
      "transcript": "ਬਿਖਿਆ ਬਿਆਪਿਆ, ਸਗਲ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.24,
      "end_time": 28.36,
      "transcript": "ਬਿਖਿਆ, ਲੈ ਡੂਬੀ ਪਰਵਾਰੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.36,
      "end_time": 35.56,
      "transcript": "ਰੇ ਨਰ, ਨਾਵ ਚਉੜਿ ਕਤ ਬੋੜੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.56,
      "end_time": 42.785,
      "transcript": "ਹਰਿ ਸਿਉ ਤੋੜਿ, ਬਿਖਿਆ ਸੰਗਿ ਜੋੜੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.995,
      "end_time": 57.32,
      "transcript": "ਸੁਰਿ ਨਰ ਦਾਧੇ, ਲਾਗੀ ਆਗਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.32,
      "end_time": 64.455,
      "transcript": "ਨਿਕਟਿ ਨੀਰੁ, ਪਸੁ ਪੀਵਸਿ ਨ ਝਾਗਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.455,
      "end_time": 71.72,
      "transcript": "ਚੇਤਤ ਚੇਤਤ, ਨਿਕਸਿਓ ਨੀਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.72,
      "end_time": 78.187,
      "transcript": "ਸੋ ਜਲੁ ਨਿਰਮਲੁ, ਕਥਤ ਕਬੀਰੁ"
    }
  ]
}

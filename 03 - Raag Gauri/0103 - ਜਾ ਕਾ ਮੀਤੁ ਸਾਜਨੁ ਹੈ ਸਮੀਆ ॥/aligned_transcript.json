{
  "audio_file": "0140 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.205,
      "end_time": 7.333,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.36,
      "end_time": 21.22,
      "transcript": "ਜਾ ਕਾ ਮੀਤੁ, ਸਾਜਨੁ ਹੈ ਸਮੀਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.22,
      "end_time": 28.697,
      "transcript": "ਤਿਸੁ ਜਨ ਕਉ, ਕਹੁ ਕਾ ਕੀ ਕਮੀਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.64,
      "end_time": 42.6,
      "transcript": "ਜਾ ਕੀ ਪ੍ਰੀਤਿ, ਗੋਬਿੰਦ ਸਿਉ ਲਾਗੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.6,
      "end_time": 49.48,
      "transcript": "ਦੂਖੁ ਦਰਦੁ ਭ੍ਰਮੁ, ਤਾ ਕਾ ਭਾਗੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.48,
      "end_time": 74.455,
      "transcript": "ਜਾ ਕਉ ਰਸੁ ਹਰਿ ਰਸੁ, ਹੈ ਆਇਓ"
    },
    {
      "section_id": "section-00007",
      "start_time": 74.455,
      "end_time": 81.565,
      "transcript": "ਸੋ ਅਨ ਰਸ, ਨਾਹੀ ਲਪਟਾਇਓ"
    },
    {
      "section_id": "section-00008",
      "start_time": 81.565,
      "end_time": 88.84,
      "transcript": "ਜਾ ਕਾ ਕਹਿਆ, ਦਰਗਹ ਚਲੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 88.84,
      "end_time": 95.855,
      "transcript": "ਸੋ ਕਿਸ ਕਉ, ਨਦਰਿ ਲੈ ਆਵੈ ਤਲੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 95.855,
      "end_time": 102.8,
      "transcript": "ਜਾ ਕਾ ਸਭੁ ਕਿਛੁ, ਤਾ ਕਾ ਹੋਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 102.8,
      "end_time": 109.455,
      "transcript": "ਨਾਨਕ ਤਾ ਕਉ, ਸਦਾ ਸੁਖੁ ਹੋਇ"
    }
  ]
}

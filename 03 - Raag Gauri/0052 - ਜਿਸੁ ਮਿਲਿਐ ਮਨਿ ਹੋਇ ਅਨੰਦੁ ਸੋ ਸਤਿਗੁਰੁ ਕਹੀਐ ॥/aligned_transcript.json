  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.167,
      "end_time": 16.851,
      "transcript": "ਗਉੜੀ ਬੈਰਾਗਣਿ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 29.79,
      "end_time": 37.829,
      "transcript": "ਜਿਸੁ ਮਿਲਿਐ ਮਨਿ ਹੋਇ ਅਨੰਦੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 37.829,
      "end_time": 45.565,
      "transcript": "ਸੋ ਸਤਿਗੁਰੁ ਕਹੀਐ"
    },
    {
      "section_id": "section-00004",
      "start_time": 45.565,
      "end_time": 53.372,
      "transcript": "ਮਨ ਕੀ ਦੁਬਿਧਾ ਬਿਨਸਿ ਜਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.372,
      "end_time": 61.001,
      "transcript": "ਹਰਿ ਪਰਮ ਪਦੁ ਲਹੀਐ"
    },
    {
      "section_id": "section-00006",
      "start_time": 61.001,
      "end_time": 69.23,
      "transcript": "ਮੇਰਾ ਸਤਿਗੁਰੁ ਪਿਆਰਾ, ਕਿਤੁ ਬਿਧਿ ਮਿਲੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 69.23,
      "end_time": 76.542,
      "transcript": "ਹਉ ਖਿਨੁ ਖਿਨੁ ਕਰੀ ਨਮਸਕਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.542,
      "end_time": 84.642,
      "transcript": "ਮੇਰਾ ਗੁਰੁ ਪੂਰਾ ਕਿਉ ਮਿਲੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 88.0,
      "end_time": 95.984,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਹਰਿ ਮੇਲਿਆ, ਮੇਰਾ ਸਤਿਗੁਰੁ ਪੂਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 95.984,
      "end_time": 103.008,
      "transcript": "ਇਛ ਪੁੰਨੀ ਜਨ ਕੇਰੀਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 103.008,
      "end_time": 110.365,
      "transcript": "ਲੇ ਸਤਿਗੁਰ ਧੂਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 110.365,
      "end_time": 118.385,
      "transcript": "ਹਰਿ ਭਗਤਿ ਦ੍ਰਿੜਾਵੈ ਹਰਿ ਭਗਤਿ ਸੁਣੈ ਤਿਸੁ ਸਤਿਗੁਰ ਮਿਲੀਐ"
    },
    {
      "section_id": "section-00013",
      "start_time": 118.385,
      "end_time": 125.47,
      "transcript": "ਤੋਟਾ ਮੂਲਿ ਨ ਆਵਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 125.47,
      "end_time": 132.988,
      "transcript": "ਹਰਿ ਲਾਭੁ ਨਿਤਿ ਦ੍ਰਿੜੀਐ"
    },
    {
      "section_id": "section-00015",
      "start_time": 132.988,
      "end_time": 140.817,
      "transcript": "ਜਿਸ ਕਉ ਰਿਦੈ ਵਿਗਾਸੁ ਹੈ, ਭਾਉ ਦੂਜਾ ਨਾਹੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 140.817,
      "end_time": 148.08,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਗੁਰ ਮਿਲਿ ਉਧਰੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 148.08,
      "end_time": 155.991,
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਵਾਹੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 159.067,
      "end_time": 168.369,
      "transcript": "ਹਰਿ ਗੁਣ ਗਾਵਾਹੀ"
    }
  ]
}

{
  "audio_file": "0145 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 16.275,
      "end_time": 22.495,
      "transcript": "ਗੁਰ ਕਾ ਸਬਦੁ, ਰਾਖੁ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00002",
      "start_time": 22.84,
      "end_time": 29.17,
      "transcript": "ਨਾਮੁ ਸਿਮਰਿ, ਚਿੰਤਾ ਸਭ ਜਾਹਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 29.17,
      "end_time": 35.365,
      "transcript": "ਬਿਨੁ ਭਗਵੰਤ, ਨਾਹੀ ਅਨ ਕੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.72,
      "end_time": 45.315,
      "transcript": "ਮਾਰੈ ਰਾਖੈ, ਏਕੋ ਸੋਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 51.895,
      "end_time": 58.405,
      "transcript": "ਗੁਰ ਕੇ ਚਰਣ, ਰਿਦੈ ਉਰਿ ਧਾਰਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.405,
      "end_time": 64.885,
      "transcript": "ਅਗਨਿ ਸਾਗਰੁ, ਜਪਿ ਉਤਰਹਿ ਪਾਰਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 65.025,
      "end_time": 71.625,
      "transcript": "ਗੁਰ ਮੂਰਤਿ ਸਿਉ, ਲਾਇ ਧਿਆਨੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 71.625,
      "end_time": 78.155,
      "transcript": "ਈਹਾ ਊਹਾ, ਪਾਵਹਿ ਮਾਨੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 78.155,
      "end_time": 84.88,
      "transcript": "ਸਗਲ ਤਿਆਗਿ, ਗੁਰ ਸਰਣੀ ਆਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 84.88,
      "end_time": 91.165,
      "transcript": "ਮਿਟੇ ਅੰਦੇਸੇ, ਨਾਨਕ ਸੁਖੁ ਪਾਇਆ"
    }
  ]
}

{
  "audio_file": "0211 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.055,
      "end_time": 12.264,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 22.04,
      "end_time": 29.995,
      "transcript": "ਸਰਬ ਕਲਾ ਭਰਪੂਰ ਪ੍ਰਭ"
    },
    {
      "section_id": "section-00003",
      "start_time": 29.995,
      "end_time": 38.145,
      "transcript": "ਬਿਰਥਾ ਜਾਨਨਹਾਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.145,
      "end_time": 45.675,
      "transcript": "ਜਾ ਕੈ ਸਿਮਰਨਿ ਉਧਰੀਐ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.135,
      "end_time": 57.415,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਬਲਿਹਾਰ ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 67.88,
      "end_time": 75.6,
      "transcript": "ਟੂਟੀ ਗਾਢਨਹਾਰ ਗੁੋਪਾਲ"
    },
    {
      "section_id": "section-00007",
      "start_time": 75.6,
      "end_time": 82.955,
      "transcript": "ਸਰਬ ਜੀਆ ਆਪੇ ਪ੍ਰਤਿਪਾਲ"
    },
    {
      "section_id": "section-00008",
      "start_time": 82.955,
      "end_time": 90.68,
      "transcript": "ਸਗਲ ਕੀ ਚਿੰਤਾ, ਜਿਸੁ ਮਨ ਮਾਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 90.68,
      "end_time": 98.025,
      "transcript": "ਤਿਸ ਤੇ, ਬਿਰਥਾ ਕੋਈ ਨਾਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 98.025,
      "end_time": 105.76,
      "transcript": "ਰੇ ਮਨ ਮੇਰੇ, ਸਦਾ ਹਰਿ ਜਾਪਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 105.76,
      "end_time": 113.025,
      "transcript": "ਅਬਿਨਾਸੀ ਪ੍ਰਭੁ, ਆਪੇ ਆਪਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 113.465,
      "end_time": 121.04,
      "transcript": "ਆਪਨ ਕੀਆ, ਕਛੂ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 121.04,
      "end_time": 128.6,
      "transcript": "ਜੇ ਸਉ ਪ੍ਰਾਨੀ ਲੋਚੈ ਕੋਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 128.6,
      "end_time": 135.865,
      "transcript": "ਤਿਸੁ ਬਿਨੁ, ਨਾਹੀ ਤੇਰੈ ਕਿਛੁ ਕਾਮ"
    },
    {
      "section_id": "section-00015",
      "start_time": 135.865,
      "end_time": 143.315,
      "transcript": "ਗਤਿ ਨਾਨਕ, ਜਪਿ ਏਕ ਹਰਿ ਨਾਮ"
    },
    {
      "section_id": "section-00016",
      "start_time": 150.875,
      "end_time": 158.28,
      "transcript": "ਰੂਪਵੰਤੁ ਹੋਇ, ਨਾਹੀ ਮੋਹੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 158.28,
      "end_time": 165.76,
      "transcript": "ਪ੍ਰਭ ਕੀ ਜੋਤਿ, ਸਗਲ ਘਟ ਸੋਹੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 165.76,
      "end_time": 172.755,
      "transcript": "ਧਨਵੰਤਾ ਹੋਇ, ਕਿਆ ਕੋ ਗਰਬੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 172.755,
      "end_time": 180.235,
      "transcript": "ਜਾ ਸਭੁ ਕਿਛੁ, ਤਿਸ ਕਾ ਦੀਆ ਦਰਬੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 180.235,
      "end_time": 187.56,
      "transcript": "ਅਤਿ ਸੂਰਾ, ਜੇ ਕੋਊ ਕਹਾਵੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 187.56,
      "end_time": 194.86,
      "transcript": "ਪ੍ਰਭ ਕੀ ਕਲਾ ਬਿਨਾ, ਕਹ ਧਾਵੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 194.86,
      "end_time": 202.105,
      "transcript": "ਜੇ ਕੋ ਹੋਇ ਬਹੈ, ਦਾਤਾਰੁ"
    },
    {
      "section_id": "section-00023",
      "start_time": 202.105,
      "end_time": 209.24,
      "transcript": "ਤਿਸੁ ਦੇਨਹਾਰੁ, ਜਾਨੈ ਗਾਵਾਰੁ"
    },
    {
      "section_id": "section-00024",
      "start_time": 209.24,
      "end_time": 216.145,
      "transcript": "ਜਿਸੁ ਗੁਰ ਪ੍ਰਸਾਦਿ, ਤੂਟੈ ਹਉ ਰੋਗੁ"
    },
    {
      "section_id": "section-00025",
      "start_time": 216.145,
      "end_time": 223.155,
      "transcript": "ਨਾਨਕ ਸੋ ਜਨੁ, ਸਦਾ ਅਰੋਗੁ"
    },
    {
      "section_id": "section-00026",
      "start_time": 230.345,
      "end_time": 237.48,
      "transcript": "ਜਿਉ ਮੰਦਰ ਕਉ, ਥਾਮੈ ਥੰਮਨੁ"
    },
    {
      "section_id": "section-00027",
      "start_time": 237.48,
      "end_time": 244.415,
      "transcript": "ਤਿਉ ਗੁਰ ਕਾ ਸਬਦੁ, ਮਨਹਿ ਅਸਥੰਮਨੁ"
    },
    {
      "section_id": "section-00028",
      "start_time": 244.415,
      "end_time": 251.525,
      "transcript": "ਜਿਉ ਪਾਖਾਣੁ, ਨਾਵ ਚੜਿ ਤਰੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 251.525,
      "end_time": 258.495,
      "transcript": "ਪ੍ਰਾਣੀ ਗੁਰ ਚਰਣ ਲਗਤੁ, ਨਿਸਤਰੈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 258.495,
      "end_time": 265.64,
      "transcript": "ਜਿਉ ਅੰਧਕਾਰ, ਦੀਪਕ ਪਰਗਾਸੁ"
    },
    {
      "section_id": "section-00031",
      "start_time": 265.64,
      "end_time": 272.485,
      "transcript": "ਗੁਰ ਦਰਸਨੁ ਦੇਖਿ, ਮਨਿ ਹੋਇ ਬਿਗਾਸੁ"
    },
    {
      "section_id": "section-00032",
      "start_time": 272.485,
      "end_time": 279.68,
      "transcript": "ਜਿਉ ਮਹਾ ਉਦਿਆਨ ਮਹਿ, ਮਾਰਗੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00033",
      "start_time": 279.68,
      "end_time": 286.72,
      "transcript": "ਤਿਉ ਸਾਧੂ ਸੰਗਿ ਮਿਲਿ, ਜੋਤਿ ਪ੍ਰਗਟਾਵੈ"
    },
    {
      "section_id": "section-00034",
      "start_time": 286.72,
      "end_time": 293.435,
      "transcript": "ਤਿਨ ਸੰਤਨ ਕੀ, ਬਾਛਉ ਧੂਰਿ"
    },
    {
      "section_id": "section-00035",
      "start_time": 293.435,
      "end_time": 300.455,
      "transcript": "ਨਾਨਕ ਕੀ ਹਰਿ ਲੋਚਾ ਪੂਰਿ"
    },
    {
      "section_id": "section-00036",
      "start_time": 307.575,
      "end_time": 314.68,
      "transcript": "ਮਨ ਮੂਰਖ, ਕਾਹੇ ਬਿਲਲਾਈਐ"
    },
    {
      "section_id": "section-00037",
      "start_time": 314.68,
      "end_time": 321.325,
      "transcript": "ਪੁਰਬ ਲਿਖੇ ਕਾ, ਲਿਖਿਆ ਪਾਈਐ"
    },
    {
      "section_id": "section-00038",
      "start_time": 321.325,
      "end_time": 328.72,
      "transcript": "ਦੂਖ ਸੂਖ, ਪ੍ਰਭ ਦੇਵਨਹਾਰੁ"
    },
    {
      "section_id": "section-00039",
      "start_time": 328.72,
      "end_time": 335.565,
      "transcript": "ਅਵਰ ਤਿਆਗਿ, ਤੂ ਤਿਸਹਿ ਚਿਤਾਰੁ"
    },
    {
      "section_id": "section-00040",
      "start_time": 335.565,
      "end_time": 342.88,
      "transcript": "ਜੋ ਕਛੁ ਕਰੈ, ਸੋਈ ਸੁਖੁ ਮਾਨੁ"
    },
    {
      "section_id": "section-00041",
      "start_time": 342.88,
      "end_time": 349.96,
      "transcript": "ਭੂਲਾ ਕਾਹੇ ਫਿਰਹਿ, ਅਜਾਨ"
    },
    {
      "section_id": "section-00042",
      "start_time": 349.96,
      "end_time": 356.795,
      "transcript": "ਕਉਨ ਬਸਤੁ, ਆਈ ਤੇਰੈ ਸੰਗ"
    },
    {
      "section_id": "section-00043",
      "start_time": 356.795,
      "end_time": 363.675,
      "transcript": "ਲਪਟਿ ਰਹਿਓ ਰਸਿ, ਲੋਭੀ ਪਤੰਗ"
    },
    {
      "section_id": "section-00044",
      "start_time": 363.675,
      "end_time": 370.74,
      "transcript": "ਰਾਮ ਨਾਮ, ਜਪਿ ਹਿਰਦੇ ਮਾਹਿ"
    },
    {
      "section_id": "section-00045",
      "start_time": 370.74,
      "end_time": 377.725,
      "transcript": "ਨਾਨਕ, ਪਤਿ ਸੇਤੀ ਘਰਿ ਜਾਹਿ"
    },
    {
      "section_id": "section-00046",
      "start_time": 384.88,
      "end_time": 391.745,
      "transcript": "ਜਿਸੁ ਵਖਰ ਕਉ, ਲੈਨਿ ਤੂ ਆਇਆ"
    },
    {
      "section_id": "section-00047",
      "start_time": 391.745,
      "end_time": 398.81,
      "transcript": "ਰਾਮ ਨਾਮੁ, ਸੰਤਨ ਘਰਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00048",
      "start_time": 398.81,
      "end_time": 405.74,
      "transcript": "ਤਜਿ ਅਭਿਮਾਨੁ, ਲੇਹੁ ਮਨ ਮੋਲਿ"
    },
    {
      "section_id": "section-00049",
      "start_time": 405.74,
      "end_time": 412.755,
      "transcript": "ਰਾਮ ਨਾਮੁ, ਹਿਰਦੇ ਮਹਿ ਤੋਲਿ"
    },
    {
      "section_id": "section-00050",
      "start_time": 412.755,
      "end_time": 419.96,
      "transcript": "ਲਾਦਿ ਖੇਪ, ਸੰਤਹ ਸੰਗਿ ਚਾਲੁ"
    },
    {
      "section_id": "section-00051",
      "start_time": 419.96,
      "end_time": 426.95,
      "transcript": "ਅਵਰ ਤਿਆਗਿ, ਬਿਖਿਆ ਜੰਜਾਲ"
    },
    {
      "section_id": "section-00052",
      "start_time": 426.95,
      "end_time": 433.885,
      "transcript": "ਧੰਨਿ ਧੰਨਿ, ਕਹੈ ਸਭੁ ਕੋਇ"
    },
    {
      "section_id": "section-00053",
      "start_time": 433.885,
      "end_time": 440.925,
      "transcript": "ਮੁਖ ਊਜਲ, ਹਰਿ ਦਰਗਹ ਸੋਇ"
    },
    {
      "section_id": "section-00054",
      "start_time": 440.925,
      "end_time": 447.9,
      "transcript": "ਇਹੁ ਵਾਪਾਰੁ, ਵਿਰਲਾ ਵਾਪਾਰੈ"
    },
    {
      "section_id": "section-00055",
      "start_time": 447.9,
      "end_time": 454.855,
      "transcript": "ਨਾਨਕ ਤਾ ਕੈ, ਸਦ ਬਲਿਹਾਰੈ"
    },
    {
      "section_id": "section-00056",
      "start_time": 461.96,
      "end_time": 468.96,
      "transcript": "ਚਰਨ ਸਾਧ ਕੇ, ਧੋਇ ਧੋਇ ਪੀਉ"
    },
    {
      "section_id": "section-00057",
      "start_time": 468.96,
      "end_time": 475.495,
      "transcript": "ਅਰਪਿ ਸਾਧ ਕਉ, ਅਪਨਾ ਜੀਉ"
    },
    {
      "section_id": "section-00058",
      "start_time": 475.96,
      "end_time": 482.65,
      "transcript": "ਸਾਧ ਕੀ ਧੂਰਿ, ਕਰਹੁ ਇਸਨਾਨੁ"
    },
    {
      "section_id": "section-00059",
      "start_time": 482.65,
      "end_time": 489.655,
      "transcript": "ਸਾਧ ਊਪਰਿ, ਜਾਈਐ ਕੁਰਬਾਨੁ"
    },
    {
      "section_id": "section-00060",
      "start_time": 489.655,
      "end_time": 497.0,
      "transcript": "ਸਾਧ ਸੇਵਾ, ਵਡਭਾਗੀ ਪਾਈਐ"
    },
    {
      "section_id": "section-00061",
      "start_time": 497.0,
      "end_time": 504.04,
      "transcript": "ਸਾਧਸੰਗਿ, ਹਰਿ ਕੀਰਤਨੁ ਗਾਈਐ"
    },
    {
      "section_id": "section-00062",
      "start_time": 504.04,
      "end_time": 511.04,
      "transcript": "ਅਨਿਕ ਬਿਘਨ ਤੇ, ਸਾਧੂ ਰਾਖੈ"
    },
    {
      "section_id": "section-00063",
      "start_time": 511.04,
      "end_time": 517.865,
      "transcript": "ਹਰਿ ਗੁਨ ਗਾਇ, ਅੰਮ੍ਰਿਤ ਰਸੁ ਚਾਖੈ"
    },
    {
      "section_id": "section-00064",
      "start_time": 517.865,
      "end_time": 524.88,
      "transcript": "ਓਟ ਗਹੀ, ਸੰਤਹ ਦਰਿ ਆਇਆ"
    },
    {
      "section_id": "section-00065",
      "start_time": 524.88,
      "end_time": 531.725,
      "transcript": "ਸਰਬ ਸੂਖ, ਨਾਨਕ ਤਿਹ ਪਾਇਆ"
    },
    {
      "section_id": "section-00066",
      "start_time": 538.675,
      "end_time": 545.75,
      "transcript": "ਮਿਰਤਕ ਕਉ, ਜੀਵਾਲਨਹਾਰ"
    },
    {
      "section_id": "section-00067",
      "start_time": 545.75,
      "end_time": 552.435,
      "transcript": "ਭੂਖੇ ਕਉ, ਦੇਵਤ ਅਧਾਰ"
    },
    {
      "section_id": "section-00068",
      "start_time": 552.435,
      "end_time": 559.56,
      "transcript": "ਸਰਬ ਨਿਧਾਨ, ਜਾ ਕੀ ਦ੍ਰਿਸਟੀ ਮਾਹਿ"
    },
    {
      "section_id": "section-00069",
      "start_time": 559.56,
      "end_time": 566.44,
      "transcript": "ਪੁਰਬ ਲਿਖੇ ਕਾ, ਲਹਣਾ ਪਾਹਿ"
    },
    {
      "section_id": "section-00070",
      "start_time": 566.44,
      "end_time": 573.395,
      "transcript": "ਸਭੁ ਕਿਛੁ ਤਿਸ ਕਾ, ਓਹੁ ਕਰਨੈ ਜੋਗੁ"
    },
    {
      "section_id": "section-00071",
      "start_time": 573.395,
      "end_time": 580.295,
      "transcript": "ਤਿਸੁ ਬਿਨੁ, ਦੂਸਰ ਹੋਆ ਨ ਹੋਗੁ"
    },
    {
      "section_id": "section-00072",
      "start_time": 580.295,
      "end_time": 587.48,
      "transcript": "ਜਪਿ ਜਨ, ਸਦਾ ਸਦਾ ਦਿਨੁ ਰੈਣੀ"
    },
    {
      "section_id": "section-00073",
      "start_time": 587.48,
      "end_time": 594.455,
      "transcript": "ਸਭ ਤੇ ਊਚ, ਨਿਰਮਲ ਇਹ ਕਰਣੀ"
    },
    {
      "section_id": "section-00074",
      "start_time": 594.455,
      "end_time": 601.17,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਜਿਸ ਕਉ ਨਾਮੁ ਦੀਆ"
    },
    {
      "section_id": "section-00075",
      "start_time": 601.17,
      "end_time": 608.425,
      "transcript": "ਨਾਨਕ ਸੋ ਜਨੁ, ਨਿਰਮਲੁ ਥੀਆ"
    },
    {
      "section_id": "section-00076",
      "start_time": 615.355,
      "end_time": 622.19,
      "transcript": "ਜਾ ਕੈ ਮਨਿ, ਗੁਰ ਕੀ ਪਰਤੀਤਿ"
    },
    {
      "section_id": "section-00077",
      "start_time": 622.19,
      "end_time": 629.185,
      "transcript": "ਤਿਸੁ ਜਨ ਆਵੈ, ਹਰਿ ਪ੍ਰਭੁ ਚੀਤਿ"
    },
    {
      "section_id": "section-00078",
      "start_time": 629.185,
      "end_time": 636.22,
      "transcript": "ਭਗਤੁ ਭਗਤੁ, ਸੁਨੀਐ ਤਿਹੁ ਲੋਇ"
    },
    {
      "section_id": "section-00079",
      "start_time": 636.22,
      "end_time": 642.875,
      "transcript": "ਜਾ ਕੈ ਹਿਰਦੈ, ਏਕੋ ਹੋਇ"
    },
    {
      "section_id": "section-00080",
      "start_time": 643.24,
      "end_time": 650.085,
      "transcript": "ਸਚੁ ਕਰਣੀ, ਸਚੁ ਤਾ ਕੀ ਰਹਤ"
    },
    {
      "section_id": "section-00081",
      "start_time": 650.085,
      "end_time": 656.95,
      "transcript": "ਸਚੁ ਹਿਰਦੈ, ਸਤਿ ਮੁਖਿ ਕਹਤ"
    },
    {
      "section_id": "section-00082",
      "start_time": 656.95,
      "end_time": 663.845,
      "transcript": "ਸਾਚੀ ਦ੍ਰਿਸਟਿ, ਸਾਚਾ ਆਕਾਰੁ"
    },
    {
      "section_id": "section-00083",
      "start_time": 663.845,
      "end_time": 670.885,
      "transcript": "ਸਚੁ ਵਰਤੈ, ਸਾਚਾ ਪਾਸਾਰੁ"
    },
    {
      "section_id": "section-00084",
      "start_time": 670.885,
      "end_time": 677.855,
      "transcript": "ਪਾਰਬ੍ਰਹਮੁ, ਜਿਨਿ ਸਚੁ ਕਰਿ ਜਾਤਾ"
    },
    {
      "section_id": "section-00085",
      "start_time": 677.855,
      "end_time": 684.769,
      "transcript": "ਨਾਨਕ ਸੋ ਜਨੁ, ਸਚਿ ਸਮਾਤਾ"

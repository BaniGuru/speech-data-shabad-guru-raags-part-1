{
  "audio_file": "0232 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.205,
      "end_time": 4.765,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 21.255,
      "end_time": 28.665,
      "transcript": "ਸੇਵਕ ਸਚੇ ਸਾਹ ਕੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 29.28,
      "end_time": 36.545,
      "transcript": "ਸੇਈ ਪਰਵਾਣੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 36.995,
      "end_time": 44.4,
      "transcript": "ਦੂਜਾ ਸੇਵਨਿ ਨਾਨਕਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.4,
      "end_time": 52.235,
      "transcript": "ਸੇ ਪਚਿ ਪਚਿ ਮੁਏ ਅਜਾਣ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.68,
      "end_time": 64.462,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ ਜੋ ਧੁਰਿ ਲਿਖਿਆ ਲੇਖੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 64.462,
      "end_time": 72.215,
      "transcript": "ਪ੍ਰਭ ਮੇਟਣਾ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 72.645,
      "end_time": 79.935,
      "transcript": "ਰਾਮ ਨਾਮੁ ਧਨੁ ਵਖਰੋ"
    },
    {
      "section_id": "section-00009",
      "start_time": 80.495,
      "end_time": 87.675,
      "transcript": "ਨਾਨਕ ਸਦਾ ਧਿਆਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.4,
      "end_time": 92.267,
      "transcript": "ਪਉੜੀ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 92.267,
      "end_time": 99.725,
      "transcript": "ਨਾਰਾਇਣਿ ਲਇਆ ਨਾਠੂੰਗੜਾ, ਪੈਰ ਕਿਥੈ ਰਖੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 100.8,
      "end_time": 108.985,
      "transcript": "ਕਰਦਾ ਪਾਪ ਅਮਿਤਿਆ, ਨਿਤ ਵਿਸੋ ਚਖੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 109.175,
      "end_time": 117.345,
      "transcript": "ਨਿੰਦਾ ਕਰਦਾ ਪਚਿ ਮੁਆ, ਵਿਚਿ ਦੇਹੀ ਭਖੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 118.0,
      "end_time": 125.915,
      "transcript": "ਸਚੈ ਸਾਹਿਬ ਮਾਰਿਆ, ਕਉਣੁ ਤਿਸ ਨੋ ਰਖੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 126.24,
      "end_time": 136.052,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਸਰਣਾਗਤੀ, ਜੋ ਪੁਰਖੁ ਅਲਖੈ"
    }
  ]
}

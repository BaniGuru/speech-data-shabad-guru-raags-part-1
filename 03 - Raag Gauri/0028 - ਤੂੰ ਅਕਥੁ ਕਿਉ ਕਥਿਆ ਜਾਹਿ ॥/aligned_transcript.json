{
  "audio_file": "0121 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.12,
      "end_time": 6.909,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.2,
      "end_time": 19.64,
      "transcript": "ਤੂੰ ਅਕਥੁ, ਕਿਉ ਕਥਿਆ ਜਾਹਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.64,
      "end_time": 26.16,
      "transcript": "ਗੁਰਸਬਦੁ ਮਾਰਣੁ, ਮਨ ਮਾਹਿ ਸਮਾਹਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 26.16,
      "end_time": 32.76,
      "transcript": "ਤੇਰੇ ਗੁਣ ਅਨੇਕ, ਕੀਮਤਿ ਨਹ ਪਾਹਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.76,
      "end_time": 39.32,
      "transcript": "ਜਿਸ ਕੀ ਬਾਣੀ, ਤਿਸੁ ਮਾਹਿ ਸਮਾਣੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 39.32,
      "end_time": 49.519,
      "transcript": "ਤੇਰੀ ਅਕਥ ਕਥਾ ਗੁਰ ਸਬਦਿ ਵਖਾਣੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.24,
      "end_time": 58.544,
      "transcript": "ਜਹ ਸਤਿਗੁਰੁ ਤਹ ਸਤਸੰਗਤਿ ਬਣਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.544,
      "end_time": 65.273,
      "transcript": "ਜਹ ਸਤਿਗੁਰੁ ਸਹਜੇ ਹਰਿ ਗੁਣ ਗਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.273,
      "end_time": 72.0,
      "transcript": "ਜਹ ਸਤਿਗੁਰੁ ਤਹਾ ਹਉਮੈ ਸਬਦਿ ਜਲਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 72.0,
      "end_time": 78.404,
      "transcript": "ਗੁਰਮੁਖਿ ਸੇਵਾ, ਮਹਲੀ ਥਾਉ ਪਾਏ"
    },
    {
      "section_id": "section-00011",
      "start_time": 78.404,
      "end_time": 85.12,
      "transcript": "ਗੁਰਮੁਖਿ ਅੰਤਰਿ, ਹਰਿ ਨਾਮੁ ਵਸਾਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 85.12,
      "end_time": 91.363,
      "transcript": "ਗੁਰਮੁਖਿ ਭਗਤਿ, ਹਰਿ ਨਾਮਿ ਸਮਾਏ"
    },
    {
      "section_id": "section-00013",
      "start_time": 91.363,
      "end_time": 98.24,
      "transcript": "ਆਪੇ ਦਾਤਿ ਕਰੇ ਦਾਤਾਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 98.24,
      "end_time": 104.533,
      "transcript": "ਪੂਰੇ ਸਤਿਗੁਰ ਸਿਉ, ਲਗੈ ਪਿਆਰੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 104.533,
      "end_time": 111.086,
      "transcript": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ, ਤਿਨ ਕਉ ਜੈਕਾਰੁ"
    }
  ]
}

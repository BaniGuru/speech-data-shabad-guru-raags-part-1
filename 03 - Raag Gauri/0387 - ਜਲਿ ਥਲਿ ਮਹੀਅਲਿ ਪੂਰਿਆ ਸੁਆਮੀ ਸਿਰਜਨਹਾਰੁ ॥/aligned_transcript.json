{
  "audio_file": "0221 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.698,
      "end_time": 15.32,
      "transcript": "ਥਿਤੀ ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 17.16,
      "end_time": 32.955,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 33.444,
      "end_time": 38.516,
      "transcript": "ਅ"
    },
    {
      "section_id": "section-00004",
      "start_time": 59.885,
      "end_time": 67.975,
      "transcript": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਪੂਰਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 68.095,
      "end_time": 76.155,
      "transcript": "ਸੁਆਮੀ ਸਿਰਜਨਹਾਰੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 76.48,
      "end_time": 84.705,
      "transcript": "ਅਨਿਕ ਭਾਂਤਿ ਹੋਇ ਪਸਰਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 84.705,
      "end_time": 92.445,
      "transcript": "ਨਾਨਕ ਏਕੰਕਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 93.08,
      "end_time": 97.045,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 101.68,
      "end_time": 110.498,
      "transcript": "ਏਕਮ ਏਕੰਕਾਰੁ ਪ੍ਰਭੁ, ਕਰਉ ਬੰਦਨਾ ਧਿਆਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 110.498,
      "end_time": 119.268,
      "transcript": "ਗੁਣ ਗੋਬਿੰਦ ਗੁਪਾਲ ਪ੍ਰਭ, ਸਰਨਿ ਪਰਉ ਹਰਿ ਰਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 119.268,
      "end_time": 127.715,
      "transcript": "ਤਾ ਕੀ ਆਸ ਕਲਿਆਣ ਸੁਖ, ਜਾ ਤੇ ਸਭੁ ਕਛੁ ਹੋਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 128.12,
      "end_time": 136.947,
      "transcript": "ਚਾਰਿ ਕੁੰਟ ਦਹ ਦਿਸਿ ਭ੍ਰਮਿਓ, ਤਿਸੁ ਬਿਨੁ ਅਵਰੁ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 136.947,
      "end_time": 145.32,
      "transcript": "ਬੇਦ ਪੁਰਾਨ ਸਿਮ੍ਰਿਤਿ ਸੁਨੇ, ਬਹੁ ਬਿਧਿ ਕਰਉ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00014",
      "start_time": 145.32,
      "end_time": 153.675,
      "transcript": "ਪਤਿਤ ਉਧਾਰਨ ਭੈ ਹਰਨ, ਸੁਖ ਸਾਗਰ ਨਿਰੰਕਾਰ"
    },
    {
      "section_id": "section-00015",
      "start_time": 153.815,
      "end_time": 162.115,
      "transcript": "ਦਾਤਾ ਭੁਗਤਾ ਦੇਨਹਾਰੁ, ਤਿਸੁ ਬਿਨੁ ਅਵਰੁ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 162.44,
      "end_time": 170.415,
      "transcript": "ਜੋ ਚਾਹਹਿ ਸੋਈ ਮਿਲੈ, ਨਾਨਕ ਹਰਿ ਗੁਨ ਗਾਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 170.625,
      "end_time": 174.975,
      "transcript": "ਗੋਬਿੰਦ ਜਸੁ ਗਾਈਐ, ਹਰਿ ਨੀਤ"
    },
    {
      "section_id": "section-00018",
      "start_time": 174.975,
      "end_time": 180.065,
      "transcript": "ਮਿਲਿ ਭਜੀਐ ਸਾਧਸੰਗਿ, ਮੇਰੇ ਮੀਤ ਰਹਾਉ"
    }
  ]
}

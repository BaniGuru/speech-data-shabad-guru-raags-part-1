      "section_id": "section-00001",
      "start_time": 2.494,
      "end_time": 16.605,
      "transcript": "ਮਹਲਾ ਚੌਥਾ ਗਉੜੀ ਪੂਰਬੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 33.2,
      "end_time": 39.76,
      "transcript": "ਹਰਿ ਦਇਆਲਿ ਦਇਆ ਪ੍ਰਭਿ ਕੀਨੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 39.76,
      "end_time": 47.302,
      "transcript": "ਮੇਰੈ ਮਨਿ ਤਨਿ ਮੁਖਿ ਹਰਿ ਬੋਲੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 47.302,
      "end_time": 53.88,
      "transcript": "ਗੁਰਮੁਖਿ ਰੰਗੁ ਭਇਆ ਅਤਿ ਗੂੜਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 53.88,
      "end_time": 61.066,
      "transcript": "ਹਰਿ ਰੰਗਿ ਭੀਨੀ ਮੇਰੀ ਚੋਲੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 61.066,
      "end_time": 68.054,
      "transcript": "ਅਪੁਨੇ ਹਰਿ ਪ੍ਰਭ ਕੀ, ਹਉ ਗੋਲੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 68.054,
      "end_time": 75.067,
      "transcript": "ਜਬ ਹਮ ਹਰਿ ਸੇਤੀ ਮਨੁ ਮਾਨਿਆ"

    {
      "section_id": "section-00013",
      "start_time": 115.37,
      "end_time": 122.268,
      "transcript": "ਹਰਿ ਹਰਿ ਨਿਕਟਿ ਵਸੈ ਸਭ ਜਗ ਕੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 122.268,
      "end_time": 128.98,
      "transcript": "ਅਪਰੰਪਰ ਪੁਰਖੁ ਅਤੋਲੀ"

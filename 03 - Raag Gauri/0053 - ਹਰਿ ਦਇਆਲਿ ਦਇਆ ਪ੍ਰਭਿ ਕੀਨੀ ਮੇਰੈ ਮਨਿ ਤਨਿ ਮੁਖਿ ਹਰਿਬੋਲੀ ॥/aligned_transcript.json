    {
      "section_id": "section-00017",
      "start_time": 142.108,
      "end_time": 148.96,
      "transcript": "ਹਰਿ ਜੀ ਅੰਤਰਿ ਬਾਹਰਿ ਤੁਮ ਸਰਣਾਗਤਿ"

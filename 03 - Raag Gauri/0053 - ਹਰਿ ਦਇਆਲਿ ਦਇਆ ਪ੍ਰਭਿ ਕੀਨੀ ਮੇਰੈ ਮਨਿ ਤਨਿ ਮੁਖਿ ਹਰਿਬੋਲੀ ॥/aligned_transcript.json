    {
      "section_id": "section-00008",
      "start_time": 75.067,
      "end_time": 83.785,
      "transcript": "ਕਰਿ ਦੀਨੋ ਜਗਤੁ ਸਭੁ ਗੋਲ ਅਮੋਲੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 88.64,
      "end_time": 94.84,
      "transcript": "ਕਰਹੁ ਬਿਬੇਕੁ ਸੰਤ ਜਨ ਭਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 94.84,
      "end_time": 102.16,
      "transcript": "ਖੋਜਿ ਹਿਰਦੈ ਦੇਖਿ ਢੰਢੋਲੀ"

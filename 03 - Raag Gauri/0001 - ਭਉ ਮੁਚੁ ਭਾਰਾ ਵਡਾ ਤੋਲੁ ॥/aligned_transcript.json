{
  "audio_file": "0115 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.554,
      "end_time": 15.016,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.016,
      "end_time": 31.68,
      "transcript": "ਮਹਲਾ ਪਹਿਲਾ ਚਉਪਦੇ ਦੁਪਦੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 32.6,
      "end_time": 46.27,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਨਿਰਭਉ ਨਿਰਵੈਰੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 46.27,
      "end_time": 60.824,
      "transcript": "ਅਕਾਲ ਮੂਰਤਿ ਅਜੂਨੀ ਸੈਭੰ ਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 78.4,
      "end_time": 85.39,
      "transcript": "ਭਉ ਮੁਚੁ ਭਾਰਾ, ਵਡਾ ਤੋਲੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 85.76,
      "end_time": 92.66,
      "transcript": "ਮਨ ਮਤਿ ਹਉਲੀ, ਬੋਲੇ ਬੋਲੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 93.16,
      "end_time": 100.3,
      "transcript": "ਸਿਰਿ ਧਰਿ ਚਲੀਐ, ਸਹੀਐ ਭਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 100.3,
      "end_time": 107.4,
      "transcript": "ਨਦਰੀ ਕਰਮੀ ਗੁਰ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 107.88,
      "end_time": 115.28,
      "transcript": "ਭੈ ਬਿਨੁ ਕੋਇ ਨ ਲੰਘਸਿ ਪਾਰਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 115.28,
      "end_time": 126.683,
      "transcript": "ਭੈ ਭਉ ਰਾਖਿਆ ਭਾਇ ਸਵਾਰਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 133.8,
      "end_time": 141.12,
      "transcript": "ਭੈ ਤਨਿ ਅਗਨਿ ਭਖੈ, ਭੈ ਨਾਲਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 141.2,
      "end_time": 148.18,
      "transcript": "ਭੈ ਭਉ ਘੜੀਐ, ਸਬਦਿ ਸਵਾਰਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 148.6,
      "end_time": 155.864,
      "transcript": "ਭੈ ਬਿਨੁ ਘਾੜਤ ਕਚੁ ਨਿਕਚ"
    },
    {
      "section_id": "section-00014",
      "start_time": 155.864,
      "end_time": 162.75,
      "transcript": "ਅੰਧਾ ਸਚਾ, ਅੰਧੀ ਸਟ"
    },
    {
      "section_id": "section-00015",
      "start_time": 163.36,
      "end_time": 170.509,
      "transcript": "ਬੁਧੀ ਬਾਜੀ, ਉਪਜੈ ਚਾਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 170.509,
      "end_time": 177.6,
      "transcript": "ਸਹਸ ਸਿਆਣਪ, ਪਵੈ ਨ ਤਾਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 178.04,
      "end_time": 185.045,
      "transcript": "ਨਾਨਕ ਮਨਮੁਖਿ ਬੋਲਣੁ ਵਾਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 185.045,
      "end_time": 192.12,
      "transcript": "ਅੰਧਾ ਅਖਰੁ, ਵਾਉ ਦੁਆਉ"
    }
  ]
}

{
  "audio_file": "0115 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.298,
      "end_time": 7.227,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.92,
      "end_time": 21.57,
      "transcript": "ਪਉਣੈ ਪਾਣੀ, ਅਗਨੀ ਕਾ ਮੇਲੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.08,
      "end_time": 28.71,
      "transcript": "ਚੰਚਲ ਚਪਲ, ਬੁਧਿ ਕਾ ਖੇਲੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.876,
      "end_time": 35.897,
      "transcript": "ਨਉ ਦਰਵਾਜੇ, ਦਸਵਾ ਦੁਆਰੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.196,
      "end_time": 43.333,
      "transcript": "ਬੁਝੁ ਰੇ ਗਿਆਨੀ, ਏਹੁ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.421,
      "end_time": 50.624,
      "transcript": "ਕਥਤਾ ਬਕਤਾ, ਸੁਨਤਾ ਸੋਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.624,
      "end_time": 61.875,
      "transcript": "ਆਪੁ ਬੀਚਾਰੇ ਸੁ ਗਿਆਨੀ ਹੋਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.319,
      "end_time": 75.676,
      "transcript": "ਦੇਹੀ ਮਾਟੀ, ਬੋਲੈ ਪਉਣੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.676,
      "end_time": 82.56,
      "transcript": "ਬੁਝੁ ਰੇ ਗਿਆਨੀ, ਮੂਆ ਹੈ ਕਉਣੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 83.16,
      "end_time": 89.86,
      "transcript": "ਮੂਈ ਸੁਰਤਿ, ਬਾਦੁ ਅਹੰਕਾਰੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 89.86,
      "end_time": 96.84,
      "transcript": "ਓਹੁ ਨ ਮੂਆ, ਜੋ ਦੇਖਣਹਾਰੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.4,
      "end_time": 104.64,
      "transcript": "ਜੈ ਕਾਰਣਿ, ਤਟਿ ਤੀਰਥ ਜਾਹੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 104.64,
      "end_time": 111.36,
      "transcript": "ਰਤਨ ਪਦਾਰਥ, ਘਟ ਹੀ ਮਾਹੀ"
    },
    {
      "section_id": "section-00014",
      "start_time": 111.88,
      "end_time": 119.12,
      "transcript": "ਪੜਿ ਪੜਿ ਪੰਡਿਤੁ, ਬਾਦੁ ਵਖਾਣੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 119.2,
      "end_time": 125.97,
      "transcript": "ਭੀਤਰਿ ਹੋਦੀ, ਵਸਤੁ ਨ ਜਾਣੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 126.44,
      "end_time": 133.45,
      "transcript": "ਹਉ ਨ ਮੂਆ, ਮੇਰੀ ਮੁਈ ਬਲਾਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 133.6,
      "end_time": 140.27,
      "transcript": "ਓਹੁ ਨ ਮੂਆ, ਜੋ ਰਹਿਆ ਸਮਾਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 141.0,
      "end_time": 148.04,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਗੁਰਿ ਬ੍ਰਹਮੁ ਦਿਖਾਇਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 148.04,
      "end_time": 156.117,
      "transcript": "ਮਰਤਾ ਜਾਤਾ, ਨਦਰਿ ਨ ਆਇਆ"
    }
  ]
}

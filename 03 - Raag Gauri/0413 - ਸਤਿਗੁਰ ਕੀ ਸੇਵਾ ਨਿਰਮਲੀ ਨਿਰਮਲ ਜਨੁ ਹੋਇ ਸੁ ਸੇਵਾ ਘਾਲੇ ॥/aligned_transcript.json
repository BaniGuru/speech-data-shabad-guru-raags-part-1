{
  "audio_file": "0226 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.475,
      "end_time": 6.975,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.28,
      "end_time": 20.615,
      "transcript": "ਸਤਿਗੁਰ ਕੀ ਸੇਵਾ ਨਿਰਮਲੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.075,
      "end_time": 27.95,
      "transcript": "ਨਿਰਮਲ ਜਨੁ ਹੋਇ ਸੁ ਸੇਵਾ ਘਾਲੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 27.95,
      "end_time": 34.72,
      "transcript": "ਜਿਨ ਅੰਦਰਿ ਕਪਟੁ ਵਿਕਾਰੁ ਝੂਠੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.72,
      "end_time": 41.33,
      "transcript": "ਓਇ ਆਪੇ ਸਚੈ ਵਖਿ ਕਢੇ ਜਜਮਾਲੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 41.33,
      "end_time": 48.2,
      "transcript": "ਸਚਿਆਰ ਸਿਖ ਬਹਿ ਸਤਿਗੁਰ ਪਾਸਿ ਘਾਲਨਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 48.2,
      "end_time": 54.175,
      "transcript": "ਕੂੜਿਆਰ ਨ ਲਭਨੀ ਕਿਤੈ ਥਾਇ ਭਾਲੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 54.175,
      "end_time": 60.74,
      "transcript": "ਜਿਨਾ ਸਤਿਗੁਰ ਕਾ ਆਖਿਆ ਸੁਖਾਵੈ ਨਾਹੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 60.74,
      "end_time": 68.0,
      "transcript": "ਤਿਨਾ ਮੁਹ ਭਲੇਰੇ ਫਿਰਹਿ ਦਯਿ ਗਾਲੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 68.0,
      "end_time": 74.64,
      "transcript": "ਜਿਨ ਅੰਦਰਿ ਪ੍ਰੀਤਿ ਨਹੀ ਹਰਿ ਕੇਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 74.64,
      "end_time": 81.11,
      "transcript": "ਸੇ ਕਿਚਰਕੁ ਵੇਰਾਈਅਨਿ ਮਨਮੁਖ ਬੇਤਾਲੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 81.11,
      "end_time": 87.84,
      "transcript": "ਸਤਿਗੁਰ ਨੋ ਮਿਲੈ ਸੁ ਆਪਣਾ ਮਨੁ ਥਾਇ ਰਖੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 87.84,
      "end_time": 94.48,
      "transcript": "ਓਹੁ ਆਪਿ ਵਰਤੈ ਆਪਣੀ ਵਥੁ ਨਾਲੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 94.48,
      "end_time": 101.12,
      "transcript": "ਜਨ ਨਾਨਕ ਇਕਨਾ ਗੁਰੁ ਮੇਲਿ ਸੁਖੁ ਦੇਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 101.12,
      "end_time": 107.675,
      "transcript": "ਇਕਿ ਆਪੇ ਵਖਿ ਕਢੈ ਠਗਵਾਲੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 108.825,
      "end_time": 114.865,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 124.675,
      "end_time": 131.44,
      "transcript": "ਜਿਨਾ ਅੰਦਰਿ ਨਾਮੁ ਨਿਧਾਨੁ ਹਰਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 131.44,
      "end_time": 138.19,
      "transcript": "ਤਿਨ ਕੇ ਕਾਜ ਦਯਿ ਆਦੇ ਰਾਸਿ"
    },
    {
      "section_id": "section-00019",
      "start_time": 138.19,
      "end_time": 144.305,
      "transcript": "ਤਿਨ ਚੂਕੀ ਮੁਹਤਾਜੀ ਲੋਕਨ ਕੀ"
    },
    {
      "section_id": "section-00020",
      "start_time": 144.88,
      "end_time": 151.35,
      "transcript": "ਹਰਿ ਪ੍ਰਭੁ ਅੰਗੁ ਕਰਿ ਬੈਠਾ ਪਾਸਿ"
    },
    {
      "section_id": "section-00021",
      "start_time": 151.35,
      "end_time": 158.045,
      "transcript": "ਜਾਂ ਕਰਤਾ ਵਲਿ ਤਾ ਸਭੁ ਕੋ ਵਲਿ"
    },
    {
      "section_id": "section-00022",
      "start_time": 158.045,
      "end_time": 164.92,
      "transcript": "ਸਭਿ ਦਰਸਨੁ ਦੇਖਿ ਕਰਹਿ ਸਾਬਾਸਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 164.92,
      "end_time": 171.48,
      "transcript": "ਸਾਹੁ ਪਾਤਿਸਾਹੁ ਸਭੁ ਹਰਿ ਕਾ ਕੀਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 171.48,
      "end_time": 178.04,
      "transcript": "ਸਭਿ ਜਨ ਕਉ ਆਇ ਕਰਹਿ ਰਹਰਾਸਿ"
    },
    {
      "section_id": "section-00025",
      "start_time": 178.04,
      "end_time": 184.57,
      "transcript": "ਗੁਰ ਪੂਰੇ ਕੀ ਵਡੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 184.57,
      "end_time": 191.28,
      "transcript": "ਹਰਿ ਵਡਾ ਸੇਵਿ ਅਤੁਲੁ ਸੁਖੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00027",
      "start_time": 191.28,
      "end_time": 197.32,
      "transcript": "ਗੁਰਿ ਪੂਰੈ ਦਾਨੁ ਦੀਆ ਹਰਿ ਨਿਹਚਲੁ"
    },
    {
      "section_id": "section-00028",
      "start_time": 197.32,
      "end_time": 204.115,
      "transcript": "ਨਿਤ ਬਖਸੇ ਚੜੈ ਸਵਾਇਆ"
    },
    {
      "section_id": "section-00029",
      "start_time": 204.6,
      "end_time": 211.16,
      "transcript": "ਕੋਈ ਨਿੰਦਕੁ ਵਡਿਆਈ ਦੇਖਿ ਨ ਸਕੈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 211.16,
      "end_time": 217.495,
      "transcript": "ਸੋ ਕਰਤੈ ਆਪਿ ਪਚਾਇਆ"
    },
    {
      "section_id": "section-00031",
      "start_time": 217.695,
      "end_time": 224.12,
      "transcript": "ਜਨੁ ਨਾਨਕੁ ਗੁਣ ਬੋਲੈ ਕਰਤੇ ਕੇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 224.12,
      "end_time": 233.675,
      "transcript": "ਭਗਤਾ ਨੋ ਸਦਾ ਰਖਦਾ ਆਇਆ ਪਉੜੀ"
    },
    {
      "section_id": "section-00033",
      "start_time": 242.44,
      "end_time": 250.71,
      "transcript": "ਤੂ ਸਾਹਿਬੁ ਅਗਮ ਦਇਆਲੁ ਹੈ, ਵਡ ਦਾਤਾ ਦਾਣਾ"
    },
    {
      "section_id": "section-00034",
      "start_time": 250.71,
      "end_time": 260.195,
      "transcript": "ਤੁਧੁ ਜੇਵਡੁ ਮੈ ਹੋਰੁ ਕੋ ਦਿਸਿ ਨ ਆਵਈ, ਤੂਹੈਂ ਸੁਘੜੁ ਮੇਰੈ ਮਨਿ ਭਾਣਾ"
    },
    {
      "section_id": "section-00035",
      "start_time": 260.195,
      "end_time": 268.795,
      "transcript": "ਮੋਹੁ ਕੁਟੰਬੁ ਦਿਸਿ ਆਵਦਾ, ਸਭੁ ਚਲਣਹਾਰਾ ਆਵਣ ਜਾਣਾ"
    },
    {
      "section_id": "section-00036",
      "start_time": 268.795,
      "end_time": 277.4,
      "transcript": "ਜੋ ਬਿਨੁ ਸਚੇ ਹੋਰਤੁ ਚਿਤੁ ਲਾਇਦੇ, ਸੇ ਕੂੜਿਆਰ ਕੂੜਾ ਤਿਨ ਮਾਣਾ"
    },
    {
      "section_id": "section-00037",
      "start_time": 277.4,
      "end_time": 285.445,
      "transcript": "ਨਾਨਕ ਸਚੁ ਧਿਆਇ ਤੂ, ਬਿਨੁ ਸਚੇ ਪਚਿ ਪਚਿ ਮੁਏ ਅਜਾਣਾ"
    },
    {
      "section_id": "section-00038",
      "start_time": 285.608,
      "end_time": 294.455,
      "transcript": "ਨਾਨਕ ਸਚੁ ਧਿਆਇ ਤੂ, ਬਿਨੁ ਸਚੇ ਪਚਿ ਪਚਿ ਮੁਏ ਅਜਾਣਾ"
    }
  ]
}

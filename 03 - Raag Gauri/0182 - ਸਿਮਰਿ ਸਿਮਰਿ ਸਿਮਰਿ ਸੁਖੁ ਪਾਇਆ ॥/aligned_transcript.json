{
  "audio_file": "0153 A PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.845,
      "end_time": 12.895,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 29.4,
      "end_time": 35.6,
      "transcript": "ਸਿਮਰਿ ਸਿਮਰਿ, ਸਿਮਰਿ ਸੁਖੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 35.6,
      "end_time": 41.615,
      "transcript": "ਚਰਨ ਕਮਲ ਗੁਰ, ਰਿਦੈ ਬਸਾਇਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.615,
      "end_time": 48.08,
      "transcript": "ਗੁਰ ਗੋਬਿੰਦੁ, ਪਾਰਬ੍ਰਹਮੁ ਪੂਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 48.08,
      "end_time": 57.685,
      "transcript": "ਤਿਸਹਿ ਅਰਾਧਿ, ਮੇਰਾ ਮਨੁ ਧੀਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 63.84,
      "end_time": 69.815,
      "transcript": "ਅਨਦਿਨੁ ਜਪਉ, ਗੁਰੂ ਗੁਰ ਨਾਮ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.16,
      "end_time": 76.045,
      "transcript": "ਤਾ ਤੇ, ਸਿਧਿ ਭਏ ਸਗਲ ਕਾਂਮ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.44,
      "end_time": 82.46,
      "transcript": "ਦਰਸਨ ਦੇਖਿ, ਸੀਤਲ ਮਨ ਭਏ"
    },
    {
      "section_id": "section-00009",
      "start_time": 82.46,
      "end_time": 88.945,
      "transcript": "ਜਨਮ ਜਨਮ ਕੇ, ਕਿਲਬਿਖ ਗਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.945,
      "end_time": 95.165,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਕਹਾ ਭੈ ਭਾਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.165,
      "end_time": 101.085,
      "transcript": "ਅਪਨੇ ਸੇਵਕ ਕੀ, ਆਪਿ ਪੈਜ ਰਖਾਈ"
    }
  ]
}

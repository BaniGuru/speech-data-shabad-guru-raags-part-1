  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.44,
      "end_time": 7.39,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.6,
      "end_time": 21.68,
      "transcript": "ਹਰਿ ਆਪੇ ਜੋਗੀ, ਡੰਡਾਧਾਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.68,
      "end_time": 28.37,
      "transcript": "ਹਰਿ ਆਪੇ ਰਵਿ ਰਹਿਆ ਬਨਵਾਰੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.8,
      "end_time": 35.64,
      "transcript": "ਹਰਿ ਆਪੇ ਤਪੁ ਤਾਪੈ, ਲਾਇ ਤਾਰੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.92,
      "end_time": 43.04,
      "transcript": "ਐਸਾ ਮੇਰਾ ਰਾਮੁ, ਰਹਿਆ ਭਰਪੂਰਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.04,
      "end_time": 53.342,
      "transcript": "ਨਿਕਟਿ ਵਸੈ ਨਾਹੀ ਹਰਿ ਦੂਰਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.92,
      "end_time": 68.04,
      "transcript": "ਹਰਿ ਆਪੇ ਸਬਦੁ ਸੁਰਤਿ ਧੁਨਿ ਆਪੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.04,
      "end_time": 75.24,
      "transcript": "ਹਰਿ ਆਪੇ ਵੇਖੈ, ਵਿਗਸੈ ਆਪੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.24,
      "end_time": 82.02,
      "transcript": "ਹਰਿ ਆਪਿ ਜਪਾਇ, ਆਪੇ ਹਰਿ ਜਾਪੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.48,
      "end_time": 89.52,
      "transcript": "ਹਰਿ ਆਪੇ ਸਾਰਿੰਗ, ਅੰਮ੍ਰਿਤਧਾਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 89.52,
      "end_time": 96.68,
      "transcript": "ਹਰਿ ਅੰਮ੍ਰਿਤੁ, ਆਪਿ ਪੀਆਵਣਹਾਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 96.68,
      "end_time": 103.43,
      "transcript": "ਹਰਿ ਆਪਿ ਕਰੇ, ਆਪੇ ਨਿਸਤਾਰਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 103.84,
      "end_time": 111.04,
      "transcript": "ਹਰਿ ਆਪੇ ਬੇੜੀ, ਤੁਲਹਾ ਤਾਰਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 111.04,
      "end_time": 118.08,
      "transcript": "ਹਰਿ ਆਪੇ ਗੁਰਮਤੀ ਨਿਸਤਾਰਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 118.08,
      "end_time": 124.74,
      "transcript": "ਹਰਿ ਆਪੇ ਨਾਨਕ, ਪਾਵੈ ਪਾਰਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 125.161,
      "end_time": 132.173,
      "transcript": "ਹਰਿ ਆਪੇ ਗੁਰਮਤੀ ਨਿਸਤਾਰਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 132.173,
      "end_time": 140.83,
      "transcript": "ਹਰਿ ਆਪੇ ਨਾਨਕ, ਪਾਵੈ ਪਾਰਾ"

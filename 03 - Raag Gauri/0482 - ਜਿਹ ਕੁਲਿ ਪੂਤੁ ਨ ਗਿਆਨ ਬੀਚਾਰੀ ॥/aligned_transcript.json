{
  "audio_file": "0242 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.245,
      "end_time": 7.3,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.48,
      "end_time": 21.56,
      "transcript": "ਜਿਹ ਕੁਲਿ ਪੂਤੁ, ਨ ਗਿਆਨ ਬੀਚਾਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.56,
      "end_time": 28.68,
      "transcript": "ਬਿਧਵਾ ਕਸ ਨ ਭਈ, ਮਹਤਾਰੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.68,
      "end_time": 35.8,
      "transcript": "ਜਿਹ ਨਰ, ਰਾਮ ਭਗਤਿ ਨਹਿ ਸਾਧੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.8,
      "end_time": 42.925,
      "transcript": "ਜਨਮਤ, ਕਸ ਨ ਮੁਓ ਅਪਰਾਧੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.96,
      "end_time": 57.12,
      "transcript": "ਮੁਚੁ ਮੁਚੁ ਗਰਭ ਗਏ, ਕੀਨ ਬਚਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.12,
      "end_time": 64.235,
      "transcript": "ਬੁਡਭੁਜ ਰੂਪ, ਜੀਵੇ ਜਗ ਮਝਿਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.235,
      "end_time": 70.895,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਜੈਸੇ ਸੁੰਦਰ ਸਰੂਪ"
    },
    {
      "section_id": "section-00009",
      "start_time": 71.44,
      "end_time": 77.855,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਜੈਸੇ ਕੁਬਜ ਕੁਰੂਪ"
    }
  ]
}

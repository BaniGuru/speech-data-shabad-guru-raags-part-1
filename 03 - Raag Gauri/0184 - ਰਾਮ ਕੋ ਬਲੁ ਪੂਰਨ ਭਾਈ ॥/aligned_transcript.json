      "section_id": "section-00001",
      "start_time": 4.245,
      "end_time": 13.917,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਚੇਤੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.917,
      "end_time": 26.518,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ ਦੁਪਦੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 26.518,
      "end_time": 39.375,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 55.485,
      "end_time": 61.89,
      "transcript": "ਰਾਮ ਕੋ ਬਲੁ ਪੂਰਨ, ਭਾਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 61.89,
      "end_time": 67.985,
      "transcript": "ਤਾ ਤੇ ਬ੍ਰਿਥਾ, ਨ ਬਿਆਪੈ ਕਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 74.095,
      "end_time": 80.2,
      "transcript": "ਜੋ ਜੋ ਚਿਤਵੈ, ਦਾਸੁ ਹਰਿ ਮਾਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 80.2,
      "end_time": 86.39,
      "transcript": "ਸੋ ਸੋ ਕਰਤਾ, ਆਪਿ ਕਰਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 86.39,
      "end_time": 92.335,
      "transcript": "ਨਿੰਦਕ ਕੀ ਪ੍ਰਭਿ, ਪਤਿ ਗਵਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 92.335,
      "end_time": 98.12,
      "transcript": "ਨਾਨਕ ਹਰਿ ਗੁਣ, ਨਿਰਭਉ ਗਾਈ"
    }
  ]
}

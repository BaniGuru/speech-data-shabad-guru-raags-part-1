{
  "audio_file": "0173 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.345,
      "end_time": 13.075,
      "transcript": "ਗਉੜੀ ਬੈਰਾਗਣਿ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.52,
      "end_time": 29.975,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 39.035,
      "end_time": 47.365,
      "transcript": "ਜਿਉ ਗਾਈ ਕਉ ਗੋਇਲੀ, ਰਾਖਹਿ ਕਰਿ ਸਾਰਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 47.365,
      "end_time": 55.075,
      "transcript": "ਅਹਿਨਿਸਿ ਪਾਲਹਿ ਰਾਖਿ ਲੇਹਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 55.52,
      "end_time": 63.025,
      "transcript": "ਆਤਮ ਸੁਖੁ ਧਾਰਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 63.76,
      "end_time": 71.045,
      "transcript": "ਇਤ ਉਤ ਰਾਖਹੁ, ਦੀਨ ਦਇਆਲਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 71.68,
      "end_time": 80.398,
      "transcript": "ਤਉ ਸਰਣਾਗਤਿ, ਨਦਰਿ ਨਿਹਾਲਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 87.6,
      "end_time": 95.325,
      "transcript": "ਜਹ ਦੇਖਉ ਤਹ ਰਵਿ ਰਹੇ, ਰਖੁ ਰਾਖਨਹਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 95.325,
      "end_time": 102.625,
      "transcript": "ਤੂੰ ਦਾਤਾ ਭੁਗਤਾ ਤੂੰਹੈ, ਤੂੰ ਪ੍ਰਾਣ ਅਧਾਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 103.08,
      "end_time": 110.305,
      "transcript": "ਕਿਰਤੁ ਪਇਆ ਅਧ ਊਰਧੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 110.685,
      "end_time": 117.895,
      "transcript": "ਬਿਨੁ ਗਿਆਨ ਬੀਚਾਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 118.355,
      "end_time": 125.565,
      "transcript": "ਬਿਨੁ ਉਪਮਾ ਜਗਦੀਸ ਕੀ"
    },
    {
      "section_id": "section-00013",
      "start_time": 126.12,
      "end_time": 132.895,
      "transcript": "ਬਿਨਸੈ ਨ ਅੰਧਿਆਰਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 133.715,
      "end_time": 140.885,
      "transcript": "ਜਗੁ ਬਿਨਸਤ ਹਮ ਦੇਖਿਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 141.365,
      "end_time": 148.455,
      "transcript": "ਲੋਭੇ ਅਹੰਕਾਰਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 148.985,
      "end_time": 156.025,
      "transcript": "ਗੁਰ ਸੇਵਾ ਪ੍ਰਭੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 156.615,
      "end_time": 163.555,
      "transcript": "ਸਚੁ ਮੁਕਤਿ ਦੁਆਰਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 164.36,
      "end_time": 171.715,
      "transcript": "ਨਿਜ ਘਰਿ ਮਹਲੁ ਅਪਾਰ ਕੋ"
    },
    {
      "section_id": "section-00019",
      "start_time": 171.96,
      "end_time": 179.115,
      "transcript": "ਅਪਰੰਪਰੁ ਸੋਈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 179.52,
      "end_time": 186.395,
      "transcript": "ਬਿਨੁ ਸਬਦੈ ਥਿਰੁ ਕੋ ਨਹੀ"
    },
    {
      "section_id": "section-00021",
      "start_time": 187.065,
      "end_time": 193.905,
      "transcript": "ਬੂਝੈ ਸੁਖੁ ਹੋਈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 202.08,
      "end_time": 209.645,
      "transcript": "ਕਿਆ ਲੈ ਆਇਆ ਲੇ ਜਾਇ ਕਿਆ"
    },
    {
      "section_id": "section-00023",
      "start_time": 210.12,
      "end_time": 217.195,
      "transcript": "ਫਾਸਹਿ ਜਮ ਜਾਲਾ"
    },
    {
      "section_id": "section-00024",
      "start_time": 217.465,
      "end_time": 224.765,
      "transcript": "ਡੋਲੁ ਬਧਾ ਕਸਿ ਜੇਵਰੀ"
    },
    {
      "section_id": "section-00025",
      "start_time": 225.24,
      "end_time": 232.285,
      "transcript": "ਆਕਾਸਿ ਪਤਾਲਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 232.675,
      "end_time": 239.925,
      "transcript": "ਗੁਰਮਤਿ ਨਾਮੁ ਨ ਵੀਸਰੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 240.48,
      "end_time": 247.315,
      "transcript": "ਸਹਜੇ ਪਤਿ ਪਾਈਐ"
    },
    {
      "section_id": "section-00028",
      "start_time": 247.84,
      "end_time": 254.645,
      "transcript": "ਅੰਤਰਿ ਸਬਦੁ ਨਿਧਾਨੁ ਹੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 255.215,
      "end_time": 262.035,
      "transcript": "ਮਿਲਿ ਆਪੁ ਗਵਾਈਐ"
    },
    {
      "section_id": "section-00030",
      "start_time": 262.76,
      "end_time": 269.745,
      "transcript": "ਨਦਰਿ ਕਰੇ ਪ੍ਰਭੁ ਆਪਣੀ"
    },
    {
      "section_id": "section-00031",
      "start_time": 270.215,
      "end_time": 277.205,
      "transcript": "ਗੁਣ ਅੰਕਿ ਸਮਾਵੈ"
    },
    {
      "section_id": "section-00032",
      "start_time": 277.655,
      "end_time": 284.105,
      "transcript": "ਨਾਨਕ ਮੇਲੁ ਨ ਚੂਕਈ"
    },
    {
      "section_id": "section-00033",
      "start_time": 285.045,
      "end_time": 292.725,
      "transcript": "ਲਾਹਾ ਸਚੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00034",
      "start_time": 299.655,
      "end_time": 308.408,
      "transcript": "ਲਾਹਾ ਸਚੁ ਪਾਵੈ"
    }
  ]
}

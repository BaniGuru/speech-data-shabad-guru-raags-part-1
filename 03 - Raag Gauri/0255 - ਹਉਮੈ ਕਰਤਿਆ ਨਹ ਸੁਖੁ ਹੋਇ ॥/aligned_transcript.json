{
  "audio_file": "0168 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.295,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.88,
      "end_time": 19.01,
      "transcript": "ਹਉਮੈ ਕਰਤਿਆ, ਨਹ ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.01,
      "end_time": 25.24,
      "transcript": "ਮਨਮਤਿ ਝੂਠੀ, ਸਚਾ ਸੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.24,
      "end_time": 31.435,
      "transcript": "ਸਗਲ ਬਿਗੂਤੇ, ਭਾਵੈ ਦੋਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.435,
      "end_time": 37.795,
      "transcript": "ਸੋ ਕਮਾਵੈ, ਧੁਰਿ ਲਿਖਿਆ ਹੋਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 37.795,
      "end_time": 44.165,
      "transcript": "ਐਸਾ, ਜਗੁ ਦੇਖਿਆ ਜੂਆਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 44.165,
      "end_time": 53.645,
      "transcript": "ਸਭਿ ਸੁਖ ਮਾਗੈ, ਨਾਮੁ ਬਿਸਾਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.08,
      "end_time": 66.581,
      "transcript": "ਅਦਿਸਟੁ ਦਿਸੈ, ਤਾ ਕਹਿਆ ਜਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 66.581,
      "end_time": 72.925,
      "transcript": "ਬਿਨੁ ਦੇਖੇ, ਕਹਣਾ ਬਿਰਥਾ ਜਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 72.925,
      "end_time": 78.905,
      "transcript": "ਗੁਰਮੁਖਿ ਦੀਸੈ, ਸਹਜਿ ਸੁਭਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 79.365,
      "end_time": 85.365,
      "transcript": "ਸੇਵਾ ਸੁਰਤਿ, ਏਕ ਲਿਵ ਲਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 85.663,
      "end_time": 91.957,
      "transcript": "ਸੁਖੁ ਮਾਂਗਤ, ਦੁਖੁ ਆਗਲ ਹੋਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 91.957,
      "end_time": 98.51,
      "transcript": "ਸਗਲ ਵਿਕਾਰੀ, ਹਾਰੁ ਪਰੋਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 98.51,
      "end_time": 104.96,
      "transcript": "ਏਕ ਬਿਨਾ ਝੂਠੇ, ਮੁਕਤਿ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 104.96,
      "end_time": 111.24,
      "transcript": "ਕਰਿ ਕਰਿ ਕਰਤਾ, ਦੇਖੈ ਸੋਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 111.24,
      "end_time": 117.84,
      "transcript": "ਤ੍ਰਿਸਨਾ ਅਗਨਿ, ਸਬਦਿ ਬੁਝਾਏ"
    },
    {
      "section_id": "section-00017",
      "start_time": 117.84,
      "end_time": 124.085,
      "transcript": "ਦੂਜਾ ਭਰਮੁ, ਸਹਜਿ ਸੁਭਾਏ"
    },
    {
      "section_id": "section-00018",
      "start_time": 124.085,
      "end_time": 130.175,
      "transcript": "ਗੁਰਮਤੀ, ਨਾਮੁ ਰਿਦੈ ਵਸਾਏ"
    },
    {
      "section_id": "section-00019",
      "start_time": 130.615,
      "end_time": 137.03,
      "transcript": "ਸਾਚੀ ਬਾਣੀ, ਹਰਿ ਗੁਣ ਗਾਏ"
    },
    {
      "section_id": "section-00020",
      "start_time": 137.03,
      "end_time": 143.432,
      "transcript": "ਤਨ ਮਹਿ ਸਾਚੋ, ਗੁਰਮੁਖਿ ਭਾਉ"
    },
    {
      "section_id": "section-00021",
      "start_time": 143.432,
      "end_time": 149.98,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਨਾਹੀ ਨਿਜ ਠਾਉ"
    },
    {
      "section_id": "section-00022",
      "start_time": 149.98,
      "end_time": 156.6,
      "transcript": "ਪ੍ਰੇਮ ਪਰਾਇਣ, ਪ੍ਰੀਤਮ ਰਾਉ"
    },
    {
      "section_id": "section-00023",
      "start_time": 156.6,
      "end_time": 162.475,
      "transcript": "ਨਦਰਿ ਕਰੇ, ਤਾ ਬੂਝੈ ਨਾਉ"
    },
    {
      "section_id": "section-00024",
      "start_time": 162.955,
      "end_time": 169.4,
      "transcript": "ਮਾਇਆ ਮੋਹੁ, ਸਰਬ ਜੰਜਾਲਾ"
    },
    {
      "section_id": "section-00025",
      "start_time": 169.4,
      "end_time": 175.865,
      "transcript": "ਮਨਮੁਖ ਕੁਚੀਲ, ਕੁਛਿਤ ਬਿਕਰਾਲਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 175.865,
      "end_time": 182.48,
      "transcript": "ਸਤਿਗੁਰੁ ਸੇਵੇ, ਚੂਕੈ ਜੰਜਾਲਾ"
    },
    {
      "section_id": "section-00027",
      "start_time": 182.48,
      "end_time": 188.92,
      "transcript": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ, ਸਦਾ ਸੁਖੁ ਨਾਲਾ"
    },
    {
      "section_id": "section-00028",
      "start_time": 188.92,
      "end_time": 195.28,
      "transcript": "ਗੁਰਮੁਖਿ ਬੂਝੈ, ਏਕ ਲਿਵ ਲਾਏ"
    },
    {
      "section_id": "section-00029",
      "start_time": 195.28,
      "end_time": 201.8,
      "transcript": "ਨਿਜ ਘਰਿ ਵਾਸੈ, ਸਾਚਿ ਸਮਾਏ"
    },
    {
      "section_id": "section-00030",
      "start_time": 201.8,
      "end_time": 208.2,
      "transcript": "ਜੰਮਣੁ ਮਰਣਾ, ਠਾਕਿ ਰਹਾਏ"
    },
    {
      "section_id": "section-00031",
      "start_time": 208.2,
      "end_time": 214.6,
      "transcript": "ਪੂਰੇ ਗੁਰ ਤੇ, ਇਹ ਮਤਿ ਪਾਏ"
    },
    {
      "section_id": "section-00032",
      "start_time": 214.6,
      "end_time": 220.795,
      "transcript": "ਕਥਨੀ ਕਥਉ, ਨ ਆਵੈ ਓਰੁ"
    },
    {
      "section_id": "section-00033",
      "start_time": 220.795,
      "end_time": 227.28,
      "transcript": "ਗੁਰੁ ਪੁਛਿ ਦੇਖਿਆ, ਨਾਹੀ ਦਰੁ ਹੋਰੁ"
    },
    {
      "section_id": "section-00034",
      "start_time": 227.28,
      "end_time": 233.175,
      "transcript": "ਦੁਖੁ ਸੁਖੁ ਭਾਣੈ, ਤਿਸੈ ਰਜਾਇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 233.505,
      "end_time": 239.78,
      "transcript": "ਨਾਨਕੁ ਨੀਚੁ ਕਹੈ, ਲਿਵ ਲਾਇ"
    },
    {
      "section_id": "section-00036",
      "start_time": 239.78,
      "end_time": 246.171,
      "transcript": "ਦੁਖੁ ਸੁਖੁ ਭਾਣੈ, ਤਿਸੈ ਰਜਾਇ"
    },
    {
      "section_id": "section-00037",
      "start_time": 246.171,
      "end_time": 253.752,
      "transcript": "ਨਾਨਕੁ ਨੀਚੁ ਕਹੈ, ਲਿਵ ਲਾਇ"
    }
  ]
}

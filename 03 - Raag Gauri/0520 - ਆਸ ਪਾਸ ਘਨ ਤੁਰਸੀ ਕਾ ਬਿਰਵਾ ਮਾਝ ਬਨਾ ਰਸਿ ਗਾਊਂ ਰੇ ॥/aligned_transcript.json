  "audio_file": "0249 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.255,
      "transcript": "ਰਾਗੁ ਗਉੜੀ ਗਿਆਰਵੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.16,
      "end_time": 18.28,
      "transcript": "ਆਸ ਪਾਸ ਘਨ ਤੁਰਸੀ ਕਾ ਬਿਰਵਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.28,
      "end_time": 23.907,
      "transcript": "ਮਾਝ ਬਨਾ ਰਸਿ ਗਾਊਂ ਰੇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.907,
      "end_time": 29.84,
      "transcript": "ਉਆ ਕਾ ਸਰੂਪੁ ਦੇਖਿ ਮੋਹੀ ਗੁਆਰਨਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.84,
      "end_time": 35.935,
      "transcript": "ਮੋ ਕਉ ਛੋਡਿ ਨ ਆਉ ਨ ਜਾਹੂ ਰੇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 36.4,
      "end_time": 42.243,
      "transcript": "ਤੋਹਿ ਚਰਨ ਮਨੁ ਲਾਗੋ, ਸਾਰਿੰਗਧਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 42.243,
      "end_time": 50.356,
      "transcript": "ਸੋ ਮਿਲੈ, ਜੋ ਬਡਭਾਗੋ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 57.655,
      "end_time": 63.745,
      "transcript": "ਬਿੰਦ੍ਰਾਬਨ ਮਨ ਹਰਨ ਮਨੋਹਰ"
    },
    {
      "section_id": "section-00009",
      "start_time": 63.745,
      "end_time": 69.525,
      "transcript": "ਕ੍ਰਿਸਨ ਚਰਾਵਤ ਗਾਊ ਰੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 69.795,
      "end_time": 75.875,
      "transcript": "ਜਾ ਕਾ ਠਾਕੁਰੁ ਤੁਹੀ ਸਾਰਿੰਗਧਰ"
    },
    {
      "section_id": "section-00011",
      "start_time": 75.875,
      "end_time": 81.465,
      "transcript": "ਮੋਹਿ ਕਬੀਰਾ ਨਾਊ ਰੇ"
    }
  ]
}

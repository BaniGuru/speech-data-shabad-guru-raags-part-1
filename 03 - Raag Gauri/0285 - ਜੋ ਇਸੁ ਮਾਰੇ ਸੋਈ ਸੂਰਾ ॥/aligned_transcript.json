{
  "audio_file": "0181 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.115,
      "end_time": 16.185,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 26.615,
      "end_time": 33.765,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੋਈ ਸੂਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 34.04,
      "end_time": 41.005,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੋਈ ਪੂਰਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.36,
      "end_time": 48.72,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਤਿਸਹਿ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 48.72,
      "end_time": 55.78,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਤਿਸ ਕਾ ਦੁਖੁ ਜਾਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 55.78,
      "end_time": 63.17,
      "transcript": "ਐਸਾ ਕੋਇ, ਜਿ ਦੁਬਿਧਾ ਮਾਰਿ ਗਵਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.17,
      "end_time": 70.308,
      "transcript": "ਇਸਹਿ ਮਾਰਿ, ਰਾਜ ਜੋਗੁ ਕਮਾਵੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 81.24,
      "end_time": 88.425,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਤਿਸ ਕਉ ਭਉ ਨਾਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 88.425,
      "end_time": 95.415,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੁ ਨਾਮਿ ਸਮਾਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 95.84,
      "end_time": 102.615,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਤਿਸ ਕੀ ਤ੍ਰਿਸਨਾ ਬੁਝੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 103.015,
      "end_time": 110.045,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੁ ਦਰਗਹ ਸਿਝੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 110.28,
      "end_time": 117.125,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੋ ਧਨਵੰਤਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 117.48,
      "end_time": 124.375,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੋ ਪਤਿਵੰਤਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 124.72,
      "end_time": 131.425,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੋਈ ਜਤੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 131.825,
      "end_time": 138.535,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਤਿਸੁ ਹੋਵੈ ਗਤੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 139.12,
      "end_time": 145.925,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਤਿਸ ਕਾ ਆਇਆ ਗਨੀ"
    },
    {
      "section_id": "section-00017",
      "start_time": 146.32,
      "end_time": 153.165,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੁ ਨਿਹਚਲੁ ਧਨੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 153.48,
      "end_time": 160.265,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੋ ਵਡਭਾਗਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 160.68,
      "end_time": 167.84,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੁ ਅਨਦਿਨੁ ਜਾਗਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 167.84,
      "end_time": 175.04,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੁ ਜੀਵਨ ਮੁਕਤਾ"
    },
    {
      "section_id": "section-00021",
      "start_time": 175.04,
      "end_time": 182.16,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਤਿਸ ਕੀ ਨਿਰਮਲ ਜੁਗਤਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 182.16,
      "end_time": 189.16,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੋਈ ਸੁਗਿਆਨੀ"
    },
    {
      "section_id": "section-00023",
      "start_time": 189.16,
      "end_time": 196.404,
      "transcript": "ਜੋ ਇਸੁ ਮਾਰੇ, ਸੁ ਸਹਜ ਧਿਆਨੀ"
    },
    {
      "section_id": "section-00024",
      "start_time": 203.44,
      "end_time": 210.155,
      "transcript": "ਇਸੁ ਮਾਰੀ ਬਿਨੁ, ਥਾਇ ਨ ਪਰੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 210.56,
      "end_time": 217.195,
      "transcript": "ਕੋਟਿ ਕਰਮ, ਜਾਪ ਤਪ ਕਰੈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 217.6,
      "end_time": 224.155,
      "transcript": "ਇਸੁ ਮਾਰੀ ਬਿਨੁ, ਜਨਮੁ ਨ ਮਿਟੈ"
    },
    {
      "section_id": "section-00027",
      "start_time": 224.64,
      "end_time": 231.356,
      "transcript": "ਇਸੁ ਮਾਰੀ ਬਿਨੁ, ਜਮ ਤੇ ਨਹੀ ਛੁਟੈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 231.356,
      "end_time": 238.705,
      "transcript": "ਇਸੁ ਮਾਰੀ ਬਿਨੁ, ਗਿਆਨੁ ਨ ਹੋਈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 238.705,
      "end_time": 245.92,
      "transcript": "ਇਸੁ ਮਾਰੀ ਬਿਨੁ, ਜੂਠਿ ਨ ਧੋਈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 245.92,
      "end_time": 252.542,
      "transcript": "ਇਸੁ ਮਾਰੀ ਬਿਨੁ, ਸਭੁ ਕਿਛੁ ਮੈਲਾ"
    },
    {
      "section_id": "section-00031",
      "start_time": 252.542,
      "end_time": 259.932,
      "transcript": "ਇਸੁ ਮਾਰੀ ਬਿਨੁ, ਸਭੁ ਕਿਛੁ ਜਉਲਾ"
    },
    {
      "section_id": "section-00032",
      "start_time": 259.932,
      "end_time": 267.08,
      "transcript": "ਜਾ ਕਉ, ਭਏ ਕ੍ਰਿਪਾਲ ਕ੍ਰਿਪਾ ਨਿਧਿ"
    },
    {
      "section_id": "section-00033",
      "start_time": 267.08,
      "end_time": 274.12,
      "transcript": "ਤਿਸੁ ਭਈ ਖਲਾਸੀ, ਹੋਈ ਸਗਲ ਸਿਧਿ"
    },
    {
      "section_id": "section-00034",
      "start_time": 274.12,
      "end_time": 280.885,
      "transcript": "ਗੁਰਿ, ਦੁਬਿਧਾ ਜਾ ਕੀ ਹੈ ਮਾਰੀ"
    },
    {
      "section_id": "section-00035",
      "start_time": 281.355,
      "end_time": 288.015,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਸੋ ਬ੍ਰਹਮ ਬੀਚਾਰੀ"
    }
  ]
}

{
  "audio_file": "0143 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.185,
      "end_time": 8.194,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.195,
      "end_time": 24.215,
      "transcript": "ਨਾਮੁ ਭਗਤ ਕੈ, ਪ੍ਰਾਨ ਅਧਾਰੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 24.375,
      "end_time": 32.005,
      "transcript": "ਨਾਮੋ ਧਨੁ, ਨਾਮੋ ਬਿਉਹਾਰੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.495,
      "end_time": 40.335,
      "transcript": "ਨਾਮ ਵਡਾਈ, ਜਨੁ ਸੋਭਾ ਪਾਏ"
    },
    {
      "section_id": "section-00005",
      "start_time": 40.6,
      "end_time": 48.695,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਜਿਸੁ ਆਪਿ ਦਿਵਾਏ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.515,
      "end_time": 76.49,
      "transcript": "ਨਾਮੁ ਭਗਤ ਕੈ, ਸੁਖ ਅਸਥਾਨੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.49,
      "end_time": 84.6,
      "transcript": "ਨਾਮ ਰਤੁ, ਸੋ ਭਗਤੁ ਪਰਵਾਨੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.6,
      "end_time": 92.445,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਜਨ ਕਉ ਧਾਰੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 92.445,
      "end_time": 100.465,
      "transcript": "ਸਾਸਿ ਸਾਸਿ, ਜਨੁ ਨਾਮੁ ਸਮਾਰੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 100.465,
      "end_time": 108.421,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਿਸੁ ਪੂਰਾ ਭਾਗੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 108.421,
      "end_time": 115.68,
      "transcript": "ਨਾਮ ਸੰਗਿ, ਤਾ ਕਾ ਮਨੁ ਲਾਗੁ"
    }
  ]
}

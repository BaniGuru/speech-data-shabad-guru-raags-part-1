{
  "audio_file": "0145 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.295,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.985,
      "end_time": 19.235,
      "transcript": "ਜਿਸੁ ਸਿਮਰਤ, ਦੂਖੁ ਸਭੁ ਜਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.485,
      "end_time": 25.96,
      "transcript": "ਨਾਮੁ ਰਤਨੁ, ਵਸੈ ਮਨਿ ਆਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.96,
      "end_time": 32.486,
      "transcript": "ਜਪਿ ਮਨ ਮੇਰੇ, ਗੋਵਿੰਦ ਕੀ ਬਾਣੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.486,
      "end_time": 42.215,
      "transcript": "ਸਾਧੂ ਜਨ, ਰਾਮੁ ਰਸਨ ਵਖਾਣੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.68,
      "end_time": 55.095,
      "transcript": "ਇਕਸੁ ਬਿਨੁ, ਨਾਹੀ ਦੂਜਾ ਕੋਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.095,
      "end_time": 61.68,
      "transcript": "ਜਾ ਕੀ ਦ੍ਰਿਸਟਿ, ਸਦਾ ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.68,
      "end_time": 68.005,
      "transcript": "ਸਾਜਨੁ ਮੀਤੁ, ਸਖਾ ਕਰਿ ਏਕੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.005,
      "end_time": 74.355,
      "transcript": "ਹਰਿ ਹਰਿ ਅਖਰ, ਮਨ ਮਹਿ ਲੇਖੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.355,
      "end_time": 80.785,
      "transcript": "ਰਵਿ ਰਹਿਆ ਸਰਬਤ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.785,
      "end_time": 86.985,
      "transcript": "ਗੁਣ ਗਾਵੈ ਨਾਨਕੁ, ਅੰਤਰਜਾਮੀ"
    }
  ]
}

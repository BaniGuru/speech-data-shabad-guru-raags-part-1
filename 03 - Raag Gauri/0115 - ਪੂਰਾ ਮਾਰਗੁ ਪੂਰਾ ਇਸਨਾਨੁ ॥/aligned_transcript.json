{
  "audio_file": "0142 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.395,
      "end_time": 8.268,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.943,
      "end_time": 23.665,
      "transcript": "ਪੂਰਾ ਮਾਰਗੁ, ਪੂਰਾ ਇਸਨਾਨੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.665,
      "end_time": 31.305,
      "transcript": "ਸਭੁ ਕਿਛੁ ਪੂਰਾ, ਹਿਰਦੈ ਨਾਮੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.64,
      "end_time": 39.13,
      "transcript": "ਪੂਰੀ ਰਹੀ, ਜਾ ਪੂਰੈ ਰਾਖੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.13,
      "end_time": 47.44,
      "transcript": "ਪਾਰਬ੍ਰਹਮ ਕੀ ਸਰਣਿ, ਜਨ ਤਾਕੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.735,
      "end_time": 66.205,
      "transcript": "ਪੂਰਾ ਸੁਖੁ, ਪੂਰਾ ਸੰਤੋਖੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.68,
      "end_time": 74.355,
      "transcript": "ਪੂਰਾ ਤਪੁ, ਪੂਰਨ ਰਾਜੁ ਜੋਗੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.355,
      "end_time": 81.785,
      "transcript": "ਹਰਿ ਕੈ ਮਾਰਗਿ, ਪਤਿਤ ਪੁਨੀਤ"
    },
    {
      "section_id": "section-00009",
      "start_time": 82.32,
      "end_time": 89.715,
      "transcript": "ਪੂਰੀ ਸੋਭਾ, ਪੂਰਾ ਲੋਕੀਕ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.04,
      "end_time": 97.655,
      "transcript": "ਕਰਣਹਾਰੁ, ਸਦ ਵਸੈ ਹਦੂਰਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.935,
      "end_time": 105.115,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਮੇਰਾ ਸਤਿਗੁਰੁ ਪੂਰਾ"
    }
  ]
}

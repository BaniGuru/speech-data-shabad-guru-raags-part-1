{
  "audio_file": "0159 B PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.355,
      "end_time": 7.415,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.68,
      "end_time": 22.04,
      "transcript": "ਮਨ ਧਰ ਤਰਬੇ, ਹਰਿ ਨਾਮ ਨੋ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.04,
      "end_time": 29.135,
      "transcript": "ਸਾਗਰ ਲਹਰਿ ਸੰਸਾ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 29.135,
      "end_time": 36.345,
      "transcript": "ਗੁਰੁ ਬੋਹਿਥੁ ਪਾਰ ਗਰਾਮਨੋ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.323,
      "end_time": 50.578,
      "transcript": "ਕਲਿ ਕਾਲਖ, ਅੰਧਿਆਰੀਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.578,
      "end_time": 57.545,
      "transcript": "ਗੁਰ ਗਿਆਨ ਦੀਪਕ, ਉਜਿਆਰੀਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.96,
      "end_time": 64.735,
      "transcript": "ਬਿਖੁ ਬਿਖਿਆ ਪਸਰੀ, ਅਤਿ ਘਨੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 65.24,
      "end_time": 72.405,
      "transcript": "ਉਬਰੇ, ਜਪਿ ਜਪਿ ਹਰਿ ਗੁਨੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.424,
      "end_time": 86.435,
      "transcript": "ਮਤਵਾਰੋ, ਮਾਇਆ ਸੋਇਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 86.8,
      "end_time": 93.705,
      "transcript": "ਗੁਰ ਭੇਟਤ, ਭ੍ਰਮੁ ਭਉ ਖੋਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.08,
      "end_time": 100.967,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਏਕੁ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 100.967,
      "end_time": 108.173,
      "transcript": "ਘਟਿ ਘਟਿ, ਨਦਰੀ ਆਇਆ"
    }
  ]
}

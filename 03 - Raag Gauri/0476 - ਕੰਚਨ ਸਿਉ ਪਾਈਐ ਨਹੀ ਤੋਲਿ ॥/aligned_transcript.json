  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.135,
      "end_time": 7.04,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ ਤਿਪਦੇ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.6,
      "end_time": 21.68,
      "transcript": "ਕੰਚਨ ਸਿਉ, ਪਾਈਐ ਨਹੀ ਤੋਲਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.68,
      "end_time": 28.84,
      "transcript": "ਮਨੁ ਦੇ, ਰਾਮੁ ਲੀਆ ਹੈ ਮੋਲਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.84,
      "end_time": 35.915,
      "transcript": "ਅਬ ਮੋਹਿ, ਰਾਮੁ ਅਪੁਨਾ ਕਰਿ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.915,
      "end_time": 42.833,
      "transcript": "ਸਹਜ ਸੁਭਾਇ ਮੇਰਾ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.833,
      "end_time": 46.6,
      "transcript": "ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.96,
      "end_time": 61.045,
      "transcript": "ਬ੍ਰਹਮੈ ਕਥਿ ਕਥਿ, ਅੰਤੁ ਨ ਪਾਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.045,
      "end_time": 68.065,
      "transcript": "ਰਾਮ ਭਗਤਿ, ਬੈਠੇ ਘਰਿ ਆਇਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.065,
      "end_time": 74.93,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਚੰਚਲ ਮਤਿ ਤਿਆਗੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.93,
      "end_time": 81.6,
      "transcript": "ਕੇਵਲ ਰਾਮ ਭਗਤਿ, ਨਿਜ ਭਾਗੀ"

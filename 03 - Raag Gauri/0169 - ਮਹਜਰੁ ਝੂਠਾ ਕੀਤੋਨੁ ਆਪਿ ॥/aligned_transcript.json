    {
      "section_id": "section-00002",
      "start_time": 14.08,
      "end_time": 21.15,
      "transcript": "ਮਹਜਰੁ, ਝੂਠਾ ਕੀਤੋਨੁ ਆਪਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.15,
      "end_time": 28.339,
      "transcript": "ਪਾਪੀ ਕਉ, ਲਾਗਾ ਸੰਤਾਪੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.28,
      "end_time": 42.2,
      "transcript": "ਜਿਸਹਿ ਸਹਾਈ, ਗੋਬਿਦੁ ਮੇਰਾ"

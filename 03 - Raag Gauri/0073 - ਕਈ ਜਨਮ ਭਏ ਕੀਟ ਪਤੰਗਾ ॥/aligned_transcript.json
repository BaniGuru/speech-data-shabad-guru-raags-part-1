{
  "audio_file": "0133 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.791,
      "end_time": 8.574,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.48,
      "end_time": 24.04,
      "transcript": "ਕਈ ਜਨਮ ਭਏ ਕੀਟ ਪਤੰਗਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 24.04,
      "end_time": 31.48,
      "transcript": "ਕਈ ਜਨਮ ਗਜ ਮੀਨ ਕੁਰੰਗਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.48,
      "end_time": 39.04,
      "transcript": "ਕਈ ਜਨਮ ਪੰਖੀ ਸਰਪ ਹੋਇਓ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.04,
      "end_time": 46.52,
      "transcript": "ਕਈ ਜਨਮ ਹੈਵਰ ਬ੍ਰਿਖ ਜੋਇਓ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.52,
      "end_time": 54.16,
      "transcript": "ਮਿਲੁ ਜਗਦੀਸ, ਮਿਲਨ ਕੀ ਬਰੀਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.16,
      "end_time": 65.56,
      "transcript": "ਚਿਰੰਕਾਲ ਇਹ ਦੇਹ ਸੰਜਰੀਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.6,
      "end_time": 84.28,
      "transcript": "ਕਈ ਜਨਮ ਸੈਲ ਗਿਰਿ ਕਰਿਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.28,
      "end_time": 91.88,
      "transcript": "ਕਈ ਜਨਮ, ਗਰਭ ਹਿਰਿ ਖਰਿਆ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.88,
      "end_time": 99.346,
      "transcript": "ਕਈ ਜਨਮ ਸਾਖ ਕਰਿ ਉਪਾਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 99.346,
      "end_time": 106.832,
      "transcript": "ਲਖ ਚਉਰਾਸੀਹ, ਜੋਨਿ ਭ੍ਰਮਾਇਆ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.832,
      "end_time": 114.68,
      "transcript": "ਸਾਧਸੰਗਿ ਭਇਓ ਜਨਮੁ ਪਰਾਪਤਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.68,
      "end_time": 122.12,
      "transcript": "ਕਰਿ ਸੇਵਾ ਭਜੁ ਹਰਿ ਹਰਿ ਗੁਰਮਤਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 122.12,
      "end_time": 129.523,
      "transcript": "ਤਿਆਗਿ ਮਾਨੁ, ਝੂਠੁ ਅਭਿਮਾਨੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 129.523,
      "end_time": 137.32,
      "transcript": "ਜੀਵਤ ਮਰਹਿ, ਦਰਗਹ ਪਰਵਾਨੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 137.32,
      "end_time": 144.96,
      "transcript": "ਜੋ ਕਿਛੁ ਹੋਆ, ਸੁ ਤੁਝ ਤੇ ਹੋਗੁ"
    },
    {
      "section_id": "section-00017",
      "start_time": 144.96,
      "end_time": 152.36,
      "transcript": "ਅਵਰੁ ਨ ਦੂਜਾ ਕਰਣੈ ਜੋਗੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 152.6,
      "end_time": 160.24,
      "transcript": "ਤਾ ਮਿਲੀਐ, ਜਾ ਲੈਹਿ ਮਿਲਾਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 160.24,
      "end_time": 167.63,
      "transcript": "ਕਹੁ ਨਾਨਕ ਹਰਿ ਹਰਿ ਗੁਣ ਗਾਇ"
    }
  ]
}

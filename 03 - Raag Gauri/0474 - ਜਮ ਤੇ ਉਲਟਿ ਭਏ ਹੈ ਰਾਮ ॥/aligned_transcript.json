{
  "audio_file": "0241 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 7.705,
      "end_time": 13.671,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.56,
      "end_time": 22.27,
      "transcript": "ਤਿਪਦੇ ਚਾਰਤੁਕੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 41.225,
      "end_time": 47.965,
      "transcript": "ਜਮ ਤੇ ਉਲਟਿ, ਭਏ ਹੈ ਰਾਮ"
    },
    {
      "section_id": "section-00004",
      "start_time": 48.56,
      "end_time": 55.215,
      "transcript": "ਦੁਖ ਬਿਨਸੇ, ਸੁਖ ਕੀਓ ਬਿਸਰਾਮ"
    },
    {
      "section_id": "section-00005",
      "start_time": 55.705,
      "end_time": 62.425,
      "transcript": "ਬੈਰੀ ਉਲਟਿ, ਭਏ ਹੈ ਮੀਤਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.865,
      "end_time": 70.095,
      "transcript": "ਸਾਕਤ ਉਲਟਿ, ਸੁਜਨ ਭਏ ਚੀਤਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.095,
      "end_time": 77.095,
      "transcript": "ਅਬ ਮੋਹਿ, ਸਰਬ ਕੁਸਲ ਕਰਿ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.095,
      "end_time": 83.887,
      "transcript": "ਸਾਂਤਿ ਭਈ ਜਬ ਗੋਬਿਦੁ ਜਾਨਿਆ"
    },
    {
      "section_id": "section-00009",
      "start_time": 83.887,
      "end_time": 88.115,
      "transcript": "ਰਹਾਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 95.08,
      "end_time": 102.4,
      "transcript": "ਤਨ ਮਹਿ ਹੋਤੀ, ਕੋਟਿ ਉਪਾਧਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 102.4,
      "end_time": 109.035,
      "transcript": "ਉਲਟਿ ਭਈ, ਸੁਖ ਸਹਜਿ ਸਮਾਧਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 109.705,
      "end_time": 116.465,
      "transcript": "ਆਪੁ ਪਛਾਨੈ, ਆਪੈ ਆਪ"
    },
    {
      "section_id": "section-00013",
      "start_time": 116.915,
      "end_time": 123.715,
      "transcript": "ਰੋਗੁ ਨ ਬਿਆਪੈ, ਤੀਨੌ ਤਾਪ"
    },
    {
      "section_id": "section-00014",
      "start_time": 124.2,
      "end_time": 131.48,
      "transcript": "ਅਬ ਮਨੁ ਉਲਟਿ, ਸਨਾਤਨੁ ਹੂਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 131.48,
      "end_time": 138.515,
      "transcript": "ਤਬ ਜਾਨਿਆ, ਜਬ ਜੀਵਤ ਮੂਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 138.515,
      "end_time": 145.395,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਸੁਖਿ ਸਹਜਿ ਸਮਾਵਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 145.925,
      "end_time": 152.505,
      "transcript": "ਆਪਿ ਨ ਡਰਉ, ਨ ਅਵਰ ਡਰਾਵਉ"
    }
  ]
}

{
  "audio_file": "0242 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.855,
      "end_time": 13.507,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 23.04,
      "end_time": 30.33,
      "transcript": "ਬਿਨੁ ਸਤ, ਸਤੀ ਹੋਇ ਕੈਸੇ ਨਾਰਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 30.33,
      "end_time": 37.535,
      "transcript": "ਪੰਡਿਤ ਦੇਖਹੁ, ਰਿਦੈ ਬੀਚਾਰਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 37.535,
      "end_time": 44.8,
      "transcript": "ਪ੍ਰੀਤਿ ਬਿਨਾ, ਕੈਸੇ ਬਧੈ ਸਨੇਹੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.8,
      "end_time": 51.925,
      "transcript": "ਜਬ ਲਗੁ ਰਸੁ, ਤਬ ਲਗੁ ਨਹੀ ਨੇਹੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.915,
      "end_time": 66.2,
      "transcript": "ਸਾਹਨਿ ਸਤੁ ਕਰੈ, ਜੀਅ ਅਪਨੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.2,
      "end_time": 73.24,
      "transcript": "ਸੋ ਰਮਯੇ ਕਉ, ਮਿਲੈ ਨ ਸੁਪਨੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 73.24,
      "end_time": 79.93,
      "transcript": "ਤਨੁ ਮਨੁ ਧਨੁ, ਗ੍ਰਿਹੁ ਸਉਪਿ ਸਰੀਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 79.93,
      "end_time": 86.875,
      "transcript": "ਸੋਈ ਸੁਹਾਗਨਿ, ਕਹੈ ਕਬੀਰੁ"
    }
  ]
}

{
  "audio_file": "0163 B PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.445,
      "transcript": "ਗਉੜੀ ਮਾਲਾ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.12,
      "end_time": 22.485,
      "transcript": "ਮੋ ਕਉ, ਇਹ ਬਿਧਿ ਕੋ ਸਮਝਾਵੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.485,
      "end_time": 29.958,
      "transcript": "ਕਰਤਾ ਹੋਇ ਜਨਾਵੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 37.32,
      "end_time": 44.815,
      "transcript": "ਅਨਜਾਨਤ ਕਿਛੁ ਇਨਹਿ ਕਮਾਨੋ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.815,
      "end_time": 52.237,
      "transcript": "ਜਪ ਤਪ ਕਛੂ ਨ ਸਾਧਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 52.237,
      "end_time": 59.725,
      "transcript": "ਦਹ ਦਿਸਿ ਲੈ ਇਹੁ ਮਨੁ ਦਉਰਾਇਓ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.725,
      "end_time": 67.035,
      "transcript": "ਕਵਨ ਕਰਮ ਕਰਿ ਬਾਧਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.175,
      "end_time": 74.84,
      "transcript": "ਮਨ ਤਨ ਧਨ ਭੂਮਿ ਕਾ ਠਾਕੁਰੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 74.84,
      "end_time": 81.969,
      "transcript": "ਹਉ ਇਸ ਕਾ ਇਹੁ ਮੇਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 81.969,
      "end_time": 89.76,
      "transcript": "ਭਰਮ ਮੋਹ ਕਛੁ ਸੂਝਸਿ ਨਾਹੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 89.76,
      "end_time": 97.19,
      "transcript": "ਇਹ ਪੈਖਰ ਪਏ ਪੈਰਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.19,
      "end_time": 104.71,
      "transcript": "ਤਬ ਇਹੁ ਕਹਾ ਕਮਾਵਨ ਪਰਿਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 104.71,
      "end_time": 112.145,
      "transcript": "ਜਬ ਇਹੁ ਕਛੂ ਨ ਹੋਤਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 119.68,
      "end_time": 127.015,
      "transcript": "ਜਬ ਏਕ ਨਿਰੰਜਨ ਨਿਰੰਕਾਰ ਪ੍ਰਭ"
    },
    {
      "section_id": "section-00015",
      "start_time": 127.015,
      "end_time": 134.436,
      "transcript": "ਸਭੁ ਕਿਛੁ ਆਪਹਿ ਕਰਤਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 134.436,
      "end_time": 142.065,
      "transcript": "ਅਪਨੇ ਕਰਤਬ ਆਪੇ ਜਾਨੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 142.065,
      "end_time": 149.355,
      "transcript": "ਜਿਨਿ ਇਹੁ ਰਚਨੁ ਰਚਾਇਆ"
    },
    {
      "section_id": "section-00018",
      "start_time": 149.6,
      "end_time": 157.16,
      "transcript": "ਕਹੁ ਨਾਨਕ ਕਰਣਹਾਰੁ ਹੈ ਆਪੇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 157.16,
      "end_time": 163.875,
      "transcript": "ਸਤਿਗੁਰਿ ਭਰਮੁ ਚੁਕਾਇਆ"
    }
  ]
}

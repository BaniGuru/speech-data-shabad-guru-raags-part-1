{
  "audio_file": "0118 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.28,
      "end_time": 7.862,
      "transcript": "ਗਉੜੀ ਚੇਤੀ ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.602,
      "end_time": 23.677,
      "transcript": "ਮੁੰਦ੍ਰਾ ਤੇ ਘਟ ਭੀਤਰਿ ਮੁੰਦ੍ਰਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.677,
      "end_time": 31.544,
      "transcript": "ਕਾਂਇਆ ਕੀਜੈ ਖਿੰਥਾਤਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.544,
      "end_time": 39.495,
      "transcript": "ਪੰਚ ਚੇਲੇ ਵਸਿ ਕੀਜਹਿ ਰਾਵਲ"
    },
    {
      "section_id": "section-00005",
      "start_time": 39.495,
      "end_time": 47.468,
      "transcript": "ਇਹੁ ਮਨੁ ਕੀਜੈ ਡੰਡਾਤਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 47.468,
      "end_time": 55.052,
      "transcript": "ਜੋਗ ਜੁਗਤਿ, ਇਵ ਪਾਵਸਿਤਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.052,
      "end_time": 62.962,
      "transcript": "ਏਕੁ ਸਬਦੁ ਦੂਜਾ ਹੋਰੁ ਨਾਸਤਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 62.962,
      "end_time": 71.157,
      "transcript": "ਕੰਦ ਮੂਲਿ ਮਨੁ ਲਾਵਸਿਤਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 78.631,
      "end_time": 86.534,
      "transcript": "ਮੂੰਡਿ ਮੁੰਡਾਇਐ ਜੇ ਗੁਰੁ ਪਾਈਐ"
    },
    {
      "section_id": "section-00010",
      "start_time": 86.534,
      "end_time": 94.173,
      "transcript": "ਹਮ ਗੁਰੁ ਕੀਨੀ ਗੰਗਾਤਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.173,
      "end_time": 102.275,
      "transcript": "ਤ੍ਰਿਭਵਣ ਤਾਰਣਹਾਰੁ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 102.275,
      "end_time": 109.916,
      "transcript": "ਏਕੁ ਨ ਚੇਤਸਿ ਅੰਧਾਤਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 109.916,
      "end_time": 117.842,
      "transcript": "ਕਰਿ ਪਟੰਬੁ ਗਲੀ ਮਨੁ ਲਾਵਸਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 117.842,
      "end_time": 125.459,
      "transcript": "ਸੰਸਾ ਮੂਲਿ ਨ ਜਾਵਸਿਤਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 125.459,
      "end_time": 133.317,
      "transcript": "ਏਕਸੁ ਚਰਣੀ ਜੇ ਚਿਤੁ ਲਾਵਹਿ"
    },
    {
      "section_id": "section-00016",
      "start_time": 133.317,
      "end_time": 141.08,
      "transcript": "ਲਬਿ ਲੋਭਿ ਕੀ ਧਾਵਸਿਤਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 141.08,
      "end_time": 148.843,
      "transcript": "ਜਪਸਿ ਨਿਰੰਜਨੁ, ਰਚਸਿ ਮਨਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 148.843,
      "end_time": 156.686,
      "transcript": "ਕਾਹੇ ਬੋਲਹਿ ਜੋਗੀ, ਕਪਟੁ ਘਨਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00019",
      "start_time": 164.72,
      "end_time": 172.298,
      "transcript": "ਕਾਇਆ ਕਮਲੀ ਹੰਸੁ ਇਆਣਾ"
    },
    {
      "section_id": "section-00020",
      "start_time": 172.298,
      "end_time": 180.166,
      "transcript": "ਮੇਰੀ ਮੇਰੀ ਕਰਤ ਬਿਹਾਣੀਤਾ"
    },
    {
      "section_id": "section-00021",
      "start_time": 180.166,
      "end_time": 187.986,
      "transcript": "ਪ੍ਰਣਵਤਿ ਨਾਨਕੁ ਨਾਗੀ ਦਾਝੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 187.986,
      "end_time": 195.564,
      "transcript": "ਫਿਰਿ ਪਾਛੈ ਪਛੁਤਾਣੀਤਾ"
    }
  ]
}

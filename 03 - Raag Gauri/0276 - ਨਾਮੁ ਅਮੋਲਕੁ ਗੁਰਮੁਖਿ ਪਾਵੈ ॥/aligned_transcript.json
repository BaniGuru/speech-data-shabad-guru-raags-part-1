{
  "audio_file": "0176 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.295,
      "end_time": 7.605,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.535,
      "end_time": 23.32,
      "transcript": "ਨਾਮੁ ਅਮੋਲਕੁ, ਗੁਰਮੁਖਿ ਪਾਵੈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.32,
      "end_time": 30.705,
      "transcript": "ਨਾਮੋ ਸੇਵੇ, ਨਾਮਿ ਸਹਜਿ ਸਮਾਵੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 30.705,
      "end_time": 38.52,
      "transcript": "ਅੰਮ੍ਰਿਤੁ ਨਾਮੁ, ਰਸਨਾ ਨਿਤ ਗਾਵੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.52,
      "end_time": 46.213,
      "transcript": "ਜਿਸ ਨੋ ਕ੍ਰਿਪਾ ਕਰੇ, ਸੋ ਹਰਿ ਰਸੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.84,
      "end_time": 61.32,
      "transcript": "ਅਨਦਿਨੁ, ਹਿਰਦੈ ਜਪਉ ਜਗਦੀਸਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.32,
      "end_time": 69.185,
      "transcript": "ਗੁਰਮੁਖਿ ਪਾਵਉ, ਪਰਮ ਪਦੁ ਸੂਖਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.402,
      "end_time": 83.845,
      "transcript": "ਹਿਰਦੈ, ਸੂਖੁ ਭਇਆ ਪਰਗਾਸੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.24,
      "end_time": 91.619,
      "transcript": "ਗੁਰਮੁਖਿ, ਗਾਵਹਿ ਸਚੁ ਗੁਣਤਾਸੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 91.619,
      "end_time": 99.445,
      "transcript": "ਦਾਸਨਿ ਦਾਸ, ਨਿਤ ਹੋਵਹਿ ਦਾਸੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 99.445,
      "end_time": 106.828,
      "transcript": "ਗ੍ਰਿਹ ਕੁਟੰਬ ਮਹਿ, ਸਦਾ ਉਦਾਸੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.828,
      "end_time": 114.21,
      "transcript": "ਜੀਵਨ ਮੁਕਤੁ, ਗੁਰਮੁਖਿ ਕੋ ਹੋਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 114.21,
      "end_time": 121.72,
      "transcript": "ਪਰਮ ਪਦਾਰਥੁ, ਪਾਵੈ ਸੋਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 121.72,
      "end_time": 129.365,
      "transcript": "ਤ੍ਰੈ ਗੁਣ ਮੇਟੇ, ਨਿਰਮਲੁ ਹੋਈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 129.365,
      "end_time": 137.113,
      "transcript": "ਸਹਜੇ ਸਾਚਿ ਮਿਲੈ, ਪ੍ਰਭੁ ਸੋਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 144.825,
      "end_time": 152.125,
      "transcript": "ਮੋਹ ਕੁਟੰਬ ਸਿਉ, ਪ੍ਰੀਤਿ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 152.455,
      "end_time": 159.915,
      "transcript": "ਜਾ, ਹਿਰਦੈ ਵਸਿਆ ਸਚੁ ਸੋਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 159.915,
      "end_time": 167.58,
      "transcript": "ਗੁਰਮੁਖਿ ਮਨੁ ਬੇਧਿਆ, ਅਸਥਿਰੁ ਹੋਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 167.58,
      "end_time": 175.24,
      "transcript": "ਹੁਕਮੁ ਪਛਾਣੈ, ਬੂਝੈ ਸਚੁ ਸੋਇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 175.24,
      "end_time": 182.717,
      "transcript": "ਤੂੰ ਕਰਤਾ, ਮੈ ਅਵਰੁ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 182.717,
      "end_time": 190.225,
      "transcript": "ਤੁਝੁ ਸੇਵੀ, ਤੁਝ ਤੇ ਪਤਿ ਹੋਇ"
    },
    {
      "section_id": "section-00022",
      "start_time": 190.225,
      "end_time": 198.074,
      "transcript": "ਕਿਰਪਾ ਕਰਹਿ, ਗਾਵਾ ਪ੍ਰਭੁ ਸੋਇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 198.074,
      "end_time": 205.743,
      "transcript": "ਨਾਮ ਰਤਨੁ, ਸਭ ਜਗ ਮਹਿ ਲੋਇ"
    },
    {
      "section_id": "section-00024",
      "start_time": 213.44,
      "end_time": 220.896,
      "transcript": "ਗੁਰਮੁਖਿ ਬਾਣੀ, ਮੀਠੀ ਲਾਗੀ"
    },
    {
      "section_id": "section-00025",
      "start_time": 220.896,
      "end_time": 228.605,
      "transcript": "ਅੰਤਰੁ ਬਿਗਸੈ, ਅਨਦਿਨੁ ਲਿਵ ਲਾਗੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 228.605,
      "end_time": 235.865,
      "transcript": "ਸਹਜੇ ਸਚੁ ਮਿਲਿਆ, ਪਰਸਾਦੀ"
    },
    {
      "section_id": "section-00027",
      "start_time": 236.32,
      "end_time": 244.0,
      "transcript": "ਸਤਿਗੁਰੁ ਪਾਇਆ, ਪੂਰੈ ਵਡਭਾਗੀ"
    },
    {
      "section_id": "section-00028",
      "start_time": 244.0,
      "end_time": 251.33,
      "transcript": "ਹਉਮੈ ਮਮਤਾ, ਦੁਰਮਤਿ ਦੁਖ ਨਾਸੁ"
    },
    {
      "section_id": "section-00029",
      "start_time": 251.33,
      "end_time": 259.08,
      "transcript": "ਜਬ ਹਿਰਦੈ, ਰਾਮ ਨਾਮ ਗੁਣਤਾਸੁ"
    },
    {
      "section_id": "section-00030",
      "start_time": 259.08,
      "end_time": 266.455,
      "transcript": "ਗੁਰਮੁਖਿ ਬੁਧਿ ਪ੍ਰਗਟੀ, ਪ੍ਰਭ ਜਾਸੁ"
    },
    {
      "section_id": "section-00031",
      "start_time": 266.455,
      "end_time": 274.293,
      "transcript": "ਜਬ ਹਿਰਦੈ, ਰਵਿਆ ਚਰਣ ਨਿਵਾਸੁ"
    },
    {
      "section_id": "section-00032",
      "start_time": 281.56,
      "end_time": 289.04,
      "transcript": "ਜਿਸੁ ਨਾਮੁ ਦੇਇ, ਸੋਈ ਜਨੁ ਪਾਏ"
    },
    {
      "section_id": "section-00033",
      "start_time": 289.04,
      "end_time": 296.62,
      "transcript": "ਗੁਰਮੁਖਿ ਮੇਲੇ, ਆਪੁ ਗਵਾਏ"
    },
    {
      "section_id": "section-00034",
      "start_time": 296.62,
      "end_time": 303.835,
      "transcript": "ਹਿਰਦੈ, ਸਾਚਾ ਨਾਮੁ ਵਸਾਏ"
    },
    {
      "section_id": "section-00035",
      "start_time": 304.265,
      "end_time": 311.856,
      "transcript": "ਨਾਨਕ, ਸਹਜੇ ਸਾਚਿ ਸਮਾਏ"
    },
    {
      "section_id": "section-00036",
      "start_time": 311.856,
      "end_time": 319.15,
      "transcript": "ਹਿਰਦੈ, ਸਾਚਾ ਨਾਮੁ ਵਸਾਏ"
    },
    {
      "section_id": "section-00037",
      "start_time": 319.15,
      "end_time": 327.855,
      "transcript": "ਨਾਨਕ, ਸਹਜੇ ਸਾਚਿ ਸਮਾਏ"
    }
  ]
}

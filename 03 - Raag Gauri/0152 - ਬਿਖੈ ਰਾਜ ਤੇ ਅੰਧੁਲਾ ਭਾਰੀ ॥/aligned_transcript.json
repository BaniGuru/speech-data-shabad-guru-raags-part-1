{
  "audio_file": "0148 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.455,
      "end_time": 8.105,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 16.485,
      "end_time": 24.427,
      "transcript": "ਬਿਖੈ ਰਾਜ ਤੇ, ਅੰਧੁਲਾ ਭਾਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 24.427,
      "end_time": 32.455,
      "transcript": "ਦੁਖਿ ਲਾਗੈ, ਰਾਮ ਨਾਮੁ ਚਿਤਾਰੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 32.8,
      "end_time": 40.365,
      "transcript": "ਤੇਰੇ ਦਾਸ ਕਉ, ਤੁਹੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 40.825,
      "end_time": 49.065,
      "transcript": "ਮਾਇਆ ਮਗਨੁ, ਨਰਕਿ ਲੈ ਜਾਈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.825,
      "end_time": 76.615,
      "transcript": "ਰੋਗ ਗਿਰਸਤ, ਚਿਤਾਰੇ ਨਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 76.815,
      "end_time": 84.84,
      "transcript": "ਬਿਖੁ ਮਾਤੇ ਕਾ, ਠਉਰ ਨ ਠਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 84.84,
      "end_time": 92.345,
      "transcript": "ਚਰਨ ਕਮਲ ਸਿਉ, ਲਾਗੀ ਪ੍ਰੀਤਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 92.88,
      "end_time": 100.375,
      "transcript": "ਆਨ ਸੁਖਾ, ਨਹੀ ਆਵਹਿ ਚੀਤਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 100.935,
      "end_time": 108.675,
      "transcript": "ਸਦਾ ਸਦਾ ਸਿਮਰਉ, ਪ੍ਰਭ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 108.915,
      "end_time": 115.84,
      "transcript": "ਮਿਲੁ ਨਾਨਕ, ਹਰਿ ਅੰਤਰਜਾਮੀ"
    }
  ]
}

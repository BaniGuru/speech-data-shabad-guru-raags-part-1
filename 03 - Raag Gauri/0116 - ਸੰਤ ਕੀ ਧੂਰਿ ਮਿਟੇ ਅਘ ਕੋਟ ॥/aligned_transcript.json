{
  "audio_file": "0142 FPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.965,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 15.84,
      "end_time": 23.055,
      "transcript": "ਸੰਤ ਕੀ ਧੂਰਿ, ਮਿਟੇ ਅਘ ਕੋਟ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.6,
      "end_time": 30.855,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਜਨਮ ਮਰਣ ਤੇ ਛੋਟ"
    },
    {
      "section_id": "section-00004",
      "start_time": 31.315,
      "end_time": 38.98,
      "transcript": "ਸੰਤ ਕਾ ਦਰਸੁ, ਪੂਰਨ ਇਸਨਾਨੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 38.98,
      "end_time": 47.38,
      "transcript": "ਸੰਤ ਕ੍ਰਿਪਾ ਤੇ, ਜਪੀਐ ਨਾਮੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 58.76,
      "end_time": 66.6,
      "transcript": "ਸੰਤ ਕੈ ਸੰਗਿ, ਮਿਟਿਆ ਅਹੰਕਾਰੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.6,
      "end_time": 74.195,
      "transcript": "ਦ੍ਰਿਸਟਿ ਆਵੈ, ਸਭੁ ਏਕੰਕਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.415,
      "end_time": 82.055,
      "transcript": "ਸੰਤ ਸੁਪ੍ਰਸੰਨ, ਆਏ ਵਸਿ ਪੰਚਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 82.055,
      "end_time": 90.12,
      "transcript": "ਅੰਮ੍ਰਿਤੁ ਨਾਮੁ, ਰਿਦੈ ਲੈ ਸੰਚਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 90.12,
      "end_time": 97.335,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਾ ਕਾ ਪੂਰਾ ਕਰਮ"
    },
    {
      "section_id": "section-00011",
      "start_time": 97.88,
      "end_time": 105.085,
      "transcript": "ਤਿਸੁ ਭੇਟੇ, ਸਾਧੂ ਕੇ ਚਰਨ"
    }
  ]
}

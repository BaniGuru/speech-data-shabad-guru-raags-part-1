{
  "audio_file": "0219 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.475,
      "end_time": 14.973,
      "transcript": "ਸਲੋਕੁ ਗਿਆਨ ਅੰਜਨੁ ਗੁਰਿ ਦੀਆ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.973,
      "end_time": 22.335,
      "transcript": "ਅਗਿਆਨ ਅੰਧੇਰ ਬਿਨਾਸੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 23.2,
      "end_time": 33.24,
      "transcript": "ਹਰਿ ਕਿਰਪਾ ਤੇ ਸੰਤ ਭੇਟਿਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 33.24,
      "end_time": 46.603,
      "transcript": "ਨਾਨਕ ਮਨਿ ਪਰਗਾਸੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 49.16,
      "end_time": 51.315,
      "transcript": "ਅਸਟਪਦੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 69.195,
      "end_time": 78.095,
      "transcript": "ਸੰਤਸੰਗਿ, ਅੰਤਰਿ ਪ੍ਰਭੁ ਡੀਠਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 78.095,
      "end_time": 86.76,
      "transcript": "ਨਾਮੁ ਪ੍ਰਭੂ ਕਾ, ਲਾਗਾ ਮੀਠਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 86.76,
      "end_time": 95.155,
      "transcript": "ਸਗਲ ਸਮਿਗ੍ਰੀ, ਏਕਸੁ ਘਟ ਮਾਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 95.48,
      "end_time": 104.085,
      "transcript": "ਅਨਿਕ ਰੰਗ, ਨਾਨਾ ਦ੍ਰਿਸਟਾਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 104.085,
      "end_time": 112.335,
      "transcript": "ਨਉ ਨਿਧਿ, ਅੰਮ੍ਰਿਤੁ ਪ੍ਰਭ ਕਾ ਨਾਮੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 112.735,
      "end_time": 121.315,
      "transcript": "ਦੇਹੀ ਮਹਿ, ਇਸ ਕਾ ਬਿਸ੍ਰਾਮੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 121.48,
      "end_time": 129.505,
      "transcript": "ਸੁੰਨ ਸਮਾਧਿ, ਅਨਹਤ ਤਹ ਨਾਦ"
    },
    {
      "section_id": "section-00013",
      "start_time": 130.12,
      "end_time": 138.475,
      "transcript": "ਕਹਨੁ ਨ ਜਾਈ, ਅਚਰਜ ਬਿਸਮਾਦ"
    },
    {
      "section_id": "section-00014",
      "start_time": 138.72,
      "end_time": 147.225,
      "transcript": "ਤਿਨਿ ਦੇਖਿਆ, ਜਿਸੁ ਆਪਿ ਦਿਖਾਏ"
    },
    {
      "section_id": "section-00015",
      "start_time": 147.225,
      "end_time": 155.935,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਜਨ, ਸੋਝੀ ਪਾਏ"
    },
    {
      "section_id": "section-00016",
      "start_time": 168.96,
      "end_time": 177.345,
      "transcript": "ਸੋ ਅੰਤਰਿ, ਸੋ ਬਾਹਰਿ ਅਨੰਤ"
    },
    {
      "section_id": "section-00017",
      "start_time": 177.64,
      "end_time": 186.098,
      "transcript": "ਘਟਿ ਘਟਿ ਬਿਆਪਿ ਰਹਿਆ, ਭਗਵੰਤ"
    },
    {
      "section_id": "section-00018",
      "start_time": 186.098,
      "end_time": 194.525,
      "transcript": "ਧਰਨਿ ਮਾਹਿ, ਆਕਾਸ ਪਇਆਲ"
    },
    {
      "section_id": "section-00019",
      "start_time": 194.96,
      "end_time": 202.975,
      "transcript": "ਸਰਬ ਲੋਕ, ਪੂਰਨ ਪ੍ਰਤਿਪਾਲ"
    },
    {
      "section_id": "section-00020",
      "start_time": 203.64,
      "end_time": 211.685,
      "transcript": "ਬਨਿ ਤਿਨਿ, ਪਰਬਤਿ ਹੈ ਪਾਰਬ੍ਰਹਮੁ"
    },
    {
      "section_id": "section-00021",
      "start_time": 212.145,
      "end_time": 220.365,
      "transcript": "ਜੈਸੀ ਆਗਿਆ, ਤੈਸਾ ਕਰਮੁ"
    },
    {
      "section_id": "section-00022",
      "start_time": 220.92,
      "end_time": 228.895,
      "transcript": "ਪਉਣ ਪਾਣੀ, ਬੈਸੰਤਰ ਮਾਹਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 229.52,
      "end_time": 237.535,
      "transcript": "ਚਾਰਿ ਕੁੰਟ, ਦਹ ਦਿਸੇ ਸਮਾਹਿ"
    },
    {
      "section_id": "section-00024",
      "start_time": 238.12,
      "end_time": 246.035,
      "transcript": "ਤਿਸ ਤੇ ਭਿੰਨ, ਨਹੀ ਕੋ ਠਾਉ"
    },
    {
      "section_id": "section-00025",
      "start_time": 246.635,
      "end_time": 255.175,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਨਾਨਕ ਸੁਖੁ ਪਾਉ"
    },
    {
      "section_id": "section-00026",
      "start_time": 255.175,
      "end_time": 263.63,
      "transcript": "ਬੇਦ ਪੁਰਾਨ, ਸਿੰਮ੍ਰਿਤਿ ਮਹਿ ਦੇਖੁ"
    },
    {
      "section_id": "section-00027",
      "start_time": 263.63,
      "end_time": 272.265,
      "transcript": "ਸਸੀਅਰ ਸੂਰ, ਨਖੵਤ੍ਰ ਮਹਿ ਏਕੁ"
    },
    {
      "section_id": "section-00028",
      "start_time": 272.265,
      "end_time": 280.739,
      "transcript": "ਬਾਣੀ ਪ੍ਰਭ ਕੀ, ਸਭੁ ਕੋ ਬੋਲੈ"
    },
    {
      "section_id": "section-00029",
      "start_time": 280.739,
      "end_time": 289.312,
      "transcript": "ਆਪਿ ਅਡੋਲੁ, ਨ ਕਬਹੂ ਡੋਲੈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 289.312,
      "end_time": 297.68,
      "transcript": "ਸਰਬ ਕਲਾ ਕਰਿ, ਖੇਲੈ ਖੇਲ"
    },
    {
      "section_id": "section-00031",
      "start_time": 297.68,
      "end_time": 306.664,
      "transcript": "ਮੋਲਿ ਨ ਪਾਈਐ, ਗੁਣਹ ਅਮੋਲ"
    },
    {
      "section_id": "section-00032",
      "start_time": 306.664,
      "end_time": 315.13,
      "transcript": "ਸਰਬ ਜੋਤਿ ਮਹਿ, ਜਾ ਕੀ ਜੋਤਿ"
    },
    {
      "section_id": "section-00033",
      "start_time": 315.13,
      "end_time": 323.795,
      "transcript": "ਧਾਰਿ ਰਹਿਓ ਸੁਆਮੀ, ਓਤਿ ਪੋਤਿ"
    },
    {
      "section_id": "section-00034",
      "start_time": 324.005,
      "end_time": 332.215,
      "transcript": "ਗੁਰ ਪਰਸਾਦਿ, ਭਰਮ ਕਾ ਨਾਸੁ"
    },
    {
      "section_id": "section-00035",
      "start_time": 332.655,
      "end_time": 342.475,
      "transcript": "ਨਾਨਕ ਤਿਨ ਮਹਿ, ਏਹੁ ਬਿਸਾਸੁ"
    },
    {
      "section_id": "section-00036",
      "start_time": 354.24,
      "end_time": 362.84,
      "transcript": "ਸੰਤ ਜਨਾ ਕਾ, ਪੇਖਨੁ ਸਭੁ ਬ੍ਰਹਮ"
    },
    {
      "section_id": "section-00037",
      "start_time": 362.84,
      "end_time": 371.28,
      "transcript": "ਸੰਤ ਜਨਾ ਕੈ, ਹਿਰਦੈ ਸਭਿ ਧਰਮ"
    },
    {
      "section_id": "section-00038",
      "start_time": 371.28,
      "end_time": 379.175,
      "transcript": "ਸੰਤ ਜਨਾ, ਸੁਨਹਿ ਸੁਭ ਬਚਨ"
    },
    {
      "section_id": "section-00039",
      "start_time": 379.8,
      "end_time": 387.775,
      "transcript": "ਸਰਬ ਬਿਆਪੀ ਰਾਮ ਸੰਗਿ ਰਚਨ"
    },
    {
      "section_id": "section-00040",
      "start_time": 388.245,
      "end_time": 396.602,
      "transcript": "ਜਿਨਿ ਜਾਤਾ, ਤਿਸ ਕੀ ਇਹ ਰਹਤ"
    },
    {
      "section_id": "section-00041",
      "start_time": 396.602,
      "end_time": 404.875,
      "transcript": "ਸਤਿ ਬਚਨ, ਸਾਧੂ ਸਭਿ ਕਹਤ"
    },
    {
      "section_id": "section-00042",
      "start_time": 405.105,
      "end_time": 413.285,
      "transcript": "ਜੋ ਜੋ ਹੋਇ, ਸੋਈ ਸੁਖੁ ਮਾਨੈ"
    },
    {
      "section_id": "section-00043",
      "start_time": 413.92,
      "end_time": 421.825,
      "transcript": "ਕਰਨ ਕਰਾਵਨਹਾਰੁ, ਪ੍ਰਭੁ ਜਾਨੈ"
    },
    {
      "section_id": "section-00044",
      "start_time": 422.52,
      "end_time": 430.897,
      "transcript": "ਅੰਤਰਿ ਬਸੇ, ਬਾਹਰਿ ਭੀ ਓਹੀ"
    },
    {
      "section_id": "section-00045",
      "start_time": 430.897,
      "end_time": 439.535,
      "transcript": "ਨਾਨਕ ਦਰਸਨੁ ਦੇਖਿ, ਸਭ ਮੋਹੀ"
    },
    {
      "section_id": "section-00046",
      "start_time": 439.535,
      "end_time": 447.88,
      "transcript": "ਆਪਿ ਸਤਿ, ਕੀਆ ਸਭੁ ਸਤਿ"
    },
    {
      "section_id": "section-00047",
      "start_time": 447.88,
      "end_time": 456.4,
      "transcript": "ਤਿਸੁ ਪ੍ਰਭ ਤੇ, ਸਗਲੀ ਉਤਪਤਿ"
    },
    {
      "section_id": "section-00048",
      "start_time": 456.4,
      "end_time": 464.465,
      "transcript": "ਤਿਸੁ ਭਾਵੈ, ਤਾ ਕਰੇ ਬਿਸਥਾਰੁ"
    },
    {
      "section_id": "section-00049",
      "start_time": 464.92,
      "end_time": 473.6,
      "transcript": "ਤਿਸੁ ਭਾਵੈ, ਤਾ ਏਕੰਕਾਰੁ"
    },
    {
      "section_id": "section-00050",
      "start_time": 473.6,
      "end_time": 481.545,
      "transcript": "ਅਨਿਕ ਕਲਾ, ਲਖੀ ਨਹ ਜਾਇ"
    },
    {
      "section_id": "section-00051",
      "start_time": 481.935,
      "end_time": 490.421,
      "transcript": "ਜਿਸੁ ਭਾਵੈ, ਤਿਸੁ ਲਏ ਮਿਲਾਇ"
    },
    {
      "section_id": "section-00052",
      "start_time": 490.421,
      "end_time": 498.864,
      "transcript": "ਕਵਨ ਨਿਕਟਿ, ਕਵਨ ਕਹੀਐ ਦੂਰਿ"
    },
    {
      "section_id": "section-00053",
      "start_time": 498.864,
      "end_time": 507.451,
      "transcript": "ਆਪੇ ਆਪਿ, ਆਪ ਭਰਪੂਰਿ"
    },
    {
      "section_id": "section-00054",
      "start_time": 507.451,
      "end_time": 515.535,
      "transcript": "ਅੰਤਰਗਤਿ, ਜਿਸੁ ਆਪਿ ਜਨਾਏ"
    },
    {
      "section_id": "section-00055",
      "start_time": 516.085,
      "end_time": 524.76,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਜਨ, ਆਪਿ ਬੁਝਾਏ"
    },
    {
      "section_id": "section-00056",
      "start_time": 524.76,
      "end_time": 533.28,
      "transcript": "ਸਰਬ ਭੂਤ, ਆਪਿ ਵਰਤਾਰਾ"
    },
    {
      "section_id": "section-00057",
      "start_time": 533.28,
      "end_time": 541.84,
      "transcript": "ਸਰਬ ਨੈਨ, ਆਪਿ ਪੇਖਨਹਾਰਾ"
    },
    {
      "section_id": "section-00058",
      "start_time": 541.84,
      "end_time": 549.909,
      "transcript": "ਸਗਲ ਸਮਗ੍ਰੀ, ਜਾ ਕਾ ਤਨਾ"
    },
    {
      "section_id": "section-00059",
      "start_time": 549.909,
      "end_time": 558.915,
      "transcript": "ਆਪਨ ਜਸੁ, ਆਪ ਹੀ ਸੁਨਾ"
    },
    {
      "section_id": "section-00060",
      "start_time": 558.915,
      "end_time": 566.805,
      "transcript": "ਆਵਨ ਜਾਨੁ, ਇਕੁ ਖੇਲੁ ਬਨਾਇਆ"
    },
    {
      "section_id": "section-00061",
      "start_time": 567.48,
      "end_time": 576.04,
      "transcript": "ਆਗਿਆਕਾਰੀ, ਕੀਨੀ ਮਾਇਆ"
    },
    {
      "section_id": "section-00062",
      "start_time": 576.04,
      "end_time": 584.395,
      "transcript": "ਸਭ ਕੈ ਮਧਿ, ਅਲਿਪਤੋ ਰਹੈ"
    },
    {
      "section_id": "section-00063",
      "start_time": 584.6,
      "end_time": 592.665,
      "transcript": "ਜੋ ਕਿਛੁ ਕਹਣਾ, ਸੁ ਆਪੇ ਕਹੈ"
    },
    {
      "section_id": "section-00064",
      "start_time": 593.165,
      "end_time": 601.462,
      "transcript": "ਆਗਿਆ ਆਵੈ, ਆਗਿਆ ਜਾਇ"
    },
    {
      "section_id": "section-00065",
      "start_time": 601.462,
      "end_time": 610.425,
      "transcript": "ਨਾਨਕ ਜਾ ਭਾਵੈ, ਤਾ ਲਏ ਸਮਾਇ"
    },
    {
      "section_id": "section-00066",
      "start_time": 622.494,
      "end_time": 631.185,
      "transcript": "ਇਸ ਤੇ ਹੋਇ, ਸੁ ਨਾਹੀ ਬੁਰਾ"
    },
    {
      "section_id": "section-00067",
      "start_time": 631.52,
      "end_time": 639.99,
      "transcript": "ਓਰੈ ਕਹਹੁ, ਕਿਨੈ ਕਛੁ ਕਰਾ"
    },
    {
      "section_id": "section-00068",
      "start_time": 639.99,
      "end_time": 648.075,
      "transcript": "ਆਪਿ ਭਲਾ, ਕਰਤੂਤਿ ਅਤਿ ਨੀਕੀ"
    },
    {
      "section_id": "section-00069",
      "start_time": 648.615,
      "end_time": 657.22,
      "transcript": "ਆਪੇ ਜਾਨੈ, ਅਪਨੇ ਜੀ ਕੀ"
    },
    {
      "section_id": "section-00070",
      "start_time": 657.22,
      "end_time": 665.275,
      "transcript": "ਆਪਿ ਸਾਚੁ, ਧਾਰੀ ਸਭ ਸਾਚੁ"
    },
    {
      "section_id": "section-00071",
      "start_time": 665.76,
      "end_time": 674.205,
      "transcript": "ਓਤਿ ਪੋਤਿ, ਆਪਨ ਸੰਗਿ ਰਾਚੁ"
    },
    {
      "section_id": "section-00072",
      "start_time": 674.4,
      "end_time": 682.345,
      "transcript": "ਤਾ ਕੀ ਗਤਿ ਮਿਤਿ, ਕਹੀ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00073",
      "start_time": 682.855,
      "end_time": 690.985,
      "transcript": "ਦੂਸਰ ਹੋਇ, ਤ ਸੋਝੀ ਪਾਇ"
    },
    {
      "section_id": "section-00074",
      "start_time": 691.48,
      "end_time": 699.705,
      "transcript": "ਤਿਸ ਕਾ ਕੀਆ, ਸਭੁ ਪਰਵਾਨੁ"
    },
    {
      "section_id": "section-00075",
      "start_time": 700.015,
      "end_time": 708.403,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ, ਨਾਨਕ ਇਹੁ ਜਾਨੁ"
    },
    {
      "section_id": "section-00076",
      "start_time": 708.403,
      "end_time": 716.435,
      "transcript": "ਜੋ ਜਾਨੈ, ਤਿਸੁ ਸਦਾ ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00077",
      "start_time": 717.095,
      "end_time": 725.482,
      "transcript": "ਆਪਿ ਮਿਲਾਇ ਲਏ, ਪ੍ਰਭੁ ਸੋਇ"
    },
    {
      "section_id": "section-00078",
      "start_time": 725.482,
      "end_time": 733.752,
      "transcript": "ਓਹੁ ਧਨਵੰਤੁ, ਕੁਲਵੰਤੁ ਪਤਿਵੰਤੁ"
    },
    {
      "section_id": "section-00079",
      "start_time": 733.752,
      "end_time": 742.72,
      "transcript": "ਜੀਵਨ ਮੁਕਤਿ, ਜਿਸੁ ਰਿਦੈ ਭਗਵੰਤੁ"
    },
    {
      "section_id": "section-00080",
      "start_time": 742.72,
      "end_time": 751.135,
      "transcript": "ਧੰਨੁ ਧੰਨੁ, ਧੰਨੁ ਜਨੁ ਆਇਆ"
    },
    {
      "section_id": "section-00081",
      "start_time": 751.135,
      "end_time": 759.225,
      "transcript": "ਜਿਸੁ ਪ੍ਰਸਾਦਿ, ਸਭੁ ਜਗਤੁ ਤਰਾਇਆ"
    },
    {
      "section_id": "section-00082",
      "start_time": 759.84,
      "end_time": 767.655,
      "transcript": "ਜਨ ਆਵਨ ਕਾ, ਇਹੈ ਸੁਆਉ"
    },
    {
      "section_id": "section-00083",
      "start_time": 768.195,
      "end_time": 776.305,
      "transcript": "ਜਨ ਕੈ ਸੰਗਿ, ਚਿਤਿ ਆਵੈ ਨਾਉ"
    },
    {
      "section_id": "section-00084",
      "start_time": 776.895,
      "end_time": 784.939,
      "transcript": "ਆਪਿ ਮੁਕਤੁ ਮੁਕਤੁ ਕਰੈ ਸੰਸਾਰੁ"
    },
    {
      "section_id": "section-00085",
      "start_time": 785.289,
      "end_time": 794.195,
      "transcript": "ਨਾਨਕ ਤਿਸੁ ਜਨ ਕਉ, ਸਦਾ ਨਮਸਕਾਰੁ"
    },
    {
      "section_id": "section-00086",

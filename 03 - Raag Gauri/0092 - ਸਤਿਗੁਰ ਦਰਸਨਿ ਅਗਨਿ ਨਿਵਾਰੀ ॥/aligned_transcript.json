{
  "audio_file": "0138 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.28,
      "end_time": 7.565,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.24,
      "end_time": 21.32,
      "transcript": "ਸਤਿਗੁਰ ਦਰਸਨਿ, ਅਗਨਿ ਨਿਵਾਰੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.32,
      "end_time": 28.4,
      "transcript": "ਸਤਿਗੁਰ ਭੇਟਤ, ਹਉਮੈ ਮਾਰੀ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.4,
      "end_time": 35.44,
      "transcript": "ਸਤਿਗੁਰ ਸੰਗਿ, ਨਾਹੀ ਮਨੁ ਡੋਲੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.44,
      "end_time": 42.4,
      "transcript": "ਅੰਮ੍ਰਿਤ ਬਾਣੀ, ਗੁਰਮੁਖਿ ਬੋਲੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 42.4,
      "end_time": 49.44,
      "transcript": "ਸਭੁ ਜਗੁ ਸਾਚਾ, ਜਾ ਸਚ ਮਹਿ ਰਾਤੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 49.44,
      "end_time": 60.145,
      "transcript": "ਸੀਤਲ ਸਾਤਿ ਗੁਰ ਤੇ ਪ੍ਰਭ ਜਾਤੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.48,
      "end_time": 70.48,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਜਪੈ ਹਰਿ ਨਾਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 70.48,
      "end_time": 77.48,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਹਰਿ ਕੀਰਤਨੁ ਗਾਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 77.48,
      "end_time": 84.44,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਸਗਲ ਦੁਖ ਮਿਟੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.44,
      "end_time": 91.769,
      "transcript": "ਸੰਤ ਪ੍ਰਸਾਦਿ, ਬੰਧਨ ਤੇ ਛੁਟੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 98.36,
      "end_time": 105.32,
      "transcript": "ਸੰਤ ਕ੍ਰਿਪਾ ਤੇ, ਮਿਟੇ ਮੋਹ ਭਰਮ"
    },
    {
      "section_id": "section-00013",
      "start_time": 105.32,
      "end_time": 112.32,
      "transcript": "ਸਾਧ ਰੇਣ, ਮਜਨ ਸਭਿ ਧਰਮ"
    },
    {
      "section_id": "section-00014",
      "start_time": 112.32,
      "end_time": 119.28,
      "transcript": "ਸਾਧ ਕ੍ਰਿਪਾਲ ਦਇਆਲ ਗੋਵਿੰਦੁ"
    },
    {
      "section_id": "section-00015",
      "start_time": 119.28,
      "end_time": 126.318,
      "transcript": "ਸਾਧਾ ਮਹਿ, ਇਹ ਹਮਰੀ ਜਿੰਦੁ"
    },
    {
      "section_id": "section-00016",
      "start_time": 133.2,
      "end_time": 140.24,
      "transcript": "ਕਿਰਪਾ ਨਿਧਿ ਕਿਰਪਾਲ ਧਿਆਵਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 140.24,
      "end_time": 147.32,
      "transcript": "ਸਾਧਸੰਗਿ, ਤਾ ਬੈਠਣੁ ਪਾਵਉ"
    },
    {
      "section_id": "section-00018",
      "start_time": 147.32,
      "end_time": 154.36,
      "transcript": "ਮੋਹਿ ਨਿਰਗੁਣ ਕਉ, ਪ੍ਰਭਿ ਕੀਨੀ ਦਇਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 154.36,
      "end_time": 161.31,
      "transcript": "ਸਾਧਸੰਗਿ, ਨਾਨਕ ਨਾਮੁ ਲਇਆ"
    }
  ]
}

      "section_id": "section-00001",
      "start_time": 0.085,
      "end_time": 6.157,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.24,
      "end_time": 18.25,
      "transcript": "ਸਤਿਗੁਰੁ ਪੂਰਾ, ਭਇਆ ਕ੍ਰਿਪਾਲੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.25,
      "end_time": 24.265,
      "transcript": "ਹਿਰਦੈ ਵਸਿਆ, ਸਦਾ ਗੁਪਾਲੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 24.265,
      "end_time": 30.395,
      "transcript": "ਰਾਮੁ ਰਵਤ, ਸਦ ਹੀ ਸੁਖੁ ਪਾਇਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 30.395,
      "end_time": 39.611,
      "transcript": "ਮਇਆ ਕਰੀ, ਪੂਰਨ ਹਰਿ ਰਾਇਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.96,
      "end_time": 52.08,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਜਾ ਕੇ ਪੂਰੇ ਭਾਗ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.08,
      "end_time": 57.645,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਅਸਥਿਰੁ ਸੋਹਾਗੁ"
    }
  ]

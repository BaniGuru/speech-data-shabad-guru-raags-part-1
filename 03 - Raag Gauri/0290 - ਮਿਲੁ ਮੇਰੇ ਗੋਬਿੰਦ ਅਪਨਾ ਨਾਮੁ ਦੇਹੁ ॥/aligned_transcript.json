{
  "audio_file": "0182 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.155,
      "end_time": 6.863,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.28,
      "end_time": 20.885,
      "transcript": "ਮਿਲੁ ਮੇਰੇ ਗੋਬਿੰਦ, ਅਪਨਾ ਨਾਮੁ ਦੇਹੁ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.885,
      "end_time": 28.61,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਧ੍ਰਿਗੁ ਧ੍ਰਿਗੁ ਅਸਨੇਹੁ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 39.04,
      "end_time": 46.04,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਜੋ ਪਹਿਰੈ ਖਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.04,
      "end_time": 52.835,
      "transcript": "ਜਿਉ ਕੂਕਰੁ, ਜੂਠਨ ਮਹਿ ਪਾਇ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.015,
      "end_time": 60.12,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਜੇਤਾ ਬਿਉਹਾਰੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.12,
      "end_time": 67.2,
      "transcript": "ਜਿਉ ਮਿਰਤਕ, ਮਿਥਿਆ ਸੀਗਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.2,
      "end_time": 73.695,
      "transcript": "ਨਾਮੁ ਬਿਸਾਰਿ, ਕਰੇ ਰਸ ਭੋਗ"
    },
    {
      "section_id": "section-00009",
      "start_time": 74.175,
      "end_time": 80.745,
      "transcript": "ਸੁਖੁ ਸੁਪਨੈ ਨਹੀ, ਤਨ ਮਹਿ ਰੋਗ"
    },
    {
      "section_id": "section-00010",
      "start_time": 81.145,
      "end_time": 88.025,
      "transcript": "ਨਾਮੁ ਤਿਆਗਿ, ਕਰੇ ਅਨ ਕਾਜ"
    },
    {
      "section_id": "section-00011",
      "start_time": 88.025,
      "end_time": 95.135,
      "transcript": "ਬਿਨਸਿ ਜਾਇ, ਝੂਠੇ ਸਭਿ ਪਾਜ"
    },
    {
      "section_id": "section-00012",
      "start_time": 95.135,
      "end_time": 102.3,
      "transcript": "ਨਾਮ ਸੰਗਿ ਮਨਿ, ਪ੍ਰੀਤਿ ਨ ਲਾਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 102.3,
      "end_time": 109.33,
      "transcript": "ਕੋਟਿ ਕਰਮ ਕਰਤੋ, ਨਰਕਿ ਜਾਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 109.33,
      "end_time": 116.235,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਜਿਨਿ ਮਨਿ ਨ ਆਰਾਧਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 116.235,
      "end_time": 123.4,
      "transcript": "ਚੋਰ ਕੀ ਨਿਆਈ, ਜਮ ਪੁਰਿ ਬਾਧਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 123.4,
      "end_time": 130.44,
      "transcript": "ਲਾਖ ਅਡੰਬਰ, ਬਹੁਤੁ ਬਿਸਥਾਰਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 130.44,
      "end_time": 137.405,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਝੂਠੇ ਪਾਸਾਰਾ"
    },
    {
      "section_id": "section-00018",
      "start_time": 137.405,
      "end_time": 144.085,
      "transcript": "ਹਰਿ ਕਾ ਨਾਮੁ, ਸੋਈ ਜਨੁ ਲੇਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 144.48,
      "end_time": 150.28,
      "transcript": "ਕਰਿ ਕਿਰਪਾ, ਨਾਨਕ ਜਿਸੁ ਦੇਇ"
    }
  ]
}

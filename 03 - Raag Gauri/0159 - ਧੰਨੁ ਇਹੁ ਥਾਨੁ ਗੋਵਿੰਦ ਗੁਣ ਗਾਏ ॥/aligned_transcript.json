{
  "audio_file": "0149 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.125,
      "end_time": 7.194,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.899,
      "end_time": 19.485,
      "transcript": "ਧੰਨੁ ਇਹੁ ਥਾਨੁ, ਗੋਵਿੰਦ ਗੁਣ ਗਾਏ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.76,
      "end_time": 29.635,
      "transcript": "ਕੁਸਲ ਖੇਮ, ਪ੍ਰਭਿ ਆਪਿ ਬਸਾਏ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 36.04,
      "end_time": 42.442,
      "transcript": "ਬਿਪਤਿ ਤਹਾ, ਜਹਾ ਹਰਿ ਸਿਮਰਨੁ ਨਾਹੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.442,
      "end_time": 48.805,
      "transcript": "ਕੋਟਿ ਅਨੰਦ, ਜਹ ਹਰਿ ਗੁਨ ਗਾਹੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 49.12,
      "end_time": 55.385,
      "transcript": "ਹਰਿ ਬਿਸਰਿਐ, ਦੁਖ ਰੋਗ ਘਨੇਰੇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.64,
      "end_time": 62.105,
      "transcript": "ਪ੍ਰਭ ਸੇਵਾ, ਜਮੁ ਲਗੈ ਨ ਨੇਰੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.84,
      "end_time": 75.36,
      "transcript": "ਸੋ ਵਡਭਾਗੀ, ਨਿਹਚਲ ਥਾਨੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.36,
      "end_time": 81.76,
      "transcript": "ਜਹ ਜਪੀਐ, ਪ੍ਰਭ ਕੇਵਲ ਨਾਮੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 81.76,
      "end_time": 87.885,
      "transcript": "ਜਹ ਜਾਈਐ, ਤਹ ਨਾਲਿ ਮੇਰਾ ਸੁਆਮੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 88.175,
      "end_time": 94.155,
      "transcript": "ਨਾਨਕ ਕਉ ਮਿਲਿਆ, ਅੰਤਰਜਾਮੀ"
    }
  ]
}

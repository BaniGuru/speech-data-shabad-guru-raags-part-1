{
  "audio_file": "0238 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 7.89,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.84,
      "end_time": 22.08,
      "transcript": "ਮਾਧਉ, ਜਲ ਕੀ ਪਿਆਸ ਨ ਜਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.08,
      "end_time": 29.527,
      "transcript": "ਜਲ ਮਹਿ, ਅਗਨਿ ਉਠੀ ਅਧਿਕਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 36.64,
      "end_time": 44.04,
      "transcript": "ਤੂੰ ਜਲਨਿਧਿ, ਹਉ ਜਲ ਕਾ ਮੀਨੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 44.04,
      "end_time": 51.32,
      "transcript": "ਜਲ ਮਹਿ ਰਹਉ, ਜਲਹਿ ਬਿਨੁ ਖੀਨੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 51.32,
      "end_time": 58.225,
      "transcript": "ਤੂੰ ਪਿੰਜਰੁ, ਹਉ ਸੂਅਟਾ ਤੋਰ"
    },
    {
      "section_id": "section-00007",
      "start_time": 58.64,
      "end_time": 65.96,
      "transcript": "ਜਮੁ ਮੰਜਾਰੁ, ਕਹਾ ਕਰੈ ਮੋਰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 65.96,
      "end_time": 73.135,
      "transcript": "ਤੂੰ ਤਰਵਰੁ, ਹਉ ਪੰਖੀ ਆਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 73.135,
      "end_time": 80.095,
      "transcript": "ਮੰਦਭਾਗੀ, ਤੇਰੋ ਦਰਸਨੁ ਨਾਹਿ"
    },
    {
      "section_id": "section-00010",
      "start_time": 80.72,
      "end_time": 87.575,
      "transcript": "ਤੂੰ ਸਤਿਗੁਰੁ, ਹਉ ਨਉਤਨੁ ਚੇਲਾ"
    },
    {
      "section_id": "section-00011",
      "start_time": 88.0,
      "end_time": 95.085,
      "transcript": "ਕਹਿ ਕਬੀਰ ਮਿਲੁ, ਅੰਤ ਕੀ ਬੇਲਾ"
    }
  ]
}

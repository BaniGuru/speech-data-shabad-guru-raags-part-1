{
  "audio_file": "0124 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.4,
      "end_time": 7.283,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.8,
      "end_time": 21.82,
      "transcript": "ਭੀਖਕ ਪ੍ਰੀਤਿ, ਭੀਖ ਪ੍ਰਭ ਪਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 22.04,
      "end_time": 28.952,
      "transcript": "ਭੂਖੇ ਪ੍ਰੀਤਿ ਹੋਵੈ ਅੰਨੁ ਖਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.952,
      "end_time": 35.81,
      "transcript": "ਗੁਰਸਿਖ ਪ੍ਰੀਤਿ, ਗੁਰ ਮਿਲਿ ਆਘਾਇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 36.28,
      "end_time": 43.44,
      "transcript": "ਹਰਿ ਦਰਸਨੁ ਦੇਹੁ, ਹਰਿ ਆਸ ਤੁਮਾਰੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.44,
      "end_time": 54.24,
      "transcript": "ਕਰਿ ਕਿਰਪਾ ਲੋਚ ਪੂਰਿ ਹਮਾਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 61.36,
      "end_time": 68.56,
      "transcript": "ਚਕਵੀ ਪ੍ਰੀਤਿ, ਸੂਰਜੁ ਮੁਖਿ ਲਾਗੈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 68.56,
      "end_time": 75.8,
      "transcript": "ਮਿਲੈ ਪਿਆਰੇ, ਸਭ ਦੁਖ ਤਿਆਗੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 75.8,
      "end_time": 82.41,
      "transcript": "ਗੁਰਸਿਖ ਪ੍ਰੀਤਿ, ਗੁਰੂ ਮੁਖਿ ਲਾਗੈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 82.88,
      "end_time": 90.12,
      "transcript": "ਬਛਰੇ ਪ੍ਰੀਤਿ, ਖੀਰੁ ਮੁਖਿ ਖਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 90.12,
      "end_time": 97.16,
      "transcript": "ਹਿਰਦੈ ਬਿਗਸੈ, ਦੇਖੈ ਮਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 97.16,
      "end_time": 103.96,
      "transcript": "ਗੁਰਸਿਖ ਪ੍ਰੀਤਿ, ਗੁਰੂ ਮੁਖਿ ਲਾਇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 104.36,
      "end_time": 111.44,
      "transcript": "ਹੋਰੁ ਸਭ ਪ੍ਰੀਤਿ, ਮਾਇਆ ਮੋਹੁ ਕਾਚਾ"
    },
    {
      "section_id": "section-00014",
      "start_time": 111.44,
      "end_time": 118.52,
      "transcript": "ਬਿਨਸਿ ਜਾਇ, ਕੂਰਾ ਕਚੁ ਪਾਚਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 118.52,
      "end_time": 125.24,
      "transcript": "ਜਨ ਨਾਨਕ ਪ੍ਰੀਤਿ, ਤ੍ਰਿਪਤਿ ਗੁਰੁ ਸਾਚਾ"
    }
  ]
}

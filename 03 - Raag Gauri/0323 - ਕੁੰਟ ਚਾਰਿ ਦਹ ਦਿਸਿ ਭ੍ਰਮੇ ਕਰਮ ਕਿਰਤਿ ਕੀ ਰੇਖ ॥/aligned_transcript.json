  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.465,
      "end_time": 5.805,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.56,
      "end_time": 14.132,
      "transcript": "ਕੁੰਟ ਚਾਰਿ ਦਹ ਦਿਸਿ ਭ੍ਰਮੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.132,
      "end_time": 21.648,
      "transcript": "ਕਰਮ ਕਿਰਤਿ ਕੀ ਰੇਖ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.648,
      "end_time": 29.036,
      "transcript": "ਸੂਖ ਦੂਖ ਮੁਕਤਿ ਜੋਨਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.036,
      "end_time": 37.742,
      "transcript": "ਨਾਨਕ ਲਿਖਿਓ ਲੇਖ ਪਵੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.12,
      "end_time": 47.198,
      "transcript": "ਕਕਾ, ਕਾਰਨ ਕਰਤਾ ਸੋਊ"
    },
    {
      "section_id": "section-00007",
      "start_time": 47.198,
      "end_time": 51.434,
      "transcript": "ਲਿਖਿਓ ਲੇਖੁ, ਨ ਮੇਟਤ ਕੋਊ"
    },
    {
      "section_id": "section-00008",
      "start_time": 51.434,
      "end_time": 55.72,
      "transcript": "ਨਹੀ ਹੋਤ, ਕਛੁ ਦੋਊ ਬਾਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 55.72,
      "end_time": 59.935,
      "transcript": "ਕਰਨੈਹਾਰੁ, ਨ ਭੂਲਨਹਾਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 59.935,
      "end_time": 64.16,
      "transcript": "ਕਾਹੂ, ਪੰਥੁ ਦਿਖਾਰੈ ਆਪੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 64.16,
      "end_time": 68.195,
      "transcript": "ਕਾਹੂ, ਉਦਿਆਨ ਭ੍ਰਮਤ ਪਛੁਤਾਪੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 68.195,
      "end_time": 72.52,
      "transcript": "ਆਪਨ ਖੇਲੁ, ਆਪ ਹੀ ਕੀਨੋ"
    },
    {
      "section_id": "section-00013",
      "start_time": 72.52,
      "end_time": 77.829,
      "transcript": "ਜੋ ਜੋ ਦੀਨੋ, ਸੁ ਨਾਨਕ ਲੀਨੋ"
    }
  ]
}

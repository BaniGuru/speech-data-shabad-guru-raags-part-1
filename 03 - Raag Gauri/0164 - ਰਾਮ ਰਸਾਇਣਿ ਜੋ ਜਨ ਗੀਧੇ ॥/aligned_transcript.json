{
  "audio_file": "0150 A PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.005,
      "end_time": 13.134,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 23.535,
      "end_time": 30.895,
      "transcript": "ਰਾਮ ਰਸਾਇਣਿ, ਜੋ ਜਨ ਗੀਧੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 30.895,
      "end_time": 38.375,
      "transcript": "ਚਰਨ ਕਮਲ, ਪ੍ਰੇਮ ਭਗਤੀ ਬੀਧੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 48.834,
      "end_time": 56.175,
      "transcript": "ਆਨ ਰਸਾ, ਦੀਸਹਿ ਸਭਿ ਛਾਰੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 56.175,
      "end_time": 63.237,
      "transcript": "ਨਾਮ ਬਿਨਾ, ਨਿਹਫਲ ਸੰਸਾਰ"
    },
    {
      "section_id": "section-00006",
      "start_time": 63.237,
      "end_time": 70.325,
      "transcript": "ਅੰਧ ਕੂਪ ਤੇ, ਕਾਢੇ ਆਪਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.76,
      "end_time": 77.455,
      "transcript": "ਗੁਣ ਗੋਵਿੰਦ, ਅਚਰਜ ਪਰਤਾਪ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.72,
      "end_time": 84.555,
      "transcript": "ਵਣਿ ਤ੍ਰਿਣਿ ਤ੍ਰਿਭਵਣਿ, ਪੂਰਨ ਗੋਪਾਲ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.88,
      "end_time": 91.605,
      "transcript": "ਬ੍ਰਹਮ ਪਸਾਰੁ, ਜੀਅ ਸੰਗਿ ਦਇਆਲ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.175,
      "end_time": 98.935,
      "transcript": "ਕਹੁ ਨਾਨਕ, ਸਾ ਕਥਨੀ ਸਾਰੁ"
    },
    {
      "section_id": "section-00011",
      "start_time": 99.32,
      "end_time": 105.875,
      "transcript": "ਮਾਨਿ ਲੇਤੁ, ਜਿਸੁ ਸਿਰਜਨਹਾਰੁ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.335,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.64,
      "end_time": 18.88,
      "transcript": "ਕੋਟਿ ਮਜਨ, ਕੀਨੋ ਇਸਨਾਨ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.88,
      "end_time": 25.24,
      "transcript": "ਲਾਖ ਅਰਬ ਖਰਬ, ਦੀਨੋ ਦਾਨੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.24,
      "end_time": 31.285,
      "transcript": "ਜਾ ਮਨਿ ਵਸਿਓ, ਹਰਿ ਕੋ ਨਾਮੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.285,
      "end_time": 36.815,
      "transcript": "ਸਗਲ ਪਵਿਤ, ਗੁਨ ਗਾਇ ਗੁਪਾਲ"
    },
    {
      "section_id": "section-00006",
      "start_time": 37.76,
      "end_time": 45.335,
      "transcript": "ਪਾਪ ਮਿਟਹਿ, ਸਾਧੂ ਸਰਨਿ ਦਇਆਲ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.4,
      "end_time": 59.64,
      "transcript": "ਬਹੁਤੁ ਉਰਧ ਤਪ, ਸਾਧਨ ਸਾਧੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 59.64,
      "end_time": 65.96,
      "transcript": "ਅਨਿਕ ਲਾਭ, ਮਨੋਰਥ ਲਾਧੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.96,
      "end_time": 72.275,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮ, ਰਸਨ ਆਰਾਧੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 78.445,
      "end_time": 84.68,
      "transcript": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ, ਬੇਦ ਬਖਾਨੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 84.68,
      "end_time": 91.12,
      "transcript": "ਜੋਗ ਗਿਆਨ ਸਿਧ, ਸੁਖ ਜਾਨੇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 91.12,
      "end_time": 97.425,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਪ੍ਰਭ ਸਿਉ ਮਨ ਮਾਨੇ"
    },
    {
      "section_id": "section-00013",
      "start_time": 103.208,
      "end_time": 109.812,
      "transcript": "ਅਗਾਧਿ ਬੋਧਿ, ਹਰਿ ਅਗਮ ਅਪਾਰੇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 109.812,
      "end_time": 115.908,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਨਾਮੁ ਰਿਦੇ ਬੀਚਾਰੇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 115.908,
      "end_time": 122.465,
      "transcript": "ਨਾਨਕ ਕਉ, ਪ੍ਰਭ ਕਿਰਪਾ ਧਾਰੇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 122.465,
      "end_time": 128.587,
      "transcript": "ਨਾਮੁ ਜਪਤ, ਨਾਮੁ ਰਿਦੇ ਬੀਚਾਰੇ"
    },

      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 5.52,
      "end_time": 13.296,
      "transcript": "ਅੰਤਰਿ ਹਰਿ ਗੁਰੂ ਧਿਆਇਦਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 13.296,
      "end_time": 20.424,
      "transcript": "ਵਡੀ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 20.88,
      "end_time": 28.005,
      "transcript": "ਤੁਸਿ ਦਿਤੀ ਪੂਰੈ ਸਤਿਗੁਰੂ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.4,
      "end_time": 35.415,
      "transcript": "ਘਟੈ ਨਾਹੀ ਇਕੁ ਤਿਲੁ ਕਿਸੈ ਦੀ ਘਟਾਈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 35.84,
      "end_time": 42.895,
      "transcript": "ਸਚੁ ਸਾਹਿਬੁ ਸਤਿਗੁਰੂ ਕੈ ਵਲਿ ਹੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 43.28,
      "end_time": 50.531,
      "transcript": "ਤਾਂ ਝਖਿ ਝਖਿ ਮਰੈ ਸਭ ਲੁੋਕਾਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 50.531,
      "end_time": 57.495,
      "transcript": "ਨਿੰਦਕਾ ਕੇ ਮੁਹ ਕਾਲੇ ਕਰੇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 57.96,
      "end_time": 64.745,
      "transcript": "ਹਰਿ ਕਰਤੈ ਆਪਿ ਵਧਾਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 65.2,
      "end_time": 72.48,
      "transcript": "ਜਿਉ ਜਿਉ ਨਿੰਦਕ ਨਿੰਦ ਕਰਹਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 72.48,
      "end_time": 79.63,
      "transcript": "ਤਿਉ ਤਿਉ ਨਿਤ ਨਿਤ ਚੜੈ ਸਵਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 79.63,
      "end_time": 86.525,
      "transcript": "ਜਨ ਨਾਨਕ ਹਰਿ ਆਰਾਧਿਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 86.96,
      "end_time": 93.585,
      "transcript": "ਤਿਨਿ ਪੈਰੀ ਆਣਿ ਸਭ ਪਾਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 94.08,
      "end_time": 97.824,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 97.824,
      "end_time": 104.645,
      "transcript": "ਸਤਿਗੁਰ ਸੇਤੀ ਗਣਤ ਜਿ ਰਖੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 105.16,
      "end_time": 111.815,
      "transcript": "ਹਲਤੁ ਪਲਤੁ ਸਭੁ ਤਿਸ ਕਾ ਗਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 112.36,
      "end_time": 119.085,
      "transcript": "ਨਿਤ ਝਹੀਆ ਪਾਏ ਝਗੂ ਸੁਟੇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 119.56,
      "end_time": 126.245,
      "transcript": "ਝਖਦਾ ਝਖਦਾ ਝੜਿ ਪਇਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 126.92,
      "end_time": 134.16,
      "transcript": "ਨਿਤ ਉਪਾਵ ਕਰੈ ਮਾਇਆ ਧਨ ਕਾਰਣਿ"
    },
    {
      "section_id": "section-00020",
      "start_time": 134.16,
      "end_time": 141.255,
      "transcript": "ਅਗਲਾ ਧਨੁ ਭੀ ਉਡਿ ਗਇਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 141.44,
      "end_time": 148.62,
      "transcript": "ਕਿਆ ਓਹੁ ਖਟੇ ਕਿਆ ਓਹੁ ਖਾਵੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 148.62,
      "end_time": 155.595,
      "transcript": "ਜਿਸੁ ਅੰਦਰਿ ਸਹਸਾ ਦੁਖੁ ਪਇਆ"
    },
    {
      "section_id": "section-00023",
      "start_time": 155.88,
      "end_time": 163.24,
      "transcript": "ਨਿਰਵੈਰੈ ਨਾਲਿ ਜਿ ਵੈਰੁ ਰਚਾਏ"
    },
    {
      "section_id": "section-00024",
      "start_time": 163.24,
      "end_time": 170.075,
      "transcript": "ਸਭੁ ਪਾਪੁ ਜਗਤੈ ਕਾ ਤਿਨਿ ਸਿਰਿ ਲਇਆ"
    },
    {
      "section_id": "section-00025",
      "start_time": 170.52,
      "end_time": 177.785,
      "transcript": "ਓਸੁ ਅਗੈ ਪਿਛੈ ਢੋਈ ਨਾਹੀ"
    },
    {
      "section_id": "section-00026",
      "start_time": 177.785,
      "end_time": 184.825,
      "transcript": "ਜਿਸੁ ਅੰਦਰਿ ਨਿੰਦਾ ਮੁਹਿ ਅੰਬੁ ਪਇਆ"
    },
    {
      "section_id": "section-00027",
      "start_time": 185.28,
      "end_time": 192.57,
      "transcript": "ਜੇ ਸੁਇਨੇ ਨੋ ਓਹੁ ਹਥੁ ਪਾਏ"
    },
    {
      "section_id": "section-00028",
      "start_time": 192.57,
      "end_time": 199.425,
      "transcript": "ਤਾ ਖੇਹੂ ਸੇਤੀ ਰਲਿ ਗਇਆ"
    },
    {
      "section_id": "section-00029",
      "start_time": 199.88,
      "end_time": 207.185,
      "transcript": "ਜੇ ਗੁਰ ਕੀ ਸਰਣੀ ਫਿਰਿ ਓਹੁ ਆਵੈ"
    },
    {
      "section_id": "section-00030",
      "start_time": 207.185,
      "end_time": 213.855,
      "transcript": "ਤਾ ਪਿਛਲੇ ਅਉਗਣ ਬਖਸਿ ਲਇਆ"
    },
    {
      "section_id": "section-00031",
      "start_time": 214.44,
      "end_time": 221.62,
      "transcript": "ਜਨ ਨਾਨਕ ਅਨਦਿਨੁ ਨਾਮੁ ਧਿਆਇਆ"
    },
    {
      "section_id": "section-00032",
      "start_time": 221.62,
      "end_time": 228.275,
      "transcript": "ਹਰਿ ਸਿਮਰਤ ਕਿਲਵਿਖ ਪਾਪ ਗਇਆ"
    },
    {
      "section_id": "section-00033",
      "start_time": 228.96,
      "end_time": 232.425,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00034",
      "start_time": 236.279,
      "end_time": 244.52,
      "transcript": "ਤੂਹੈ ਸਚਾ ਸਚੁ ਤੂ, ਸਭ ਦੂ ਉਪਰਿ ਤੂ ਦੀਬਾਣੁ"
    },
    {
      "section_id": "section-00035",
      "start_time": 244.52,
      "end_time": 252.56,
      "transcript": "ਜੋ ਤੁਧੁ ਸਚੁ ਧਿਆਇਦੇ, ਸਚੁ ਸੇਵਨਿ ਸਚੇ ਤੇਰਾ ਮਾਣੁ"
    },
    {
      "section_id": "section-00036",
      "start_time": 252.56,
      "end_time": 260.625,
      "transcript": "ਓਨਾ ਅੰਦਰਿ ਸਚੁ ਮੁਖ ਉਜਲੇ, ਸਚੁ ਬੋਲਨਿ ਸਚੇ ਤੇਰਾ ਤਾਣੁ"
    },
    {
      "section_id": "section-00037",
      "start_time": 260.625,
      "end_time": 268.44,
      "transcript": "ਸੇ ਭਗਤ ਜਿਨੀ ਗੁਰਮੁਖਿ ਸਾਲਾਹਿਆ, ਸਚੁ ਸਬਦੁ ਨੀਸਾਣੁ"
    },
    {
      "section_id": "section-00038",
      "start_time": 268.44,
      "end_time": 277.075,
      "transcript": "ਸਚੁ ਜਿ ਸਚੇ ਸੇਵਦੇ, ਤਿਨ ਵਾਰੀ ਸਦ ਕੁਰਬਾਣੁ"
    }
  ]

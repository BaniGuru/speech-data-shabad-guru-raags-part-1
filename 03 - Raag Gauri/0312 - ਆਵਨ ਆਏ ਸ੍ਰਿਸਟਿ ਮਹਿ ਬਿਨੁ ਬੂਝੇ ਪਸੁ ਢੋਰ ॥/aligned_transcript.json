  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.635,
      "end_time": 9.295,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 9.885,
      "end_time": 15.535,
      "transcript": "ਆਵਨ ਆਏ ਸ੍ਰਿਸਟਿ ਮਹਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 15.845,
      "end_time": 21.285,
      "transcript": "ਬਿਨੁ ਬੂਝੇ ਪਸੁ ਢੋਰ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.835,
      "end_time": 27.375,
      "transcript": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਸੋ ਬੁਝੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 27.92,
      "end_time": 35.515,
      "transcript": "ਜਾ ਕੈ ਭਾਗ ਮਥੋਰ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.16,
      "end_time": 52.97,
      "transcript": "ਯਾ ਜੁਗ ਮਹਿ, ਏਕਹਿ ਕਉ ਆਇਆ ਜਨਮਤ ਮੋਹਿਓ, ਮੋਹਨੀ ਮਾਇਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 52.97,
      "end_time": 60.615,
      "transcript": "ਗਰਭ ਕੁੰਟ ਮਹਿ, ਉਰਧ ਤਪ ਕਰਤੇ ਸਾਸਿ ਸਾਸਿ, ਸਿਮਰਤ ਪ੍ਰਭੁ ਰਹਤੇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.615,
      "end_time": 68.78,
      "transcript": "ਉਰਝਿ ਪਰੇ, ਜੋ ਛੋਡਿ ਛਡਾਨਾ ਦੇਵਨਹਾਰੁ, ਮਨਹਿ ਬਿਸਰਾਨਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.78,
      "end_time": 77.005,
      "transcript": "ਧਾਰਹੁ ਕਿਰਪਾ, ਜਿਸਹਿ ਗੁਸਾਈ ਇਤ ਉਤ ਨਾਨਕ, ਤਿਸੁ ਬਿਸਰਹੁ ਨਾਹੀ"
    }
  ]
}

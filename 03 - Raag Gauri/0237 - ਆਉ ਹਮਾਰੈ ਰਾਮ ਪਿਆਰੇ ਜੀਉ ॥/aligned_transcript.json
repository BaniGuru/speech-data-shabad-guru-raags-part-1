{
  "audio_file": "0164 B PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.125,
      "end_time": 7.355,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ ਮਾਝ"
    },
    {
      "section_id": "section-00002",
      "start_time": 18.055,
      "end_time": 25.095,
      "transcript": "ਆਉ ਹਮਾਰੈ, ਰਾਮ ਪਿਆਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00003",
      "start_time": 25.095,
      "end_time": 35.92,
      "transcript": "ਰੈਣਿ ਦਿਨਸੁ, ਸਾਸਿ ਸਾਸਿ ਚਿਤਾਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.92,
      "end_time": 42.96,
      "transcript": "ਸੰਤ ਦੇਉ ਸੰਦੇਸਾ, ਪੈ ਚਰਣਾਰੇ ਜੀਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.96,
      "end_time": 53.175,
      "transcript": "ਤੁਧੁ ਬਿਨੁ, ਕਿਤੁ ਬਿਧਿ ਤਰੀਐ ਜੀਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.695,
      "end_time": 60.92,
      "transcript": "ਸੰਗਿ ਤੁਮਾਰੈ, ਮੈ ਕਰੇ ਅਨੰਦਾ ਜੀਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.92,
      "end_time": 67.96,
      "transcript": "ਵਣਿ ਤਿਣਿ ਤ੍ਰਿਭਵਣਿ, ਸੁਖ ਪਰਮਾਨੰਦਾ ਜੀਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.96,
      "end_time": 78.6,
      "transcript": "ਸੇਜ ਸੁਹਾਵੀ, ਇਹੁ ਮਨੁ ਬਿਗਸੰਦਾ ਜੀਉ"
    },
    {
      "section_id": "section-00009",
      "start_time": 78.6,
      "end_time": 89.28,
      "transcript": "ਪੇਖਿ ਦਰਸਨੁ, ਇਹੁ ਸੁਖੁ ਲਹੀਐ ਜੀਉ"
    },
    {
      "section_id": "section-00010",
      "start_time": 89.28,
      "end_time": 96.235,
      "transcript": "ਚਰਣ ਪਖਾਰਿ, ਕਰੀ ਨਿਤ ਸੇਵਾ ਜੀਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 96.235,
      "end_time": 106.415,
      "transcript": "ਪੂਜਾ ਅਰਚਾ ਬੰਦਨ ਦੇਵਾ ਜੀਉ"
    },
    {
      "section_id": "section-00012",
      "start_time": 106.92,
      "end_time": 113.92,
      "transcript": "ਦਾਸਨਿ ਦਾਸੁ, ਨਾਮੁ ਜਪਿ ਲੇਵਾ ਜੀਉ"
    },
    {
      "section_id": "section-00013",
      "start_time": 113.92,
      "end_time": 124.39,
      "transcript": "ਬਿਨਉ, ਠਾਕੁਰ ਪਹਿ ਕਹੀਐ ਜੀਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 131.6,
      "end_time": 138.68,
      "transcript": "ਇਛ ਪੁੰਨੀ ਮੇਰੀ, ਮਨੁ ਤਨੁ ਹਰਿਆ ਜੀਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 138.68,
      "end_time": 145.8,
      "transcript": "ਦਰਸਨ ਪੇਖਤ, ਸਭ ਦੁਖ ਪਰਹਰਿਆ ਜੀਉ"
    },
    {
      "section_id": "section-00016",
      "start_time": 145.8,
      "end_time": 155.928,
      "transcript": "ਹਰਿ ਹਰਿ ਨਾਮੁ, ਜਪੇ ਜਪਿ ਤਰਿਆ ਜੀਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 155.928,
      "end_time": 165.918,
      "transcript": "ਇਹੁ ਅਜਰੁ ਨਾਨਕ ਸੁਖੁ ਸਹੀਐ ਜੀਉ"
    }
  ]
}

{
  "audio_file": "0240 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 3.305,
      "end_time": 14.882,
      "transcript": "ਗਉੜੀ ਕਬੀਰ ਜੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 30.68,
      "end_time": 36.895,
      "transcript": "ਉਪਜੈ ਨਿਪਜੈ, ਨਿਪਜਿ ਸਮਾਈ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.895,
      "end_time": 43.07,
      "transcript": "ਨੈਨਹ ਦੇਖਤ, ਇਹੁ ਜਗੁ ਜਾਈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 43.07,
      "end_time": 49.3,
      "transcript": "ਲਾਜ ਨ ਮਰਹੁ, ਕਹਹੁ ਘਰੁ ਮੇਰਾ"
    },
    {
      "section_id": "section-00005",
      "start_time": 49.3,
      "end_time": 58.595,
      "transcript": "ਅੰਤ ਕੀ ਬਾਰ, ਨਹੀ ਕਛੁ ਤੇਰਾ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 64.72,
      "end_time": 70.76,
      "transcript": "ਅਨਿਕ ਜਤਨ ਕਰਿ, ਕਾਇਆ ਪਾਲੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.76,
      "end_time": 76.93,
      "transcript": "ਮਰਤੀ ਬਾਰ, ਅਗਨਿ ਸੰਗਿ ਜਾਲੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 76.93,
      "end_time": 82.965,
      "transcript": "ਚੋਆ ਚੰਦਨੁ, ਮਰਦਨ ਅੰਗਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 82.965,
      "end_time": 88.995,
      "transcript": "ਸੋ ਤਨੁ ਜਲੈ, ਕਾਠ ਕੈ ਸੰਗਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 89.24,
      "end_time": 95.32,
      "transcript": "ਕਹੁ ਕਬੀਰ, ਸੁਨਹੁ ਰੇ ਗੁਨੀਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 95.32,
      "end_time": 100.997,
      "transcript": "ਬਿਨਸੈਗੋ ਰੂਪੁ, ਦੇਖੈ ਸਭ ਦੁਨੀਆ"
    }
  ]
}

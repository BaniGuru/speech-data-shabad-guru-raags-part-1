{
  "audio_file": "0190 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.335,
      "end_time": 5.795,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.8,
      "end_time": 21.431,
      "transcript": "ਕਿਰਤ ਕਮਾਵਨ ਸੁਭ ਅਸੁਭ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.431,
      "end_time": 27.665,
      "transcript": "ਕੀਨੇ ਤਿਨਿ ਪ੍ਰਭਿ ਆਪਿ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.2,
      "end_time": 34.575,
      "transcript": "ਪਸੁ ਆਪਨ ਹਉ ਹਉ ਕਰੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 34.895,
      "end_time": 45.162,
      "transcript": "ਨਾਨਕ ਬਿਨੁ ਹਰਿ ਕਹਾ ਕਮਾਤਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 55.055,
      "end_time": 59.672,
      "transcript": "ਏਕਹਿ ਆਪਿ ਕਰਾਵਨਹਾਰਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.672,
      "end_time": 63.732,
      "transcript": "ਆਪਹਿ, ਪਾਪ ਪੁੰਨ ਬਿਸਥਾਰਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 63.732,
      "end_time": 68.255,
      "transcript": "ਇਆ ਜੁਗ, ਜਿਤੁ ਜਿਤੁ ਆਪਹਿ ਲਾਇਓ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.255,
      "end_time": 72.61,
      "transcript": "ਸੋ ਸੋ ਪਾਇਓ, ਜੁ ਆਪਿ ਦਿਵਾਇਓ"
    },
    {
      "section_id": "section-00010",
      "start_time": 72.61,
      "end_time": 76.657,
      "transcript": "ਉਆ ਕਾ ਅੰਤੁ, ਨ ਜਾਨੈ ਕੋਊ"
    },
    {
      "section_id": "section-00011",
      "start_time": 76.657,
      "end_time": 80.94,
      "transcript": "ਜੋ ਜੋ ਕਰੈ, ਸੋਊ ਫੁਨਿ ਹੋਊ"
    },
    {
      "section_id": "section-00012",
      "start_time": 80.94,
      "end_time": 85.312,
      "transcript": "ਏਕਹਿ ਤੇ, ਸਗਲਾ ਬਿਸਥਾਰਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 85.312,
      "end_time": 90.175,
      "transcript": "ਨਾਨਕ, ਆਪਿ ਸਵਾਰਨਹਾਰਾ"
    }
  ]
}

{
  "audio_file": "0157 B PB.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 6.997,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.015,
      "end_time": 18.92,
      "transcript": "ਜੋਗ ਜੁਗਤਿ, ਸੁਨਿ ਆਇਓ ਗੁਰ ਤੇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.92,
      "end_time": 27.445,
      "transcript": "ਮੋ ਕਉ, ਸਤਿਗੁਰ ਸਬਦਿ ਬੁਝਾਇਓ ਰਹਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.705,
      "end_time": 42.065,
      "transcript": "ਨਉ ਖੰਡ ਪ੍ਰਿਥਮੀ ਇਸੁ ਤਨ ਮਹਿ ਰਵਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 42.065,
      "end_time": 48.565,
      "transcript": "ਨਿਮਖ ਨਿਮਖ ਨਮਸਕਾਰਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 48.565,
      "end_time": 55.16,
      "transcript": "ਦੀਖਿਆ ਗੁਰ ਕੀ ਮੁੰਦ੍ਰਾ ਕਾਨੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 55.16,
      "end_time": 61.76,
      "transcript": "ਦ੍ਰਿੜਿਓ ਏਕੁ ਨਿਰੰਕਾਰਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.76,
      "end_time": 68.32,
      "transcript": "ਪੰਚ ਚੇਲੇ ਮਿਲਿ ਭਏ ਇਕਤ੍ਰਾ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.32,
      "end_time": 74.265,
      "transcript": "ਏਕਸੁ ਕੈ ਵਸਿ ਕੀਏ"
    },
    {
      "section_id": "section-00010",
      "start_time": 74.665,
      "end_time": 81.28,
      "transcript": "ਦਸ ਬੈਰਾਗਨਿ ਆਗਿਆਕਾਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 81.28,
      "end_time": 87.375,
      "transcript": "ਤਬ ਨਿਰਮਲ ਜੋਗੀ ਥੀਏ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.88,
      "end_time": 93.695,
      "transcript": "ਭਰਮੁ ਜਰਾਇ ਚਰਾਈ ਬਿਭੂਤਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 94.28,
      "end_time": 100.125,
      "transcript": "ਪੰਥੁ ਏਕੁ ਕਰਿ ਪੇਖਿਆ"
    },
    {
      "section_id": "section-00014",
      "start_time": 100.84,
      "end_time": 107.32,
      "transcript": "ਸਹਜ ਸੂਖ ਸੋ ਕੀਨੀ ਭੁਗਤਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 107.32,
      "end_time": 113.345,
      "transcript": "ਜੋ ਠਾਕੁਰਿ ਮਸਤਕਿ ਲੇਖਿਆ"
    },
    {
      "section_id": "section-00016",
      "start_time": 113.8,
      "end_time": 120.235,
      "transcript": "ਜਹ ਭਉ ਨਾਹੀ ਤਹਾ ਆਸਨੁ ਬਾਧਿਓ"
    },
    {
      "section_id": "section-00017",
      "start_time": 120.235,
      "end_time": 126.325,
      "transcript": "ਸਿੰਗੀ ਅਨਹਤ ਬਾਨੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 126.8,
      "end_time": 133.24,
      "transcript": "ਤਤੁ ਬੀਚਾਰੁ ਡੰਡਾ ਕਰਿ ਰਾਖਿਓ"
    },
    {
      "section_id": "section-00019",
      "start_time": 133.24,
      "end_time": 139.315,
      "transcript": "ਜੁਗਤਿ ਨਾਮੁ ਮਨਿ ਭਾਨੀ"
    },
    {
      "section_id": "section-00020",
      "start_time": 139.84,
      "end_time": 146.235,
      "transcript": "ਐਸਾ ਜੋਗੀ ਵਡਭਾਗੀ ਭੇਟੈ"
    },
    {
      "section_id": "section-00021",
      "start_time": 146.235,
      "end_time": 152.235,
      "transcript": "ਮਾਇਆ ਕੇ ਬੰਧਨ ਕਾਟੈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 152.645,
      "end_time": 158.545,
      "transcript": "ਸੇਵਾ ਪੂਜ ਕਰਉ ਤਿਸੁ ਮੂਰਤਿ ਕੀ"
    },
    {
      "section_id": "section-00023",
      "start_time": 158.955,
      "end_time": 164.785,
      "transcript": "ਨਾਨਕੁ ਤਿਸੁ ਪਗ ਚਾਟੈ"
    }
  ]
}

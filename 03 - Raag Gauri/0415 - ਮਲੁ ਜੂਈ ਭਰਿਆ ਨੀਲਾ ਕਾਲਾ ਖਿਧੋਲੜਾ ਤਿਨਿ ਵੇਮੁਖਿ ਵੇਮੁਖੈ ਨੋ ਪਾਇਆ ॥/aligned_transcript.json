{
  "audio_file": "0227 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.36,
      "end_time": 4.605,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.04,
      "end_time": 20.745,
      "transcript": "ਮਲੁ ਜੂਈ ਭਰਿਆ ਨੀਲਾ ਕਾਲਾ ਖਿਧੋਲੜਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 20.745,
      "end_time": 28.055,
      "transcript": "ਤਿਨਿ ਵੇਮੁਖਿ ਵੇਮੁਖੈ ਨੋ ਪਾਇਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.44,
      "end_time": 35.95,
      "transcript": "ਪਾਸਿ ਨ ਦੇਈ ਕੋਈ ਬਹਣਿ ਜਗਤ ਮਹਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 35.95,
      "end_time": 43.165,
      "transcript": "ਗੂਹ ਪੜਿ ਸਗਵੀ ਮਲੁ ਲਾਇ ਮਨਮੁਖੁ ਆਇਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.165,
      "end_time": 50.83,
      "transcript": "ਪਰਾਈ ਜੋ ਨਿੰਦਾ ਚੁਗਲੀ ਨੋ ਵੇਮੁਖੁ ਕਰਿ ਕੈ ਭੇਜਿਆ"
    },
    {
      "section_id": "section-00007",
      "start_time": 50.83,
      "end_time": 58.2,
      "transcript": "ਓਥੈ ਭੀ ਮੁਹੁ ਕਾਲਾ ਦੁਹਾ ਵੇਮੁਖਾ ਦਾ ਕਰਾਇਆ"
    },
    {
      "section_id": "section-00008",
      "start_time": 58.2,
      "end_time": 65.335,
      "transcript": "ਤੜ ਸੁਣਿਆ ਸਭਤੁ ਜਗਤ ਵਿਚਿ ਭਾਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 65.575,
      "end_time": 72.705,
      "transcript": "ਵੇਮੁਖੁ ਸਣੈ ਨਫਰੈ ਪਉਲੀ ਪਉਦੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 72.84,
      "end_time": 80.075,
      "transcript": "ਫਾਵਾ ਹੋਇ ਕੈ ਉਠਿ ਘਰਿ ਆਇਆ"
    },
    {
      "section_id": "section-00011",
      "start_time": 80.075,
      "end_time": 87.275,
      "transcript": "ਅਗੈ ਸੰਗਤੀ ਕੁੜਮੀ ਵੇਮੁਖੁ ਰਲਣਾ ਨ ਮਿਲੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 87.275,
      "end_time": 94.505,
      "transcript": "ਤਾ ਵਹੁਟੀ ਭਤੀਜੀਂ ਫਿਰਿ ਆਣਿ ਘਰਿ ਪਾਇਆ"
    },
    {
      "section_id": "section-00013",
      "start_time": 94.505,
      "end_time": 101.515,
      "transcript": "ਹਲਤੁ ਪਲਤੁ ਦੋਵੈ ਗਏ"
    },
    {
      "section_id": "section-00014",
      "start_time": 101.72,
      "end_time": 108.695,
      "transcript": "ਨਿਤ ਭੁਖਾ ਕੂਕੇ ਤਿਹਾਇਆ"
    },
    {
      "section_id": "section-00015",
      "start_time": 109.04,
      "end_time": 116.32,
      "transcript": "ਧਨੁ ਧਨੁ ਸੁਆਮੀ ਕਰਤਾ ਪੁਰਖੁ ਹੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 116.32,
      "end_time": 123.5,
      "transcript": "ਜਿਨਿ ਨਿਆਉ ਸਚੁ ਬਹਿ ਆਪਿ ਕਰਾਇਆ"
    },
    {
      "section_id": "section-00017",
      "start_time": 123.5,
      "end_time": 130.78,
      "transcript": "ਜੋ ਨਿੰਦਾ ਕਰੇ ਸਤਿਗੁਰ ਪੂਰੇ ਕੀ"
    },
    {
      "section_id": "section-00018",
      "start_time": 130.78,
      "end_time": 137.829,
      "transcript": "ਸੋ ਸਾਚੈ ਮਾਰਿ ਪਚਾਇਆ"
    },
    {
      "section_id": "section-00019",
      "start_time": 152.72,
      "end_time": 159.685,
      "transcript": "ਏਹੁ ਅਖਰੁ ਤਿਨਿ ਆਖਿਆ"
    },
    {
      "section_id": "section-00020",
      "start_time": 159.975,
      "end_time": 166.785,
      "transcript": "ਜਿਨਿ ਜਗਤੁ ਸਭੁ ਉਪਾਇਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 167.115,
      "end_time": 171.12,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00022",
      "start_time": 171.12,
      "end_time": 178.24,
      "transcript": "ਸਾਹਿਬੁ ਜਿਸ ਕਾ ਨੰਗਾ ਭੁਖਾ ਹੋਵੈ"
    },
    {
      "section_id": "section-00023",
      "start_time": 178.24,
      "end_time": 185.6,
      "transcript": "ਤਿਸ ਦਾ ਨਫਰੁ ਕਿਥਹੁ ਰਜਿ ਖਾਏ"
    },
    {
      "section_id": "section-00024",
      "start_time": 185.6,
      "end_time": 192.705,
      "transcript": "ਜਿ ਸਾਹਿਬ ਕੈ ਘਰਿ ਵਥੁ ਹੋਵੈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 192.705,
      "end_time": 200.2,
      "transcript": "ਸੁ ਨਫਰੈ ਹਥਿ ਆਵੈ ਅਣਹੋਦੀ ਕਿਥਹੁ ਪਾਏ"
    },
    {
      "section_id": "section-00026",
      "start_time": 200.2,
      "end_time": 207.52,
      "transcript": "ਜਿਸ ਦੀ ਸੇਵਾ ਕੀਤੀ ਫਿਰਿ ਲੇਖਾ ਮੰਗੀਐ"
    },
    {
      "section_id": "section-00027",
      "start_time": 207.52,
      "end_time": 214.405,
      "transcript": "ਸਾ ਸੇਵਾ ਅਉਖੀ ਹੋਈ"
    },
    {
      "section_id": "section-00028",
      "start_time": 214.815,
      "end_time": 222.07,
      "transcript": "ਨਾਨਕ ਸੇਵਾ ਕਰਹੁ ਹਰਿ ਗੁਰ ਸਫਲ ਦਰਸਨ ਕੀ"
    },
    {
      "section_id": "section-00029",
      "start_time": 222.07,
      "end_time": 233.255,
      "transcript": "ਫਿਰਿ ਲੇਖਾ ਮੰਗੈ ਨ ਕੋਈ ਪਉੜੀ"
    },
    {
      "section_id": "section-00030",
      "start_time": 237.141,
      "end_time": 245.205,
      "transcript": "ਨਾਨਕ ਵੀਚਾਰਹਿ ਸੰਤ ਜਨ, ਚਾਰਿ ਵੇਦ ਕਹੰਦੇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 245.205,
      "end_time": 253.145,
      "transcript": "ਭਗਤ ਮੁਖੈ ਤੇ ਬੋਲਦੇ, ਸੇ ਵਚਨ ਹੋਵੰਦੇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 253.145,
      "end_time": 261.05,
      "transcript": "ਪ੍ਰਗਟ ਪਹਾਰਾ ਜਾਪਦਾ, ਸਭਿ ਲੋਕ ਸੁਣੰਦੇ"
    },
    {
      "section_id": "section-00033",
      "start_time": 261.05,
      "end_time": 268.755,
      "transcript": "ਸੁਖੁ ਨ ਪਾਇਨਿ ਮੁਗਧ ਨਰ, ਸੰਤ ਨਾਲਿ ਖਹੰਦੇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 269.2,
      "end_time": 276.855,
      "transcript": "ਓਇ ਲੋਚਨਿ ਓਨਾ ਗੁਣੈ ਨੋ, ਓਇ ਅਹੰਕਾਰਿ ਸੜੰਦੇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 277.0,
      "end_time": 284.865,
      "transcript": "ਓਇ ਵਿਚਾਰੇ ਕਿਆ ਕਰਹਿ, ਜਾ ਭਾਗ ਧੁਰਿ ਮੰਦੇ"
    },
    {
      "section_id": "section-00036",
      "start_time": 284.865,
      "end_time": 292.387,
      "transcript": "ਜੋ ਮਾਰੇ ਤਿਨਿ ਪਾਰਬ੍ਰਹਮਿ, ਸੇ ਕਿਸੈ ਨ ਸੰਦੇ"
    },
    {
      "section_id": "section-00037",
      "start_time": 292.387,
      "end_time": 300.075,
      "transcript": "ਵੈਰੁ ਕਰਹਿ ਨਿਰਵੈਰ ਨਾਲਿ, ਧਰਮ ਨਿਆਇ ਪਚੰਦੇ"
    },
    {
      "section_id": "section-00038",
      "start_time": 300.4,
      "end_time": 307.855,
      "transcript": "ਜੋ ਜੋ ਸੰਤਿ ਸਰਾਪਿਆ, ਸੇ ਫਿਰਹਿ ਭਵੰਦੇ"
    },
    {
      "section_id": "section-00039",
      "start_time": 308.12,
      "end_time": 316.865,
      "transcript": "ਪੇਡੁ ਮੁੰਢਾਹੂੰ ਕਟਿਆ, ਤਿਸੁ ਡਾਲ ਸੁਕੰਦੇ"
    }
  ]
}

{
  "audio_file": "0120 C Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 5.391,
      "end_time": 12.4,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.4,
      "end_time": 19.24,
      "transcript": "ਇਕਿ ਗਾਵਤ ਰਹੇ, ਮਨਿ ਸਾਦੁ ਨ ਪਾਇ"
    },
    {
      "section_id": "section-00003",
      "start_time": 19.24,
      "end_time": 25.874,
      "transcript": "ਹਉਮੈ ਵਿਚਿ ਗਾਵਹਿ, ਬਿਰਥਾ ਜਾਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.874,
      "end_time": 32.814,
      "transcript": "ਗਾਵਣਿ ਗਾਵਹਿ, ਜਿਨ ਨਾਮ ਪਿਆਰੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 32.814,
      "end_time": 40.73,
      "transcript": "ਸਾਚੀ ਬਾਣੀ ਸਬਦ ਬੀਚਾਰੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.252,
      "end_time": 53.24,
      "transcript": "ਗਾਵਤ ਰਹੈ, ਜੇ ਸਤਿਗੁਰ ਭਾਵੈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.24,
      "end_time": 62.295,
      "transcript": "ਮਨੁ ਤਨੁ ਰਾਤਾ ਨਾਮਿ ਸੁਹਾਵੈ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 67.08,
      "end_time": 73.721,
      "transcript": "ਇਕਿ ਗਾਵਹਿ, ਇਕਿ ਭਗਤਿ ਕਰੇਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 73.721,
      "end_time": 80.92,
      "transcript": "ਨਾਮੁ ਨ ਪਾਵਹਿ, ਬਿਨੁ ਅਸਨੇਹ"
    },
    {
      "section_id": "section-00010",
      "start_time": 80.92,
      "end_time": 87.64,
      "transcript": "ਸਚੀ ਭਗਤਿ, ਗੁਰਸਬਦ ਪਿਆਰਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 87.64,
      "end_time": 94.852,
      "transcript": "ਅਪਨਾ ਪਿਰੁ ਰਾਖਿਆ, ਸਦਾ ਉਰਿ ਧਾਰਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 101.12,
      "end_time": 107.88,
      "transcript": "ਭਗਤਿ ਕਰਹਿ ਮੂਰਖ, ਆਪੁ ਜਣਾਵਹਿ"
    },
    {
      "section_id": "section-00013",
      "start_time": 107.88,
      "end_time": 114.602,
      "transcript": "ਨਚਿ ਨਚਿ ਟਪਹਿ, ਬਹੁਤੁ ਦੁਖੁ ਪਾਵਹਿ"
    },
    {
      "section_id": "section-00014",
      "start_time": 114.602,
      "end_time": 121.48,
      "transcript": "ਨਚਿਐ ਟਪਿਐ, ਭਗਤਿ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 121.48,
      "end_time": 128.962,
      "transcript": "ਸਬਦਿ ਮਰੈ, ਭਗਤਿ ਪਾਏ ਜਨੁ ਸੋਇ"
    },
    {
      "section_id": "section-00016",
      "start_time": 135.04,
      "end_time": 141.8,
      "transcript": "ਭਗਤਿ ਵਛਲੁ, ਭਗਤਿ ਕਰਾਏ ਸੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 141.8,
      "end_time": 148.52,
      "transcript": "ਸਚੀ ਭਗਤਿ, ਵਿਚਹੁ ਆਪੁ ਖੋਇ"
    },
    {
      "section_id": "section-00018",
      "start_time": 148.52,
      "end_time": 155.07,
      "transcript": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਾਚਾ, ਸਭ ਬਿਧਿ ਜਾਣੈ"
    },
    {
      "section_id": "section-00019",
      "start_time": 155.07,
      "end_time": 162.357,
      "transcript": "ਨਾਨਕ ਬਖਸੇ, ਨਾਮੁ ਪਛਾਣੈ"
    }
  ]
}

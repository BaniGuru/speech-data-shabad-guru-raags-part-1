    {
      "section_id": "section-00014",
      "start_time": 159.803,
      "end_time": 167.12,
      "transcript": "ਅਬਿਨਾਸੀ ਪੁਰਖੁ ਪਾਇਆ ਪਰਮੇਸਰੁ"

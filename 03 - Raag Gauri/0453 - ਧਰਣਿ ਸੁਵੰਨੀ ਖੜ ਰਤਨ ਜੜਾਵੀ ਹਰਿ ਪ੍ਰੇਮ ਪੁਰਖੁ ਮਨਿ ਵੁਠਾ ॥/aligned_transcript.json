  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.24,
      "end_time": 10.705,
      "transcript": "ਸਲੋਕੁ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 19.0,
      "end_time": 27.395,
      "transcript": "ਧਰਣਿ ਸੁਵੰਨੀ ਖੜ ਰਤਨ ਜੜਾਵੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 27.395,
      "end_time": 35.085,
      "transcript": "ਹਰਿ ਪ੍ਰੇਮ ਪੁਰਖੁ ਮਨਿ ਵੁਠਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 35.52,
      "end_time": 43.055,
      "transcript": "ਸਭੇ ਕਾਜ ਸੁਹੇਲੜੇ ਥੀਏ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.375,
      "end_time": 50.961,
      "transcript": "ਗੁਰੁ ਨਾਨਕੁ ਸਤਿਗੁਰੁ ਤੁਠਾ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.961,
      "end_time": 55.255,
      "transcript": "ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 63.16,
      "end_time": 70.575,
      "transcript": "ਫਿਰਦੀ ਫਿਰਦੀ ਦਹ ਦਿਸਾ"
    },
    {
      "section_id": "section-00008",
      "start_time": 70.995,
      "end_time": 78.305,
      "transcript": "ਜਲ ਪਰਬਤ ਬਨਰਾਇ"
    },
    {
      "section_id": "section-00009",
      "start_time": 78.775,
      "end_time": 86.245,
      "transcript": "ਜਿਥੈ ਡਿਠਾ ਮਿਰਤਕੋ"
    },
    {
      "section_id": "section-00010",
      "start_time": 86.615,
      "end_time": 94.025,
      "transcript": "ਇਲ ਬਹਿਠੀ ਆਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.36,
      "end_time": 96.745,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00012",
      "start_time": 101.8,
      "end_time": 110.125,
      "transcript": "ਜਿਸੁ ਸਰਬ ਸੁਖਾ ਫਲ ਲੋੜੀਅਹਿ, ਸੋ ਸਚੁ ਕਮਾਵਉ"
    },
    {
      "section_id": "section-00013",
      "start_time": 110.465,
      "end_time": 118.725,
      "transcript": "ਨੇੜੈ ਦੇਖਉ ਪਾਰਬ੍ਰਹਮੁ, ਇਕੁ ਨਾਮੁ ਧਿਆਵਉ"
    },
    {
      "section_id": "section-00014",
      "start_time": 119.16,
      "end_time": 127.275,
      "transcript": "ਹੋਇ ਸਗਲ ਕੀ ਰੇਣੁਕਾ ਹਰਿ ਸੰਗਿ ਸਮਾਵਉ"
    },
    {
      "section_id": "section-00015",
      "start_time": 127.56,
      "end_time": 131.601,
      "transcript": "ਦੂਖੁ ਨ ਦੇਈ ਕਿਸੈ ਜੀਅ"
    },
    {
      "section_id": "section-00016",
      "start_time": 131.601,
      "end_time": 135.835,
      "transcript": "ਪਤਿ ਸਿਉ ਘਰਿ ਜਾਵਉ"
    },
    {
      "section_id": "section-00017",
      "start_time": 135.835,
      "end_time": 139.86,
      "transcript": "ਪਤਿਤ ਪੁਨੀਤ ਕਰਤਾ ਪੁਰਖੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 139.86,
      "end_time": 146.442,
      "transcript": "ਨਾਨਕ ਸੁਣਾਵਉ"
    }
  ]

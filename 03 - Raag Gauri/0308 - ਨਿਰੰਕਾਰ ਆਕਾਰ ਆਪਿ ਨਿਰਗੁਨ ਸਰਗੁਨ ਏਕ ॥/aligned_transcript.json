  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.8,
      "end_time": 10.555,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.0,
      "end_time": 17.03,
      "transcript": "ਨਿਰੰਕਾਰ ਆਕਾਰ ਆਪਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 17.03,
      "end_time": 22.775,
      "transcript": "ਨਿਰਗੁਨ ਸਰਗੁਨ ਏਕ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.28,
      "end_time": 28.795,
      "transcript": "ਏਕਹਿ ਏਕ ਬਖਾਨਨੋ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.135,
      "end_time": 36.615,
      "transcript": "ਨਾਨਕ ਏਕ ਅਨੇਕ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.225,
      "end_time": 54.005,
      "transcript": "ਓਅੰ ਗੁਰਮੁਖਿ, ਕੀਓ ਅਕਾਰਾ ਏਕਹਿ ਸੂਤਿ ਪਰੋਵਨਹਾਰਾ"
    },
    {
      "section_id": "section-00007",
      "start_time": 54.005,
      "end_time": 61.645,
      "transcript": "ਭਿੰਨ ਭਿੰਨ, ਤ੍ਰੈ ਗੁਣ ਬਿਸਥਾਰੰ ਨਿਰਗੁਨ ਤੇ, ਸਰਗੁਨ ਦ੍ਰਿਸਟਾਰੰ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.645,
      "end_time": 69.52,
      "transcript": "ਸਗਲ ਭਾਤਿ ਕਰਿ, ਕਰਹਿ ਉਪਾਇਓ ਜਨਮ ਮਰਨ, ਮਨ ਮੋਹੁ ਬਢਾਇਓ"
    },
    {
      "section_id": "section-00009",
      "start_time": 69.52,
      "end_time": 77.675,
      "transcript": "ਦੁਹੂ ਭਾਤਿ ਤੇ, ਆਪਿ ਨਿਰਾਰਾ ਨਾਨਕ, ਅੰਤੁ ਨ ਪਾਰਾਵਾਰਾ"
    }
  ]
}

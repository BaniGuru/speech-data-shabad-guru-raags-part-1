{
  "audio_file": "0191 F Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.285,
      "end_time": 5.725,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 6.84,
      "end_time": 14.41,
      "transcript": "ਗਨਿ ਮਿਨਿ ਦੇਖਹੁ ਮਨੈ ਮਾਹਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 14.41,
      "end_time": 21.87,
      "transcript": "ਸਰਪਰ ਚਲਨੋ ਲੋਗ"
    },
    {
      "section_id": "section-00004",
      "start_time": 21.928,
      "end_time": 29.185,
      "transcript": "ਆਸ ਅਨਿਤ ਗੁਰਮੁਖਿ ਮਿਟੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.455,
      "end_time": 38.477,
      "transcript": "ਨਾਨਕ ਨਾਮ ਅਰੋਗ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 43.015,
      "end_time": 51.295,
      "transcript": "ਗਗਾ ਗੋਬਿਦ ਗੁਣ ਰਵਹੁ, ਸਾਸਿ ਸਾਸਿ ਜਪਿ ਨੀਤ"
    },
    {
      "section_id": "section-00007",
      "start_time": 51.405,
      "end_time": 59.685,
      "transcript": "ਕਹਾ ਬਿਸਾਸਾ ਦੇਹ ਕਾ, ਬਿਲਮ ਨ ਕਰਿਹੋ ਮੀਤ"
    },
    {
      "section_id": "section-00008",
      "start_time": 60.04,
      "end_time": 68.214,
      "transcript": "ਨਹ ਬਾਰਿਕ ਨਹ ਜੋਬਨੈ, ਨਹ ਬਿਰਧੀ ਕਛੁ ਬੰਧੁ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.214,
      "end_time": 76.685,
      "transcript": "ਓਹ ਬੇਰਾ ਨਹ ਬੂਝੀਐ, ਜਉ ਆਇ ਪਰੈ ਜਮ ਫੰਧੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 76.815,
      "end_time": 84.935,
      "transcript": "ਗਿਆਨੀ ਧਿਆਨੀ ਚਤੁਰ ਪੇਖਿ, ਰਹਨੁ ਨਹੀ ਇਹ ਠਾਇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 85.16,
      "end_time": 93.45,
      "transcript": "ਛਾਡਿ ਛਾਡਿ ਸਗਲੀ ਗਈ, ਮੂੜ ਤਹਾ ਲਪਟਾਹਿ"
    },
    {
      "section_id": "section-00012",
      "start_time": 93.45,
      "end_time": 101.675,
      "transcript": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਸਿਮਰਤ ਰਹੈ, ਜਾਹੂ ਮਸਤਕਿ ਭਾਗ"
    },
    {
      "section_id": "section-00013",
      "start_time": 101.84,
      "end_time": 110.755,
      "transcript": "ਨਾਨਕ ਆਏ ਸਫਲ ਤੇ, ਜਾ ਕਉ ਪ੍ਰਿਅਹਿ ਸੁਹਾਗ"
    }
  ]
}

    {
      "section_id": "section-00006",
      "start_time": 56.64,
      "end_time": 63.305,
      "transcript": "ਬੁਝੀ ਹੇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 74.36,
      "end_time": 81.96,
      "transcript": "ਕੋਟਿ ਜੋਰੇ ਲਾਖ ਕ੍ਰੋਰੇ, ਮਨੁ ਨ ਹੋਰੇ"

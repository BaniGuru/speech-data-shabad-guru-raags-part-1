      "transcript": "ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00005",
      "start_time": 50.92,
      "end_time": 56.64,
      "transcript": "ਤ੍ਰਿਸਨਾ ਬਿਰਲੇ ਹੀ ਕੀ"

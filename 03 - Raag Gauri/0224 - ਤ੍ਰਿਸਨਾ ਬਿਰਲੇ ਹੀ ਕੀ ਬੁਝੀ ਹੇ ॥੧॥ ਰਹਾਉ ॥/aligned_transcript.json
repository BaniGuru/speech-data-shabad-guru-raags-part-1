    {
      "section_id": "section-00017",
      "start_time": 157.519,
      "end_time": 164.265,
      "transcript": "ਨਾਨਕ ਸੋ ਜਨੁ, ਦਰਿ ਹਰਿ ਸਿਝੀ ਹੇ"

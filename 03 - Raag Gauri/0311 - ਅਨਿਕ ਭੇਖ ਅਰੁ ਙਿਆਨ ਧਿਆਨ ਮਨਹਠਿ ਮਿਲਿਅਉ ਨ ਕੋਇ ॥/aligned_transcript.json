{
  "audio_file": "0189 E Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.465,
      "end_time": 10.285,
      "transcript": "ਸਲੋਕ"
    },
    {
      "section_id": "section-00002",
      "start_time": 10.76,
      "end_time": 16.345,
      "transcript": "ਅਨਿਕ ਭੇਖ ਅਰੁ ਙਿਆਨ ਧਿਆਨ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.76,
      "end_time": 22.265,
      "transcript": "ਮਨਹਠਿ ਮਿਲਿਅਉ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00004",
      "start_time": 22.76,
      "end_time": 28.475,
      "transcript": "ਕਹੁ ਨਾਨਕ ਕਿਰਪਾ ਭਈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 28.6,
      "end_time": 37.585,
      "transcript": "ਭਗਤੁ ਙਿਆਨੀ ਸੋਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00006",
      "start_time": 45.72,
      "end_time": 53.36,
      "transcript": "ਙੰਙਾ, ਙਿਆਨੁ ਨਹੀ ਮੁਖ ਬਾਤਉ ਅਨਿਕ ਜੁਗਤਿ, ਸਾਸਤ੍ਰ ਕਰਿ ਭਾਤਉ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.36,
      "end_time": 61.12,
      "transcript": "ਙਿਆਨੀ ਸੋਇ, ਜਾ ਕੈ ਦ੍ਰਿੜ ਸੋਊ ਕਹਤ ਸੁਨਤ, ਕਛੁ ਜੋਗੁ ਨ ਹੋਊ"
    },
    {
      "section_id": "section-00008",
      "start_time": 61.12,
      "end_time": 68.76,
      "transcript": "ਙਿਆਨੀ ਰਹਤ, ਆਗਿਆ ਦ੍ਰਿੜੁ ਜਾ ਕੈ ਉਸਨ ਸੀਤ ਸਮਸਰਿ ਸਭ, ਤਾ ਕੈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 68.76,
      "end_time": 76.985,
      "transcript": "ਙਿਆਨੀ ਤਤੁ, ਗੁਰਮੁਖਿ ਬੀਚਾਰੀ ਨਾਨਕ, ਜਾ ਕਉ ਕਿਰਪਾ ਧਾਰੀ"
    }
  ]
}

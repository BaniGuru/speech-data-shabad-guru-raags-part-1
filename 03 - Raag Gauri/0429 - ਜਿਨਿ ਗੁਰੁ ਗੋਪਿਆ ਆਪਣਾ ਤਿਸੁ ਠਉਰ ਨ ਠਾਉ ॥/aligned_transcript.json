{
  "audio_file": "0232 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 1.275,
      "end_time": 5.865,
      "transcript": "ਸਲੋਕੁ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 22.68,
      "end_time": 30.235,
      "transcript": "ਜਿਨਿ ਗੁਰੁ ਗੋਪਿਆ ਆਪਣਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 30.68,
      "end_time": 38.185,
      "transcript": "ਤਿਸੁ ਠਉਰ ਨ ਠਾਉ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.68,
      "end_time": 46.205,
      "transcript": "ਹਲਤੁ ਪਲਤੁ ਦੋਵੈ ਗਏ"
    },
    {
      "section_id": "section-00005",
      "start_time": 46.64,
      "end_time": 54.195,
      "transcript": "ਦਰਗਹ ਨਾਹੀ ਥਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.64,
      "end_time": 70.215,
      "transcript": "ਓਹ ਵੇਲਾ ਹਥਿ ਨ ਆਵਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 70.64,
      "end_time": 78.105,
      "transcript": "ਫਿਰਿ ਸਤਿਗੁਰ ਲਗਹਿ ਪਾਇ"
    },
    {
      "section_id": "section-00008",
      "start_time": 78.6,
      "end_time": 86.105,
      "transcript": "ਸਤਿਗੁਰ ਕੀ ਗਣਤੈ ਘੁਸੀਐ"
    },
    {
      "section_id": "section-00009",
      "start_time": 86.6,
      "end_time": 94.035,
      "transcript": "ਦੁਖੇ ਦੁਖਿ ਵਿਹਾਇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 94.52,
      "end_time": 101.865,
      "transcript": "ਸਤਿਗੁਰੁ ਪੁਰਖੁ ਨਿਰਵੈਰੁ ਹੈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 102.385,
      "end_time": 109.785,
      "transcript": "ਆਪੇ ਲਏ ਜਿਸੁ ਲਾਇ"
    },
    {
      "section_id": "section-00012",
      "start_time": 110.275,
      "end_time": 118.21,
      "transcript": "ਨਾਨਕ ਦਰਸਨੁ ਜਿਨਾ ਵੇਖਾਲਿਓਨੁ"
    },
    {
      "section_id": "section-00013",
      "start_time": 118.21,
      "end_time": 125.445,
      "transcript": "ਤਿਨਾ ਦਰਗਹ ਲਏ ਛਡਾਇ"
    },
    {
      "section_id": "section-00014",
      "start_time": 125.92,
      "end_time": 137.335,
      "transcript": "ਮਹਲਾ ਤੀਜਾ ਮਨਮੁਖੁ ਅਗਿਆਨੁ, ਦੁਰਮਤਿ ਅਹੰਕਾਰੀ"
    },
    {
      "section_id": "section-00015",
      "start_time": 137.84,
      "end_time": 145.145,
      "transcript": "ਅੰਤਰਿ ਕ੍ਰੋਧੁ, ਜੂਐ ਮਤਿ ਹਾਰੀ"
    },
    {
      "section_id": "section-00016",
      "start_time": 145.68,
      "end_time": 153.46,
      "transcript": "ਕੂੜੁ ਕੁਸਤੁ, ਓਹੁ ਪਾਪ ਕਮਾਵੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 153.46,
      "end_time": 161.315,
      "transcript": "ਕਿਆ ਓਹੁ ਸੁਣੈ, ਕਿਆ ਆਖਿ ਸੁਣਾਵੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 169.24,
      "end_time": 176.625,
      "transcript": "ਅੰਨਾ ਬੋਲਾ ਖੁਇ, ਉਝੜਿ ਪਾਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 177.04,
      "end_time": 184.425,
      "transcript": "ਮਨਮੁਖੁ ਅੰਧਾ, ਆਵੈ ਜਾਇ"
    },
    {
      "section_id": "section-00020",
      "start_time": 184.92,
      "end_time": 192.285,
      "transcript": "ਬਿਨੁ ਸਤਿਗੁਰ ਭੇਟੇ, ਥਾਇ ਨ ਪਾਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 192.715,
      "end_time": 204.025,
      "transcript": "ਨਾਨਕ, ਪੂਰਬਿ ਲਿਖਿਆ ਕਮਾਇ ਪਉੜੀ"
    },
    {
      "section_id": "section-00022",
      "start_time": 204.265,
      "end_time": 213.0,
      "transcript": "ਜਿਨ ਕੇ ਚਿਤ ਕਠੋਰ ਹਹਿ, ਸੇ ਬਹਹਿ ਨ ਸਤਿਗੁਰ ਪਾਸਿ"
    },
    {
      "section_id": "section-00023",
      "start_time": 213.0,
      "end_time": 221.52,
      "transcript": "ਓਥੈ ਸਚੁ ਵਰਤਦਾ, ਕੂੜਿਆਰਾ ਚਿਤ ਉਦਾਸਿ"
    },
    {
      "section_id": "section-00024",
      "start_time": 221.52,
      "end_time": 229.88,
      "transcript": "ਓਇ ਵਲੁ ਛਲੁ ਕਰਿ ਝਤਿ ਕਢਦੇ, ਫਿਰਿ ਜਾਇ ਬਹਹਿ ਕੂੜਿਆਰਾ ਪਾਸਿ"
    },
    {
      "section_id": "section-00025",
      "start_time": 229.88,
      "end_time": 238.24,
      "transcript": "ਵਿਚਿ ਸਚੇ ਕੂੜੁ ਨ ਗਡਈ, ਮਨਿ ਵੇਖਹੁ ਕੋ ਨਿਰਜਾਸਿ"
    },
    {
      "section_id": "section-00026",
      "start_time": 238.24,
      "end_time": 248.013,
      "transcript": "ਕੂੜਿਆਰ ਕੂੜਿਆਰੀ ਜਾਇ ਰਲੇ, ਸਚਿਆਰ ਸਿਖ ਬੈਠੇ ਸਤਿਗੁਰ ਪਾਸਿ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.44,
      "end_time": 12.995,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.585,
      "end_time": 18.893,
      "transcript": "ਰਾਗੁ ਗਉੜੀ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.893,
      "end_time": 31.625,
      "transcript": "ਬੈਰਾਗਣਿ ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00004",
      "start_time": 47.385,
      "end_time": 54.92,
      "transcript": "ਸਤਿਗੁਰ ਤੇ ਜੋ ਮੁਹ ਫੇਰੇ"
    },
    {
      "section_id": "section-00005",
      "start_time": 54.92,
      "end_time": 61.915,
      "transcript": "ਤੇ ਵੇਮੁਖ ਬੁਰੇ ਦਿਸੰਨਿ"
    },
    {
      "section_id": "section-00006",
      "start_time": 62.4,
      "end_time": 69.465,
      "transcript": "ਅਨਦਿਨੁ ਬਧੇ ਮਾਰੀਅਨਿ"
    },
    {
      "section_id": "section-00007",
      "start_time": 69.96,
      "end_time": 77.095,
      "transcript": "ਫਿਰਿ ਵੇਲਾ ਨਾ ਲਹੰਨਿ"
    },
    {
      "section_id": "section-00008",
      "start_time": 77.48,
      "end_time": 84.775,
      "transcript": "ਹਰਿ ਹਰਿ ਰਾਖਹੁ, ਕ੍ਰਿਪਾ ਧਾਰਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 84.775,
      "end_time": 92.177,
      "transcript": "ਸਤਸੰਗਤਿ ਮੇਲਾਇ ਪ੍ਰਭ"
    },
    {
      "section_id": "section-00010",
      "start_time": 92.177,
      "end_time": 100.515,
      "transcript": "ਹਰਿ ਹਿਰਦੈ ਹਰਿ ਗੁਣ ਸਾਰਿ ਰਹਾਉ"
    },
    {
      "section_id": "section-00011",
      "start_time": 107.615,
      "end_time": 114.745,
      "transcript": "ਸੇ ਭਗਤ ਹਰਿ ਭਾਵਦੇ"

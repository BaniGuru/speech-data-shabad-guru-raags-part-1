  "audio_file": "0195 FPb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 4.88,
      "end_time": 10.575,
      "transcript": "ਸਲੋਕੁ"
    },
    {
      "section_id": "section-00002",
      "start_time": 11.12,
      "end_time": 16.625,
      "transcript": "ਹਉ ਹਉ ਕਰਤ ਬਿਹਾਨੀਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 16.995,
      "end_time": 22.585,
      "transcript": "ਸਾਕਤ ਮੁਗਧ ਅਜਾਨ"
    },
    {
      "section_id": "section-00004",
      "start_time": 23.0,
      "end_time": 28.725,
      "transcript": "ੜੜਕਿ ਮੁਏ ਜਿਉ ਤ੍ਰਿਖਾਵੰਤ"
    },
    {
      "section_id": "section-00005",
      "start_time": 29.065,
      "end_time": 34.665,
      "transcript": "ਨਾਨਕ ਕਿਰਤਿ ਕਮਾਨ"
    },
    {
      "section_id": "section-00006",
      "start_time": 35.08,
      "end_time": 36.725,
      "transcript": "ਪਉੜੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 46.2,
      "end_time": 54.28,
      "transcript": "ੜਾੜਾ, ੜਾੜਿ ਮਿਟੈ ਸੰਗਿ ਸਾਧੂ ਕਰਮ ਧਰਮ ਤਤੁ, ਨਾਮ ਅਰਾਧੂ"
    },
    {
      "section_id": "section-00008",
      "start_time": 54.28,
      "end_time": 62.08,
      "transcript": "ਰੂੜੋ, ਜਿਹ ਬਸਿਓ ਰਿਦ ਮਾਹੀ ਉਆ ਕੀ, ੜਾੜਿ ਮਿਟਤ ਬਿਨਸਾਹੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 62.08,
      "end_time": 70.0,
      "transcript": "ੜਾੜਿ ਕਰਤ, ਸਾਕਤ ਗਾਵਾਰਾ ਜੇਹ ਹੀਐ, ਅਹੰਬੁਧਿ ਬਿਕਾਰਾ"
    },
    {
      "section_id": "section-00010",
      "start_time": 70.0,
      "end_time": 78.175,
      "transcript": "ੜਾੜਾ, ਗੁਰਮੁਖਿ ੜਾੜਿ ਮਿਟਾਈ ਨਿਮਖ ਮਾਹਿ, ਨਾਨਕ ਸਮਝਾਈ"
    }
  ]
}

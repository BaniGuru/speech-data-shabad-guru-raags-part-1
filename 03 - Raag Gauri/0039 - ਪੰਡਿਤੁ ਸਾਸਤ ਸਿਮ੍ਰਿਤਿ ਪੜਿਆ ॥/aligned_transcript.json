{
  "audio_file": "0123 D Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 12.2,
      "end_time": 24.16,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ਚੌਥਾ ਚਉਥਾ ਚਉਪਦੇ"
    },
    {
      "section_id": "section-00002",
      "start_time": 24.16,
      "end_time": 30.689,
      "transcript": "ਇਕਓਅੰਕਾਰਿ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ"
    },
    {
      "section_id": "section-00003",
      "start_time": 36.04,
      "end_time": 41.96,
      "transcript": "ਪੰਡਿਤੁ ਸਾਸਤ ਸਿਮ੍ਰਿਤਿ ਪੜਿਆ"
    },
    {
      "section_id": "section-00004",
      "start_time": 41.96,
      "end_time": 48.04,
      "transcript": "ਜੋਗੀ ਗੋਰਖੁ ਗੋਰਖੁ ਕਰਿਆ"
    },
    {
      "section_id": "section-00005",
      "start_time": 48.04,
      "end_time": 54.12,
      "transcript": "ਮੈ ਮੂਰਖ, ਹਰਿ ਹਰਿ ਜਪੁ ਪੜਿਆ"
    },
    {
      "section_id": "section-00006",
      "start_time": 54.12,
      "end_time": 60.12,
      "transcript": "ਨਾ ਜਾਨਾ, ਕਿਆ ਗਤਿ ਰਾਮ ਹਮਾਰੀ"
    },
    {
      "section_id": "section-00007",
      "start_time": 60.12,
      "end_time": 69.35,
      "transcript": "ਹਰਿ ਭਜੁ ਮਨ ਮੇਰੇ ਤਰੁ ਭਉਜਲੁ ਤੂ ਤਾਰੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.36,
      "end_time": 81.48,
      "transcript": "ਸੰਨਿਆਸੀ ਬਿਭੂਤ ਲਾਇ, ਦੇਹ ਸਵਾਰੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.48,
      "end_time": 87.68,
      "transcript": "ਪਰ ਤ੍ਰਿਅ ਤਿਆਗੁ, ਕਰੀ ਬ੍ਰਹਮਚਾਰੀ"
    },
    {
      "section_id": "section-00010",
      "start_time": 87.68,
      "end_time": 93.8,
      "transcript": "ਮੈ ਮੂਰਖ, ਹਰਿ ਆਸ ਤੁਮਾਰੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 93.8,
      "end_time": 100.0,
      "transcript": "ਖਤ੍ਰੀ ਕਰਮ ਕਰੇ, ਸੂਰਤਣੁ ਪਾਵੈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 100.0,
      "end_time": 106.08,
      "transcript": "ਸੂਦੁ ਵੈਸੁ, ਪਰ ਕਿਰਤਿ ਕਮਾਵੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 106.08,
      "end_time": 112.28,
      "transcript": "ਮੈ ਮੂਰਖ, ਹਰਿ ਨਾਮੁ ਛਡਾਵੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 112.28,
      "end_time": 118.4,
      "transcript": "ਸਭ ਤੇਰੀ ਸ੍ਰਿਸਟਿ, ਤੂੰ ਆਪਿ ਰਹਿਆ ਸਮਾਈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 118.4,
      "end_time": 124.273,
      "transcript": "ਗੁਰਮੁਖਿ ਨਾਨਕ ਦੇ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 124.273,
      "end_time": 130.485,
      "transcript": "ਮੈ ਅੰਧੁਲੇ, ਹਰਿ ਟੇਕ ਟਿਕਾਈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 130.485,
      "end_time": 136.615,
      "transcript": "ਗੁਰਮੁਖਿ ਨਾਨਕ ਦੇ ਵਡਿਆਈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 136.615,

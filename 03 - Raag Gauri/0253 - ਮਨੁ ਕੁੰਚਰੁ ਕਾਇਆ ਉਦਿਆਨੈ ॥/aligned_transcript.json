{
  "audio_file": "0168 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.555,
      "end_time": 10.391,
      "transcript": "ਗਉੜੀ ਗੁਆਰੇਰੀ"
    },
    {
      "section_id": "section-00002",
      "start_time": 10.391,
      "end_time": 17.595,
      "transcript": "ਮਹਲਾ ਪਹਿਲਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 34.465,
      "end_time": 40.96,
      "transcript": "ਮਨੁ ਕੁੰਚਰੁ, ਕਾਇਆ ਉਦਿਆਨੈ"
    },
    {
      "section_id": "section-00004",
      "start_time": 40.96,
      "end_time": 47.185,
      "transcript": "ਗੁਰੁ ਅੰਕਸੁ, ਸਚੁ ਸਬਦੁ ਨੀਸਾਨੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 47.185,
      "end_time": 53.515,
      "transcript": "ਰਾਜ ਦੁਆਰੈ, ਸੋਭ ਸੁ ਮਾਨੈ"
    },
    {
      "section_id": "section-00006",
      "start_time": 53.515,
      "end_time": 59.715,
      "transcript": "ਚਤੁਰਾਈ, ਨਹ ਚੀਨਿਆ ਜਾਇ"
    },
    {
      "section_id": "section-00007",
      "start_time": 59.715,
      "end_time": 69.095,
      "transcript": "ਬਿਨੁ ਮਾਰੇ, ਕਿਉ ਕੀਮਤਿ ਪਾਇ ਰਹਾਉ"
    },
    {
      "section_id": "section-00008",
      "start_time": 75.72,
      "end_time": 82.01,
      "transcript": "ਘਰ ਮਹਿ ਅੰਮ੍ਰਿਤੁ, ਤਸਕਰੁ ਲੇਈ"
    },
    {
      "section_id": "section-00009",
      "start_time": 82.01,
      "end_time": 88.243,
      "transcript": "ਨੰਨਾਕਾਰੁ, ਨ ਕੋਇ ਕਰੇਈ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.243,
      "end_time": 94.765,
      "transcript": "ਰਾਖੈ ਆਪਿ, ਵਡਿਆਈ ਦੇਈ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.765,
      "end_time": 101.158,
      "transcript": "ਨੀਲ ਅਨੀਲ, ਅਗਨਿ ਇਕ ਠਾਈ"
    },
    {
      "section_id": "section-00012",
      "start_time": 101.158,
      "end_time": 107.565,
      "transcript": "ਜਲਿ ਨਿਵਰੀ, ਗੁਰਿ ਬੂਝ ਬੁਝਾਈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 107.565,
      "end_time": 114.045,
      "transcript": "ਮਨੁ ਦੇ ਲੀਆ, ਰਹਸਿ ਗੁਣ ਗਾਈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 114.045,
      "end_time": 120.68,
      "transcript": "ਜੈਸਾ ਘਰਿ, ਬਾਹਰਿ ਸੋ ਤੈਸਾ"
    },
    {
      "section_id": "section-00015",
      "start_time": 120.68,
      "end_time": 127.2,
      "transcript": "ਬੈਸਿ ਗੁਫਾ ਮਹਿ, ਆਖਉ ਕੈਸਾ"
    },
    {
      "section_id": "section-00016",
      "start_time": 127.2,
      "end_time": 133.525,
      "transcript": "ਸਾਗਰਿ ਡੂਗਰਿ, ਨਿਰਭਉ ਐਸਾ"
    },
    {
      "section_id": "section-00017",
      "start_time": 133.525,
      "end_time": 139.96,
      "transcript": "ਮੂਏ ਕਉ, ਕਹੁ ਮਾਰੇ ਕਉਨੁ"
    },
    {
      "section_id": "section-00018",
      "start_time": 139.96,
      "end_time": 146.8,
      "transcript": "ਨਿਡਰੇ ਕਉ, ਕੈਸਾ ਡਰੁ ਕਵਨੁ"
    },
    {
      "section_id": "section-00019",
      "start_time": 146.8,
      "end_time": 153.11,
      "transcript": "ਸਬਦਿ ਪਛਾਨੈ, ਤੀਨੇ ਭਉਨ"
    },
    {
      "section_id": "section-00020",
      "start_time": 153.11,
      "end_time": 159.495,
      "transcript": "ਜਿਨਿ ਕਹਿਆ, ਤਿਨਿ ਕਹਨੁ ਵਖਾਨਿਆ"
    },
    {
      "section_id": "section-00021",
      "start_time": 159.495,
      "end_time": 165.935,
      "transcript": "ਜਿਨਿ ਬੂਝਿਆ, ਤਿਨਿ ਸਹਜਿ ਪਛਾਨਿਆ"
    },
    {
      "section_id": "section-00022",
      "start_time": 165.935,
      "end_time": 172.035,
      "transcript": "ਦੇਖਿ ਬੀਚਾਰਿ, ਮੇਰਾ ਮਨੁ ਮਾਨਿਆ"
    },
    {
      "section_id": "section-00023",
      "start_time": 172.68,
      "end_time": 179.0,
      "transcript": "ਕੀਰਤਿ ਸੂਰਤਿ ਮੁਕਤਿ, ਇਕ ਨਾਈ"
    },
    {
      "section_id": "section-00024",
      "start_time": 179.0,
      "end_time": 185.4,
      "transcript": "ਤਹੀ ਨਿਰੰਜਨੁ, ਰਹਿਆ ਸਮਾਈ"
    },
    {
      "section_id": "section-00025",
      "start_time": 185.4,
      "end_time": 191.925,
      "transcript": "ਨਿਜ ਘਰਿ ਬਿਆਪਿ ਰਹਿਆ, ਨਿਜ ਠਾਈ"
    },
    {
      "section_id": "section-00026",
      "start_time": 191.925,
      "end_time": 198.4,
      "transcript": "ਉਸਤਤਿ ਕਰਹਿ, ਕੇਤੇ ਮੁਨਿ ਪ੍ਰੀਤਿ"
    },
    {
      "section_id": "section-00027",
      "start_time": 198.4,
      "end_time": 204.691,
      "transcript": "ਤਨਿ ਮਨਿ ਸੂਚੈ, ਸਾਚੁ ਸੁ ਚੀਤਿ"
    },
    {
      "section_id": "section-00028",
      "start_time": 204.691,
      "end_time": 210.775,
      "transcript": "ਨਾਨਕ ਹਰਿ ਭਜੁ, ਨੀਤਾ ਨੀਤਿ"
    }
  ]
}

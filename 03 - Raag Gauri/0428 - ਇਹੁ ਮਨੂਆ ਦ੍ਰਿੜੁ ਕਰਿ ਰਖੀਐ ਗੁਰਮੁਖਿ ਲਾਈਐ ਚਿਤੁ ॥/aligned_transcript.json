{
  "audio_file": "0232 A Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 2.685,
      "end_time": 13.282,
      "transcript": "ਸਲੋਕੁ ਮਹਲਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 13.282,
      "end_time": 20.027,
      "transcript": "ਚੌਥਾ"
    },
    {
      "section_id": "section-00003",
      "start_time": 41.32,
      "end_time": 49.925,
      "transcript": "ਇਹੁ ਮਨੂਆ ਦ੍ਰਿੜੁ ਕਰਿ ਰਖੀਐ"
    },
    {
      "section_id": "section-00004",
      "start_time": 50.365,
      "end_time": 59.155,
      "transcript": "ਗੁਰਮੁਖਿ ਲਾਈਐ ਚਿਤੁ"
    },
    {
      "section_id": "section-00005",
      "start_time": 59.155,
      "end_time": 67.835,
      "transcript": "ਕਿਉ ਸਾਸਿ ਗਿਰਾਸਿ ਵਿਸਾਰੀਐ"
    },
    {
      "section_id": "section-00006",
      "start_time": 68.285,
      "end_time": 77.192,
      "transcript": "ਬਹਦਿਆ ਉਠਦਿਆ ਨਿਤ"
    },
    {
      "section_id": "section-00007",
      "start_time": 85.895,
      "end_time": 94.155,
      "transcript": "ਮਰਣ ਜੀਵਣ ਕੀ ਚਿੰਤਾ ਗਈ"
    },
    {
      "section_id": "section-00008",
      "start_time": 94.64,
      "end_time": 102.957,
      "transcript": "ਇਹੁ ਜੀਅੜਾ ਹਰਿ ਪ੍ਰਭ ਵਸਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 102.957,
      "end_time": 111.739,
      "transcript": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਰਖੁ ਤੂ"
    },
    {
      "section_id": "section-00010",
      "start_time": 111.739,
      "end_time": 119.805,
      "transcript": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਬਖਸਿ"
    },
    {
      "section_id": "section-00011",
      "start_time": 120.325,
      "end_time": 124.536,
      "transcript": "ਮਹਲਾ ਤੀਜਾ"
    },
    {
      "section_id": "section-00012",
      "start_time": 124.536,
      "end_time": 133.17,
      "transcript": "ਮਨਮੁਖੁ ਅਹੰਕਾਰੀ ਮਹਲੁ ਨ ਜਾਣੈ"
    },
    {
      "section_id": "section-00013",
      "start_time": 133.17,
      "end_time": 141.175,
      "transcript": "ਖਿਨੁ ਆਗੈ ਖਿਨੁ ਪੀਛੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 141.575,
      "end_time": 150.06,
      "transcript": "ਸਦਾ ਬੁਲਾਈਐ ਮਹਲਿ ਨ ਆਵੈ"
    },
    {
      "section_id": "section-00015",
      "start_time": 150.06,
      "end_time": 158.315,
      "transcript": "ਕਿਉ ਕਰਿ ਦਰਗਹ ਸੀਝੈ"
    },
    {
      "section_id": "section-00016",
      "start_time": 166.96,
      "end_time": 174.945,
      "transcript": "ਸਤਿਗੁਰ ਕਾ ਮਹਲੁ ਵਿਰਲਾ ਜਾਣੈ"
    },
    {
      "section_id": "section-00017",
      "start_time": 175.4,
      "end_time": 183.155,
      "transcript": "ਸਦਾ ਰਹੈ ਕਰ ਜੋੜਿ"
    },
    {
      "section_id": "section-00018",
      "start_time": 183.515,
      "end_time": 191.165,
      "transcript": "ਆਪਣੀ ਕ੍ਰਿਪਾ ਕਰੇ ਹਰਿ ਮੇਰਾ"
    },
    {
      "section_id": "section-00019",
      "start_time": 191.665,
      "end_time": 203.415,
      "transcript": "ਨਾਨਕ ਲਏ ਬਹੋੜਿ ਪਉੜੀ"
    },
    {
      "section_id": "section-00020",
      "start_time": 203.655,
      "end_time": 212.465,
      "transcript": "ਸਾ ਸੇਵਾ ਕੀਤੀ ਸਫਲ ਹੈ, ਜਿਤੁ ਸਤਿਗੁਰ ਕਾ ਮਨੁ ਮੰਨੇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 212.465,
      "end_time": 221.07,
      "transcript": "ਜਾ ਸਤਿਗੁਰ ਕਾ ਮਨੁ ਮੰਨਿਆ, ਤਾ ਪਾਪ ਕਸੰਮਲ ਭੰਨੇ"
    },
    {
      "section_id": "section-00022",
      "start_time": 221.07,
      "end_time": 229.595,
      "transcript": "ਉਪਦੇਸੁ ਜਿ ਦਿਤਾ ਸਤਿਗੁਰੂ, ਸੋ ਸੁਣਿਆ ਸਿਖੀ ਕੰਨੇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 229.92,
      "end_time": 238.59,
      "transcript": "ਜਿਨ ਸਤਿਗੁਰ ਕਾ ਭਾਣਾ ਮੰਨਿਆ, ਤਿਨ ਚੜੀ ਚਵਗਣਿ ਵੰਨੇ"
    },
    {
      "section_id": "section-00024",
      "start_time": 238.59,
      "end_time": 248.355,
      "transcript": "ਇਹ ਚਾਲ ਨਿਰਾਲੀ ਗੁਰਮੁਖੀ, ਗੁਰ ਦੀਖਿਆ ਸੁਣਿ ਮਨੁ ਭਿੰਨੇ"
    }
  ]
}

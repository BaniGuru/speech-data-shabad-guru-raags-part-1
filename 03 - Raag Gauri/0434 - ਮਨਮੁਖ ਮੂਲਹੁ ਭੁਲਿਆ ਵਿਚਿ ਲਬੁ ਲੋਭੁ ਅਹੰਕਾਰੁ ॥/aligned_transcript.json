{
  "audio_file": "0233 B Pb.mp3",
  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.015,
      "end_time": 4.615,
      "transcript": "ਸਲੋਕ ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 23.315,
      "end_time": 30.405,
      "transcript": "ਮਨਮੁਖ ਮੂਲਹੁ ਭੁਲਿਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 30.76,
      "end_time": 37.795,
      "transcript": "ਵਿਚਿ ਲਬੁ ਲੋਭੁ ਅਹੰਕਾਰੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 38.12,
      "end_time": 44.945,
      "transcript": "ਝਗੜਾ ਕਰਦਿਆ ਅਨਦਿਨੁ ਗੁਦਰੈ"
    },
    {
      "section_id": "section-00005",
      "start_time": 45.4,
      "end_time": 52.365,
      "transcript": "ਸਬਦਿ ਨ ਕਰਹਿ ਵੀਚਾਰੁ"
    },
    {
      "section_id": "section-00006",
      "start_time": 59.76,
      "end_time": 66.505,
      "transcript": "ਸੁਧਿ ਮਤਿ ਕਰਤੈ ਸਭ ਹਿਰਿ ਲਈ"
    },
    {
      "section_id": "section-00007",
      "start_time": 66.855,
      "end_time": 73.555,
      "transcript": "ਬੋਲਨਿ ਸਭੁ ਵਿਕਾਰੁ"
    },
    {
      "section_id": "section-00008",
      "start_time": 74.04,
      "end_time": 81.12,
      "transcript": "ਦਿਤੈ ਕਿਤੈ ਨ ਸੰਤੋਖੀਅਹਿ"
    },
    {
      "section_id": "section-00009",
      "start_time": 81.12,
      "end_time": 88.184,
      "transcript": "ਅੰਤਰਿ ਤਿਸਨਾ ਬਹੁ ਅਗਿਆਨੁ ਅੰਧੵਾਰੁ"
    },
    {
      "section_id": "section-00010",
      "start_time": 88.184,
      "end_time": 94.8,
      "transcript": "ਨਾਨਕ ਮਨਮੁਖਾ ਨਾਲੋ ਤੁਟੀ ਭਲੀ"
    },
    {
      "section_id": "section-00011",
      "start_time": 94.8,
      "end_time": 101.849,
      "transcript": "ਜਿਨ ਮਾਇਆ ਮੋਹ ਪਿਆਰੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 101.849,
      "end_time": 106.011,
      "transcript": "ਮਹਲਾ ਚੌਥਾ"
    },
    {
      "section_id": "section-00013",
      "start_time": 112.945,
      "end_time": 119.705,
      "transcript": "ਜਿਨਾ ਅੰਦਰਿ ਦੂਜਾ ਭਾਉ ਹੈ"
    },
    {
      "section_id": "section-00014",
      "start_time": 120.08,
      "end_time": 126.825,
      "transcript": "ਤਿਨਾ੍ ਗੁਰਮੁਖਿ ਪ੍ਰੀਤਿ ਨ ਹੋਇ"
    },
    {
      "section_id": "section-00015",
      "start_time": 127.24,
      "end_time": 133.995,
      "transcript": "ਓਹੁ ਆਵੈ ਜਾਇ ਭਵਾਈਐ"
    },
    {
      "section_id": "section-00016",
      "start_time": 134.48,
      "end_time": 141.135,
      "transcript": "ਸੁਪਨੈ ਸੁਖੁ ਨ ਕੋਇ"
    },
    {
      "section_id": "section-00017",
      "start_time": 141.76,
      "end_time": 148.759,
      "transcript": "ਕੂੜੁ ਕਮਾਵੈ ਕੂੜੁ ਉਚਰੈ"
    },
    {
      "section_id": "section-00018",
      "start_time": 148.759,
      "end_time": 155.795,
      "transcript": "ਕੂੜਿ ਲਗਿਆ ਕੂੜੁ ਹੋਇ"
    },
    {
      "section_id": "section-00019",
      "start_time": 163.385,
      "end_time": 170.265,
      "transcript": "ਮਾਇਆ ਮੋਹੁ ਸਭੁ ਦੁਖੁ ਹੈ"
    },
    {
      "section_id": "section-00020",
      "start_time": 170.6,
      "end_time": 177.385,
      "transcript": "ਦੁਖਿ ਬਿਨਸੈ ਦੁਖੁ ਰੋਇ"
    },
    {
      "section_id": "section-00021",
      "start_time": 177.785,
      "end_time": 184.955,
      "transcript": "ਨਾਨਕ ਧਾਤੁ ਲਿਵੈ ਜੋੜੁ ਨ ਆਵਈ"
    },
    {
      "section_id": "section-00022",
      "start_time": 184.955,
      "end_time": 191.585,
      "transcript": "ਜੇ ਲੋਚੈ ਸਭੁ ਕੋਇ"
    },
    {
      "section_id": "section-00023",
      "start_time": 192.12,
      "end_time": 198.945,
      "transcript": "ਜਿਨ ਕਉ ਪੋਤੈ ਪੁੰਨੁ ਪਇਆ"
    },
    {
      "section_id": "section-00024",
      "start_time": 199.28,
      "end_time": 206.035,
      "transcript": "ਤਿਨਾ ਗੁਰਸਬਦੀ ਸੁਖੁ ਹੋਇ"
    },
    {
      "section_id": "section-00025",
      "start_time": 206.52,
      "end_time": 213.637,
      "transcript": "ਪਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00026",
      "start_time": 217.525,
      "end_time": 224.825,
      "transcript": "ਨਾਨਕ ਵੀਚਾਰਹਿ ਸੰਤ ਮੁਨਿ ਜਨਾਂ, ਚਾਰਿ ਵੇਦ ਕਹੰਦੇ"
    },
    {
      "section_id": "section-00027",
      "start_time": 225.315,
      "end_time": 233.36,
      "transcript": "ਭਗਤ ਮੁਖੈ ਤੇ ਬੋਲਦੇ, ਸੇ ਵਚਨ ਹੋਵੰਦੇ"
    },
    {
      "section_id": "section-00028",
      "start_time": 233.36,
      "end_time": 241.167,
      "transcript": "ਪਰਗਟ ਪਾਹਾਰੈ ਜਾਪਦੇ, ਸਭਿ ਲੋਕ ਸੁਣੰਦੇ"
    },
    {
      "section_id": "section-00029",
      "start_time": 241.167,
      "end_time": 249.205,
      "transcript": "ਸੁਖੁ ਨ ਪਾਇਨਿ ਮੁਗਧ ਨਰ, ਸੰਤ ਨਾਲਿ ਖਹੰਦੇ"
    },
    {
      "section_id": "section-00030",
      "start_time": 249.205,
      "end_time": 257.28,
      "transcript": "ਓਇ ਲੋਚਨਿ ਓਨਾ ਗੁਣਾ ਨੋ ਓਇ, ਅਹੰਕਾਰਿ ਸੜੰਦੇ"
    },
    {
      "section_id": "section-00031",
      "start_time": 257.28,
      "end_time": 264.965,
      "transcript": "ਓਇ ਵੇਚਾਰੇ ਕਿਆ ਕਰਹਿ, ਜਾਂ ਭਾਗ ਧੁਰਿ ਮੰਦੇ"
    },
    {
      "section_id": "section-00032",
      "start_time": 265.2,
      "end_time": 272.96,
      "transcript": "ਜੋ ਮਾਰੇ ਤਿਨਿ ਪਾਰਬ੍ਰਹਮਿ, ਸੇ ਕਿਸੈ ਨ ਸੰਦੇ"
    },
    {
      "section_id": "section-00033",
      "start_time": 272.96,
      "end_time": 280.8,
      "transcript": "ਵੈਰੁ ਕਰਨਿ ਨਿਰਵੈਰ ਨਾਲਿ, ਧਰਮਿ ਨਿਆਇ ਪਚੰਦੇ"
    },
    {
      "section_id": "section-00034",
      "start_time": 280.8,
      "end_time": 288.365,
      "transcript": "ਜੋ ਜੋ ਸੰਤਿ ਸਰਾਪਿਆ, ਸੇ ਫਿਰਹਿ ਭਵੰਦੇ"
    },
    {
      "section_id": "section-00035",
      "start_time": 288.56,
      "end_time": 298.362,
      "transcript": "ਪੇਡੁ ਮੁੰਢਾਹੂ ਕਟਿਆ, ਤਿਸੁ ਡਾਲ ਸੁਕੰਦੇ"
    }
  ]
}

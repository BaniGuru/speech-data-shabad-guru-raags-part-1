  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.195,
      "end_time": 7.295,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 14.52,
      "end_time": 21.185,
      "transcript": "ਬਾਰਨੈ ਬਲਿਹਾਰਨੈ, ਲਖ ਬਰੀਆ"
    },
    {
      "section_id": "section-00003",
      "start_time": 21.185,
      "end_time": 28.579,
      "transcript": "ਨਾਮੋ ਹੋ ਨਾਮੁ ਸਾਹਿਬ ਕੋ"
    },
    {
      "section_id": "section-00004",
      "start_time": 28.579,
      "end_time": 36.495,
      "transcript": "ਪ੍ਰਾਨ ਅਧਰੀਆ ਰਹਾਉ"
    },
    {
      "section_id": "section-00005",
      "start_time": 43.44,
      "end_time": 50.495,
      "transcript": "ਕਰਨ ਕਰਾਵਨ, ਤੁਹੀ ਏਕ"
    },
    {
      "section_id": "section-00006",
      "start_time": 50.72,
      "end_time": 57.52,
      "transcript": "ਜੀਅ ਜੰਤ ਕੀ, ਤੁਹੀ ਟੇਕ"
    },
    {
      "section_id": "section-00007",
      "start_time": 57.52,
      "end_time": 64.738,
      "transcript": "ਰਾਜ ਜੋਬਨ, ਪ੍ਰਭ ਤੂੰ ਧਨੀ"
    },
    {
      "section_id": "section-00008",
      "start_time": 64.738,
      "end_time": 71.902,
      "transcript": "ਤੂੰ ਨਿਰਗੁਨ, ਤੂੰ ਸਰਗੁਨੀ"
    },
    {
      "section_id": "section-00009",
      "start_time": 78.845,
      "end_time": 86.181,
      "transcript": "ਈਹਾ ਊਹਾ, ਤੁਮ ਰਖੇ"
    },
    {
      "section_id": "section-00010",
      "start_time": 86.181,
      "end_time": 93.431,
      "transcript": "ਗੁਰ ਕਿਰਪਾ ਤੇ, ਕੋ ਲਖੇ"
    },
    {
      "section_id": "section-00011",
      "start_time": 93.431,
      "end_time": 100.625,
      "transcript": "ਅੰਤਰਜਾਮੀ, ਪ੍ਰਭ ਸੁਜਾਨੁ"
    },
    {
      "section_id": "section-00012",
      "start_time": 100.625,
      "end_time": 107.475,
      "transcript": "ਨਾਨਕ, ਤਕੀਆ ਤੁਹੀ ਤਾਣੁ"
    }
  ]
}

  "sections": [
    {
      "section_id": "section-00001",
      "start_time": 0.115,
      "end_time": 7.058,
      "transcript": "ਗਉੜੀ ਮਹਲਾ ਪੰਜਵਾ"
    },
    {
      "section_id": "section-00002",
      "start_time": 12.76,
      "end_time": 18.585,
      "transcript": "ਜੀਵਨ ਪਦਵੀ, ਹਰਿ ਕੇ ਦਾਸ"
    },
    {
      "section_id": "section-00003",
      "start_time": 18.875,
      "end_time": 25.16,
      "transcript": "ਜਿਨ ਮਿਲਿਆ, ਆਤਮ ਪਰਗਾਸੁ"
    },
    {
      "section_id": "section-00004",
      "start_time": 25.16,
      "end_time": 31.235,
      "transcript": "ਹਰਿ ਕਾ ਸਿਮਰਨੁ, ਸੁਨਿ ਮਨ ਕਾਨੀ"
    },
    {
      "section_id": "section-00005",
      "start_time": 31.235,
      "end_time": 40.538,
      "transcript": "ਸੁਖੁ ਪਾਵਹਿ, ਹਰਿ ਦੁਆਰ ਪਰਾਨੀ ਰਹਾਉ"
    },
    {
      "section_id": "section-00006",
      "start_time": 46.859,
      "end_time": 53.005,
      "transcript": "ਆਠ ਪਹਰ, ਧਿਆਈਐ ਗੋਪਾਲੁ"
    },
    {
      "section_id": "section-00007",
      "start_time": 53.005,
      "end_time": 58.745,
      "transcript": "ਨਾਨਕ, ਦਰਸਨੁ ਦੇਖਿ ਨਿਹਾਲੁ"
    }
  ]
}

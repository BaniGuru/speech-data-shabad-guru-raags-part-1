      "section_id": "section-00037",
      "start_time": 258.437,
      "end_time": 264.675,
      "transcript": "ਨਾਨਕ ਮਾਇਆ ਕਾ ਦੁਖੁ ਤਦੇ ਚੂਕੈ"

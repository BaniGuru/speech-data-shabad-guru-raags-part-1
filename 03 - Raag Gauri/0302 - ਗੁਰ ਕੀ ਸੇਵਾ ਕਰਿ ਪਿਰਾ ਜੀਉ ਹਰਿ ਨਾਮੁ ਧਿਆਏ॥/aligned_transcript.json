    },
    {
      "section_id": "section-00003",
      "start_time": 32.84,
      "end_time": 39.01,
      "transcript": "ਗੁਰ ਕੀ ਸੇਵਾ ਕਰਿ ਪਿਰਾ ਜੀਉ"

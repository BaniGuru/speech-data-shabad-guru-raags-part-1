    {
      "section_id": "section-00007",
      "start_time": 63.64,
      "end_time": 69.666,
      "transcript": "ਘਰਿ ਬੈਠਿਆ ਹਰਿ ਪਾਏ ਸਦਾ ਚਿਤੁ ਲਾਏ"
